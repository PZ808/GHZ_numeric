             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", "M"}], "+", "r0"}], ")"}]}]}], ")"}], 
         " ", 
         RowBox[{"t", "[", "]"}], " ", "\[ScriptCapitalD]"}], "-", 
        RowBox[{
         SqrtBox["M"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "2"], "+", 
           SuperscriptBox["r0", "2"], "-", 
           RowBox[{"2", " ", "a", " ", 
            SqrtBox[
             RowBox[{"M", " ", "r0"}]]}]}], ")"}], " ", "\[ScriptCapitalD]", 
         " ", 
         RowBox[{"\[Phi]", "[", "]"}]}]}], 
       RowBox[{
        RowBox[{"2", " ", "a", " ", 
         SqrtBox["M"]}], "+", 
        RowBox[{
         SqrtBox["r0"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}], ")"}]}]}]]}], ",", 
     RowBox[{
      RowBox[{"X", "[", "]"}], "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{"r", "[", "]"}], "-", "r0"}], "\[ScriptCapitalB]"]}], ",", 
     RowBox[{
      RowBox[{"Y", "[", "]"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", "r0"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "[", "]"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"Z", "[", "]"}], "\[Rule]", 
      RowBox[{"zc", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{
              SqrtBox["M"], " ", 
              RowBox[{"t", "[", "]"}]}], 
