Cell[CellGroupData[{
Cell["Puncture 4th-order  m-mode", "Title",
 CellChangeTimes->{{3.9745043279171047`*^9, 3.9745043311967907`*^9}, {
   3.974509170121682*^9, 3.9745091706648483`*^9}, 3.974509214861302*^9, {
   3.9745092520957127`*^9, 
   3.974509274649201*^9}},ExpressionUUID->"eb754ac9-86d4-443d-b613-\
5ffa8a17a250"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{
  3.9745092184200783`*^9},ExpressionUUID->"a803f53c-b53d-49e4-a4d7-\
eec6a74382f3"],

Cell[TextData[{
 "Computes the local puncture metric h^P to 4th order in \[Lambda]\n for a \
particle on a circular orbit using comoving coordinates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", 
    RowBox[{"\[Mu]", " "}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b706a944-e686-4564-ac8c-a0c596527d8f"],
 "= (T,X,Y,Z) centered on the particle \n ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["X", "p"], "\[Mu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d5b78d5-2d13-4383-a1c6-1cfee910ea09"],
 " = (T,0,0,0).  These are related to BL (t,r,\[Theta],\[Phi]) coordinates by \
\[LineSeparator]",
 Cell[BoxData[
  RowBox[{"\[LineSeparator]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", 
            SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "t"}], "-", 
         RowBox[{"M", 
          SqrtBox[
           SubscriptBox["\[Rho]", "0"]], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Alpha]", "2"], "-", 
            RowBox[{"2", "\[Alpha]"}], "+", 
            SubscriptBox["\[Rho]", "0"]}], ")"}], "\[Phi]", " "}]}], 
        RowBox[{"\[ScriptCapitalD]", " ", 
         SubscriptBox["\[Rho]", "0"]}]], "=", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", 
             SqrtBox["M"]}], "+", 
            RowBox[{
             SqrtBox[
              SubscriptBox["r", "0"]], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], " ", "M"}], "+", 
               SubscriptBox["r", "0"]}], ")"}]}]}], ")"}], " ", "t", " ", 
          "\[ScriptCapitalD]"}], "-", 
         RowBox[{
          SqrtBox["M"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["a", "2"], "+", 
            SuperscriptBox[
             SubscriptBox["r", "0"], "2"], "-", 
            RowBox[{"2", " ", "a", " ", 
             SqrtBox[
              RowBox[{"M", " ", 
               SubscriptBox["r", "0"]}]]}]}], ")"}], " ", "\[ScriptCapitalD]",
           " ", "\[Phi]"}]}], 
        RowBox[{
         RowBox[{"2", " ", "a", " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["r0"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}], ")"}]}]}]]}]}], ",",
      "\[IndentingNewLine]", "\[LineSeparator]", 
     RowBox[{"X", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"r", "-", 
         RowBox[{"M", " ", 
          SubscriptBox["\[Rho]", "0"]}]}], "\[ScriptCapitalB]"], "=", 
       FractionBox[
        RowBox[{"r", "-", "r0"}], "\[ScriptCapitalB]"]}]}], ",", 
     "\[LineSeparator]", "\[IndentingNewLine]", 
     RowBox[{"Y", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["M\[Rho]", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "=", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["r", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ",", "\[LineSeparator]", 
     "\[IndentingNewLine]", 
     RowBox[{"Z", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["z", "c"], 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{"\[Phi]", "-", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "p"], "t"}]}], "2"], "]"}]}], "=", 
       RowBox[{
        SubscriptBox["z", "c"], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               SqrtBox["M"], " ", "t"}], 
              RowBox[{
               RowBox[{"a", " ", 
                SqrtBox["M"]}], "+", 
               SuperscriptBox["r0", 
                RowBox[{"3", "/", "2"}]]}]]}], "+", "\[Phi]"}], ")"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "where", " ", 
    "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "0"], "=", 
      RowBox[{
       SubscriptBox["r", "0"], "/", "M"}]}], ",", " ", 
     RowBox[{"\[Alpha]", "=", 
      FractionBox["a", 
       SqrtBox[
        RowBox[{"M", " ", 
         SubscriptBox["r", "0"]}]]]}]}], "\[IndentingNewLine]", "and", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SubscriptBox["z", "c"], "=", 
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"M", "/", 
         SubscriptBox["r", "0"]}]], 
       FractionBox["\[ScriptCapitalB]", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "p"], "\[ScriptCapitalD]"}]]}]}], 
     ",", " ", 
     RowBox[{"\[ScriptCapitalB]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Alpha]", "2"], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{"\[ScriptCapitalD]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[Alpha]"}], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "3"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "p"], "=", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"M", " ", "\[Alpha]"}], " ", "+", 
            RowBox[{"M", " ", 
             SubscriptBox["\[Rho]", "0"]}]}], ")"}], 
          SubscriptBox["\[Rho]", "0"]}], ",", " "}]]]}]}], 
    "\[IndentingNewLine]"}]}]],ExpressionUUID->
  "514b2cce-241b-4035-8a78-558d88863f43"],
 "\n (Adapted and truncated from  Patrick\[CloseCurlyQuote]s \
PunctureInCoordinates)"
}], "Text",
 CellChangeTimes->{{3.974504333881632*^9, 3.974504364771311*^9}, {
  3.974504404313861*^9, 3.974504410096993*^9}, {3.97450445282802*^9, 
  3.9745045576717854`*^9}, {3.9745046993059883`*^9, 3.974504846379155*^9}, {
  3.974504879441987*^9, 3.974505302060597*^9}, {3.974509228172714*^9, 
  3.97450924420795*^9}, {3.97452797174934*^9, 
  3.974527973630299*^9}},ExpressionUUID->"6c6cc39c-a50b-4069-92ea-\
e9eb2bedb97b"],

