          RowBox[{"Join", "[", 
           RowBox[{"BDzcRules", ",", "\[Alpha]\[Rho]0Toar0$Rule", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"R", "[", "]"}], "->", 
