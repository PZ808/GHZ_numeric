Cell[TextData[{
 "We have two kinds of integrals: 1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
    RowBox[{
     SuperscriptBox["R", "n"], 
     SuperscriptBox["e", 
      RowBox[{"-", "im\[Phi]"}]], "d\[Phi]"}]}], TraditionalForm]],
  ExpressionUUID->"d0e70a0a-a4a0-41c0-adda-5be1ae7f41d5"],
 " and 2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
    RowBox[{
     SuperscriptBox["R", "n"], 
     RowBox[{"Z", "'"}], 
     SuperscriptBox["e", 
      RowBox[{"-", "im\[Phi]"}]], "d\[Phi]"}]}], TraditionalForm]],
  ExpressionUUID->"1e3d3df3-d3ea-4157-af85-18cdab7b9804"],
 ". Integral 1 can be done in the exact same way as Eq. (109) of ",
 ButtonBox["Bourg et al. (2024)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.48550/arXiv.2404.10082"], None},
  ButtonNote->"https://doi.org/10.48550/arXiv.2404.10082"],
 ", leading to:\n\n1) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
         SuperscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["n", "TI"]], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["i", "TI"], 
            StyleBox["m", "TI"], "\[Phi]"}]], 
         StyleBox["d", "TI"], "\[Phi]", "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", "\[Pi]", 
            SuperscriptBox[
             RowBox[{"(", "-1", ")"}], 
             StyleBox["m", "TI"]], 
            SuperscriptBox["\[CurlyRho]", 
             RowBox[{
               StyleBox["n", "TI"], "/", "2"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox["\[CurlyRho]", "2"], "+", 
                 SubsuperscriptBox[
                  StyleBox["z", "TI"], 
                  StyleBox["c", "TI"], "2"]}], ")"}], 
             RowBox[{
               StyleBox["n", "TI"], "/", "4"}]]}], 
          SubscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               StyleBox["n", "TI"], "/", "2"}], ")"}], 
           StyleBox["m", "TI"]]], 
         SubscriptBox["\[Null]", "3"], 
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "/", "2"}], 
          StyleBox["m", "TI"]], 
         RowBox[{"(", 
           StyleBox["z", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\int_{-\\pi}^{\\pi}R^n e^{-im\\phi}d\\phi = \
\\frac{2\\pi(-1)^{m}\\varrho^{n/2}(\\varrho^2+z^2_c)^{n/4}}{(1+n/2)_m} \
{}_{3}P_{n/2}^m(z)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b131f5a0-ed4b-4391-98ad-87f50a66c3e5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CurlyRho]", "2"], "\[Congruent]", 
         SuperscriptBox[
          StyleBox["X", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["Y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\varrho^2 \\equiv X^2 + Y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44c1e184-1860-4020-8230-713af2a931bd"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["z", "TI"], "\[Congruent]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[CurlyRho]", "2"], "+", 
            FractionBox[
             SubsuperscriptBox[
              StyleBox["z", "TI"], 
              StyleBox["c", "TI"], "2"], "2"]}], 
          RowBox[{"\[CurlyRho]", 
            SqrtBox[
             RowBox[{
               SuperscriptBox["\[CurlyRho]", "2"], "+", 
               SubsuperscriptBox[
                StyleBox["z", "TI"], 
                StyleBox["c", "TI"], "2"]}]]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "z\\equiv \
\\frac{\\varrho^2+\\frac{z_c^2}{2}}{\\varrho\\sqrt{\\varrho^2+z^2_c}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c83e989d-de23-4ad7-9bf2-7f57b9acc387"],
 "."
}], "Text",ExpressionUUID->"5eca12ad-153c-41a3-98fc-7a2e3ccfdb1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integral1", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"R", "[", "]"}], "n_."], ":>", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mBlock", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "+", 
            FractionBox["n", "2"]}], "<=", "0"}], ",", 
          RowBox[{"-", 
           RowBox[{"Abs", "[", "m", "]"}]}], ",", 
          RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"2", "\[Pi]", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "mBlock"], 
       SuperscriptBox[
        RowBox[{"\[CurlyRho]", "[", "]"}], 
        RowBox[{"n", "/", "2"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"\[CurlyRho]", "[", "]"}], "2"], "+", 
          SuperscriptBox["zc", "2"]}], ")"}], 
        RowBox[{"n", "/", "4"}]], 
       FractionBox[
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{"n", "/", "2"}], ",", "mBlock", ",", "3", ",", 
          RowBox[{"z", "[", "]"}]}], "]"}], 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"1", "+", 
           RowBox[{"n", "/", "2"}]}], ",", "mBlock"}], "]"}]]}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"2933b819-6b4d-4ad9-8b9e-82a86b0660cc"],

Cell[TextData[{
 "Eq. (2) is done in a similar way but with a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "'"}], "=", 
    RowBox[{
     SubscriptBox["z", "c"], 
     RowBox[{"sin", "(", "\[Phi]", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"e8cd2ed6-2d8e-4e7e-b0c3-66f0370096eb"],
 ":"
}], "Text",ExpressionUUID->"a9418bad-ab7a-450a-90f7-6f45304e7b68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntegralZp1", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"R", "[", "]"}], "n_."], ":>", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mp1", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "+", 
             FractionBox["n", "2"]}], "<=", "0"}], ",", 
           RowBox[{"-", 
            RowBox[{"Abs", "[", 
             RowBox[{"m", "+", "1"}], "]"}]}], ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"m", "+", "1"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"mn1", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "+", 
             FractionBox["n", "2"]}], "<=", "0"}], ",", 
           RowBox[{"-", 
            RowBox[{"Abs", "[", 
             RowBox[{"m", "-", "1"}], "]"}]}], ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"m", "-", "1"}], "]"}]}], "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "m"], " ", "\[Pi]", " ", 
       InterpretationBox[
        StyleBox["zc",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`zc,
        Editable->False], " ", 
       SuperscriptBox[
        RowBox[{"\[CurlyRho]", "[", "]"}], 
        RowBox[{"n", "/", "2"}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           InterpretationBox[
            StyleBox["zc",
             ShowAutoStyles->False,
             AutoSpacing->False],
            $CellContext`zc,
            Editable->False], "2"], "+", 
          SuperscriptBox[
           RowBox[{"\[CurlyRho]", "[", "]"}], "2"]}], ")"}], 
        RowBox[{"n", "/", "4"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            InterpretationBox[
             StyleBox["LegendreP",
              ShowAutoStyles->False,
              AutoSpacing->False],
             LegendreP,
             Editable->False], "[", 
            RowBox[{
             FractionBox["n", "2"], ",", "mp1", ",", "3", ",", 
             RowBox[{"z", "[", "]"}]}], "]"}], 
           RowBox[{
            InterpretationBox[
             StyleBox["Pochhammer",
              ShowAutoStyles->False,
              AutoSpacing->False],
             Pochhammer,
             Editable->False], "[", 
            RowBox[{
             RowBox[{"1", "+", 
              FractionBox["n", "2"]}], ",", "mp1"}], "]"}]]}], "+", 
         FractionBox[
          RowBox[{
           InterpretationBox[
            StyleBox["LegendreP",
             ShowAutoStyles->False,
             AutoSpacing->False],
            LegendreP,
            Editable->False], "[", 
           RowBox[{
            FractionBox["n", "2"], ",", "mn1", ",", "3", ",", 
            RowBox[{"z", "[", "]"}]}], "]"}], 
          RowBox[{
           InterpretationBox[
            StyleBox["Pochhammer",
             ShowAutoStyles->False,
             AutoSpacing->False],
            Pochhammer,
            Editable->False], "[", 
           RowBox[{
            RowBox[{"1", "+", 
             FractionBox["n", "2"]}], ",", "mn1"}], "]"}]]}], ")"}]}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"bdfc5efb-52ee-4648-a98a-a38bb9642f7e"],

