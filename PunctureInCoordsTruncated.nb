                  RowBox[{"r", "[", "]"}], "-", 
                  RowBox[{"M", " ", "\[Rho]0"}]}], ")"}]}]}], ",", 
              RowBox[{
               RowBox[{"Y", "[", "]"}], "->", 
               RowBox[{
                RowBox[{"-", "M"}], " ", "\[Rho]0", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"\[Theta]", "[", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"Zp", "[", "]"}], "->", 
               RowBox[{"zc", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Phi]", "[", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"Z", "[", "]"}], "->", 
               RowBox[{"zc", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", "]"}], "/", "2"}], "]"}]}]}]}], 
             "}"}]}], "]"}]}], "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"a", "->", 
            RowBox[{"1", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{"r", "[", "]"}], "->", "11"}], ",", 
           RowBox[{"r0", "->", "10"}], ",", 
           RowBox[{
            RowBox[{"\[Theta]", "[", "]"}], "->", 
            RowBox[{"Pi", "/", "3"}]}]}], "}"}]}], ",", 
