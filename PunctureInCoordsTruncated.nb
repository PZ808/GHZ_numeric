Cell[CellGroupData[{

Cell[TextData[{
 "Reduce powers of ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "a0a24923-e07c-4088-a59a-0c61505f8300"]
}], "Subsubsection",ExpressionUUID->"d2a30b57-a1e2-4967-a106-6b86909f14a5"],

Cell[TextData[{
 "In the derived expressions, the tetrad components are written in terms of \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "a"], 
    SuperscriptBox["X", "b"], 
    SuperscriptBox["Y", "c"], 
    SuperscriptBox["Z", "d"]}], TraditionalForm]],ExpressionUUID->
  "50f4a59f-492f-4e6a-a423-88fef230bbaa"],
 ", we can reduce the powers of ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "3906918d-c7d6-4eb4-89b8-68b5783ba09c"],
 " to only ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Z", "0"], TraditionalForm]],ExpressionUUID->
  "cdc9b014-883c-4134-9ac0-ff8f74931323"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Z", "1"], TraditionalForm]],ExpressionUUID->
  "af84c675-dca7-45da-aba8-660ca05aef2a"],
 " by utilising ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Z", "2"], "=", 
    RowBox[{
     SuperscriptBox["R", "2"], "-", 
     SuperscriptBox["X", "2"], "-", 
     SuperscriptBox["Y", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "810e9513-e2e2-431d-a901-0564d16de953"]
}], "Text",ExpressionUUID->"b37d429a-8fb4-405f-acbb-27b91465c6fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReduceZ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"Z", "[", "]"}], "n_"], ":>", 
      RowBox[{
       RowBox[{
        RowBox[{"Z", "[", "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"R", "[", "]"}], "2"], "-", 
           SuperscriptBox[
            RowBox[{"X", "[", "]"}], "2"], "-", 
           SuperscriptBox[
            RowBox[{"Y", "[", "]"}], "2"]}], ")"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], "/", "2"}]]}], "/;", 
       RowBox[{"OddQ", "[", "n", "]"}]}]}], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Z", "[", "]"}], "n_"], ":>", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"R", "[", "]"}], "2"], "-", 
          SuperscriptBox[
           RowBox[{"X", "[", "]"}], "2"], "-", 
          SuperscriptBox[
           RowBox[{"Y", "[", "]"}], "2"]}], ")"}], 
        RowBox[{"n", "/", "2"}]], "/;", 
       RowBox[{"EvenQ", "[", "n", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"ea5be245-e77d-4b88-bd90-5a439eeddd3b"],

Cell[TextData[{
 "We then expand ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "b0adb419-31af-42c4-b0a5-1f92cd4cc0bc"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"Z", "'"}], "2"], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Z", "'"}], ")"}], "3"], "16"], "+", 
     RowBox[{"O", "(", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Z", "'"}], ")"}], "5"], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"57caaad4-17b7-44a7-9994-53350e06a4db"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "'"}], "=", 
    RowBox[{
     SubscriptBox["z", "c"], 
     RowBox[{"sin", "(", "\[Phi]", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"761b209a-e2a2-4216-b7cf-aae8df9388ba"],
 ", to simplify the integration."
}], "Text",ExpressionUUID->"102ec874-51fb-41d8-916f-1357f0a99094"],

