\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Validation of the $m$-mode Held seed. Top row: the modulus of the reduced seed $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \Phi $}\mathaccent "0365{\Phi }^{0\circ }$ on the $N_{z}=21$ LGL grid (circles), obtained by solving \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:reduced eth}\unskip \@@italiccorr )}} in $z$, against the analytic Schwarzschild $\ell $ sum (solid). Bottom row: the pointwise complex error relative to $\qopname  \relax m{max}|\text  {exact}|$. The quoted operator residual is the relative residual of the reduced angular equation when the analytic seed is substituted, and measures the discretization rather than the solve.\relax }}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mmode seed}{{1}{11}{Validation of the $m$-mode Held seed. Top row: the modulus of the reduced seed $\widetilde {\Phi }^{0\circ }$ on the $N_{z}=21$ LGL grid (circles), obtained by solving \eqref {eq:reduced eth} in $z$, against the analytic Schwarzschild $\ell $ sum (solid). Bottom row: the pointwise complex error relative to $\max |\text {exact}|$. The quoted operator residual is the relative residual of the reduced angular equation when the analytic seed is substituted, and measures the discretization rather than the solve.\relax }{figure.caption.17}{}}
\citation{Lo:2023fvv,GSNjl}
\citation{Lo:2023fvv}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Independent modal reference for the adjustment \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:habadjusted}\unskip \@@italiccorr )}}, built from the closed-form Schwarzschild $(\ell ,m)$ components summed at fixed $m$ through $\ell =20$, evaluated at $z=0.37$, $u=\varphi =0$. Each panel shows the reconstructed piece $|2\operatorname  {Re}{\mathcal  S}^{\dagger }\Phi ^{\rm  Adj}|$, the gauge piece $|{\mathcal  L}_{\zeta }g|$, their sum, and the fitted $|A_{-1}|/r$ Laurent coefficient. The individually growing pieces cancel to leave a $1/r$ tail.\relax }}{12}{figure.caption.18}\protected@file@percent }
\newlabel{fig:modal falloff}{{2}{12}{Independent modal reference for the adjustment \eqref {eq:habadjusted}, built from the closed-form Schwarzschild $(\ell ,m)$ components summed at fixed $m$ through $\ell =20$, evaluated at $z=0.37$, $u=\varphi =0$. Each panel shows the reconstructed piece $|2\Re \S ^{\dagger }\Phi ^{\rm Adj}|$, the gauge piece $|\Lie _{\zeta }g|$, their sum, and the fitted $|A_{-1}|/r$ Laurent coefficient. The individually growing pieces cancel to leave a $1/r$ tail.\relax }{figure.caption.18}{}}
