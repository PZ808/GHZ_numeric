@article{Hod2012349,
	Abstract = {The fundamental quasinormal resonances of charged Reissner--Nordstr{\"o}m black holes due to charged scalar perturbations are derived analytically. In the \{WKB\} regime, q Q ≫ ℏ , we obtain a simple expression for the fundamental quasinormal resonances: ω = q Q / r + − i 2 π T \{BH\} ( n + 1 2 ) , where T \{BH\} and Q are the temperature and electric charge of the black hole and q is the electric charge of the field. Remarkably, our results show that the relaxation dynamics of a perturbed Reissner--Nordstr{\"o}m black hole may saturate the recently proposed universal relaxation bound. },
	Author = {Shahar Hod},
