Cell[TextData[Cell[BoxData[
 StyleBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Eth", " ", "and", " ", "EthPrime", " ", "and", " ", "Held", " ", 
      "scalars", " ", "operated", " ", "on", " ", "the", " ", "spin"}], "-", 
     RowBox[{"weighted", " ", "spherical", " ", 
      RowBox[{"harmonics", ".", " ", 
       RowBox[{"Let", "'"}]}], "s", " ", "say", " ", "f"}]}], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{"l", ",", "m"}]], 
     RowBox[{
      SubscriptBox[
       RowBox[{"f", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "s"], 
      SubscriptBox["Y", 
       RowBox[{"l", ",", "m"}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], "."}]}]}]}]}], "Text",
  FontSize->
   12]],ExpressionUUID->"b2c2c79c-ecd1-4df3-9e70-7b7de27891eb"]], "Text",
