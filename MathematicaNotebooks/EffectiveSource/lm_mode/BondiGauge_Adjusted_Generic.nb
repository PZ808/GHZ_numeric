Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[CapitalPhi]HeldModeFunctions", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Build", " ", "the", " ", "four", " ", "Held", " ", "coefficient", " ", 
     "functions", " ", 
     RowBox[{"Phi", "^", 
      RowBox[{"{", 
       RowBox[{"0", " ", "o"}], "}"}]}]}], ",", 
    RowBox[{"Phi", "^", 
     RowBox[{"{", 
      RowBox[{"1", " ", "o"}], "}"}]}], ",", 
    RowBox[{"Phi", "^", 
     RowBox[{"{", 
      RowBox[{"2", " ", "o"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Phi", "^", 
        RowBox[{"{", 
         RowBox[{"3", " ", "o"}], "}"}]}], " ", "using", " ", "the", " ", 
       "equations", " ", 
       RowBox[{
        RowBox[{"thorn", "'"}], "^", "2"}], " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"{", 
         RowBox[{"0", " ", "o"}], "}"}]}]}], "=", 
      RowBox[{
       RowBox[{"...", " ", 
        RowBox[{"thorn", "'"}], " ", 
        RowBox[{"Phi", "^", 
         RowBox[{"{", 
          RowBox[{"1", " ", "o"}], "}"}]}]}], "=", 
       RowBox[{
        RowBox[{"...", " ", 
         RowBox[{"Phi", "^", 
          RowBox[{"{", 
           RowBox[{"2", " ", "o"}], "}"}]}]}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"...", " ", 
             RowBox[{"Phi", "^", 
              RowBox[{"{", 
               RowBox[{"3", " ", "o"}], "}"}]}]}], "=."}], ".."}], " ", 
          "\[IndentingNewLine]", "\n", 
          RowBox[{"\[CapitalPhi]HeldModeFunctions", "[", 
           RowBox[{
           "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", 
            "lmax_Integer", ",", "a_"}], "]"}]}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[Omega]", ",", "pp", ",", "fb", ",", "e1", ",", "e2", ",", "e3",
