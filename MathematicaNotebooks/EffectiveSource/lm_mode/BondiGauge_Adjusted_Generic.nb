          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"L", "->", 
              RowBox[{
               RowBox[{"fbar", "^", "Y_"}], 
               RowBox[{"{", 
                RowBox[{"L", " ", "m", " ", "n", " ", "k"}], "}"}]}]}], ",", 
             "..."}], "|>"}], "."}]}]}]}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"fbAssoc", "=", 
       RowBox[{"fbarHY", "[", 
        RowBox[{"m", ",", "n", ",", "k", ",", "lmax", ",", "a"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"fbAssoc", "===", 
         RowBox[{"<|", "|>"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Lmin", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pad", "=", 
       RowBox[{"OptionValue", "[", "\"\<LPad\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tol", "=", 
       RowBox[{"OptionValue", "[", "\"\<ChopTolerance\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "The", " ", "Held", " ", "angular", " ", "operators", " ", "and", " ", 
        "multiplication", " ", "by", " ", "Kerr", " ", "background", " ", 
        "quantities", " ", "generate", " ", "neighboring", " ", "spherical", " ", 
        RowBox[{"multipoles", ".", "Therefore"}], " ", "evaluate", " ", 
        "Phi_j", " ", "on", " ", "a", " ", "slightly", " ", "larger", " ", 
        "L", " ", "interval", " ", "than", " ", "the", " ", "one", " ", 
        "initially", " ", "occupied", " ", "by", " ", 
        RowBox[{"fbarHY", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"LmaxOut", "=", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Keys", "[", "fbAssoc", "]"}], "]"}], "+", "pad"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "The", " ", "exact", " ", "stationary", " ", "mode", " ", "is", " ", 
         "treated", " ", 
         RowBox[{"separately", ".", "For"}], " ", "the", " ", "radiative", " ",
          "adjustment", " ", "used", " ", "here"}], ",", 
        RowBox[{
         RowBox[{"fH", "~", "omega"}], "^", "3"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"while", " ", "the", " ", "expressions", " ", "for", " ", 
           RowBox[{"Phi", "^", "0"}], " ", "and", " ", 
           RowBox[{"Phi", "^", "1"}], " ", "involve", " ", "inverse", " ", 
           "powers", " ", "of", " ", "omega", " ", "after", " ", "solving", " ",
            "the", " ", 
           RowBox[{"thorn", "'"}], " ", 
           RowBox[{"equations", ".", "Rather"}], " ", "than", " ", "evaluate",
            " ", "the", " ", "generic", " ", "omega"}], "!=", 
          RowBox[{"0", " ", "formulas", " ", "at", " ", "omega"}]}], "=", 
         "0"}], ",", 
        RowBox[{
        "return", " ", "an", " ", "empty", " ", "radiative", " ", 
         "contribution", " ", 
         RowBox[{"here", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Exact", " ", "stationary", " ", "mode", " ", "treated", " ", 
        RowBox[{"separately", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"PossibleZeroQ", "[", "\[Omega]", "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", "|>"}], "]"}]}], "]"}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"funcs", "=", 
       RowBox[{"\[CapitalPhi]HeldModeFunctions", "[", 
        RowBox[{"m", ",", "n", ",", "k", ",", "lmax", ",", "a"}], "]"}]}], ";",
       "\n", "\[IndentingNewLine]", 
      RowBox[{"sampleHeldMode", "[", 
       RowBox[{
        RowBox[{"funcs", "[", "j", "]"}], ",", "m", ",", "Lmin", ",", 
        "LmaxOut", ",", "tol"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
