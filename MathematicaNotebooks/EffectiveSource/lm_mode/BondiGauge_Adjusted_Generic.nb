Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"fHS", ",", "fHS\[Dagger]", ",", "fbarHS"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fHS", "[", 
      RowBox[{
      "L_Integer", ",", "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", 
       "a_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Omega]", "=", 
         RowBox[{"\[Omega]mnk", "[", 
          RowBox[{"m", ",", "n", ",", "k"}], "]"}]}], "}"}], ",", 
       RowBox[{
        FractionBox[
         RowBox[{"32", " ", "\[ImaginaryI]", " ", "*", 
          SuperscriptBox["\[Omega]", "3"]}], 
         RowBox[{"Starobinsky\[ScriptCapitalC]", "[", 
          RowBox[{"L", ",", "m", ",", "a", ",", "\[Omega]"}], "]"}]], "*", 
        RowBox[{"\[Psi]05HS", "[", 
         RowBox[{"L", ",", "m", ",", "n", ",", "k"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"only", " ", "spheroidal", " ", "amplitude"}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fbarHS", "[", 
      RowBox[{
      "L_Integer", ",", "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", 
       "a_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
      RowBox[{"cconj", "[", 
       RowBox[{"fHS", "[", 
        RowBox[{"L", ",", 
         RowBox[{"-", "m"}], ",", 
         RowBox[{"-", "n"}], ",", 
         RowBox[{"-", "k"}], ",", "a"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fHS\[Dagger]", "[", 
      RowBox[{
      "L_Integer", ",", "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", 
       "a_"}], "]"}], ":=", 
     RowBox[{"Conjugate", "@", 
      RowBox[{"fHS", "[", 
       RowBox[{"L", ",", "m", ",", "n", ",", "k", ",", "a"}], "]"}]}]}], 
    ";"}], "  "}]}]], "Input",
