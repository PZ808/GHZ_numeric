Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[Lambda]", ",", "\[Lambda]s", ",", "Starobinsky\[ScriptCapitalC]"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]s", "[", 
     RowBox[{"s_", ",", "l_", ",", "m_", ",", "a\[Omega]_"}], "]"}], ":=", 
    RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
     RowBox[{"s", ",", "l", ",", "m", ",", "a\[Omega]"}], "]"}]}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"above", " ", "\\", "mathcal"}], " ", "C_", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\\", "ell"}], " ", 
       RowBox[{"m", " ", "\\", "omega"}]}], "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\\", "mathfrak"}], " ", "C_", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{
        RowBox[{"\\", "ell"}], " ", "m"}]}], "}"}], 
     RowBox[{"(", 
      RowBox[{"a", "\\", "omega"}], ")"}], " ", "in", " ", "my", " ", 
     "notes"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Starobinsky\[ScriptCapitalC]", "[", 
    RowBox[{"l_", ",", "m_", ",", "a_", ",", "\[Omega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[Lambda]lm", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"use", " ", "the", " ", "s"}], "=", 
       RowBox[{"2", " ", 
        RowBox[{"e", "'"}], "val"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Lambda]lm", "=", 
       RowBox[{"\[Lambda]s", "[", 
        RowBox[{"2", ",", "l", ",", "m", ",", 
         RowBox[{"a", " ", "\[Omega]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Lambda]lm", "+", "4"}], ")"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Lambda]lm", "+", "6"}], ")"}], "^", "2"}]}], "+", 
       RowBox[{"144", " ", 
        RowBox[{"M", "^", "2"}], " ", 
        RowBox[{"\[Omega]", "^", "2"}]}], "+", 
       RowBox[{"8", " ", "a", " ", "\[Omega]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Lambda]lm", "+", "4"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", "\[Lambda]lm"}], "+", "26"}], ")"}], " ", 
        RowBox[{"(", 
