Cell[CellGroupData[{

Cell["Setup", "Subsection",
 CellChangeTimes->{{3.998454426422716*^9, 
  3.99845442799886*^9}},ExpressionUUID->"01e141d3-526b-46ea-8d78-\
b0cae6c756f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "canonicalNKQ", ",", "canonicalModeQ", ",", "cplusKey", ",", 
     "computeCplusMode"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
   "define", " ", "the", " ", "canonical", " ", "half", " ", "of", " ", "the",
     " ", 
    RowBox[{"\\(", 
     RowBox[{"(", 
      RowBox[{"m", ",", "n", ",", "k"}], ")"}], "\\)"}], " ", 
    RowBox[{"lattice", ":"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"canonicalNKQ", "[", 
    RowBox[{"n_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"n", ">", "0"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"n", "==", "0"}], "&&", 
      RowBox[{"k", ">=", "0"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"canonicalModeQ", "[", 
     RowBox[{"m_", ",", "n_", ",", "k_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"m", ">", "0"}], "||", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"m", "==", "0"}], "&&", 
       RowBox[{"canonicalNKQ", "[", 
        RowBox[{"n", ",", "k"}], "]"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "  ", 
   RowBox[{
   "worker", " ", "that", " ", "does", " ", "only", " ", "the", " ", 
    "expensive", " ", 
    RowBox[{"calculation", ":"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"computeCplusMode", "[", 
    RowBox[{"{", 
     RowBox[{"l_", ",", "m_", ",", "n_", ",", "k_"}], "}"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "amp", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"amp", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"TeukolskyPointParticleMode", "[", 
             RowBox[{
             "Weylspin", ",", "l", ",", "m", ",", "n", ",", "k", ",", 
              "orbit"}], "]"}], "[", "\"\<Amplitudes\>\"", "]"}], 
           "[", "\"\<\[ScriptCapitalI]\>\"", "]"}], ",", "$Failed"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "}"}], ",", "amp"}], 
       "}"}]}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Key", " ", "accessor"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cplusKey", "[", 
    RowBox[{"s_", ",", "l_", ",", "m_", ",", "n_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"s", ",", "l", ",", "m", ",", "n", ",", "k"}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998454374119392*^9, 3.998454407259244*^9}, {
  3.998456749250908*^9, 3.9984567496263027`*^9}, {3.9984568882067947`*^9, 
  3.9984568886374893`*^9}, {3.9984575069703712`*^9, 3.998457508968082*^9}, {
  3.998496590325199*^9, 3.998496596954465*^9}},
 CellLabel->
  "In[1144]:=",ExpressionUUID->"f08e7257-704f-4c32-b2db-25dcb04dd986"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Parallel (over ell ) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["C", "+"], " "}], TraditionalForm]],ExpressionUUID->
  "af74b078-84f4-4aef-a461-78a6c007e640"],
 "Run"
}], "Subsection",
 CellChangeTimes->{{3.998454441721299*^9, 3.998454451883716*^9}, {
   3.998456626208272*^9, 3.998456652127738*^9}, 
   3.998473852444847*^9},ExpressionUUID->"a1bf4546-931a-4a58-90b4-\
1a1301b93456"],

Cell["\<\
Procedure: 
1. load the existing ell WXF if present;
2. generate the canonical modes for that ell
3. remove modes already cached;
4. compute only the missing ones in parallel;
5. add each result and its (-m, -n, -k) symmetry partner;
6. write the updated ell cache immediately to disk;
7. merge it into a global CplusCache so Cplus[ ...] works during the session .\
\>", "Text",
 CellChangeTimes->{{3.998456608412747*^9, 3.9984566225582952`*^9}, {
  3.998456658188555*^9, 
  3.998456690670957*^9}},ExpressionUUID->"a43a8190-fb8b-46c6-b82c-\
8916801b1d68"],

Cell["For small lmax, nmax, kmax we can do this on the fly", "Text",
 CellChangeTimes->{{3.998454413780559*^9, 3.998454413782793*^9}, {
  3.998456916912273*^9, 3.998456924761262*^9}, {3.998473262352399*^9, 
  3.9984732799830437`*^9}},ExpressionUUID->"dea7cee8-22f8-42a3-887f-\
7485c191b227"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LaunchKernels", "[", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{"orbit", ",", "Weylspin", ",", "computeCplusMode"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ParallelNeeds", "[", "\"\<Teukolsky`\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"modesThisL", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "0", ",", "l"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "nmin", ",", "nmax"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}], ",", 
           "2"}], "]"}], ",", 
         RowBox[{
          RowBox[{"canonicalModeQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{"computeCplusMode", ",", "modesThisL", ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Assign", " ", "only", " ", "on", " ", "main", " ", "kernel"}],
        "*)"}], 
      RowBox[{"Scan", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"result", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "lm", ",", "amp", ",", "ll", ",", "mm", ",", "nn", ",", "kk"}], 
             "}"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"lm", ",", "amp"}], "}"}], "=", "result"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"ll", ",", "mm", ",", "nn", ",", "kk"}], "}"}], "=", 
              "lm"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"amp", "=!=", "$Failed"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cplus", "[", 
                  RowBox[{
                  "Weylspin", ",", "ll", ",", "mm", ",", "nn", ",", "kk"}], 
                  "]"}], "=", "amp"}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"mm", "==", "0"}], "&&", 
                    RowBox[{"nn", "==", "0"}], "&&", 
                    RowBox[{"kk", "==", "0"}]}], ")"}]}], ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Cplus", "[", 
                    RowBox[{"Weylspin", ",", "ll", ",", 
                    RowBox[{"-", "mm"}], ",", 
                    RowBox[{"-", "nn"}], ",", 
                    RowBox[{"-", "kk"}]}], "]"}], "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"ll", "+", "kk"}], ")"}]}], " ", 
                    RowBox[{"Conjugate", "[", "amp", "]"}]}]}], ";"}]}], 
                 "]"}], ";"}]}], "]"}], ";"}]}], "]"}]}], "]"}], ",", 
        "results"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], "]"}], ",",
    "l"}], "]"}]}], "Input",
 CellChangeTimes->{{3.998454488869919*^9, 3.998454495289668*^9}, 
   3.998456915782144*^9, 3.9984704310498123`*^9},
 CellLabel->
  "In[1150]:=",ExpressionUUID->"4e3adbd1-ea77-424b-bd92-bf7e75cf6379"],

