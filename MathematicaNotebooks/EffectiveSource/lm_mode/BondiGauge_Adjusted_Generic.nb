 RowBox[{
  RowBox[{"This", " ", "prefactor", " ", "in", " ", "Schw", " ", "is", " ", 
   FractionBox[
    RowBox[{"2", "\[ImaginaryI]", "*", 
     SuperscriptBox["\[Omega]", "3"]}], 
    RowBox[{
     RowBox[{
      FractionBox["1", "16"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"l", "+", "2"}], ")"}], "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}], "2"], 
      SuperscriptBox["l", "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"l", "-", "1"}], ")"}], "2"]}], "+", 
     RowBox[{"9", 
      SuperscriptBox["M", "2"], 
      SuperscriptBox["\[Omega]", "2"]}]}]]}], ",", " ", 
  RowBox[{
  "which", " ", "gives", " ", "the", " ", "normalization", " ", "anchor", " ",
    "for", " ", 
   RowBox[{"Kerr", "."}]}]}]}], "Text",
