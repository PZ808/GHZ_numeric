Cell[CellGroupData[{

Cell["Compute asymptotic amplitude with BHPT ", "Section",
 Evaluatable->False,
 CellChangeTimes->{
  3.8738760584608297`*^9, {3.9979368589039173`*^9, 3.997936862653947*^9}, {
   3.998374168449345*^9, 3.998374204087132*^9}, {3.998384051996089*^9, 
   3.998384077821583*^9}, 
   3.998453901039115*^9},ExpressionUUID->"b84e151d-1b95-4577-9bbb-\
63cf196e182d"],

Cell[TextData[{
 "For generic circular orbits, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "mnk"], "=", 
    RowBox[{
     SubscriptBox["m\[CapitalOmega]", "\[CurlyPhi]"], "+", 
     SubscriptBox["n\[CapitalOmega]", "r"], "+", 
     SubscriptBox["k\[CapitalOmega]", "\[Theta]"], " "}]}], TraditionalForm]],
  ExpressionUUID->"69d44353-c49e-4000-8fb7-f4575af9ff02"],
 " one uses TeukolskyPointParticleMode with the given orbit and l,m,n,k and \
spin s. ",
 StyleBox["We use the fact that,  ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["C", "\[PlusMinus]"], ")"}], 
     RowBox[{
      RowBox[{"l", "-", "m"}], ",", 
      RowBox[{"-", "n"}], ",", 
      RowBox[{"-", "k"}]}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"l", "+", "k"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["C", "lmnk", "\[PlusMinus]"], ")"}], "*"]}]}], 
   TraditionalForm]],ExpressionUUID->"afe5c4e7-4830-44be-a84c-88a306f87ab1"],
 StyleBox[", due to the polar reflection symmetry of the Spheroidal \
functions.",
  FontColor->GrayLevel[0]]
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.872920845845791*^9, 3.87292096710155*^9}, {
