Cell[TextData[{
 "Computes, for a generic orbit the asymptotic amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99e9f746-40a5-4d8f-96bd-10d8d09d7101"],
 "~ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[Psi]", 
      RowBox[{"5", "\[Degree]"}]], "0"], 
    SuperscriptBox["r", 
     RowBox[{"-", "5"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c8a87f83-8579-44f2-8b61-106b2d900237"],
 " from the lm coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     SuperscriptBox["C", "+"], ")"}], "lm"], TraditionalForm]],ExpressionUUID->
  "4d2f8bdc-53ea-477f-98dc-7b708868c815"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[Psi]", 
       RowBox[{"5", "o"}]], "0"], "(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", "lmnk"], " ", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox["C", "+"], ")"}], 
       SubscriptBox["lm\[Omega]", "nk"]], 
      RowBox[{
       SubscriptBox["S", 
        SubscriptBox["lm\[Omega]", "nk"]], "(", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "534fc0fd-fb32-4fb4-bdd5-038d09157cf3"],
 ". The algorithm is: \n\n",
