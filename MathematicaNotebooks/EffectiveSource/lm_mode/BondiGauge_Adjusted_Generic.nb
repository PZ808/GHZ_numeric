Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "+", "2"}], ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "+", "1"}], ")"}], "2"], 
     SuperscriptBox["l", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "-", "1"}], ")"}], "2"]}], "==", 
    RowBox[{
     SuperscriptBox["l", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "l"}], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "l", "+", 
        SuperscriptBox["l", "2"]}], ")"}], "2"]}]}], ")"}], "//", 
  "FullSimplify"}]], "Input",
 Evaluatable->False,
