Cell[CellGroupData[{

Cell["Global Assumptions", "Section",
 CellChangeTimes->{{3.9984535508261127`*^9, 
  3.998453556737376*^9}},ExpressionUUID->"4246e11f-10f9-4805-8c9d-\
6cc1cbdb2e29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{
    RowBox[{"M", ">", "0"}], "&&", 
    RowBox[{"0", "<", "a", "<=", "M"}], "&&", 
    RowBox[{"r", ">", "0"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"M", ",", "a", ",", "\[Omega]", ",", "r"}], "}"}], ",", 
      "Reals"}], "]"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
