       RowBox[{"a", "<=", "1"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", ",", "a", ",", "\[Omega]", ",", "r"}], "}"}], ",", 
