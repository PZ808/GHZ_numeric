Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"cSM", ",", "bSM", ",", "CosThetaMatrix"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cSM", "[", 
     RowBox[{"l_", ",", "s_", ",", "m_"}], "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "^", "2"}], "-", 
          RowBox[{"m", "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "^", "2"}], "-", 
          RowBox[{"s", "^", "2"}]}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", " ", 
           RowBox[{"l", "^", "2"}]}], "-", "1"}], ")"}]}], ")"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bSM", "[", 
     RowBox[{"l_", ",", "s_", ",", "m_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", "s"}], " ", 
     RowBox[{"m", "/", 
      RowBox[{"(", 
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], ")"}]}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CosThetaMatrix", "[", 
     RowBox[{"s_", ",", "m_", ",", "ells_List"}], "]"}], ":=", 
    RowBox[{"SparseArray", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"L", "==", 
          RowBox[{"lp", "+", "1"}]}], ",", 
         RowBox[{"cSM", "[", 
          RowBox[{
           RowBox[{"lp", "+", "1"}], ",", "s", ",", "m"}], "]"}], ",", 
         RowBox[{"L", "==", "lp"}], ",", 
         RowBox[{"bSM", "[", 
          RowBox[{"lp", ",", "s", ",", "m"}], "]"}], ",", 
         RowBox[{"L", "==", 
          RowBox[{"lp", "-", "1"}]}], ",", 
         RowBox[{"cSM", "[", 
          RowBox[{"lp", ",", "s", ",", "m"}], "]"}], ",", "True", ",", "0"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "ells"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"lp", ",", "ells"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "construct", " ", "the", " ", "cos", " ", "coupling", " ", "matrix", " ", 
    "for", " ", "all", " ", "ells"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cmat", "[", 
    RowBox[{"s_", ",", "m_"}], "]"}], "=", 
   RowBox[{"CosThetaMatrix", "[", 
    RowBox[{"s", ",", "m", ",", "ells"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998501484480579*^9, 3.998501485080014*^9}, {
  3.998501774893121*^9, 
  3.998501803542708*^9}},ExpressionUUID->"6563814f-70e3-4abf-b498-\
a164a12fa523"]
}, Closed]]
}, Closed]],

