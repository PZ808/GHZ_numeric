Cell[CellGroupData[{

Cell["Correctly re-enable evaluation property", "Subsubsubsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.762002514219326*^9, 
  3.7620025247075577`*^9}},ExpressionUUID->"e59e5fc2-c521-497d-8a00-\
306bdc11fd7f"],

Cell["\<\
\tThis part of the above code creates a docked button that easily allows to \
deactivate cell evaluation and re - enable it,
\twhile keeping the texts, outputs,etc default (not evaluable).  \
Specifically, \[OpenCurlyDoubleQuote]re-enable\[CloseCurlyDoubleQuote] in \
fact just sets properties back to default.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.7620025283983707`*^9, 3.762002653775247*^9}, {
  3.767333803125916*^9, 3.767333810069026*^9}, {3.767334453236224*^9, 
  3.767334455964188*^9}, {3.8979745502005777`*^9, 
  3.897974554274568*^9}},ExpressionUUID->"f937f148-cf35-479f-93e7-\
5bfeba07df07"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonevaluable", " ", "=", " ", 
    RowBox[{"ToBoxes", "@", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Button", "[", 
         RowBox[{
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CurrentValue", "[", 
            RowBox[{
             RowBox[{"SelectedCells", "@", 
              RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
            "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.767333531414897*^9, 3.767333548375959*^9}, {
   3.7673336081872797`*^9, 3.767333622683069*^9}, {3.767333752783671*^9, 
   3.767333761976211*^9}, 3.77002782470183*^9, {3.8979745565450783`*^9, 
   3.897974561744177*^9}, {3.9195693402399817`*^9, 3.919569340428852*^9}},
 CellLabel->
  "In[430]:=",ExpressionUUID->"ea0906d3-7782-440d-a182-a42f5595f870"],

Cell["\<\
\tThe below code does the same thing, but it creates a palette instead. Kept \
it for archive purposes.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.7673338322712193`*^9, 3.767333874132453*^9}, {
  3.77002894251302*^9, 3.770028946009004*^9}, {3.897974564326116*^9, 
  3.897974564685095*^9}},ExpressionUUID->"e7f3f61d-4313-4120-ad57-\
f8d4b5378a97"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{"CreatePalette", "@", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Button", "[", 
       RowBox[{
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<Evaluatable -> ``\>\"", ",", "#"}], "]"}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"CurrentValue", "[", 
          RowBox[{
           RowBox[{"SelectedCells", "@", 
            RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
          "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.762002661603444*^9, 3.7620026639591093`*^9}, {
  3.7673338237102613`*^9, 3.767333827148489*^9}, {3.897974569615777*^9, 
  3.897974575393712*^9}, {3.9984736349133263`*^9, 
  3.9984736374667397`*^9}},ExpressionUUID->"74cebfcc-5929-4a6d-b367-\
e64e2efa067b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Full docked buttons", "Subsubsubsubsection",
 CellChangeTimes->{{3.767334421497847*^9, 
  3.767334428492256*^9}},ExpressionUUID->"4f1e98ef-9a14-4ff0-bab0-\
c019908a979c"],

Cell["\<\
\t\t\t\tImplementation of each part as a docked cell. For adding new \
features, simply create new data as shown for the above two buttons, i.e. \
ToBoxes[stuff] and then put it inside the BoxData.
\t\t\t\tThe next lines shoul not be touched and their purpose is to make the \
toolbar expand/collapse upon clicking of the bottom panel.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.7700290356860733`*^9, 3.770029173865818*^9}, 
   3.8833786476108437`*^9},ExpressionUUID->"4572b6be-8150-4c88-900f-\
d6db9a90d3b5"],

Cell[BoxData[
 RowBox[{"\t\t\t\t", 
  RowBox[{
   RowBox[{
    RowBox[{"fullDockedCellsWithCollapseToolbar", "=", 
     RowBox[{"Cell", "[", 
      RowBox[{
       RowBox[{"BoxData", "[", 
        RowBox[{"{", 
         RowBox[{"buttonalignment", ",", "buttonevaluable"}], "}"}], "]"}], ",",
        " ", "\[IndentingNewLine]", "\t\t\t\t\t", 
       RowBox[{"CellFrameLabelMargins", "\[Rule]", "0"}], ",", 
       RowBox[{"CellFrameLabels", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ButtonBox", "[", 
             RowBox[{"\"\<\>\"", ",", "\[IndentingNewLine]", "\t\t\t\t", 
              RowBox[{"ButtonFunction", "\[RuleDelayed]", 
               RowBox[{"Function", "[", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"pc", "=", 
                    RowBox[{"ParentCell", "@", 
                    RowBox[{"EvaluationCell", "[", "]"}]}]}], "}"}], ",", 
                  RowBox[{"SetOptions", "[", 
                   RowBox[{"pc", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"CurrentValue", "[", 
                    RowBox[{"pc", ",", "CellSize"}], "]"}], "===", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "Inherited"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                    "\t\t\t\t", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "Inherited"}]}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "0"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"\"\<CellMinHeight\>\"", "\[Rule]", "0"}], 
                    "}"}]}], ",", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "0"}]}], "}"}]}], 
                    "]"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"ImageSize", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Scaled", "[", "2", "]"}], ",", "15"}], "}"}]}], ",", 
              RowBox[{"Evaluator", "\[Rule]", "Automatic"}]}], "]"}], ",", 
            "None"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\t\t\t\t", 
   RowBox[{"SetOptions", "[", 
    RowBox[{
     RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
     RowBox[{
     "DockedCells", "\[Rule]", "fullDockedCellsWithCollapseToolbar"}]}], 
    "]"}], "\[IndentingNewLine]", "\t\t\t\t", 
   RowBox[{"Clear", "[", 
    RowBox[{"buttonalignment", ",", "buttonevaluable"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.770025318638297*^9, 3.770025318638781*^9}, {
   3.7700258231894093`*^9, 3.7700258521002827`*^9}, {3.7700258828440104`*^9, 
   3.7700258870832376`*^9}, {3.7700259317144413`*^9, 3.770025976112444*^9}, {
   3.770026061774335*^9, 3.770026071117613*^9}, {3.770026102893291*^9, 
   3.770026135444914*^9}, {3.770026210274729*^9, 3.770026214713163*^9}, 
   3.7700275691012383`*^9, {3.7700276111871347`*^9, 3.770027691976449*^9}, {
   3.7700289970957003`*^9, 3.770029026902608*^9}},
 CellLabel->
  "In[431]:=",ExpressionUUID->"fd42c861-fcad-4367-bcab-ae0588df6248"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Timestamp", "Subsubsubsection",
 CellChangeTimes->{{3.7609672865582323`*^9, 
  3.760967289016127*^9}},ExpressionUUID->"ad76a9c5-d055-484f-a52a-\
705f167eba5c"],

Cell["\<\
\tThis code puts a timestamp at the beginning of the document whenever one \
saves the notebook.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.7609672941787767`*^9, 3.760967324173888*^9}, {
  3.761398612129731*^9, 3.7613986341451473`*^9}, {3.761758082757056*^9, 
  3.7617580832600822`*^9}, {3.897974497513751*^9, 
  3.8979744989287558`*^9}},ExpressionUUID->"dead7875-6402-494b-89e1-\
8b9a3c9b2619"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{"SetOptions", "[", 
   RowBox[{
    RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
    RowBox[{"NotebookEventActions", "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<MenuCommand\>\"", ",", "\"\<Save\>\""}], "}"}], "\[RuleDelayed]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], "=", 
            "\[IndentingNewLine]", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"LinkWrite", "[", 
                  RowBox[{
                   RowBox[{"First", "[", "$FrontEnd", "]"}], ",", 
                   RowBox[{"FrontEnd`Value", "[", "#", "]"}]}], "]"}], ";", 
                 " ", 
                 RowBox[{"LinkRead", "[", 
                  RowBox[{"First", "[", "$FrontEnd", "]"}], "]"}]}], ")"}], 
               "&"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Day\>\"", ",", "\"\<MonthName\>\"", 
                ",", "\"\<Year\>\""}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"NotebookLocate", "[", "\"\<LastModified\>\"", "]"}], ";", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"NotebookWrite", "[", 
            RowBox[{
             RowBox[{"InputNotebook", "[", "]"}], ",", 
             RowBox[{"Cell", "[", 
              RowBox[{
               RowBox[{"TextData", "[", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Last modified:  \>\"", ",", "dy", 
                  ",", "\"\< \>\"", ",", "mn", ",", "\"\< \>\"", ",", "yr"}], 
                 "}"}], "]"}], ",", "\"\<Text\>\"", ",", 
               RowBox[{"CellTags", "\[Rule]", "\"\<LastModified\>\""}]}], 
              "]"}]}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"PassEventsDown", "\[Rule]", "True"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.760964509197397*^9, 3.7609645823273706`*^9}, {
   3.760966262536373*^9, 3.7609664206695004`*^9}, 3.760966456308247*^9, 
   3.761398604306072*^9, {3.761398961482812*^9, 3.761398992153411*^9}, {
   3.7614926911149197`*^9, 3.7614926919219093`*^9}, {3.761758089102713*^9, 
   3.7617581142272997`*^9}, {3.892873603824644*^9, 3.892873621743348*^9}, {
   3.897974500327571*^9, 3.8979745056926317`*^9}},
 CellLabel->
  "In[434]:=",ExpressionUUID->"1b3963fb-e157-4d87-9459-61497b77a9fa"]
}, Open  ]]
}, Closed]]
}, Closed]],

