Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[CapitalPhi]AdjustmentYVector", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalPhi]AdjustmentYVector", "[", 
   RowBox[{
   "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", "lmaxOut_Integer", ",",
     "a_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "lmin", ",", "ells", ",", "Cmat", ",", "Rmat", ",", "\[Phi]0", ",", 
      "\[Phi]1", ",", "\[Phi]2", ",", "\[Phi]3", ",", "result"}], "}"}], ",", 
    
    RowBox[{"(*", 
     RowBox[{"spin", "-", 
      RowBox[{
      "2", " ", "spherical", " ", "harmonics", " ", "begin", " ", "here"}]}], 
     "*)"}], 
    RowBox[{
     RowBox[{"lmin", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"2", ",", 
        RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Need", "+", 
       RowBox[{"3", " ", "because", " ", "of", " ", 
        RowBox[{"rho", "^", 
         RowBox[{"{", 
          RowBox[{"-", "3"}], "}"}]}]}]}], "*)"}], 
     RowBox[{"ells", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"lmin", ",", 
        RowBox[{"lmaxOut", "+", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", 
      RowBox[{"multiplication", " ", "by", " ", "cos", 
       RowBox[{"(", "theta", ")"}]}], "*)"}], 
     RowBox[{"Cmat", "=", 
      RowBox[{"CosThetaMatrix", "[", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "m", ",", "ells"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"multiplication", " ", "by", " ", 
        RowBox[{"1", "/", "rho"}]}], "=", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        RowBox[{"i", " ", "a", " ", "cos", 
         RowBox[{"(", "theta", ")"}]}]}]}], "*)"}], 
     RowBox[{"Rmat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "r"}], " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{
          RowBox[{"Length", "[", "ells", "]"}], ",", "SparseArray"}], "]"}]}],
        "+", 
       RowBox[{"I", " ", "a", " ", "Cmat"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Original", " ", "ell", " ", "coefficients"}], "*)"}], 
     RowBox[{"\[Phi]0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalPhi]0H", "[", 
         RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ells"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalPhi]1H", "[", 
         RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ells"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]2", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalPhi]2H", "[", 
         RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ells"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]3", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalPhi]3H", "[", 
         RowBox[{"l", ",", "m", ",", "n", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ells"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"\[Phi]0", "+", 
       RowBox[{"Rmat", ".", "\[Phi]1"}], "+", 
       RowBox[{"Rmat", ".", 
        RowBox[{"(", 
         RowBox[{"Rmat", ".", "\[Phi]2"}], ")"}]}], "+", 
       RowBox[{"Rmat", ".", 
        RowBox[{"(", 
         RowBox[{"Rmat", ".", 
          RowBox[{"(", 
           RowBox[{"Rmat", ".", "\[Phi]3"}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"ells", "->", "result"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.998501644779413*^9, 3.99850164478214*^9}, {
  3.998501872742684*^9, 3.998501874382895*^9}, {3.998502010156571*^9, 
