Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "spheroidalToSphericalCoefficients", "]"}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "spheroidalToSphericalCoefficients", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<NumTerms\>\"", "->", "30"}], ",", 
      RowBox[{"\"\<ChopTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "25"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spheroidalToSphericalCoefficients", "[", 
    RowBox[{"s_Integer", ",", "l_Integer", ",", "m_Integer", ",", 
     RowBox[{"aw_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"spheroidalToSphericalCoefficients", "[", 
     RowBox[{"s", ",", "l", ",", "m", ",", "aw", ",", "opts"}], "]"}], "=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"S", ",", "coeffs", ",", "tol"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tol", "=", 
        RowBox[{"OptionValue", "[", "\"\<ChopTolerance\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"S", "=", 
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", "\[IndentingNewLine]", 
         RowBox[{
         "s", ",", "l", ",", "m", ",", "aw", ",", "\[IndentingNewLine]", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<SphericalExpansion\>\"", ",", 
             RowBox[{"\"\<NumTerms\>\"", "->", 
              RowBox[{"OptionValue", "[", "\"\<NumTerms\>\"", "]"}]}]}], 
            "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeffs", "=", 
        RowBox[{"S", "[", "\"\<ExpansionCoefficients\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Association", "@", "\[IndentingNewLine]", 
        RowBox[{"Select", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Normal", "[", "coeffs", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"Last", "[", "#", "]"}], "]"}], ">", "tol"}], "&"}]}], 
         "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]}],
