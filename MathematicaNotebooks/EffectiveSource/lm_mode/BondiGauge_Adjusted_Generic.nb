  3.998479218275805*^9}},ExpressionUUID->"9f8f19ff-5a88-4cf3-b9ca-\
85b33be88754"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpinRules", ":=", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"g_", "+", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Enclose", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ConfirmAssert", "[", 
          RowBox[{
           RowBox[{
