        RowBox[{"\[Omega]", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"\[Lambda]lm", "+", "4"}], ")"}]}], "+", 
          RowBox[{"3", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "-", 
              RowBox[{"a", " ", "\[Omega]"}]}], ")"}], "^", "2"}]}]}], 
         ")"}]}]}]}]}], "]"}]}], ";"}]}], "Input",
