   RowBox[{
    RowBox[{"simplify", "[", "f_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fsimplify", "[", "f_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], 
