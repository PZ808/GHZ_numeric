   RowBox[{
    RowBox[{"simplifyRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r0", ">", "0"}], ",", 
       RowBox[{"l", ">=", "2"}], ",", 
       RowBox[{"Element", "[", 
