Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"compute", " ", "the", " ", "geodesic", " ", "frequencies", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"in", " ", "BL", " ", "time"}], ",", " ", 
      RowBox[{
       RowBox[{"but", " ", "since", " ", 
        RowBox[{"du", "/", "dt"}]}], " ", "=", " ", 
       RowBox[{"1", " ", "they", " ", "are", " ", "the", " ", "same"}]}]}], 
     ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]r", ",", "\[CapitalOmega]\[Theta]", ",", 
       "\[CapitalOmega]\[CurlyPhi]"}], "}"}], "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Values", "[", 
        RowBox[{"KerrGeoFrequencies", "[", 
         RowBox[{
         "aKerr", ",", "semiLatus$p0", ",", "eccentricity$e0", ",", 
          "cos\[Chi]0"}], "]"}], "]"}], ",", "HP"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Precision", "@", "%"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"build", " ", "\[Omega]"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[Omega]m", ",", "\[Omega]mnk"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]m", "[", 
     RowBox[{"m_", ",", "n_", ",", "k_"}], "]"}], ":=", 
    RowBox[{"m", "*", "\[CapitalOmega]\[CurlyPhi]"}]}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]mnk", "[", 
     RowBox[{"m_", ",", "n_", ",", "k_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"m", "*", "\[CapitalOmega]\[CurlyPhi]"}], " ", "+", " ", 
