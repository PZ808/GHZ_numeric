Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[CapitalPhi]HeldModeFunctions", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Build", " ", "the", " ", "four", " ", "Held", " ", "coefficient", " ", 
     "functions", " ", 
     RowBox[{"Phi", "^", 
      RowBox[{"{", 
       RowBox[{"0", " ", "o"}], "}"}]}]}], ",", 
    RowBox[{"Phi", "^", 
     RowBox[{"{", 
      RowBox[{"1", " ", "o"}], "}"}]}], ",", 
    RowBox[{"Phi", "^", 
     RowBox[{"{", 
      RowBox[{"2", " ", "o"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Phi", "^", 
        RowBox[{"{", 
         RowBox[{"3", " ", "o"}], "}"}]}], " ", "using", " ", "the", " ", 
       "equations", " ", 
       RowBox[{
        RowBox[{"thorn", "'"}], "^", "2"}], " ", 
       RowBox[{"Phi", "^", 
        RowBox[{"{", 
         RowBox[{"0", " ", "o"}], "}"}]}]}], "=", 
      RowBox[{
       RowBox[{"...", " ", 
        RowBox[{"thorn", "'"}], " ", 
        RowBox[{"Phi", "^", 
         RowBox[{"{", 
          RowBox[{"1", " ", "o"}], "}"}]}]}], "=", 
       RowBox[{
        RowBox[{"...", " ", 
         RowBox[{"Phi", "^", 
          RowBox[{"{", 
           RowBox[{"2", " ", "o"}], "}"}]}]}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"...", " ", 
             RowBox[{"Phi", "^", 
              RowBox[{"{", 
               RowBox[{"3", " ", "o"}], "}"}]}]}], "=."}], ".."}], " ", 
          "\[IndentingNewLine]", "\n", 
          RowBox[{"\[CapitalPhi]HeldModeFunctions", "[", 
           RowBox[{
           "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", 
            "lmax_Integer", ",", "a_"}], "]"}]}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[Omega]", ",", "pp", ",", "fb", ",", "e1", ",", "e2", ",", "e3",
              ",", "epE1", ",", "epE2", ",", "ep2E2", ",", "six", ",", "phi0",
              ",", "phi1", ",", "phi2", ",", "phi3", ",", "\[CapitalPsi]H", ",",
              "\[Rho]pH"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Omega]", "=", 
             RowBox[{"\[Omega]mnk", "[", 
              RowBox[{"m", ",", "n", ",", "k"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pp", "=", 
             RowBox[{
              RowBox[{"-", " ", "\[ImaginaryI]"}], " ", "\[Omega]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"\[Rho]pH", "=", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "2"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"\[CapitalPsi]H", "=", "M"}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"fb", "=", 
             RowBox[{"fbarYMode", "[", 
              RowBox[{"n", ",", "k", ",", "lmax", ",", "a"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"eth", " ", "f"}], ",", 
              RowBox[{
               RowBox[{"eth", "^", "2"}], " ", "f"}], ",", 
              RowBox[{
               RowBox[{"eth", "^", "3"}], " ", "f"}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"e1", "=", 
             RowBox[{"EdthH", "[", "fb", "]"}]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"e2", "=", 
             RowBox[{"EdthH", "[", "e1", "]"}]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"e3", "=", 
             RowBox[{"EdthH", "[", "e2", "]"}]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"(*", 
             RowBox[{"Useful", " ", "primed", " ", "chains"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"epE1", "=", 
             RowBox[{"EdthpH", "[", "e1", "]"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"eth", "'"}], " ", "eth", " ", "f"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"epE2", "=", 
             RowBox[{"EdthpH", "[", "e2", "]"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"eth", "'"}], " ", 
              RowBox[{"eth", "^", "2"}], " ", "f"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"ep2E2", "=", 
             RowBox[{"EdthpH", "[", "epE2", "]"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"eth", "'"}], "^", "2"}], " ", 
              RowBox[{"eth", "^", "2"}], " ", "f"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"six", "=", 
             RowBox[{"EdthpH", "[", 
              RowBox[{"EdthpH", "[", 
               RowBox[{"EdthpH", "[", "e3", "]"}], "]"}], "]"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"eth", "'"}], "^", "3"}], " ", 
              RowBox[{"eth", "^", "3"}], " ", "f"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Phi", "^", "3"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"phi3", "=", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"L", ",", "mm"}], "}"}], ",", 
               RowBox[{
                RowBox[{"-", "2"}], " ", "pp", " ", 
                RowBox[{"fb", "[", 
                 RowBox[{"L", ",", "mm"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Phi", "^", "2"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"phi2", "=", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"L", ",", "mm"}], "}"}], ",", 
               RowBox[{
                RowBox[{"-", "2"}], " ", 
                RowBox[{"epE1", "[", 
                 RowBox[{"L", ",", "mm"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Phi", "^", "1"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"phi1", "=", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"L", ",", "mm"}], "}"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "pp"}], ")"}]}], " ", 
                 RowBox[{"ep2E2", "[", 
                  RowBox[{"L", ",", "mm"}], "]"}]}], "-", 
                RowBox[{"4", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\[Tau]H\[Dagger]", "[", "e1", "]"}], ")"}], "[", 
                  RowBox[{"L", ",", "mm"}], "]"}]}], "-", 
                RowBox[{"3", " ", "\[CapitalPsi]H", " ", 
                 RowBox[{"fb", "[", 
                  RowBox[{"L", ",", "mm"}], "]"}]}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Phi", "^", "0"}], "*)"}], 
            RowBox[{"phi0", "=", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"L", ",", "mm"}], "}"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{"3", " ", 
                    RowBox[{"pp", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
                 RowBox[{"six", "[", 
                  RowBox[{"L", ",", "mm"}], "]"}]}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "pp"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Tau]H\[Dagger]", "[", "epE2", "]"}], ")"}], "[", 
                    RowBox[{"L", ",", "mm"}], "]"}]}], "+", 
                   RowBox[{"M", " ", 
                    RowBox[{"epE1", "[", 
                    RowBox[{"L", ",", "mm"}], "]"}]}], "+", 
                   RowBox[{"2", " ", "M", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Rho]pH", "[", "fb", "]"}], ")"}], "[", 
                    RowBox[{"L", ",", "mm"}], "]"}]}]}], ")"}]}]}]}], "]"}]}],
             ";", "\[IndentingNewLine]", 
            RowBox[{"<|", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"0", "->", "phi0"}], ",", "\[IndentingNewLine]", 
              RowBox[{"1", "->", "phi1"}], ",", "\[IndentingNewLine]", 
              RowBox[{"2", "->", "phi2"}], ",", "\[IndentingNewLine]", 
              RowBox[{"3", "->", "phi3"}]}], "\[IndentingNewLine]", 
             "|>"}]}]}], "\[IndentingNewLine]", "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ClearAll", "[", "\[CapitalPhi]HeldModeFunctions", "]"}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{
      RowBox[{"\[CapitalPhi]HeldModeFunctions", "[", 
       RowBox[{
       "m_Integer", ",", "n_Integer", ",", "k_Integer", ",", "lmax_Integer", ",", 
        RowBox[{"a_", "?", "NumericQ"}]}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Omega]", ",", "aw", ",", "pp", ",", "fb", ",", "e1", ",", "e2", ",",
           "e3", ",", "epE1", ",", "epE2", ",", "ep2E2", ",", "six", ",", 
          "psiH", ",", "rhopH", ",", "phi0", ",", "phi1", ",", "phi2", ",", 
          "phi3"}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Frequency", " ", "and", " ", "spheroidicity", " ", "parameter", " ",
           "for", " ", "this", " ", 
          RowBox[{"(", 
           RowBox[{"m", ",", "n", ",", "k"}], ")"}], " ", "mode"}], "*)"}], 
        RowBox[{
         RowBox[{"\[Omega]", "=", 
          RowBox[{"\[Omega]mnk", "[", 
           RowBox[{"m", ",", "n", ",", "k"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"aw", "=", 
          RowBox[{"a", " ", "\[Omega]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"On", " ", "a", " ", "fixed", " ", "Fourier", " ", 
            RowBox[{"mode", ":", 
             RowBox[{"thorn", "'"}]}]}], "->", 
           RowBox[{
            RowBox[{"-", "i"}], " ", "omega"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"pp", "=", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[Omega]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Background", " ", "Held", " ", "scalars", " ", "in", " ", "the", " ",
            "present", " ", "Kerr", " ", "conventions"}], "*)"}], 
         RowBox[{"psiH", "=", "M"}], ";", "\[IndentingNewLine]", 
         RowBox[{"rhopH", "=", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
