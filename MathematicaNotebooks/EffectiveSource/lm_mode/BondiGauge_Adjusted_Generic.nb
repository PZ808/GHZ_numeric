Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpinRules", ":=", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"g_", "+", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Enclose", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ConfirmAssert", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Spinof", "[", "f", "]"}], "===", 
            RowBox[{"Spinof", "[", "g", "]"}]}], 
           ",", "\"\<Two scalars with different spins added\>\""}], "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Spinof", "[", "f", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"g_", "*", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", 
        RowBox[{"Spinof", "[", "g", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"n_", "?", "NumberQ"}], "]"}], "\[RuleDelayed]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"EdthH", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"EdthpH", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "-", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"\[Tau]H", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"\[Tau]H\[Dagger]", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "-", "1"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"\[CapitalOmega]H", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Spinof", "[", "f", "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}]], "Input",
 CellLabel->
  "In[1106]:=",ExpressionUUID->"6dd8a549-3918-453a-8295-b98253d4cb6f"],

