Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"simplification", " ", "utilities"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "simplify", ",", "simplifyRule", ",", " ", "fsimplify", ",", " ", 
     "fchop"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simplifyRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r0", ">", "0"}], ",", 
       RowBox[{"l", ">=", "2"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"L", ",", "l", ",", "m", ",", "m", ",", "n"}], "}"}], ",", 
         "Integers"}], "]"}], ",", 
       RowBox[{"M", ">", "0"}], ",", 
       RowBox[{"a", "<=", "1"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", ",", "a", ",", "\[Omega]", ",", "r"}], "}"}], ",", 
         "Reals"}], "]"}], ",", 
       RowBox[{"r", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simplify", "[", "f_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fsimplify", "[", "f_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"conjugation", " ", "utilities"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconj", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cconj", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"Evaluate", "[", "expr", "]"}], "]"}], "]"}], "//", 
      "fsimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconjSch", "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"cconjSch", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"expr", "/.", 
          RowBox[{"a", "->", "0"}]}], "]"}], "]"}], "]"}], "//", 
      "fsimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconjModeLm", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"cconjModeLm", "[", "PhiLM_", "]"}], "[", 
       RowBox[{"L_", ",", "m_"}], "]"}], "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"cconj", "[", 
         RowBox[{
          RowBox[{"PhiLM", "[", 
           RowBox[{"L", ",", 
            RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconjMode", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"cconjMode", "[", "ModeF_", "]"}], "[", 
       RowBox[{"l_", ",", "m_", ",", "n_", ",", "k_"}], "]"}], "[", "r_", 
      "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", 
       RowBox[{"(", "m", ")"}]}], " ", 
      RowBox[{"cconj", "[", 
       RowBox[{
        RowBox[{"ModeF", "[", 
         RowBox[{"l", ",", 
          RowBox[{"-", "m"}], ",", 
          RowBox[{"-", "n"}], ",", 
          RowBox[{"-", "k"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ReMode", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ReMode", "[", "ModeF_", "]"}], "[", 
       RowBox[{"l_", ",", "m_", ",", "n_", ",", "k_"}], "]"}], "[", "r_", 
      "]"}], ":=", " ", 
     RowBox[{
      FractionBox["1", "2"], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"ModeF", "[", 
          RowBox[{"l", ",", 
           RowBox[{"-", "m"}], ",", 
           RowBox[{"-", "n"}], ",", 
           RowBox[{"-", "k"}]}], "]"}], "[", "r", "]"}], "+", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"(", "m", ")"}]}], " ", 
         RowBox[{"cconj", "[", 
          RowBox[{
           RowBox[{"ModeF", "[", 
            RowBox[{"l", ",", 
             RowBox[{"-", "m"}], ",", 
             RowBox[{"-", "n"}], ",", 
             RowBox[{"-", "k"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fchop", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"expr", "//", "fsimplify"}], "//", "Expand"}], "//", "Chop"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
