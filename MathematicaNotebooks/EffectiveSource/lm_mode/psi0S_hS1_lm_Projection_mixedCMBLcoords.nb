      RowBox[{
       RowBox[{"-", "r0val"}], " ", "y"}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeAngularProjector", "[", 
