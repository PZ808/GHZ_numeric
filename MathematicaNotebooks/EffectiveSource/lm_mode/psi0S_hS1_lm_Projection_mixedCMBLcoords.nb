2d1d971031df"],

Cell[CellGroupData[{

Cell["Direction derivatives and derivative jets", "Subsection",
 CellChangeTimes->{{3.9880889768050423`*^9, 3.988088976807725*^9}, 
   3.988173262400278*^9, {3.988174389400302*^9, 3.988174392439642*^9}, {
   3.9907707044043827`*^9, 
   3.99077070768985*^9}},ExpressionUUID->"9d611b53-346d-44ef-9c4f-\
de7e9c030e4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "makeModeDirectionalOpMixed", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makeModeDirectionalOpMixed", "[", 
    RowBox[{"vec_Association", ",", "m_", ",", 
     RowBox[{"zeroExtra_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"omega", ",", "AX", ",", "AY", ",", "A0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"omega", "=", 
       RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AX", "=", 
       RowBox[{"vec", "[", "\"\<X\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AY", "=", 
       RowBox[{"vec", "[", "\"\<Y\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", "omega", " ", 
         RowBox[{"vec", "[", "\"\<t\>\"", "]"}]}], "+", 
        RowBox[{"I", " ", "m", " ", 
         RowBox[{"vec", "[", "\"\<phi\>\"", "]"}]}], "+", "zeroExtra"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"makeFirstOrderOp", "[", 
       RowBox[{"AX", ",", "AY", ",", "A0"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.988091283509275*^9, 3.988091298183605*^9}, {
  3.988119671889225*^9, 3.988119677710678*^9}},
 CellLabel->
  "In[464]:=",ExpressionUUID->"9a012e9b-5bea-4f37-acfd-c44bf500d0cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Apply", " ", "first"}], "-", 
    RowBox[{
    "order", " ", "operators", " ", "to", " ", "precomputed", " ", "jets"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
