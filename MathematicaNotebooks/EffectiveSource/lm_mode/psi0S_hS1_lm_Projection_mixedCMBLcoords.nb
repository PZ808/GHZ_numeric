          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "err", "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MaxAbsDiagonalError\>\"", "->", 
