Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mmbDirectionFits", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"eps", ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", ",", "f"}], "}"}], ",", 
          RowBox[{
           RowBox[{"d", "=", 
            RowBox[{"hSNearParticleFalloff", "[", 
             RowBox[{"\"\<mmb\>\"", ",", "mRange", ",", 
              RowBox[{"eps", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"eps", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"f", "=", 
            RowBox[{"fitPowerLaw", "[", 
             RowBox[{"d", ",", "fitRange"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<p\>\"", "->", 
              RowBox[{"f", "[", "\"\<p\>\"", "]"}]}], ",", 
             RowBox[{"\"\<R2\>\"", "->", 
              RowBox[{"f", "[", "\"\<R2\>\"", "]"}]}], ",", 
             RowBox[{"\"\<p - 2\>\"", "->", 
              RowBox[{
               RowBox[{"f", "[", "\"\<p\>\"", "]"}], "-", "2"}]}], ",", 
             RowBox[{"\"\<p - 3\>\"", "->", 
              RowBox[{
               RowBox[{"f", "[", "\"\<p\>\"", "]"}], "-", "3"}]}]}], 
            "|>"}]}]}], "]"}]}], "]"}], ",", "nearDirections"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}]], "Input",
