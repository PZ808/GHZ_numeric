                FractionBox[
                 SqrtBox["\[CapitalDelta]"], 
                 SqrtBox[
                  RowBox[{"2", "\[CapitalSigma]"}]]], 
                FractionBox["1", 
                 SqrtBox[
                  RowBox[{
                  "2", "\[CapitalDelta]", " ", "\[CapitalSigma]"}]]]}], "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"r", "[", "]"}], "2"], "+", 
                 SuperscriptBox["a", "2"]}], ",", 
                RowBox[{"-", "\[CapitalDelta]"}], ",", "0", ",", "a"}], 
               "}"}]}], "/.", "KerrVals"}], "/.", "BLtoCM"}], "//.", 
           "ToVars"}], "/.", "apToBD"}], "//", "FullSimplify"}], ")"}], "/.", 
       "apToBD"}], "//", "FullSimplify"}], ",", 
     RowBox[{"{", "BL", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mBL", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
