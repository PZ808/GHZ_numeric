Cell[TextData[{
 "For a function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", 
    RowBox[{
     RowBox[{"F", "(", 
      RowBox[{"x", ",", "y"}], ")"}], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "i\[Omega]t"}], "+", "im\[Phi]", " "}]]}]}], 
   TraditionalForm]],ExpressionUUID->"2a5c37aa-9798-45c2-a4ba-fb7b866b38c9"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "\[Mu]"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], " ", "=", " "}], 
   TraditionalForm]],ExpressionUUID->"ef51db26-3fa1-40e7-8d5f-75b9a9fa5b3f"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["v", "t"], "(", 
      RowBox[{"-", "\[ImaginaryI]\[Omega]F"}], ")"}], "+", 
     RowBox[{
      SuperscriptBox["v", "\[Phi]"], "(", 
      RowBox[{"\[ImaginaryI]", " ", "mF"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"080c4189-0699-4d34-8280-06fdfe738dce"],
 "+ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["v", "X"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "X"], " ", "F"}]}], "+", 
      RowBox[{
       SuperscriptBox["v", "Y"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "Y"], "F"}]}]}], "]"}], 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]\[Omega]t"}], "+", "\[ImaginaryI]m\[Phi]", 
      " "}]]}], TraditionalForm]],ExpressionUUID->
  "515e1159-077c-49e1-8a4b-55b54afc4a3b"],
 "\nSince X=X(r) and Y=Y(\[Theta]) ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["X", 
       RowBox[{",", "r"}]], 
