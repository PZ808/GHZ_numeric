         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"thetaGridRaw", "=", 
        RowBox[{"ArcCos", "/@", "zGridRaw"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"yGridRaw", "=", 
        RowBox[{"N64", "/@", 
