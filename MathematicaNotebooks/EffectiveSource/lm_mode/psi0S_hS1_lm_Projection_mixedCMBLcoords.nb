Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"integerLabelQ", ",", "exactIntLabel", ",", "validSWSHLabelQ"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integerLabelQ", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"IntegerQ", "[", "x", "]"}], "||", 
    RowBox[{"TrueQ", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"x", "-", 
           RowBox[{"Round", "[", "x", "]"}]}], ",", "50"}], "]"}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "30"}]}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "exactIntLabel", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", "x_Integer", "]"}], ":=", "x"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xx", ",", "rr"}], "}"}], ",", 
      RowBox[{
       RowBox[{"xx", "=", 
        RowBox[{"N", "[", 
         RowBox[{"x", ",", "80"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rr", "=", 
        RowBox[{"Round", "[", "xx", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"xx", "-", "rr"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "40"}]}]}], ",", 
         RowBox[{"Rationalize", "[", 
          RowBox[{"rr", ",", "0"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Bad non-integer spheroidal label: \>\"", ",", "x"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Bad non-numeric/non-integer spheroidal label: \>\"", ",",
          "x"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"validSWSHLabelQ", "[", 
    RowBox[{"s_", ",", "ell_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ss", "=", 
       RowBox[{"exactIntLabel", "[", "s", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ll", "=", 
       RowBox[{"exactIntLabel", "[", "ell", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mm", "=", 
       RowBox[{"exactIntLabel", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ll", ">=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "ss", "]"}], ",", 
         RowBox[{"Abs", "[", "mm", "]"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988302094916025*^9, 3.988302094919104*^9}, 
   3.988302880750177*^9},
 CellLabel->
  "In[735]:=",ExpressionUUID->"545a8ceb-00d9-4829-aed5-6c1ad1d42c77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sphKeyString", "[", 
    RowBox[{
    "s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", "omega_", ",", 
     "yGrid_List", ",", "prec_Integer"}], "]"}], ":=", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<s\>\"", "<>", 
        RowBox[{"ToString", "[", "s", "]"}]}], ",", 
       RowBox[{"\"\<ell\>\"", "<>", 
        RowBox[{"ToString", "[", "ell", "]"}]}], ",", 
       RowBox[{"\"\<m\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}]}], ",", 
       RowBox[{"\"\<om\>\"", "<>", 
        RowBox[{"cacheHash", "[", 
         RowBox[{"N", "[", 
          RowBox[{"omega", ",", "40"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<a\>\"", "<>", 
        RowBox[{"cacheHash", "[", 
         RowBox[{"N", "[", 
          RowBox[{"aKerr", ",", "40"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<grid\>\"", "<>", 
        RowBox[{"cacheHash", "[", 
         RowBox[{"N", "[", 
          RowBox[{"yGrid", ",", "40"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<p\>\"", "<>", 
        RowBox[{"ToString", "[", "prec", "]"}]}], ",", 
       RowBox[{"\"\<v\>\"", "<>", 
        RowBox[{"ToString", "[", "$SpheroidalCacheVersion", "]"}]}]}], "}"}], 
     ",", "\"\<-\>\""}], "]"}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988384880567255*^9, 3.988384880959497*^9}, 
   3.9883850056715727`*^9},
 CellLabel->
