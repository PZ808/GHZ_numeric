Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{"(*", 
   RowBox[{
   "Pull", " ", "out", " ", "and", " ", "plot", " ", "one", " ", "projected", 
    " ", "Teukolsky", " ", "source", " ", "mode"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "projectionKeySummary", ",", "getProjectionEntry", ",", 
      "getProjectionData", ",", "getJoinedProjectionData", ",", 
      "plotProjectionEntry", ",", "plotProjectionMode", ",", 
      "projectionEntryDataset"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"projectionKeySummary", "[", "res_Association", "]"}], ":=", 
     RowBox[{"Dataset", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<s\>\"", "->", 
           RowBox[{"key", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<ell\>\"", "->", 
           RowBox[{"key", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Patch\>\"", "->", 
           RowBox[{"key", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "|>"}], ",", 
        RowBox[{"{", 
         RowBox[{"key", ",", 
          RowBox[{"Keys", "[", "res", "]"}]}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getProjectionEntry", "[", 
      RowBox[{
      "res_Association", ",", "s_Integer", ",", "ell_Integer", ",", 
       "patch_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "key", "}"}], ",", 
       RowBox[{
        RowBox[{"key", "=", 
         RowBox[{"{", 
          RowBox[{"s", ",", "ell", ",", "patch"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"res", ",", "key"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Missing key: \>\"", ",", "key"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", "\"\<Available keys are:\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Keys", "[", "res", "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "[", "key", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getProjectionData", "[", 
      RowBox[{
      "res_Association", ",", "s_Integer", ",", "ell_Integer", ",", 
       "patch_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"entry", ",", "X", ",", "vals"}], "}"}], ",", 
       RowBox[{
        RowBox[{"entry", "=", 
         RowBox[{"getProjectionEntry", "[", 
          RowBox[{"res", ",", "s", ",", "ell", ",", "patch"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"entry", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"X", "=", 
         RowBox[{"entry", "[", "\"\<XGrid\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{"entry", "[", "\"\<Values\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Entry\>\"", "->", "entry"}], ",", 
          RowBox[{"\"\<X\>\"", "->", "X"}], ",", 
          RowBox[{"\"\<Values\>\"", "->", "vals"}], ",", 
          RowBox[{"\"\<ReData\>\"", "->", 
