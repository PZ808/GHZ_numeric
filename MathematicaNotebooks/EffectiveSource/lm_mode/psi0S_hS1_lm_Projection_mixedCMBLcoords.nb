    "endpointPowerOfFunction", ",", "expectedRightPower", ",", 
     "expectedLeftPower", ",", "componentPoleRegularityReport"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedRightPower", "[", 
    RowBox[{"m_Integer", ",", "q_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"expectedLeftPower", "[", 
     RowBox[{"m_Integer", ",", "q_Integer"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"m", "-", "q"}], "]"}], "/", "2"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"endpointPowerOfFunction", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"Xval_", "?", "NumericQ"}], ",", "projector_Association", ",", 
     "side_String", ",", 
     RowBox[{"n_Integer", ":", "16"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "yGrid", ",", "YGrid", ",", "inds", ",", "delta", ",", "vals", ",", 
       "logpts", ",", "fit", ",", "slope"}], "}"}], ",", 
     RowBox[{
      RowBox[{"yGrid", "=", 
       RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"YGrid", "=", 
       RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"inds", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"side", "===", "\"\<Right\>\""}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "yGrid", "]"}], "-", "n", "+", "1"}], ",", 
           
           RowBox[{"Length", "[", "yGrid", "]"}]}], "]"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"delta", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"side", "===", "\"\<Right\>\""}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"yGrid", "[", 
           RowBox[{"[", "inds", "]"}], "]"}]}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"yGrid", "[", 
           RowBox[{"[", "inds", "]"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"Xval", ",", 
            RowBox[{"YGrid", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "inds"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"logpts", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", "delta", "]"}], ",", 
          RowBox[{"Log", "[", "vals", "]"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"logpts", ",", "u", ",", "u"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"slope", "=", 
       RowBox[{
        RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Slope\>\"", "->", "slope"}], ",", 
        RowBox[{"\"\<PowerP\>\"", "->", 
         RowBox[{"-", "slope"}]}], ",", 
        RowBox[{"\"\<Points\>\"", "->", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"delta", ",", "vals"}], "}"}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
