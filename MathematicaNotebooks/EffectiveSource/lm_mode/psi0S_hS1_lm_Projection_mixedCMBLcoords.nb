Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "runIRGhSGridExport", "]"}], "=", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Components\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ll\>\"", ",", "\"\<lm\>\"", ",", "\"\<mm\>\""}], "}"}]}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<MList\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<OutputDirectory\>\"", "->", "Automatic"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<PatchGrids\>\"", "->", "Automatic"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<YGrid\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<Overwrite\>\"", "->", "False"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<Parallel\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Metadata\>\"", "->", 
       RowBox[{"<|", "|>"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"runIRGhSGridExport", "[", 
    RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "components", ",", "mList", ",", "outDir", ",", "patchGrids", ",", 
       "ygrid", ",", "overwrite", ",", "parallel", ",", "metadata", ",", 
       "worker", ",", "results"}], "}"}], ",", 
     RowBox[{
      RowBox[{"components", "=", 
       RowBox[{"OptionValue", "[", "\"\<Components\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mList", "=", 
       RowBox[{"OptionValue", "[", "\"\<MList\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"outDir", "=", 
       RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"patchGrids", "=", 
       RowBox[{"OptionValue", "[", "\"\<PatchGrids\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ygrid", "=", 
       RowBox[{"OptionValue", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"overwrite", "=", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"OptionValue", "[", "\"\<Overwrite\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"parallel", "=", 
       RowBox[{"TrueQ", "@", 
        RowBox[{"OptionValue", "[", "\"\<Parallel\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"metadata", "=", 
       RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"mList", "===", "Automatic"}], ",", 
        RowBox[{"mList", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "mMax"}], ",", "mMax"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"outDir", "===", "Automatic"}], ",", 
        RowBox[{"outDir", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], 
            ",", "\"\<TabR_IRGGridData\>\""}], "}"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"patchGrids", "===", "Automatic"}], ",", 
        RowBox[{"patchGrids", "=", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<left\>\"", "->", "XLeftGridProd"}], ",", 
           RowBox[{"\"\<right\>\"", "->", "XRightGridProd"}]}], "|>"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ygrid", "===", "Automatic"}], ",", 
        RowBox[{"ygrid", "=", "YGrid"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", 
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"outDir", ",", 
          RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"worker", "[", "mm_Integer", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"file", ",", "obj"}], "}"}], ",", 
         RowBox[{
          RowBox[{"file", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"outDir", ",", 
              RowBox[{"\"\<hSGrid_m\>\"", "<>", 
               RowBox[{"mTag", "[", "mm", "]"}], "<>", " ", "\"\<_a\>\"", "<>",
                " ", 
               RowBox[{"ToString", "[", "aKerr", "]"}], 
               "<>", "\"\<.mx\>\""}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"FileExistsQ", "[", "file", "]"}], "&&", 
             RowBox[{"!", "overwrite"}]}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<m\>\"", "->", "mm"}], ",", 
               RowBox[{"\"\<status\>\"", "->", "\"\<exists\>\""}], ",", 
               RowBox[{"\"\<file\>\"", "->", "file"}]}], "|>"}], "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"obj", "=", 
           RowBox[{"computeIRGhSGridForM", "[", 
            RowBox[{"mm", ",", 
             RowBox[{"\"\<Components\>\"", "->", "components"}], ",", 
             RowBox[{"\"\<PatchGrids\>\"", "->", "patchGrids"}], ",", 
             RowBox[{"\"\<YGrid\>\"", "->", "ygrid"}], ",", 
             RowBox[{"\"\<Metadata\>\"", "->", "metadata"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dumpIRGhSGridForM", "[", 
           RowBox[{"file", ",", "obj"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<m\>\"", "->", "mm"}], ",", 
            RowBox[{"\"\<status\>\"", "->", "\"\<computed\>\""}], ",", 
            RowBox[{"\"\<file\>\"", "->", "file"}], ",", 
            RowBox[{"\"\<components\>\"", "->", "components"}], ",", 
            RowBox[{"\"\<patches\>\"", "->", 
             RowBox[{"Keys", "[", "patchGrids", "]"}]}]}], "|>"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"parallel", ",", 
        RowBox[{
         RowBox[{"LaunchKernels", "[", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{
          "mTag", ",", "evalJetOnXYGrid", ",", "evalComponentJetOnPatch", ",",
            "computeIRGhSGridForM", ",", "dumpIRGhSGridForM", ",", 
           "hSJetCompiled", ",", "compileJet2", ",", "hSJet2", ",", 
           "hS1FinalRules$Kerr", ",", "tovals", ",", "to0vals", ",", " ", 
           "XLeftGridProd", ",", "XRightGridProd", ",", "patchLeftProd", ",", 
           " ", "patchRightProd", ",", " ", "YGrid"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"results", "=", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{"worker", ",", "mList", ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}]}], 
        ",", 
        RowBox[{"results", "=", 
         RowBox[{"Map", "[", 
          RowBox[{"worker", ",", "mList"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Dataset", "[", "results", "]"}]}]}], "]"}]}], ";"}]}], "Input",\

 Evaluatable->False,
