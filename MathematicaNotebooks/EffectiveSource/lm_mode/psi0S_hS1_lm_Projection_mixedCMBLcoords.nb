  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildComponentMatrix", "[", 
     RowBox[{"fun_", ",", 
      RowBox[{"m_Integer", "?", "NonNegative"}], ",", "XGrid_List", ",", 
      "YGrid_List"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fun", "[", "m", "]"}], "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "XGrid"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "YGrid"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
