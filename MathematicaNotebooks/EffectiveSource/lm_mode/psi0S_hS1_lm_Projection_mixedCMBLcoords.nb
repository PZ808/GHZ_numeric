           "Print", "[", "\"\<This expression is not ready for Compile.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"Xval", ",", "Yval"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"globalSymbolsLeftForCompile", "[", "expr_", "]"}], ":=", 
     RowBox[{"DeleteDuplicates", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"HoldComplete", "[", "expr", "]"}], ",", 
        RowBox[{"s_Symbol", "/;", 
         RowBox[{
          RowBox[{
           RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}], "&&", 
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Xval", ",", "Yval"}], "}"}], ",", "s"}], "]"}]}]}]}], ",",
         "Infinity"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeCompiledXYFunction", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"rules_List", ":", "compileRules"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr0", ",", "e", ",", "leftovers"}], "}"}], ",", 
       RowBox[{
        RowBox[{"expr0", "=", "expr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
         RowBox[{"expr0", ",", "\"\<before numerical replacement\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{
          RowBox[{"expr0", "/.", " ", "rules"}], "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"X", "->", "Xval"}], ",", 
            RowBox[{"Y", "->", "Yval"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"N", "[", 
          RowBox[{"e", ",", "MachinePrecision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
         RowBox[{"e", ",", "\"\<after numerical replacement\>\""}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"leftovers", "=", 
         RowBox[{"globalSymbolsLeftForCompile", "[", "e", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"leftovers", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
