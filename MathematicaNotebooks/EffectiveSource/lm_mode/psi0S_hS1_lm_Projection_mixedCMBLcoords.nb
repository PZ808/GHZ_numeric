Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$psi0MCacheDir", "=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$hSCacheRoot", ",", "\"\<Psi0m\>\""}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ensureDirectory", "[", "$psi0MCacheDir", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9992774853611794`*^9, 3.999277496677039*^9}, {
  3.999277643149272*^9, 3.999277650031221*^9}},
 CellLabel->
  "In[626]:=",ExpressionUUID->"875197e6-493e-4286-8ef7-24c89a1fd6a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"psi0MFile", ",", "computePsi0M"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"psi0MFile", "[", "m_Integer", "]"}], ":=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$psi0MCacheDir", ",", 
       RowBox[{"\"\<psi0_m\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"computePsi0M", "[", 
    RowBox[{"m_Integer", ",", "xGrid_List", ",", "yGrid_List"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"file", ",", "fun", ",", "data", ",", "payload"}], "}"}], ",", 
     RowBox[{
      RowBox[{"file", "=", 
       RowBox[{"psi0MFile", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"readMXObject", "[", "file", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Computing psi0 for m = \>\"", ",", "m"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fun", "=", 
       RowBox[{"psi0MEvaluator", "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"fun", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xGrid"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"payload", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<aKerr\>\"", "->", "aKerr"}], ",", 
         RowBox[{"\"\<XGrid\>\"", "->", "xGrid"}], ",", 
         RowBox[{"\"\<YGrid\>\"", "->", "yGrid"}], ",", 
         RowBox[{"\"\<Psi0\>\"", "->", "data"}]}], "|>"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"writeMXObject", "[", 
       RowBox[{"file", ",", "payload"}], "]"}], ";", "\[IndentingNewLine]", 
      "payload"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999277378997756*^9, 3.999277379000033*^9}},
 CellLabel->
  "In[628]:=",ExpressionUUID->"2273c6f0-1049-4473-a386-f165190b7c67"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mList", "=", 
    RowBox[{"DeleteDuplicates", "[", "mList", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]0pm$results", "=", 
