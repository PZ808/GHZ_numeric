Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psi0FromMetricExpr", "[", 
    RowBox[{"jets_Association", ",", "m_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "ops", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ops", "=", 
       RowBox[{"makePsi0Ops", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<A1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<A2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<ll\>\"", "]"}]}], "]"}], 
         "\[IndentingNewLine]", "+", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<B1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<B2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<mm\>\"", "]"}]}], "]"}], 
         "\[IndentingNewLine]", "-", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<B1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<C\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<lm\>\"", "]"}]}], "]"}], 
         "\[IndentingNewLine]", "-", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<A1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<E\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<lm\>\"", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
