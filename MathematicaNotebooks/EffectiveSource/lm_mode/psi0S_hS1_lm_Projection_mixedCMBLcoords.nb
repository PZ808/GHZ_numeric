     RowBox[{"\"\<Parallel\>\"", "->", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Metadata\>\"", "->", "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
