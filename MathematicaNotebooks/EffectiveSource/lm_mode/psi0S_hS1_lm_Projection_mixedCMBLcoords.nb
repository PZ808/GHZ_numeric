Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fitPowerLawM", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitPowerLawM", "[", 
    RowBox[{"data_", ",", 
     RowBox[{"{", 
      RowBox[{"mmin_", ",", "mmax_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "tail", ",", "x", ",", "fit", ",", "p", ",", "curve", ",", "ms"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"tail", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"data", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"mmin", "<=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<=", "mmax"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           "tail"}], ")"}], ",", "x", ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"-", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "fit", "]"}], ",", "x"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ms", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"mmin", ",", "mmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"curve", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"fit", "[", 
             RowBox[{"Log", "[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@",
         "ms"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<p\>\"", "->", "p"}], ",", 
        RowBox[{"\"\<fit\>\"", "->", "fit"}], ",", 
        RowBox[{"\"\<plot\>\"", "->", 
         RowBox[{"ListLogLogPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"data", ",", "curve"}], "}"}], ",", 
           RowBox[{"Joined", "->", 
            RowBox[{"{", 
             RowBox[{"False", ",", "True"}], "}"}]}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "None"}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<|m|\>\"", ",", "\"\<norm\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<data\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<fit: |m|^-\>\"", ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"p", ",", 
                   RowBox[{"{", 
                    RowBox[{"6", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
              "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Power-law fit over \>\"", ",", "mmin", 
               ",", "\"\< \[LessEqual] |m| \[LessEqual] \>\"", ",", "mmax"}], 
              "}"}], "]"}]}], ",", 
           RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.990864472829039*^9, 3.99086447283007*^9}},
 CellLabel->
  "In[450]:=",ExpressionUUID->"b6c01c61-74d1-45af-8039-acea8a564a16"],

