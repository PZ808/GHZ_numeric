      RowBox[{"\"\<NEdgeNearest\>\"", "->", "8"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"radialSourceResolutionReport", "[", 
    RowBox[{"grids_Association", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x0", ",", "xWTLeft", ",", "xWTRight", ",", "xLeftEval", ",", 
       "xRightEval", ",", "xLeft", ",", "xRight", ",", "dL", ",", "dR", ",", 
       "dEdgeL", ",", "dEdgeR", ",", "radii", ",", "nNearest", ",", 
       "nEdgeNearest", ",", "leftInsetX", ",", "rightInsetX"}], "}"}], ",", 
     RowBox[{
      RowBox[{"radii", "=", 
       RowBox[{"OptionValue", "[", "\"\<Radii\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nNearest", "=", 
       RowBox[{"OptionValue", "[", "\"\<NNearest\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nEdgeNearest", "=", 
       RowBox[{"OptionValue", "[", "\"\<NEdgeNearest\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"grids", "[", "\"\<X0\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Exact", " ", "compact"}], "-", 
        RowBox[{"support", " ", "boundaries"}]}], "*)"}], 
      RowBox[{"xWTLeft", "=", 
       RowBox[{"grids", "[", "\"\<XWTLeftExact\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xWTRight", "=", 
       RowBox[{"grids", "[", "\"\<XWTRightExact\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Actual", " ", "numerical", " ", "evaluation", " ", "boundaries"}], 
       "*)"}], 
      RowBox[{"xLeftEval", "=", 
       RowBox[{"grids", "[", "\"\<XLeftEvalBoundary\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xRightEval", "=", 
       RowBox[{"grids", "[", "\"\<XRightEvalBoundary\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
