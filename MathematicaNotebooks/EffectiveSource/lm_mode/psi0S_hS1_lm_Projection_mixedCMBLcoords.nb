Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "repairTinyIndeterminates", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "repairTinyIndeterminates", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Tolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "30"}]}]}], ",", 
      RowBox[{"\"\<Radius\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<MinNeighbors\>\"", "->", "2"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"repairTinyIndeterminates", "[", 
    RowBox[{
     RowBox[{"data_", "?", "MatrixQ"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", "data"}], ",", 
       RowBox[{"tol", "=", 
        RowBox[{"OptionValue", "[", "\"\<Tolerance\>\"", "]"}]}], ",", 
       RowBox[{"rad", "=", 
        RowBox[{"OptionValue", "[", "\"\<Radius\>\"", "]"}]}], ",", 
       RowBox[{"minN", "=", 
        RowBox[{"OptionValue", "[", "\"\<MinNeighbors\>\"", "]"}]}], ",", 
       "dims", ",", "badPos", ",", 
       RowBox[{"repaired", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"unresolved", "=", 
        RowBox[{"{", "}"}]}], ",", "neighbors", ",", "vals", ",", "i", ",", 
       "j", ",", "irange", ",", "jrange"}], "}"}], ",", 
     RowBox[{
      RowBox[{"dims", "=", 
       RowBox[{"Dimensions", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Anything", " ", "that", " ", "is", " ", "not", " ", "an", " ", 
        "ordinary", " ", "finite", " ", "number"}], "*)"}], 
      RowBox[{"badPos", "=", 
       RowBox[{"Position", "[", 
        RowBox[{"data", ",", 
         RowBox[{"x_", "/;", 
          RowBox[{"!", 
           RowBox[{"NumberQ", "[", "x", "]"}]}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}], "=", "pos"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"irange", "=", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"i", "-", "rad"}]}], "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"dims", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"i", "+", "rad"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"jrange", "=", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"j", "-", "rad"}]}], "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"dims", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"j", "+", "rad"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"neighbors", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ii", "==", "i"}], "&&", 
                RowBox[{"jj", "==", "j"}]}], ",", "Nothing", ",", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"ii", ",", "irange"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"jj", ",", "jrange"}], "}"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vals", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"neighbors", ",", "NumberQ"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "vals", "]"}], ">=", "minN"}], "&&", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", "vals", "]"}], "]"}], "<", "tol"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"out", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", "0."}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"repaired", ",", "pos"}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"unresolved", ",", "pos"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"pos", ",", "badPos"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Data\>\"", "->", "out"}], ",", 
        RowBox[{"\"\<RepairedPositions\>\"", "->", "repaired"}], ",", 
        RowBox[{"\"\<UnresolvedPositions\>\"", "->", "unresolved"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.999347120695757*^9, 3.9993471206978416`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"03d8e651-08b6-4d64-8f21-aca18779a4e5"]
