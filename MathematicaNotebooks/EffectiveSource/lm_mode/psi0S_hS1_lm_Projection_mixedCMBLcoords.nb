Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"goodComplexQ", ",", "hSComponentRMS"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"goodComplexQ", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"NumericQ", "[", "z", "]"}], "&&", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"z", ",", 
       RowBox[{
       "Indeterminate", "|", "ComplexInfinity", "|", "DirectedInfinity", "|", 
        "_Overflow"}]}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hSComponentRMS", "[", 
    RowBox[{"key_String", ",", "mm_Integer", ",", 
     RowBox[{"pts_List", ":", "falloffPts"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "vals", "}"}], ",", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"hVal", "[", 
            RowBox[{"key", ",", "mm", ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"pt", ",", "pts"}], "}"}]}], "]"}], ",", 
         RowBox[{"z_", "/;", 
          RowBox[{"!", 
           RowBox[{"goodComplexQ", "[", "z", "]"}]}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"vals", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Missing", "[", "\"\<NoGoodValues\>\"", "]"}], ",", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "vals", "]"}], "^", "2"}], "]"}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.990506077929632*^9, 3.9905060779315968`*^9}, {
  3.999262085529457*^9, 3.999262091274564*^9}, {3.99926214336817*^9, 
