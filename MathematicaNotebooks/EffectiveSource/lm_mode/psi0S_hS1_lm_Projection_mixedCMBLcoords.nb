Cell[CellGroupData[{

Cell["Production h_ab export", "Subsection",
 CellChangeTimes->{{3.990609194259509*^9, 3.990609201087906*^9}, {
  3.9992625729481983`*^9, 
  3.9992625732995358`*^9}},ExpressionUUID->"5cf10ab4-fc85-41b8-9503-\
2d539f311826"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Kerr", "-", 
    RowBox[{"safe", " ", "compiled", " ", "hS", " ", "grid", " ", 
     RowBox[{"exporter", ":", 
      RowBox[{"one", " ", "file", " ", "per", " ", "m"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Uses", " ", 
    RowBox[{"hSJetCompiled", "[", 
     RowBox[{"key", ",", "m"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "mTag", ",", "evalJetOnXYGrid", ",", "evalComponentJetOnPatch", ",", 
      "computeIRGhSGridForM", ",", "dumpIRGhSGridForM", ",", 
      "runIRGhSGridExport"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mTag", "[", "m_Integer", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "<", "0"}], ",", 
       RowBox[{"\"\<m\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Abs", "[", "m", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<p\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",ExpressionUUID->"28086b66-e8ed-4667-\
ba04-de4cd77a1027"],

Cell[CellGroupData[{

Cell["old stuff", "Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.999329701950564*^9, 
  3.99932970318709*^9}},ExpressionUUID->"47f6d664-b2bc-4d7f-9a5c-\
b51aa11127dd"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Evaluate", " ", "one", " ", "compiled", " ", "function", " ", 
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", "on", " ", "an", " ", "X"}], ",", 
    RowBox[{"Y", " ", "tensor", " ", 
     RowBox[{"grid", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"evalJetOnXYGrid", "[", 
      RowBox[{"f_", ",", "xgrid_List", ",", "ygrid_List"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xs", ",", "ys"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xs", "=", 
         RowBox[{"Developer`ToPackedArray", "@", 
          RowBox[{"N", "[", "xgrid", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ys", "=", 
         RowBox[{"Developer`ToPackedArray", "@", 
          RowBox[{"N", "[", "ygrid", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Developer`ToPackedArray", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Quiet", "@", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"x", ",", "y"}], "]"}], ",", "Indeterminate"}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "ys"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"A", " ", 
     RowBox[{"hSJetCompiled", "[", 
      RowBox[{"key", ",", "m"}], "]"}], " ", "object", " ", "should", " ", 
     "be", " ", "an", " ", 
     RowBox[{"association", ":", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<F\>\"", "->", "cf"}], ",", 
         RowBox[{"\"\<Fx\>\"", "->", "cfX"}], ",", 
         RowBox[{"\"\<Fy\>\"", "->", "cfY"}], ",", "..."}], "|>"}], " ", 
       "This", " ", "evaluates", " ", "all", " ", "jet", " ", "entries", " ", 
       "on", " ", "one", " ", 
       RowBox[{"patch", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"evalComponentJetOnPatch", "[", 
      RowBox[{"jet_Association", ",", "xgrid_List", ",", "ygrid_List"}], 
      "]"}], ":=", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"evalJetOnXYGrid", "[", 
         RowBox[{
          RowBox[{"jet", "[", "#", "]"}], ",", "xgrid", ",", "ygrid"}], "]"}],
         "&"}], ",", 
       RowBox[{"Keys", "[", "jet", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "computeIRGhSGridForM", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Components\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<ll\>\"", ",", "\"\<lm\>\"", ",", "\"\<mm\>\""}], 
         "}"}]}], ",", 
       RowBox[{"\"\<PatchGrids\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<YGrid\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<Metadata\>\"", "->", 
        RowBox[{"<|", "|>"}]}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeIRGhSGridForM", "[", 
      RowBox[{"m_Integer", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "components", ",", "patchGrids", ",", "ygrid", ",", "metadata", ",", 
         "compiledJets", ",", "data"}], "}"}], ",", 
       RowBox[{
        RowBox[{"components", "=", 
         RowBox[{"OptionValue", "[", "\"\<Components\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"patchGrids", "=", 
         RowBox[{"OptionValue", "[", "\"\<PatchGrids\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ygrid", "=", 
         RowBox[{"OptionValue", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"metadata", "=", 
         RowBox[{"OptionValue", "[", "\"\<Metadata\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"patchGrids", "===", "Automatic"}], ",", 
          RowBox[{"patchGrids", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<left\>\"", "->", "XLeftGridProd"}], ",", 
             RowBox[{"\"\<right\>\"", "->", "XRightGridProd"}]}], "|>"}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ygrid", "===", "Automatic"}], ",", 
          RowBox[{"ygrid", "=", "YGrid"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<m = \>\"", ",", "m", 
          ",", "\"\<: compiling hab components \>\"", ",", "components"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"compiledJets", "=", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hSJetCompiled", "[", 
             RowBox[{"#", ",", "m"}], "]"}], "&"}], ",", "components"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<m = \>\"", ",", "m", 
          ",", "\"\<: evaluating on X,Y grids\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"patch", ",", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"evalComponentJetOnPatch", "[", 
                 RowBox[{
                  RowBox[{"compiledJets", "[", "#", "]"}], ",", 
                  RowBox[{"patchGrids", "[", "patch", "]"}], ",", "ygrid"}], 
                 "]"}], "&"}], ",", "components"}], "]"}]}], "]"}], ",", 
           RowBox[{"Keys", "[", "patchGrids", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<CompiledhSGrid\>\""}], ",", 
          RowBox[{"\"\<Gauge\>\"", "->", "\"\<IRG\>\""}], ",", 
          RowBox[{"\"\<SpinSource\>\"", "->", "\"\<+2\>\""}], ",", 
          RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
          RowBox[{"\"\<Components\>\"", "->", "components"}], ",", 
          RowBox[{"\"\<JetKeys\>\"", "->", 
           RowBox[{"AssociationMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Keys", "[", 
               RowBox[{"compiledJets", "[", "#", "]"}], "]"}], "&"}], ",", 
             "components"}], "]"}]}], ",", 
          RowBox[{"\"\<PatchNames\>\"", "->", 
           RowBox[{"Keys", "[", "patchGrids", "]"}]}], ",", 
          RowBox[{"\"\<XPatchGrids\>\"", "->", "patchGrids"}], ",", 
          RowBox[{"\"\<YGrid\>\"", "->", "ygrid"}], ",", 
          RowBox[{"\"\<Data\>\"", "->", "data"}], ",", 
          RowBox[{"\"\<Dimensions\>\"", "->", 
           RowBox[{"AssociationMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<NX\>\"", "->", 
                 RowBox[{"Length", "[", 
                  RowBox[{"patchGrids", "[", "#", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<NY\>\"", "->", 
                 RowBox[{"Length", "[", "ygrid", "]"}]}]}], "|>"}], "&"}], ",", 
             RowBox[{"Keys", "[", "patchGrids", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Metadata\>\"", "->", "metadata"}], ",", 
          RowBox[{"\"\<Created\>\"", "->", 
           RowBox[{"DateString", "[", "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dumpIRGhSGridForM", "[", 
      RowBox[{"file_String", ",", "obj_Association"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Clear", "[", "IRGhSGridData", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"IRGhSGridData", "=", "obj"}], ";", "\[IndentingNewLine]", 
        RowBox[{"DumpSave", "[", 
         RowBox[{"file", ",", "IRGhSGridData"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "IRGhSGridData", "]"}], ";", 
        "\[IndentingNewLine]", "file"}]}], "]"}]}], ";"}]}]}]], "Input",
