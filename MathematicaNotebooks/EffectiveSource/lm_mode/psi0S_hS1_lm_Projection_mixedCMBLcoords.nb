    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"All", "-", 
     RowBox[{"m", " ", "plus"}], "-", 
     RowBox[{"2", " ", "projection", " ", "driver"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "runPlus2ProjectionsAllM", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "runPlus2ProjectionsAllM", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<MList\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<CacheRoot\>\"", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<psi0LMCache\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"\"\<Overwrite\>\"", "->", "False"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"runPlus2ProjectionsAllM", "[", 
      RowBox[{
       RowBox[{"ellMax_Integer", ":", "15"}], ",", 
       RowBox[{"nY_Integer", ":", "128"}], ",", "patchAssoc_Association", ",",
        "psifunBuilder_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "mList", ",", "cacheRoot", ",", "overwrite", ",", "allResults", ",", 
         "m", ",", "file", ",", "psifun", ",", "res"}], "}"}], ",", 
       RowBox[{
        RowBox[{"mList", "=", 
         RowBox[{"OptionValue", "[", "\"\<MList\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"mList", "===", "Automatic"}], ",", 
          RowBox[{"mList", "=", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "ellMax"}], ",", "ellMax"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cacheRoot", "=", 
         RowBox[{"OptionValue", "[", "\"\<CacheRoot\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"overwrite", "=", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"OptionValue", "[", "\"\<Overwrite\>\"", "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"ensureDirectory", "[", "cacheRoot", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allResults", "=", 
         RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"file", "=", 
            RowBox[{"psi0LMCacheFile", "[", 
             RowBox[{"cacheRoot", ",", "ellMax", ",", "nY", ",", "m"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"FileExistsQ", "[", "file", "]"}], "&&", 
              RowBox[{"!", "overwrite"}]}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Loading cached plus-2 projection for m = \>\"", ",",
                 "m"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"res", "=", 
               RowBox[{"readMXObject", "[", "file", "]"}]}], ";"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Computing plus-2 projection for m = \>\"", ",", 
                "m"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"psifun", "=", 
               RowBox[{"psifunBuilder", "[", "m", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"res", "=", 
               RowBox[{"runPlus2ProjectionsForM", "[", 
                RowBox[{
                "m", ",", "ellMax", ",", "nY", ",", "patchAssoc", ",", 
                 "psifun"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"writeMXObject", "[", 
               RowBox[{"file", ",", "res"}], "]"}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"allResults", "[", "m", "]"}], "=", "res"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "allResults"}]}], "]"}]}], ";"}]}]}]], "Input",\

