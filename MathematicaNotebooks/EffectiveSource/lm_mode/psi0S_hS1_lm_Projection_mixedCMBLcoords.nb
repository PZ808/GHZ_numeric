Cell[BoxData[
 RowBox[{
  RowBox[{"irgReport", "=", 
   RowBox[{"runIRGTeffGridExport", "[", 
    RowBox[{
     RowBox[{"\"\<Components\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ll\>\"", ",", "\"\<lm\>\"", ",", "\"\<mm\>\""}], "}"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<MList\>\"", "->", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "mMax"}], ",", "mMax"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<OutputDirectory\>\"", "->", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], 
         ",", "\"\<hSm_for_\[Psi]mP_Jets_GridData\>\""}], "}"}], "]"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"\"\<PatchGrids\>\"", "->", "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<left\>\"", "->", "XLeftGridProd"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<right\>\"", "->", "XRightGridProd"}]}], 
       "\[IndentingNewLine]", "|>"}]}], ",", "\[IndentingNewLine]", 
