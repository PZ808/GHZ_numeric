         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Most", "[", "xLO", "]"}], ",", "xLI"}], "]"}]}], ",", 
        RowBox[{"\"\<XRightGrid\>\"", "->", 
         RowBox[{"Join", "[", 
          RowBox[{"xRI", ",", 
           RowBox[{"Rest", "[", "xRO", "]"}]}], "]"}]}], ",", 
        RowBox[{"\"\<WindowHalfWidthR\>\"", "->", "Lwin"}], ",", 
        RowBox[{"\"\<WindowCutoff\>\"", "->", "wcut"}], ",", 
        RowBox[{"\"\<WindowUCut\>\"", "->", "ucut"}], ",", 
