           RowBox[{"+", "2"}], ",", "ellMax", ",", "m"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Building projectors on master kernel for m = \>\"", ",",
           "m", ",", "\"\<...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
