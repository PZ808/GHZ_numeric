       RowBox[{
        RowBox[{"total", "=", 
         RowBox[{
          RowBox[{"Length", "[", "XGrid", "]"}], " ", 
          RowBox[{"Length", "[", "YGrid", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
