     RowBox[{
      RowBox[{"omega", "=", 
       RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rule", "=", 
       RowBox[{"makeGaussLegendreRule", "[", 
        RowBox[{"nY", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yGrid", "=", 
       RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"weights", "=", 
       RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"YGrid", "=", 
       RowBox[{"YofYCos", "/@", "yGrid"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sphVals", "=", 
       RowBox[{"Table", "[", 
