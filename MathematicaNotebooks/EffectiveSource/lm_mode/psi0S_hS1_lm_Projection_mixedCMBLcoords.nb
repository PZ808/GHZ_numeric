          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "ypatch", "]"}], "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "yrule", "]"}], ">=", 
          RowBox[{
           RowBox[{"Min", "[", "ypatch", "]"}], "-", "tol"}]}], "&&", 
         RowBox[{
          RowBox[{"Max", "[", "yrule", "]"}], "<=", 
          RowBox[{
           RowBox[{"Max", "[", "ypatch", "]"}], "+", "tol"}]}]}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
