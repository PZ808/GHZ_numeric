           RowBox[{"ValueQ", "[", "$Currentpsi0fun", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<$Currentpsi0fun is not defined on kernel \>\"", ",", 
             "$KernelID"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ell", "=", 
         RowBox[{"task", "[", "\"\<ell\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"task", "[", "\"\<m\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nY", "=", 
         RowBox[{"task", "[", "\"\<nY\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"patchAssoc", "=", 
         RowBox[{"task", "[", "\"\<PatchAssoc\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"projector", "=", 
         RowBox[{"task", "[", "\"\<Projector\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"patchRules", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"XGrid", "=", 
             RowBox[{"patchAssoc", "[", "patchName", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"timing", "=", 
             RowBox[{"AbsoluteTiming", "[", 
              RowBox[{
               RowBox[{"vals", "=", 
