      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xs", ",", "ys", ",", "projWeights", ",", "vals"}], "}"}], ",", 
       RowBox[{
        RowBox[{"xs", "=", 
