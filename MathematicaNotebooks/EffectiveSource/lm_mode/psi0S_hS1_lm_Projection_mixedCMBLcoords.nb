             RowBox[{"\"\<p - 2\>\"", "->", 
              RowBox[{
               RowBox[{"f", "[", "\"\<p\>\"", "]"}], "-", "2"}]}], ",", 
             RowBox[{"\"\<p - 3\>\"", "->", 
              RowBox[{
               RowBox[{"f", "[", "\"\<p\>\"", "]"}], "-", "3"}]}]}], 
            "|>"}]}]}], "]"}]}], "]"}], ",", "nearDirections"}], "]"}]}], 
