Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"sphTableDir", ",", "sphCacheFiles"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphTableDir", "=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"your", " ", "hSCompileCache", " ", "directory"}], "*)"}], 
      RowBox[{
      ",", "\"\<SpheroidalTables\>\"", ",", "\"\<MacOSX-ARM64-WL14.2\>\""}], 
      "}"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sphCacheFiles", "=", 
    RowBox[{"FileNames", "[", 
     RowBox[{"\"\<*.mx\>\"", ",", "sphTableDir"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<NumberOfFiles\>\"", "->", 
    RowBox[{"Length", "[", "sphCacheFiles", "]"}]}], ",", 
   RowBox[{"\"\<DuplicateNamesQ\>\"", "->", 
    RowBox[{"Not", "@", 
     RowBox[{"DuplicateFreeQ", "[", 
      RowBox[{"FileNameTake", "/@", "sphCacheFiles"}], "]"}]}]}], ",", 
   RowBox[{"\"\<ZeroByteFiles\>\"", "->", 
    RowBox[{"Select", "[", 
     RowBox[{"sphCacheFiles", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"FileByteCount", "[", "#", "]"}], "==", "0"}], "&"}]}], 
     "]"}]}], ",", 
   RowBox[{"\"\<FileSizeRangeMiB\>\"", "->", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"sphCacheFiles", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Missing", "[", "\"\<NoFiles\>\"", "]"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{"FileByteCount", "/@", "sphCacheFiles"}], "]"}], "/", 
        RowBox[{"2", "^", "20"}]}], "]"}]}], "]"}]}]}], "|>"}]}], "Input",
 Evaluatable->False,
