   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "ensureDirectory", ",", "safeName", ",", "writeMXObject", ",", 
      "readMXObject", ",", "psi0LMCacheFile"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"dir", ",", 
         RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"safeName", "[", "x_", "]"}], ":=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"x", ",", "InputForm"}], "]"}], ",", 
       RowBox[{
        RowBox[{"RegularExpression", "[", "\"\<[^A-Za-z0-9_-]\>\"", "]"}], 
        "->", "\"\<_\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "$hSMXObject", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"writeMXObject", "[", 
      RowBox[{"file_String", ",", "obj_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dir", ",", "tmp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"dir", "=", 
         RowBox[{"DirectoryName", "[", "file", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ensureDirectory", "[", "dir", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", 
            RowBox[{"\"\<.\>\"", "<>", 
             RowBox[{"FileBaseName", "[", "file", "]"}], "<>", "\"\<-\>\"", "<>", 
             RowBox[{"CreateUUID", "[", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "$hSMXObject", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"$hSMXObject", "=", "obj"}], ";", "\[IndentingNewLine]", 
        RowBox[{"DumpSave", "[", 
         RowBox[{"tmp", ",", "$hSMXObject"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
          RowBox[{"DeleteFile", "[", "file", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"RenameFile", "[", 
         RowBox[{"tmp", ",", "file"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "$hSMXObject", "]"}], ";", 
        "\[IndentingNewLine]", "file"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"readMXObject", "[", "file_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"Clear", "[", "$hSMXObject", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Get", "[", "file", "]"}], ";", "\[IndentingNewLine]", 
        "$hSMXObject"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"psi0LMCacheFile", "[", 
      RowBox[{
      "root_String", ",", "ellMax_Integer", ",", "nY_Integer", ",", 
       "m_Integer"}], "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"root", ",", "\"\<Plus2Projections_a0p0\>\"", ",", 
        RowBox[{"\"\<ellMax\>\"", "<>", 
         RowBox[{"ToString", "[", "ellMax", "]"}]}], ",", 
        RowBox[{"\"\<nY\>\"", "<>", 
         RowBox[{"ToString", "[", "nY", "]"}]}], ",", 
        RowBox[{"\"\<m\>\"", "<>", 
         RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
