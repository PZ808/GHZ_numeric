       RowBox[{"tag_String", ":", "\"\<\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "bad", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bad", "=", 
         RowBox[{"unevaluatedSourceBuilderCalls", "[", "expr", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"bad", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Unevaluated source-builder calls remain \>\"", ",", 
             "tag", ",", "\"\<:\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
