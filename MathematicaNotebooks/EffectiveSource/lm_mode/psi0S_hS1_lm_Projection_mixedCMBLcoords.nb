 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "makeRadialPatchGridsRefined", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<EpsilonX\>\"", "->", "\[Epsilon]Tiny"}], ",", 
      RowBox[{"\"\<InnerHalfWidth\>\"", "->", "0.01"}], ",", 
      RowBox[{"\"\<WindowHalfWidthR\>\"", "->", "2.0"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "numerical", " ", "rather", " ", "than", " ", "exact", " ", "support", 
        " ", "boundary"}], "*)"}], 
      RowBox[{"\"\<WindowCutoff\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "20"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makeRadialPatchGridsRefined", "[", 
    RowBox[{
    "nLeftOuter_Integer", ",", "nLeftInner_Integer", ",", 
     "nRightInner_Integer", ",", "nRightOuter_Integer", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsX", ",", "dxInner", ",", "Lwin", ",", "wcut", ",", "ucut", ",", 
       "edgeInsetR", ",", "x0", ",", "rWTLeftExact", ",", "rWTRightExact", ",",
        "rLeftEval", ",", "rRightEval", ",", "xWTLeftExact", ",", 
       "xWTRightExact", ",", "xLeftEval", ",", "xRightEval", ",", "xLO", ",", 
       "xLI", ",", "xRI", ",", "xRO"}], "}"}], ",", 
     RowBox[{
      RowBox[{"epsX", "=", 
       RowBox[{"OptionValue", "[", "\"\<EpsilonX\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dxInner", "=", 
       RowBox[{"OptionValue", "[", "\"\<InnerHalfWidth\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Lwin", "=", 
       RowBox[{"OptionValue", "[", "\"\<WindowHalfWidthR\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wcut", "=", 
       RowBox[{"OptionValue", "[", "\"\<WindowCutoff\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", "X0val"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
         "===", "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Exact", " ", "mathematical", " ", "compact"}], "-", 
        RowBox[{"support", " ", "boundaries"}]}], "*)"}], 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
         "===", "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
      RowBox[{"rWTLeftExact", "=", 
       RowBox[{"r0val", "-", "Lwin"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rWTRightExact", "=", 
       RowBox[{"r0val", "+", "Lwin"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xWTLeftExact", "=", 
       RowBox[{"N64", "@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Xval", "[", "rWTLeftExact", "]"}], "/.", " ", "tovals"}], 
          "/.", " ", "to0vals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xWTRightExact", "=", 
       RowBox[{"N64", "@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Xval", "[", "rWTRightExact", "]"}], "/.", " ", "tovals"}],
           "/.", " ", "to0vals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
