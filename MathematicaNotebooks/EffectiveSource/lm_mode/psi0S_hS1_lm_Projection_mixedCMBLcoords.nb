Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "getProjData", ",", "getJoinedProjData", ",", "plotProjectedMode"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getProjData", "[", 
     RowBox[{
     "res_Association", ",", "s_Integer", ",", "ell_Integer", ",", 
      "m_Integer", ",", "patch_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"entry", ",", "X", ",", "vals"}], "}"}], ",", 
      RowBox[{
       RowBox[{"entry", "=", 
        RowBox[{
         RowBox[{"res", "[", "\"\<Data\>\"", "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"s", ",", "ell", ",", "m", ",", "patch"}], "}"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"X", "=", 
        RowBox[{"entry", "[", "\"\<XGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"entry", "[", "\"\<Values\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<X\>\"", "->", "X"}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "vals"}], ",", 
         RowBox[{"\"\<ReData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"X", ",", 
             RowBox[{"Re", "[", "vals", "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"\"\<ImData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"X", ",", 
             RowBox[{"Im", "[", "vals", "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"\"\<AbsData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"X", ",", 
             RowBox[{"Abs", "[", "vals", "]"}]}], "}"}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getJoinedProjData", "[", 
     RowBox[{
     "res_Association", ",", "s_Integer", ",", "ell_Integer", ",", 
      "m_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"left", ",", "right", ",", "X", ",", "vals", ",", "order"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"left", "=", 
        RowBox[{"getProjData", "[", 
         RowBox[{"res", ",", "s", ",", "ell", ",", "m", ",", "\"\<Left\>\""}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"right", "=", 
        RowBox[{"getProjData", "[", 
         RowBox[{
         "res", ",", "s", ",", "ell", ",", "m", ",", "\"\<Right\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"X", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"left", "[", "\"\<X\>\"", "]"}], ",", 
          RowBox[{"right", "[", "\"\<X\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"left", "[", "\"\<Values\>\"", "]"}], ",", 
          RowBox[{"right", "[", "\"\<Values\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", "X", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<X\>\"", "->", 
          RowBox[{"X", "[", 
           RowBox[{"[", "order", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Values\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "order", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<ReData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Re", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"\"\<ImData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Im", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"\"\<AbsData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotProjectedMode", "[", 
    RowBox[{
    "res_Association", ",", "s_Integer", ",", "ell_Integer", ",", 
     "m_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "data", "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"getJoinedProjData", "[", 
        RowBox[{"res", ",", "s", ",", "ell", ",", "m"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "[", "\"\<ReData\>\"", "]"}], ",", 
          RowBox[{"data", "[", "\"\<ImData\>\"", "]"}], ",", 
          RowBox[{"data", "[", "\"\<AbsData\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", "None"}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Psi]0 projection,  s = \>\"", ",", "s", 
            ",", "\"\<, \[ScriptL] = \>\"", ",", "ell", ",", "\"\<, m = \>\"",
             ",", "m"}], "}"}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
