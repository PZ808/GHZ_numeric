       RowBox[{"Flatten", "[", "M", "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"splitGridAt", "[", 
      RowBox[{"XGrid_List", ",", 
       RowBox[{"x0_", ":", 
        RowBox[{"N64", "@", "0"}]}], ",", 
       RowBox[{"gap_", ":", 
        RowBox[{"N64", "@", "0"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xLeft", ",", "xRight"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xLeft", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"XGrid", ",", 
           RowBox[{
            RowBox[{"#", "<", 
             RowBox[{"x0", "-", "gap"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xRight", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"XGrid", ",", 
           RowBox[{
            RowBox[{"#", ">", 
             RowBox[{"x0", "+", "gap"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<Left\>\"", "->", "xLeft"}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Right\>\"", "->", "xRight"}]}], "\[IndentingNewLine]", 
         "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makePatch", "[", 
