Cell[BoxData[{
 RowBox[{
  RowBox[{"lBL", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"PowerExpand", "[", 
               RowBox[{
                SqrtBox[
                 FractionBox[
                  RowBox[{"2", "\[CapitalSigma]"}], "\[CapitalDelta]"]], 
                FractionBox["1", 
                 SqrtBox[
                  RowBox[{
                  "2", "\[CapitalDelta]", " ", "\[CapitalSigma]"}]]]}], "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"r", "[", "]"}], "2"], "+", 
                 SuperscriptBox["a", "2"]}], ",", "\[CapitalDelta]", ",", "0",
                 ",", "a"}], "}"}]}], "/.", "KerrVals"}], "/.", "BLtoCM"}], "//.",
            "ToVars"}], "/.", "apToBD"}], "//", "FullSimplify"}], ")"}], "/.",
        "apToBD"}], "//", "FullSimplify"}], ",", 
     RowBox[{"{", "BL", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nBL", "=", 
