Cell["\<\
For projection, we need values at your quadrature nodes, the fastest thing is \
just to cache the vector of spheroidal harmonic values on the grid.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.988298102026392*^9, 
  3.9882981072614193`*^9}},ExpressionUUID->"73df216a-af7d-4221-a906-\
5e49ded04b16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Production", " ", 
    RowBox[{"compile", "/", "cache"}], " ", "infrastructure"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mergeRules", ",", "toMachineRules", ",", "cacheHash", ",", 
     "ensureDirectory", ",", "getCached", ",", "safeName"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "buildSphYTable", ",", "SphYTableCached", ",", "buildSphBundleForM"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"validSpheroidalPairs", ",", "prebuildSpheroidalTables"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Rules", " ", "earlier", " ", "in", " ", "the", " ", "list", " ", 
     RowBox[{"win", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mergeRules", "[", 
      RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toMachineRules", "[", "rules_List", "]"}], ":=", 
     RowBox[{"rules", "/.", " ", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"l_", ",", "r_"}], "]"}], ":>", 
       RowBox[{"Rule", "[", 
        RowBox[{"l", ",", 
         RowBox[{"N", "[", 
          RowBox[{"r", ",", "MachinePrecision"}], "]"}]}], "]"}]}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cacheHash", "[", "obj_", "]"}], ":=", 
     RowBox[{"StringTake", "[", 
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Hash", "[", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "obj", "]"}], ",", "\"\<SHA256\>\""}],
           "]"}], ",", "16"}], "]"}], ",", "20"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"dir", ",", 
         RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"safeName", "[", "x_", "]"}], ":=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"x", ",", "InputForm"}], "]"}], ",", 
       RowBox[{
        RowBox[{"RegularExpression", "[", "\"\<[^A-Za-z0-9_-]\>\"", "]"}], 
        "->", "\"\<_\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988383862619103*^9, 3.988383862622436*^9}, {
   3.988383951598907*^9, 3.988383978896521*^9}, {3.988384315333365*^9, 
   3.988384315489586*^9}, {3.988384830961358*^9, 3.98838483147427*^9}, 
   3.9883850363334846`*^9, {3.988385483383676*^9, 3.988385522545206*^9}, 
   3.989501065774692*^9},
 CellLabel->
  "In[745]:=",ExpressionUUID->"5e068f37-a57f-49a4-a54a-c7c084696d30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"getCached", ",", "HoldRest"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"getCached", "[", 
    RowBox[{"file_String", ",", "build_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "obj", "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"readMXObject", "[", "file", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"obj", "=", "build"}], ";", "\[IndentingNewLine]", 
      RowBox[{"writeMXObject", "[", 
       RowBox[{"file", ",", "obj"}], "]"}], ";", "\[IndentingNewLine]", 
      "obj"}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988383877774441*^9, 3.988383877777588*^9}, 
   3.988383942806612*^9, {3.988385041454406*^9, 3.988385041617416*^9}, 
   3.988385496701806*^9},
 CellLabel->
  "In[753]:=",ExpressionUUID->"2fa1e616-e461-4a44-b178-0c1df27e4f2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sphYDirect", "]"}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphYDirect", "[", 
     RowBox[{"s0_", ",", "ell0_", ",", "m0_", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", 
      RowBox[{"yCos_", "?", "NumericQ"}], ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ss", ",", "ll", ",", "mm", ",", "theta", ",", "gamma", ",", "val"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"ss", "=", 
        RowBox[{"exactIntLabel", "[", "s0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ll", "=", 
        RowBox[{"exactIntLabel", "[", "ell0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mm", "=", 
        RowBox[{"exactIntLabel", "[", "m0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{"IntegerQ", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Labels are not exact integers: \>\"", ",", 
            RowBox[{"InputForm", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"ll", ">=", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "ss", "]"}], ",", 
              RowBox[{"Abs", "[", "mm", "]"}]}], "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Invalid SWSH labels: \>\"", ",", 
            RowBox[{"{", 
             RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"ArcCos", "[", "yCos", "]"}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gamma", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"aKerr", " ", "omega"}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"val", "=", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"ss", ",", "ll", ",", "mm", ",", "gamma"}], "]"}], "[", 
         RowBox[{"theta", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"NumericQ", "[", "val", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<SWSH did not evaluate numerically for labels: \>\"", ",", 
            RowBox[{"{", 
             RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Heads: \>\"", ",", 
            RowBox[{"Head", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<InputForm labels: \>\"", ",", 
            RowBox[{"InputForm", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<gamma = \>\"", ",", "gamma", ",", "\"\<, theta = \>\"",
             ",", "theta"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"N", "[", 
        RowBox[{"val", ",", "prec"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildSphYTable", "[", 
     RowBox[{"s_", ",", "ell_", ",", "m_", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ss", ",", "ll", ",", "mm", ",", "vals"}], "}"}], ",", 
      RowBox[{
       RowBox[{"ss", "=", 
        RowBox[{"exactIntLabel", "[", "s", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ll", "=", 
        RowBox[{"exactIntLabel", "[", "ell", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mm", "=", 
        RowBox[{"exactIntLabel", "[", "m", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"sphYDirect", "[", 
           RowBox[{
           "ss", ",", "ll", ",", "mm", ",", "omega", ",", "y", ",", "prec"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
