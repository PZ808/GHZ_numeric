Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphOrthogonalityMatrix", "[", 
     RowBox[{"s_Integer", ",", "m_Integer", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
      "ellList_List", ",", 
      RowBox[{"nY_Integer", ":", "NumY"}], ",", 
      RowBox[{"wp_", ":", "MP"}], ",", 
      RowBox[{"phiFactor_", ":", 
       RowBox[{"2", " ", "Pi"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rule", ",", "weights", ",", "vals", ",", "mat"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rule", "=", 
        RowBox[{"makeGaussLegendreRule", "[", 
         RowBox[{"nY", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"sphValsOnRule", "[", 
         RowBox[{"s", ",", "m", ",", "omega", ",", "ellList", ",", "rule"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mat", "=", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"phiFactor", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"weights", " ", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"vals", "[", "ell1", "]"}], "]"}], " ", 
             RowBox[{"vals", "[", "ell2", "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ell1", ",", "ellList"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ell2", ",", "ellList"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", "mat"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphOrthogonalityCheck", "[", 
    RowBox[{"s_Integer", ",", "m_Integer", ",", 
     RowBox[{"omega_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
     "ellList_List", ",", 
     RowBox[{"nY_Integer", ":", "NumY"}], ",", 
     RowBox[{"wp_", ":", "MP"}], ",", 
     RowBox[{"phiFactor_", ":", 
      RowBox[{"2", " ", "Pi"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mat", ",", "id", ",", "err", ",", "offDiag"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"sphOrthogonalityMatrix", "[", 
        RowBox[{
        "s", ",", "m", ",", "omega", ",", "ellList", ",", "nY", ",", "wp", ",",
          "phiFactor"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "ellList", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"err", "=", 
       RowBox[{"mat", "-", "id"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"offDiag", "=", 
       RowBox[{"err", "-", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "err", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Matrix\>\"", "->", "mat"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<ErrorMatrix\>\"", "->", "err"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MaxAbsError\>\"", "->", 
