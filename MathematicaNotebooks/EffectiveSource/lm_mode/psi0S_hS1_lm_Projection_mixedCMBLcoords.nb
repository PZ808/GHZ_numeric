         RowBox[{"Developer`ToPackedArray", "[", "vals", "]"}], ".", 
         "projWeights"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"projectPatchPairFast", "[", 
