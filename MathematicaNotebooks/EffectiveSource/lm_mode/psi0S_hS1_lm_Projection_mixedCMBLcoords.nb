               "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"applyTwoOpsToJet2Num", "[", 
               RowBox[{
                RowBox[{"ops", "[", "\"\<A1\>\"", "]"}], ",", 
