Cell["cache export utils", "Subsubsection",
 CellChangeTimes->{
  3.999331680392494*^9},ExpressionUUID->"8f6da677-8b21-4239-b704-\
023f15a25adb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Evaluate", " ", "compiled", " ", 
      RowBox[{"T_ab", "^", "eff"}], " ", "2"}], "-", 
     RowBox[{"jets", " ", "on", " ", "the", " ", "full", " ", "X"}]}], ",", 
    RowBox[{"Y", " ", "grid"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"one", " ", "file", " ", "per", " ", "m"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "mFileTag", ",", "dumphSGridCache", ",", "loadhSGridCache", ",", 
      "evalCompiledObjectOnXYGrid", ",", "computehSGridForM", ",", 
      "runhSGridCache"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mFileTag", "[", "m_Integer", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", "<", "0"}], ",", 
       RowBox[{"\"\<m\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Abs", "[", "m", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<p\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dumphSGridCache", "[", 
      RowBox[{"file_String", ",", "obj_Association"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"Clear", "[", "hSGridCache", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hSGridCache", "=", "obj"}], ";", "\[IndentingNewLine]", 
        RowBox[{"DumpSave", "[", 
         RowBox[{"file", ",", "hSGridCache"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "hSGridCache", "]"}], ";", 
        "\[IndentingNewLine]", "file"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loadhSGridCache", "[", "file_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"Clear", "[", "hSGridCache", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Get", "[", "file", "]"}], ";", "\[IndentingNewLine]", 
        "hSGridCache"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.990603242818535*^9, 3.9906032428208*^9}, 
   3.99060920600777*^9, {3.999262588572448*^9, 3.999262595256865*^9}, {
   3.999262626317258*^9, 3.9992626346902943`*^9}, {3.999262879446209*^9, 
   3.999262890072316*^9}},
 CellLabel->
  "In[432]:=",ExpressionUUID->"20d1b7f9-3489-4289-8774-96d243bdb381"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"evalCompiledObjectOnXYGrid", "[", 
     RowBox[{"obj_Association", ",", "xgrid_List", ",", "ygrid_List"}], "]"}],
     ":=", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"evalCompiledObjectOnXYGrid", "[", 
        RowBox[{
         RowBox[{"obj", "[", "#", "]"}], ",", "xgrid", ",", "ygrid"}], "]"}], 
       "&"}], ",", 
      RowBox[{"Keys", "[", "obj", "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evalCompiledObjectOnXYGrid", "[", 
    RowBox[{"f_", ",", "xgrid_List", ",", "ygrid_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xs", ",", "ys"}], "}"}], ",", 
     RowBox[{
      RowBox[{"xs", "=", 
       RowBox[{"Developer`ToPackedArray", "[", 
        RowBox[{"N", "@", "xgrid"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ys", "=", 
       RowBox[{"Developer`ToPackedArray", "[", 
        RowBox[{"N", "@", "ygrid"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xs"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "ys"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.99060325257732*^9, 3.990603252579319*^9}},
 CellLabel->
  "In[436]:=",ExpressionUUID->"0f49dadf-07ae-410e-8d07-61ca25f88c83"]
}, Open  ]],

