        RowBox[{"\"\<r0\>\"", "->", "r0val"}], ",", 
        RowBox[{"\"\<B\>\"", "->", "\[ScriptCapitalB]0val"}], ",", 
        RowBox[{"\"\<X0\>\"", "->", "X0val"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<nXLeft\>\"", "->", 
