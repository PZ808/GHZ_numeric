Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numberTag", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "s", "}"}], ",", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"N", "[", 
             RowBox[{"x", ",", "16"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Infinity", ",", "12"}], "}"}], ",", 
           RowBox[{"NumberPoint", "->", "\"\<.\>\""}], ",", 
           RowBox[{"NumberPadding", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
           RowBox[{"ExponentFunction", "->", 
            RowBox[{"(", 
             RowBox[{"Null", "&"}], ")"}]}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"StringTrim", "[", "s", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{"s", ",", "\"\<.\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"s", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"RegularExpression", "[", "\"\<0+$\>\"", "]"}], 
              "->", "\"\<\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"s", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
              "->", "\"\<\>\""}]}], "]"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"s", "==", "\"\<-0\>\""}], ",", 
         RowBox[{"s", "=", "\"\<0\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
           RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spinTag", "[", 
   RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"StringReplace", "[", 
   RowBox[{
    RowBox[{"ToString", "[", 
     RowBox[{"InputForm", "[", 
      RowBox[{"N", "[", 
       RowBox[{"x", ",", "10"}], "]"}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<-\>\"", "\[Rule]", "\"\<m\>\""}], ",", 
      RowBox[{"\"\<.\>\"", "\[Rule]", "\"\<p\>\""}], ",", 
      RowBox[{"\"\<`\>\"", "\[Rule]", "\"\<\>\""}]}], "}"}]}], 
   "]"}]}]}], "Input",
