Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Rules", " ", "earlier", " ", "in", " ", "the", " ", "list", " ", 
    RowBox[{"win", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mergeRules", "[", 
      RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"toMachineRules", "[", "rules_List", "]"}], ":=", 
     RowBox[{"rules", "/.", " ", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"l_", ",", "r_"}], "]"}], ":>", 
       RowBox[{"Rule", "[", 
        RowBox[{"l", ",", 
         RowBox[{"N", "[", 
          RowBox[{"r", ",", "MP"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cacheHash", "[", "obj_", "]"}], ":=", 
     RowBox[{"StringTake", "[", 
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Hash", "[", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "obj", "]"}], ",", "\"\<SHA256\>\""}],
           "]"}], ",", "16"}], "]"}], ",", "20"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"dir", ",", 
         RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"safeName", "[", "x_", "]"}], ":=", 
    RowBox[{"StringReplace", "[", 
     RowBox[{
      RowBox[{"ToString", "[", 
       RowBox[{"x", ",", "InputForm"}], "]"}], ",", 
      RowBox[{
       RowBox[{"RegularExpression", "[", "\"\<[^A-Za-z0-9_-]\>\"", "]"}], 
       "->", "\"\<_\>\""}]}], "]"}]}]}]}]], "Input",
