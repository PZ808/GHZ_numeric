       RowBox[{
        RowBox[{"yrule", "=", 
         RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ypatch", "=", 
         RowBox[{"patch", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tol", "=", 
         RowBox[{
          RowBox[{"10", "^", 
