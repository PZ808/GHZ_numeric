Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "pointwiseConvergenceTable", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointwiseConvergenceTable", "[", 
    RowBox[{
    "vals_List", ",", "XGrid_List", ",", "nYList_List", ",", "inds_List"}], 
    "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"seq", ",", "diffs"}], "}"}], ",", 
       RowBox[{
        RowBox[{"seq", "=", 
         RowBox[{"vals", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "k"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"diffs", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"Differences", "[", "seq", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Index\>\"", "->", "k"}], ",", 
          RowBox[{"\"\<X\>\"", "->", 
           RowBox[{"XGrid", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Values\>\"", "->", 
           RowBox[{"AssociationThread", "[", 
            RowBox[{"nYList", ",", "seq"}], "]"}]}], ",", 
          RowBox[{"\"\<SuccessiveAbsDiffs\>\"", "->", "diffs"}]}], "|>"}]}]}],
       "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "inds"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellLabel->
  "In[1011]:=",ExpressionUUID->"f41a564c-24be-4671-8ad9-e66da9ac8317"]
