          RowBox[{
           RowBox[{"jets", "=", 
            RowBox[{"AssociationMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"evalCompiledAssoc", "[", 
                RowBox[{
                 RowBox[{"jetsC", "[", "#", "]"}], ",", "x", ",", "y"}], 
