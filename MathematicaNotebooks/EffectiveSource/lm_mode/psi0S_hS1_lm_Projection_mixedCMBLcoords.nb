Cell["\<\
For projection, we need values at your quadrature nodes, the fastest thing is \
just to cache the vector of spheroidal harmonic values on the grid.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.988298102026392*^9, 
  3.9882981072614193`*^9}},ExpressionUUID->"73df216a-af7d-4221-a906-\
5e49ded04b16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Production", " ", 
    RowBox[{"compile", "/", "cache"}], " ", "infrastructure"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mergeRules", ",", "toMachineRules", ",", "cacheHash", ",", 
     "ensureDirectory", ",", "getCached", ",", "safeName"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "buildSphYTable", ",", "SphYTableCached", ",", "buildSphBundleForM"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"validSpheroidalPairs", ",", "prebuildSpheroidalTables"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Rules", " ", "earlier", " ", "in", " ", "the", " ", "list", " ", 
     RowBox[{"win", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mergeRules", "[", 
      RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toMachineRules", "[", "rules_List", "]"}], ":=", 
     RowBox[{"rules", "/.", " ", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"l_", ",", "r_"}], "]"}], ":>", 
       RowBox[{"Rule", "[", 
        RowBox[{"l", ",", 
         RowBox[{"N", "[", 
          RowBox[{"r", ",", "MachinePrecision"}], "]"}]}], "]"}]}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cacheHash", "[", "obj_", "]"}], ":=", 
     RowBox[{"StringTake", "[", 
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Hash", "[", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "obj", "]"}], ",", "\"\<SHA256\>\""}],
           "]"}], ",", "16"}], "]"}], ",", "20"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"dir", ",", 
         RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"safeName", "[", "x_", "]"}], ":=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"x", ",", "InputForm"}], "]"}], ",", 
       RowBox[{
        RowBox[{"RegularExpression", "[", "\"\<[^A-Za-z0-9_-]\>\"", "]"}], 
        "->", "\"\<_\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988383862619103*^9, 3.988383862622436*^9}, {
