                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               
               RowBox[{"\"\<Window\>\"", 
                "->", "\"\<4th order XY bump\>\""}]}], "|>"}]}]}], ",", 
           RowBox[{"{", 
