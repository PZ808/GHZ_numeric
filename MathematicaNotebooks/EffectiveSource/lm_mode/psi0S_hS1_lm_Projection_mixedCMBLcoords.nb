     RowBox[{"unevaluatedSourceBuilderCalls", "[", "expr_", "]"}], ":=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"HoldComplete", "[", "expr", "]"}], ",", 
       RowBox[{"HoldPattern", "[", 
        RowBox[{"applyTwoOpsToJet2", "[", "___", "]"}], "]"}], ",", 
       "Infinity"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"tag_String", ":", "\"\<\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "bad", "}"}], ",", 
       RowBox[{
        RowBox[{"bad", "=", 
         RowBox[{"unevaluatedSourceBuilderCalls", "[", "expr", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"bad", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Unevaluated applyTwoOpsToJet2 calls remain \>\"", ",",
              "tag", ",", "\"\<:\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Short", "[", 
             RowBox[{"bad", ",", "3"}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
           "Print", "[", "\"\<This expression is not ready for Compile.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
