Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "applyOpToJet2", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"applyOpToJet2", "[", 
    RowBox[{"op_Association", ",", "jet_Association"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"op", "[", "\"\<AX\>\"", "]"}], " ", 
     RowBox[{"jet", "[", "\"\<X\>\"", "]"}]}], "+", 
    RowBox[{
     RowBox[{"op", "[", "\"\<AY\>\"", "]"}], " ", 
     RowBox[{"jet", "[", "\"\<Y\>\"", "]"}]}], "+", 
    RowBox[{
     RowBox[{"op", "[", "\"\<A0\>\"", "]"}], " ", 
     RowBox[{"jet", "[", "\"\<F\>\"", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988088983354436*^9, 3.9880889953423033`*^9}, 
   3.9993309207441053`*^9},
 CellLabel->
  "In[467]:=",ExpressionUUID->"d52b3d8d-1447-4ee5-b4e7-c0fb0fbd7c03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "applyTwoOpsToJet2", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"applyTwoOpsToJet2", "[", 
    RowBox[{
    "outer_Association", ",", "inner_Association", ",", "jet_Association"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
