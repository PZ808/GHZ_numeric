      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Index\>\"", "->", "k"}], ",", 
        RowBox[{"\"\<X\>\"", "->", 
         RowBox[{"XGrid", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v1\>\"", "->", 
         RowBox[{"v1", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v2\>\"", "->", 
         RowBox[{"v2", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<AbsError\>\"", "->", 
         RowBox[{"err", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<RelError\>\"", "->", 
