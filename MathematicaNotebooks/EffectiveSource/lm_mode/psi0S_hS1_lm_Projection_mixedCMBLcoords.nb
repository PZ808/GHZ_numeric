       RowBox[{",", "x"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "796913d0-f36f-46a2-a104-d6b3cf376eb5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Theta]"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["Y", 
       RowBox[{",", "\[Theta]"}]], 
      SubscriptBox["F", 
       RowBox[{",", "Y"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "d7b478b9-1933-4371-8b9a-4e16d1477d42"],
 " \nwith X = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}], "/", "\[ScriptCapitalB]", " "}], 
   TraditionalForm]],ExpressionUUID->"a3124700-40ce-4331-8230-a2e983346702"],
 " and Y = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["r", "0"]}], "cos\[Theta]"}], TraditionalForm]],
  ExpressionUUID->"3bd58e85-d3d0-49b8-ae31-edb7d6f3d6b6"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    RowBox[{",", "r"}]], TraditionalForm]],ExpressionUUID->
  "6274a12e-0b60-4277-a386-e218a7de882b"],
 " = 1/\[ScriptCapitalB] and ",
