Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prebuildSpheroidalTablesSerial", "[", 
    RowBox[{
    "sList_List", ",", "ellMax_Integer", ",", "omegaOfM_", ",", "yGrid_List", 
     ",", 
     RowBox[{"prec_Integer", ":", "MP"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"specs", ",", "n", ",", 
       RowBox[{"k", "=", "0"}], ",", 
       RowBox[{"built", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"failed", "=", 
        RowBox[{"{", "}"}]}], ",", "spec", ",", "s", ",", "ell", ",", "m", ",",
        "omega"}], "}"}], ",", 
     RowBox[{
      RowBox[{"specs", "=", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"validSpheroidalPairs", "[", 
             RowBox[{"s", ",", "ellMax"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "sList"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "specs", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"spec", "=", 
            RowBox[{"specs", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", ",", "ell", ",", "m"}], "}"}], "=", "spec"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"omega", "=", 
            RowBox[{"omegaOfM", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Quiet", "@", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"SphYTableCachedSerial", "[", 
                RowBox[{
                "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
                 "prec"}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"built", ",", "spec"}], "]"}]}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"failed", ",", "spec"}], "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "n"}], "}"}]}], "]"}], ",", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<building spheroidal table \>\"", ",", "k", 
           ",", "\"\</\>\"", ",", "n", ",", "\"\<   current = \>\"", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"k", ">=", "1"}], "&&", 
              RowBox[{"k", "<=", "n"}]}], ",", 
             RowBox[{"specs", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", "\"\<\>\""}], "]"}], 
           ",", "\"\<   failed = \>\"", ",", 
           RowBox[{"Length", "[", "failed", "]"}]}], "}"}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Built\>\"", "->", "built"}], ",", 
        RowBox[{"\"\<Failed\>\"", "->", "failed"}], ",", 
        RowBox[{"\"\<Count\>\"", "->", 
         RowBox[{"Length", "[", "built", "]"}]}], ",", 
        RowBox[{"\"\<FailedCount\>\"", "->", 
         RowBox[{"Length", "[", "failed", "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 Evaluatable->False,
