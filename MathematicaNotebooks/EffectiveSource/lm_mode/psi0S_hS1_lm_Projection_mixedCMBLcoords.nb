Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "parseMFromFile", ",", "loadIRGTeffGridFile", ",", "readMergedMFolder"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"parseMFromFile", "[", "file_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"name", ",", "hit"}], "}"}], ",", 
      RowBox[{
       RowBox[{"name", "=", 
        RowBox[{"FileNameTake", "[", "file", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hit", "=", 
        RowBox[{"StringCases", "[", 
         RowBox[{"name", ",", 
          RowBox[{
           RowBox[{"\"\<merged_\>\"", "~~", 
            RowBox[{"sign", ":", 
             RowBox[{"(", 
              RowBox[{"\"\<mp\>\"", "|", "\"\<mm\>\""}], ")"}]}], "~~", 
            RowBox[{"n", ":", 
             RowBox[{"DigitCharacter", ".."}]}], "~~", "\"\<.mx\>\""}], ":>", 
           
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"sign", "===", "\"\<mp\>\""}], ",", "1", ",", 
              RowBox[{"-", "1"}]}], "]"}], " ", 
            RowBox[{"ToExpression", "[", "n", "]"}]}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hit", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Missing", "[", 
          RowBox[{"\"\<CouldNotParseM\>\"", ",", "name"}], "]"}], ",", 
         RowBox[{"First", "[", "hit", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"loadIRGTeffGridFile", "[", "file_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "data", "}"}], ",", 
      RowBox[{
       RowBox[{"Clear", "[", "IRGTeffGridData", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "These", " ", "files", " ", "define", " ", "IRGTeffGridData"}], 
        "*)"}], 
       RowBox[{"Get", "[", "file", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"data", "=", "IRGTeffGridData"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Failed to load association from: \>\"", ",", "file"}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "data"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readMergedMFolder", "[", "dir_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"files", ",", "pairs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"files", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<TaBR_IRGGrid_merged_*.mx\>\"", ",", "dir"}], "]"}], ",",
          "parseMFromFile"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Found \>\"", ",", 
        RowBox[{"Length", "[", "files", "]"}], ",", "\"\< files\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Column", "[", 
        RowBox[{"FileNameTake", "/@", 
         RowBox[{"Take", "[", 
          RowBox[{"files", ",", 
           RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pairs", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"parseMFromFile", "[", "file", "]"}], "->", 
          RowBox[{"loadIRGTeffGridFile", "[", "file", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"file", ",", "files"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Association", "@", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"pairs", ",", 
         RowBox[{"_", "->", "$Failed"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.990864403066897*^9, 3.990864403069031*^9}},
