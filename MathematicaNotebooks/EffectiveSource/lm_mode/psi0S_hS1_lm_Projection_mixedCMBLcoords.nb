          "apToBD"}], "//", "FullSimplify"}], ")"}], "/.", "apToBD"}], "//", 
      "FullSimplify"}], ",", 
     RowBox[{"{", "BL", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mBarBL", "=", 
