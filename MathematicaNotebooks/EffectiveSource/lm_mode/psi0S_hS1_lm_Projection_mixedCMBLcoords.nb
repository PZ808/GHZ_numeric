Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numberTag", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "s", "}"}], ",", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"N", "[", 
             RowBox[{"x", ",", "16"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Infinity", ",", "12"}], "}"}], ",", 
           RowBox[{"NumberPoint", "->", "\"\<.\>\""}], ",", 
           RowBox[{"NumberPadding", "->", 
            RowBox[{"{", 
