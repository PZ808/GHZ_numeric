   RowBox[{"makeModeDirectionalOpMixed", "[", 
    RowBox[{"vec_Association", ",", "m_", ",", 
     RowBox[{"zeroExtra_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"omega", ",", "AX", ",", "AY", ",", "A0"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"omega", "=", 
       RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AX", "=", 
       RowBox[{"vec", "[", "\"\<X\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AY", "=", 
       RowBox[{"vec", "[", "\"\<Y\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A0", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", "omega", " ", 
         RowBox[{"vec", "[", "\"\<t\>\"", "]"}]}], "+", 
        RowBox[{"I", " ", "m", " ", 
         RowBox[{"vec", "[", "\"\<phi\>\"", "]"}]}], "+", "zeroExtra"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"makeFirstOrderOp", "[", 
       RowBox[{"AX", ",", "AY", ",", "A0"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
