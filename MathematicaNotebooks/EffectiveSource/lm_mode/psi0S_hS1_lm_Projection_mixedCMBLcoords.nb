       "\[IndentingNewLine]", 
       RowBox[{"extra", "=", 
        RowBox[{"OptionValue", "[", "\"\<ExtraMetadata\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"outDir", "===", "Automatic"}], ",", 
         RowBox[{"outDir", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<hS_psi0_IRG_Comps_GridCache\>\""}], "}"}], "]"}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
