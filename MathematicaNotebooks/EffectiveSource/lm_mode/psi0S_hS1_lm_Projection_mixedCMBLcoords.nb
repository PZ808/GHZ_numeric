Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"offDiagonalPart", ",", "checkSpheroidalFamily"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"offDiagonalPart", "[", 
     RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"matrix", "-", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Diagonal", "[", "matrix", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"checkSpheroidalFamily", "[", 
    RowBox[{"s_Integer", ",", "m_Integer", ",", 
     RowBox[{"omega0_", "?", "NumericQ"}], ",", "ellList_List", ",", 
     "rule_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "y", ",", "w", ",", "sphMat", ",", "gram", ",", "norms", ",", 
       "normMatrix", ",", "normalizedGram", ",", "coeffs", ",", 
       "normalizedSphMat", ",", "weightedBra", ",", "field", ",", 
       "recoveredCoeffs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"y", "=", 
       RowBox[{"N", "@", 
        RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{"N", "@", 
        RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sphMat", "=", 
       RowBox[{"sphMatrixOnRule", "[", 
        RowBox[{"s", ",", "m", ",", "omega0", ",", "ellList", ",", "rule"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gram", "=", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "w"}], "&"}], ",", 
          RowBox[{"Conjugate", "[", "sphMat", "]"}]}], "]"}], ".", 
        RowBox[{"Transpose", "[", "sphMat", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"norms", "=", 
       RowBox[{"Re", "@", 
        RowBox[{"Diagonal", "[", "gram", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"normMatrix", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "norms", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"normalizedGram", "=", 
       RowBox[{"normMatrix", ".", "gram", ".", "normMatrix"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"normalizedSphMat", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "/", 
           RowBox[{"Sqrt", "[", "#2", "]"}]}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"sphMat", ",", "norms"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SeedRandom", "[", "12345", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeffs", "=", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"Length", "[", "ellList", "]"}]}], "]"}], "+", 
        RowBox[{"I", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"Length", "[", "ellList", "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"field", "=", 
       RowBox[{"coeffs", ".", "normalizedSphMat"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"weightedBra", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", "w"}], "&"}], ",", 
         RowBox[{"Conjugate", "[", "normalizedSphMat", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"recoveredCoeffs", "=", 
       RowBox[{"weightedBra", ".", "field"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<s\>\"", "->", "s"}], ",", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<omega0\>\"", "->", "omega0"}], ",", 
        RowBox[{"\"\<ellList\>\"", "->", "ellList"}], ",", 
        RowBox[{"\"\<Dimensions\>\"", "->", 
         RowBox[{"Dimensions", "[", "sphMat", "]"}]}], ",", 
        RowBox[{"\"\<NumericMatrixQ\>\"", "->", 
         RowBox[{"MatrixQ", "[", 
          RowBox[{"sphMat", ",", "NumericQ"}], "]"}]}], ",", 
        RowBox[{"\"\<RawNorms\>\"", "->", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"ellList", ",", "norms"}], "]"}]}], ",", 
        RowBox[{"\"\<RawNormRange\>\"", "->", 
         RowBox[{"MinMax", "[", "norms", "]"}]}], ",", 
        RowBox[{"\"\<MaxRawNormErrorFromOne\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"norms", "-", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MaxNormalizedDiagonalError\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Diagonal", "[", "normalizedGram", "]"}], "-", "1"}], 
           "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MaxNormalizedOffDiagonal\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"offDiagonalPart", "[", "normalizedGram", "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<MaxImaginaryPartOfValues\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Im", "[", "sphMat", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<NormalizedRoundTripError\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"recoveredCoeffs", "-", "coeffs"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<NormalizedGramMatrix\>\"", "->", "normalizedGram"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
