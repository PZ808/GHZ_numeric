Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Read", "/", "write"}], " ", "one", " ", "saved", " ", "IRG", " ",
     "grid", " ", "file"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"readIRGGridFile", ",", "writeIRGGridFile"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"readIRGGridFile", "[", "file_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "obj", "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"FileExistsQ", "[", "file", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Missing file: \>\"", ",", "file"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"IRGhSGridData", ",", "teffGridCache"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Get", "[", "file", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ValueQ", "[", "IRGhSGridData", "]"}], "&&", 
            RowBox[{"AssociationQ", "[", "IRGhSGridData", "]"}]}], ",", 
           "IRGhSGridData", ",", 
           RowBox[{
            RowBox[{"ValueQ", "[", "teffGridCache", "]"}], "&&", 
            RowBox[{"AssociationQ", "[", "teffGridCache", "]"}]}], ",", 
           "teffGridCache", ",", "True", ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             
             RowBox[{"\"\<Could not find saved association in file: \>\"", ",",
               "file"}], "]"}], ";", "\[IndentingNewLine]", "$Failed"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"IRGhSGridData", ",", "teffGridCache"}], "]"}], ";", 
        "\[IndentingNewLine]", "obj"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"writeIRGGridFile", "[", 
      RowBox[{"file_String", ",", "obj_Association"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"Clear", "[", "IRGhSGridData", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"IRGhSGridData", "=", "obj"}], ";", "\[IndentingNewLine]", 
        RowBox[{"DumpSave", "[", 
         RowBox[{"file", ",", "IRGhSGridData"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", "IRGhSGridData", "]"}], ";", 
        "\[IndentingNewLine]", "file"}]}], "]"}]}], ";"}]}]}]], "Input",
