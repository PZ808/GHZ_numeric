        "\[IndentingNewLine]", 
        RowBox[{"valsYLeft", "=", 
         RowBox[{"projectOnXGridSideFast", "[", 
          RowBox[{"psifun", ",", 
           RowBox[{"projectors", "[", "\"\<YLeft\>\"", "]"}], ",", "xLeft"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"valsYRight", "=", 
         RowBox[{"projectOnXGridSideFast", "[", 
          RowBox[{"psifun", ",", 
           RowBox[{"projectors", "[", "\"\<YRight\>\"", "]"}], ",", "xLeft"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<XGrid\>\"", "->", "xLeft"}], ",", 
