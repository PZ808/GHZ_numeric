Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "angularIntegrandSamples", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angularIntegrandSamples", "[", 
     RowBox[{"psifun_", ",", "projector_Association", ",", 
      RowBox[{"Xval_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "yGrid", ",", "YGrid", ",", "sph", ",", "srcVals", ",", "vals"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"yGrid", "=", 
        RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YGrid", "=", 
        RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sph", "=", 
        RowBox[{"projector", "[", "\"\<SpheroidalValues\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"srcVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"psifun", "[", 
           RowBox[{"Xval", ",", 
            RowBox[{"YGrid", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"sph", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
           RowBox[{"srcVals", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
