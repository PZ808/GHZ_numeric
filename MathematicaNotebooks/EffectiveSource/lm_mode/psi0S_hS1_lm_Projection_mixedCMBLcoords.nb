                 RowBox[{"Length", "[", "ygrid", "]"}]}]}], "|>"}], "&"}], ",", 
             RowBox[{"Keys", "[", "xPatchGrids", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<Created\>\"", "->", 
           RowBox[{"DateString", "[", "]"}]}], ",", 
          RowBox[{"\"\<Metadata\>\"", "->", "extra"}]}], "|>"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dumphSGridCache", "[", 
        RowBox[{"file", ",", "obj"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
