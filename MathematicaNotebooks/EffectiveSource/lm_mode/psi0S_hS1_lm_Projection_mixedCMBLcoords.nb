        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "tail", "]"}], "<", "3"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<error\>\"", "->", "\"\<Too few data points\>\""}], ",", 
            RowBox[{"\"\<tailData\>\"", "->", "tail"}]}], "|>"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fit", "=", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Log", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
            "tail"}], ")"}], ",", "x", ",", "x"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"alpha", "=", 
        RowBox[{"-", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Normal", "[", "fit", "]"}], ",", "x"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ms", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"mmin", ",", "mmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"curve", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Exp", "[", 
             RowBox[{"fit", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "ms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<alpha\>\"", "->", "alpha"}], ",", 
         RowBox[{"\"\<fit\>\"", "->", "fit"}], ",", 
         RowBox[{"\"\<RSquared\>\"", "->", 
          RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
         RowBox[{"\"\<curve\>\"", "->", "curve"}], ",", 
         RowBox[{"\"\<plot\>\"", "->", 
          RowBox[{"ListLogPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"data", ",", "curve"}], "}"}], ",", 
            RowBox[{"Joined", "->", 
             RowBox[{"{", 
              RowBox[{"False", ",", "True"}], "}"}]}], ",", 
            RowBox[{"PlotMarkers", "->", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "None"}], "}"}]}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<|m|\>\"", ",", "\"\<amplitude\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<data\>\"", ",", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<exp fit: \[Alpha] = \>\"", ",", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"alpha", ",", 
                    RowBox[{"{", 
                    RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
               "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Exponential fit over \>\"", ",", "mmin", 
                ",", "\"\< \[LessEqual] |m| \[LessEqual] \>\"", ",", "mmax"}],
                "}"}], "]"}]}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fitPowerLaw", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"{", 
       RowBox[{"mmin_", ",", "mmax_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tail", ",", "x", ",", "fit", ",", "p", ",", "curve", ",", "ms"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"tail", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"mmin", "<=", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", "mmax"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "tail", "]"}], "<", "3"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<error\>\"", "->", "\"\<Too few data points\>\""}], ",", 
            RowBox[{"\"\<tailData\>\"", "->", "tail"}]}], "|>"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fit", "=", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
               RowBox[{"Log", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
            "tail"}], ")"}], ",", "x", ",", "x"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"-", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Normal", "[", "fit", "]"}], ",", "x"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ms", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"mmin", ",", "mmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"curve", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Exp", "[", 
             RowBox[{"fit", "[", 
              RowBox[{"Log", "[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@",
          "ms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<p\>\"", "->", "p"}], ",", 
         RowBox[{"\"\<fit\>\"", "->", "fit"}], ",", 
         RowBox[{"\"\<RSquared\>\"", "->", 
          RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
         RowBox[{"\"\<curve\>\"", "->", "curve"}], ",", 
         RowBox[{"\"\<plot\>\"", "->", 
          RowBox[{"ListLogLogPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"data", ",", "curve"}], "}"}], ",", 
            RowBox[{"Joined", "->", 
             RowBox[{"{", 
              RowBox[{"False", ",", "True"}], "}"}]}], ",", 
            RowBox[{"PlotMarkers", "->", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "None"}], "}"}]}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<|m|\>\"", ",", "\"\<amplitude\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<data\>\"", ",", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<power fit: p = \>\"", ",", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"p", ",", 
                    RowBox[{"{", 
                    RowBox[{"6", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
               "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Power-law fit over \>\"", ",", "mmin", 
                ",", "\"\< \[LessEqual] |m| \[LessEqual] \>\"", ",", "mmax"}],
                "}"}], "]"}]}], ",", 
            RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compareFalloffFits", "[", 
    RowBox[{"data_", ",", "fitRange_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"exp", ",", "pow"}], "}"}], ",", 
     RowBox[{
      RowBox[{"exp", "=", 
       RowBox[{"fitExpLaw", "[", 
        RowBox[{"data", ",", "fitRange"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pow", "=", 
       RowBox[{"fitPowerLaw", "[", 
        RowBox[{"data", ",", "fitRange"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<fitRange\>\"", "->", "fitRange"}], ",", 
        RowBox[{"\"\<exponentialAlpha\>\"", "->", 
         RowBox[{"exp", "[", "\"\<alpha\>\"", "]"}]}], ",", 
        RowBox[{"\"\<exponentialRSquared\>\"", "->", 
         RowBox[{"exp", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
        RowBox[{"\"\<powerLawP\>\"", "->", 
         RowBox[{"pow", "[", "\"\<p\>\"", "]"}]}], ",", 
        RowBox[{"\"\<powerLawRSquared\>\"", "->", 
         RowBox[{"pow", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
        RowBox[{"\"\<expPlot\>\"", "->", 
         RowBox[{"exp", "[", "\"\<plot\>\"", "]"}]}], ",", 
        RowBox[{"\"\<powerPlot\>\"", "->", 
         RowBox[{"pow", "[", "\"\<plot\>\"", "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",
