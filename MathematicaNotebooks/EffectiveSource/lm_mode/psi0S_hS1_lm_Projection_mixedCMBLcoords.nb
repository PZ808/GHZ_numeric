Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "sYLmsThetaPhi", ",", "SsphThetaPhi", ",", "sSlmw$y", ",", "sYLmsy"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sYLmsThetaPhi", "[", 
     RowBox[{"s_", ",", "ell_", ",", "m_"}], "]"}], "[", 
    RowBox[{
     RowBox[{"theta_", "?", "NumericQ"}], ",", 
     RowBox[{"phi_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "ell", ",", "m", ",", "theta", ",", "phi"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SsphThetaPhi", "[", 
      RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
     RowBox[{
      RowBox[{"theta_", "?", "NumericQ"}], ",", 
      RowBox[{"phi_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "gamma", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gamma", "=", 
        RowBox[{"aKerr", " ", "omega"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{"s", ",", "ell", ",", "m", ",", "gamma"}], "]"}], "[", 
        RowBox[{"theta", ",", "phi"}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
