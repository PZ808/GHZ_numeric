       RowBox[{"s", "===", "\"\<plus\>\""}]}], ",", "\"\<MostlyPlus\>\"", ",",
       "True", ",", "$Failed"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
