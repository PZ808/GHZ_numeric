Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "projectionEntryCheck", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"projectionEntryCheck", "[", "res_Association", "]"}], ":=", 
    RowBox[{"Dataset", "@", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"key", ",", "entry"}], "}"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Key\>\"", "->", "key"}], ",", 
           RowBox[{"\"\<nX\>\"", "->", 
            RowBox[{"Length", "[", 
             RowBox[{"entry", "[", "\"\<XGrid\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<nVals\>\"", "->", 
            RowBox[{"Length", "[", 
             RowBox[{"entry", "[", "\"\<Values\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<All numeric\>\"", "->", 
            RowBox[{"VectorQ", "[", 
             RowBox[{
              RowBox[{"entry", "[", "\"\<Values\>\"", "]"}], ",", 
              "NumericQ"}], "]"}]}], ",", 
           RowBox[{"\"\<MaxAbs\>\"", "->", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"entry", "[", "\"\<Values\>\"", "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<MinAbs\>\"", "->", 
            RowBox[{"Min", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"entry", "[", "\"\<Values\>\"", "]"}], "]"}], "]"}]}]}],
           "|>"}]}], "]"}], ",", "res"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"projectionEntryCheck", "[", 
  RowBox[{"\[Psi]m2", "[", "\"\<Data\>\"", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9882511318561487`*^9, 3.988251131859489*^9}, {
  3.999321228687684*^9, 3.9993212387852488`*^9}},
