   RowBox[{"ensureDirectory", "[", "$psi0MCacheDir", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"psi0MFile", ",", "computepsi0M"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"psi0MFile", "[", "m_Integer", "]"}], ":=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$psi0MCacheDir", ",", 
       RowBox[{"\"\<psi0_m\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"computepsi0M", "[", 
    RowBox[{"m_Integer", ",", "patches_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "file", ",", "fun", ",", "data", ",", "storedPatches", ",", 
       "dimensions", ",", "payload"}], "}"}], ",", 
     RowBox[{
      RowBox[{"file", "=", 
       RowBox[{"psi0MFile", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"readMXObject", "[", "file", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Computing psi0 for m = \>\"", ",", "m"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Build", " ", "the", " ", "pointwise", " ", "evaluator", " ", "only", " ",
         "once", " ", "for", " ", "this", " ", "m"}], "*)"}], 
      "\[IndentingNewLine]", 
