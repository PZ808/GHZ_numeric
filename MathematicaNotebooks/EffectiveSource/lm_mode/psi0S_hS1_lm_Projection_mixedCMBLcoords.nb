             RowBox[{"x0", "+", "dxInner"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xRO", "=", 
         RowBox[{"affineChebLobattoGrid", "[", 
          RowBox[{"nRightOuter", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x0", "+", "dxInner"}], ",", "xWTRight"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xRE", "=", 
         RowBox[{"affineChebLobattoGrid", "[", 
          RowBox[{"nExt", ",", 
           RowBox[{"{", 
            RowBox[{"xWTRight", ",", "xDomainRight"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Remove", " ", "duplicated", " ", "Lobatto", " ", "endpoints", " ", 
          "when", " ", "joining"}], "*)"}], 
        RowBox[{"xLeft", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Most", "[", "xLE", "]"}], ",", 
           RowBox[{"Most", "[", "xLO", "]"}], ",", "xLI"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xRight", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"xRI", ",", 
           RowBox[{"Rest", "[", "xRO", "]"}], ",", 
           RowBox[{"Rest", "[", "xRE", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xFull", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"xLeft", ",", "xRight"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<X0\>\"", "->", "x0"}], ",", 
          RowBox[{"(*", 
           RowBox[{"world", "-", 
            RowBox[{
             RowBox[{"tube", "/", "support"}], " ", "boundaries"}]}], "*)"}], 
          
          RowBox[{"\"\<XWTLeft\>\"", "->", "xWTLeft"}], ",", 
          RowBox[{"\"\<XWTRight\>\"", "->", "xWTRight"}], ",", 
          RowBox[{"(*", 
           RowBox[{"full", " ", 
            RowBox[{"plotting", "/", "computational"}], " ", "domain"}], 
           "*)"}], 
          RowBox[{"\"\<XDomainLeft\>\"", "->", "xDomainLeft"}], ",", 
          RowBox[{"\"\<XDomainRight\>\"", "->", "xDomainRight"}], ",", 
          RowBox[{"(*", 
           RowBox[{"individual", " ", "patches"}], "*)"}], 
          RowBox[{"\"\<XLeftExteriorGrid\>\"", "->", "xLE"}], ",", 
          RowBox[{"\"\<XLeftOuterGrid\>\"", "->", "xLO"}], ",", 
          RowBox[{"\"\<XLeftInnerGrid\>\"", "->", "xLI"}], ",", 
          RowBox[{"\"\<XRightInnerGrid\>\"", "->", "xRI"}], ",", 
          RowBox[{"\"\<XRightOuterGrid\>\"", "->", "xRO"}], ",", 
          RowBox[{"\"\<XRightExteriorGrid\>\"", "->", "xRE"}], ",", 
          RowBox[{"(*", 
           RowBox[{"joined", " ", "grids"}], "*)"}], 
          RowBox[{"\"\<XLeftGrid\>\"", "->", "xLeft"}], ",", 
          RowBox[{"\"\<XRightGrid\>\"", "->", "xRight"}], ",", 
          RowBox[{"\"\<XFullGrid\>\"", "->", "xFull"}], ",", 
          RowBox[{"(*", 
           RowBox[{"useful", " ", "physical", " ", "metadata"}], "*)"}], 
          RowBox[{"\"\<RWTLeft\>\"", "->", "rWTLeft"}], ",", 
          RowBox[{"\"\<RWTRight\>\"", "->", "rWTRight"}], ",", 
          RowBox[{"\"\<WindowHalfWidthR\>\"", "->", "Lwin"}]}], "|>"}]}]}], 
      "]"}]}], ";"}], " ", "*)"}]}]], "Input",
