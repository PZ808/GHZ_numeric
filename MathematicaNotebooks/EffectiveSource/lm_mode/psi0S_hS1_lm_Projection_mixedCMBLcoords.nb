        RowBox[{"\"\<ellMax\>\"", "<>", 
         RowBox[{"ToString", "[", "ellMax", "]"}]}], ",", 
        RowBox[{"\"\<nY\>\"", "<>", 
         RowBox[{"ToString", "[", "nY", "]"}]}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{"psi0LMCacheFile", "[", 
      RowBox[{
      "root_String", ",", "ellMax_Integer", ",", "nY_Integer", ",", 
       "m_Integer"}], "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"plus2ProjectionDir", "[", 
         RowBox[{"root", ",", "ellMax", ",", "nY"}], "]"}], ",", 
        RowBox[{"\"\<m\>\"", "<>", 
         RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}], 
      "]"}]}], ";"}], " ", "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"dir", ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "$psi0SMXObject", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"writeMXObject", "[", 
     RowBox[{"file_String", ",", "obj_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dir", ",", "tmp"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"DirectoryName", "[", "file", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ensureDirectory", "[", "dir", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tmp", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", 
           RowBox[{"\"\<.\>\"", "<>", 
            RowBox[{"FileBaseName", "[", "file", "]"}], "<>", "\"\<-\>\"", "<>", 
            RowBox[{"CreateUUID", "[", "]"}], "<>", "\"\<.mx\>\""}]}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "$psi0SMXObject", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"$psi0SMXObject", "=", "obj"}], ";", "\[IndentingNewLine]", 
       RowBox[{"DumpSave", "[", 
        RowBox[{"tmp", ",", "$psi0SMXObject"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
         RowBox[{"DeleteFile", "[", "file", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"RenameFile", "[", 
        RowBox[{"tmp", ",", "file"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "$psi0SMXObject", "]"}], ";", 
       "\[IndentingNewLine]", "file"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readMXObject", "[", "file_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{
      RowBox[{"Clear", "[", "$psi0SMXObject", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Get", "[", "file", "]"}], ";", "\[IndentingNewLine]", 
