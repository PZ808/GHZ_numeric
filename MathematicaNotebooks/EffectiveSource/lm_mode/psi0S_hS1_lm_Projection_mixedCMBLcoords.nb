 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computehSGridForM", "[", 
     RowBox[{"m_Integer", ",", "xPatchGrids_Association", ",", "ygrid_List", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "components", ",", "outDir", ",", "overwrite", ",", "extra", ",", 
