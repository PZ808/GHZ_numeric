  3.9885326618527737`*^9}},ExpressionUUID->"f6584e11-ad41-4d3f-9eb6-\
b75f1055add2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "heldOwnValueBytes", ",", "heldDefinitionBytes", ",", 
     "TopGlobalOwnValueMemory", ",", "TopGlobalMemory"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"heldOwnValueBytes", ",", "HoldFirst"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heldOwnValueBytes", "[", "s_Symbol", "]"}], ":=", 
    RowBox[{"ByteCount", "[", 
     RowBox[{"OwnValues", "[", 
      RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"heldDefinitionBytes", ",", "HoldFirst"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heldDefinitionBytes", "[", "s_Symbol", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{"ByteCount", "/@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OwnValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"DownValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"UpValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"SubValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"FormatValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"NValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"DefaultValues", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"Options", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"Messages", "[", 
         RowBox[{"Unevaluated", "[", "s", "]"}], "]"}]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TopGlobalOwnValueMemory", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TopGlobalOwnValueMemory", "[", 
     RowBox[{
      RowBox[{"n_", ":", "10"}], ",", 
      RowBox[{"patt_", ":", "\"\<Global`*\>\""}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"names", ",", "rows"}], "}"}], ",", 
      RowBox[{
       RowBox[{"names", "=", 
        RowBox[{"Names", "[", "patt", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"bytes", "=", 
              RowBox[{"ToExpression", "[", 
               RowBox[{"name", ",", "InputForm", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"heldOwnValueBytes", "[", "s", "]"}], ",", 
                  "HoldAllComplete"}], "]"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"name", ",", "bytes", ",", 
              RowBox[{"N", "[", 
               RowBox[{"bytes", "/", 
                RowBox[{"2.", "^", "20"}]}], "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"TakeLargestBy", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
          RowBox[{"UpTo", "[", "n", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"rows", "/.", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"name_", ",", "bytes_", ",", "mib_"}], "}"}], ":>", 
             RowBox[{"{", 
              RowBox[{"name", ",", "bytes", ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"mib", ",", 
                 RowBox[{"{", 
                  RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}]}]}],
            ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Symbol\>\"", ",", "\"\<Bytes\>\"", 
             ",", "\"\<MiB\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Left"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TopGlobalMemory", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TopGlobalMemory", "[", 
    RowBox[{
     RowBox[{"n_", ":", "10"}], ",", 
     RowBox[{"patt_", ":", "\"\<Global`*\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"names", ",", "rows"}], "}"}], ",", 
     RowBox[{
      RowBox[{"names", "=", 
       RowBox[{"Names", "[", "patt", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"bytes", "=", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"name", ",", "InputForm", ",", 
               RowBox[{"Function", "[", 
                RowBox[{"s", ",", 
                 RowBox[{"heldDefinitionBytes", "[", "s", "]"}], ",", 
                 "HoldAllComplete"}], "]"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"name", ",", "bytes", ",", 
             RowBox[{"N", "[", 
              RowBox[{"bytes", "/", 
               RowBox[{"2.", "^", "20"}]}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"name", ",", "names"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"rows", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"TakeLargestBy", "[", 
        RowBox[{"rows", ",", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"rows", "/.", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"name_", ",", "bytes_", ",", "mib_"}], "}"}], ":>", 
            RowBox[{"{", 
             RowBox[{"name", ",", "bytes", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"mib", ",", 
                RowBox[{"{", 
                 RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}]}]}], 
          ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Symbol\>\"", ",", "\"\<Bytes\>\"", 
            ",", "\"\<MiB\>\""}], "}"}]}], "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
