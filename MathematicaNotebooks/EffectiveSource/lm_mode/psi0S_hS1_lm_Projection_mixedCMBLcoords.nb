      RowBox[{"(*", 
       RowBox[{"Numerically", " ", "active", " ", "support"}], "*)"}], 
      RowBox[{"(*", "*)"}], 
      RowBox[{"(*", 
       RowBox[{
       "Do", " ", "not", " ", "spend", " ", "Lobatto", " ", "points", " ", 
        "where", " ", "W", " ", "is", " ", 
        RowBox[{"e", ".", "g", ".", 
         RowBox[{"10", "^", 
          RowBox[{"-", "200."}]}]}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
       "Instead", " ", "stop", " ", "when", " ", "W", " ", "reaches", " ", 
        "the", " ", "requested", " ", "numerical"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"cutoff", ".", "Outside"}], " ", "this", " ", "region", " ", 
        "the", " ", "source", " ", "is", " ", "numerically"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"treated", " ", "as", " ", 
        RowBox[{"zero", "."}]}], "*)"}], 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
         "===", "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
      RowBox[{"ucut", "=", 
       RowBox[{"bumpUFromCutoff", "[", "wcut", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"edgeInsetR", "=", 
       RowBox[{"Lwin", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "ucut"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rLeftEval", "=", 
       RowBox[{"r0val", "-", 
        RowBox[{"Lwin", " ", "ucut"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rRightEval", "=", 
       RowBox[{"r0val", "+", 
        RowBox[{"Lwin", " ", "ucut"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xLeftEval", "=", 
       RowBox[{"N64", "@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Xval", "[", "rLeftEval", "]"}], "/.", " ", "tovals"}], "/.",
           " ", "to0vals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xRightEval", "=", 
       RowBox[{"N64", "@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Xval", "[", "rRightEval", "]"}], "/.", " ", "tovals"}], "/.",
           " ", "to0vals"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
         "===", "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"Four", " ", "radial", " ", "patches"}], "*)"}], 
      RowBox[{"(*", "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"active", " ", "edge"}], "|", "outer", "|", 
        RowBox[{"inner", "||", "inner"}], "|", "outer", "|", 
        RowBox[{"active", " ", "edge"}]}], "*)"}], 
      RowBox[{"(*", " ", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
         "===", "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
      RowBox[{"xLO", "=", 
       RowBox[{"affineChebLobattoGrid", "[", 
        RowBox[{"nLeftOuter", ",", 
         RowBox[{"{", 
          RowBox[{"xLeftEval", ",", 
           RowBox[{"x0", "-", "dxInner"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xLI", "=", 
       RowBox[{"affineChebLobattoGrid", "[", 
        RowBox[{"nLeftInner", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x0", "-", "dxInner"}], ",", 
           RowBox[{"x0", "-", "epsX"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xRI", "=", 
       RowBox[{"affineChebLobattoGrid", "[", 
        RowBox[{"nRightInner", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x0", "+", "epsX"}], ",", 
           RowBox[{"x0", "+", "dxInner"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xRO", "=", 
       RowBox[{"affineChebLobattoGrid", "[", 
        RowBox[{"nRightOuter", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x0", "+", "dxInner"}], ",", "xRightEval"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<X0\>\"", "->", "x0"}], ",", 
        RowBox[{"(*", 
         RowBox[{"exact", " ", "support"}], "*)"}], 
        RowBox[{"\"\<XWTLeftExact\>\"", "->", "xWTLeftExact"}], ",", 
        RowBox[{"\"\<XWTRightExact\>\"", "->", "xWTRightExact"}], ",", 
        RowBox[{"(*", 
