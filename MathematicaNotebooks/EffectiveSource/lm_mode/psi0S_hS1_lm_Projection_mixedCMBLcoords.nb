Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "numberTag", ",", "spinTag", ",", "plus2ProjectionDir", ",", 
     "psi0LMCacheFile", ",", "ensureDirectory", ",", "writeMXObject", ",", 
     "readMXObject"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numberTag", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "s", "}"}], ",", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"ToString", "@", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"N", "[", 
             RowBox[{"x", ",", "16"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Infinity", ",", "12"}], "}"}], ",", 
           RowBox[{"NumberPoint", "->", "\"\<.\>\""}], ",", 
           RowBox[{"NumberPadding", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
           RowBox[{"ExponentFunction", "->", 
            RowBox[{"(", 
             RowBox[{"Null", "&"}], ")"}]}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"StringTrim", "[", "s", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{"s", ",", "\"\<.\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"s", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"RegularExpression", "[", "\"\<0+$\>\"", "]"}], 
              "->", "\"\<\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"s", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
              "->", "\"\<\>\""}]}], "]"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"s", "==", "\"\<-0\>\""}], ",", 
         RowBox[{"s", "=", "\"\<0\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
           RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"spinTag", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "aa", "}"}], ",", 
      RowBox[{
       RowBox[{"aa", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{"N", "[", 
          RowBox[{"aKerr", ",", "16"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"aa", "==", "0"}], "]"}], ",", "\"\<a0p0\>\"", ",", 
         RowBox[{"\"\<a\>\"", "<>", 
          RowBox[{"numberTag", "[", "aa", "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plus2ProjectionDir", "[", 
      RowBox[{"root_String", ",", "ellMax_Integer", ",", "nY_Integer"}], 
      "]"}], ":=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"root", ",", 
        RowBox[{"\"\<psi0lmProjections_\>\"", "<>", 
