Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"finiteNumberQ", ",", "numericLeaves", ",", "gridNorm"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"finiteNumberQ", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"NumericQ", "[", "z", "]"}], "&&", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"z", ",", 
       RowBox[{
       "Indeterminate", "|", "ComplexInfinity", "|", "DirectedInfinity"}]}], 
      "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numericLeaves", "[", "obj_", "]"}], ":=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"N", "[", "obj", "]"}], ",", 
        RowBox[{
         RowBox[{"z_", "?", "NumericQ"}], ":>", "z"}], ",", "Infinity"}], 
       "]"}], ",", "finiteNumberQ"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gridNorm", "[", 
    RowBox[{"obj_Association", ",", 
     RowBox[{"normType_", ":", "\"\<rms\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "vals", "}"}], ",", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"numericLeaves", "[", 
        RowBox[{"obj", "[", "\"\<Data\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "vals", "]"}], "==", "0"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoNumericValues\>\"", "]"}], ",", 
        RowBox[{"Switch", "[", 
         RowBox[{"normType", ",", "\"\<max\>\"", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "vals", "]"}], "]"}], ",", "\"\<l2\>\"", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "vals", "]"}], "^", "2"}], "]"}], "]"}], 
          ",", "\"\<rms\>\"", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "vals", "]"}], "^", "2"}], "]"}], "]"}], 
          ",", "\"\<meanAbs\>\"", ",", 
          RowBox[{"Mean", "[", 
           RowBox[{"Abs", "[", "vals", "]"}], "]"}], ",", "_", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "vals", "]"}], "^", "2"}], "]"}], "]"}]}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.990864427979188*^9, 3.990864427980319*^9}},
 CellLabel->
  "In[442]:=",ExpressionUUID->"6d40491b-c422-454d-8263-9e3eadcc9939"],

