 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flattenComplexInterleaved", "[", 
     RowBox[{"data_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", "#", "]"}], ",", 
          RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
