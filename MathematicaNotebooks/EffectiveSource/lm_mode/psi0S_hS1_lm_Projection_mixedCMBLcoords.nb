              "}"}], "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<s\>\"", "->", 
                RowBox[{"+", "2"}]}], ",", 
               RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
               RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
               RowBox[{"\"\<Patch\>\"", "->", "patchName"}], ",", 
               RowBox[{"\"\<nY\>\"", "->", "nY"}], ",", 
               RowBox[{"\"\<XGrid\>\"", "->", "XGrid"}], ",", 
               RowBox[{"\"\<Values\>\"", "->", "vals"}], ",", 
               RowBox[{"\"\<TimeSeconds\>\"", "->", 
