         RowBox[{"\"\<SourceValues\>\"", "->", "srcVals"}], ",", 
         RowBox[{"\"\<IntegrandValues\>\"", "->", "vals"}], ",", 
         RowBox[{"\"\<Data\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"yGrid", ",", 
             RowBox[{"Re", "[", "vals", "]"}], ",", 
             RowBox[{"Im", "[", "vals", "]"}], ",", 
             RowBox[{"Abs", "[", "vals", "]"}]}], "}"}], "]"}]}], ",", 
