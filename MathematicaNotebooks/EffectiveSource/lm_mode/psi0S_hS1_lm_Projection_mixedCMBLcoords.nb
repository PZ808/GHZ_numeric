       RowBox[{"Button", "[", 
        RowBox[{
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CurrentValue", "[", 
           RowBox[{
            RowBox[{"SelectedCells", "@", 
             RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
           "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
