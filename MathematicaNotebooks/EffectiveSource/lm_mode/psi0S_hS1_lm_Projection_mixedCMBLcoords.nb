Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"compileXYExpr", ",", "compileJet2", ",", "hSJetCompiled"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compileXYExpr", "[", "expr_", "]"}], ":=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Yin", ",", "_Real"}], "}"}]}], "}"}], ",", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"N64", "[", "expr", "]"}], "//.", "tovals"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"X", "->", "x"}], ",", 
         RowBox[{"Y", "->", "Yin"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
     RowBox[{"CompilationOptions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}], 
    "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"compileXYExpr", ",", "compileSymbolsLeft"}], "]"}], ";", "\n", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"compileSymbolsLeft", "[", "expr_", "]"}], ":=", 
     RowBox[{"DeleteDuplicates", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Hold", "[", "expr", "]"}], ",", 
        RowBox[{"s_Symbol", "/;", 
         RowBox[{
          RowBox[{
           RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}], "&&", 
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Yin"}], "}"}], ",", "s"}], "]"}]}]}]}], ",", 
        "Infinity"}], "]"}]}]}], ";", "\n", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"compileXYExpr", "[", 
      RowBox[{"expr_", ",", "paramRules_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "leftover"}], "}"}], ",", 
       RowBox[{
        RowBox[{"e", "=", 
         RowBox[{
          RowBox[{"expr", "/.", " ", 
           RowBox[{"Y", "->", "Yin"}]}], "/.", " ", "paramRules"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"N", "[", 
          RowBox[{"e", ",", "MP"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftover", "=", 
         RowBox[{"compileSymbolsLeft", "[", "e", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"leftover", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Unreplaced symbols before Compile: \>\"", ",", 
             "leftover"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Expression head/key expression was: \>\"", ",", 
             RowBox[{"Short", "[", 
              RowBox[{"e", ",", "3"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Compile", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"X", ",", "_Real"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Yin", ",", "_Real"}], "}"}]}], "}"}], ",", 
          RowBox[{"Evaluate", "[", "e", "]"}], ",", 
          RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
          RowBox[{"CompilationOptions", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], 
            "}"}]}]}], "]"}]}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"compileJet2", "[", "jet_Association", "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{"compileXYExpr", ",", "jet"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hSJetCompiled", "[", 
    RowBox[{"key_String", ",", "m_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"hSJetCompiled", "[", 
     RowBox[{"key", ",", "m"}], "]"}], "=", 
    RowBox[{"compileJet2", "[", 
     RowBox[{"hSJet2", "[", 
      RowBox[{"key", ",", "m"}], "]"}], "]"}]}]}], ";"}]}], "Input",
