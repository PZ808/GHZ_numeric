Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonalignment", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"styles", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Section\>\"", ",", "\"\<Subsection\>\"", 
          ",", "\"\<Subsubsection\>\""}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ToBoxes", "@", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<align\>\"", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Set", "[", 
             RowBox[{
              RowBox[{"CurrentValue", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], "]"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"CurrentValue", "[", 
               RowBox[{
                RowBox[{"PreviousCell", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"CellStyle", "\[Rule]", "styles"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], 
               "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"Cells", "[", 
            RowBox[{"CellStyle", "\[Rule]", "\"\<Text\>\""}], "]"}]}], 
          "]"}]}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.767334514785654*^9, 3.7673345236628838`*^9}, {
  3.77002780011087*^9, 3.770027808916594*^9}, {3.7700319254436007`*^9, 
