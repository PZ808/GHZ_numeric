Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Memoized", " ", "Teukolsky", " ", "source", " ", "expressions", " ", 
     "by", " ", "m"}], "-", "mode"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "hSJetsByM", ",", "psi0Expr", ",", "makeNumericXYFunction", ",", 
      "psi0Fun"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"memoized", " ", "hS", " ", "jets"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hSJetsByM", "[", "m_", "]"}], ":=", 
     RowBox[{
      RowBox[{"hSJetsByM", "[", "m", "]"}], "=", 
      RowBox[{"hSJets2", "[", "m", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"memoized", " ", "Teuk", " ", "jets"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"psi0Expr", "[", "m_", "]"}], ":=", 
     RowBox[{
      RowBox[{"psi0Expr", "[", "m", "]"}], "=", 
      RowBox[{"psi0FromMetricExpr", "[", 
       RowBox[{
        RowBox[{"hSJetsByM", "[", "m", "]"}], ",", "m"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"insert", " ", "param", " ", "values"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeNumericXYFunction", "[", "expr_", "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr0", "=", "expr"}], "}"}], ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{"N64", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"expr0", "//.", "tovals"}], "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"X", "->", "x"}], ",", 
              RowBox[{"Y", "->", "y"}]}], "}"}]}], ")"}]}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"memoized", " ", "but", " ", "not", " ", 
     RowBox[{"compiled", " ", "!"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"psi0Fun", "[", "m_", "]"}], ":=", 
     RowBox[{
      RowBox[{"psi0Fun", "[", "m", "]"}], "=", 
      RowBox[{"makeNumericXYFunction", "[", 
       RowBox[{"psi0Expr", "[", "m", "]"}], "]"}]}]}], ";"}], 
