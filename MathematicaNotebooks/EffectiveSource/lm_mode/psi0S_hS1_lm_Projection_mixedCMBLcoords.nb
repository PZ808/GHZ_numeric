Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "radialSourceResolutionReportPatches", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"radialSourceResolutionReportPatches", "[", 
    RowBox[{"xLeftGrid_", ",", "xRightGrid_", ",", 
     RowBox[{"x0_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dL", ",", "dR", ",", "radii"}], "}"}], ",", 
     RowBox[{
      RowBox[{"dL", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"xLeftGrid", "-", "x0"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dR", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"xRightGrid", "-", "x0"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"radii", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "4"}]}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], ",", 
         RowBox[{"5", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}], ",", 
         RowBox[{"5", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "2"}]}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "2"}]}]}], ",", 
         RowBox[{"5", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "2"}]}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "1"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<nearest left distances\>\"", "->", 
         RowBox[{"Take", "[", 
          RowBox[{"dL", ",", 
           RowBox[{"UpTo", "[", "12", "]"}]}], "]"}]}], ",", 
        RowBox[{"\"\<nearest right distances\>\"", "->", 
         RowBox[{"Take", "[", 
          RowBox[{"dR", ",", 
           RowBox[{"UpTo", "[", "12", "]"}]}], "]"}]}], ",", 
        RowBox[{"\"\<counts within radius\>\"", "->", 
         RowBox[{"Dataset", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<radius\>\"", "->", "r"}], ",", 
              RowBox[{"\"\<left count\>\"", "->", 
               RowBox[{"Count", "[", 
                RowBox[{"dL", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"#", "<=", "r"}], "&"}], ")"}]}]}], "]"}]}], ",", 
              
              RowBox[{"\"\<right count\>\"", "->", 
               RowBox[{"Count", "[", 
                RowBox[{"dR", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"#", "<=", "r"}], "&"}], ")"}]}]}], "]"}]}]}], 
             "|>"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "radii"}], "}"}]}], "]"}]}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9993255056569757`*^9, 3.999325507836055*^9}, {
  3.999325806790394*^9, 3.999325817049344*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"c7aff2ee-7a12-4ccc-b087-379b160f02a9"],

