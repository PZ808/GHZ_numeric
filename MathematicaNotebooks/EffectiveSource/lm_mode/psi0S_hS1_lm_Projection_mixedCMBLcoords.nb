Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Serial", " ", "spheroidal", " ", "table", " ", 
    RowBox[{"cache", "--"}], " ", "robust", " ", "fallback"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "sphTableGoodQ", ",", "SphYTableCachedSerial", ",", 
      "prebuildSpheroidalTablesSerial"}], "]"}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sphTableGoodQ", "[", "obj_Association", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "vals", "}"}], ",", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"obj", ",", "\"\<Values\>\"", ",", "$Failed"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ListQ", "[", "vals", "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"vals", ",", "$Failed"}], "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"vals", ",", 
           RowBox[{
           "SpinWeightedSpheroidalHarmonicS", "|", 
            "SpinWeightedSpheroidalHarmonicS"}]}], "]"}], "&&", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"vals", ",", "NumericQ"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sphTableGoodQ", "[", "_", "]"}], ":=", "False"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SphYTableCachedSerial", "[", 
      RowBox[{"s_", ",", "ell_", ",", "m_", ",", 
       RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
       RowBox[{"prec_Integer", ":", "MP"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"file", ",", "obj"}], "}"}], ",", 
       RowBox[{
        RowBox[{"file", "=", 
         RowBox[{"sphTableFile", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
          RowBox[{
           RowBox[{"obj", "=", 
            RowBox[{"readMXObject", "[", "file", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"sphTableGoodQ", "[", "obj", "]"}], ",", 
             RowBox[{"Return", "[", "obj", "]"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Deleting bad spheroidal cache file: \>\"", ",", 
                "file"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"DeleteFile", "[", "file", "]"}], ";"}]}], "]"}], 
           ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"buildSphYTable", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"sphTableGoodQ", "[", "obj", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Bad spheroidal table built for: \>\"", ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "ell", ",", "m"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"writeMXObject", "[", 
         RowBox[{"file", ",", "obj"}], "]"}], ";", "\[IndentingNewLine]", 
        "obj"}]}], "]"}]}], ";"}]}]}]], "Input",
