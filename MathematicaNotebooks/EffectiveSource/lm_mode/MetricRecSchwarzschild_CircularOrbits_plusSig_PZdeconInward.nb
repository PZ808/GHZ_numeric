Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TllData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"TllLeftInterpol", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
          RowBox[{
           RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}], 
          " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPllData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"(", 
            RowBox[{"l", "+", 
             SuperscriptBox["l", "2"], "-", 
             RowBox[{
             "2", " ", "\[ImaginaryI]", " ", "m", " ", "rmin", " ", 
              "\[CapitalOmega]\[CurlyPhi]"}]}], ")"}], 
           RowBox[{"2", " ", 
            SuperscriptBox["rmin", "2"]}]], "  ", 
          RowBox[{
           RowBox[{"hPllLeft", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
