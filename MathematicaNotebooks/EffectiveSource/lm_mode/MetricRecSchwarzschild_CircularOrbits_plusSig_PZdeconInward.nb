Cell[CellGroupData[{

Cell["\<\
Compute variation of parameters weighting coefficients - Manual calculation\
\>", "Subsection",
 CellChangeTimes->{
  3.8738760584608297`*^9, {3.907314979379834*^9, 3.907314979905294*^9}, {
   3.918726355634098*^9, 
   3.918726363672752*^9}},ExpressionUUID->"1135424b-a5d5-41c4-bcc7-\
2dba88daa4b7"],

Cell[TextData[StyleBox["Not evaluable.",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{3.918726370173047*^9, 
  3.9187263729097767`*^9}},ExpressionUUID->"f2bc7f55-e1e3-47e0-8a1e-\
764016f8dcaa"],

Cell[TextData[{
 "For Schwarzschild circular orbits, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    SubscriptBox["m\[CapitalOmega]", "\[CurlyPhi]"]}], TraditionalForm]],
  ExpressionUUID->"164217db-ffe1-4e32-a8c4-f4c3344df469"],
 " and is basically taken into account in TeukolskyPointParticleMode when you \
tell it e=a=0, and give it the orbit and m.\nCurrently, the toolkit is not \
functioning for static modes (m=0), so need to do this manually, using \
variation-of-parameters approach.\nThe extra factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "2"], " ", 
    RowBox[{"f", "(", "r", ")"}]}], TraditionalForm]],ExpressionUUID->
  "4d71f447-345e-4e38-a6bb-db386ac236ca"],
 " attached to the Wronskian is because we follow the conventions in the book \
chapter instead of the reconstruction paper where the Teukolsky equation is \
first written in self-adjoint form (eq. (83)-(84)). This is because the modes \
of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "8ecd5180-d2f4-4da7-ad40-b3afa5ecec2a"],
 " and the source term are expanded following the same conventions, see eq \
(81,82,91,96). See how the source term is constructed in this notebook for \
more details.\n",
 StyleBox["Note that by definition, ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "0e7887bb-3f87-4cfe-a2da-3d53fa46473b"],
 StyleBox[" should be invariant under sign signature.",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\n",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\nWe used the fact that,  ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["C", "\[PlusMinus]"], ")"}], 
     RowBox[{"l", "-", "m"}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "l"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["C", "lm", "\[PlusMinus]"], ")"}], "*"]}]}], 
   TraditionalForm]],ExpressionUUID->"49660da3-a10f-466b-bef0-0469f9e599e2"],
 StyleBox[", which has been checked empirically.",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.872920845845791*^9, 3.87292096710155*^9}, {
   3.872921055889456*^9, 3.8729210563035927`*^9}, {3.872926929017425*^9, 
   3.872926929211132*^9}, {3.873647956208074*^9, 3.8736479890585747`*^9}, {
   3.8737897933735723`*^9, 3.873789803206341*^9}, {3.875093013342348*^9, 
   3.8750930916877737`*^9}, {3.8775828295395613`*^9, 
   3.8775828380686207`*^9}, {3.882509586967506*^9, 3.882509662476149*^9}, {
   3.882509730278206*^9, 3.882509786634519*^9}, {3.883117603612205*^9, 
   3.883117630411024*^9}, {3.883117660475514*^9, 3.88311766893075*^9}, {
   3.88311770265271*^9, 3.883117781349448*^9}, 3.88311808619674*^9, {
