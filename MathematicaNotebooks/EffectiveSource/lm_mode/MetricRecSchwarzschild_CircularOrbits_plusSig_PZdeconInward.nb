        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"Abs", "@", "\[Psi]0Data"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "500"], 
         SuperscriptBox["l", 
          RowBox[{"-", "2"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], 
   " "}]}]], "Input",
