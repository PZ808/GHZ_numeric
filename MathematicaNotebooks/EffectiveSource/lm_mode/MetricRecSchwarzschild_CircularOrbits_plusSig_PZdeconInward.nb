   RowBox[{
    RowBox[{"Quiet", "@", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[ScriptC]AnalytictCoord", "[", "BlSIndex", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "n", "]"}], " ", "=", 
         RowBox[{"N", "[", 
