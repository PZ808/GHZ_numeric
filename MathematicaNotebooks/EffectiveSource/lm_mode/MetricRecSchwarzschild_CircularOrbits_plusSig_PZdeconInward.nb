Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Residual", " ", "field", " ", "using", " ", "power"}], "-", 
    RowBox[{
    "series", " ", "expanded", " ", "puncture", " ", "diverges", " ", "away", 
     " ", "from", " ", 
     RowBox[{"particle", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]0Data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]0RSmoothPiece", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"Abs", "@", "\[Psi]0Data"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "10000000"], 
         SuperscriptBox["l", "6"]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], 
   " "}]}]], "Input",
