Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "TllDistrContributionAtRminTMP", ",", "TllDistrContributionAtRmin"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TllDistrContributionAtRminTMP", "[", 
     RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "\[Rho]_", "]"}], 
   " ", "=", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", "-", "\[Rho]min"}], ")"}], " ", 
         RowBox[{"Tll\[Delta]Coeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "\[Rho]"}], "-", "\[Rho]min"}], ")"}], " ", 
         "\[Rho]min", " ", 
         RowBox[{"Tll\[Delta]pCoeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}]}], 
       SuperscriptBox["\[Rho]min", "2"]], "/.", " ", 
      RowBox[{
       RowBox[{"Tll\[Delta]Coeff", "[", 
        RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
       RowBox[{"Tll\[Delta]RminPiece", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], " ", "/.", " ", 
     RowBox[{
      RowBox[{"Tll\[Delta]pCoeff", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
      RowBox[{"Tll\[Delta]pRminPiece", "[", 
       RowBox[{"l", ",", "m"}], "]"}]}]}], "  ", "//", " ", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TllDistrContributionAtRmin", "[", 
    RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "\[Rho]_", "]"}], " ",
   "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"TllDistrContributionAtRminTMP", "[", 
         RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], "[", "\[Rho]", "]"}], 
       " ", "/.", " ", "h\[ScriptCapitalP]TaylorAnalyticRule"}], ")"}], " ", 
     "+", "\[IndentingNewLine]", "\t\t\t", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"TllDistrContributionAtRminTMP", "[", 
          RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], "[", "\[Rho]", "]"}], 
        " ", "/.", " ", "h\[ScriptCapitalP]TaylorAbs\[CapitalDelta]rRule"}], 
       ")"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], " ", "/.", " ", "rTo\[Rho]Rule"}], 
   " ", "//", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}], 
    "&"}]}]}], "\[IndentingNewLine]", 
