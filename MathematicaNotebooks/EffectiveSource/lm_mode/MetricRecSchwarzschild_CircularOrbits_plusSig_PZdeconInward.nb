Cell[TextData[{
 "For the derivatives below, checked that substituting known values of \
derivatives of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "edbe7183-2964-42fa-8ded-ac8a61526889"],
 ", instead of differentiating the interpolating polynomials makes no \
difference."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.891668883458453*^9, 3.89166895128981*^9}, 
   3.893998346001968*^9},ExpressionUUID->"7bdd8bb3-c400-4793-8491-\
6dc430aa962b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hPData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"hPllLeft", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRuleForPuncture", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
     RowBox[{"hPData", "[", 
      RowBox[{"[", 
       RowBox[{"30", ";;", "All"}], "]"}], "]"}]}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "0.003"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "0.21"}], "}"}]}], "}"}], ",", "l"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListLogPlot", "[", 
     RowBox[{"Abs", "@", "hPData"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], " ", "l"}], "]"}]}], " ", "/.", " ", 
        "paraFitRuleForPuncture"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], " "}]}], "Input",
