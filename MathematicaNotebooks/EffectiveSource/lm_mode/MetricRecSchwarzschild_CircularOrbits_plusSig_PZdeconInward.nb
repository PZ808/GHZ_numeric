Cell[TextData[{
 "Note that , because geodesic equation is independent on sign convention, so \
is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "a"], TraditionalForm]],ExpressionUUID->
  "b2ee71a1-58d4-47cd-8ceb-68377f6a378d"],
 "!"
}], "Text",
 CellChangeTimes->{{3.8956469727390957`*^9, 
  3.895647042312319*^9}},ExpressionUUID->"7dc58a93-a7a0-4e8f-a731-\
d7cf7eab580c"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[CapitalDelta]r", ",", "\[Omega]m"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velU", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"3", " ", 
          RowBox[{"M", "/", "r0"}]}]}], "]"}]}], 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", "\[CapitalOmega]\[CurlyPhi]"}], 
       "}"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"in", " ", "usual", " ", 
     RowBox[{"(", 
      RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
     "coordinates"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velD", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"gmetDD", ".", "velU"}], " ", "/.", " ", "partRule"}], " ", "//",
       " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velNullU", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"JacTransf", ".", "velU"}], " ", "/.", " ", "partRule"}], " ", 
      "//", " ", "Simplify"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"in", " ", 
     RowBox[{"(", 
      RowBox[{"u", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
     RowBox[{"coordinates", ".", " ", "Vector"}], " ", "is", " ", 
     "unchanged"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velNullD", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"gmetNullDD", ".", "velNullU"}], " ", "/.", " ", "partRule"}], 
      " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CurlyPhi]2Rule", " ", "=", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]\[CurlyPhi]", "^", "2"}], " ", "->", " ", 
      RowBox[{"M", "/", 
       RowBox[{"r0", "^", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]r", "[", "r_", "]"}], "=", 
     RowBox[{"r", "-", "r0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]m", "[", "m_", "]"}], "=", " ", 
     RowBox[{"m", " ", "\[CapitalOmega]\[CurlyPhi]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.8737918438299303`*^9, 3.873791854751466*^9}, {
   3.873963448082094*^9, 3.873963463847247*^9}, {3.873965584464079*^9, 
   3.873965613249823*^9}, {3.875433704401189*^9, 3.8754337125540943`*^9}, 
   3.875433752429346*^9, {3.875683683742578*^9, 3.875683691279896*^9}, 
   3.8756839049886923`*^9, {3.876985390183434*^9, 3.876985400427519*^9}, {
   3.876985555167308*^9, 3.876985569212392*^9}, {3.876985605203617*^9, 
   3.876985628372644*^9}, {3.879782432821097*^9, 3.879782440294489*^9}, 
   3.8988339590124683`*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"5b048e98-5ad4-45ab-af66-bfad52268b1f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Tetrad and spin coefficients", "Section",
 CellChangeTimes->{{3.873005638867421*^9, 3.873005639224432*^9}, {
  3.903152643831441*^9, 
  3.90315264544487*^9}},ExpressionUUID->"7385190b-525a-442c-aecd-\
bc9624dfb4b0"],

Cell[TextData[{
 "For definitions of spin coefficients and null tetrad below, have a look at ",
 ButtonBox["2011.03548 ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2011.03548.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/2011.03548.pdf"],
 "and ",
 ButtonBox["2101.04592",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2101.04592.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/2101.04592.pdf"],
 " section 4.1.1.\nAlso check out ",
 ButtonBox["1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 ", appendix B.\n",
 StyleBox["Note that in the second, they g",
  FontColor->GrayLevel[0]],
 "ive the relation using mostly negative metric convention.\nThe difference \
in convention is made so that the spin coefficients are the same no matter \
the convention.\nSimilarly, the tetrad basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["l", "a"], ",", 
     SuperscriptBox["n", "a"], ",", 
     SuperscriptBox["m", "a"], ",", 
     SuperscriptBox[
      OverscriptBox["m", "_"], "a"]}], ")"}], TraditionalForm]],
  ExpressionUUID->"bab1cfbf-f5fa-4edb-8c6d-2b304aff1789"],
 " (upper index!) are the same in both positive and negative conventions.\n\n",
 StyleBox["In what follows, everything will be in Kinnersley tetrad.",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{{3.8730057899932203`*^9, 3.873005823676877*^9}, {
  3.87300640978415*^9, 3.8730064664711227`*^9}, {3.873791193382742*^9, 
  3.8737912138880043`*^9}, {3.874143171660524*^9, 3.87414317252732*^9}, {
  3.877583600726143*^9, 3.8775836256488447`*^9}, {3.87758485291376*^9, 
  3.877584856350374*^9}, {3.877585221405682*^9, 3.8775852862871227`*^9}, {
  3.878288722672552*^9, 3.8782887963941307`*^9}, {3.894014917017972*^9, 
  3.89401493558407*^9}, {3.895648280183941*^9, 3.8956483199762917`*^9}, {
  3.898834018581703*^9, 3.8988340950080147`*^9}, {3.9031535167649*^9, 
  3.903153543972645*^9}},ExpressionUUID->"591ccf52-e4f5-4a72-92aa-\
dc8e58950421"],

