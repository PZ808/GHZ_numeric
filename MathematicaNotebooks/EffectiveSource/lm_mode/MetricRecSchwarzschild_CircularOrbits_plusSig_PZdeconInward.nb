              RowBox[{"l", ",", "m"}], "]"}], "[", 
             RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], ",", 
            RowBox[{"\[Rho]", "<", "\[Rho]0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"TlmRightInterpol", "[", 
