Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPhi]Data", " ", "=", " ", 
   RowBox[{"Abs", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
