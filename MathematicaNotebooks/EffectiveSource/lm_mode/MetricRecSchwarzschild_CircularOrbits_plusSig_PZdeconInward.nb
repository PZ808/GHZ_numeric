Cell[TextData[{
 "According to ",
 ButtonBox["2101.04592",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2101.04592.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/2101.04592.pdf"],
 " Table 1 at page 29. Note that the tetrad in the table is for Carter! So, \
need to convert to Kinnersley.\nAlso, inverted the BLS indices 3 and 6, \
because the puncture is given in trace-reversed form.\nBy inspection of the \
puncture, they satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     RowBox[{"il", "-", "m"}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "m"], 
     SubsuperscriptBox["h", "ilm", "*"]}]}], TraditionalForm]],ExpressionUUID->
  "b7a52511-17a7-47bc-9008-29de831b0886"],
 "."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.872755156919907*^9, 3.872755221618581*^9}, {
   3.8727553624607153`*^9, 3.8727553862978067`*^9}, {3.8727604358840923`*^9, 
