Cell[TextData[{
 "We will also work in single null coordinate where u=t-r*, and r* defined \
such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SuperscriptBox["dr", "*"], "dr"], "=", 
    FractionBox["1", "f"]}], TraditionalForm]],ExpressionUUID->
  "0ec705f0-77b6-4c92-8681-064943442caa"],
 " (Schwarzschild)."
}], "Text",
