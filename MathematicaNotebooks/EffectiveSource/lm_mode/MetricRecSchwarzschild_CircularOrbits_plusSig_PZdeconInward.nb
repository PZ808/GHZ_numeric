   3.898776925501875*^9}, 3.8987769703030033`*^9, {3.898777224125225*^9, 
   3.898777232403553*^9}, {3.898777571906212*^9, 3.898777572739745*^9}, {
   3.898843708465747*^9, 3.89884375589151*^9}, 3.8988473395552797`*^9, 
   3.898851715807259*^9, 3.898851995851366*^9, {3.898852522029395*^9, 
   3.898852522850834*^9}, {3.898857891971098*^9, 3.898857896928388*^9}, {
   3.919233705270925*^9, 3.919233722259573*^9}, {3.992512167389542*^9, 
   3.992512184992279*^9}, {3.992512426999522*^9, 3.992512436352466*^9}, {
   3.992512912707705*^9, 
   3.992512941892454*^9}},ExpressionUUID->"f73760e3-40bd-44e1-ba65-\
6018b61dc9c3"],

