Cell[TextData[{
 "They all vanish except for two quantities (see eq. (73),(74) in \
reconstruction paper): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["g", "."], "nn"], " ", "=", 
     RowBox[{
      FractionBox["2", "r"], 
      SubsuperscriptBox["g", 
       OverscriptBox["M", "."], "o"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"where", " ", 
      SubsuperscriptBox["g", 
       OverscriptBox["M", "."], "o"]}], "=", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[CapitalPsi]", "0"], 
       FractionBox[
        OverscriptBox["M", "."], "M"]}], " ", "=", " ", 
      RowBox[{
       OverscriptBox["M", "."], " ", "=", " ", 
       FractionBox[
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", "M"}], 
          SubscriptBox["r", "0"]]}], 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"3", "M"}], 
           SubscriptBox["r", "0"]]}]]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"5a74144f-c6da-40ee-b308-698dd2845299"],
 ", (assuming Kinnersley tetrad and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["M", "."], "=", 
    RowBox[{"E", "=", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["g", "ab"]}], 
      SubsuperscriptBox["u", "0", "a"], 
      SuperscriptBox["t", "b"]}]}]}], TraditionalForm]],ExpressionUUID->
  "f3861a9c-e32d-4257-9a94-215628c8e0e6"],
 ")\nand ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["g", "."], "nm"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "2"}], 
     SuperscriptBox["\[Rho]", "2"], 
     SubsuperscriptBox["g", 
      OverscriptBox["a", "."], "o"]}]}], TraditionalForm]],ExpressionUUID->
  "6e5aece7-bbd9-402b-9519-c37657dc09ef"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["g", 
     OverscriptBox["a", "."], "o"], "=", 
    RowBox[{
     FractionBox["i", 
      SqrtBox["2"]], "M", 
     OverscriptBox["a", "."], "sin", " ", "\[Theta]"}]}], TraditionalForm]],
  ExpressionUUID->"b4880cfe-2ba0-4095-90bd-7de44dd946b2"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["a", "."], "=", 
    FractionBox[
     OverscriptBox["J", "."], "M"]}], TraditionalForm]],ExpressionUUID->
  "88b89eb6-f645-43ec-8d1b-07276b1385cc"],
 " in Schwarzschild (see text below (74) and (79)). ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["J", "."], "=", 
    RowBox[{
     SubscriptBox["L", "z"], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["g", "ab"], 
       SubsuperscriptBox["u", "0", "a"], 
       SuperscriptBox["\[Phi]", "b"]}], "=", 
      SqrtBox[
       FractionBox[
        RowBox[{"M", " ", 
         SubscriptBox["r", "0"]}], 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"3", " ", "M"}], 
          SubscriptBox["r", "0"]]}]]]}]}]}], TraditionalForm]],ExpressionUUID->
  "0e412a80-9b9a-4010-8b3e-9ec83628480f"],
 ". (see eq (128) in ",
 ButtonBox["arXiv:1207.5595",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1207.5595.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1207.5595.pdf"],
 ".)"
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.873199415662826*^9, 3.873199582055037*^9}, {
