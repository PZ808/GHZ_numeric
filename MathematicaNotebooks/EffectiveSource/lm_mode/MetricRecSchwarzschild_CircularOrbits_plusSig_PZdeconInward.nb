Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[CapitalPhi]barRetPlusData", ",", "\[CapitalPhi]barRetPlus", ",", 
     "\[CapitalPhi]barRetPlusD", ",", "\[CapitalPhi]barRetPlusBuildAll"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[CapitalPhi]barRetPlusData", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "PhiBarPlusSolveOne", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<InnerRadius\>\"", "->", "Automatic"}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[CapitalPhi]barRetPlus", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "\[CapitalPhi]barRetPlusData", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<UseTailOutsideBoundary\>\"", "->", "True"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[CapitalPhi]barRetPlusD", "]"}], "=", 
    RowBox[{"Options", "[", "\[CapitalPhi]barRetPlus", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]barRetPlus", "::", "below"}], 
    "=", "\"\<Requested r = `1`, but the cached outer solution only extends \
down to rInner = `2`.\>\""}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]barRetPlus", "::", "outside"}], 
    "=", "\"\<Requested r = `1` is outside the numerical inward-solve \
interval. Returning the fitted asymptotic tail.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]barRetPlusData", "[", 
    RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalPhi]barRetPlusData", "[", 
     RowBox[{"\[ScriptL]", ",", "m", ",", "opts"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rInner", "=", 
         RowBox[{"OptionValue", "[", "\"\<InnerRadius\>\"", "]"}]}], ",", 
        RowBox[{"rBoundary", "=", 
         RowBox[{"OptionValue", "[", "\"\<BoundaryRadius\>\"", "]"}]}], ",", 
        RowBox[{"fitRange", "=", 
         RowBox[{"OptionValue", "[", "\"\<FitRange\>\"", "]"}]}], ",", "fit", 
        ",", "sol", ",", "fitOpts", ",", "solveOpts"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rInner", "===", "Automatic"}], ",", 
         RowBox[{"rInner", "=", "rmax"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rBoundary", "===", "Automatic"}], ",", 
         RowBox[{"rBoundary", "=", 
          RowBox[{"fitRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{"rInner", "<", "rBoundary"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Need rInner < rBoundary. Got rInner = \>\"", ",", 
            "rInner", ",", "\"\<, rBoundary = \>\"", ",", "rBoundary"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fitOpts", "=", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Fitpsi0RetTail", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"solveOpts", "=", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "PhiBarPlusSolveOne", "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"fit", "=", 
        RowBox[{"Fitpsi0RetTail", "[", 
         RowBox[{"\[ScriptL]", ",", "m", ",", 
          RowBox[{"Sequence", "@@", "fitOpts"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"PhiBarPlusSolveOne", "[", 
         RowBox[{"\[ScriptL]", ",", "m", ",", "rInner", ",", 
          RowBox[{"Sequence", "@@", "solveOpts"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<l\>\"", "->", "\[ScriptL]"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<InnerRadius\>\"", "->", "rInner"}], ",", 
         RowBox[{"\"\<BoundaryRadius\>\"", "->", "rBoundary"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<FitRange\>\"", "->", "fitRange"}], ",", 
         RowBox[{"\"\<Fit\>\"", "->", "fit"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Solution\>\"", "->", "sol"}]}], "\[IndentingNewLine]", 
        "|>"}]}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalPhi]barRetPlus", "[", 
      RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "[", 
     RowBox[{"rr_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"\[CapitalPhi]barRetPlusD", "[", 
      RowBox[{"\[ScriptL]", ",", "m", ",", "0", ",", "opts"}], "]"}], "[", 
     "rr", "]"}]}], ";"}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]barRetPlusD", "[", 
     RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
      RowBox[{"k_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "[", 
    RowBox[{"rr_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", "sol", ",", "fit", ",", "rInner", ",", "rBoundary", ",", 
       "useTail", ",", "dataOpts"}], "}"}], ",", 
     RowBox[{
      RowBox[{"useTail", "=", 
       RowBox[{"OptionValue", "[", "\"\<UseTailOutsideBoundary\>\"", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"dataOpts", "=", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "\[CapitalPhi]barRetPlusData", "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"\[CapitalPhi]barRetPlusData", "[", 
        RowBox[{"\[ScriptL]", ",", "m", ",", 
         RowBox[{"Sequence", "@@", "dataOpts"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"data", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"data", "[", "\"\<Solution\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"data", "[", "\"\<Fit\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInner", "=", 
       RowBox[{"data", "[", "\"\<InnerRadius\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rBoundary", "=", 
       RowBox[{"data", "[", "\"\<BoundaryRadius\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"rr", "<", "rInner"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"\[CapitalPhi]barRetPlus", "::", "below"}], ",", "rr", ",",
            "rInner"}], "]"}], ";", "\[IndentingNewLine]", "Indeterminate"}], 
        ",", 
        RowBox[{"rr", "<=", "rBoundary"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "==", "0"}], ",", 
          RowBox[{"sol", "[", "rr", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", "k", "]"}], "[", "sol", "]"}], "[", 
           "rr", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"rr", ">", "rBoundary"}], "&&", "useTail"}], ",", 
        RowBox[{"PhiBarTailDerivsFromFit", "[", 
         RowBox[{"fit", ",", "k", ",", "rr"}], "]"}], ",", "True", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"\[CapitalPhi]barRetPlus", "::", "outside"}], ",", "rr"}], 
          "]"}], ";", "\[IndentingNewLine]", "Indeterminate"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
