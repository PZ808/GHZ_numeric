                    "--", "--"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"First", ":", 
     RowBox[{
     "solve", " ", "right", " ", "patch", " ", "inward", " ", "from", " ", 
      "rhoMax", " ", "to", " ", "rho0"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
