Cell[TextData[{
 StyleBox["Note: The below way of defining \[Psi] will result in a wrong \
result when evaluating its derivative at r0!!! \n",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Needs to be delayed rule or else the numerical integration for \
Hertz potential will not work.",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.8835088328939466`*^9, 3.883508874870825*^9}, {
   3.88354317009404*^9, 3.883543196543109*^9}, 3.8844129851495457`*^9, {
