              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]0RData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]Ret", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"rmin", "+", "1"}], "]"}], "-", 
              RowBox[{
               RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"rmin", "+", "1"}], "]"}]}], ")"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", 
             RowBox[{"rmin", "+", "1"}], "]"}], " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
