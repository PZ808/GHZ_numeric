Cell[BoxData[{
 RowBox[{"Clear", "[", "dint", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dint", "[", 
   RowBox[{"x_", ",", "p_", ",", "m_", ",", "r_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Factor", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
