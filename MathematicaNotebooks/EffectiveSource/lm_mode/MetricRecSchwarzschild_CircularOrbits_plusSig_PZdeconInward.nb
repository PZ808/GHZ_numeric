   RowBox[{"cCirc10TermNoCoeffRule", "[", "aExp", "]"}], " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cCirc1stTermContribution", "[", "aExp", "]"}], "-", 
      RowBox[{
       RowBox[{"1", "/", "3"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"xnmTermNoCoeffRule", "[", 
            RowBox[{"1", ",", "0", ",", "aExp"}], "]"}], "'"}], "[", "rmax", 
          "]"}], "-", 
         RowBox[{"2", " ", "\[Rho]max", " ", 
          RowBox[{
           RowBox[{"xnmTermNoCoeffRule", "[", 
            RowBox[{"1", ",", "0", ",", "aExp"}], "]"}], "[", "rmax", "]"}]}],
          "+", 
         RowBox[{"cCircDistrContributionAtRmax", "[", 
          RowBox[{"1", ",", "0", ",", "aExp"}], "]"}]}], ")"}]}]}], ",", 
     "CoeffCollectRule"}], "]"}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8762477165525913`*^9, 3.8762477305660353`*^9}, {
   3.876247761693874*^9, 3.87624785024393*^9}, {3.8762876731812487`*^9, 
   3.876287680327924*^9}, {3.876298226037672*^9, 3.876298230577289*^9}, {
