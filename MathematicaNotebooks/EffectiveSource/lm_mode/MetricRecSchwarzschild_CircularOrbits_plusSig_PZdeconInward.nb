Cell[CellGroupData[{

Cell["Comparison", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.882170247852923*^9, 
  3.882170249333967*^9}},ExpressionUUID->"9377e8f6-0c1d-48a8-b080-\
eb706faac956"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fll", " ", "=", " ", 
   RowBox[{
    RowBox[{"8", " ", "\[Pi]", " ", 
     RowBox[{
      RowBox[{"ul", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r0", "^", "2"}], " ", "utU"}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flm", " ", "=", " ", 
   RowBox[{
    RowBox[{"8", " ", "\[Pi]", " ", "ul", " ", 
     RowBox[{"um", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r0", "^", "2"}], " ", "utU"}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]pp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "fll"}], " ", 
     RowBox[{"r0", "/", 
      RowBox[{"(", 
       RowBox[{"8", " ", "\[Pi]"}], ")"}]}]}], " ", "//", " ", "Simplify"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]pp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"flm", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}], " ", "\[Pi]"}], ")"}]}]}], " ", "//",
     " ", "Simplify"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.88216597760858*^9, 3.882166039861704*^9}, {
   3.882166844135455*^9, 3.882166904762926*^9}, {3.882167006479303*^9, 
   3.8821670123456097`*^9}, {3.8821675898911047`*^9, 3.882167590620942*^9}, {
   3.8821760284981422`*^9, 3.8821760344758797`*^9}, {3.8833786565566063`*^9, 
   3.883378656557699*^9}, 3.883378744293631*^9, {3.883807768313217*^9, 
   3.883807769039769*^9}, {3.894014626691318*^9, 3.8940146274661417`*^9}, 
   3.894014786884004*^9, 3.894015006719886*^9, {3.8940156232265368`*^9, 
   3.894015623695401*^9}, {3.8988433027959013`*^9, 3.8988433035883617`*^9}},
 CellLabel->
  "In[653]:=",ExpressionUUID->"1b622fe9-c2dc-4689-ad55-d237353e88d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       RowBox[{"M", "/", "r0"}]}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", 
      RowBox[{"3", " ", 
       RowBox[{"M", "/", "r0"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"Lzmomentum", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"M", " ", 
      RowBox[{"r0", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"3", " ", 
          RowBox[{"M", "/", "r0"}]}]}], ")"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]Abhay", "=", 
   RowBox[{"energy", "/", 
    RowBox[{"(", 
     RowBox[{"r0", " ", 
      RowBox[{"f", "[", "r0", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]Abhay", "=", 
   RowBox[{"2", " ", 
    RowBox[{"Lzmomentum", "/", 
     RowBox[{"(", 
      RowBox[{"r0", "^", "3"}], ")"}]}]}]}], ";"}]}], "Input",
 Evaluatable->False,
