Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", "makePortableBranchUniform", "]"}], ";", "\n", 
    RowBox[{
     RowBox[{"Options", "[", "makePortableBranchUniform", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Points\>\"", "->", "400"}], ",", 
       RowBox[{"InterpolationOrder", "->", "5"}], ",", " ", 
       RowBox[{"WorkingPrecision", "->", "TeukolskyPrecision"}]}], "}"}]}], ";",
     "\n", 
    RowBox[{
     RowBox[{"makePortableBranchUniform", "[", 
      RowBox[{"sol_", ",", "branch_String", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rmin_", "?", "NumericQ"}], ",", 
         RowBox[{"rmax_", "?", "NumericQ"}]}], "}"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grid", ",", "vals"}], "}"}], ",", 
       RowBox[{
        RowBox[{"grid", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"rmin", ",", "TeukolskyPrecision"}], "]"}], ",", 
           RowBox[{"N", "[", 
            RowBox[{"rmax", ",", "TeukolskyPrecision"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<Points\>\"", "]"}], "-", "1"}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{
          RowBox[{"sol", "[", "branch", "]"}], "/@", "grid"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"vals", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<NonNumericValues\>\"", ",", "\[IndentingNewLine]", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Branch\>\"", "->", "branch"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"\"\<BadPositions\>\"", "->", 
                RowBox[{"Flatten", "@", 
                 RowBox[{"Position", "[", 
                  RowBox[{"vals", ",", 
                   RowBox[{"x_", "/;", 
                    RowBox[{"!", 
                    RowBox[{"NumericQ", "[", "x", "]"}]}]}]}], "]"}]}]}]}], 
              "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"grid", ",", "vals"}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"InterpolationOrder", "->", 
           RowBox[{"OptionValue", "[", "InterpolationOrder", "]"}]}]}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "makePortableBranch", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "makePortableBranch", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Points\>\"", "->", "1000"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<GridPowers\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<ClusterAt\>\"", "->", "Automatic"}], ",", 
       RowBox[{"InterpolationOrder", "->", "5"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"WorkingPrecision", "->", "TeukolskyPrecision"}]}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makePortableBranch", "[", 
      RowBox[{"sol_", ",", "branch_String", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rmin_", "?", "NumericQ"}], ",", 
         RowBox[{"rmax_", "?", "NumericQ"}]}], "}"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "nPts", ",", "powers", ",", "clusterAt", ",", "interpOrder", ",", 
         "wp", ",", "a", ",", "b", ",", "u", ",", "grids", ",", "grid", ",", 
         "vals", ",", "numericMask", ",", "bad"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nPts", "=", 
         RowBox[{"OptionValue", "[", "\"\<Points\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"powers", "=", 
         RowBox[{"OptionValue", "[", "\"\<GridPowers\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"clusterAt", "=", 
         RowBox[{"OptionValue", "[", "\"\<ClusterAt\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"interpOrder", "=", 
         RowBox[{"OptionValue", "[", "InterpolationOrder", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wp", "=", 
         RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"clusterAt", "===", "Automatic"}], ",", 
          "\[IndentingNewLine]", 
