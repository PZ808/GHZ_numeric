Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"r0", "=", 
     RowBox[{
      RowBox[{"8", "M", " ", "at", " ", "rmin"}], "=", 
