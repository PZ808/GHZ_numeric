Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "expressions", " ", "for", " ", "\[ScriptCapitalU]", " ", 
    "which", " ", "agree"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Eth]pCK\[Rho]", "[", 
          RowBox[{"1", ",", "l"}], "]"}], "[", 
         RowBox[{
          RowBox[{"\[Eth]CK\[Rho]", "[", 
           RowBox[{"0", ",", "l"}], "]"}], "[", 
          RowBox[{"g", "[", "\[Rho]", "]"}], "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"\[Eth]CK\[Rho]", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "l"}], "]"}], "[", 
         RowBox[{
          RowBox[{"\[Eth]pCK\[Rho]", "[", 
           RowBox[{"0", ",", "l"}], "]"}], "[", 
          RowBox[{"g", "[", "\[Rho]", "]"}], "]"}], "]"}], "-", 
        RowBox[{"2", " ", "M", " ", 
         RowBox[{"\[Rho]", "^", "3"}], " ", 
         RowBox[{"g", "[", "\[Rho]", "]"}]}], " ", "+", 
        RowBox[{
         RowBox[{"\[Thorn]pNullK\[Rho]", "[", 
          RowBox[{"1", ",", "1"}], "]"}], "[", 
         RowBox[{"\[Rho]", " ", 
          RowBox[{"g", "[", "\[Rho]", "]"}]}], "]"}], "-", 
        RowBox[{"2", " ", "\[Rho]", " ", "\[Rho]pK", " ", 
         RowBox[{"g", "[", "\[Rho]", "]"}]}], " ", "+", 
        RowBox[{"\[Thorn]NullK", "[", 
         RowBox[{"\[Rho]pK", " ", 
          RowBox[{"g", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "r"}], "]"}]}], "]"}], "-", 
        RowBox[{"2", " ", "\[Rho]", " ", "\[Rho]pK", " ", 
         RowBox[{"g", "[", "\[Rho]", "]"}]}], "+", 
        RowBox[{"\[Rho]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{
             RowBox[{"\[Thorn]pNullK\[Rho]", "[", 
              RowBox[{"0", ",", "0"}], "]"}], "[", 
             RowBox[{"g", "[", "\[Rho]", "]"}], "]"}]}], "-", 
           RowBox[{"2", " ", "\[Rho]pK", " ", 
            RowBox[{"g", "[", "\[Rho]", "]"}]}]}], ")"}]}], "+", 
        RowBox[{"\[Rho]pK", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"\[Thorn]NullK", "[", 
             RowBox[{"g", "[", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "r"}], "]"}], "]"}]}], "-", 
           RowBox[{"2", " ", "\[Rho]", " ", 
            RowBox[{"g", "[", "\[Rho]", "]"}]}]}], ")"}]}], "-", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"\[Thorn]pNullK\[Rho]", "[", 
           RowBox[{"1", ",", "1"}], "]"}], "[", 
          RowBox[{
           RowBox[{"\[Rho]", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"g", "'"}], "[", "\[Rho]", "]"}]}], "]"}]}], "+", " ", 
        RowBox[{"2", " ", "\[Rho]", " ", "\[Rho]pK", " ", 
         RowBox[{"g", "[", "\[Rho]", "]"}]}]}], ")"}]}], " ", "/.", " ", 
     RowBox[{"r", " ", "->", " ", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "\[Rho]"}]}]}], " ", "//", " ", "Simplify"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Eth]pCK\[Rho]", "[", 
