Cell[BoxData[{
 RowBox[{"\[Psi]RetData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rmax", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
        RowBox[{"i", "/", "50"}]}]}], ",", 
      RowBox[{
       RowBox[{"\[Psi]Ret", "[", 
        RowBox[{"2", ",", "2"}], "]"}], "[", 
       RowBox[{"rmax", "+", 
        RowBox[{"100", " ", "M", " ", 
         RowBox[{"i", "/", "50"}]}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "50"}], "}"}]}], "]"}]}], "\[LineSeparator]", 
 RowBox[{"paraFitRule", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
     RowBox[{"\[Psi]RetData", "[", 
      RowBox[{"[", 
       RowBox[{"30", ";;", "All"}], "]"}], "]"}]}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"r", "^", 
      RowBox[{"(", 
       RowBox[{"-", "b"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "b"}], "}"}], ",", "r"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
