Cell["\<\
Set up rule to account for all the contributions in the integration of \
\[Delta] and \[Delta]\[CloseCurlyQuote]\
\>", "Text",
 CellChangeTimes->{{3.8929764507177553`*^9, 3.892976494829124*^9}, 
   3.9817995502670183`*^9, {3.9920848789441767`*^9, 
   3.9920848804822083`*^9}},ExpressionUUID->"e58b4278-d4be-4c8b-9a23-\
8a5013dbb63d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[ScriptCapitalN]bxmmb\[Delta]Coeff", ",", "xnmbIntegrationRule"}],
   "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalN]bxmmb\[Delta]Coeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Eth]pCK", "[", 
        RowBox[{"0", ",", "l"}], "]"}], "[", 
       RowBox[{"xmmbAt\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "]"}]}], " ", "/.", " ", 
     RowBox[{"r", " ", "->", " ", "rmax"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"when", " ", "evaluating", " ", 
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], " ", "at", " ", 
    SubscriptBox["r", "min"], " ", "we", " ", "can", " ", "simply", " ", 
    "take", " ", "the", " ", "value", " ", "of", " ", "the", " ", 
    "distributional", " ", "parts", " ", "as", " ", "the", " ", "integral", " ",
     "over", " ", "smooth", " ", "bit", " ", "is", " ", "zero", " ", "at", " ", 
    SubscriptBox["r", "min"]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xnmbIntegrationRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"xnmbIntegrand\[Delta]Coeff", "[", 
        RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", " ", 
      
      RowBox[{
       RowBox[{"Tlmb\[Delta]RmaxInterpol", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "+", 
       RowBox[{"\[ScriptCapitalN]bxmmb\[Delta]Coeff\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"xnmbIntegrand\[Delta]pCoeff", "[", 
        RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", " ", 
      
      RowBox[{"Tlmb\[Delta]pRmaxInterpol", "[", 
       RowBox[{"l", ",", "m"}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.892976678465035*^9, 3.8929766903903427`*^9}, {
   3.8929774514841433`*^9, 3.8929774765849733`*^9}, {3.89299989992626*^9, 
