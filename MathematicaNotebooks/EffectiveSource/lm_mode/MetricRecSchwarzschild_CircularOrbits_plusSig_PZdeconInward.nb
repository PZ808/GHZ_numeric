        RowBox[{"coeffs", "=", 
         RowBox[{"LeastSquares", "[", 
          RowBox[{"mat", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<l\>\"", "->", "\[ScriptL]"}], ",", 
