   3.992147283747705*^9}},ExpressionUUID->"00dd3b89-e61a-452e-b4e7-\
48c4b0b3f463"],

Cell[CellGroupData[{

Cell["Via Integration", "Subsubsection",
 CellChangeTimes->{{3.8929754609504433`*^9, 
  3.892975463807796*^9}},ExpressionUUID->"7237c281-a0fc-4ca7-973d-\
b85b046c27bd"],

Cell[TextData[{
 "Integrate (60) in reconstruction paper at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "rmax"}], TraditionalForm]],ExpressionUUID->
  "344dd3c9-7ff1-48a2-846b-8a8c518f1405"],
 ", so that only distributional pieces contribute."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.892975543340213*^9, 3.892975546486411*^9}, {
  3.9931878687908688`*^9, 
  3.993187870125881*^9}},ExpressionUUID->"7e8630b6-214d-4229-a262-\
bf7ff203e1c6"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "xnmbDistrContributionPieceAtrmax", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xnmbDistrContributionPieceAtrmax", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[Rho]_", "]"}], " ", "=", 
   RowBox[{
    FractionBox["2", "3"], " ", 
    SuperscriptBox["\[Rho]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
