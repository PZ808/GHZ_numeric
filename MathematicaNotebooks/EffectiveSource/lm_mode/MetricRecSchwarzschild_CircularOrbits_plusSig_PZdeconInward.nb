        RowBox[{"sol", "=", 
         RowBox[{"res", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]HomogInUp", "[", "ss", "]"}], "[", 
