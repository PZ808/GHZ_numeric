Cell[TextData[{
 "The metric can be written in the form (",
 ButtonBox["r",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2101.04592"], None},
  ButtonNote->"https://arxiv.org/abs/2101.04592"],
 "eview paper):  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"n", "\[GreaterEqual]", "0"}]], " ", 
      RowBox[{
       SubscriptBox["c", "n"], " ", 
       SuperscriptBox["\[CapitalDelta]r", "n"]}]}], " ", "+"}], " ", "|", 
    "\[CapitalDelta]r", "|", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{"n", "\[GreaterEqual]", "0"}]], 
     RowBox[{
      SubscriptBox["d", "n"], "  ", 
      SuperscriptBox["\[CapitalDelta]r", 
       RowBox[{"n", "-", "1"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "e327ac01-4c52-447e-a59c-a6931a9d8d3b"],
 ". (log term not here for circular orbits).\nNote that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "0"], TraditionalForm]],ExpressionUUID->
  "fbdfdf7a-058e-4b0b-8e4a-0b3e705f03bd"],
 " will be wlog set to 0 as it can be re-absorbed into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "0"], TraditionalForm]],ExpressionUUID->
  "625d9c01-caaf-4de8-8198-c79f30a78957"],
 " (basically, the second sum can be re-interpreted as  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["d", "0"], " ", "+"}], " ", "|", "\[CapitalDelta]r", "|", 
    " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["d", "1"], " ", "+", " ", 
       RowBox[{
        SubscriptBox["d", "2"], " ", "\[CapitalDelta]r"}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["d", "3"], 
        SuperscriptBox["\[CapitalDelta]r", "2"]}], "+"}], "..."}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"33d3b067-b279-482d-928a-24ee0c775e06"],
 ")."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.882252673966774*^9, 3.882252680955142*^9}, {
   3.882252906704714*^9, 3.8822530510084*^9}, {3.882253918165202*^9, 
   3.882254013643861*^9}, {3.882254044262903*^9, 3.882254114818594*^9}, 
   3.8940170852823277`*^9, {3.894017181913575*^9, 
   3.894017191601457*^9}},ExpressionUUID->"5f104e49-9e96-45a8-9e86-\
edaaf55a6414"]
}, Closed]],

