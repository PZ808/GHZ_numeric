                RowBox[{"rr", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", 
                   RowBox[{"qs", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"Length", "[", "qs", "]"}]}], "}"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
         "|>"}]}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}], 
