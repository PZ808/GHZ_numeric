Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"eigth", "-", 
    RowBox[{"order", " ", "TSIs"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Thorn]NullK", "[", 
       RowBox[{"\[Thorn]NullK", "[", 
        RowBox[{"\[Thorn]NullK", "[", 
         RowBox[{"\[Thorn]NullK", "[", 
          RowBox[{
           RowBox[{"r", "^", "4"}], " ", 
           RowBox[{
            RowBox[{"\[Thorn]pNullK", "[", 
             RowBox[{
              RowBox[{"Weyl$spin$p", "-", "3"}], ",", 
              RowBox[{"Weyl$spin$q", "-", "3"}]}], "]"}], "[", 
            RowBox[{
             RowBox[{"\[Thorn]pNullK", "[", 
              RowBox[{
               RowBox[{"Weyl$spin$p", "-", "2"}], ",", 
               RowBox[{"Weyl$spin$q", "-", "2"}]}], "]"}], "[", 
             RowBox[{
              RowBox[{"\[Thorn]pNullK", "[", 
               RowBox[{
                RowBox[{"Weyl$spin$p", "-", "1"}], ",", 
                RowBox[{"Weyl$spin$q", "-", "1"}]}], "]"}], "[", 
              RowBox[{
               RowBox[{"\[Thorn]pNullK", "[", 
                RowBox[{"Weyl$spin$p", ",", "Weyl$spin$q"}], "]"}], "[", 
               RowBox[{
                RowBox[{"r", "^", "4"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Psi$s2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
