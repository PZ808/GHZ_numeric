Cell[TextData[{
 "Next three check large l-behaviour of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "d5d03a65-d5b9-4513-9e93-7676901e445f"],
 " and its derivatives.\nOn the worldline, the retarded ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "ae6c4916-50cd-4d15-a5ca-cfd8fe66d8ce"],
 " converges as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "73bf80fe-43b6-4122-89e1-51b10ec4da04"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "'"}], TraditionalForm]],ExpressionUUID->
  "28a60c34-4ab4-437a-bdb6-811bd06e6872"],
 " converges as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "4a406bfa-568c-4145-aca6-7fce923f5410"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "'"}], TraditionalForm]],ExpressionUUID->
  "2cd24a5d-12c1-43b1-abc1-9a0fd3b9fd8c"],
 "\[CloseCurlyQuote] goes like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptL]", "0"], TraditionalForm]],ExpressionUUID->
  "39ce7b7f-c7ca-47fb-b79c-40f67301b952"],
 ".\nThis all agrees with Barry\[CloseCurlyQuote]s results."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.883903608257928*^9, 3.883903609804213*^9}, {
  3.883929235441988*^9, 3.883929253031033*^9}, {3.883929316315565*^9, 
  3.883929376776968*^9}},ExpressionUUID->"8081a79a-c809-402e-b830-\
504f57c5c633"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]rPlot", "=", 
   RowBox[{"1", "/", "10000000000000000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListLogLogPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"Abs", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
               RowBox[{
                RowBox[{"\[CapitalPsi]barRet", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"-", "m"}]}], "]"}], "[", "Left", "]"}], " ", 
               StyleBox[
                RowBox[{
                 RowBox[{"ExpI\[Omega]rstar", "[", 
                  RowBox[{"-", "m"}], "]"}], "[", "r0", "]"}],
                FontColor->GrayLevel[0]]}], "]"}], 
             RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
              RowBox[{
               RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
               RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "4"], 
        SuperscriptBox["l", 
         RowBox[{"-", "2"}]]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListLogLogPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"Abs", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
                  RowBox[{
                   RowBox[{"\[CapitalPsi]barRet", "[", 
                    RowBox[{"l", ",", 
                    RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], " ", 
                  StyleBox[
                   RowBox[{
                    RowBox[{"ExpI\[Omega]rstar", "[", 
                    RowBox[{"-", "m"}], "]"}], "[", "r", "]"}],
                   FontColor->GrayLevel[0]]}], 
                 StyleBox[",",
                  FontColor->GrayLevel[0]], 
                 StyleBox["r",
                  FontColor->GrayLevel[0]]}], "]"}], "]"}], 
              RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
               RowBox[{
                RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
                RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], " ", "/.", 
             " ", 
             RowBox[{"r", " ", "->", " ", 
              RowBox[{"r0", "-", "\[CapitalDelta]rPlot"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
