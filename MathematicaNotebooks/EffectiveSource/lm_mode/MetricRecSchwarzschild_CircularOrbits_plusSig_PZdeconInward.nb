Cell[TextData[{
 "One can check that \[ScriptCapitalU] = ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "l", "+", 
       SuperscriptBox["l", "2"], "-", 
       RowBox[{
       "4", " ", "\[ImaginaryI]", " ", "m", " ", "r", " ", 
        "\[CapitalOmega]\[CurlyPhi]"}]}], ")"}], " ", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"6", " ", "M"}], "-", 
        RowBox[{"4", " ", "r"}], "-", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "m", " ", 
         SuperscriptBox["r", "2"], " ", "\[CapitalOmega]\[CurlyPhi]"}]}], 
       ")"}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "r"], 
       RowBox[{"+", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "M"}], "-", "r"}], ")"}]}]}], " ", "r", " ", 
      SubsuperscriptBox["\[PartialD]", "r", "2"]}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["r", "2"]}]]}]],
  CellChangeTimes->{{3.887450372934161*^9, 3.887450398171913*^9}},
  ExpressionUUID->"c0400fc6-da65-48e3-ac58-ba5915d82c78"],
 "."
}], "Text",
