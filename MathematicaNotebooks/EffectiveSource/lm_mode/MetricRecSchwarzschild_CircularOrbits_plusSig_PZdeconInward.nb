6f7e5fa7e1ac"],

Cell[TextData[{
 "Hack: in the below, I use the assumption l\[GreaterEqual]2 when \
simplifying, even if this is not necessarily true for some quantities.\nThe \
reason is to force Mathematica to cancel out certain terms, which will \
otherwise give a ",
 Cell[BoxData[
  FormBox[
   FractionBox["0", "0"], TraditionalForm]],ExpressionUUID->
  "2ffb0fa9-4c6d-46a0-a50e-ea761d93c1cc"],
 " error (e.g. evaluating ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ln"], TraditionalForm]],ExpressionUUID->
  "031099cc-4005-472c-aaf4-0e61c983839a"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "0"}], ",", "1"}], TraditionalForm]],ExpressionUUID->
  "2e988e8c-7447-4ebf-8364-c42090fd0bec"],
 ")."
}], "Text",
 CellChangeTimes->{{3.893830178261451*^9, 
  3.893830260112306*^9}},ExpressionUUID->"99c87939-181e-4725-9b1b-\
fcb1b84f214b"],

Cell[BoxData[{
 RowBox[{
