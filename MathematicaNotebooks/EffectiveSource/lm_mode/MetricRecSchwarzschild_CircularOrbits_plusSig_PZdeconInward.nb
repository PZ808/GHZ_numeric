Cell[CellGroupData[{

Cell["Corrector tensor", "Chapter",
 CellChangeTimes->{{3.872834792705989*^9, 3.8728347998475313`*^9}, 
   3.873199714988744*^9, 3.8731999219459467`*^9, {3.8732025770666037`*^9, 
   3.873202580121941*^9}, {3.873266720257308*^9, 3.873266726519794*^9}, {
   3.87370767765462*^9, 3.873707689262396*^9}, {3.873708073361755*^9, 
   3.8737080762652187`*^9}, 3.8750867580908403`*^9, {3.878472625343667*^9, 
   3.878472633249157*^9}, {3.882427459931904*^9, 3.882427462764402*^9}, 
   3.886503193171417*^9, {3.8871227169133*^9, 3.8871227374892263`*^9}, {
   3.887179827414137*^9, 3.887179828423109*^9}, {3.8872701846982317`*^9, 
   3.8872701878384953`*^9}, 3.888560558726502*^9, {3.893320441361218*^9, 
   3.8933204436889*^9}, {3.893589095431237*^9, 
   3.893589095857773*^9}},ExpressionUUID->"f7badb55-9d1a-465b-a721-\
75675971ec51"],

Cell[CellGroupData[{

Cell["Theory", "Section",
 CellChangeTimes->{{3.8788066672288637`*^9, 3.8788066682679863`*^9}, {
  3.879841651770989*^9, 
  3.8798416525197487`*^9}},ExpressionUUID->"8206bd5a-d7cb-43cf-9f6f-\
dddaf0b369f4"],

Cell[TextData[{
 "General corrector tensor is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "ab"], " ", "=", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      SubscriptBox["m", 
       RowBox[{"(", "a"}]], 
      SubscriptBox[
       OverscriptBox["m", "_"], 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]]}], " ", "-", " ", 
     RowBox[{"2", " ", 
      SubscriptBox["l", 
       RowBox[{"(", "a"}]], 
      SubscriptBox[
       OverscriptBox["m", "_"], 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", "nm"]}], "-", 
     RowBox[{"2", " ", 
      SubscriptBox["l", 
       RowBox[{"(", "a"}]], 
      SubscriptBox["m", 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", 
       RowBox[{"n", 
        OverscriptBox["m", "_"]}]]}], "+", 
     RowBox[{
      SubscriptBox["l", "a"], 
      SubscriptBox["l", "b"], 
      SubscriptBox["x", "nn"]}]}]}], TraditionalForm]],ExpressionUUID->
  "37e440af-badf-4f29-ba88-55fadf8a22c9"],
 ", see ",
 ButtonBox["1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 " eq. (55). Defined to satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["T", "ab"], "-", 
       SubscriptBox[
        RowBox[{"(", "\[ScriptCapitalE]x", ")"}], "ab"]}], ")"}], 
     SuperscriptBox["l", "a"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "4cc6f617-7cd3-4705-8407-3f7b62f55ca5"],
 ".\nNote that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "la"], "=", 
    RowBox[{
     SubscriptBox["x", "mm"], "=", 
     RowBox[{
      SubscriptBox["x", 
       RowBox[{
        OverscriptBox["m", "_"], 
        OverscriptBox["m", "_"]}]], "=", "0"}]}]}], TraditionalForm]],
  ExpressionUUID->"78d2b9d1-7256-495a-9706-c518e2cd463c"],
 ". Only non-trivial pieces are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "nn"], ",", " ", 
    SubscriptBox["x", "nm"], ",", 
    SubscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}]], ",", 
    SubscriptBox["x", 
     RowBox[{
      OverscriptBox["m", "_"], 
      OverscriptBox["m", "_"]}]]}], TraditionalForm]],ExpressionUUID->
  "62ed5c97-64e3-4297-9da4-5952ed1fff6b"],
 ". They are given by ODEs, see ",
 ButtonBox["2108.04273",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2108.04273.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/2108.04273.pdf"],
 ", eq. (56)-(61), and ",
 ButtonBox["1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 ", eq. (58)-(61). See also comment on page 38."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBmIQ/Us0ZZLNszeOW10yF4Hoo3wJRrZAesZtJWsQvTBK
xx5ET2BSqwHRG4QkG0D0LYaNXSBaYb/qBBAdeMsBTM+fcP0iiJ42CUIXTAq8
BqKtbjbdAdEs35Kemr544yizZP4zEH3uRP+2h1/eOH7Z+uAAiO5q43gAomXu
X/8Non33/WR4BKRfJx9RAdFRFmu0QPS+AFtLEF0UJRoEoqewcBSA6B0GzeVg
/rn9VSCaYY7i6SdAWsAm6hqIPtMR/QBEW2zofgqiJ7yYkif77Y3jpgnZRSD6
mp4EQ96/N46aU6PAtETn3J+31rx1fHHwKpgGAG3IstQ=
  "],ExpressionUUID->"0c9c7351-1124-48d4-a3c0-3522f6ef12b7"]
}, Closed]],

Cell[CellGroupData[{

Cell["Boundary conditions", "Section",
 CellChangeTimes->{{3.8934962567815247`*^9, 
  3.893496263016321*^9}},ExpressionUUID->"c40d767e-257d-4f44-b275-\
dea44308e4c8"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[Rho]max", ",", "rmax", ",", "rmin", ",", "\[Rho]min"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9924108620934353`*^9, 3.992410876326646*^9}},
 CellLabel->
  "In[392]:=",ExpressionUUID->"fbe2aa72-eb9d-4b61-8bc2-b4bc33a9d3ea"],

Cell[CellGroupData[{

Cell["Theory/Notes", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.897968025962689*^9, 
  3.897968038832839*^9}},ExpressionUUID->"8f27f4f7-1cd6-436a-98ba-\
0a7e4dd9ee9c"],

Cell[TextData[{
 "Can do this either by\t1) evaluating the integrals in (59)-(61) in the \
reconstruction paper,\n\t\t\t\t\t2) Expand out LHS of (56)-(59) in \
reconstruction paper, setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "ab"], " ", "\[Rule]", " ", 
    RowBox[{
     SubscriptBox["x", "ab"], 
     RowBox[{"H", "(", 
      RowBox[{
       SubscriptBox["r", "max"], "-", "r"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"82e55696-5ea8-4d85-ab9b-84fbe9b9b3a2"],
 ", then equate the distributional pieces.\n\t\t\t\t\t",
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " in the following, we always make sure the coefficients of the \[Delta] \
functions and its derivatives have been evaluated\n\t\t\t\t\tat ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "104b74bc-e962-4b7d-9c63-d58bce92a928"],
 " if this is not already the case.\n\t\t\t\t\tThis is done using the usual \
identities:\n\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"F", 
      RowBox[{"(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], "   ", "=", "     ", 
     RowBox[{
      RowBox[{"F", "(", 
       SubscriptBox["x", "0"], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"F", "'"}]}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"db247620-e01e-41bc-a270-e77e34e1abdc"],
 "\nMake sure to account for the signature convention differences!\n",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
