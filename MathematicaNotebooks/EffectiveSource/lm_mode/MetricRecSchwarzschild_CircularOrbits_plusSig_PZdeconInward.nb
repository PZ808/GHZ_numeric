Cell[TextData[{
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " When defining the \[OpenCurlyDoubleQuote]TRXXInterpolation\
\[CloseCurlyDoubleQuote] below, important that the different geodesics and \
numerical quantities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "71dc10ca-4d90-4418-bb23-7127217b0a9f"],
 ",M, etc) have not been set yet. Otherwise, get a strange error in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ln"], TraditionalForm]],ExpressionUUID->
