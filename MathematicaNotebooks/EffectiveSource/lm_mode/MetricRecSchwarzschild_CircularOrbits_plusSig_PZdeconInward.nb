Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rDataMax", "=", "1200"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhiBarPlusAtRmax", "=", 
    RowBox[{"PhiBarPlusBoundaryDataAll", "[", 
     RowBox[{"rmax", ",", "lmax", ",", 
      RowBox[{"\"\<FitRange\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"800", ",", "1200"}], "}"}]}], ",", 
      RowBox[{"\"\<BoundaryRadius\>\"", "->", "1100"}], ",", 
      RowBox[{"\"\<PeelingPower\>\"", "->", "5"}], ",", 
      RowBox[{"\"\<NTailTerms\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<NumberOfFitPoints\>\"", "->", "250"}], ",", 
      RowBox[{"WorkingPrecision", "->", "60"}], ",", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", 
      RowBox[{"PrecisionGoal", "->", "25"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhiBarPlusAtRmax", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], "]"}], "[", "\"\<\[Phi]bar\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"PhiBarPlusAtRmax", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], "]"}], "[", "\"\<d\[Phi]bar\>\"", "]"}], "\n", 
 RowBox[{
