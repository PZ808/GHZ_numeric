Cell[CellGroupData[{

Cell["Hertz potential \[CapitalPsi]", "Chapter",
 CellChangeTimes->{{3.872758888155019*^9, 3.8727588905969276`*^9}, {
  3.8728313351903753`*^9, 3.872831346176062*^9}, {3.8729381830397043`*^9, 
  3.872938184327359*^9}, {3.877414068963187*^9, 3.877414078485368*^9}, {
  3.877585615984076*^9, 3.877585616425661*^9}, {3.879849408976841*^9, 
  3.87984941312221*^9}, {3.8800313644882*^9, 3.880031364858171*^9}, {
  3.883905472332659*^9, 3.883905479637525*^9}, {3.8840704358740396`*^9, 
  3.884070436038962*^9}, {3.902216112135228*^9, 3.902216113232193*^9}, {
  3.9947341363355627`*^9, 3.994734137221931*^9}, {3.994826981917288*^9, 
  3.994826982665936*^9}},ExpressionUUID->"b92032db-f23e-404e-8024-\
3c977450ae12"],

Cell[TextData[{
 "Note: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "b6be2994-0b1c-4d3f-939a-412cced8a98e"],
 " will by definition be invariant under sign signature. This is not the case \
for the Hertz potential, which will differ by a sign.\nCompare for example \
Eq.(6) in reconstruction paper to (68a) in book chapter.\nIn the present case \
below, we will compute the Hertz potential (and thus the metric at the next \
step) in the (+,-,-,-) signature."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.8831199732650843`*^9, 3.883119987386539*^9}, {
   3.883120042113454*^9, 3.883120112066766*^9}, {3.883120245889801*^9, 
   3.883120302904567*^9}, 3.883378728878539*^9, 
   3.88350806672655*^9},ExpressionUUID->"fdbc1e3a-296c-4c19-aef6-\
c86f71970c0e"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.992612156609126*^9, 
  3.992612158362975*^9}},ExpressionUUID->"f8800620-3453-44fa-8946-\
8db506ebecfa"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalPsi]", 
    RowBox[{"+", 
     RowBox[{"/", "-"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{"half", " ", "string"}], ")"}], " ", "and", " ", 
   RowBox[{
    SuperscriptBox["\[CapitalPsi]", 
     RowBox[{"N", " "}]], "(", 
    RowBox[{"no", " ", "sting"}], ")"}], " ", "from", " ", 
   RowBox[{"Ori", "'"}], "s", " ", "method"}], 
  TraditionalForm]],ExpressionUUID->"4c4e75c5-9aeb-49ce-9c30-d52101e37e46"]], \
"Section",
 CellChangeTimes->{{3.872758888155019*^9, 3.8727588905969276`*^9}, {
   3.8728313351903753`*^9, 3.872831346176062*^9}, {3.8729381830397043`*^9, 
   3.872938184327359*^9}, {3.877414068963187*^9, 3.877414078485368*^9}, {
   3.877585615984076*^9, 3.877585616425661*^9}, 3.879160166577688*^9, {
   3.8831313338740063`*^9, 3.883131335164356*^9}, {3.9925096033326473`*^9, 
   3.992509606330902*^9}, {3.994734181682678*^9, 3.994734231976943*^9}, {
   3.994826988197699*^9, 
   3.994826990001696*^9}},ExpressionUUID->"75a19342-b332-4458-a9bf-\
64e5f00408ca"],

Cell[CellGroupData[{

Cell["Theory", "Subsection",
 CellChangeTimes->{{3.9070466143537397`*^9, 3.907046617142795*^9}, {
  3.907046856657029*^9, 
  3.907046859950137*^9}},ExpressionUUID->"435b1a54-d2c4-49aa-a7f6-\
af729cc4aa7f"],

Cell[TextData[{
 "The Hertz potential equation (radial inversion formula) is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox["\[Thorn]", "4"], 
     OverscriptBox["\[CapitalPsi]", "_"]}]}], TraditionalForm]],
  ExpressionUUID->"41d7443a-fbd8-4764-bd8b-5765b72650ee"],
 ".\nIn vacuum, can use the Teukolsky-Starobinsky relations can be used on \
the radial inversion formula (decoupled into modes) to give\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["64", 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], 
       SuperscriptBox["\[Thorn]", "4"], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", 
         RowBox[{"-", "2"}]], 
        SubscriptBox["\[Psi]", "lm"]}]}]}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["64", 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], 
       SuperscriptBox["r", "4"], 
       SuperscriptBox[
        RowBox[{"\[Thorn]", "'"}], "4"], 
       SuperscriptBox["r", "4"], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
        SubscriptBox["\[Psi]", "lm"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f9dccbed-7461-4092-8528-f7b4295a2c8e"],
 "\nIn the above, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPhi]", "_"], "lm"], TraditionalForm]],
  ExpressionUUID->"b4dc7334-d610-4f33-8425-6a1892185fc9"],
 " means the modes of a complex conjugated quantity. In particular,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox[
      OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], " ", ":=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"m", "+", "s"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
        SubscriptBox[
         OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], ")"}], "*"]}]}], 
   TraditionalForm]],ExpressionUUID->"c13416cd-3535-41e6-9d09-5bb893efdc72"],
 ".\nSo, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"52853f51-96ac-407b-b1d5-eb2f29e81b93"],
 " can be expanded into basis functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["", 
     RowBox[{"-", "s"}]], 
    SubscriptBox["\[Psi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "bf11c9a6-ea94-4422-bcc1-3f98ce68b11b"],
 ", and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["\[CapitalPsi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "8377e3ee-0cf6-4cec-b6a9-942bcce4474a"],
 " into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["\[Psi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "51a8533f-3e40-40bb-b91e-8125417a3e72"],
 ", say the \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] basis functions \
for concreteness. In particular, the right-hand side of the above equations \
must satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["\[Psi]", "lm"]}]}], " ", "\[Proportional]", " ", 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
     SubscriptBox["\[Psi]", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "54a5aaa2-80a6-4c82-9762-bce34eaf2a7e"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["\[Psi]", "lm"]}]}], " ", "\[Proportional]", "  ", 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "2"}]], 
     SubscriptBox["\[Psi]", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "44fc629c-1174-44a0-8d5b-b69438988b21"],
 ".\n\nThe proper way to find the exact coefficient is to evaluate these \
homogeneous functions at the horizon (or infinity depending on the basis \
function) and simply comparing them. Alternatively, can just guess and then \
check numerically \[OpenCurlyDoubleQuote]until it works\
\[CloseCurlyDoubleQuote]. See below.\n\nThe exact formula depends on \n 1) on \
the normalisation of the homogenenous solutions,\n  2) if m=0 or not.\n  \n\
For example, for ",
 StyleBox["non-static",
  FontWeight->"Bold"],
 " modes, using the \[OpenCurlyDoubleQuote]usual\[CloseCurlyDoubleQuote] \
normalisation from the toolkit, one can check that \n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["64", 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], 
     SuperscriptBox["\[Thorn]", "4"], "  ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox["4", 
      SuperscriptBox["\[Omega]", "4"]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["64", 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], 
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"64", 
       SuperscriptBox["\[Omega]", "4"]}], 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], TraditionalForm]}],
  ExpressionUUID->"617a7562-ee07-4491-a4e7-1ae61e545a2a"],
 "\nfrom which the modes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", 
     RowBox[{"\[PlusMinus]", "2"}]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"180a4f87-f107-46ac-91b3-4111c35c4846"],
 " are then given analytically,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "lm", "up"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["4", 
        SuperscriptBox["\[Omega]", "4"]], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
        SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalPsi]", "_"], "lm", "up"]}], " ", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"64", 
         SuperscriptBox["\[Omega]", "4"]}], 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", 
         RowBox[{"-", "2"}]], 
        SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"af993675-8497-4f35-8669-f189b4382f25"],
 "\nNote that for static modes, this breaks down.\n\nFor the",
 StyleBox[" static ",
  FontWeight->"Bold"],
 "modes, the homogeneous solution are actually known analytically (again, up \
to normalisation). In the toolkit, they are given by,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "in"], " ", "=", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "+", "s", "+", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "s"}]], " ", 
     FractionBox[
      RowBox[{"\[CapitalGamma]", "(", 
       RowBox[{"1", "+", "s"}], ")"}], 
      RowBox[{"\[CapitalGamma]", "(", 
       RowBox[{"1", "-", "s"}], ")"}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "l"}], ",", 
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"1", "-", "s"}], ",", 
       RowBox[{"1", "-", 
        FractionBox["r", 
         RowBox[{"2", "M"}]]}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "662df9a7-8e71-4bc9-b230-0517dc25d041"],
 ", s> 0 (note that \[CapitalGamma](1-s) should be absorbed into F21 to \
regularize it into F21Regularised)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "in"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "2"}], "s"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["r", 
         RowBox[{"2", "M"}]], "-", "1"}], ")"}], 
      RowBox[{"-", "s"}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "l"}], ",", 
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"1", "-", "s"}], ",", 
       RowBox[{"1", "-", 
        FractionBox["r", 
         RowBox[{"2", "M"}]]}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "9b93e151-a33c-4a5d-bad0-e679d7ba595a"],
 ", s\[LessEqual] 0,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "up"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "s"}], "-", "l", "-", "1"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["r", 
         RowBox[{"2", "M"}]], "-", "1"}], ")"}], 
      RowBox[{"-", "s"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["r", 
        RowBox[{"2", "M"}]], ")"}], 
      RowBox[{
       RowBox[{"-", "l"}], "-", "1"}]], 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"l", "+", "1", "-", "s"}], ",", 
       RowBox[{
        RowBox[{"2", "l"}], "+", "2"}], ",", 
       FractionBox["r", 
        RowBox[{"2", "M"}]]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "93f09d16-0b9f-409a-a684-bfe8d4e15625"],
 "\nThis changes the formulae for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", 
     RowBox[{"\[PlusMinus]", "2"}]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPsi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"6a6ae3ea-035e-4ea1-bd09-845e17837764"],
 " a bit. The end-result is,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox[
       OverscriptBox["\[CapitalPsi]", "_"], "lm", 
       RowBox[{"in", "/", "up"}]]}], " ", "=", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["M", "4"]}], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"l", "-", "1"}], ")"}], "4"]], " ", 
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
       SubsuperscriptBox["\[Psi]", "lm", 
        RowBox[{"in", "/", "up"}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "17d64f44-e7ad-4ef5-954e-f3189f9f0798"],
 ".\nFor the retarded solution, one then simply multiples it with the \
appropriate weighting coefficient. "
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.907046633070578*^9, 3.9070466690971107`*^9}, {
  3.907046753715465*^9, 3.907046846293333*^9}, {3.907046902308004*^9, 
  3.907046903611537*^9}, {3.907047659981381*^9, 3.9070477829127293`*^9}, {
  3.907047842952845*^9, 3.907048144832046*^9}, {3.907048189903224*^9, 
  3.9070483070354033`*^9}, {3.907048382091339*^9, 3.907048765346795*^9}, {
  3.907048812608927*^9, 3.907048961199314*^9}, {3.907048995318959*^9, 
  3.907049136000572*^9}, {3.919572326051179*^9, 3.9195723290376263`*^9}, {
  3.919572391062608*^9, 3.9195724231333113`*^9}, {3.9947490990105057`*^9, 
  3.9947491346985292`*^9}, {3.99482699820294*^9, 
  3.994827021102364*^9}},ExpressionUUID->"513c18a6-019a-4f37-a26f-\
58588359b361"],

Cell[CellGroupData[{

Cell["The Teukolsky-Starobinsky spin flip relations", "Subsubsection",
 CellChangeTimes->{{3.907046882528058*^9, 3.907046907225952*^9}, {
  3.994734169554347*^9, 
  3.994734171783002*^9}},ExpressionUUID->"c3b8f5a0-b698-4cca-b4b3-\
3dce758f307c"],

Cell[TextData[{
 "The relations are (see review paper, and Chandrasekhar, The mathematical \
theory of black holes),\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["X", "lm"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SubscriptBox["C", "lm"], "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["X", "lm"]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
 
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["X", "lm"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SubsuperscriptBox["C", "lm", "*"], "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["X", "lm"]}]}]}], TraditionalForm]}],ExpressionUUID->
  "48336522-d7c1-4cb6-a7fa-eafb823a4d9f"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "lm"], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "-", "1"}], ")"}], "4"], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"m", "+", "l"}]], "12", " ", "i", " ", "M", " ", 
      "\[Omega]"}]}]}], TraditionalForm]],ExpressionUUID->
  "c88717a9-292d-4cf5-b63f-397972f637b1"],
 ".\nIn the above, X stands for functions that solve the vacuum Teukolsky \
equation. So, can replace it with \[Psi] or \[CapitalPhi]. Specifically, if \
one is given the name \[OpenCurlyDoubleQuote]\[Psi]\[CloseCurlyDoubleQuote], \
the opposite spin one is then called \[OpenCurlyDoubleQuote]\[CapitalPhi]\
\[CloseCurlyDoubleQuote].\nWe can combine them to get relations that \
\[OpenCurlyDoubleQuote]decouple\[CloseCurlyDoubleQuote] the + and - spins.\n\
",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], 
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["X", "lm"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}], "16"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["X", "lm"]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
 
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     SubscriptBox[
      SuperscriptBox["\[Thorn]", "4"], 
      RowBox[{"-", "2"}]], 
     SubscriptBox["X", "lm"]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}], "16"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["X", "lm"]}]}]}], TraditionalForm]}],ExpressionUUID->
  "13499823-7764-4649-838e-76511a220451"],
 "\nIn the literature, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["C", "lm"], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "61393a9d-9bb3-4855-b7d9-c03ebdf76f78"],
 " is called \[OpenCurlyDoubleQuote]p\[CloseCurlyDoubleQuote].\n\nBelow, \
checking explicitly that the relations are satisfied."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.907046922017836*^9, 3.9070469412919197`*^9}, {
  3.9070469768847647`*^9, 3.907047442058344*^9}, {3.907047479066354*^9, 
  3.907047540885112*^9}, {3.907047803340745*^9, 3.907047831334312*^9}, {
  3.9222511017486687`*^9, 
  3.92225110360293*^9}},ExpressionUUID->"c2443971-2e0c-4bd7-a618-\
8f79e86d32b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Testing", " ", "fourth"}], "-", 
    RowBox[{"order", " ", "TSIs"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myl", "=", "3"}], ";", 
    RowBox[{"mym", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Weyl$spin$p", "=", "4"}], ";", " ", 
    RowBox[{"Weyl$spin$q", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"myC", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{"myl", "-", "1"}], ",", "4"}], "]"}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"mym", "+", "myl"}], ")"}]}], " ", "12", " ", "I", " ", "M", 
       " ", 
       RowBox[{"\[Omega]m", "[", "mym", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Psi$sm2", "=", 
     RowBox[{"TeukolskyRadial", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "myl", ",", "mym", ",", "aKerr", ",", 
       RowBox[{"\[Omega]m", "[", "mym", "]"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<NumericalIntegration\>\"", ",", 
          RowBox[{"\"\<Domain\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<In\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}], ",", 
             RowBox[{"\"\<Up\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}]}], "}"}]}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Psi$s2", " ", "=", " ", 
     RowBox[{"TeukolskyRadial", "[", 
      RowBox[{"2", ",", "myl", ",", "mym", ",", "aKerr", ",", 
       RowBox[{"\[Omega]m", "[", "mym", "]"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<NumericalIntegration\>\"", ",", 
          RowBox[{"\"\<Domain\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<In\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}], ",", 
             RowBox[{"\"\<Up\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}]}], "}"}]}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Thorn]NullK", "[", 
      RowBox[{"\[Thorn]NullK", "[", 
       RowBox[{"\[Thorn]NullK", "[", 
        RowBox[{"\[Thorn]NullK", "[", 
         RowBox[{
          RowBox[{"Cplus", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "myl", ",", "mym"}], "]"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Psi$sm2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
           StyleBox["/",
            FontColor->GrayLevel[0]], 
           StyleBox[
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
            FontColor->GrayLevel[0]]}]}], "]"}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"myC", "/", "4"}], " ", 
       RowBox[{"Cplus", "[", 
        RowBox[{"2", ",", "myl", ",", "mym"}], "]"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Psi$s2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
        StyleBox["/",
         FontColor->GrayLevel[0]], 
        StyleBox[
         RowBox[{
          RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
         FontColor->GrayLevel[0]]}]}], ")"}]}], " ", "/.", " ", 
    RowBox[{"r", " ", "->", " ", "rmin"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"r", "^", "4"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Thorn]pNullK", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", "3"}]}], "]"}], "[", 
        RowBox[{
         RowBox[{"\[Thorn]pNullK", "[", 
          RowBox[{"2", ",", 
           RowBox[{"-", "2"}]}], "]"}], "[", 
         RowBox[{
          RowBox[{"\[Thorn]pNullK", "[", 
           RowBox[{"3", ",", 
            RowBox[{"-", "1"}]}], "]"}], "[", 
          RowBox[{
           RowBox[{"\[Thorn]pNullK", "[", 
            RowBox[{"4", ",", "0"}], "]"}], "[", 
           RowBox[{
            RowBox[{"r", "^", "4"}], " ", 
            RowBox[{"Cplus", "[", 
             RowBox[{"2", ",", "myl", ",", "mym"}], "]"}], " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Psi$s2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
             StyleBox["/",
              FontColor->GrayLevel[0]], 
             StyleBox[
              RowBox[{
               RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
              FontColor->GrayLevel[0]]}]}], "]"}], "]"}], "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", "myC", "]"}], "/", "4"}], " ", 
         RowBox[{"Cplus", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "myl", ",", "mym"}], "]"}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Psi$sm2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
          StyleBox["/",
           FontColor->GrayLevel[0]], 
          StyleBox[
           RowBox[{
            RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
           FontColor->GrayLevel[0]]}]}], ")"}]}]}], " ", "/.", " ", 
     RowBox[{"r", " ", "->", " ", "rmin"}]}], "/.", " ", 
    RowBox[{"m", " ", "->", " ", "mym"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Cp", "[", 
      RowBox[{"myl", ",", 
       RowBox[{"-", "mym"}]}], "]"}], " ", 
     RowBox[{"Cplus", "[", 
      RowBox[{"2", ",", "myl", ",", 
       RowBox[{"-", "mym"}]}], "]"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9042005418057203`*^9, 3.904200597727915*^9}, {
