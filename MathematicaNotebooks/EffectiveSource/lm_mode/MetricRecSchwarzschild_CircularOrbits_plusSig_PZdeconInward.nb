Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "A", ",", "b", ",", "\[CapitalPsi]HalfMinusDataRight", ",", 
   "paraFitRuleFor\[CapitalPsi]HalfMinusDataRight"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPsi]HalfMinusDataRight", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
            RowBox[{
             RowBox[{"\[CapitalPsi]barp$HalfMinus", "[", 
              RowBox[{"l", ",", 
               RowBox[{"-", "m"}]}], "]"}], "[", "rPlotRight", "]"}]}], "]"}],
           " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "20", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRuleFor\[CapitalPsi]HalfMinusDataRight", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"\[CapitalPsi]HalfMinusDataRight", "[", 
      RowBox[{"[", "All", "]"}], "]"}], "]"}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "b"}], "}"}], ",", "l"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
