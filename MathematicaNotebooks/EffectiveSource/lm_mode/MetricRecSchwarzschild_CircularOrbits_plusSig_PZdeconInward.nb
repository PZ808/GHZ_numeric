Cell[TextData[{
 "The retarded metric perturbation is discontinuous at the worldline, the \
discontinuity goes as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "11c224cd-0fab-4dfe-b722-a85984c6b0c0"],
 ", and the continuous piece goes as ",
