Cell[BoxData[{
 RowBox[{"Clear", "[", "boun", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"boun", "[", 
   RowBox[{"p_", ",", "l_", ",", "m_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "r"}], " ", 
      RowBox[{"dint", "[", 
       RowBox[{"1", ",", "p", ",", "m", ",", "r", ",", "\[Delta]"}], "]"}], 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", 
          RowBox[{"m", "-", "1", "-", "r"}]}], "]"}], "[", "Pl", "]"}], "[", 
       RowBox[{"l", ",", "1"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", 
       RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "-", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "r"}], " ", 
      RowBox[{"dint", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "p", ",", "m", ",", "r", ",", "\[Delta]"}], 
       "]"}], 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", 
          RowBox[{"m", "-", "1", "-", "r"}]}], "]"}], "[", "Pl", "]"}], "[", 
       RowBox[{"l", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ",", 
     RowBox[{"{", 
