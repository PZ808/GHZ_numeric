    RowBox[{"xmmbpAt\[Rho]maxViaODE", "[", 
     RowBox[{"l", ",", "m"}], "]"}]}], " ", "/.", " ", 
   RowBox[{"\[Rho]max", "->", "  ", 
    RowBox[{"\[Rho]OfrK", "[", "rmax", "]"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
