Cell[CellGroupData[{

Cell["Operators", "Chapter",
 CellChangeTimes->{{3.8730074467106*^9, 3.873007477647131*^9}, {
  3.87369394240007*^9, 3.873693944583273*^9}, {3.878291951544613*^9, 
  3.878291953280534*^9}, {3.8788088204318743`*^9, 3.878808820836512*^9}, {
  3.885890555612906*^9, 
  3.885890556310988*^9}},ExpressionUUID->"d1d9873d-da7b-416a-bd22-\
e2b411aafb97"],

Cell[CellGroupData[{

Cell["\[Thorn] and \[Eth]", "Section",
 CellChangeTimes->{{3.879229741978854*^9, 3.879229742358327*^9}, {
   3.879230805306423*^9, 3.87923081202138*^9}, 3.882508040596266*^9, 
   3.882508503202599*^9, 
   3.8928914459620867`*^9},ExpressionUUID->"fad178fd-5433-4d8c-b5d8-\
5d2644ed636c"],

Cell[TextData[{
 "The operators \[Thorn] and \[Eth] are given as (see, for example, eq 36 \
page 12 and page 27 in ",
 ButtonBox["b",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2101.04592"], None},
  ButtonNote->"https://arxiv.org/abs/2101.04592"],
 "ook cha):\nNote that they are independent on sign convention.\n\t\[Thorn] \
:= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["l", "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], " ", 
      RowBox[{"-", " ", "p\[Epsilon]"}]}]}], "-", 
    RowBox[{"q", 
     OverscriptBox["\[Epsilon]", "_"]}]}], TraditionalForm]],ExpressionUUID->
  "47ad8c7d-4c2c-4038-9d97-bc98ddabecc8"],
 ",\t\t\[Thorn]\[CloseCurlyQuote] := ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], " ", 
      RowBox[{"+", 
       RowBox[{"p\[Epsilon]", "'"}]}]}]}], "+", 
    RowBox[{"q", 
     RowBox[{
      OverscriptBox["\[Epsilon]", "_"], "'"}]}]}], TraditionalForm]],
  ExpressionUUID->"a7ad8859-965c-4b92-ba09-f0878d5325cb"],
 ",\n\t\[Eth] := ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["m", "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], " ", 
      RowBox[{"-", " ", "p\[Beta]"}]}]}], "+", 
    RowBox[{"q", 
     RowBox[{
      OverscriptBox["\[Beta]", "_"], "'"}]}]}], TraditionalForm]],
  ExpressionUUID->"159524f2-4d73-4779-90a5-9117a8c92010"],
 ",\t\[Eth]\[CloseCurlyQuote] := ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox["m", "_"], "a"], 
     RowBox[{
      SubscriptBox["\[Del]", "a"], " ", 
      RowBox[{"+", 
       RowBox[{"p\[Beta]", "'"}]}]}]}], "-", 
    RowBox[{"q", 
     OverscriptBox["\[Beta]", "_"]}]}], TraditionalForm]],ExpressionUUID->
  "c48d53e3-e288-4275-a091-fc2cd37303c5"],
 ".\n\nFor example, in Schwarzschild circular orbits, we find:\nIn Carter \
tetrad: \t\twith t coordinate: \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Thorn]", "C"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "f"}]]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "t"}]], 
        RowBox[{"+", "f"}]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], " ", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"p", "+", "q"}], ")"}], "2"]}]}], 
       FractionBox["M", 
        SuperscriptBox["r", "2"]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ebbb30c5-5852-4735-902e-8efe43d111bb"],
 ",\n\t\t\t\t\twith u coordinate:\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Thorn]", 
     RowBox[{"Null", " ", "C"}]], " ", "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "f"}]]], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["f", "2"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]], " ", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"p", "+", "q"}], ")"}], "2"]}]}], 
       FractionBox["M", 
        SuperscriptBox["r", "2"]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"b39d96fd-79f2-4b77-94fe-be6cb8d463d5"],
 ".\nIn Kinnersley tetrad: \twith t coordinate: \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Thorn]", "K"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "f"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "t"}]], 
        RowBox[{"+", "f"}]}], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "r"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"36c43f98-1526-43ac-b4e9-588e09ad8358"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[Thorn]", "'"}], "K"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", "t"}]], 
         RowBox[{"-", "f"}]}], 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "r"}]]}], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "2"], 
      FractionBox["M", 
       SuperscriptBox["r", "2"]]}]}]}], TraditionalForm]],ExpressionUUID->
  "1705e03a-9668-4372-a952-cd0573d149dd"],
 ",\n\t\t\t\t\twith u coordinate:\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Thorn]", 
     RowBox[{"Null", " ", "K"}]], " ", "=", 
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", "r"}]]}], TraditionalForm]],ExpressionUUID->
  "46234e8d-4292-4dfa-9345-8a9e4538fc10"],
 ",\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[Thorn]", "'"}], 
     RowBox[{"Null", " ", "K"}]], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "u"}]], 
        RowBox[{"-", 
         FractionBox["f", "2"]}]}], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "r"}]]}], ")"}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "2"], 
      FractionBox["M", 
       SuperscriptBox["r", "2"]]}]}]}], TraditionalForm]],ExpressionUUID->
  "229c7ec8-6e20-42df-921e-ff2e79c6d828"],
 ".\nIn both tetrads: \t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eth]", "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       RowBox[{
        FractionBox["1", "r"], " "}], 
       RowBox[{"-", "s"}]]}], 
     SubsuperscriptBox["\[ScriptCapitalL]", "\[Omega]", "\[Dagger]"]}]}], 
   TraditionalForm]],ExpressionUUID->"7311d0cb-ff2b-47e4-a4e1-71571827eccc"],
 ", \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eth]", "'"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       RowBox[{
        FractionBox["1", "r"], " "}], "s"]}], 
     SubscriptBox["\[ScriptCapitalL]", "\[Omega]"]}]}], TraditionalForm]],
  ExpressionUUID->"64de1d94-1f9b-4a49-85bb-b34acee2d29b"],
 ", \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[" ", "s"], 
     SubscriptBox["\[ScriptCapitalL]", "\[Omega]"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "\[Theta]"}]], 
        RowBox[{"+", 
         FractionBox["\[ImaginaryI]", "sin\[Theta]"]}]}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "\[Phi]"}]], 
        RowBox[{"-", "s"}]}], " ", "cot", " ", "\[Theta]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"e6da7e22-7480-4e7a-be30-b40e1ec1e514"],
 ", where s := ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"p", "-", "q"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "c0f8f6d5-7bc6-4807-97ac-719168425d99"],
 " is the spin.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[" ", 
     RowBox[{"-", "s"}]], 
    SubsuperscriptBox["\[ScriptCapitalL]", "\[Omega]", "\[Dagger]"], " ", 
    SubscriptBox[
     RowBox[{"and", " "}], "s"], 
    SubscriptBox["\[ScriptCapitalL]", "\[Omega]"]}], TraditionalForm]],
  ExpressionUUID->"514e80f7-3815-4e87-944d-08ea70543fb2"],
 " is sometimes also written as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Eth]", "~"], TraditionalForm]],ExpressionUUID->
  "7f2cf1d0-bceb-4d8c-a3b7-0300fccc68e6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Eth]", "~"], "'"}], TraditionalForm]],ExpressionUUID->
  "f5b9c24a-b0e0-4d7c-a978-d18650f01784"],
 " (eq A.17, in reconstruction paper).\n\nFor differentiation with respect to \
t, we can use a small hack and replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", "t"}]], " ", 
    RowBox[{"->", " ", 
     RowBox[{"-", 
      SubscriptBox["im\[CapitalOmega]", "\[Phi]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"3e772668-f552-4c66-a1ab-60875e1deeae"],
 ".\nFor \[Eth], we replace the differential operator by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eth]", "(", "s", ")"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "r"]}], 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "-", "s"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"l", "+", "s", "+", "1"}], ")"}]}], "2"]]}]}], 
   TraditionalForm]],ExpressionUUID->"c559638b-b4ba-4871-8174-53897314e42c"],
 " etc."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQBGIQrSBrZcH9/I3jkgZbGxD94+qqdhC95ktqD4i+U1I2
G0Sz/N2yDET7cGivA9H/drCsB9Ed+9+0aLx942h0wrUDRIefF54Iol89TZoM
ok05vaeD6L7Mw9tBdOryr5dAdOn8izdBdGDFqbsg+lZr8T0QrXve7RGIrlnb
9xRE7++pfAWif/3Y8gZES+VM+gyiN62L+wOi5d5+Z9EE0gY6tnwgumO+lTuI
ZvKOiwPRDlXaSSC6KcUlH0S7aB5dGQqkHf9D6CfPF545+PGNY07ajLMgOmRL
6KaEr28czxwLA9MXDtdemPXvjeOBLNOLIDpv6xqpuUD63nYIbXMyxm4Ow1vH
rOm7HEB01DG5LHvmt47B7J4lIPpM7Ge+GLa3jtx11YIgOsNYIcpS5K3jjFtH
wLS/XkA6iL7V2pkJogGwnNbg
  "],ExpressionUUID->"4454e80b-8d4a-4183-9934-3e03a1d8c912"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"(*", 
    RowBox[{"\[Thorn]C", ",", "\[Thorn]NullC", ","}], "*)"}], 
   RowBox[{
   "\[Thorn]K", ",", "\[Thorn]pK", ",", "\[Thorn]NullK", ",", 
    "\[Thorn]pNullK", ",", "\[Thorn]NullK\[Rho]", ",", "\[Thorn]pNullK\[Rho]",
     ",", "\[Eth]CK", ",", "\[Eth]pCK", ",", "\[Eth]CK\[Rho]", ",", 
    "\[Eth]pCK\[Rho]"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Thorn]C", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"I", " ", 
           RowBox[{"\[Omega]m", "[", "m", "]"}]}], 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"f", "[", "r", "]"}]}], "]"}]]}], " ", "#"}], "+", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         FractionBox[
          RowBox[{"f", "[", "r", "]"}], "2"], "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "r"}], "]"}]}], " ", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]C", " ", "#"}]}], 
      " ", "&"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Thorn]NullC", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         FractionBox[
          RowBox[{"f", "[", "r", "]"}], "2"], "]"}], " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "r"}], "]"}], "/", "2"}]}], " ", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]NullC", " ", "#"}]}],
       " ", "&"}]}], ";"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Thorn]K", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
