Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "cb4a4a47-6f84-46a4-9fab-7ca54a07182f"],
 ", there are two parts that contribute: one from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "lm"], TraditionalForm]],ExpressionUUID->
  "0bce5223-630e-4629-a1d5-b071a1dfa6c3"],
 " as usual (\[Delta] and \[Delta]\[CloseCurlyQuote]), and one part from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalN]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "09cd42e2-1bb6-4598-bc44-acaae094f982"],
 " (just \[Delta]). The latter part is actually only made up of the \
distributional content in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "5462451b-f2a2-4830-b66d-e2a0fe6c9e83"],
 ".\nNote that this contribution will vanish anyway because the l=1 m=0 piece \
of Tll vanishes."
}], "Text",
