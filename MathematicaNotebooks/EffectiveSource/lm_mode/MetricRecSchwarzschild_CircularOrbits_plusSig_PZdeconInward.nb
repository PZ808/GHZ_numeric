Cell[TextData[{
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " the coefficients below are those from the puncture in u slicing! This is \
because these coefficients are needed when computing corrector tensor using \
power series expansion,\nand this requires stress energy given in u slicing. \
To make the calculations exact, the factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    SuperscriptBox["i\[Omega]r", "*"]], TraditionalForm]],ExpressionUUID->
  "1212b206-9083-41a4-b493-769259bc9df4"],
 " needs to be gone in expression of the stress-energy, which requires the \
input for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalE]h", "P"], TraditionalForm]],
  ExpressionUUID->"88954aa6-d809-47d2-a405-b2c57dedb990"],
 " to be given in u slicing as well."
}], "Text",
