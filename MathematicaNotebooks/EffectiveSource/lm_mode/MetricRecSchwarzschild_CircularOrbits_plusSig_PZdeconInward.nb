Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "TllDistrContributionAtRminTMP", ",", "TllDistrContributionAtRmin"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TllDistrContributionAtRminTMP", "[", 
     RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "\[Rho]_", "]"}], 
   " ", "=", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
