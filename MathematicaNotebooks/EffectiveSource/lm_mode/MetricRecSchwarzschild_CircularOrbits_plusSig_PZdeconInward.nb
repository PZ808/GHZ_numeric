              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"xmmbNDSolveRight", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]", "]"}], 
               "]"}]}]}], ";", "\[IndentingNewLine]", 
