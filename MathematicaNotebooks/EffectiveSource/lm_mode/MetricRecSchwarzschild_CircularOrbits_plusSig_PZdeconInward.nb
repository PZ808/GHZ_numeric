Cell[TextData[{
 "Check large l behaviour. For the numerically computed puncture, expect \
decay like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"~", 
    SuperscriptBox["l", 
     RowBox[{"-", "4"}]]}], TraditionalForm]],ExpressionUUID->
  "23e3c317-e425-4e2f-a432-855ddbede38b"],
 ". Only the leading regularization parameter coincide with the large l \
behaviour of the retarded field (because to get correct regularization \
parameter, need to expand in scalar harmonics), so expect decay like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "8e81a341-757d-4df6-bbb7-1b9a0348999f"],
 ".\nNote: again, using too little Workprecision (say wp=36), the blue line \
will be a little wobbly at higher l."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.888052169075306*^9, 3.88805225809046*^9}, {
  3.893928352786957*^9, 
  3.8939283981463013`*^9}},ExpressionUUID->"dd970e51-835e-4fc9-b7b3-\
a2576f4f389d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hluuNogDotUsingRegPara", " ", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"hRetuu", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"Hl", "[", "0", "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"Hl", "[", "2", "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"Hl", "[", "4", "]"}]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hluuNogDotUsingPuncture", " ", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"hRetuu", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}],
            "-", 
           RowBox[{
            RowBox[{"hPuu", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", 
            RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
     "]"}]}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.887874269034409*^9, 3.887874306003755*^9}, {
  3.887890927279356*^9, 3.887890927858884*^9}, {3.887890986649075*^9, 
