Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
    "Should", " ", "not", " ", "set", " ", "the", " ", "geodesic", " ", 
     "quantities", " ", "before", " ", "running", " ", 
     RowBox[{"this", "!"}]}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"TllTerm", ",", "TlmTerm", ",", "TlmbTerm", ",", "TlnTerm"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"TllTerm", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[Rho]_", "]"}], " ", "=", 
     RowBox[{
      RowBox[{"Piecewise", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"TllLeftInterpol", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", 
             RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], ",", 
            RowBox[{"\[Rho]", "<", "\[Rho]0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"TllRightInterpol", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", 
             RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], ",", 
            RowBox[{"\[Rho]", ">", "\[Rho]0"}]}], "}"}]}], "}"}], ",", 
        "Indeterminate"}], "]"}], " ", "//", " ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}], "&"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"TlmTerm", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[Rho]_", "]"}], " ", "=", 
     RowBox[{
      RowBox[{"Piecewise", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
