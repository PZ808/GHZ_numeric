        RowBox[{"rFitMin", "+", "rFitMax"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rScale", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rFitMax", "-", "rFitMin"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rs", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"wp", "===", "MachinePrecision"}], ",", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"rFitMin", ",", "rFitMax", ",", 
          RowBox[{"nPts", "-", "1"}]}], "]"}], ",", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"SetPrecision", "[", 
           RowBox[{"rFitMin", ",", "wp"}], "]"}], ",", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"rFitMax", ",", "wp"}], "]"}], ",", 
          RowBox[{"nPts", "-", "1"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xs", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rs", "-", "rCenter"}], ")"}], "/", "rScale"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"values", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"halfMinus", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "rr", "]"}], "-", 
         RowBox[{
          RowBox[{"inward", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "rr", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"rr", ",", "rs"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"values", ",", "NumericQ"}], "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<NonNumericValues\>\"", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Mode\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"l", ",", "m"}], "}"}]}], ",", 
            RowBox[{"\"\<BadIndices\>\"", "->", 
             RowBox[{"Pick", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"Length", "[", "values", "]"}], "]"}], ",", 
               RowBox[{"NumericQ", "/@", "values"}], ",", "False"}], 
              "]"}]}]}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mat", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Length", "[", "xs", "]"}]}], "]"}], ",", "xs", ",", 
         RowBox[{"xs", "^", "2"}], ",", 
         RowBox[{"xs", "^", "3"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"coeffsScaled", "=", 
      RowBox[{"LeastSquares", "[", 
       RowBox[{"mat", ",", "values"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"polynomialScaled", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cc", "=", "coeffsScaled"}], ",", 
          RowBox[{"rc", "=", "rCenter"}], ",", 
          RowBox[{"sc", "=", "rScale"}]}], "}"}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "rr", "}"}], ",", 
          RowBox[{
           RowBox[{"cc", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}], "^", 
             "2"}]}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "4", "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}], "^", 
             "3"}]}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"polynomialRExpression", "=", 
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"coeffsScaled", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"coeffsScaled", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", "-", "rCenter"}], ")"}], "/", "rScale"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"coeffsScaled", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "-", "rCenter"}], ")"}], "/", "rScale"}], ")"}], "^",
           "2"}]}], "+", 
        RowBox[{
         RowBox[{"coeffsScaled", "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "-", "rCenter"}], ")"}], "/", "rScale"}], ")"}], "^",
           "3"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"coeffsR", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"polynomialRExpression", ",", "r", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"polynomial", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"cc", "=", "coeffsR"}], "}"}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "rr", "}"}], ",", 
          RowBox[{
           RowBox[{"cc", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "rr"}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", 
            RowBox[{"rr", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"cc", "[", 
             RowBox[{"[", "4", "]"}], "]"}], " ", 
            RowBox[{"rr", "^", "3"}]}]}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"residuals", "=", 
      RowBox[{"values", "-", 
       RowBox[{"polynomial", "/@", "rs"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"scale", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "300"}]}], ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "values", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
       RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
       RowBox[{"\"\<FitRange\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"rFitMin", ",", "rFitMax"}], "}"}]}], ",", 
       RowBox[{"\"\<FitRadii\>\"", "->", "rs"}], ",", 
       RowBox[{"\"\<Center\>\"", "->", "rCenter"}], ",", 
       RowBox[{"\"\<Scale\>\"", "->", "rScale"}], ",", 
       RowBox[{"\"\<ScaledCoefficients\>\"", "->", "coeffsScaled"}], ",", 
       RowBox[{"\"\<coeffs\>\"", "->", "coeffsR"}], ",", 
       RowBox[{"\"\<a0\>\"", "->", 
        RowBox[{"coeffsR", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<a1\>\"", "->", 
        RowBox[{"coeffsR", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<a2\>\"", "->", 
        RowBox[{"coeffsR", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<a3\>\"", "->", 
        RowBox[{"coeffsR", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<Polynomial\>\"", "->", "polynomial"}], ",", 
       RowBox[{"\"\<ScaledPolynomial\>\"", "->", "polynomialScaled"}], ",", 
       RowBox[{"\"\<ResidualValues\>\"", "->", "residuals"}], ",", 
       RowBox[{"\"\<MaxAbsoluteResidual\>\"", "->", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "residuals", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<RelativeResidual\>\"", "->", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "residuals", "]"}], "]"}], "/", "scale"}]}]}], 
      "|>"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.994508644215536*^9, 3.994508644217615*^9}, {
  3.994508674730562*^9, 3.994508751538987*^9}, {3.994827878494793*^9, 
