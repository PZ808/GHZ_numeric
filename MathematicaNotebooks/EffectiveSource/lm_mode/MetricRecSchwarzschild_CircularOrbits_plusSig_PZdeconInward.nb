       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}]}]}], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"Can", " ", "check", " ", "that", " ", "the", " ", 
     RowBox[{"\[Delta]", "'"}], 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "max"]}], ")"}], " ", "piece", " ", 
     RowBox[{"vanishes", ":", " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]T", "ln", "+"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[CapitalDelta]\[ScriptCapitalU]x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}]], ")"}], "+"]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
