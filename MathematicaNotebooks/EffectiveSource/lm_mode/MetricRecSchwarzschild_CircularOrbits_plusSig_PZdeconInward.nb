Cell[TextData[{
 "Eq. (58) is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "2"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], 
      RowBox[{"(", 
       RowBox[{"r", " ", 
        SubscriptBox["x", "nn"]}], ")"}]}]}], "=", 
    RowBox[{
     SubscriptBox["T", "ln"], "+", 
     SubscriptBox["\[ScriptCapitalU]x", 
      RowBox[{"m", 
       OverscriptBox["m", "_"]}]], "+", 
     SubscriptBox["\[ScriptCapitalV]x", "nm"], "+", 
     RowBox[{
      OverscriptBox["\[ScriptCapitalV]", "_"], 
      SubscriptBox["x", 
       RowBox[{"n", 
        OverscriptBox["m", "_"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "84a1c1ef-6dbb-443c-be54-ef93882350ca"],
 "\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{"LHS", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        SubscriptBox["r", "max"], "-", "r"}], ")"}]}], "-", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["r", "max"]], 
      SubsuperscriptBox["x", "nn", "+"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
