Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", 
     RowBox[{
      OverscriptBox["m", "_"], 
      OverscriptBox["m", "_"]}], "\[Dagger]"], "=", 
    FormBox[
     RowBox[{" ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "-", "\[Rho]"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Thorn]", "+", 
          RowBox[{"3", "\[Rho]"}]}], ")"}]}], "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[Thorn]", "2"]}], "-", 
         RowBox[{"3", " ", "\[Thorn]\[Rho]"}], " ", "+", " ", 
         "\[Rho]\[Thorn]", "+", 
         RowBox[{"3", 
          SuperscriptBox["\[Rho]", "2"]}]}], "=", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["S", 
           RowBox[{
            OverscriptBox["m", "_"], 
            OverscriptBox["m", "_"]}], "\[Dagger]"], ")"}], "*"]}]}]}],
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "63ef8014-bbc5-4375-8340-0c4c6e90d3d7"],
 ",  eq (B.6)."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
