         RowBox[{"cCircDistrContributionAtRmin", "[", 
          RowBox[{"1", ",", "0", ",", "aExp"}], "]"}], "+", 
         RowBox[{"cCircDistrContributionAtRmax", "[", 
          RowBox[{"1", ",", "0", ",", "aExp"}], "]"}], "+", 
         RowBox[{"cCirc\[ScriptCapitalN]xmmbAnalyticContribution", "[", 
          RowBox[{"1", ",", "0", ",", "aExp"}], "]"}], "+", 
         RowBox[{
         "cCirc\[ScriptCapitalN]xmmbAbs\[CapitalDelta]rContribution", "[", 
          RowBox[{"1", ",", "0", ",", "aExp"}], "]"}]}], ")"}]}]}], " ", ",", 
     "CoeffCollectRule", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"#", ",", 
        RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}], " ", "&"}]}], 
    "]"}]}], ";"}]], "Input",
