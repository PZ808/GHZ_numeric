Cell["\<\
For m odd the decomposition is \[Integral]\[Rho]^p \\!\\( 
\\*SubsuperscriptBox[\\(P\\), \\(l\\), \\(m\\)](\\(cos\\ \[Alpha]\\))\\)sin^2 \
\[Alpha] d\[Alpha]. We have: Sqrt[1-x^2]P[l,m,x]=1/(2l+1) \
((l-m+1)(l-m+2)P[l+1,m-1,x]-(l+m-1)(l+m)P[l-1,m-1,x])\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"187b1844-49d0-463f-ac3c-922f57bfe89f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]int", "[", 
     RowBox[{"p_", ",", "l_", ",", "m_Integer", ",", "\[Delta]_"}], "]"}], "/;", 
    RowBox[{"OddQ", "[", "m", "]"}]}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "l"}], "+", "1"}], ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "-", "m", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"l", "-", "m", "+", "2"}], ")"}], 
       RowBox[{"\[Alpha]int", "[", 
        RowBox[{"p", ",", 
         RowBox[{"l", "+", "1"}], ",", 
         RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "+", "m", "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"l", "+", "m"}], ")"}], 
       RowBox[{"\[Alpha]int", "[", 
        RowBox[{"p", ",", 
         RowBox[{"l", "-", "1"}], ",", 
         RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}]}], ")"}]}]}], 
  ";"}]], "Input",
 Evaluatable->False,
 CellLabel->
  "In[5994]:=",ExpressionUUID->"066ea951-7ada-4dfb-b9d0-dc180732cde9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]int", "[", 
     RowBox[{
     "p_Integer", ",", "l_Integer", ",", "m_Integer", ",", 
      "\[Delta]_Symbol"}], "]"}], "/;", 
    RowBox[{"OddQ", "[", "m", "]"}]}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]int", "[", 
     RowBox[{"p", ",", "l", ",", "m", ",", "\[Delta]"}], "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "1"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "m", "+", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"l", "-", "m", "+", "2"}], ")"}], 
          RowBox[{"\[Alpha]int", "[", 
           RowBox[{"p", ",", 
            RowBox[{"l", "+", "1"}], ",", 
            RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "+", "m", "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"l", "+", "m"}], ")"}], 
          RowBox[{"\[Alpha]int", "[", 
           RowBox[{"p", ",", 
            RowBox[{"l", "-", "1"}], ",", 
            RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}]}], ")"}]}], 
      ",", 
      RowBox[{"Abs", "[", "\[Delta]", "]"}], ",", "Simplify"}], "]"}]}]}], 
  ";"}]], "Input",
 Evaluatable->False,
 CellLabel->
  "In[5995]:=",ExpressionUUID->"caf55397-32f8-400c-bba4-f24bf84a1ee0"],

Cell["\<\
In the vector sector, we have two different kinds of integrals for i=4,8.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"acc0b23d-079b-4a83-82de-5b1f6b0fd2d8"],

Cell["\<\
The first type of integral  involves:
1/Sqrt[1-x^2] ((l+1) (l+m) P[l-1,m,x]-l (l-m+1) P[l+1,m,x])/(2l+1)=-1/(2m \
(2l+1)) ((l+1) (l+m) (P[l,m+1,x]+(l-m)(l-m+1)P[l,m-1,x])-l (l-m+1) \
(P[l,m+1,x]+(l+m)(l+m+1)P[l,m-1,x]))=1/2 ((1+l-m)(l+m) P[l,m-1,x]-P[l,m+1,x])\
\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"58f39b3c-7b6c-44e6-8bbc-5e5fdc087bff"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Alpha]intv1", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]intv1", "[", 
   RowBox[{"p_Integer", ",", "l_", ",", "m_Integer", ",", "\[Delta]_Symbol"}],
    "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "-", "m", "+", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"l", "+", "m"}], ")"}], " ", 
      RowBox[{"\[Alpha]intmp2", "[", 
       RowBox[{"p", ",", "l", ",", 
        RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}], "-", 
     RowBox[{"\[Alpha]int", "[", 
      RowBox[{"p", ",", "l", ",", 
       RowBox[{"m", "+", "1"}], ",", "\[Delta]"}], "]"}]}], 
    ")"}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.907915187157749*^9, 3.907915188769916*^9}},
 CellLabel->
  "In[5996]:=",ExpressionUUID->"ab054d8b-e54f-424d-b290-2706bb08efd4"],

Cell["\<\
The second type of integral:

m/Sqrt[1-x^2] P[l, m, x] =-(1/2)(P[l-1, m+1, x]+(l+m-1)(l+m)P[l-1, m-1, x])\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"b1e99032-bd1d-4ac4-93e7-1bfb8eb77ee2"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Alpha]intv2", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]intv2", "[", 
   RowBox[{"p_Integer", ",", "l_", ",", "m_Integer", ",", "\[Delta]_Symbol"}],
    "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}]}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Alpha]int", "[", 
      RowBox[{"p", ",", 
       RowBox[{"l", "-", "1"}], ",", 
       RowBox[{"m", "+", "1"}], ",", "\[Delta]"}], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "m", "-", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"l", "+", "m"}], ")"}], 
      RowBox[{"\[Alpha]intmp2", "[", 
       RowBox[{"p", ",", 
        RowBox[{"l", "-", "1"}], ",", 
        RowBox[{"m", "-", "1"}], ",", "\[Delta]"}], "]"}]}]}], 
    ")"}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.9079151916116877`*^9, 3.9079151931726847`*^9}},
 CellLabel->
  "In[5998]:=",ExpressionUUID->"59370b51-ad32-4972-a9d8-36dc4f12b059"],

Cell["For i=5,9 we have two different integrals.", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"fa1f46bb-a982-454f-bcaa-e264a0b63527"],

Cell["\<\
The first type of integral  involves:
((l+1) (l+m) P[l-1,m,x]-l (l-m+1) P[l+1,m,x])/(2l+1)\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"674d7fff-8bbc-43de-9f23-17fac7cb3fc0"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Alpha]intv3", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]intv3", "[", 
   RowBox[{"p_Integer", ",", "l_", ",", "m_Integer", ",", "\[Delta]_Symbol"}],
    "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "l"}], "+", "1"}], ")"}]}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"l", "+", "m"}], ")"}], " ", 
      RowBox[{"\[Alpha]int", "[", 
       RowBox[{"p", ",", 
        RowBox[{"l", "-", "1"}], ",", "m", ",", "\[Delta]"}], "]"}]}], "-", 
     RowBox[{"l", 
      RowBox[{"(", 
       RowBox[{"l", "-", "m", "+", "1"}], ")"}], 
      RowBox[{"\[Alpha]int", "[", 
       RowBox[{"p", ",", 
        RowBox[{"l", "+", "1"}], ",", "m", ",", "\[Delta]"}], "]"}]}]}], 
    ")"}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.9079151995218*^9, 3.907915200935985*^9}},
 CellLabel->
  "In[6000]:=",ExpressionUUID->"4dceddbf-5d51-44fa-81f3-238a84e8bf2f"],

Cell["\<\
The second type of integral:

m P[l, m, x]\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"e75603e1-3534-41a2-a0a5-e492beefbb9e"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Alpha]intv4", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]intv4", "[", 
   RowBox[{"p_Integer", ",", "l_", ",", "m_Integer", ",", "\[Delta]_Symbol"}],
    "]"}], ":=", 
  RowBox[{"m", " ", 
   RowBox[{"\[Alpha]int", "[", 
    RowBox[{"p", ",", "l", ",", "m", ",", "\[Delta]"}], "]"}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.907915202413262*^9, 3.907915203869261*^9}},
 CellLabel->
  "In[6002]:=",ExpressionUUID->"3c6dafe3-9c78-42c8-b32c-6054863fe8ed"],

Cell["In the tensor sector we also have two types of integral", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"cc259b9e-48b4-498c-9bc8-ac9c8b162567"],

Cell["\<\
The first type of integral involves
1/(1-x^2) 1/((2l-1)(2l+1)(2l+3)) ((1+l) (2+l) (3+2 l) (-1+l+m) (l+m) \
LegendreP[-2+l,m,x]-2 (-1+l) (2+l) (1+2 l) (l+l^2-3 m^2) \
LegendreP[l,m,x]+(-1+l) l (-1+2 l) (1+l-m) (2+l-m) LegendreP[2+l,m,x])\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"a156e16d-a931-4be1-824e-6c95380b0f37"],

Cell["This simplifies to", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,ExpressionUUID->"46788a24-0a5b-4745-851c-35f9919c0c8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"legendredown", "=", 
   RowBox[{
    RowBox[{"LegendreP", "[", 
     RowBox[{"l_", ",", "m_", ",", "x"}], "]"}], ":>", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "m"}], ")"}]}], ")"}]}], " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"x", "^", "2"}]}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"LegendreP", "[", 
        RowBox[{
         RowBox[{"l", "-", "1"}], ",", 
         RowBox[{"m", "+", "1"}], ",", "x"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "+", "m", "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"l", "+", "m"}], ")"}], 
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{"l", "-", "1"}], ",", 
          RowBox[{"m", "-", "1"}], ",", "x"}], "]"}]}]}], ")"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"legendreup", "=", 
   RowBox[{
    RowBox[{"LegendreP", "[", 
     RowBox[{"l_", ",", "m_", ",", "x"}], "]"}], ":>", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "m"}], ")"}]}], ")"}]}], " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"x", "^", "2"}]}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"LegendreP", "[", 
        RowBox[{
         RowBox[{"l", "+", "1"}], ",", 
         RowBox[{"m", "+", "1"}], ",", "x"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "-", "m", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"l", "-", "m", "+", "2"}], ")"}], 
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{"l", "+", "1"}], ",", 
          RowBox[{"m", "-", "1"}], ",", "x"}], "]"}]}]}], ")"}]}]}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
 CellLabel->
  "In[6004]:=",ExpressionUUID->"d0ccb2cb-cf4f-4877-834c-3c8fb8fefb8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"legendrerules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"LegendreP", "[", 
       RowBox[{
        RowBox[{"l", "+", "2"}], ",", "m", ",", "x"}], "]"}], "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"LegendreP", "[", 
          RowBox[{
           RowBox[{"l", "+", "2"}], ",", "m", ",", "x"}], "]"}], "/.", 
         "legendredown"}], "/.", "legendredown"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"LegendreP", "[", 
       RowBox[{"l", ",", "m", ",", "x"}], "]"}], "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"LegendreP", "[", 
          RowBox[{"l", ",", "m", ",", "x"}], "]"}], "/.", "legendredown"}], "/.",
         "legendreup"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"LegendreP", "[", 
       RowBox[{
        RowBox[{"l", "-", "2"}], ",", "m", ",", "x"}], "]"}], "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"LegendreP", "[", 
          RowBox[{
           RowBox[{"l", "-", "2"}], ",", "m", ",", "x"}], "]"}], "/.", 
         "legendreup"}], "/.", "legendreup"}], ")"}]}]}], "}"}]}], 
  ";"}]], "Input",
 Evaluatable->False,
 CellLabel->
  "In[6006]:=",ExpressionUUID->"bc36b212-19b7-4c41-a9a9-e15d1a940aa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}]}], " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "3"}], ")"}]}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", "l"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"2", " ", "l"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "l", "+", "m"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"l", "+", "m"}], ")"}], " ", 
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "+", "l"}], ",", "m", ",", "x"}], "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "l"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", "l"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "l"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"l", "+", 
          RowBox[{"l", "^", "2"}], "-", 
          RowBox[{"3", " ", 
           RowBox[{"m", "^", "2"}]}]}], ")"}], " ", 
        RowBox[{"LegendreP", "[", 
         RowBox[{"l", ",", "m", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "l"}], ")"}], " ", "l", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "l"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l", "-", "m"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", "l", "-", "m"}], ")"}], " ", 
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{"2", "+", "l"}], ",", "m", ",", "x"}], "]"}]}]}], ")"}]}], "/.",
     "legendrerules"}], ",", 
   RowBox[{"HoldPattern", "[", 
    RowBox[{"LegendreP", "[", "__", "]"}], "]"}], ",", "Factor"}], 
  "]"}]], "Input",
 Evaluatable->False,
 CellLabel->
  "In[6007]:=",ExpressionUUID->"4acaa3ad-43a2-494a-83c0-080dc48c21b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "l", "-", "m"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"2", "+", "l", "-", "m"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "l", "+", "m"}], ")"}], " ", 
