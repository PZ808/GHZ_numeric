  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "71dc10ca-4d90-4418-bb23-7127217b0a9f"],
 ",M, etc) have not been set yet. Otherwise, get a strange error in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ln"], TraditionalForm]],ExpressionUUID->
  "d3eb4b76-2d13-4ad5-ae97-02a96c409c66"],
 " which only uses 3 digits of precision."
}], "Text",
