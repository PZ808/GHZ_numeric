Cell[BoxData[{
 RowBox[{
  RowBox[{"fll", " ", "=", " ", 
   RowBox[{
    RowBox[{"8", " ", "\[Pi]", " ", 
     RowBox[{
      RowBox[{"ul", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r0", "^", "2"}], " ", "utU"}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flm", " ", "=", " ", 
   RowBox[{
    RowBox[{"8", " ", "\[Pi]", " ", "ul", " ", 
     RowBox[{"um", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r0", "^", "2"}], " ", "utU"}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]pp", " ", "=", " ", 
   RowBox[{
    RowBox[{"fll", " ", 
     RowBox[{"r0", "/", 
      RowBox[{"(", 
       RowBox[{"8", " ", "\[Pi]"}], ")"}]}]}], " ", "//", " ", "Simplify"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]pp", " ", "=", " ", 
   RowBox[{
    RowBox[{"I", " ", 
     RowBox[{"flm", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}], " ", "\[Pi]"}], ")"}]}]}], " ", "//",
     " ", "Simplify"}]}], ";"}]}], "Input",
 Evaluatable->False,
