Cell[CellGroupData[{

Cell["Check --- Reality conditions", "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8816764118891706`*^9, 3.8816764270713377`*^9}, {
   3.8829447607562037`*^9, 3.882944766930718*^9}, 
   3.883379714653758*^9},ExpressionUUID->"d55899ee-6a1b-49ef-968f-\
53f32c221410"],

Cell[TextData[{
 "We should have that the 4D ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nn"], TraditionalForm]],ExpressionUUID->
  "076d6110-5e49-4ef9-bfd3-8a8d3100009b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "f4b73de4-4399-4ebb-93a1-c0a1460e1654"],
 " are real, while by definition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}]], " ", "=", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["x", "nm"], ")"}], "*"]}], TraditionalForm]],
  ExpressionUUID->"fd50774a-9d0e-44db-a022-74fc29dae0ed"],
 ".\nAt the level of the modes, this means for example that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"m", "+", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["x", "nm", 
        RowBox[{"l", "-", "m"}]], ")"}], "*"], " "}]}], TraditionalForm]],
  ExpressionUUID->"dfa5e666-a0c7-4863-9072-4e96370b217b"],
 ". This formula also holds for the other tetrad components."
}], "Text",
 CellMargins->{{$Failed, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.881676445111261*^9, 3.881676596647101*^9}, 
   3.8833786564175463`*^9, 
   3.883379620435625*^9},ExpressionUUID->"b01ff5a3-df7d-4bd1-b838-\
47e1dd11dbc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "MAKE", " ", "SURE", " ", "THAT", " ", "VALUE", " ", "OF", " ", "M", " ", 
     "AND", " ", "r0", " ", "AGREE", " ", "WITH", " ", "THOSE", " ", "FOR", 
     " ", "WHICH", " ", "THE", " ", "COEFFICIENTS", " ", "of", " ", "the", 
     " ", "stress", " ", "energy", " ", "WERE", " ", "COMPUTED", " ", 
     RowBox[{
      RowBox[{"FOR", "!!"}], "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"aExpTEST", "=", "2"}], ";", " ", 
    RowBox[{"myrTEST", "=", 
     RowBox[{"r0", "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"xmmbTermNoCoeffRule", "[", 
         RowBox[{"myl", ",", "mym", ",", "aExpTEST"}], "]"}], "[", "myrTEST", 
        "]"}], " ", "-", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "mym"}], " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{"xmmbTermNoCoeffRule", "[", 
           RowBox[{"myl", ",", 
