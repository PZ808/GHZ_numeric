Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["h", "uu"], "=", 
   RowBox[{
    SubscriptBox["h", "ab"], 
    SuperscriptBox["u", "a"], 
    SuperscriptBox["u", "b"]}]}], 
  TraditionalForm]],ExpressionUUID->"095ec7aa-ff01-40c4-bf58-e2cbb9953c36"]], \
"Section",
 Evaluatable->False,
 CellChangeTimes->{{3.88589387551539*^9, 3.885893875841318*^9}, {
  3.886153788577382*^9, 
  3.886153803088161*^9}},ExpressionUUID->"3ad3b16a-0ba0-4699-9eec-\
0f28b2b4068c"],

Cell[TextData[{
 "Note that if  we are working with the trace-reversed metric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "ab"], "=", 
    RowBox[{
     SubscriptBox["h", "ab"], "-", 
     RowBox[{
      FractionBox["1", "2"], "h", " ", 
      SubscriptBox["g", "ab"]}]}]}], TraditionalForm]],ExpressionUUID->
  "e54e47ee-dd38-41a4-8832-11191fde241b"],
 ", then to leading order (mostly negative signature): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "ab"], "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", 
         SubscriptBox["Mu", "a"], 
         SubscriptBox["u", "b"]}], "R"], "+"}], "..."}], "."}]}], 
   TraditionalForm]],ExpressionUUID->"ce035f8f-f182-4d13-adac-2fc4974282e8"],
 " (R is 4D distance).\nSo, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "uu"], "=", "  ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"4", "M"}], "R"], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"4609f89f-c988-4eca-9204-7b92a7401ede"],
 ", while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "ab"], "=", "  ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"2", 
        RowBox[{"M", "(", 
         RowBox[{
          SubscriptBox["g", "ab"], "+", 
          RowBox[{"2", 
           SubscriptBox["u", "a"], 
           SubscriptBox["u", "b"]}]}], ")"}]}], "R"], "+"}], "..."}]}], 
   TraditionalForm]],ExpressionUUID->"b41ecaf0-8ca0-4da0-b43f-329626622999"],
 ", so  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "uu"], "=", "  ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"2", "M"}], "R"], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"7df25bf3-ea10-468d-8911-1557d8e61493"],
 ". So, to leading order, there is a factor of 2 difference in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "uu"], TraditionalForm]],ExpressionUUID->
  "9e96a8c8-9c24-446a-9b6b-7cb97225df1c"],
 " between trace-reversed and non-trace-reversed."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.886484310321848*^9, 3.886484371464364*^9}, {
  3.886484482152865*^9, 3.886484483291782*^9}, {3.886484556040395*^9, 
