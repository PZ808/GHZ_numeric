Cell[CellGroupData[{

Cell["Solve coupled ODE system", "Section",
 CellChangeTimes->{{3.875446596836796*^9, 3.8754465985275373`*^9}, {
   3.875447299366548*^9, 3.875447299912943*^9}, {3.8756876007427464`*^9, 
   3.875687610289195*^9}, {3.893320856906191*^9, 3.893320860787057*^9}, {
   3.893337447746389*^9, 3.893337449265718*^9}, 
   3.893496324333762*^9},ExpressionUUID->"3f80abc0-634d-46ee-8b89-\
c022e74eaf70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rmax", "=", 
   RowBox[{"r0", "+", 
    RowBox[{"2", "M"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmin", "=", 
   RowBox[{"r0", "-", 
    RowBox[{"2", "M"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]max", "=", 
   RowBox[{"\[Rho]OfrK", "[", "rmax", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]min", "=", 
   RowBox[{"\[Rho]OfrK", "[", "rmin", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992415656450244*^9, 3.992415678104398*^9}, {
  3.9924159116540937`*^9, 3.992415927768004*^9}},
 CellLabel->
  "In[491]:=",ExpressionUUID->"b8e81e02-d325-418f-b684-d2793889c987"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "52dcc7fb-dc6b-469c-ac51-7dc2fe05267c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nn"], TraditionalForm]],ExpressionUUID->
  "9f4b61cf-c447-4a32-96a4-4ea6431b7503"],
 ", need to solve starting at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "27fde446-17c6-4a7b-9c03-4463a75f95d7"],
 ". For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nm"], TraditionalForm]],ExpressionUUID->
  "24c4d571-f18a-488d-b5c3-61a42b8a3c35"],
 ", need to start at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "16986f94-3232-4329-b181-af68d1bbf28c"],
 ". What we do is, we still solve the equation for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nm"], TraditionalForm]],ExpressionUUID->
  "779a8258-05e9-4682-a348-b234de4abe7a"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "c8e77bca-3e09-4ec6-8fa8-f98bf6bde26f"],
 ", but set everything to zero. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nm"], TraditionalForm]],ExpressionUUID->
  "e172a622-a9a3-45a4-a280-80f6a4c833de"],
 " is then zero, although its value should never matter.\n\nAlso, from usual \
properties of spin weighted harmonics and that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}]], "=", 
    SubsuperscriptBox["x", "nm", "*"]}], TraditionalForm]],ExpressionUUID->
  "e39204fc-8a14-44f9-b67d-558ba62f9caa"],
 ", we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"m", "+", "1"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["x", "nm", 
        RowBox[{"l", "-", "m"}]], ")"}], "*"]}]}], TraditionalForm]],
  ExpressionUUID->"37017679-a6e9-4632-8e9c-06682078f96f"],
 ". Furthermore, checked explicitly that the following holds:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", "ab", 
     RowBox[{"l", "-", "m"}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "l"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["x", "ab", "lm"], ")"}], "*"]}]}], TraditionalForm]],
  ExpressionUUID->"b8672ac2-fda3-4e43-aeb6-30cb7e4dbda9"],
 " (see section \[OpenCurlyDoubleQuote]Check --- Reality conditions\
\[CloseCurlyDoubleQuote] below).\nTherefore, we have the simple relation:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"l", "+", "m", "+", "1"}]], " ", 
     SubsuperscriptBox["x", "nm", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "4570c038-1847-462d-ba7a-ad95ed5d4e82"],
 ", which we use below."
}], "Text",
 CellChangeTimes->{{3.8933962219771433`*^9, 3.8933963706013517`*^9}, {
  3.8933986705032043`*^9, 3.893398875305482*^9}, {3.919415894902791*^9, 
  3.9194159098929358`*^9}},ExpressionUUID->"a4177c48-4a32-42a6-830e-\
46056a15b073"],

