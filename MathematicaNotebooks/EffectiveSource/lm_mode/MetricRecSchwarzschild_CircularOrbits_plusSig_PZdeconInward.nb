Cell[TextData[{
 "For Schwarzschild circular orbits, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    SubscriptBox["m\[CapitalOmega]", "\[CurlyPhi]"]}], TraditionalForm]],
  ExpressionUUID->"87e7a9da-9aa1-46bb-969b-8f4f746b02d2"],
 " and is basically taken into account in TeukolskyPointParticleMode when you \
tell it e=a=0, and give it the orbit and m. ",
 StyleBox["We used the fact that,  ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["A", "\[PlusMinus]"], ")"}], 
     RowBox[{"l", "-", "m"}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "l"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["A", "lm", "\[PlusMinus]"], ")"}], "*"]}]}], 
   TraditionalForm]],ExpressionUUID->"0c2ff1b0-abe9-4d3e-8d3a-0e81149dd867"],
 StyleBox[", which has been checked empirically.",
  FontColor->GrayLevel[0]]
}], "Text",
