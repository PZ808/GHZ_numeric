Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "xnmbAt\[Rho]minViaIntegration", ",", "xnmbpAt\[Rho]minViaIntegration"}], 
   "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "delta", " ", "functions", " ", "are", " ", "the", " ", 
     "only", " ", "thing", " ", "that", " ", "will", " ", "have", " ", 
     "non"}], "-", 
    RowBox[{
    "vanishing", " ", "contribution", " ", "when", " ", "evaluating", " ", 
     SubscriptBox["x", 
      RowBox[{"m", 
       OverscriptBox["m", "_"]}]], " ", "at", " ", 
     RowBox[{
      SubscriptBox["r", "min"], "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xnmbAt\[Rho]minViaIntegration", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"xnmbDistrContributionPieceAtrmax", "[", 
      RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}], "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
