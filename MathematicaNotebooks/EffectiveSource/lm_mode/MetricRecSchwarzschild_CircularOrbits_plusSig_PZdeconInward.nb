Cell[CellGroupData[{

Cell["Metric in shadowless gauge", "Chapter",
 Evaluatable->False,
 CellChangeTimes->{{3.8774994415413094`*^9, 3.877499447030366*^9}, {
  3.993008189095673*^9, 
  3.993008195664044*^9}},ExpressionUUID->"4ad46bb4-4292-4a9d-9213-\
8ffba5cd7318"],

Cell[CellGroupData[{

Cell[TextData[{
 "Modes of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["h", "ab", 
    RowBox[{"N", ",", " ", "shadowless"}]], TraditionalForm]],ExpressionUUID->
  "90f8d060-ca3c-4af5-9329-461e470a30af"]
}], "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8810440875654488`*^9, 3.8810440891191187`*^9}, {
  3.893759420084203*^9, 
  3.893759421482308*^9}},ExpressionUUID->"9fa022a8-1854-4d99-8f0a-\
ea7fdfd5b18e"],

Cell[TextData[StyleBox["Not evaluable.",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.893760000074457*^9, 
  3.893760006659718*^9}},ExpressionUUID->"0a87340f-90b6-4017-bdde-\
e3485ea100c9"],

Cell[TextData[{
 "The full corrected metric reads (see reconstruction paper, eq. (107) p. \
29): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "ab", 
     RowBox[{"N", ",", " ", "Corrected"}]], " ", "=", " ", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox["h", "^"], "ab", "N"], " ", "+", " ", 
     SubscriptBox[
      OverscriptBox["g", 
       OverscriptBox["~", "."]], "ab"], " ", "+", " ", 
     RowBox[{
      SubsuperscriptBox[
       OverscriptBox["h", "~"], "ab", "M"], " ", 
      SubscriptBox["\[CapitalTheta]", "M"]}]}]}], TraditionalForm]],
  ExpressionUUID->"ce6381e7-f71f-4abc-b7a0-76555488bf2d"],
 ", where\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["h", "^"], "ab", "N"], "=", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"Re", "(", 
       RowBox[{
        SubsuperscriptBox["\[ScriptCapitalS]", "ab", "\[Dagger]"], 
        SuperscriptBox["\[CapitalPhi]", "+"]}], ")"}], " ", 
      SubsuperscriptBox["\[CapitalTheta]", "M", "+"]}], " ", "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Re", "(", 
       RowBox[{
        SubsuperscriptBox["\[ScriptCapitalS]", "ab", "\[Dagger]"], 
        SuperscriptBox["\[CapitalPhi]", "-"]}], ")"}], " ", 
      SubsuperscriptBox["\[CapitalTheta]", "M", "-"]}]}]}], TraditionalForm]],
  ExpressionUUID->"79bdb62b-2b08-471f-ad0f-689fba854cdc"],
 "  is the reconstructed field in the vacuum region ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "<", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "dd519729-9574-4d83-bc89-165af8f7bf3d"],
 " (-) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", ">", 
    SubscriptBox["r", "max"]}], TraditionalForm]],ExpressionUUID->
  "06123ecd-d9d9-4e5f-948b-f1582ecfbe7f"],
 " (+),\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["g", 
      OverscriptBox["~", "."]], "ab"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox["g", "."], "ab"], 
      SubsuperscriptBox["\[CapitalTheta]", "M", "+"]}], " ", "-", " ", 
     RowBox[{
      SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
      SubsuperscriptBox["\[CapitalTheta]", "M", "-"]}]}]}], TraditionalForm]],
  ExpressionUUID->"f2650eda-e5ee-41c7-9451-b6bb5241ecd6"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["h", "~"], "ab", "M"], "=", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"Re", "(", 
       RowBox[{
        SubsuperscriptBox["\[ScriptCapitalS]", "ab", "\[Dagger]"], 
        SuperscriptBox["\[CapitalPhi]", "M"]}], ")"}]}], "+", 
     SubsuperscriptBox["x", "ab", "M"], "-", 
     RowBox[{
      SubscriptBox["\[ScriptCapitalL]", 
       SuperscriptBox["\[Xi]", "S"]], 
      SubscriptBox["g", "ab"]}], "-", 
     RowBox[{
      SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
      SubscriptBox["g", "ab"]}]}]}], TraditionalForm]],ExpressionUUID->
  "93e56819-200c-4718-ae83-7fcdaf542972"],
 ".\nNote that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", 
     SuperscriptBox["\[Xi]", "S"]], 
    SubscriptBox["g", "ab"]}], TraditionalForm]],ExpressionUUID->
  "4d48b44f-0f8d-4499-9666-2b1c340424bb"],
 " is zero in Schwarzschild."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.881041947702031*^9, 3.881042600506912*^9}, {
  3.881043068809772*^9, 3.8810430913505383`*^9}, {3.894017063636661*^9, 
  3.894017064599125*^9}},ExpressionUUID->"d40492ff-e8b3-4d47-ba2a-\
bcd763e9d290"]
}, Open  ]],

