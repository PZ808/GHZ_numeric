    "The", " ", "delta", " ", "functions", " ", "are", " ", "the", " ", 
     "only", " ", "thing", " ", "that", " ", "will", " ", "have", " ", 
     "non"}], "-", 
    RowBox[{
    "vanihsing", " ", "contribution", " ", "when", " ", "evaluating", " ", 
     SubscriptBox["x", 
      RowBox[{"m", 
       OverscriptBox["m", "_"]}]], " ", "at", " ", 
     RowBox[{
      SubscriptBox["r", "max"], "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xnmAt\[Rho]maxViaODE", "[", 
   RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"xnm", "[", 
     RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}], " ", "/.", " ", 
   "ruletmp"}]}], "\[IndentingNewLine]", 
 RowBox[{
