Cell[TextData[{
 "Modify them to account for the factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", 
     SuperscriptBox["i\[Omega]r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "da2459d0-2cd1-4b86-b3ef-33babf7107fa"],
 ".\nNote: for the |\[CapitalDelta]r| term, need to be careful. I removed the \
absolute value here to get the right coefficients."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.882260649916333*^9, 3.882260665574707*^9}, {
   3.882262429327866*^9, 3.882262456421886*^9}, 3.8832287453954477`*^9, {
