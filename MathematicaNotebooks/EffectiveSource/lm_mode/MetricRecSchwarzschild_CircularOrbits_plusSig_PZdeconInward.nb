            RowBox[{"\[Psi]ResFrom\[Psi]New", "[", 
             RowBox[{"20", ",", "15"}], "]"}], "[", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "rGrid", "]"}]}], "}"}]}], "]"}]}], ";"}], 
    " ", "//", " ", "Timing"}], "\[IndentingNewLine]", 
