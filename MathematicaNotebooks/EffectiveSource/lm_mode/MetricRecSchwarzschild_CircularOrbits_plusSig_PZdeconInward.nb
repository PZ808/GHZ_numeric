    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"SabTab\[Delta]ppTerm", "[", 
        RowBox[{"2", ",", "l", ",", "m"}], "]"}], "'"}], "[", "r0", 
      "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SabTab\[Delta]ConstTerm", "[", 
    RowBox[{"2", ",", "l_", ",", "m_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SabTab\[Delta]Term", "[", 
      RowBox[{"2", ",", "l", ",", "m"}], "]"}], "[", "r0", "]"}], "-", 
