Cell[TextData[{
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " to correctly run this, you will need to recompute \
\[ScriptCapitalE]hPWorldtubePiece and make sure that the metric is still \
written in the format \[OpenCurlyDoubleQuote]hNullK[a,b]\
\[CloseCurlyDoubleQuote]. Also, make sure that equations are written assuming \
u slicing.\n\nIn section \[OpenCurlyDoubleQuote]Check --- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
     RowBox[{
      SuperscriptBox["h", "Res"], "+", 
      SuperscriptBox["h", "P"], "+", 
      SubscriptBox["x", "ab"]}], ")"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"493eaf24-13ec-4af4-8369-4eb83e9c98f8"],
 "\[CloseCurlyDoubleQuote] checked also that the \[Delta] and \[Delta]\
\[CloseCurlyQuote] pieces vanish."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.882943833502573*^9, 3.88294388020186*^9}, {
