 FormBox[
  SuperscriptBox["h", "R"], 
  TraditionalForm]],ExpressionUUID->"9c3099ca-168f-4661-8f78-cbc0785dfcf4"]], \
"Subsection",
 CellChangeTimes->{{3.887780204052684*^9, 3.887780206956938*^9}, {
  3.8903842847146397`*^9, 3.890384285572658*^9}, {3.89318543715903*^9, 
  3.893185438463554*^9}},ExpressionUUID->"835f6360-4eaf-4cdf-a27c-\
3666b314a367"],

Cell["\<\
Making sure that the length of each list is the same by padding to the right \
the lower spin weighted objects.\
\>", "Text",
 CellChangeTimes->{{3.90316422215495*^9, 
  3.903164250683682*^9}},ExpressionUUID->"6b128e0e-6ab5-43fa-bce4-\
ef73e23c5246"],

