Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "It", " ", "is", " ", "much", " ", "faster", " ", "to", " ", "define", " ",
     "the", " ", "full", " ", "solution", " ", "like", " ", "that", " ", 
