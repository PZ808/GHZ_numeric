Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalPhi]", "+"], "   ", "inward", " ", 
   "integration"}], 
  TraditionalForm]],ExpressionUUID->"355a097e-67e1-4358-8138-fd150f23d8cb"]], \
"Section",
 CellChangeTimes->{{3.992076524827373*^9, 3.992076537639977*^9}, {
  3.9921429464072227`*^9, 3.992142949682518*^9}, {3.9925096119036407`*^9, 
  3.9925096150455637`*^9}, {3.992509676711035*^9, 
  3.992509676711117*^9}},ExpressionUUID->"f13c3ed8-e1a5-4349-bd70-\
380349b3f489"],

Cell["\<\
Construct the outer (+) Hertz - potential solution by imposing asymptotic \
boundary data at a large but finite radius .
The retarded Weyl scalar mode \[Psi]Ret[l, m][r] is assumed to be available \
only on a finite numerical domain, e . g . up to rDataMax .
Rather than imposing artificial zero boundary conditions at a sequence of \
increasingly large radii, 
we fit the large - r behaviour of \[Psi]Ret to a peeling expansion \
\[Psi]Ret[l, m] (r)~Sum[a_q r^(-q), q >= 5] .
Since in the outgoing - coordinate convention D = \[PartialD]_r the radial \
inversion relation is \[PartialD]_r^4\\bar\[CapitalPsi][l, m] (r) = 2 (-1)^m \
\[Psi]Ret[l, m] (r), 
the fitted \[Psi]Ret tail can be integrated analytically four times to obtain \
asymptotic values for\\bar\[CapitalPsi] and its first three r - derivatives \
at a finite matching radius rBoundary inside the numerical domain . The ODE \
is then solved inward from rBoundary down to the requested radius rEval, \
typically rmax . 
This avoids evaluating \[Psi]Ret outside its numerical domain and replaces \
the slow - converging finite - radius zero conditions with asymptotically \
consistent boundary data . 
   
   Main routines : 
   -FitPsi0RetTail[l, m, ...] Fits \[Psi]Ret[l, m] on the specified large - r \
interval to a power - law tail.
  - PsiBarTailDerivsFromFit[fit, k, r] Returns the kth r - derivative of the \
analytically integrated Hertz potential tail at radius r .
    
- PsiBarPlusSolveOne[l, m, rEval, ...] Solves \[PartialD]_r^4\\bar\
\[CapitalPsi] = 2 (-1)^m \[Psi]Ret inward from rBoundary to rEval .
- PsiBarPlusBoundaryData[l, m, rEval, ...] Returns\\bar\[CapitalPsi], \\bar\
\[CapitalPsi]', \\bar\[CapitalPsi]'', and\\bar\[CapitalPsi]''' at rEval for \
one mode . 
-PsiBarPlusBoundaryDataAll[rEval, lmax, ...] Computes the same boundary data \
for all modes 2 <= l <= lmax and - l <= m <= l . I

mportant consistency checks : 
-rEval < rBoundary < rFitMax <= rDataMax . 
-The fitted residual \[Psi]Ret - \[Psi]RetTail should be small on the fit \
interval . 
-If \[Psi]Ret still contains an oscillatory phase at large r, first \
demodulate by the appropriate exp (\[PlusMinus]i \[Omega] r_*) factor before \
fitting the power tail .\
\>", "Text",
 CellChangeTimes->{{3.992510116568512*^9, 
  3.992510229395028*^9}},ExpressionUUID->"b58745fa-279b-4591-8050-\
54b7847cd145"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.992507151771654*^9, 3.992507151775256*^9}, {
   3.9925073192275457`*^9, 3.992507352172392*^9}, {3.992507477281434*^9, 
   3.992507496212513*^9}, {3.9925075494750013`*^9, 3.992507554146352*^9}, 
   3.992510893153914*^9},
 CellLabel->
  "In[617]:=",ExpressionUUID->"b336bb9e-64db-4709-9c0e-5922cb72fcdb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "fit\[Psi]0Tail", ",", "PhiTailFromPsi0Fit", ",", 
    "PhiPlusSolveAsymptotic"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"fit", " ", 
    RowBox[{
     RowBox[{"\[Psi]0Ret", "[", 
      RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", "to", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "j"], 
     RowBox[{
      SubscriptBox["a", "j"], 
      SuperscriptBox["r", 
       RowBox[{"-", 
        SubscriptBox["q", "j"], " "}]]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fit\[Psi]0Tail", "[", 
    RowBox[{"l_", ",", "m_", ",", "rFitMin_", ",", "rFitMax_", ",", 
     RowBox[{"nFit_", ":", "8"}], ",", 
     RowBox[{"nPts_", ":", "200"}], ",", 
     RowBox[{"p_", ":", "5"}], ",", 
     RowBox[{"wp_", ":", "50"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rs", ",", "qs", ",", "mat", ",", "y", ",", "coeffs"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rs", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{"rFitMin", ",", "rFitMax", ",", 
           RowBox[{"nPts", "-", "1"}]}], "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qs", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"p", ",", 
         RowBox[{"p", "+", "nFit"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mat", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"-", "q"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "rs", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "qs"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]Ret", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "/@", "rs"}], ",", "wp"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"coeffs", "=", 
       RowBox[{"LeastSquares", "[", 
        RowBox[{"mat", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<p\>\"", "->", "p"}], ",", 
        RowBox[{"\"\<nFit\>\"", "->", "nFit"}], ",", 
        RowBox[{"\"\<qs\>\"", "->", "qs"}], ",", 
        RowBox[{"\"\<coeffs\>\"", "->", "coeffs"}], ",", 
        RowBox[{"\"\<Psi0Tail\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "rr", "}"}], ",", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", "j", "]"}], "]"}], " ", 
              RowBox[{"rr", "^", 
               RowBox[{"(", 
                RowBox[{"-", 
                 RowBox[{"qs", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "qs", "]"}]}], "}"}]}], "]"}]}], 
          "]"}]}]}], "|>"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhiTailFromPsi0Fit", "[", 
   RowBox[{"l_", ",", "m_", ",", "fit_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qs", ",", "a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"qs", "=", 
      RowBox[{"fit", "[", "\"\<qs\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"fit", "[", "\"\<coeffs\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "/", 
          RowBox[{"Pochhammer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"qs", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "-", "4"}], ",", "4"}], 
           "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "qs", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Function", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "rr", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "[", 
