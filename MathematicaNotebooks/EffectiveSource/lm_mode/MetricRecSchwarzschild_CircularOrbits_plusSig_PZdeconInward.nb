Cell[TextData[{
 "Need to add the extra factor of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"im", " ", "\[CapitalOmega]\[CurlyPhi]", " ", 
     SuperscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "ebd2d4e9-386c-47e0-a247-ce4b5827c35b"],
 " so that we get the expression in (u,r,\[Theta],\[CurlyPhi]) coordinates."
}], "Text",
 CellChangeTimes->{{3.872921293823042*^9, 3.8729213675225897`*^9}, {
   3.872927687887518*^9, 3.872927735186803*^9}, 3.872929645974719*^9, {
   3.875640553108601*^9, 3.875640579159296*^9}, {3.875697463795042*^9, 
   3.875697463795088*^9}, {3.875787425749255*^9, 
   3.875787425749312*^9}},ExpressionUUID->"641916c8-c630-4503-a10c-\
1ff5b605613a"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "ExpI\[Omega]rstar", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExpI\[Omega]rstar", "[", "m_", "]"}], "[", "r_", "]"}], " ", "=",
    " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", 
     RowBox[{"\[Omega]m", "[", "m", "]"}], " ", 
     RowBox[{"rstar", "[", "r", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.875640130863244*^9, 3.8756401483157883`*^9}, {
