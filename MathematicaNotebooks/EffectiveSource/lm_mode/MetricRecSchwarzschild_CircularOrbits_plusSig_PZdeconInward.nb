Cell[TextData[{
 "The Lie derivative in the direction of \[CapitalXi] of a rank (0,2) tensor \
is:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
     SubscriptBox["g", "ab"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalXi]", "c"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "c"], " ", 
       SubscriptBox["g", "ab"]}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["g", "cb"], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "a"], " ", 
       SuperscriptBox["\[CapitalXi]", "c"]}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["g", "ac"], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "b"], " ", 
       SuperscriptBox["\[CapitalXi]", "c"]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"62eb0f09-7a32-412b-b482-b2729e99b270"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.877402461749173*^9, 
