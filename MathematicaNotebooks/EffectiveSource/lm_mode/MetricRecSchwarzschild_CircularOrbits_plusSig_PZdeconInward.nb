Cell[CellGroupData[{

Cell["Retarded field", "Subsection",
 CellChangeTimes->{{3.886763479133566*^9, 
  3.8867634866943817`*^9}},ExpressionUUID->"6fccfeb4-62d1-49b5-9242-\
86138d715d9d"],

Cell[TextData[{
 "Checked for (l,m)=(2,1),(2,2),(3,1),(3,2) the formula for retarded \
potential agrees with Barry\[CloseCurlyQuote]s Hertz potential, Max error was \
~ 10^-(10) with wp=40.\nNote: as stated before, our Hertz potential differs \
from Barry\[CloseCurlyQuote]s Hertz potential by a factor of 2. (Need to add \
factor of 2 to our Hertz potential to agree with Barry\[CloseCurlyQuote]s).\n\
\nFrom Table I page 8 in ",
 ButtonBox["arXiv:1004.2276",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1004.2276.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1004.2276.pdf"],
 ", note that in IRG, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "7f788c16-0817-448a-a24b-9c450581f607"],
 " falls off as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "r"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalPhi]", "~", "r"}], "^", "3"}], " ", "."}]}], 
   TraditionalForm]],ExpressionUUID->"75e5d05d-4a42-47e4-8cc9-c27dff7acf0e"]
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.879849137461958*^9, 3.879849286514213*^9}, {
   3.879849344385199*^9, 3.87984934454985*^9}, {3.879849385325307*^9, 
