Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]Exact\[CloseCurlyDoubleQuote] puncture", \
"Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.890974678739891*^9, 
  3.890974704436591*^9}},ExpressionUUID->"b0e68051-6f44-4db9-ab1d-\
2b4762fea5bd"],

Cell[TextData[{
 "Same as above, but using the \[OpenCurlyDoubleQuote]exact\
\[CloseCurlyDoubleQuote] puncture.\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "R"], TraditionalForm]],ExpressionUUID->
  "96e7803b-0fac-4065-b66d-a0b6796782c7"],
 " converges even away from particle."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.8840678528703127`*^9, 3.8840678852158413`*^9}, {
  3.884067917476613*^9, 
  3.884067917595574*^9}},ExpressionUUID->"0cbc3884-046e-4a47-bce1-\
3f6ece8f23c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Of", " ", "course", " ", "get", " ", "exact", " ", "same", " ", "results",
     " ", "at", " ", "the", " ", "particle", " ", "by", " ", "definition"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]0Data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]0RSmoothPiece", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "r0", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}], " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"Abs", "@", "\[Psi]0Data"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "600"], 
         SuperscriptBox["l", 
          RowBox[{"-", "2"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], 
   " "}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8823517824154587`*^9, 3.8823517886405363`*^9}, {
