 Evaluatable->False,
 CellChangeTimes->{{3.893183600973741*^9, 
  3.8931836124789133`*^9}},ExpressionUUID->"7f8e5920-0ced-476d-885d-\
b567ebc3d1cb"],

Cell[TextData[{
 "Note: For the components along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "a"], TraditionalForm]],ExpressionUUID->
  "dd4b0bf4-d9c5-4c07-b5b4-a83e01e00513"],
 ", checked that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["l", "a"], 
     RowBox[{
      SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
      SuperscriptBox["h", "Res"], ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"ceaf4803-4ded-4e09-9ecf-9caf79301296"],
 " and it is the corrector tensor that takes care of the effective stress \
energy by itself, as it should by construction.\n\nWe find a problem near ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "adb8db79-242a-4ca4-8890-7db1bb6587fe"],
 " for some components, but this is a numerical artifact from differentiating \
interpolated functions."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.893184367684964*^9, 3.8931844648297577`*^9}, {
   3.898849280613723*^9, 3.8988492911643553`*^9}, 3.898849375057225*^9, {
