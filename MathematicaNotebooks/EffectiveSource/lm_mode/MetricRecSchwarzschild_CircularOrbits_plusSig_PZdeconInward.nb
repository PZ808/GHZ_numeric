          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"2", " ", 
               RowBox[{"M", "/", "r"}]}]}], ")"}], "/", "2"}], "]"}], " ", 
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]lm", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}]}], "]"}]}]}], 
     " ", "/.", " ", "\[IndentingNewLine]", "\t\t\t\t\t", 
     RowBox[{
      RowBox[{"h\[ScriptCapitalP]lmb", "[", 
       RowBox[{"l", ",", "m"}], "]"}], " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "r", "}"}], ",", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", " ", 
              RowBox[{"M", "/", "r"}]}]}], ")"}], "/", "2"}], "]"}], " ", 
         RowBox[{
          RowBox[{"h\[ScriptCapitalP]lmb", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}]}], "]"}]}]}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Kinnersley", " ", "tetrad"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diff", " ", "=", " ", 
   RowBox[{"BarryGllExpr", " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalE]hPSmoothPiece", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "BarryGllExpr", "]"}]}], "Input",
