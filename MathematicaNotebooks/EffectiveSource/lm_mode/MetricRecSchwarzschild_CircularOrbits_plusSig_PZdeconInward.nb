           RowBox[{"-", "2"}], "+", "l", "+", 
           SuperscriptBox["l", "2"], "-", 
           RowBox[{
           "4", " ", "\[ImaginaryI]", " ", "m", " ", "r", " ", 
            "\[CapitalOmega]\[CurlyPhi]"}]}], ")"}], " ", 
         RowBox[{"F", "[", "r", "]"}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "6"}], " ", "M"}], "+", 
         RowBox[{"4", " ", "r"}], "+", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "m", " ", 
          SuperscriptBox["r", "2"], " ", "\[CapitalOmega]\[CurlyPhi]"}]}], 
        ")"}], " ", 
       RowBox[{
        SuperscriptBox["F", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", 
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{
