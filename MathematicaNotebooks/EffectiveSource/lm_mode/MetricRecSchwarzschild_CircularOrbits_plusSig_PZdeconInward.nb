Cell["Power-series expanded puncture", "Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.8909746589720182`*^9, 
  3.890974664596485*^9}},ExpressionUUID->"acce252b-ebd9-4f87-a822-\
3133b6275afa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Residual", " ", "field", " ", "using", " ", "power"}], "-", 
    RowBox[{
    "series", " ", "expanded", " ", "puncture", " ", "converges", " ", "at", " ", 
     RowBox[{"particle", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"A", ",", "b", ",", "\[Psi]0Data"}], "]"}], "\[LineSeparator]", 
   RowBox[{
    RowBox[{"\[Psi]0Data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]0RSmoothPiece", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "r0", "]"}], 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"Abs", "@", "\[Psi]0Data"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "500"], 
         SuperscriptBox["l", 
          RowBox[{"-", "2"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], 
   " "}]}]], "Input",
 CellChangeTimes->{{3.8823517824154587`*^9, 3.8823517886405363`*^9}, {
   3.8823537732856407`*^9, 3.882353780903873*^9}, {3.882605854172512*^9, 
