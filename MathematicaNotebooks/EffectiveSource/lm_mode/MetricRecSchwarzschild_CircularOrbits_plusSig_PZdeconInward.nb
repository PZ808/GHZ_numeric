3e4efc708bb0"],

Cell[CellGroupData[{

Cell["Effective source", "Section",
 CellChangeTimes->{{3.919405211983712*^9, 
  3.919405214079721*^9}},ExpressionUUID->"7e514d3f-3ee8-4b9e-9935-\
758aa9300285"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   OverscriptBox["M", "."], TraditionalForm]], "Subsection",ExpressionUUID->
  "8fb8740c-0509-45bb-b38c-3b045a72a4c5"],
 " using effective source"
}], "Subsection",
 CellChangeTimes->{{3.919325471536537*^9, 
  3.9193254996957693`*^9}},ExpressionUUID->"41a68cdb-25fc-4f97-b373-\
497cc42d8e2b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["M", "."], " ", "=", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"8", " ", "\[Pi]"}]], " ", 
     RowBox[{
      SubscriptBox["\[Integral]", 
       SubscriptBox["\[CapitalSigma]", "t"]], " ", 
      RowBox[{
       SubsuperscriptBox["T", "ab", "R"], " ", 
       SuperscriptBox["t", "a"], " ", 
       SuperscriptBox["d\[CapitalSigma]", "b"]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"65bab71c-6a07-4036-85d8-ebd9d0f3281d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["d\[CapitalSigma]", "b"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["f", 
      RowBox[{"-", "1"}]], 
     SuperscriptBox["r", "2"], " ", 
     SuperscriptBox["t", 
      RowBox[{"b", " "}]], "sin", " ", "\[Theta]", " ", "d", " ", "\[Theta]", 
     " ", "d", " ", "\[Phi]"}]}], TraditionalForm]],ExpressionUUID->
  "af13c181-0b2d-4539-ac43-0a0b40751ca7"],
 ". Can check that: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "tt"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["f", "2"], "4"], " ", 
      SubscriptBox["T", "ll"]}], " ", "+", " ", 
     SubscriptBox["T", "nn"], " ", "+", " ", 
     RowBox[{"f", " ", 
      SubscriptBox["T", "ln"]}]}]}], TraditionalForm]],ExpressionUUID->
  "1a6f4222-2d28-461f-96f5-3fa1879dfea1"],
 ". In particular, note ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "tt"], TraditionalForm]],ExpressionUUID->
  "ecf97119-6f07-4ab6-9e21-9e64c6f5448c"],
 " is a spin 0 object and we can write\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "tt"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "lm"], " ", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["T", "tt", "lm"], "(", "r", ")"}], "  ", 
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
       SubscriptBox["Y", "lm"]}], 
      RowBox[{"(", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["im\[CapitalOmega]", "\[Phi]"]}], "t"}]]}]}]}], 
   TraditionalForm]],ExpressionUUID->"f9c2dad3-e443-41c3-b590-fe8fe4fa196c"],
 ". We fix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    SubscriptBox["t", "0"]}], TraditionalForm]],ExpressionUUID->
  "4ef71ceb-4257-4ece-98f4-5acdae0a799a"],
 ", and so\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["M", "."], " ", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"8", "\[Pi]"}]], 
      RowBox[{
       SubscriptBox["\[Sum]", "lm"], 
       RowBox[{
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["im\[CapitalOmega]", "\[Phi]"]}], 
          SubscriptBox["t", "0"]}]], 
        RowBox[{"\[Integral]", 
         RowBox[{"dr", " ", 
          RowBox[{
           SubsuperscriptBox["T", "tt", "lm"], "(", "r", ")"}], " ", 
          SuperscriptBox["f", 
           RowBox[{"-", "1"}]], 
          SuperscriptBox["r", "2"], 
          RowBox[{"\[Integral]", " ", 
           RowBox[{
            RowBox[{
             SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
             SubscriptBox["Y", "lm"]}], 
            RowBox[{"(", 
             RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "sin", " ", 
            "\[Theta]", " ", "d\[Theta]", " ", "d\[Phi]"}]}]}]}]}]}]}], " ", "=",
      " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"8", "\[Pi]", " ", "C"}]], 
      RowBox[{"\[Integral]", 
       RowBox[{"dr", " ", 
        RowBox[{
         SubsuperscriptBox["T", "tt", "00"], "(", "r", ")"}], " ", 
        SuperscriptBox["f", 
         RowBox[{"-", "1"}]], 
        SuperscriptBox["r", "2"]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "1ed28356-ee84-4d07-b050-087a1e212fe4"],
 ", where we used\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Integral]", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
       SubscriptBox["Y", "lm"]}], 
      RowBox[{"(", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "sin", " ", 
      "\[Theta]", " ", "d\[Theta]", " ", "d\[Phi]"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox["1", "C"], 
      RowBox[{"\[Integral]", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
         SubscriptBox["Y", "lm"]}], 
        RowBox[{"(", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
        RowBox[{
         SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
         SubscriptBox["Y", "00"]}], 
        RowBox[{"(", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "sin", " ", 
        "\[Theta]", " ", "d\[Theta]", " ", "d\[Phi]"}]}]}], " ", "=", " ", 
     RowBox[{
      FractionBox["1", "C"], " ", 
      SubsuperscriptBox["\[Delta]", "l", "0"], " ", 
      SubsuperscriptBox["\[Delta]", "m", "0"]}]}]}], TraditionalForm]],
  ExpressionUUID->"479dbbd4-f19a-4835-9bdb-01634684924f"],
 "and C is a constant, here equal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "0"], 
     SubscriptBox["Y", "00"]}], 
    RowBox[{"(", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"7416b5fc-9007-484c-b226-f79c6550eb00"],
 " which is a constant.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubsuperscriptBox["T", "tt", "lm"], "(", "r", ")"}]}], TraditionalForm]],
  ExpressionUUID->"b8e73c89-74bf-477e-9def-e79359d94968"],
 " is made up of a smooth bit and a distributional bit."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.919399346012288*^9, 3.919399405080201*^9}, {
  3.919401528851439*^9, 3.919401768287871*^9}, {3.9194017987058287`*^9, 
  3.9194020375380497`*^9}, {3.919402076693685*^9, 
  3.919402188697941*^9}},ExpressionUUID->"b3ad9369-05c2-42ef-8679-\
c6a6e43eee1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Smooth", " ", "part"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"8", " ", "\[Pi]", " ", 
       RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
        RowBox[{"0", ",", "0", ",", "0", ",", "\[Theta]", ",", "\[Phi]"}], 
        "]"}]}], ")"}]}], " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"r", "^", "2"}], "/", 
        RowBox[{"f", "[", "r", "]"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
