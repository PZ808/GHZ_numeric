 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"xmmbTerm", "[", 
       RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "r_", "]"}], " ", 
     "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xmmbTermNoCoeffRule", "[", 
