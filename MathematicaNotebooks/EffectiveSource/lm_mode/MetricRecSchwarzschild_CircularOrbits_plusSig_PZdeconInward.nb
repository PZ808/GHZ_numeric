Cell[TextData[{
 "When acting on an spin-0 object of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "r", ")"}], 
    RowBox[{"H", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "min"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "feb4eeae-2067-457c-a577-2089fcab07ee"],
 ", we get two terms, one proportional to the Heaviside function and a delta \
function. For the latter, we evaluate the coefficient at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "c65019ac-ee6a-4405-894f-4f141e5b3010"],
 "."
}], "Text",
 CellChangeTimes->{{3.8928915165734987`*^9, 3.892891546318351*^9}, {
  3.892891582750355*^9, 3.892891584781966*^9}, {3.8928916514179077`*^9, 
  3.892891652077832*^9}, {3.8928917391456747`*^9, 
  3.892891783717112*^9}},ExpressionUUID->"31c3c665-194c-4271-9af4-\
71088be4f996"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[ScriptCapitalN]OfFH", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalN]OfFH", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[ScriptCapitalN]NullK", "[", 
      RowBox[{"0", ",", "l"}], "]"}], "[", 
     RowBox[{
      RowBox[{"F", "[", "r", "]"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "//", " ", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{"r", "-", "rmin"}], "]"}], ",", 
         RowBox[{"DiracDelta", "[", 
          RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], 
      "]"}], " ", "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
