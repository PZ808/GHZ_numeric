Cell[CellGroupData[{

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nm"], TraditionalForm]],ExpressionUUID->
  "4880ba11-4544-4321-bccb-f9ed6da570ad"]
}], "Subsection",
 CellChangeTimes->{{3.875679278025872*^9, 3.875679280665263*^9}, {
   3.887696005424199*^9, 3.887696008160141*^9}, {3.893320926750257*^9, 
   3.893320927532695*^9}, {3.8933257640130653`*^9, 3.893325784142599*^9}, 
   3.893496278240869*^9},ExpressionUUID->"296d4692-1a31-4273-9307-\
ff63f259fe1f"],

Cell[TextData[{
 "We have two different kinds of contributions:\n1) one coming from the \
stress energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "lm"], TraditionalForm]],ExpressionUUID->
  "54a36f49-683e-4c3d-8765-a562ed0fc2bc"],
 " (\[Delta] and \[Delta]\[CloseCurlyQuote]).\n2) One coming from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalN]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "acc1233a-bc03-4c98-ba60-1889fee976dd"],
 " (just a \[Delta]). This is because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "600da21c-0cbf-45dc-b04b-777083904540"],
 " carries a Heaviside function around ",
 StyleBox["at ",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0.5, 0, 0.5]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "r"}], "+", 
    SubscriptBox["r", "max"]}], TraditionalForm]],
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0.5, 0, 0.5],ExpressionUUID->
  "671e3462-c856-4b3c-8a51-61b941fc0ba7"],
 "\nSpecifically, we have  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalN]x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SubscriptBox["\[Eth]x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], " ", "+", " ", 
     RowBox[{"#", " ", 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"51343e45-da09-46cd-9a5f-fcddd3fb6349"],
 ".\nSee section on Operators for more details."
}], "Text",
 CellChangeTimes->{{3.877152676663382*^9, 3.877152719234168*^9}, {
  3.877152802644614*^9, 3.877152836297073*^9}, {3.8874453989336853`*^9, 
  3.8874455039666452`*^9}, {3.8874456774420156`*^9, 3.887445689280428*^9}, {
  3.8874461551174192`*^9, 3.887446278958334*^9}, {3.8874473022492123`*^9, 
  3.8874473436256037`*^9}, {3.887696693767502*^9, 3.887696706050632*^9}, {
  3.887696740666079*^9, 3.8876968103450127`*^9}, {3.888311880628512*^9, 
  3.8883119349644117`*^9}, {3.888311974947075*^9, 3.888311976144988*^9}, {
  3.888312156492014*^9, 3.888312156744583*^9}, {3.888312351618609*^9, 
  3.8883124223775587`*^9}, {3.892968743372345*^9, 3.892968744984663*^9}, {
  3.89297616360993*^9, 3.892976172034112*^9}, {3.8988385833937607`*^9, 
  3.898838583393895*^9}, {3.9921466289003572`*^9, 3.992146654353971*^9}, {
  3.9921467745668497`*^9, 3.9921467794411507`*^9}, {3.992412299978737*^9, 
  3.992412349578279*^9}},ExpressionUUID->"b202bba0-7946-4533-8437-\
0cfc526364a3"],

