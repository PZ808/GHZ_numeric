Cell[BoxData[{
 RowBox[{
  RowBox[{"lCU", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"f", "[", "r", "]"}]}], "]"}]}], 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"f", "[", "r", "]"}], ",", "0", ",", "0"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lCD", " ", "=", " ", 
   RowBox[{"gmetDD", ".", "lCU"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nCU", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"f", "[", "r", "]"}]}], "]"}]}], 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", 
       RowBox[{"f", "[", "r", "]"}]}], ",", "0", ",", "0"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nCD", " ", "=", " ", 
   RowBox[{"gmetDD", ".", "nCU"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mCU", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"r", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", 
      RowBox[{"I", "/", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mCD", " ", "=", " ", 
   RowBox[{"gmetDD", ".", "mCU"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mbCU", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"r", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", 
      RowBox[{
       RowBox[{"-", "I"}], "/", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mbCD", " ", "=", " ", 
   RowBox[{"gmetDD", ".", "mbCU"}]}], ";"}]}], "Input",
 Evaluatable->False,
