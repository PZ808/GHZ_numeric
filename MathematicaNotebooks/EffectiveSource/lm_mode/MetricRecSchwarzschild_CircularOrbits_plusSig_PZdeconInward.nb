Cell[TextData[{
 "\nOutward integration:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"+", 
       FractionBox[
        SubsuperscriptBox["\[Rho]", "min", "2"], "3"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         OverscriptBox["\[Eth]", "~"], 
         SuperscriptBox["b", "o"]}], ")"}], "-"]}], " ", "+", 
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", 
         SuperscriptBox["\[Rho]", "4"], 
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Rho]"], 
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["x", "nm"], 
            SuperscriptBox["\[Rho]", "2"]], ")"}]}]}], 
        SubscriptBox["|", 
         RowBox[{"r", "=", 
          SubscriptBox["r", "min"]}]], " ", 
        RowBox[{"+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "min"], " ", "of", " ", 
           SubscriptBox["T", "lm"], " ", "and", " ", 
           SubscriptBox["\[ScriptCapitalN]x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]]}], ")"}]}]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"41fb7d05-2cc4-401c-9be1-ff4c321ab4b0"],
 ".\n",
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " Concerning the distributional contributions, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalN]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "826abb15-93d2-43df-b6b2-2da3ce1a5781"],
 " will actually not contribute, because its coefficient linearly depends on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "d81d2af5-a468-4833-b843-a966234c5025"],
 ", which vanishes for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "1"}], ",", " ", 
    RowBox[{"m", "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "79c5f5ad-ca4e-4ed8-9a0b-81254c67f5bb"],
 "."
}], "Text",
