Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\[Psi]HomogInUp", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"ParallelEvaluate", "[", 
    RowBox[{"$HistoryLength", "=", "0"}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"If", " ", "needed"}], ",", 
    RowBox[{
    "load", " ", "the", " ", "Teukolsky", " ", "package", " ", "on", " ", 
     "all", " ", "subkernels", " ", 
     RowBox[{"too", ".", " ", "\[IndentingNewLine]", "Use"}], " ", "whatever",
      " ", 
     RowBox[{"Needs", "[", "...", "]"}], " ", "you", " ", "used", " ", "in", " ",
      "the", " ", "main", " ", 
     RowBox[{"kernel", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ParallelEvaluate", "[", 
     RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], "]"}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "Weylspin", ",", "aKerr", ",", "\[Omega]m", ",", "rNumInbd", ",", 
     "rNumOutbd", ",", "TeukolskyRadial"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lmaxHomog", "=", "lmax"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sHomog", "=", "Weylspin"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"positiveModeJobs", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", "m"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "sHomog", "]"}], ",", "lmaxHomog"}], "}"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992579037504938*^9, 3.992579037508985*^9}, {
  3.992580599140727*^9, 
  3.992580625781075*^9}},ExpressionUUID->"0d833ae7-89b5-42c4-a291-\
54e6aff54911"],

Cell[BoxData[
 RowBox[{
  RowBox[{"positiveModeResults", "=", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "lm", "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"l", "=", 
               RowBox[{"lm", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"m", "=", 
               RowBox[{"lm", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "sol"}], "}"}], ",", 
            RowBox[{
             RowBox[{"sol", "=", 
              RowBox[{"TeukolskyRadial", "[", 
               RowBox[{"sHomog", ",", "l", ",", "m", ",", "aKerr", ",", 
                RowBox[{"\[Omega]m", "[", "m", "]"}], ",", 
                RowBox[{"Method", "->", 
                 RowBox[{"{", 
                  RowBox[{"\"\<NumericalIntegration\>\"", ",", 
                   RowBox[{"\"\<Domain\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"\<In\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}], ",", 
                    RowBox[{"\"\<Up\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}]}], 
                    "}"}]}]}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"l", ",", "m", ",", "sol"}], "}"}]}]}], "]"}]}], "]"}], 
        ",", "positiveModeJobs", ",", 
        RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], 
      ",", "\"\<Computing positive-m homogeneous Teukolsky modes...\>\""}], 
     "]"}], "//", "AbsoluteTiming"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.992579071361116*^9, 
  3.992579071363695*^9}},ExpressionUUID->"27f0f69a-847c-46ef-b36c-\
8dbd8bac0044"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ll", "=", 
         RowBox[{"res", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"mm", "=", 
         RowBox[{"res", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
