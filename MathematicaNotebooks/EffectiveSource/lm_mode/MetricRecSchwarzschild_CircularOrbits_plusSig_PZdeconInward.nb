Cell[TextData[Cell[BoxData[
 FormBox[
  SubscriptBox[
   OverscriptBox["g", "."], "ab"], 
  TraditionalForm]],ExpressionUUID->"b2531d7c-8a3e-4f83-b21a-d49ec4eaa124"]], \
"Chapter",
 CellChangeTimes->{{3.8728348882727947`*^9, 
