  RowBox[{
   RowBox[{"\[ScriptCapitalV]NullK", "[", 
    RowBox[{
     RowBox[{"F", "[", "r", "]"}], " ", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}], ",", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], "]"}],
     " ", "&"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
