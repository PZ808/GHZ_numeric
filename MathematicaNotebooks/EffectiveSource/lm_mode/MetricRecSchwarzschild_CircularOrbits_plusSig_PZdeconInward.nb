Cell[CellGroupData[{

Cell[TextData[{
 "Analytic (no-string) solution in terms of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", "0", "Ret"], TraditionalForm]],ExpressionUUID->
  "c2d8249a-8d12-489e-ae68-8007642d9fdb"]
}], "Subsection",
 CellChangeTimes->{{3.879248343994113*^9, 3.879248367585693*^9}, {
  3.992667035035987*^9, 3.992667043372705*^9}, {3.9929695636243362`*^9, 
  3.992969568271185*^9}},ExpressionUUID->"27401199-3a51-4e47-a927-\
9e80421e7e5a"],

Cell[TextData[{
 "See eq (52)-(53). Note that here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "m"], 
     SubscriptBox["\[CapitalPhi]", 
      RowBox[{"l", "-", "m"}]]}]}], TraditionalForm]],ExpressionUUID->
  "02d105a0-a7c5-462e-9aa0-bc888525bd8f"],
 "The functional form of these formulae hold independently on whether the \
modes are in terms of  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "i\[Omega]t"}]], TraditionalForm]],ExpressionUUID->
  "da022a5d-d728-4363-a25a-a74e74e725de"],
 " or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "i\[Omega]u"}]], TraditionalForm]],ExpressionUUID->
  "6113dfdc-adda-4c73-9ba4-11a9d637fef1"],
 " (in (52), just multiply each side with the  factor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", 
     SuperscriptBox["i\[Omega]r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "3d42be5a-1daa-4e36-aad6-bec1233d1abc"],
 " and reabsorb it in both definitions of R).\nAgain, need to account sign \
convention difference."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.878971120347747*^9, 3.8789711323155622`*^9}, {
  3.878972512337726*^9, 3.878972564511279*^9}, {3.8789729181065693`*^9, 
