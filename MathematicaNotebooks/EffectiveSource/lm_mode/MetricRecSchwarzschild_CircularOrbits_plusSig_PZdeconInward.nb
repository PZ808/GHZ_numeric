    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox["\[Thorn]", "3"], 
        OverscriptBox["\[CapitalPhi]", "_"]}], "]"}], 
      SubscriptBox["|", 
       SubscriptBox["r", "min"]]}], "=", 
     RowBox[{"2", " ", 
      SuperscriptBox["B", "o"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d5f2f0bd-3e7b-4ad4-a585-bce0d491cea5"],
 ".\nAt the level of the modes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
