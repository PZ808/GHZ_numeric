Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"aCirc2ndTermDistrContributionAtRmaxTMP", "[", 
    RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"rmax", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"rmax", " ", 
          RowBox[{
           RowBox[{"Tll\[Delta]Coeff", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"Tll\[Delta]pCoeff", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}]}]}], ")"}]}], 
      " ", "/.", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Tll\[Delta]Coeff", "[", 
         RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", " ", 
       RowBox[{"Tll\[Delta]RmaxPiece", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], " ", "/.", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Tll\[Delta]pCoeff", "[", 
