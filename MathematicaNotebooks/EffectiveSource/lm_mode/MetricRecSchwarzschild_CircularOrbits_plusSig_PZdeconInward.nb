Cell[CellGroupData[{

Cell["Theory", "Subsection",
 CellChangeTimes->{{3.8963519962631493`*^9, 
  3.8963519994950857`*^9}},ExpressionUUID->"81d7ae32-a9db-46b8-9efa-\
815ecffe83d1"],

Cell[TextData[{
 "The Teukolsky equation is given by: (see, e.g. (84) in review paper): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[CapitalDelta]", 
         RowBox[{"-", "s"}]], 
        FractionBox["d", "dr"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]", 
           RowBox[{"s", "+", "1"}]], 
          FractionBox["d", "dr"]}], ")"}]}], "+", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{
          SuperscriptBox["K", "2"], "-", 
          RowBox[{"2", 
           RowBox[{"is", "(", 
            RowBox[{"r", "-", "M"}], ")"}], "K"}]}]}], "\[CapitalDelta]"], 
       "+", 
       RowBox[{"4", "is\[Omega]r"}], "-", "\[Lambda]"}], "}"}], " ", 
     SubscriptBox["\[Psi]", "lm"]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["S", "ab"], 
     SubscriptBox["T", "ab"]}]}], TraditionalForm]],ExpressionUUID->
  "a6984ac2-93b8-4bb5-989d-8cf8c6346859"],
 ".\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        SuperscriptBox["a", "2"]}], ")"}], "\[Omega]"}], "-", 
     RowBox[{"a", " ", "m"}]}]}], TraditionalForm]],ExpressionUUID->
  "860efe15-c8fb-4b11-b6ff-6a54baa3b419"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", ":=", 
    RowBox[{
     SuperscriptBox["r", "2"], "-", 
     RowBox[{"2", " ", "M", " ", "r"}], "+", 
     SuperscriptBox["a", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "66ef031f-989b-4fef-b32f-fb300778644f"],
 ". In Schwarzschild, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{
     RowBox[{"l", "(", 
      RowBox[{"l", "+", "1"}], ")"}], "-", 
     RowBox[{"s", "(", 
      RowBox[{"s", "+", "1"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "dadd5828-2057-4fd5-8270-67cc861598cb"],
 ".\n\nWe first use the Teukolsky toolkit to solve for the two homogeneous \
solutions with ingoing/outgoing boundary conditions at the black-hole \
horizon/null infinity, called the \[OpenCurlyDoubleQuote]in\
\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] solutions. Then, we compute \
the inhomogeneous solution via variation of parameters method. Because RHS is \
only made up of \[Delta]-functions (and their first and second derivatives), \
can find an analytical expression of the inhomogeneous solution in terms of \
homogeneous solutions.\nLook at section 4.1.7 in review paper for more \
details."
}], "Text",
 CellChangeTimes->{{3.896352010227569*^9, 3.896352117408772*^9}, {
  3.896352147570059*^9, 3.896352262331336*^9}, {3.8963522947773943`*^9, 
  3.896352398758497*^9}},ExpressionUUID->"af86f70d-08f9-4a9e-a72a-\
a910be228330"]
}, Closed]],

