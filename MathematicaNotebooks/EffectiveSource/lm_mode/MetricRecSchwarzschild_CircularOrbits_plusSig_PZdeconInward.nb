   RowBox[{
    RowBox[{"hPLorenz", "[", "1", "]"}], "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox["2"], " ", 
