Cell[CellGroupData[{

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "2526c67f-7799-4380-bfb3-a64c6763ae83"]
}], "Subsection",
 CellChangeTimes->{{3.875679278025872*^9, 3.875679280665263*^9}, {
   3.887696005424199*^9, 3.887696008160141*^9}, {3.8933235147495317`*^9, 
   3.8933235169686813`*^9}, {3.8933257654549*^9, 3.893325792064292*^9}, 
   3.893496281279667*^9},ExpressionUUID->"750e0ae8-9365-4560-8bcb-\
9dbee148ff88"],

Cell[TextData[{
 StyleBox["Not evaluable.",
  FontColor->RGBColor[1, 0, 0]],
 "\nNeeded before because we would solve the ODE for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "477b931c-611e-4773-81de-620736e36b13"],
 ". Still keeping it for posterity."
}], "Text",
 CellChangeTimes->{{3.893399010876135*^9, 
  3.893399086322833*^9}},ExpressionUUID->"7e6ab159-6ef4-41ca-8f6f-\
be8383685e99"],

Cell[TextData[{
 "We have two different kinds of contributions:\n1) one coming from the \
stress energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "lm"], TraditionalForm]],ExpressionUUID->
  "5373b2a3-a58e-4029-bf85-3434f708a5da"],
 " (\[Delta] and \[Delta]\[CloseCurlyQuote]).\n2) One coming from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[ScriptCapitalN]", "_"], 
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]]}], TraditionalForm]],ExpressionUUID->
  "0191c31b-8e45-4c50-933a-334177ecfaac"],
 " (just a \[Delta]). This is because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "0735f59e-1bab-4577-aec5-ee66fba7cd45"],
 " carries a Heaviside function \nSpecifically, we have  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[ScriptCapitalN]", "_"], 
     SubscriptBox["x", 
      RowBox[{"m", 
       OverscriptBox["m", "_"]}]]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"\[Eth]", "'"}], 
      SubscriptBox["x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}], " ", "+", " ", 
     RowBox[{"#", " ", 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"bbb6536f-f8d9-4431-ba7a-ae7eaa5f6425"],
 ".\n"
}], "Text",
 CellChangeTimes->{{3.877152676663382*^9, 3.877152719234168*^9}, {
   3.877152802644614*^9, 3.877152836297073*^9}, {3.8874453989336853`*^9, 
   3.8874455039666452`*^9}, {3.8874456774420156`*^9, 3.887445689280428*^9}, {
