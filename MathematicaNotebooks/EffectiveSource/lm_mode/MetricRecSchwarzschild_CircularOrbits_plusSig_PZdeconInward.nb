   RowBox[{"SabTab\[Delta]pConstTerm", "[", 
    RowBox[{"2", ",", "l_", ",", "m_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SabTab\[Delta]pTerm", "[", 
