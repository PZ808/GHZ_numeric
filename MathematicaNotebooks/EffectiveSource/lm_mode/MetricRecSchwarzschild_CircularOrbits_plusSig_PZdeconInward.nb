   3.893781418622094*^9, 3.8937814515925713`*^9}, {3.894430945618256*^9, 
   3.894430948505207*^9}, 3.8987618720944433`*^9, {3.91872705002104*^9, 
   3.9187270523372393`*^9}},ExpressionUUID->"a7527b91-0e93-4581-a7f9-\
6dd0374767f3"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "myWronskian", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
