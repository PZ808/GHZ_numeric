Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "branchDerivativeErrorReport", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"branchDerivativeErrorReport", "[", 
    RowBox[{"original_", ",", "portable_Association", ",", "branch_String", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ra_", "?", "NumericQ"}], ",", 
       RowBox[{"rb_", "?", "NumericQ"}]}], "}"}], ",", 
     RowBox[{"nTest_Integer", ":", "300"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "testGrid", ",", "referenceValues", ",", "portableValues", ",", 
       "errors", ",", "referenceScale"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Midpoints", " ", "avoid", " ", "simply", " ", "retesting", " ", 
       "interpolation", " ", "nodes"}], "*)"}], 
     RowBox[{
      RowBox[{"testGrid", "=", 
       RowBox[{"MovingAverage", "[", 
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"N", "[", "ra", "]"}], ",", 
           RowBox[{"N", "[", "rb", "]"}], ",", "nTest"}], "]"}], ",", "2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Association", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"referenceValues", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "k", "]"}], "[", 
               RowBox[{"original", "[", "branch", "]"}], "]"}], "[", "rr", 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rr", ",", "testGrid"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"portableValues", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "k", "]"}], "[", 
               RowBox[{"portable", "[", "branch", "]"}], "]"}], "[", "rr", 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rr", ",", "testGrid"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"errors", "=", 
           RowBox[{"portableValues", "-", "referenceValues"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"referenceScale", "=", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "100"}]}], ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", "referenceValues", "]"}], "]"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"k", "->", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<MaxAbsoluteError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", "errors", "]"}], "]"}]}], ",", 
             RowBox[{"\"\<RelativeToGlobalScale\>\"", "->", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", "errors", "]"}], "]"}], "/", 
               "referenceScale"}]}]}], "|>"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.994566748886586*^9, 3.99456674888873*^9}, 
   3.994566903940382*^9},
 CellLabel->
  "In[2537]:=",ExpressionUUID->"377faee1-ccb6-48ce-92ae-616bec5b8fc3"]
