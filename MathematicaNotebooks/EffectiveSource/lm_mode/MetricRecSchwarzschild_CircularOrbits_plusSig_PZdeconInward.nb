Cell[TextData[{
 "Compare large l behaviour of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "7fc6851d-6df8-450f-87d2-10ad8b327b6e"],
 " with its leading large l term.\nLarge difference is likely a consequence \
of the fact that large l behaviour of the metric perturbations and its \
derivatives are not the same."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.891669099142218*^9, 
  3.891669245895508*^9}},ExpressionUUID->"edca58ca-6e02-4f49-a09b-\
43095035d24a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hPData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["l", "2"], " "}], 
           RowBox[{"2", " ", 
            SuperscriptBox["rmin", "2"]}]], " ", 
          RowBox[{
           RowBox[{"hPllLeft", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", 
    RowBox[{"Abs", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"TllLeftInterpol", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"0", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", "lmax"}], "}"}]}], "]"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Abs", "@", "hPData"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.891422201661373*^9, 3.891422268656632*^9}, {
