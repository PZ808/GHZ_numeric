Cell[CellGroupData[{

Cell["Check with point-particle source", "Section",
 Evaluatable->False,
 CellChangeTimes->{
  3.879844604131274*^9, {3.8798446588151484`*^9, 3.879844659126225*^9}, {
   3.885459988034794*^9, 
   3.885459989465703*^9}},ExpressionUUID->"d8fdb389-ae01-4a95-ba84-\
eefe09c13a24"],

Cell[CellGroupData[{

Cell["Theory", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.88216713000215*^9, 
  3.882167132303095*^9}},ExpressionUUID->"85524bfe-b574-493b-9aa3-\
73fb405e9eab"],

Cell[TextData[{
 "See arXiv:1503.02414, below eq. (25). Compare also (31)-(32) with \
(24)-(25).\nThere is a typo and it should read: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Xi]", "\[Mu]"], "=", " ", 
     RowBox[{"\[Mu]", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          OverscriptBox["\[CapitalEpsilon]", "^"], 
          RowBox[{
           SubscriptBox["r", "0"], 
           SubscriptBox["f", "0"]}]], " ", 
         SuperscriptBox["t", "\[Mu]"]}], " ", "+", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"2", " ", 
           SubscriptBox["L", "z"]}], 
          SubsuperscriptBox["r", "0", "3"]], 
         SuperscriptBox["\[Phi]", "\[Mu]"]}]}], ")"}], " ", 
      RowBox[{"\[CapitalTheta]", "(", 
       RowBox[{
        SubscriptBox["r", "0"], "-", "r"}], ")"}]}]}], ","}], 
   TraditionalForm]],ExpressionUUID->"8fb1c2b5-b152-4156-869c-ef2941cf264e"],
 " where \[Mu] is particle mass, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["E", "^"], " ", "=", 
     FractionBox[
      RowBox[{" ", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", "M"}], 
         SubscriptBox["r", "0"]]}]}], 
      SqrtBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", "M"}], 
         SubscriptBox["r", "0"]]}]]]}], ",", " ", 
    RowBox[{
     SubscriptBox["L", "z"], " ", "=", 
     SqrtBox[
      FractionBox[
       SubscriptBox["Mr", "0"], 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", "M"}], 
         SubscriptBox["r", "0"]]}]]], " "}]}], TraditionalForm]],
  ExpressionUUID->"adcde37e-d846-4891-afbf-19727edeea96"]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.879844111732706*^9, 3.879844389511216*^9}, 
   3.8798444874577427`*^9, 3.8833786565038*^9, 
   3.884611386981711*^9},ExpressionUUID->"99fb625a-8edf-45ef-b20f-\
760f2a3b96ee"],

Cell[TextData[{
 "First, can check this by computing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], ",", " ", 
    RowBox[{
     SuperscriptBox["b", "o"], " ", "and", " ", 
     SuperscriptBox["c", "o"]}]}], TraditionalForm]],ExpressionUUID->
  "5f129bad-0bf7-4bd4-8618-67d9921e31f6"],
 " for a point particle-source: reconstruction paper, H.20. Note that the \
final answer should not depend on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "f97100ae-fa8f-4741-a325-e0eca2d9363a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "01dcf704-0b59-4d61-8181-e452be43fe24"],
 "!\nUse that: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "ab"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["f", "ab"], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "0"]}], ")"}], " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"cb5465e3-0c98-4c58-8021-b77b0cdc11f2"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "ab"], " ", ":=", " ", 
    RowBox[{"8", "\[Pi]", 
     FractionBox[
      RowBox[{
       SubscriptBox["u", "a"], 
       SubscriptBox["u", "b"]}], 
      RowBox[{
       SubsuperscriptBox["r", "0", "2"], 
       SuperscriptBox["u", "t"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "95236291-9f41-408e-ab25-c3088fb2760d"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], "=", 
    RowBox[{
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Theta]", "-", 
       RowBox[{"\[Pi]", "/", "2"}]}], ")"}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Phi]", "-", "\[Omega]t"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"42351d6e-88f1-4b22-8e66-3d1dda8b4fec"],
 ". (8\[Pi] is included in the definition of the stress energy in the \
papers).\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Rho]", "0", "2"], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Rho]", "-", 
       SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"5aba956d-7eb1-46c1-ac56-a8e46e318b0e"],
 ", and from (C.3): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"l", ",", "m"}]], " "}], "s"], 
     SubscriptBox[
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["Y", "_"], "lm"], "(", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}], " "}], "s"], 
     
     RowBox[{
      SubscriptBox["Y", "lm"], "(", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"79bfb91f-717c-43b4-9d23-81b6ec9ac6b3"],
 ".\n\t\t\nFirst term for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "d2e94336-b03a-46ae-ba1f-2c49cc126962"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["f", "ll"], 
     RowBox[{"2", " ", 
      SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Rho]", "max"], "-", 
      SubscriptBox["\[Rho]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"781da94b-bed9-4fd2-be6e-219034f6cc53"],
 ".  (Do take care that integrating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "(", 
    RowBox[{
     SubscriptBox["\[Rho]", "1"], "-", 
     SubscriptBox["\[Rho]", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "3e53d106-e01a-4b73-8f64-0990ca9325cd"],
 " will give you Heaviside functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "(", 
    RowBox[{
     SubscriptBox["\[Rho]", "2"], "-", 
     SubscriptBox["\[Rho]", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "9ee4dfc9-58dc-4785-85e9-86e14261792e"],
 "). E.g.:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[Rho]", "min"], 
       SubscriptBox["\[Rho]", "2"]], 
      RowBox[{
       SubscriptBox["d\[Rho]", "1"], " ", 
       SubsuperscriptBox["\[Rho]", "1", 
        RowBox[{"-", "4"}]]}]}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{
       SubscriptBox["r", "1"], "-", 
       SubscriptBox["r", "0"]}], ")"}]}], "=", "  ", 
    RowBox[{
     SubsuperscriptBox["\[Rho]", "0", 
      RowBox[{"-", "2"}]], 
     RowBox[{
      RowBox[{"H", "(", 
       RowBox[{
        SubscriptBox["\[Rho]", "2"], "-", 
        SubscriptBox["\[Rho]", "0"]}], ")"}], " ", "."}]}]}], 
   TraditionalForm]],ExpressionUUID->"7c104efd-d8ed-4c52-a974-fae48ca5f31d"],
 "\nSecond term gives: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    SubscriptBox["\[Rho]", "max"]}], TraditionalForm]],ExpressionUUID->
  "7ea25d77-f61e-4003-8d37-4e9a517e1eb4"],
 ".\nAdding both terms together, the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "max"], TraditionalForm]],ExpressionUUID->
  "a5f17416-30c6-4045-9d25-8778c735fd07"],
 " cancel and we get:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Rho]", "0"]}]]}], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"05a9b936-069d-4c9f-98f1-99929af39136"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"->", "    ", 
     SubsuperscriptBox["a", "lm", "o"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Rho]", "0"]}]]}], "  ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"f5f85c84-03b0-4a7c-b210-8decd1f5875f"],
 ". (s=0).\n\t\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "o"], TraditionalForm]],ExpressionUUID->
  "ca9122b5-357b-4e35-bb21-26758e38fc98"],
 " is just proportional to the second term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "d63298dd-3783-4891-90e2-d3b19f5aeb26"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "o"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"8c5a8515-44fb-41dd-a2b6-f3f903748e20"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"->", "    ", 
     SubsuperscriptBox["b", "lm", "o"]}], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}]], "  ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"8af9a5ce-f98d-4030-b594-b62c3eaec51d"],
 ". (s=0).\n\t\nFor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "c5469cd4-5a0a-43d7-a0b2-ac5b047588a7"],
 ", first note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eth]", " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], " ", "=", 
    RowBox[{"\[Rho]", " ", 
     SqrtBox[
      FractionBox[
       RowBox[{" ", 
        RowBox[{"l", "(", 
         RowBox[{"l", "+", "1"}], ")"}]}], "2"]], " ", 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"l", ",", "m"}]], " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{
          SubscriptBox[
           OverscriptBox["Y", "_"], "lm"], "(", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}], " "}], 
        "1"], 
       RowBox[{
        SubscriptBox["Y", "lm"], "(", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f08d1bd0-4624-4c6b-9fec-5db3d131798a"],
 ". (we only really care about the case s=0 here). Note that we suppress spin \
if s=0.\nFirst term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "b1acd6ca-d779-4d5f-bc3f-4215877c473c"],
 " is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Rho]", "max", "2"], " ", 
    FractionBox[
     SubscriptBox["f", "ll"], 
     RowBox[{"2", 
      SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
    OverscriptBox["\[Eth]", "~"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"210dc097-37d3-4e5f-9162-43d5b4ec05b3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Eth]", "~"], "=", 
    RowBox[{
     FractionBox["1", "\[Rho]"], "\[Eth]"}]}], TraditionalForm]],
  ExpressionUUID->"09e8b594-ea39-4bac-8f96-9d461b079fcd"],
 " is independent of \[Rho].\nSecond term is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["f", "lm"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"2c5e11e1-93bb-45b4-adff-7ce13d11a1ee"],
 ".\nConcerning ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "85388d1c-a9e1-48f1-93e9-89b405828470"],
 ", similar calculations show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], "=", " ", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      SubsuperscriptBox["\[Rho]", "0", "2"]], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
     RowBox[{"H", "(", 
      RowBox[{"\[Rho]", "-", 
       SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"062c935d-ec0f-4994-ba4b-81cb03f72a19"],
 ".\nThen: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalN]x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", 
        SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
     OverscriptBox["\[Eth]", "~"], " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
     SuperscriptBox["\[Rho]", "3"], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H", "(", 
         RowBox[{"\[Rho]", "-", 
          SubscriptBox["\[Rho]", "0"]}], ")"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", "-", 
           SubscriptBox["\[Rho]", "0"]}], ")"}], " ", 
         RowBox[{"\[Delta]", "(", 
          RowBox[{"\[Rho]", "-", 
           SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], ")"}], "."}]}]}], 
   TraditionalForm]],ExpressionUUID->"089b70ee-2c5d-4124-bbb0-bbee0c93d3e1"],
 " The second term can be dropped because the coefficient vanishes at the \
particle.\nSo, third term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "3d43f0e5-106d-43a7-86ff-d1b36f17d785"],
 " is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SubscriptBox["f", "ll"], 
      SubsuperscriptBox["\[Rho]", "0", "2"]]}], 
    OverscriptBox["\[Eth]", "~"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Rho]", "max", "2"], "-", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}], ")"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"852b7c39-4289-4c09-a0c0-f8bfe776e04c"],
 ".\nAdding everything up, again find that the first term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"~", 
     SubsuperscriptBox["\[Rho]", "max", "2"]}]}], TraditionalForm]],
  ExpressionUUID->"200fe1a5-62e9-4d42-aa40-e77e9c60a6dd"],
 ") cancels with the corresponding expression in the third term.\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "3"]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "(", 
         RowBox[{"\[CapitalOmega]", "-", 
          SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        OverscriptBox["\[Eth]", "~"], " ", 
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "(", 
         RowBox[{"\[CapitalOmega]", "-", 
          SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"b67b08dd-2d93-45f0-af8f-8c11e1e77689"],
 ".\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["c", "lm", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "3"]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox[
         SubscriptBox["f", "lm"], "1"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}], " ", "+", 
       " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        SqrtBox[
         FractionBox[
          RowBox[{" ", 
           RowBox[{"l", "(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "2"]], 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
      ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "7e6ba981-a7cc-4a4e-a9a8-e3d5b2081334"],
 ".\n\t\t\nSo, \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["a", "lm", "o"], ">"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Rho]", "0"]}]]}], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"7a3561ce-da43-49b7-980a-1bf54e415451"],
 ", \t(the averaging basically sets t=0 by periodicity).\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["b", "lm", "o"], ">"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"c0011b15-a527-44ce-9c18-59be2c4c9dcf"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["c", "lm", "o"], ">"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "3"]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox[
         SubscriptBox["f", "lm"], "1"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        SqrtBox[
         FractionBox[
          RowBox[{" ", 
           RowBox[{"l", "(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "2"]], 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"810c2351-69ef-4126-b659-91efbcbd4bc9"],
 ".\nNow, computing \[Alpha] and \[Beta] constants of \[CapitalXi], note that \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["Y", "_"], "10"], "(", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"2127dc69-8e2c-455a-af75-95117eaf6de2"],
 " and so the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "o"], TraditionalForm]],ExpressionUUID->
  "38f74ec3-9929-4aca-91fd-d0aa7e7db315"],
 " contribution vanishes, as well as second term in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "4ae7d7b2-3ec9-4714-a6c4-1e64d6ad96db"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["a", "00", "o"], ">"}], " ", "=", " ", 
    RowBox[{"-", 
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"4", 
       SubscriptBox["\[Rho]", "0"], " ", 
       SqrtBox["\[Pi]"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "38ab793e-4087-456f-98dc-01ad3e3ae17e"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["b", "10", "o"], ">"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"870e4e10-4388-4d9f-b729-0261e6c79abd"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["c", "10", "o"], ">"}], " ", "=", " ", 
    RowBox[{"-", 
     FractionBox[
      SubscriptBox["f", "lm"], 
      SqrtBox[
       RowBox[{"6", "\[Pi]"}]]]}]}], TraditionalForm]],ExpressionUUID->
  "83f9edf4-042e-4583-8656-9f0b63f56453"],
 ".\n\[Implies]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    FractionBox["1", 
     RowBox[{
      SubscriptBox["r", "0"], 
      SqrtBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", " ", "M"}], 
         SubscriptBox["r", "0"]]}]]}]]}], TraditionalForm]],ExpressionUUID->
  "7ca6b34e-940f-4a8f-a1b0-c42ec4146b81"],
 ", \t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", " ", "=", 
    FractionBox[
     RowBox[{"2", 
      SubscriptBox["\[CapitalOmega]", "\[Phi]"]}], 
     RowBox[{
      SubscriptBox["r", "0"], 
      SqrtBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", " ", "M"}], 
         SubscriptBox["r", "0"]]}]]}]]}], TraditionalForm]],ExpressionUUID->
  "b1a55700-2b14-4b4a-8ff5-c7bf77c24800"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.882167170720036*^9, 3.8821672019746237`*^9}, {
