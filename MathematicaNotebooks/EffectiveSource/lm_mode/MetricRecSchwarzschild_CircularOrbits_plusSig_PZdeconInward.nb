Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "\[ScriptCapitalU]xmmb\[Delta]Coeff", ",", 
   "\[ScriptCapitalU]xmmb\[Delta]pCoeff", ",", 
   "\[ScriptCapitalV]xnm\[Delta]Coeff", ",", 
   "\[ScriptCapitalV]bxnmb\[Delta]Coeff", ",", "xnnIntegrationRule"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalU]xmmb\[Delta]Coeff\[Rho]max", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "\[ImaginaryI]", " ", "m", " ", "\[CapitalOmega]\[CurlyPhi]"}], "+", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"f", "[", "rmax", "]"}]}], "rmax"]}], ")"}]}], " ", 
     RowBox[{"xmmbAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"f", "[", "rmax", "]"}], " ", 
     RowBox[{"\[Rho]max", "^", "2"}], " ", 
     RowBox[{"xmmbpAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalU]xmmb\[Delta]pCoeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"f", "[", "rmax", "]"}]}], "/", "2"}], " ", 
     RowBox[{
      RowBox[{"xmmbNDSolveRight", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}]}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]xnm\[Delta]Coeff\[Rho]max", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{"-", " ", 
     FractionBox[
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]], 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", "rmax"}]]}], 
    RowBox[{"xnmAt\[Rho]max", "[", 
     RowBox[{"l", ",", "m"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalV]bxnmb\[Delta]Coeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]], 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", "rmax"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"l", "+", "m", "+", "1"}], ")"}]}], " ", 
     RowBox[{"xnmAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}]}], ";"}], " "}]}], "Input",
 CellChangeTimes->{{3.992163641601369*^9, 3.992163716169821*^9}, {
