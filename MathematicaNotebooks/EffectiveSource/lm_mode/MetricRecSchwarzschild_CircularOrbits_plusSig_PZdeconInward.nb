Cell["\<\
Comparing my calculations with the arXiv paper (arXiv:1503.02414).\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.882170484866335*^9, 3.882170510961899*^9}, {
  3.88217606083037*^9, 3.882176061062578*^9}, {3.886573789867003*^9, 
