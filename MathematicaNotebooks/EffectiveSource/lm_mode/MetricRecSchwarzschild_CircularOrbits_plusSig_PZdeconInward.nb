Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "teukolskyResidualData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "teukolskyResidualData", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Spin\>\"", "->", "Weylspin"}], ",", 
      RowBox[{"\"\<Mass\>\"", "->", "M"}], ",", 
      RowBox[{"\"\<FrequencyFunction\>\"", "->", "\[Omega]m"}], ",", 
      RowBox[{"\"\<ScaleFloor\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "100"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"teukolskyResidualData", "[", 
    RowBox[{"f_", ",", "ell_Integer", ",", "m_Integer", ",", 
     RowBox[{"rr_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "s", ",", "mass", ",", "omegaFunction", ",", "omega", ",", "delta", ",",
        "k", ",", "lambda", ",", "derivativeTerm", ",", "potentialTerm", ",", 
       "residual", ",", "scale"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"OptionValue", "[", "\"\<Spin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mass", "=", 
       RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"omegaFunction", "=", 
       RowBox[{"OptionValue", "[", "\"\<FrequencyFunction\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"omega", "=", 
       RowBox[{"omegaFunction", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"delta", "=", 
       RowBox[{
        RowBox[{"rr", "^", "2"}], "-", 
        RowBox[{"2", " ", "mass", " ", "rr"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{
        RowBox[{"rr", "^", "2"}], " ", "omega"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lambda", "=", 
       RowBox[{
        RowBox[{"ell", " ", 
         RowBox[{"(", 
          RowBox[{"ell", "+", "1"}], ")"}]}], "-", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{"s", "+", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"derivativeTerm", "=", 
       RowBox[{
        RowBox[{"delta", " ", 
         RowBox[{
          RowBox[{"f", "''"}], "[", "rr", "]"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"s", "+", "1"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"rr", "-", "mass"}], ")"}], " ", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "rr", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"potentialTerm", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"k", "^", "2"}], "-", 
             RowBox[{"2", " ", "I", " ", "s", " ", 
              RowBox[{"(", 
               RowBox[{"rr", "-", "mass"}], ")"}], " ", "k"}]}], ")"}], "/", 
           "delta"}], "+", 
          RowBox[{"4", " ", "I", " ", "s", " ", "omega", " ", "rr"}], "-", 
          "lambda"}], ")"}], " ", 
        RowBox[{"f", "[", "rr", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"residual", "=", 
       RowBox[{"derivativeTerm", "+", "potentialTerm"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<ScaleFloor\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", "derivativeTerm", "]"}], "+", 
          RowBox[{"Abs", "[", "potentialTerm", "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Ell\>\"", "->", "ell"}], ",", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<Spin\>\"", "->", "s"}], ",", 
        RowBox[{"\"\<Frequency\>\"", "->", "omega"}], ",", 
        RowBox[{"\"\<Radius\>\"", "->", "rr"}], ",", 
        RowBox[{"\"\<DerivativeTerm\>\"", "->", "derivativeTerm"}], ",", 
        RowBox[{"\"\<PotentialTerm\>\"", "->", "potentialTerm"}], ",", 
        RowBox[{"\"\<Residual\>\"", "->", "residual"}], ",", 
        RowBox[{"\"\<AbsoluteResidual\>\"", "->", 
         RowBox[{"Abs", "[", "residual", "]"}]}], ",", 
        RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
        RowBox[{"\"\<RelativeResidual\>\"", "->", 
         RowBox[{
          RowBox[{"Abs", "[", "residual", "]"}], "/", "scale"}]}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9947462981969748`*^9},
 CellLabel->
  "In[416]:=",ExpressionUUID->"a43805b5-842b-4bfd-9a6c-a0104d8725fb"],

