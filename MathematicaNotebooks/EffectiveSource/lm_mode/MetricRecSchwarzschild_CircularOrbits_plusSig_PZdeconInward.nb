              RowBox[{"StringTemplate", "[", "\"\<s``_l``_m``.wxf\>\"", "]"}],
               "[", 
              RowBox[{"spin", ",", "ell", ",", "mm"}], "]"}]}], "}"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FileExistsQ", "[", "file", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Missing file: \>\"", ",", "file"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"file", ",", "\"\<WXF\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AssociationQ", "[", "sol", "]"}]}], "||", 
            RowBox[{"!", 
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"sol", ",", "\"\<In\>\""}], "]"}]}], "||", 
            RowBox[{"!", 
