 "\nNote: Be careful when making Mathematica integrate derivative of \
\[Delta]-function, ",
 StyleBox["as it can give the wrong answer",
  FontColor->RGBColor[1, 0, 0]],
 ". See example below.\nTo get right answer, make sure the argument of \
\[Delta]-function is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "(", 
    RowBox[{"x", "-", 
     SubscriptBox["x", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "02fc3299-371e-48ec-be72-dc112669caf2"],
 ", so not generic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "(", 
    RowBox[{"f", "(", "x", ")"}], ")"}], TraditionalForm]],ExpressionUUID->
  "4ee93360-b806-4ed8-a233-4319d1b930f0"],
 "!"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.897967973002303*^9, 3.8979681304373617`*^9}, {
   3.897968307712371*^9, 3.897968428961523*^9}, {3.897968566229911*^9, 
