Cell["\<\
Adding up all the contributions together.
It turns out that only the n=0 and 1 terms contribute.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.879842249556388*^9, 3.879842260138031*^9}, {
  3.897973917598427*^9, 
  3.897973935219743*^9}},ExpressionUUID->"0506a8c5-1416-4223-89ab-\
2f7e5786baa1"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"aCirc00", ",", "bCirc10", ",", "cCirc10"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aCirc00", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aCirc00TermNoCoeffRule", "[", "nInd", "]"}], " ", "/.", " ", 
      "coeffRule"}], ",", 
     RowBox[{"{", 
      RowBox[{"nInd", ",", "0", ",", "orderOfPuncture"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bCirc10", " ", "=", " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"bCirc10TermNoCoeffRule", "[", "nInd", "]"}], " ", "/.", " ", 
       "coeffRule"}], ",", 
      RowBox[{"{", 
       RowBox[{"nInd", ",", "0", ",", "orderOfPuncture"}], "}"}]}], "]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["b", "o"], " ", "is", " ", "identically", " ", "0", " ", 
     "because", " ", "Tll", " ", "has", " ", "trivial", " ", 
     RowBox[{"(", 
      RowBox[{"l", ",", "m"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", ",", "0"}], ")"}], " ", 
     RowBox[{"mode", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cCirc10", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cCirc10TermNoCoeffRule", "[", "nInd", "]"}], " ", "/.", " ", 
      "coeffRule"}], ",", 
     RowBox[{"{", 
      RowBox[{"nInd", ",", "0", ",", "orderOfPuncture"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.879842328578535*^9, 3.8798423869701853`*^9}, {
  3.881683516946095*^9, 3.881683545606016*^9}, {3.884674583464679*^9, 
  3.884674584549212*^9}, {3.8846746283549767`*^9, 3.884674650044485*^9}, {
  3.884674697461342*^9, 3.884674698558797*^9}, {3.886571549886937*^9, 
  3.886571567901092*^9}, {3.886571626557351*^9, 3.886571654346566*^9}, {
  3.893479893405529*^9, 3.893479898142385*^9}, {3.893485558846949*^9, 
  3.8934855633615417`*^9}},
 CellLabel->
  "In[1174]:=",ExpressionUUID->"8300937c-d61b-43a5-abbb-657a0bf022b9"]
}, Closed]],

