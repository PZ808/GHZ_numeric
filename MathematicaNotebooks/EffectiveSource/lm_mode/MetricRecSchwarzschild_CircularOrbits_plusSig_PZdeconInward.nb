Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TllData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"TllLeftInterpol", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
          RowBox[{
           RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPllData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"(", 
            RowBox[{"l", "+", 
             SuperscriptBox["l", "2"], "-", 
             RowBox[{
             "2", " ", "\[ImaginaryI]", " ", "m", " ", "rmin", " ", 
              "\[CapitalOmega]\[CurlyPhi]"}]}], ")"}], 
           RowBox[{"2", " ", 
            SuperscriptBox["rmin", "2"]}]], "  ", 
          RowBox[{
           RowBox[{"hPllLeft", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPlnData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
            "2", " ", "\[ImaginaryI]", " ", "m", " ", 
             "\[CapitalOmega]\[CurlyPhi]"}], 
            RowBox[{
             RowBox[{"2", " ", "M"}], "-", "rmin"}]]}], "  ", 
          RowBox[{
           RowBox[{"hPlnLeft", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPlmData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{"l", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "l"}], ")"}]}]], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "M"}], "+", 
              RowBox[{"rmin", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{
                 "\[ImaginaryI]", " ", "m", " ", "rmin", " ", 
                  "\[CapitalOmega]\[CurlyPhi]"}]}], ")"}]}]}], ")"}]}], 
           RowBox[{
            SqrtBox["2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "M"}], "-", "rmin"}], ")"}], " ", 
            SuperscriptBox["rmin", "2"]}]], "  ", 
          RowBox[{
           RowBox[{"hPlmLeft", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPlnpData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["2", "rmin"]}], "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"hPlnLeft", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hPlmpData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{"l", " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "l"}], ")"}]}]], 
           RowBox[{
            SqrtBox["2"], " ", "rmin"}]], "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"hPlmLeft", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", 
           RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
