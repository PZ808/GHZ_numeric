Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "NumericRule", ",", "\[Psi]0PExactWorldtubePiece", ",", 
    "\[Psi]0PExact\[Delta]rmin", ",", "\[Psi]0PExact\[Delta]prmin", ",", 
    "\[Psi]0PExact\[Delta]rmax", ",", "\[Psi]0PExact\[Delta]prmax"}], "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Choose", " ", "here", " ", "which", " ", "puncture", " ", "you", " ", 
     "want", " ", "to", " ", 
     RowBox[{"use", ".", " ", "First"}], " ", "will", " ", "do", " ", "the", " ",
      "numerical", " ", "integrals"}], ",", " ", 
    RowBox[{
     RowBox[{"second", " ", "are", " ", "pre"}], "-", "computed"}], ",", " ", 
    
    RowBox[{
    "expanded", " ", "in", " ", "powers", " ", "series", " ", "in", " ", 
     "dr"}], ",", " ", 
    RowBox[{"last", " ", "is", " ", "\"\<exact\>\""}], ",", " ", 
    RowBox[{
     RowBox[{"values", " ", "having", " ", "been", " ", "pre"}], "-", 
     RowBox[{"computed", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NumericRule", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], "[", "r_", "]"}], "->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"hP", "[", "x", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", 
         RowBox[{"r", "-", "r0"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
           RowBox[{"l_", ",", "m_"}], "]"}], "'"}], "[", "r_", "]"}], "->", 
        " ", 
        RowBox[{
         RowBox[{
          RowBox[{"dhP", "[", "x", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", 
         RowBox[{
          RowBox[{"r", "-", "r0"}], ",", "1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
           RowBox[{"l_", ",", "m_"}], "]"}], "''"}], "[", "r_", "]"}], "->", 
        " ", 
        RowBox[{
         RowBox[{
          RowBox[{"dhP", "[", "x", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", 
         RowBox[{
          RowBox[{"r", "-", "r0"}], ",", "2"}], "]"}]}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"NumericAtParticleRule", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], "[", 
         RowBox[{"r0", "+", "Left"}], "]"}], ":>", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"hP", "[", "x", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", "Left", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
           RowBox[{"l_", ",", "m_"}], "]"}], "'"}], "[", 
         RowBox[{"r0", "+", "Left"}], "]"}], ":>", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"dhP", "[", "x", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", 
         RowBox[{"Left", ",", "1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
           RowBox[{"l_", ",", "m_"}], "]"}], "''"}], "[", 
         RowBox[{"r0", "+", "Left"}], "]"}], ":>", " ", 
        RowBox[{
         RowBox[{
