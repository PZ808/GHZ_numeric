Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"now", " ", "do", " ", "m"}], "=", 
    RowBox[{
     RowBox[{"0", " ", "s"}], "=", 
     RowBox[{"2", " ", "jobs"}]}]}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "mzerojobsp2", ",", "zeroModeJobsp2", ",", "results", ",", "remaining", ",",
       "completed", ",", "total", ",", "lastMode", ",", "failed"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zeroModeJobsp2", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ell", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"ell", ",", "lminHomog", ",", "lmaxHomog"}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"machine", "  ", "prec", " ", "m"}], "=", 
     RowBox[{"0", " ", "mjobs"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mzerojobsp2", "=", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"mode", ",", "\[IndentingNewLine]", 
         RowBox[{"With", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ell", "=", 
              RowBox[{"mode", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"emm", "=", "0"}], ",", 
             RowBox[{"spin0", "=", "sHomog"}], ",", 
             RowBox[{"a0", "=", "aKerr"}], ",", 
             RowBox[{"omega0", "=", 
              RowBox[{"\[Omega]m", "[", "0", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"rin", "=", "rNumInbd"}], ",", 
             RowBox[{"rp", "=", "r0"}], ",", 
             RowBox[{"rout", "=", "rNumOutbd"}], ",", " ", 
             RowBox[{"wp0", "=", "TeukolskyPrecision"}]}], 
            "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"ParallelSubmit", "[", "\[IndentingNewLine]", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"solLocal", ",", "portableSol"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"solLocal", "=", 
                RowBox[{"TeukolskyRadial", "[", 
                 RowBox[{
                 "spin0", ",", "ell", ",", "emm", ",", "a0", ",", "omega0"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"portableSol", "=", "\[IndentingNewLine]", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<In\>\"", "->", 
                   RowBox[{"makePortableBranch", "[", 
                    RowBox[{"solLocal", ",", "\"\<In\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"rin", ",", "rp"}], "}"}], ",", 
                    RowBox[{"\"\<Points\>\"", "->", "500"}], ",", 
                    RowBox[{"\"\<GridPowers\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp0"}]}], "]"}]}], ",", 
                  RowBox[{"\"\<Up\>\"", "->", 
                   RowBox[{"makePortableBranch", "[", 
                    RowBox[{"solLocal", ",", "\"\<Up\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"rp", ",", "rout"}], "}"}], ",", 
                    RowBox[{"\"\<Points\>\"", "->", "1500"}], ",", 
                    RowBox[{"\"\<GridPowers\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2", ",", "4", ",", "8"}], "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp0"}]}], "]"}]}]}], 
                 "|>"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"ell", ",", "emm", ",", "portableSol"}], "}"}]}]}], 
             "]"}], "]"}]}], "]"}]}], "]"}], ",", "zeroModeJobsp2"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"high", " ", "prec", " ", "m"}], "=", 
     RowBox[{"0", " ", "mjobs"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mzerojobsp2HP", "=", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"mode", ",", "\[IndentingNewLine]", 
         RowBox[{"With", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ell", "=", 
              RowBox[{"mode", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"emm", "=", "0"}], ",", 
             RowBox[{"spin0", "=", "sHomog"}], ",", 
             RowBox[{"a0", "=", "aKerr"}], ",", 
             RowBox[{"omega0", "=", 
              RowBox[{"\[Omega]m", "[", "0", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"rin", "=", "rNumInbd"}], ",", 
             RowBox[{"rp", "=", "r0"}], ",", 
             RowBox[{"rout", "=", "rNumOutbd"}], ",", 
             RowBox[{"wp0", "=", "TeukolskyPrecision"}]}], 
            "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"ParallelSubmit", "[", "\[IndentingNewLine]", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"solLocal", ",", "portableData"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"solLocal", "=", 
                RowBox[{"TeukolskyRadial", "[", 
                 RowBox[{
                 "spin0", ",", "ell", ",", "emm", ",", "a0", ",", "omega0"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"portableData", "=", "\[IndentingNewLine]", 
                RowBox[{"<|", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"\"\<FormatVersion\>\"", "->", "2"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"\"\<In\>\"", "->", 
                   RowBox[{"portableBranchData", "[", 
                    RowBox[{"solLocal", ",", "\"\<In\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"rin", ",", "rp"}], "}"}], ",", 
                    RowBox[{"\"\<Points\>\"", "->", "500"}], ",", 
                    RowBox[{"\"\<GridPowers\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp0"}]}], "]"}]}], ",", 
                  RowBox[{"\"\<Up\>\"", "->", 
                   RowBox[{"portableBranchData", "[", 
                    RowBox[{"solLocal", ",", "\"\<Up\>\"", ",", 
                    RowBox[{"{", 
                    RowBox[{"rp", ",", "rout"}], "}"}], ",", 
                    RowBox[{"\"\<Points\>\"", "->", "1500"}], ",", 
                    RowBox[{"\"\<GridPowers\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2", ",", "4", ",", "8"}], "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp0"}]}], "]"}]}]}], 
                 "\[IndentingNewLine]", "|>"}]}], ";", "\[IndentingNewLine]", 
               
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", 
                  RowBox[{"FreeQ", "[", 
                   RowBox[{"portableData", ",", "_Failure", ",", "Infinity"}],
                    "]"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{"Failure", "[", 
                  RowBox[{"\"\<PortableBranchDataFailed\>\"", ",", 
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Mode\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"ell", ",", "emm"}], "}"}]}], ",", 
                    RowBox[{"\"\<BranchData\>\"", "->", "portableData"}]}], 
                    "|>"}]}], "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"ell", ",", "emm", ",", "portableData"}], "}"}]}], 
                "]"}]}]}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "zeroModeJobsp2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
