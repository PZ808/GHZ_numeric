Cell[TextData[{
 "Now summing over the lm modes.\n",
 StyleBox["NOTE: I am not multiplying back by ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    SuperscriptBox["i\[Omega]r", "\[Star]"]], TraditionalForm]],
  ExpressionUUID->"3c90c076-2c81-4edd-b13e-2452e6e2cbf1"],
 StyleBox[" when summing over the individual lm modes!",
