Cell[CellGroupData[{

Cell["BLS to tetrad", "Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.872755050944825*^9, 3.8727550562504263`*^9}, {
  3.872760422216731*^9, 3.872760427073944*^9}, {3.872929814584628*^9, 
