    RowBox[{"\[ScriptCapitalN]OfFH", "[", "r", "]"}], ",", 
    RowBox[{"DiracDelta", "[", 
     RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "/.", " ", 
  RowBox[{"r", " ", "->", " ", "rmin"}]}]}], "Input",
