Cell["\<\
Set up rule to account for all the contributions in the integration of \
\[Delta] and \[Delta]\[CloseCurlyQuote]. See again the Operator section for \
more details.\
\>", "Text",
 CellChangeTimes->{{3.8929764507177553`*^9, 3.892976494829124*^9}, {
  3.892984692387265*^9, 
  3.8929847017862377`*^9}},ExpressionUUID->"fb29dbef-ce51-49cf-be30-\
38c841120bbf"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "\[ScriptCapitalU]xmmb\[Delta]Coeff", ",", 
   "\[ScriptCapitalU]xmmb\[Delta]pCoeff", ",", 
   "\[ScriptCapitalV]xnm\[Delta]Coeff", ",", 
   "\[ScriptCapitalV]bxnmb\[Delta]Coeff", ",", "xnnIntegrationRule"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalU]xmmb\[Delta]Coeff\[Rho]max", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "\[ImaginaryI]", " ", "m", " ", "\[CapitalOmega]\[CurlyPhi]"}], "+", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"f", "[", "rmax", "]"}]}], "rmax"]}], ")"}]}], " ", 
     RowBox[{"xmmbAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"f", "[", "rmax", "]"}], " ", 
     RowBox[{"\[Rho]max", "^", "2"}], " ", 
     RowBox[{"xmmbpAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalU]xmmb\[Delta]pCoeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"f", "[", "rmax", "]"}]}], "/", "2"}], " ", 
     RowBox[{
      RowBox[{"xmmbNDSolveRight", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}]}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]xnm\[Delta]Coeff\[Rho]max", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{"-", " ", 
     FractionBox[
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]], 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", "rmax"}]]}], 
    RowBox[{"xnmAt\[Rho]max", "[", 
     RowBox[{"l", ",", "m"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalV]bxnmb\[Delta]Coeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]], 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", "rmax"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"l", "+", "m", "+", "1"}], ")"}]}], " ", 
     RowBox[{"xnmAt\[Rho]max", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}]}], ";"}], " "}]}], "Input",
 CellChangeTimes->{{3.992163641601369*^9, 3.992163716169821*^9}, {
  3.9921637670942993`*^9, 3.9921637677256002`*^9}, {3.992412871557757*^9, 
  3.9924129148235064`*^9}},
 CellLabel->
  "In[469]:=",ExpressionUUID->"22505948-6ac3-40ae-b444-9a98f438aad5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xnnIntegrationRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"xnnIntegrand\[Delta]Coeff", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "->", " ", 
      RowBox[{
       RowBox[{"Tln\[Delta]RmaxInterpol", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "+", 
       RowBox[{"\[ScriptCapitalU]xmmb\[Delta]Coeff\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "+", 
       RowBox[{"\[ScriptCapitalV]xnm\[Delta]Coeff\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}], " ", "+", 
       RowBox[{"\[ScriptCapitalV]bxnmb\[Delta]Coeff\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"xnnIntegrand\[Delta]pCoeff", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", "0"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.992501271449236*^9, 3.992501272660095*^9}, 
   3.992501489219153*^9},
 CellLabel->
  "In[474]:=",ExpressionUUID->"2d916300-e279-4d64-aaa6-50fd89121ebd"],

Cell[TextData[{
 "As stated above, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nn"], TraditionalForm]],ExpressionUUID->
  "5f89ce2b-8e73-48c9-bdd4-2b971ec7d59a"],
 " should not have a \[Delta] piece. This \[Delta] piece occurs as a \
\[OpenCurlyDoubleQuote]boundary term\[CloseCurlyDoubleQuote] when integrating \
\[OpenCurlyDoubleQuote]by parts\[CloseCurlyDoubleQuote] the \[Delta]\
\[CloseCurlyQuote] piece.\nThe coefficient of this piece is simply the \
coefficient of the \[Delta]\[CloseCurlyQuote] piece of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ln"], TraditionalForm]],ExpressionUUID->
  "003c77f2-6759-4982-8631-6523c5ac12d1"],
 "+ ",
