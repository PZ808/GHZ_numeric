Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Fit", "[", 
  RowBox[{
   RowBox[{"hlPuuTableLeft", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "5"}], ";;"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "3"}], ")"}]}]], ",", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "5"}], ")"}]}]], ",", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "5"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "5"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "7"}], ")"}]}]]}], 
    RowBox[{"(*", 
     RowBox[{",", 
      SuperscriptBox["l", 
       RowBox[{"-", "3"}]]}], "*)"}], "}"}], ",", "l"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"Hl", "[", "0", "]"}]}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"Hl", "[", "2", "]"}]}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"Hl", "[", "4", "]"}]}]}], " ", "//", " ", "N", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"went", " ", "to", " ", "l"}], "=", 
    RowBox[{"40", " ", "for", " ", "this"}]}], " ", "*)"}]}]}], "Input",
