Cell[TextData[{
 "We can improve the agreement by matching for a power-law and sum beyond ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "max"], TraditionalForm]],ExpressionUUID->
  "9e4f1fd6-0b1b-4c0e-b4cd-7c97ee316b64"],
 ". So that we can write schematically:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Sum]", 
     SubsuperscriptBox["h", "uu", "l"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Sum]", "0", 
       SubscriptBox["", 
        SubscriptBox["l", "max"]]], " ", 
      SubsuperscriptBox["h", "uu", 
       RowBox[{"l", ",", "data"}]]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       SubscriptBox["l", "max"], "\[Infinity]"], 
      SuperscriptBox["al", "b"]}]}]}], TraditionalForm]],ExpressionUUID->
  "87deaeb1-0121-4262-ba1d-7ba1a0122860"],
 ", where a and b are fitted parameters."
}], "Text",
 CellChangeTimes->{{3.894013442533675*^9, 3.894013712392118*^9}, {
  3.894013770303121*^9, 
  3.894013785045836*^9}},ExpressionUUID->"fcd64cb1-f6ef-4ae1-8609-\
36a1d3eae2a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TransitionToPowerLaw", " ", "=", " ", "30"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fitRule", " ", "=", "  ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "40"}], "]"}], ",", 
        RowBox[{"Re", "[", 
         RowBox[{
         "metricContributionlModes", "+", "correctorContributionlModes", "-", 
          "\[ScriptCapitalL]\[CapitalXi]gabContributionlModes"}], "]"}]}], 
       "}"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"TransitionToPowerLaw", "+", "1"}], ";;", "All"}], "]"}], 
     "]"}], ",", 
    RowBox[{"a", " ", 
     RowBox[{"l", "^", 
      RowBox[{"(", 
       RowBox[{"-", "b"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", "l", ",", 
    RowBox[{"MaxIterations", "->", "\[Infinity]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
     "metricContributionlModes", "+", "correctorContributionlModes", "-", 
      "\[ScriptCapitalL]\[CapitalXi]gabContributionlModes"}], "]"}], "]"}], 
   "+", "\[IndentingNewLine]", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"l", "^", 
        RowBox[{"(", 
         RowBox[{"-", "b"}], ")"}]}]}], " ", "/.", " ", "fitRule"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
