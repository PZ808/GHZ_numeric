Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"fit", " ", 
    RowBox[{
     RowBox[{"\[Psi]0Ret", "[", 
      RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", "to", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "j"], 
     RowBox[{
      SubscriptBox["a", "j"], 
      SuperscriptBox["r", 
       RowBox[{"-", 
        SubscriptBox["q", "j"], " "}]]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"fit\[Psi]0Tail", ",", "\[Psi]0LeadingCoeffFromFit"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"fit", " ", 
     RowBox[{
      RowBox[{"\[Psi]0Ret", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", "to", " ", 
     RowBox[{
      SubscriptBox["\[Sum]", "j"], 
      RowBox[{
       SubscriptBox["a", "j"], 
       SuperscriptBox["r", 
        RowBox[{"-", 
         SubscriptBox["q", "j"], " "}]]}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"fit\[Psi]0Tail", "[", 
     RowBox[{"l_", ",", "m_", ",", "rFitMin_", ",", "rFitMax_", ",", 
      RowBox[{"nFit_", ":", "8"}], ",", 
      RowBox[{"nPts_", ":", "200"}], ",", 
      RowBox[{"p_", ":", "5"}], ",", 
      RowBox[{"wp_", ":", "TeukolskyPrecision"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rs", ",", "qs", ",", "mat", ",", "y", ",", "coeffs"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rs", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"rFitMin", ",", "rFitMax", ",", 
            RowBox[{"nPts", "-", "1"}]}], "]"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qs", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"p", ",", 
          RowBox[{"p", "+", "nFit"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mat", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "q"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "rs", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", "qs"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "/@", "rs"}], ",", "wp"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeffs", "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"mat", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<p\>\"", "->", "p"}], ",", 
         RowBox[{"\"\<nFit\>\"", "->", "nFit"}], ",", 
         RowBox[{"\"\<qs\>\"", "->", "qs"}], ",", " ", "\[IndentingNewLine]", 
         
         RowBox[{"\"\<coeffs\>\"", "->", "coeffs"}], ",", 
         RowBox[{"\"\<aLeading\>\"", "->", 
          RowBox[{"coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<psi0Tail\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "rr", "}"}], ",", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "j", "]"}], "]"}], " ", 
               RowBox[{"rr", "^", 
                RowBox[{"(", 
                 RowBox[{"-", 
                  RowBox[{"qs", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Length", "[", "qs", "]"}]}], "}"}]}], "]"}]}], 
           "]"}]}]}], "\[IndentingNewLine]", "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]0LeadingCoeffFromFit", "[", "fit_Association", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "coeffs", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"coeffs", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"fit", ",", "\"\<coeffs\>\"", ",", 
           RowBox[{"Missing", "[", "\"\<NoCoeffs\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ListQ", "[", "coeffs", "]"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "coeffs", "]"}], ">=", "1"}]}], ",", 
          RowBox[{"coeffs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"Missing", "[", "\"\<NoLeadingCoeff\>\"", "]"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]"}]}]], "Input",\

 CellChangeTimes->{{3.99250716359312*^9, 3.99250716359656*^9}, {
