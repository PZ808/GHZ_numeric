9940476c9539"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]Abhay", " ", "==", " ", "\[Alpha]pp"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]Abhay", " ", "==", " ", "\[Beta]pp"}], " ", "/.", " ", 
   RowBox[{"\[CapitalOmega]\[CurlyPhi]", "\[Rule]", 
    RowBox[{"Sqrt", "[", 
     FractionBox["M", 
      SuperscriptBox["r0", "3"]], "]"}]}]}], " ", "//", " ", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{"r0", " ", ">", " ", 
        RowBox[{"3", " ", "M"}], " ", ">", " ", "0"}], "}"}]}]}], "]"}], " ", 
   "&"}]}]}], "Input",
 Evaluatable->False,
