Cell["          Timestamp alternative", "Subsubsubsubsection",
 CellChangeTimes->{{3.761398766925271*^9, 3.76139877532752*^9}, {
  3.761398870841613*^9, 3.761398914376091*^9}, {3.761399990990498*^9, 
  3.761400006509848*^9}},ExpressionUUID->"dab2422c-0267-4f9f-be2c-\
120db8346d7e"],

Cell["\<\
\t\tThe below is a timestamp that instead updates whenever one closes the \
notebook.
\t\tThis has been made unevaluable as the previous one is usually preferred.\
\>", "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.761398779362192*^9, 3.761398862820754*^9}, {
  3.761398916624186*^9, 3.761398918936412*^9}, {3.761400009394061*^9, 
  3.761400012054068*^9}, {3.8979745166215687`*^9, 
  3.897974517863199*^9}},ExpressionUUID->"81275951-1b76-4363-a950-\
2b9abb36c667"],

Cell[BoxData[
 RowBox[{"\t\t   ", 
  RowBox[{"SetOptions", "[", 
   RowBox[{
    RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
    RowBox[{"NotebookEventActions", "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"\"\<WindowClose\>\"", "\[RuleDelayed]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], "=", 
           "\[IndentingNewLine]", "\t   ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"LinkWrite", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "$FrontEnd", "]"}], ",", 
                  RowBox[{"FrontEnd`Value", "[", "#", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "     ", 
                RowBox[{"LinkRead", "[", 
                 RowBox[{"First", "[", "$FrontEnd", "]"}], "]"}]}], ")"}], 
              "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Day\>\"", ",", "\"\<MonthName\>\"", ",", 
               "\"\<Second\>\""}], "}"}]}], "]"}]}], ";", 
          RowBox[{"NotebookLocate", "[", "\"\<LastModified\>\"", "]"}], ";", 
          "\[IndentingNewLine]", "\t     ", 
          RowBox[{"NotebookWrite", "[", 
           RowBox[{
            RowBox[{"InputNotebook", "[", "]"}], ",", 
            RowBox[{"Cell", "[", 
             RowBox[{
              RowBox[{"TextData", "[", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Last modified:  \>\"", ",", "dy", ",", "\"\<, \>\"", ",",
                  "mn", ",", "\"\< \>\"", ",", "yr"}], "}"}], "]"}], ",", 
              "\"\<Text\>\"", ",", 
              RowBox[{"CellTags", "\[Rule]", "\"\<LastModified\>\""}]}], 
             "]"}]}], "]"}]}]}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 Evaluatable->False,
