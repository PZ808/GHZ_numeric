Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{"r", "^", 
     RowBox[{"(", 
      RowBox[{"-", "2"}], ")"}]}]}], " ", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "^", "2"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"xmmb", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", 
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{
           RowBox[{"-", "r"}], "+", "rmax"}], "]"}]}], ",", "r"}], "]"}]}], ",",
      "r"}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{"%", ",", 
