 CellLabel->"In[42]:=",ExpressionUUID->"7de21a3f-6feb-44c7-a86c-4422bb878073"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geodesics", "Section",
 CellChangeTimes->{{3.873791814957588*^9, 3.873791817083537*^9}, {
