Cell[TextData[{
 "The below manually tells Mathematica to pass differentiation through \
Conjugation. See ",
 ButtonBox["this page",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathematica.stackexchange.com/questions/91356/derivative-of-\
conjugate-multivariate-function"], None},
  ButtonNote->
   "https://mathematica.stackexchange.com/questions/91356/derivative-of-\
conjugate-multivariate-function"],
 " for more information.\nThis is used in a few places in the code, for \
example when computing metric reconstruction from hertz potential."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.881055015426565*^9, 3.8810550523997097`*^9}, {
  3.893777847964488*^9, 
  3.893777937522397*^9}},ExpressionUUID->"35cce3a6-cbe8-4053-b7f9-\
11e44cb52312"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"excluded", "=", 
  RowBox[{"\"\<ExcludedFunctions\>\"", "/.", "\[IndentingNewLine]", 
   RowBox[{"(", 
    RowBox[{"\"\<DifferentiationOptions\>\"", "/.", 
     RowBox[{"SystemOptions", "[", "\"\<DifferentiationOptions\>\"", "]"}]}], 
    ")"}]}]}], "\n", 
 RowBox[{"SetSystemOptions", "[", 
  RowBox[{"\"\<DifferentiationOptions\>\"", "->", 
   RowBox[{"\"\<ExcludedFunctions\>\"", "->", 
    RowBox[{"Union", "[", 
     RowBox[{"excluded", ",", 
      RowBox[{"{", "Conjugate", "}"}]}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Unprotect", "[", "Conjugate", "]"}], ";"}], "\n", 
 RowBox[{"Conjugate", "/:", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"Conjugate", "[", "f_", "]"}], ",", "x__"}], "]"}], ":=", 
  RowBox[{"Conjugate", "[", 
   RowBox[{"D", "[", 
    RowBox[{"f", ",", "x"}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Protect", "[", "Conjugate", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.881054993712122*^9, 3.88105501412199*^9}, {
