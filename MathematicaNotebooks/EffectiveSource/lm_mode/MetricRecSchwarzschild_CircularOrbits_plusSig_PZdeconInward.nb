       RowBox[{"hSInterpol", "[", "i_", "]"}], "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "[", "Left", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"hSLeftInterpol", "[", "i", "]"}], "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "0", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
