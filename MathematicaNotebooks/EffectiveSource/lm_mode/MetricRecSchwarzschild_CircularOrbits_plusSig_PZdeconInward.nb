  "In[640]:=",ExpressionUUID->"dd5d024d-ad52-41b1-9385-5fc4c003bafb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]Ret", "[", 
         RowBox[{"ltest", ",", "mtest"}], "]"}], "[", "r", "]"}], "-", 
       RowBox[{
        RowBox[{"fit32", "[", "\"\<Psi0Tail\>\"", "]"}], "[", "r", "]"}]}], 
      "]"}], "/", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "80"}]}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"\[Psi]Ret", "[", 
          RowBox[{"ltest", ",", "mtest"}], "]"}], "[", "r", "]"}], "]"}]}], 
      "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "rFitMin", ",", "rFitMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<relative tail-fit error\>\""}]}], 
  "]"}]], "Input",
