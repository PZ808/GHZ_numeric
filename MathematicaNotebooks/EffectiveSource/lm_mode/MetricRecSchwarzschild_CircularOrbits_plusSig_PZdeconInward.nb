Cell[TextData[{
 "The relevant differential operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", 
       RowBox[{"(", 
        RowBox[{"\[Eth]", "-", "\[Tau]"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Eth]", "+", 
        RowBox[{"3", "\[Tau]"}]}], ")"}]}], " ", "=", " ", 
     RowBox[{"-", 
      SuperscriptBox["\[Eth]", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "de409466-e931-4e21-87a5-a0ec438914e5"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.873099199660882*^9, 
  3.873099236363055*^9}},ExpressionUUID->"7ea39279-3f34-4d25-9a74-\
49a49844c216"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "S\[Dagger]nn", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S\[Dagger]nn", "[", "l_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"nNullKU", ".", "lNullKD"}], ")"}], "^", "2"}]}], " ", 
     RowBox[{
      RowBox[{"\[Eth]CK", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "l"}], "]"}], "[", 
      RowBox[{
       RowBox[{"\[Eth]CK", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", "#", "]"}], "]"}]}], " ",
     "&"}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.873099322817862*^9, 3.873099344451977*^9}, {
   3.873099563926983*^9, 3.87309958993517*^9}, {3.873736989528726*^9, 
   3.873736992248253*^9}, {3.8737893398003187`*^9, 3.873789353925645*^9}, {
   3.873792323352705*^9, 3.873792325093071*^9}, {3.875642589046013*^9, 
   3.8756426239668007`*^9}, {3.877586338249055*^9, 3.877586341566451*^9}, 
   3.879227844231434*^9, {3.8792280786382933`*^9, 3.879228111383122*^9}},
 CellLabel->
  "In[5169]:=",ExpressionUUID->"19733780-a4a7-4ad1-b41f-01335e9b67d1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SubsuperscriptBox["S", 
   RowBox[{"n", 
    OverscriptBox["m", "_"]}], "\[Dagger]"], 
  TraditionalForm]],ExpressionUUID->"06379be6-84cb-4d35-9483-cc2726bc1c15"]], \
"Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.873099397205471*^9, 3.873099407792728*^9}, 
   3.87373694489599*^9, {3.8756425827867804`*^9, 3.875642582786797*^9}, {
   3.87922784993579*^9, 
   3.8792278503595047`*^9}},ExpressionUUID->"87b44d17-af2e-40b4-b055-\
fe41e2afd767"],

Cell[TextData[{
 "The relevant differential operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["1", "2"], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "-", "\[Rho]", "+", 
           OverscriptBox["\[Rho]", "_"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"\[Eth]", "+", 
           RowBox[{"3", "\[Tau]"}]}], ")"}]}], "  ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Eth]", "-", "\[Tau]", "+", 
           RowBox[{
            OverscriptBox["\[Tau]", "_"], "'"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "+", 
           RowBox[{"3", "\[Rho]"}]}], ")"}]}]}], "]"}]}], " ", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{"\[Thorn]\[Eth]", "  ", "+", " ", "\[Eth]\[Thorn]", "+", 
        RowBox[{"3", "\[Eth]\[Rho]"}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"7e5ad9d9-84a1-4433-b926-b1fde1f7f34c"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8730994172006493`*^9, 3.873099518773645*^9}, {
  3.879227793421976*^9, 3.879227799536953*^9}, {3.8829408768637123`*^9, 
  3.882940876863855*^9}},ExpressionUUID->"04e81469-746d-4dc9-9fc8-\
59f588260eae"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "S\[Dagger]nmb", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S\[Dagger]nmb", "[", "l_", "]"}], "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"nNullKU", ".", "lNullKD"}], " ", 
         RowBox[{"mbNullKU", ".", "mNullKD"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"nNullKU", ".", "mNullKD"}], " ", 
         RowBox[{"mbNullKU", ".", "lNullKD"}]}]}], ")"}], "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Thorn]NullK", "[", 
        RowBox[{
         RowBox[{"\[Eth]CK", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", "#", "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"\[Eth]CK", "[", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", 
        RowBox[{"\[Thorn]NullK", "[", "#", "]"}], "]"}], "+", 
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"\[Eth]CK", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", 
         RowBox[{"\[Rho]K", " ", "#"}], "]"}]}]}], ")"}]}], " ", "&"}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.87309953943843*^9, 3.8730995720463247`*^9}, {
   3.87309961366546*^9, 3.873099720250243*^9}, {3.873099752819248*^9, 
   3.8730998320009604`*^9}, {3.873099869247816*^9, 3.8730998724031754`*^9}, {
   3.873649929900099*^9, 3.873649931009152*^9}, {3.873723929696439*^9, 
   3.8737239349907618`*^9}, {3.873736996402285*^9, 3.873736998970849*^9}, {
   3.873789172289703*^9, 3.873789172564506*^9}, {3.87378937475723*^9, 
   3.873789419172364*^9}, {3.873792332286127*^9, 3.8737923355213737`*^9}, {
   3.875642654962797*^9, 3.875642716604896*^9}, 3.875642803065316*^9, {
   3.877586360078703*^9, 3.877586462705524*^9}, {3.8792276300429487`*^9, 
   3.879227641042276*^9}, {3.879227839208709*^9, 3.879227839412938*^9}, 
   3.892982629023211*^9},ExpressionUUID->"2242bff6-9b4d-4099-9877-\
8407b695e643"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["S", "ab"], 
   SuperscriptBox["T", "ab"]}], 
  TraditionalForm]],ExpressionUUID->"ebaeec36-064c-44a3-b2ba-e23117366a0c"]], \
"Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8737025438928223`*^9, 
  3.873702582847026*^9}},ExpressionUUID->"5fc0ed8d-9017-4b88-97c8-\
89e238d42ade"],

Cell[TextData[{
 StyleBox["Not evaluable.\n",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["This was used to compute the weighting coefficients of the \
retarded Teukolsky equations manually. Now switched to using the BHPT.",
  FontColor->GrayLevel[0]]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.918726289519474*^9, 
  3.9187263340126677`*^9}},ExpressionUUID->"bcadc014-4541-45c9-a8da-\
1a04753e8af1"],

Cell[CellGroupData[{

Cell["Theory", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.8837367551278763`*^9, 
  3.883736755813472*^9}},ExpressionUUID->"77a8ce3b-7803-4b72-9b9c-\
a918f86ce4ec"],

Cell[TextData[{
 "For references, we will follow the conventions laid out in the review paper \
(with slight notational differences, when writing the source), instead of the \
reconstruction, because the toolkit operates under these conventions.\nThe \
Teukolsky equations are: \[ScriptCapitalO] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "c080b913-e31d-4f1d-835c-ca6159ecfb96"],
 " =  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", "0", "ab"], 
    SubscriptBox["T", "ab"]}], TraditionalForm]],ExpressionUUID->
  "98b9f40a-1eed-4554-a425-07f91ae768c7"],
 ", \[ScriptCapitalO]\[CloseCurlyQuote] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "4"], TraditionalForm]],ExpressionUUID->
  "7f40ce66-f05c-46ec-bd59-fa0a9d0a4922"],
 " =  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", "4", "ab"], 
    SubscriptBox["T", "ab"]}], TraditionalForm]],ExpressionUUID->
  "604ca962-7427-40f6-9552-40957fee4aab"],
 ".\nWe have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "ab"], " ", "=", " ", 
    RowBox[{"8", "\[Pi]", 
     RowBox[{"\[Integral]", " ", 
      RowBox[{
       SubscriptBox["u", "a"], 
       SubscriptBox["u", "b"], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "4", ")"}]], "(", 
         RowBox[{"x", "-", 
          RowBox[{"x", "(", "\[Tau]", ")"}]}], ")"}], 
        SqrtBox[
         RowBox[{"-", "g"}]]], " ", "d\[Tau]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ae4dfc77-2fac-4a31-b710-eecee92dbb56"],
 ". Make change of variable: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Tau]", "=", 
    RowBox[{
     FractionBox["d\[Tau]", "dt"], "dt"}]}], TraditionalForm]],ExpressionUUID->
  "92053f9a-3e82-426c-8c5d-e00454397714"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d\[Tau]", "dt"], "=", 
    FractionBox["1", 
     SuperscriptBox["u", "t"]]}], TraditionalForm]],ExpressionUUID->
  "bac8694f-bd80-4539-a5fc-aa6b12768127"],
 ".\nWe get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "ab"], " ", "=", 
    RowBox[{"8", "\[Pi]", " ", 
     FractionBox[
      RowBox[{
       SubscriptBox["u", "a"], 
       SubscriptBox["u", "b"]}], 
      RowBox[{
       SubsuperscriptBox["r", "0", "2"], 
       SuperscriptBox["u", "t"]}]], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "0"]}], ")"}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Theta]", "-", 
       FractionBox["\[Pi]", "2"]}], ")"}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Phi]", "-", "\[CapitalOmega]t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"6a8738d5-a7c8-406a-a214-672fecb99844"],
 ". We used that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "g"}]], "=", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", "sin", " ", "\[Theta]"}]}], 
   TraditionalForm]],ExpressionUUID->"fdbdc514-329d-495e-9b54-cba2290d4f9f"],
 ", and evaluated it at the particle (thanks to the delta functions).\nThe \
~",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[PartialD]", "r", "2"], TraditionalForm]],
  ExpressionUUID->"cf3ac70b-c9e1-431d-b83b-53c646cbfef6"],
 " coefficient of the operator \[ScriptCapitalO] is \[Thorn]\[Thorn]\
\[CloseCurlyQuote]. (In reconstruction, there is an extra factor 2).\n\
Similarly, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["S", "0", "ab"], 
     SubscriptBox["T", "ab"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Eth]", "-", 
        RowBox[{
         OverscriptBox["\[Tau]", "_"], "'"}], "-", 
        RowBox[{"4", "\[Tau]"}]}], ")"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Thorn]", "-", 
          RowBox[{"2", 
           OverscriptBox["\[Rho]", "_"]}]}], ")"}], 
        SubscriptBox["T", "lm"]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Eth]", "-", 
          RowBox[{
           OverscriptBox["\[Tau]", "_"], "'"}]}], ")"}], " ", 
        SubscriptBox["T", "ll"]}]}], "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Thorn]", "-", 
        OverscriptBox["\[Rho]", "_"], "-", 
        RowBox[{"4", "\[Rho]"}]}], ")"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Eth]", "-", 
          RowBox[{"2", 
           RowBox[{
            OverscriptBox["\[Tau]", "_"], "'"}]}]}], ")"}], 
        SubscriptBox["T", "lm"]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Thorn]", "-", 
          OverscriptBox["\[Rho]", "_"]}], ")"}], 
        SubscriptBox["T", "mm"]}]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"5bdeb9e6-da33-4315-970a-fa17f46d2bec"],
 ", (This is relevant for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "f6b8508b-2c22-4c09-a4ea-2fac45d4f530"],
 ")\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["S", "4", "ab"], 
     SubscriptBox["T", "ab"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Eth]", "'"}], "-", 
        OverscriptBox["\[Tau]", "_"], "-", 
        RowBox[{"4", 
         RowBox[{"\[Tau]", "'"}]}]}], ")"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Thorn]", "'"}], "-", 
          RowBox[{"2", 
           RowBox[{
            OverscriptBox["\[Rho]", "_"], "'"}]}]}], ")"}], 
        SubscriptBox["T", 
         RowBox[{"n", 
          OverscriptBox["m", "_"]}]]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Eth]", "'"}], "-", 
          OverscriptBox["\[Tau]", "_"]}], ")"}], " ", 
        SubscriptBox["T", "nn"]}]}], "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Thorn]", "'"}], "-", 
        RowBox[{
         OverscriptBox["\[Rho]", "_"], "'"}], "-", 
        RowBox[{"4", 
         RowBox[{"\[Rho]", "'"}]}]}], ")"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Eth]", "'"}], "-", 
          RowBox[{"2", 
           OverscriptBox["\[Tau]", "_"]}]}], ")"}], 
        SubscriptBox["T", 
         RowBox[{"n", 
          OverscriptBox["m", "_"]}]]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Thorn]", "'"}], "-", 
          RowBox[{
           OverscriptBox["\[Rho]", "_"], "'"}]}], ")"}], 
        SubscriptBox["T", 
         RowBox[{
          OverscriptBox["m", "_"], 
          OverscriptBox["m", "_"]}]]}]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"6e2e7ded-b90c-44bf-b2f8-694344718584"],
 ". (This is relevant for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "4"], TraditionalForm]],ExpressionUUID->
  "d902b8a0-4465-4196-acd2-b0c3220b2f44"],
 ")\n(in review paper, there is an extra factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "179d0248-a658-456a-8ccb-3734bd5a1e8d"],
 ").\n\nAt the level of the modes, the Teukolsky equation (for all spins), \
take the self-adjoint form (84): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"-", "s"}]], 
       FractionBox["d", "dr"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]", 
          RowBox[{"s", "+", "1"}]], 
         FractionBox["d", "dr"]}], ")"}]}], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["K", "2"], "-", 
        RowBox[{"2", "is", 
         RowBox[{"(", 
          RowBox[{"r", "-", "M"}], ")"}], "K"}]}], "\[CapitalDelta]"], "+", 
      RowBox[{"4", "is\[Omega]r"}], "-", 
      SubscriptBox["\[Lambda]", "s"]}], "]"}], "  ", 
    SubscriptBox["\[Psi]", "lm"], " ", 
    SubscriptBox[
     RowBox[{"=", " "}], "s"], 
    SubscriptBox["T", "lm"]}], TraditionalForm]],ExpressionUUID->
  "e0fec67e-314d-405e-a8bb-569736b4cf90"],
 ".\nThe mode decomposition of \[Psi] and the source are different depending \
on the spin! See eqs 81 and 91 in review paper.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], " ", 
    SubscriptBox["=", 
     RowBox[{" ", "2"}]], 
    RowBox[{
     SubscriptBox[
      RowBox[{
       SubscriptBox["\[Psi]", "lm"], " "}], "2"], 
     SubscriptBox["S", "lm"], 
     SuperscriptBox["e", 
      RowBox[{"-", "i\[Omega]t"}]]}]}], TraditionalForm]],ExpressionUUID->
  "677c24ed-d9fc-4ea5-a8a9-60cddc306be2"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "4"], 
     SubscriptBox["\[Psi]", "4"]}], " ", 
    SubscriptBox["=", 
     RowBox[{" ", 
      RowBox[{"-", "2"}]}]], 
    RowBox[{
     SubscriptBox[
      RowBox[{
       SubscriptBox["\[Psi]", "lm"], " "}], 
      RowBox[{"-", "2"}]], 
     SubscriptBox["S", "lm"], 
     SuperscriptBox["e", 
      RowBox[{"-", "i\[Omega]t"}]]}]}], TraditionalForm]],ExpressionUUID->
  "fa0f0b69-e5e4-4df8-81e6-41b86f5e1afa"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      SubsuperscriptBox["S", "0", "ab"], 
      SubscriptBox["T", "ab"]}],
     TraditionalForm], "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       FractionBox["1", 
        RowBox[{"2", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{" ", "2"}]]}], 
     SubscriptBox[
      RowBox[{
       SubscriptBox["T", "lm"], " "}], "2"], 
     SubscriptBox["S", "lm"], 
     SuperscriptBox["e", 
      RowBox[{"-", "i\[Omega]t"}]]}]}], TraditionalForm]],ExpressionUUID->
  "7813fa30-34e5-4ddf-94c5-1761fb939c6d"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      SuperscriptBox["r", "4"], 
      SubsuperscriptBox["S", "4", "ab"], 
      SubscriptBox["T", "ab"]}],
     TraditionalForm], "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       FractionBox["1", 
        RowBox[{"2", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{" ", 
        RowBox[{"-", "2"}]}]]}], 
     SubscriptBox[
      RowBox[{
       SubscriptBox["T", "lm"], " "}], 
      RowBox[{"-", "2"}]], 
     SubscriptBox["S", "lm"], 
     SuperscriptBox["e", 
      RowBox[{"-", "i\[Omega]t"}]]}]}], TraditionalForm]],ExpressionUUID->
  "e66be625-b147-4de9-afa2-13db7dcd3951"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.883736778200314*^9, 3.883736837273891*^9}, {
  3.8837369225161037`*^9, 3.883737644035719*^9}, {3.8837378361508408`*^9, 
  3.883737910251644*^9}, {3.8837385073366423`*^9, 3.883738521477277*^9}, {
  3.88468062273728*^9, 3.884680631220763*^9}, {3.894430426478232*^9, 
  3.894430430008635*^9}, {3.894430896258943*^9, 3.8944309134557734`*^9}, {
  3.895052990457698*^9, 3.8950529961123857`*^9}, {3.9022066371994667`*^9, 
  3.902206639356543*^9}},ExpressionUUID->"8f1f0453-8f05-4051-af80-\
f0cec0ac9ac6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Computation", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.873653088632918*^9, 3.873653090095366*^9}, {
  3.873703098879508*^9, 3.873703099529175*^9}, {3.873963430128137*^9, 
  3.873963430190598*^9}, {3.894014077968873*^9, 
  3.894014081453677*^9}},ExpressionUUID->"4fe62c37-b08f-4dc2-bc5f-\
1c8cc9058087"],

Cell[TextData[{
 StyleBox["The below assumes we are working in the Kinnersley tetrad and in t \
slicing.",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\n\nNote:",
  FontColor->RGBColor[1, 0, 0]],
 " in the below definition, the spin-weighted harmonics should really be \
complex conjugated, but at the particle, they are real anyway.\n",
 StyleBox["Also, ",
  FontColor->RGBColor[0.1982452124818799, 0.5258258945601587, 1.]],
 "the tetrad components of u depend on sign convention (because you do ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["e", "b", "a"], TraditionalForm]],ExpressionUUID->
  "44bc0a03-8125-45c7-af44-bf9d57269f4e"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "a"], TraditionalForm]],ExpressionUUID->
  "d69114f7-5f7f-467f-8085-902d04221473"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "a"], "=", 
    RowBox[{
     SubscriptBox["g", "ab"], 
     SuperscriptBox["u", "b"]}]}], TraditionalForm]],ExpressionUUID->
  "1ecfaafa-c0af-46d4-801b-cf1ebfaf04e7"],
 "). However, they come in pairs, so the stress-energy is independent on sign \
convention."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.883738074665477*^9, 3.883738110611888*^9}, {
  3.885015173692148*^9, 3.8850152707760773`*^9}, {3.894013994740432*^9, 
  3.894014016117393*^9}, {3.8940140530749493`*^9, 
  3.8940140561611843`*^9}},ExpressionUUID->"95a358cd-3f81-485d-9a77-\
7a34bdcc0257"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "Tll", ",", "Tnn", ",", "Tlm", ",", "Tmm", ",", "Tnmb", ",", "Tmbmb"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Tll", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{"8", "\[Pi]", " ", "ul", " ", 
    RowBox[{"ul", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r0", "^", "2"}], " ", "utU"}], ")"}]}], " ", 
