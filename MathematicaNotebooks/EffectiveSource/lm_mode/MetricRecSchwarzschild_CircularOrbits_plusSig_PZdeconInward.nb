Cell[TextData[{
 "Need to add the extra factor of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"im", " ", "\[CapitalOmega]\[CurlyPhi]", " ", 
     SuperscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "ebd2d4e9-386c-47e0-a247-ce4b5827c35b"],
 " so that we get the expression in (u,r,\[Theta],\[CurlyPhi]) coordinates."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.872921293823042*^9, 3.8729213675225897`*^9}, {
   3.872927687887518*^9, 3.872927735186803*^9}, 3.872929645974719*^9, {
