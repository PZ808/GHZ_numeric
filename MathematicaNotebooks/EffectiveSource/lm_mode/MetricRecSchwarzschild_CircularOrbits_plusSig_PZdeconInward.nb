Cell[BoxData[{
 RowBox[{
  RowBox[{"hPData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hPllrmin8mpmax14", "[", 
           RowBox[{"l", ",", "m"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"0", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
