 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fitpsi0RetTail", "[", 
     RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Fitpsi0RetTail", "[", 
      RowBox[{"\[ScriptL]", ",", "m", ",", "opts"}], "]"}], "=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"psi0", "=", 
          RowBox[{"OptionValue", "[", "\"\<Psi0Function\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"fitRange", "=", 
          RowBox[{"OptionValue", "[", "\"\<FitRange\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"p", "=", 
          RowBox[{"OptionValue", "[", "\"\<PeelingPower\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"nTail", "=", 
          RowBox[{"OptionValue", "[", "\"\<NTailTerms\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"nPts", "=", 
          RowBox[{"OptionValue", "[", "\"\<NumberOfFitPoints\>\"", "]"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"wp", "=", 
          RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
         "\[IndentingNewLine]", "rFitMin", ",", "rFitMax", ",", "rs", ",", 
         "qs", ",", "mat", ",", "y", ",", "coeffs"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rFitMin", ",", "rFitMax"}], "}"}], "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"fitRange", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rs", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Subdivide", "[", 
            RowBox[{"rFitMin", ",", "rFitMax", ",", 
             RowBox[{"nPts", "-", "1"}]}], "]"}], ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qs", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"p", ",", 
           RowBox[{"p", "+", "nTail"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"-", "q"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "rs", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"q", ",", "qs"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y", "=", 
         RowBox[{"N", "[", 
