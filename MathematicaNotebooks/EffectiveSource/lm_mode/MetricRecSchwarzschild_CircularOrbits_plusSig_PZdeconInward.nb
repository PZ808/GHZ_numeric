    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{"l", " ", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]], 
       RowBox[{"2", 
        SqrtBox["2"], 
        SubscriptBox["r", "max"]}]], 
      SubsuperscriptBox["x", 
       RowBox[{"n", 
        OverscriptBox["m", "_"]}], "+"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Implies]", "RHS"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "...", ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         RowBox[{"-", "r"}], "+", 
         SubscriptBox["r", "max"]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Delta]T", "ln", "+"], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "m", " ", 
             SubscriptBox["\[CapitalOmega]", "\[Phi]"]}], "+", 
            FractionBox[
             RowBox[{"2", " ", 
              SuperscriptBox["f", "+"]}], 
             SubscriptBox["r", "max"]]}], ")"}], 
          SubsuperscriptBox["x", 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}], "+"]}], "-", 
         RowBox[{
          FractionBox[
           SuperscriptBox["f", "+"], "2"], " ", 
          SubsuperscriptBox[
           RowBox[{"x", "'"}], 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}], "+"]}], "-", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{"l", " ", 
             RowBox[{"(", 
              RowBox[{"l", "+", "1"}], ")"}]}]], 
           RowBox[{"2", 
            SqrtBox["2"], 
            SubscriptBox["r", "max"]}]], 
          SubsuperscriptBox["x", "nm", "+"]}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{"l", " ", 
             RowBox[{"(", 
              RowBox[{"l", "+", "1"}], ")"}]}]], 
           RowBox[{"2", 
            SqrtBox["2"], 
            SubscriptBox["r", "max"]}]], 
          SubsuperscriptBox["x", 
           RowBox[{"n", 
            OverscriptBox["m", "_"]}], "+"]}]}], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]T", "ln", "+"], "-", 
         RowBox[{
          FractionBox[
           SuperscriptBox["f", "+"], "2"], 
          SubsuperscriptBox["x", 
