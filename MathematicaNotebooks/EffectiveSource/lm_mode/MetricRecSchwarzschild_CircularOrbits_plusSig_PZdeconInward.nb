Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], \nwhile in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"a3241cb7-7d96-44b6-91a1-57049183532d"]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 3.8929713039202633`*^9}, {
