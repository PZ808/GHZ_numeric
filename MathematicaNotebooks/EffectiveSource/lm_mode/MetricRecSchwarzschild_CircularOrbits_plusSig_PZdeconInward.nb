 RowBox[{
  RowBox[{
   RowBox[{"conjugate\[Psi]0TailFit", "[", "fit_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", "m", ",", "qs", ",", "coeffs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"fit", "[", "\"\<l\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"fit", "[", "\"\<m\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qs", "=", 
       RowBox[{"fit", "[", "\"\<qs\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"coeffs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "l"}], "*", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"fit", "[", "\"\<coeffs\>\"", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
        RowBox[{"\"\<m\>\"", "->", 
         RowBox[{"-", "m"}]}], ",", 
        RowBox[{"\"\<p\>\"", "->", 
         RowBox[{"fit", "[", "\"\<p\>\"", "]"}]}], ",", 
        RowBox[{"\"\<nFit\>\"", "->", 
         RowBox[{"fit", "[", "\"\<nFit\>\"", "]"}]}], ",", 
