Cell[CellGroupData[{

Cell["Check redshift value against literature", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.887955050748774*^9, 3.887955054092927*^9}, {
  3.8880533836405573`*^9, 
  3.888053389135989*^9}},ExpressionUUID->"fa63409c-7016-4e1c-993b-\
81f28278a928"],

Cell[CellGroupData[{

Cell["Theory", "Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.896362179839696*^9, 
  3.896362181092621*^9}},ExpressionUUID->"a185edab-69d7-4dac-bbae-\
370e959be56b"],

Cell[TextData[{
 "The ingredients to compute the correct redshift value are the following:\n\
1) Subtract the reconstructed retarded metric perturbation (thus in radiation \
gauge) from the original puncture (in Lorentz gauge).\n2) In principle, these \
should only account for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "\[GreaterEqual]", "2"}], TraditionalForm]],ExpressionUUID->
  "7fc12351-de72-4d06-b3b1-7cf1b9f682d8"],
 " modes. I.e. their ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "0"}], ",", "1"}], TraditionalForm]],ExpressionUUID->
  "13be7329-9110-43b5-8f33-242f0a32a6f7"],
 " should vanish. This is true for the reconstructed retarded metric, but not \
true for the puncture. So, to avoid counting them, should subtract them.\n3) \
Now, need to account for the actual ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "d8b9738e-f46c-4c86-852c-864f09a5fa56"],
 " and 1 modes. To the right of the particle, this is simply making sure that \
the asymptotic mass and spin are correct (in reconstruction, the \
reconstructed metric gives vanishing Abbott-Deser charges). ",
 ButtonBox["This terms is simply ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1702.00969.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1702.00969.pdf"],
 Cell[BoxData[
  FormBox[
   ButtonBox[
    SubscriptBox[
     OverscriptBox["g", "."], "ab"],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["https://arxiv.org/pdf/1702.00969.pdf"], None},
    ButtonNote->"https://arxiv.org/pdf/1702.00969.pdf"], TraditionalForm]],
  ExpressionUUID->"7d4f337d-0ea9-4301-b62f-92e9d295f344"],
 ", and account for the jump in the mass and spin due to the particle. On the \
left, one instead should subtract a certain gauge perturbation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
    SubscriptBox["g", "ab"]}], TraditionalForm]],ExpressionUUID->
  "78ce7ac1-425b-4e47-9856-d33b3420db1f"],
 ". This is normally subtracted on the entire spacetime, but for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", ">", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "9b9fd7f0-1c9c-492a-a122-151a8b086366"],
 " it will cancel the string that comes from the reconstruction, so in the \
end, this term only exists for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "<", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "b69f304c-9401-4a6b-b19e-0d181822a3fc"],
 ". ",
 ButtonBox["See this paper, section B .2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1503.02414.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1503.02414.pdf"],
 " for more details (note that there, they define the vector ",
 Cell[BoxData[
  FormBox["\[CapitalXi]", TraditionalForm]],ExpressionUUID->
  "6c495471-9a2f-4034-b093-96f3460c81f1"],
 " so that the gauge perturbation is to be added up instead of subtracted). \
(It turns out that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["g", "."], "ab"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"]}], 
     SubscriptBox["g", "ab"]}]}], TraditionalForm]],ExpressionUUID->
  "c9e767f8-73e9-49ef-9b85-eb40eed2a824"],
 " for appropriately defined \[CapitalXi].\n4) Everything is evaluated at the \
particle.\n\nSo, altogether, we have:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "uu"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"l", "\[GreaterEqual]", "2"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["h", "l", 
          RowBox[{"ret", ",", "recons"}]], " ", "-", " ", 
         SubsuperscriptBox["h", "l", "P"]}], ")"}]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{
         RowBox[{"l", "=", "0"}], ",", "1"}]], " ", 
       RowBox[{"(", 
        SubsuperscriptBox["h", "l", "P"], ")"}]}], " ", "+", 
      SubscriptBox[
       OverscriptBox["g", "."], "uu"]}], 
     SubscriptBox["|", 
      RowBox[{
       RowBox[{"r", "=", 
        SubscriptBox["r", "0"]}], ",", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", 
       RowBox[{"\[Phi]", "=", "\[CapitalOmega]t"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"609abbc4-39a8-4566-a520-793f41a5a8b9"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", ">", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "8dc8749f-51d2-42f2-ae41-45d7cc2273ec"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "uu"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"l", "\[GreaterEqual]", "2"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["h", "l", 
          RowBox[{"ret", ",", "recons"}]], " ", "-", " ", 
         SubsuperscriptBox["h", "l", "P"]}], ")"}]}], " ", "-", " ", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{
         RowBox[{"l", "=", "0"}], ",", "1"}]], " ", 
       RowBox[{"(", 
        SubsuperscriptBox["h", "l", "P"], ")"}]}], " ", "-", 
      RowBox[{
       SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
       SubscriptBox["g", "uu"]}]}], 
     SubscriptBox["|", 
      RowBox[{
       RowBox[{"r", "=", 
        SubscriptBox["r", "0"]}], ",", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", 
       RowBox[{"\[Phi]", "=", "\[CapitalOmega]t"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"6f6e820a-4aac-4c66-932c-01b8676308d6"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "<", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "4448099c-6fef-47d3-8cc0-b43712bc5197"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.896362194380144*^9, 3.896362634621526*^9}, {
  3.896362681186037*^9, 3.8963626812335157`*^9}, {3.896362719115993*^9, 
  3.896362996926467*^9}, {3.8963694062923803`*^9, 
  3.896369446559742*^9}},ExpressionUUID->"6ffc8a6c-5722-48e8-bda2-\
14bd3a255d68"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Evaluating at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubsuperscriptBox["r", "0", "-"]}], TraditionalForm]],ExpressionUUID->
  "2bda80d3-c20a-431d-a85c-c564a1e49988"]
}], "Subsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.8880535231086283`*^9, 
  3.888053563847529*^9}},ExpressionUUID->"0fdf6858-a51b-4364-a9ae-\
9eb595661270"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"exacthuu", " ", "=", " ", 
    RowBox[{"-", "0.21606289103798457"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"r0", "=", 
     RowBox[{"10", "M"}]}], ",", " ", 
    RowBox[{"see", " ", 
     TemplateBox[{
       RowBox[{"Detweiler", " ", "2008", " ", "paper"}], {
        URL["https://arxiv.org/pdf/0804.3529.pdf"], None}, 
       "https://arxiv.org/pdf/0804.3529.pdf", "HyperlinkActionRecycled", {
       "HyperlinkActive"}, BaseStyle -> {"Hyperlink"}, HyperlinkAction -> 
       "Recycled"},
      "HyperlinkTemplate"]}], ",", " ", 
    RowBox[{
    "or", " ", "Table", " ", "III", " ", "in", " ", "Appendix", " ", "A", " ",
      "in", " ", 
     TemplateBox[{
       RowBox[{"arXiv", ":", "1406.4890"}], {
        URL["https://arxiv.org/pdf/1406.4890.pdf"], None}, 
       "https://arxiv.org/pdf/1406.4890.pdf", "HyperlinkActionRecycled", {
       "HyperlinkActive"}, BaseStyle -> {"Hyperlink"}, HyperlinkAction -> 
       "Recycled"},
      "HyperlinkTemplate"]}], ",", " ", 
    RowBox[{"where", " ", "they", " ", "give", " ", 
     FractionBox[
      SuperscriptBox["u", "t"], "2"], 
     RowBox[{
      SubscriptBox["h", "uu"], "."}]}]}], " ", "*)"}]}]], "Input",
 Evaluatable->False,
