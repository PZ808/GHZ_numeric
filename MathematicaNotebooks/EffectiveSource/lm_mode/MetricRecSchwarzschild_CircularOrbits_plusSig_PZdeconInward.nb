  RowBox[{"(*", " ", 
   RowBox[{"Comparing", " ", 
    SubsuperscriptBox["\[Psi]", "0", "Res"]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
