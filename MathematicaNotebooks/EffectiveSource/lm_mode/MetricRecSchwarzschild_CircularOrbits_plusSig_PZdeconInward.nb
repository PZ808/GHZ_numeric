Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPsi]barRetPlusData", "[", 
    RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalPsi]barRetPlusData", "[", 
     RowBox[{"\[ScriptL]", ",", "m", ",", "opts"}], "]"}], "=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rInner", ",", "tailData", ",", "solveOpts", ",", "solveData"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "set", " ", "inner", " ", "end", " ", "of", " ", "integration", " ", 
        RowBox[{"run", ".", " ", "default"}], " ", "to", " ", "rmax"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rInner", "=", 
        RowBox[{"OptionValue", "[", "\"\<InnerRadius\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rInner", "===", "Automatic"}], ",", 
         RowBox[{"rInner", "=", "rmax"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tailData", "=", 
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<Psi0TailData\>\"", "]"}], ",", 
          RowBox[{"Automatic", ":>", "\[Psi]0tailData"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "tailData", "]"}]}], "||", 
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"tailData", ",", "\"\<Fits\>\""}], "]"}]}], "||", 
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{
             RowBox[{"tailData", "[", "\"\<Fits\>\"", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[ScriptL]", ",", "m"}], "}"}]}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<No cached \[Psi]0 tail data found for mode \>\"", ",", 
            RowBox[{"{", 
             RowBox[{"\[ScriptL]", ",", "m"}], "}"}], ",", "\"\<.\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"solveOpts", "=", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{
          "Options", "[", "\[CapitalPsi]BarPlusSolveOneFromTailData", "]"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"solveData", "=", 
        RowBox[{"\[CapitalPsi]BarPlusSolveOneFromTailData", "[", 
         RowBox[{"\[ScriptL]", ",", "m", ",", "rInner", ",", 
          RowBox[{"\"\<Psi0TailData\>\"", "->", "tailData"}], ",", 
          RowBox[{"Sequence", "@@", "solveOpts"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"solveData", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "solveData"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.992944869626396*^9, 3.9929448696286087`*^9}, {
  3.993278645494684*^9, 3.993278672711658*^9}, {3.994826771712874*^9, 
