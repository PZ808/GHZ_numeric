Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[CapitalPsi]barRetPlusBuildAll", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[CapitalPsi]barRetPlusBuildAll", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "\[CapitalPsi]barRetPlusData", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LMin\>\"", "->", "Weylspin"}], ",", 
        RowBox[{"\"\<Verbose\>\"", "->", "True"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPsi]barRetPlusBuildAll", "[", 
    RowBox[{
     RowBox[{"lmax_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{
      "OptionsPattern", "[", "\[CapitalPsi]barRetPlusBuildAll", "]"}]}]}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "lmin", ",", "verbose", ",", "modes", ",", "nModes", ",", "dataOpts", ",", 
       RowBox[{"done", "=", "0"}], ",", 
       RowBox[{"currentMode", "=", "None"}], ",", "raw", ",", "successful", ",",
        "failed"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lmin", "=", 
       RowBox[{"OptionValue", "[", "\"\<LMin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verbose", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<Verbose\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"lmax", "<", "lmin"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Need lmax >= LMin. Received lmax = \>\"", ",", "lmax", 
           ",", "\"\< and LMin = \>\"", ",", "lmin", ",", "\"\<.\>\""}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"modes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[ScriptL]", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[ScriptL]", ",", "lmin", ",", "lmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "\[ScriptL]"}], ",", "\[ScriptL]"}], "}"}]}], "]"}],
          ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nModes", "=", 
       RowBox[{"Length", "[", "modes", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dataOpts", "=", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "\[CapitalPsi]barRetPlusData", "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"verbose", ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Building \>\"", ",", "nModes", 
           ",", "\"\< modes for \>\"", ",", "lmin", ",", "\"\< <= l <= \>\"", 
           ",", "lmax", ",", "\"\<.\>\""}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"raw", "=", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"mode", ",", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ell", ",", "mm", ",", "result"}], "}"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"ell", ",", "mm"}], "}"}], "=", "mode"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"currentMode", "=", "mode"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"result", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{"\[CapitalPsi]barRetPlusData", "[", 
                    RowBox[{"ell", ",", "mm", ",", 
                    RowBox[{"Sequence", "@@", "dataOpts"}]}], "]"}], ",", 
                    "$Failed"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"done", "++"}], ";", "\[IndentingNewLine]", 
                RowBox[{"mode", "->", "result"}]}]}], "]"}]}], "]"}], ",", 
           "modes"}], "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Current mode:\>\"", ",", 
               RowBox[{"Dynamic", "[", "currentMode", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Completed:\>\"", ",", 
               RowBox[{"Dynamic", "[", "done", "]"}], ",", "\"\< / \>\"", ",",
                "nModes"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Progress:\>\"", ",", 
               RowBox[{"ProgressIndicator", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", "done", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "nModes"}], "}"}], ",", 
                 RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], "}"}]}], 
            "}"}], ",", 
           RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"successful", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"Select", "[", 
         RowBox[{"raw", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "=!=", "$Failed"}], "&"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"failed", "=", 
       RowBox[{"First", "/@", 
        RowBox[{"Select", "[", 
         RowBox[{"raw", ",", 
