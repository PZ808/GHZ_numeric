Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "\[ScriptC]AnalyticuCoord", ",", "\[ScriptC]Abs\[CapitalDelta]ruCoord"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Monitor", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
