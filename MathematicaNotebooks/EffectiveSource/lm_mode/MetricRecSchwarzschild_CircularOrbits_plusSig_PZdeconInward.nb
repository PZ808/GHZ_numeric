Cell[CellGroupData[{

Cell["Coordinates", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.895045907934393*^9, 
  3.895045909398467*^9}},ExpressionUUID->"32a73f88-498a-45b0-ba66-\
a5c2431d4f99"],

Cell[TextData[{
 "Want local, comoving coordinates (x,y,z) around particle.\nFor comoving \
coordinates, we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Phi]", "new"], " ", "=", " ", 
    RowBox[{"\[Phi]", "-", "\[CapitalOmega]t"}]}], TraditionalForm]],
  ExpressionUUID->"c7d6825a-9636-40a7-aaff-bf442a4d4cb0"],
 ", which is effectively the same as setting t=0 in old coordinates.\nChoose\n\
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", " ", "=", " ", 
     RowBox[{
     "\[CapitalDelta]r", " ", "sin", " ", "\[Theta]", " ", "cos", " ", 
      "\[Phi]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{
     "\[CapitalDelta]r", " ", "sin", " ", "\[Theta]", " ", "sin", " ", 
      "\[Phi]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{"\[CapitalDelta]r", " ", "cos", " ", 
      RowBox[{"\[Theta]", "."}]}]}]}], TraditionalForm]],ExpressionUUID->
  "11b7207e-0b94-40fb-b1ed-2038992bdd8e"],
 "\nThen, take cylindrical coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[CurlyRho]", ",", 
     OverscriptBox["\[Theta]", "~"], ",", "z"}], ")"}], TraditionalForm]],
  ExpressionUUID->"5d34f0f9-17f6-4917-8b03-1174f594779b"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"\[CurlyRho]", " ", "cos", " ", 
      OverscriptBox["\[Theta]", "~"]}]}], ",", "\n", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"\[CurlyRho]", " ", "sin", " ", 
      RowBox[{
       OverscriptBox["\[Theta]", "~"], "."}]}]}]}], TraditionalForm]],
  ExpressionUUID->"51632093-127b-4900-994a-5f9641f7bd6c"],
 "\n\nSo, have:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Theta]", "~"], " ", "=", " ", "\[Phi]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\[CurlyRho]", " ", "=", " ", 
     RowBox[{"|", 
      RowBox[{"\[CapitalDelta]r", " ", "sin", " ", "\[Theta]"}], "|"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{"\[CapitalDelta]r", " ", "cos", " ", 
      RowBox[{"\[Theta]", "."}]}]}]}], TraditionalForm]],ExpressionUUID->
  "d236b11c-af0a-4ecf-8fe1-f0136c83b209"],
 "\nSticking to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "aa1225f8-0e9b-48ce-80fe-f1467eb2c944"],
 " (implying ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", ">", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "5f66bbc1-af50-4d83-8de0-482a5588f299"],
 "), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}], TraditionalForm]],
  ExpressionUUID->"1c16722e-c068-4652-872d-0169c39488ee"],
 ", can invert to find,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", " ", "=", 
     OverscriptBox["\[Theta]", "~"]}], " ", ",", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]r", " ", "=", " ", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["z", "2"], "+", 
       SuperscriptBox["\[CurlyRho]", "2"]}]]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\[Theta]", " ", "=", " ", 
     RowBox[{
      RowBox[{"arctan", "(", 
       FractionBox["\[CurlyRho]", "z"], ")"}], "."}]}]}], TraditionalForm]],
  ExpressionUUID->"eb841f86-6335-4523-af62-e3c0970d8d47"]
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.8950465491886263`*^9, 3.895046882734908*^9}, {
  3.8950470301058826`*^9, 3.895047045006103*^9}, {3.895047217954253*^9, 
  3.895047272549243*^9}, {3.895133047452998*^9, 
  3.895133047709079*^9}},ExpressionUUID->"7a91a8cb-15fd-4646-96a4-\
ef2b55cda1bc"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "myxCoord", ",", "myyCoord", ",", "myzCoord", ",", 
   "my\[CapitalDelta]rCoord", ",", "my\[Theta]Coord", ",", "my\[Phi]Coord"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myxCoord", "[", 
    RowBox[{"\[CapitalDelta]r_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], 
   " ", "=", " ", 
   RowBox[{"\[CapitalDelta]r", " ", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myyCoord", "[", 
    RowBox[{"\[CapitalDelta]r_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], 
   " ", "=", " ", 
   RowBox[{"\[CapitalDelta]r", " ", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"myzCoord", "[", 
     RowBox[{"\[CapitalDelta]r_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], 
    " ", "=", " ", 
    RowBox[{"\[CapitalDelta]r", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[CapitalDelta]rCoord", "[", 
    RowBox[{"\[CurlyRho]_", ",", "\[Theta]Tilde_", ",", "z_"}], "]"}], " ", 
   "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"\[CurlyRho]", "^", "2"}], "+", 
     RowBox[{"z", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[Theta]Coord", "[", 
    RowBox[{"\[CurlyRho]_", ",", "\[Theta]Tilde_", ",", "z_"}], "]"}], " ", 
   "=", " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{"z", ",", "\[CurlyRho]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[Phi]Coord", "[", 
    RowBox[{"\[CurlyRho]_", ",", "\[Theta]Tilde_", ",", "z_"}], "]"}], " ", 
   "=", " ", "\[Theta]Tilde"}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.895042620609304*^9, 3.895042719423314*^9}, {
  3.8950427555080223`*^9, 3.895042839070286*^9}, {3.895043177435437*^9, 
  3.8950432452008343`*^9}, {3.895043291039362*^9, 3.89504332436707*^9}, {
  3.895045600256207*^9, 3.895045607224321*^9}, {3.895047719446479*^9, 
