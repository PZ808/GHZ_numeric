80f76a07d600"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRange", " ", "=", " ", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPsi]RetData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rmax", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
         RowBox[{"i", "/", "iRange"}]}]}], ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
            RowBox[{
             RowBox[{"\[CapitalPsi]barRet", "[", 
              RowBox[{"l", ",", 
               RowBox[{"-", "m"}]}], "]"}], "[", 
             RowBox[{"rmax", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
               RowBox[{"i", "/", "iRange"}]}]}], "]"}]}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "iRange"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRule", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
     RowBox[{"\[CapitalPsi]RetData", "[", 
      RowBox[{"[", 
       RowBox[{"20", ";;", "All"}], "]"}], "]"}]}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"r", "^", 
      RowBox[{"(", 
       RowBox[{"-", "b"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "b"}], "}"}], ",", "r"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{"Abs", "@", "\[CapitalPsi]RetData"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "b"}], ")"}]}]}], " ", "/.", " ", "paraFitRule"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"r", ",", "rmax", ",", "rNumOutbd"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}], "Input",
