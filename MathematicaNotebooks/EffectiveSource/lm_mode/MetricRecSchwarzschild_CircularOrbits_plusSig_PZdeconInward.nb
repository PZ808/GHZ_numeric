Cell[BoxData[{
 RowBox[{"Clear", "[", "exactint", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exactint", "[", 
   RowBox[{"p_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", "+", "1"}], ")"}], "/", "2"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p", "+", "1"}], ")"}], "/", "2"}]}], "]"}], "^", "2"}]}],
       ")"}], "/", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"l", "-", 
        RowBox[{"p", "/", "2"}]}], ",", 
       RowBox[{"2", "+", "p"}]}], "]"}]}], "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"\[Delta]", "^", "2"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "/", "2"}], "+", "1"}], ")"}]}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      RowBox[{"-", "l"}], ",", 
      RowBox[{"1", "+", "l"}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p", "/", "2"}], ")"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], "/", "2"}], ")"}]}]}], "]"}]}], "-", 
   
   RowBox[{
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{"2", "+", "p"}], ")"}]}], " ", 
    RowBox[{"\[Delta]", "^", 
     RowBox[{"(", 
      RowBox[{"1", "+", "p"}], ")"}]}], " ", 
    RowBox[{"Abs", "[", "\[Delta]", "]"}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      RowBox[{"-", "l"}], ",", 
      RowBox[{"1", "+", "l"}], ",", 
      RowBox[{"2", "+", 
       RowBox[{"p", "/", "2"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], "/", "2"}], ")"}]}]}], 
     "]"}]}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.907915128347158*^9, 3.907915130154879*^9}},
 CellLabel->
  "In[5970]:=",ExpressionUUID->"6bfa7b2d-92e3-4c8b-a79d-b264c6f217de"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "rest", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rest", "[", 
   RowBox[{"p_", ",", "l_", ",", "m_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "x", "}"}], ",", 
    RowBox[{
     RowBox[{"dint", "[", 
      RowBox[{"x", ",", "p", ",", "m", ",", "m", ",", "\[Delta]"}], "]"}], "/.", 
     RowBox[{
      RowBox[{
       RowBox[{"RR", "[", 
        RowBox[{"x", ",", "\[Delta]"}], "]"}], "^", "n_"}], ":>", 
      RowBox[{"exactint", "[", 
       RowBox[{
        RowBox[{"2", "n"}], ",", "l", ",", "\[Delta]"}], "]"}]}]}]}], 
   "]"}]}]}], "Input",
