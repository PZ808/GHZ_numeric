  3.883740273688032*^9, 
  3.8837402756902933`*^9}},ExpressionUUID->"2867ca88-299e-4c15-880a-\
2a56362ed55e"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "homogeneous", " ", "solutions", " ", "are", " ", "given", " ", "in", " ", 
   RowBox[{"(", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
   "coordinates"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9920777466281033`*^9, 
  3.99207776610007*^9}},ExpressionUUID->"21e87c0c-a06b-421d-875a-\
7c09f5aabcd8"],

