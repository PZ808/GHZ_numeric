      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fun", ",", "coords", ",", "vals", ",", "order"}], "}"}], ",", 
      
      RowBox[{
       RowBox[{"fun", "=", 
        RowBox[{"makePortableBranch", "[", 
         RowBox[{"sol", ",", "branch", ",", "domain", ",", "opts"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FailureQ", "[", "fun", "]"}], ",", 
         RowBox[{"Return", "[", "fun", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coords", "=", 
        RowBox[{"First", "[", 
         RowBox[{"fun", "[", "\"\<Coordinates\>\"", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
