 "Defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "lm"], " ", "=", " ", 
    RowBox[{
     SubsuperscriptBox["h", "lm", "R"], "+", 
     SubscriptBox["x", "lm"], "-", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
        SubscriptBox["g", "ab"]}], ")"}], "lm"]}]}], TraditionalForm]],
  ExpressionUUID->"163b6a2c-084c-4685-abff-02d52c79aa8a"],
 " for all the tetrad legs. This is valid in the range ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "min"], "<", "r", "<", 
    SubscriptBox["r", "max"]}], TraditionalForm]],ExpressionUUID->
  "cb912aa2-5aee-42b2-af3d-33b94b22d43b"],
