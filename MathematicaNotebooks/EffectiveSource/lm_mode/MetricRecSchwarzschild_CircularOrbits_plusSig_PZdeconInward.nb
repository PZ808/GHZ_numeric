          RowBox[{"currentMode", "=", 
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"res", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{"fit\[CapitalPsi]CubicDifferenceBase", "[", 
               RowBox[{
               "l", ",", "m", ",", "rFitMin", ",", "rFitMax", ",", "nPts", ",",
                 "wp"}], "]"}], ",", "$Failed"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"done", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], "->", "res"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mapFunction", "=", 
       RowBox[{"If", "[", 
        RowBox[{"useParallel", ",", "ParallelMap", ",", "Map"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"raw", "=", 
       RowBox[{"Monitor", "[", 
        RowBox[{
