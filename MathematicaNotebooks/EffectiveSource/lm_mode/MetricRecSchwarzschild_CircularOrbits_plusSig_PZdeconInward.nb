Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"for", " ", "outward", " ", "integration", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"\[Delta]", " ", "and", " ", 
        RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "for", " ", 
        "the", " ", "first", " ", "integral", " ", "in", " ", 
        SuperscriptBox["a", "o"]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Epsilon]", ">", "0"}], ",", 
          RowBox[{"rmin", ">", "0"}], ",", 
          RowBox[{"r1", ">", "0"}], ",", 
          RowBox[{"rmax", ">", "rmin"}]}], "}"}], ",", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r2", "^", 
            RowBox[{"(", 
             RowBox[{"-", "2"}], ")"}]}], 
           RowBox[{"r1", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Tll\[Delta]Coeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], " ", 
              RowBox[{"DiracDelta", "[", 
               RowBox[{"r1", "-", "rmax"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"Tll\[Delta]pCoeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], " ", 
              RowBox[{
               RowBox[{"DiracDelta", "'"}], "[", 
               RowBox[{"r1", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r2", ",", 
            RowBox[{"rmin", "-", "\[Epsilon]"}], ",", 
            RowBox[{"rmax", "+", "\[Epsilon]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r1", ",", 
            RowBox[{"rmin", "-", "\[Epsilon]"}], ",", "r2"}], "}"}]}], 
         "]"}]}], "]"}]}], " ", "/.", " ", 
     RowBox[{"\[Epsilon]", " ", "->", " ", "0"}]}], " ", "//", " ", 
    RowBox[{
     RowBox[{"Simplify", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"\[Delta]", " ", "and", " ", 
        RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "for", " ", 
        "the", " ", "second", " ", "integral", " ", "in", " ", 
        SuperscriptBox["a", "o"]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Epsilon]", ">", "0"}], ",", 
          RowBox[{"rmin", ">", "0"}], ",", 
          RowBox[{"r1", ">", "0"}], ",", 
          RowBox[{"rmax", ">", "rmin"}]}], "}"}], ",", "  ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r2", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Tll\[Delta]Coeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], " ", 
              RowBox[{"DiracDelta", "[", 
               RowBox[{"r2", "-", "rmax"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"Tll\[Delta]pCoeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], " ", 
              RowBox[{
               RowBox[{"DiracDelta", "'"}], "[", 
               RowBox[{"r2", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r2", ",", 
            RowBox[{"rmin", "-", "\[Epsilon]"}], ",", 
