                    RowBox[{
                    "--", "--"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]\
}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xmmbNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}], ",", 
            RowBox[{"xnmNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}], ",", 
            RowBox[{"xnnNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}]}], "}"}], "=", 
          "\[IndentingNewLine]", 
          RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", "xmmb", "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"\[Rho]", "^", "4"}], " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"myxmmb", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", "\[Rho]", 
                  "]"}]}]}], "==", 
               RowBox[{
                RowBox[{"TllRightInterpol", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", 
                RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"myxmmb", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}], "==", 
               RowBox[{"xmmbAt\[Rho]max", "[", 
                RowBox[{"l", ",", "m"}], "]"}]}], ",", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"myxmmb", "[", 
                  RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[Rho]max", 
