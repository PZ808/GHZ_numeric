d9b5983d08c7"],

Cell[TextData[{
 "Barry\[CloseCurlyQuote]s notebook add an expression for the ll component. \
We check this against the above. Turns out that Barry\[CloseCurlyQuote]s \
expression was in Carter tetrad and mostly negative signature. I don\
\[CloseCurlyQuote]t know what the function \[Lambda](0,l,m) is, but setting \
it to equal ",
 Cell[BoxData[
  FormBox[
   SqrtBox["\[Mu]"], TraditionalForm]],ExpressionUUID->
  "d5c90075-f394-41a1-846a-f2e590586131"],
 " (from Andrew\[CloseCurlyQuote]s notebook; see above) is what it takes for \
the expressions to agree. ",
 StyleBox["Note:",
  FontColor->RGBColor[1, 0, 0]],
 " the calculation is done using t coordinate, NOT u!!"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.873629378282969*^9, 3.873629417717717*^9}, {
  3.873629924563415*^9, 3.873629988873146*^9}, {3.875432718532234*^9, 
  3.875432766276943*^9}, {3.8988349593373613`*^9, 
  3.898834969790737*^9}},ExpressionUUID->"a56fef9c-ec92-461c-924a-\
9c90b73f752b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"BarryGllExpr", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", 
          RowBox[{"0", ",", "l", ",", "m"}], "]"}], "-", 
         RowBox[{"2", "\[ImaginaryI]", " ", "\[Omega]", " ", "r"}]}], ")"}], 
       RowBox[{
        RowBox[{
         RowBox[{"h\[ScriptCapitalP]ll", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}]}], ")"}]}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "M"}], "-", "r"}], ")"}], 
          RowBox[{
           RowBox[{
            RowBox[{"h\[ScriptCapitalP]ln", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "r", "]"}]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", "r", " ", 
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]ln", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}]}], ")"}], "/", 
       RowBox[{"r", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Omega]", " ", "r", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "6"}], "\[ImaginaryI]", " ", "M"}], "+", 
            RowBox[{"r", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "\[ImaginaryI]"}], "+", 
               RowBox[{"\[Omega]", " ", "r"}]}], ")"}]}]}], ")"}], 
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]mmb", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "M"}], "-", "r"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"4", "M"}], "+", 
               RowBox[{"2", "\[ImaginaryI]", " ", "r", 
                RowBox[{"(", 
                 RowBox[{"\[ImaginaryI]", "+", 
                  RowBox[{"\[Omega]", " ", "r"}]}], ")"}]}]}], ")"}], 
             RowBox[{
              RowBox[{
               RowBox[{"h\[ScriptCapitalP]mmb", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "r", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "M"}], "-", "r"}], ")"}], "r", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"h\[ScriptCapitalP]mmb", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", "r", "]"}]}]}], 
           ")"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"r", "-", 
           RowBox[{"2", "M"}]}], ")"}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"3", "M"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
             SuperscriptBox["r", "2"]}]}], ")"}], 
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]lm", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}], "+", 
         RowBox[{"r", 
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"2", "M"}]}], ")"}], 
          RowBox[{
           RowBox[{
            RowBox[{"h\[ScriptCapitalP]lm", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "r", "]"}]}]}], 
        ")"}], 
       RowBox[{
        SqrtBox[
         RowBox[{"l", 
          RowBox[{"(", 
           RowBox[{"l", "+", "1"}], ")"}]}]], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}], " ", 
          SqrtBox[
           RowBox[{"r", 
            RowBox[{"(", 
             RowBox[{"r", "-", 
              RowBox[{"2", "M"}]}], ")"}]}]]}], ")"}]}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"3", "M"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
             SuperscriptBox["r", "2"]}]}], ")"}], 
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]lmb", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}], "+", 
         RowBox[{"r", 
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"2", "M"}]}], ")"}], 
          RowBox[{
           RowBox[{
            RowBox[{"h\[ScriptCapitalP]lmb", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "r", "]"}]}]}], 
        ")"}], 
       RowBox[{
        SqrtBox[
         RowBox[{"l", 
          RowBox[{"(", 
           RowBox[{"l", "+", "1"}], ")"}]}]], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}], " ", 
          SqrtBox[
           RowBox[{"r", 
            RowBox[{"(", 
             RowBox[{"r", "-", 
              RowBox[{"2", "M"}]}], ")"}]}]]}], ")"}]}]}]}], " ", "/.", " ", 
     RowBox[{"\[Omega]", " ", "->", " ", 
      RowBox[{"m", " ", "\[CapitalOmega]\[CurlyPhi]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Carter", " ", "tetrad"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BarryGllExpr", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", 
            RowBox[{"M", "/", "r"}]}]}], ")"}]}], " ", "%"}], " ", "/.", " ", 
       
       RowBox[{
        RowBox[{"h\[ScriptCapitalP]ll", "[", 
         RowBox[{"l", ",", "m"}], "]"}], " ", "->", " ", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "r", "}"}], ",", 
