comment699594_280152", "HyperlinkActionRecycled", {"HyperlinkActive"}, 
       BaseStyle -> {"Hyperlink"}, HyperlinkAction -> "Recycled"},
      "HyperlinkTemplate"]}], " ", "for", " ", 
    RowBox[{"discussion", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"hSInterpol", ",", "dhSInterpol", ",", "ddhSInterpol"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"hSInterpol", "[", "i_", "]"}], "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[CapitalDelta]r_", "]"}], "=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"hSLeftInterpol", "[", "i", "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}], ",", 
           RowBox[{"\[CapitalDelta]r", "<", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"hSRightInterpol", "[", "i", "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}], ",", 
           RowBox[{"\[CapitalDelta]r", "\[GreaterEqual]", "0"}]}], "}"}]}], 
        "}"}], ",", "\"\<Never get here in hSInterpol\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
