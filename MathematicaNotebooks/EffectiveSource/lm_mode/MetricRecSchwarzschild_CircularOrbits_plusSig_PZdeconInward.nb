        SubscriptBox["r", "max"], "-", "r"}], ")"}]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[Delta]T", "ln", "+"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]T", "ln", "+"], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"RHS", " ", "term", " ", "2"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "...", ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         SubscriptBox["r", "max"], "-", "r"}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[Delta]\[ScriptCapitalU]x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}]], ")"}], "+"], 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[CapitalDelta]\[ScriptCapitalU]x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}]], ")"}], "+"], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "max"], "-", "r"}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "...", ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         RowBox[{"-", "r"}], "+", 
         SubscriptBox["r", "max"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "m", " ", 
             SubscriptBox["\[CapitalOmega]", "\[Phi]"]}], "+", 
            FractionBox[
             RowBox[{"2", " ", 
              SuperscriptBox["f", "+"]}], 
             SubscriptBox["r", "max"]]}], ")"}], 
          SubsuperscriptBox["x", 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}], "+"]}], "+", 
         RowBox[{
          FractionBox[
           SuperscriptBox["f", "+"], "2"], " ", 
          SubsuperscriptBox[
           RowBox[{"x", "'"}], 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}], "+"]}]}], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}], "-", 
      RowBox[{
       FractionBox[
        SuperscriptBox["f", "+"], "2"], 
