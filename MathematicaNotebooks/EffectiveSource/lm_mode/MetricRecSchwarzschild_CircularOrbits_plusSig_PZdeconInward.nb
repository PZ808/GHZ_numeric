Cell[TextData[{
 "Here, the formula is when decomposing in Fourier basis in u, instead of t.\n\
Refer to the correct formula in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "4dc38516-6d5f-4261-a2df-28f4c9132724"],
 " Puncture Field section.\nDue to the reconstruction, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["l", "a"], 
     SubscriptBox["h", "ab"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "77c57e90-d097-4167-8689-07bd76d4c966"],
 " and so, two terms in the formula identically vanish."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.879229407514595*^9, 3.879229546849205*^9}, {
