Cell[TextData[{
 "Now construct the spin flipped radial functions w/ s=-2 using the Ori trick \
multiplying w/ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", 
     RowBox[{"+", " "}]], " ", "and", " ", 
    SubscriptBox["C", "-"], " "}], TraditionalForm]],ExpressionUUID->
  "79e96a5d-b2aa-47b0-b4c9-0fd4e8622092"]
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.994747368143601*^9, 
  3.9947474231848803`*^9}},ExpressionUUID->"6e6b9fb8-88c6-4d62-8df0-\
58b48d086316"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Psi]RetSpinFlip", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]RetSpinFlip", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "r_", "]"}], ":=", 
     RowBox[{"Evaluate", "@", 
      RowBox[{"Piecewise", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Cminus", "[", 
              RowBox[{"Weylspin", ",", "l", ",", "m"}], "]"}], 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]HomogInUp", "[", 
                  RowBox[{"-", "Weylspin"}], "]"}], "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\"\<In\>\"", "]"}], "[",
                "r", "]"}], 
              StyleBox["/",
               FontColor->GrayLevel[0]], 
              StyleBox[
               RowBox[{
                RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r", "]"}],
               
               FontColor->GrayLevel[0]]}]}], ",", 
            RowBox[{"r", "\[LessEqual]", "r0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Cplus", "[", 
              RowBox[{"Weylspin", ",", "l", ",", "m"}], "]"}], 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]HomogInUp", "[", 
                  RowBox[{"-", "Weylspin"}], "]"}], "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\"\<Up\>\"", "]"}], "[",
                "r", "]"}], 
              StyleBox["/",
               FontColor->GrayLevel[0]], 
              StyleBox[
               RowBox[{
                RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r", "]"}],
               
               FontColor->GrayLevel[0]]}]}], ",", 
            RowBox[{"r", ">", "r0"}]}], "}"}]}], "\[IndentingNewLine]", "}"}],
         ",", "\[IndentingNewLine]", "\"\<Never get here. Problem evaluating \
\[Psi]Ret.\>\""}], "\[IndentingNewLine]", "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]RetSpinFlip", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "Left", "]"}], ":=", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"$MaxExtraPrecision", "=", "1000"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Cminus", "[", 
          RowBox[{"Weylspin", ",", "l", ",", "m"}], "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]HomogInUp", "[", 
              RowBox[{"-", "Weylspin"}], "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "\"\<In\>\"", "]"}], "[", 
           "r0", "]"}], 
          StyleBox["/",
           FontColor->GrayLevel[0]], 
          StyleBox[
           RowBox[{
            RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}],
           FontColor->GrayLevel[0]]}]}]}], 
       StyleBox["\[IndentingNewLine]",
        FontColor->GrayLevel[0]], "]"}], "\[IndentingNewLine]", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]RetSpinFlip", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}], ":=", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"$MaxExtraPrecision", "=", "1000"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Cplus", "[", 
          RowBox[{"Weylspin", ",", "l", ",", "m"}], "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]HomogInUp", "[", 
              RowBox[{"-", "Weylspin"}], "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "\"\<Up\>\"", "]"}], "[", 
           "r0", "]"}], 
          StyleBox["/",
           FontColor->GrayLevel[0]], 
          StyleBox[
           RowBox[{
            RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}],
           FontColor->GrayLevel[0]]}]}]}], 
       StyleBox["\[IndentingNewLine]",
        FontColor->GrayLevel[0]], "]"}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"l", ",", 
     RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"m", ",", "0", ",", "l"}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"end", " ", "do"}], " ", "*)"}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.993017339311308*^9, 3.993017370060793*^9}},
 CellLabel->
  "In[420]:=",ExpressionUUID->"cd4eb019-3ac3-4585-a8d5-c77309525c26"],

Cell["\<\
Get the -m paired modes from the conjugated +m modes with (-1)^l coming from \
the Y functions \
\>", "Text",
 CellChangeTimes->{{3.994821513771183*^9, 
  3.994821552205127*^9}},ExpressionUUID->"950f1eba-1706-4885-bcd7-\
f7a01d3e0bf3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]Ret", "[", 
      RowBox[{"l_", ",", "m_"}], "]"}], "[", "r_", "]"}], "/;", 
    RowBox[{"m", "<", "0"}]}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "l"], 
    RowBox[{"Conjugate", "[", 
     RowBox[{
      RowBox[{"\[Psi]Ret", "[", 
       RowBox[{"l", ",", 
        RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]RetSpinFlip", "[", 
      RowBox[{"l_", ",", "m_"}], "]"}], "[", "r_", "]"}], "/;", 
    RowBox[{"m", "<", "0"}]}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "l"], 
    RowBox[{"Conjugate", "[", 
     RowBox[{
      RowBox[{"\[Psi]RetSpinFlip", "[", 
       RowBox[{"l", ",", 
        RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.992933947064239*^9, 3.992933948173748*^9}, {
  3.99293401717665*^9, 3.992934018641224*^9}, {3.992934106788828*^9, 
  3.992934107824203*^9}, {3.993017388724183*^9, 3.993017394105402*^9}},
 CellLabel->
  "In[422]:=",ExpressionUUID->"c691b8cf-1b69-4a77-9b26-9d75e2c34dec"],

Cell["\<\
Def piecewise + and - branch functions with support on r>r0 and r<r0, resp.\
\>", "Text",
 CellChangeTimes->{{3.994823808574431*^9, 
  3.994823833668782*^9}},ExpressionUUID->"0389d2e9-a184-4a4f-8d4c-\
26d773771220"],

