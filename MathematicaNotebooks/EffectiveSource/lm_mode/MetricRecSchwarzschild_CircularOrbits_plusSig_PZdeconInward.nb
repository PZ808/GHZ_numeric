   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rGrid", " ", "=", " ", 
     RowBox[{"DeleteElements", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"rmin", "+", 
          RowBox[{"i", " ", 
