Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]rPlot", "=", 
   RowBox[{"1", "/", "10000000000000000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListLogLogPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"Abs", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
               RowBox[{
                RowBox[{"\[CapitalPsi]barRet", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"-", "m"}]}], "]"}], "[", "Left", "]"}], " ", 
               StyleBox[
                RowBox[{
                 RowBox[{"ExpI\[Omega]rstar", "[", 
                  RowBox[{"-", "m"}], "]"}], "[", "r0", "]"}],
                FontColor->GrayLevel[0]]}], "]"}], 
             RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
              RowBox[{
               RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
               RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
