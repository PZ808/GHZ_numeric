 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", 
     RowBox[{
      OverscriptBox["m", "_"], 
      OverscriptBox["m", "_"]}], "\[Dagger]"], "=", 
    FormBox[
     RowBox[{" ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "-", "\[Rho]"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Thorn]", "+", 
          RowBox[{"3", "\[Rho]"}]}], ")"}]}], "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[Thorn]", "2"]}], "-", 
         RowBox[{"3", " ", "\[Thorn]\[Rho]"}], " ", "+", " ", 
         "\[Rho]\[Thorn]", "+", 
         RowBox[{"3", 
          SuperscriptBox["\[Rho]", "2"]}]}], "=", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["S", 
           RowBox[{
            OverscriptBox["m", "_"], 
            OverscriptBox["m", "_"]}], "\[Dagger]"], ")"}], "*"]}]}]}],
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "63ef8014-bbc5-4375-8340-0c4c6e90d3d7"],
 ",  eq (B.6)."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.873094543777586*^9, 3.873094553191925*^9}, {
   3.873094688925646*^9, 3.8730946902041197`*^9}, {3.873094721465901*^9, 
   3.873094783948419*^9}, {3.87309574757977*^9, 3.87309578210331*^9}, {
   3.873098572666457*^9, 3.873098573013234*^9}, {3.878965850765867*^9, 
