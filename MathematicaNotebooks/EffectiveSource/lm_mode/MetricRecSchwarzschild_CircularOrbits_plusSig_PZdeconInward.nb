         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "30"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", "r0", "}"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"remove", " ", "r"}], "=", "r0"}], ",", " ", 
     RowBox[{"as", " ", "puncture", " ", "not", " ", "defined", " ", 
      RowBox[{"there", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{"Table", "[", 
