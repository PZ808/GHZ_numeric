Cell[BoxData[{
 RowBox[{"Clear", "[", "\[CapitalPhi]Mbar", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Monitor", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalPhi]Mbar", "[", 
         RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "=", " ", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''''"}], "[",
               "r", "]"}], " ", "==", " ", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", "\[ScriptM]"}], " ", 
              RowBox[{
               RowBox[{"\[Psi]0RSmoothPiece", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "r", 
               "]"}]}]}], ",", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{"RMbar", "[", 
               RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax", 
              "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{"\[CapitalPsi]barInward", "[", 
               RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax", 
              "]"}]}], ",", " ", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'"}], "[", 
              "rmax", "]"}], " ", "==", "  ", 
             RowBox[{
              RowBox[{"d\[CapitalPsi]barInward", "[", 
               RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax", 
              "]"}]}], ",", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''"}], "[",
               "rmax", "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"d2\[CapitalPsi]barInward", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax",
                "]"}], "-", 
              RowBox[{"2", " ", 
               RowBox[{"\[Psi]0PExact\[Delta]prmax", "[", 
