Cell[TextData[{
 "Checked for all the other indices which give the same kind of answer. One \
small exception is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["m", "_"], 
    OverscriptBox["m", "_"]}], TraditionalForm]],ExpressionUUID->
  "f68dea13-70b2-4904-8535-acd57f064042"],
 " component which has a weird behaviour towards the very end:"
}], "Text",
 CellMargins->{{$Failed, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.890387550070314*^9, 
  3.8903875915442944`*^9}},ExpressionUUID->"a50d021f-ffeb-4209-ba01-\
ddc97c495223"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hPData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hPmbmbrmin8mpmax20", "[", 
           RowBox[{"l", ",", "m"}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRuleForPuncture", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
     RowBox[{"hPData", "[", 
      RowBox[{"[", 
       RowBox[{"25", ";;", "All"}], "]"}], "]"}]}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "0.003"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "0.21"}], "}"}]}], "}"}], ",", "l"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListLogPlot", "[", 
     RowBox[{"Abs", "@", "hPData"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], " ", "l"}], "]"}]}], " ", "/.", " ", 
        "paraFitRuleForPuncture"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], " "}]}], "Input",
