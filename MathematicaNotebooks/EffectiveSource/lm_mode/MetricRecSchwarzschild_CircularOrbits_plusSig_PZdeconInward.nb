Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPsi]barRetPlus", "[", 
     RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "[", 
    RowBox[{"rr_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalPsi]barRetPlusD", "[", 
     RowBox[{"\[ScriptL]", ",", "m", ",", "0", ",", "opts"}], "]"}], "[", 
    "rr", "]"}]}], ";"}]], "Input",
