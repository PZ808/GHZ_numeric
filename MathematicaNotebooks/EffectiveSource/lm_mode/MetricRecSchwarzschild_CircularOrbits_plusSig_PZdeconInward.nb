Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"r0", "=", 
     RowBox[{
      RowBox[{"10", "M", " ", "at", " ", "rmin"}], "=", 
      RowBox[{"8", "M"}]}]}], ",", " ", 
    RowBox[{"norder", " ", "=", " ", "2"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]0RetData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]Ret", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]0PData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]0RData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]Ret", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], "-", 
