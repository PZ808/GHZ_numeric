Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPsi]barRetPlusD", "[", 
     RowBox[{"\[ScriptL]_Integer", ",", "m_Integer", ",", 
      RowBox[{"k_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "[", 
    RowBox[{"rr_", "?", "NumericQ"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", "fit", ",", "rInner", ",", "rBoundary", ",", "useTail", ",",
        "dataOpts", ",", "numericalFunctions"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"useTail", "=", 
       RowBox[{"OptionValue", "[", "\"\<UseTailOutsideBoundary\>\"", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"dataOpts", "=", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "\[CapitalPsi]barRetPlusData", "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"\[CapitalPsi]barRetPlusData", "[", 
        RowBox[{"\[ScriptL]", ",", "m", ",", 
         RowBox[{"Sequence", "@@", "dataOpts"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"data", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"data", "[", "\"\<Fit\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInner", "=", 
       RowBox[{"data", "[", "\"\<InnerRadius\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rBoundary", "=", 
       RowBox[{"data", "[", "\"\<BoundaryRadius\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"numericalFunctions", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"data", "[", "\"\<\[CapitalPsi]Bar\>\"", "]"}], ",", 
         RowBox[{"data", "[", "\"\<d\[CapitalPsi]Bar\>\"", "]"}], ",", 
         RowBox[{"data", "[", "\"\<d2\[CapitalPsi]Bar\>\"", "]"}], ",", 
         RowBox[{"data", "[", "\"\<d3\[CapitalPsi]Bar\>\"", "]"}]}], "}"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"rr", "<", "rInner"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"\[CapitalPsi]barRetPlus", "::", "below"}], ",", "rr", ",",
            "rInner"}], "]"}], ";", "\[IndentingNewLine]", "Indeterminate"}], 
        ",", 
        RowBox[{
         RowBox[{"rInner", "<=", "rr", "<=", "rBoundary"}], "&&", 
         RowBox[{"0", "<=", "k", "<=", "3"}]}], ",", 
        RowBox[{
         RowBox[{"numericalFunctions", "[", 
          RowBox[{"[", 
           RowBox[{"k", "+", "1"}], "]"}], "]"}], "[", "rr", "]"}], ",", 
        RowBox[{
         RowBox[{"rInner", "<=", "rr", "<=", "rBoundary"}], "&&", 
         RowBox[{"k", ">=", "4"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"k", "-", "3"}], "]"}], "[", 
          RowBox[{"data", "[", "\"\<PhiBarTriplePrime\>\"", "]"}], "]"}], "[",
          "rr", "]"}], ",", 
        RowBox[{
         RowBox[{"rr", ">", "rBoundary"}], "&&", 
         RowBox[{"TrueQ", "[", "useTail", "]"}]}], ",", 
        RowBox[{"\[CapitalPsi]BarTailDerivsFromFitm", "[", 
         RowBox[{"fit", ",", "m", ",", "k", ",", "rr"}], "]"}], ",", "True", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"\[CapitalPsi]barRetPlus", "::", "outside"}], ",", "rr"}], 
          "]"}], ";", "\[IndentingNewLine]", "Indeterminate"}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.992944891192543*^9, 3.992944891194976*^9}, {
