Cell[TextData[{
 "We also check explicitly that each corrector tensor satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", "ab", "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "l"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["x", "ab", 
        RowBox[{"l", "-", "m"}]], ")"}], "*"]}]}], TraditionalForm]],
  ExpressionUUID->"d94ec426-313c-4957-9786-aa3efb258405"],
 ". TOgether with the above, we then have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"l", "+", "m", "+", "1"}]], 
     SubsuperscriptBox["x", "nm", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "b31682a2-48b8-4c7c-94c3-280ed0688951"],
 "."
}], "Text",
 Evaluatable->False,
