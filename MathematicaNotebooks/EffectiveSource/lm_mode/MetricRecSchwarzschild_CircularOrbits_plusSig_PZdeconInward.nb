Cell[CellGroupData[{

Cell["Computation in (t,r) coordinates", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.877597521957388*^9, 3.877597525166691*^9}, {
  3.8776742058771753`*^9, 
  3.8776742101688423`*^9}},ExpressionUUID->"0e8a7917-dfa3-4a02-bee4-\
75ce9ca52cb4"],

Cell[TextData[{
 "Here we work out the formula for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "=", 
    RowBox[{
     SuperscriptBox["\[ScriptCapitalT]", "ab"], 
     SubscriptBox["h", "ab"]}]}], TraditionalForm]],ExpressionUUID->
  "e01f367a-17c3-46b1-9ddb-7501b562a165"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8775975464730062`*^9, 3.877597568404859*^9}, {
   3.893997662311748*^9, 3.893997667023509*^9}, 
   3.8939977796537943`*^9},ExpressionUUID->"738874ab-ae07-4a7b-b567-\
aaa10eb5bf69"],

Cell[TextData[{
 "Formula ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "=", 
    RowBox[{
     SuperscriptBox["\[ScriptCapitalT]", "ab"], 
     SubscriptBox["h", "ab"]}]}], TraditionalForm]],ExpressionUUID->
  "78665bf4-8c84-440b-a18a-6f9f737224ac"],
 " can be found, e.g. in reconstruction paper eq. (B.7) or in the review \
paper eq (55a). The tetrad legs are in Kinnersley for both.\nNote: there is a \
sign difference between the two references.\nThis is because there are two \
different definitions for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "d7cfa89d-fff4-421e-90c9-545f2916b020"],
 ":\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "=", " ", 
    RowBox[{
     RowBox[{"-", " ", 
      SubscriptBox["C", "abcd"]}], " ", 
     SuperscriptBox["l", "a"], 
     SuperscriptBox["m", "b"], 
     SuperscriptBox["l", "c"], 
     SuperscriptBox["m", "d"]}]}], TraditionalForm]],ExpressionUUID->
  "a57a6dcb-1d2d-417b-8cb8-1489d12f492a"],
 " in the (+,-,-,-) signature       \[Rule]     use (B7) in reconstruction \
paper,\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], "=", " ", 
    RowBox[{
     RowBox[{"+", " ", 
      SubscriptBox["C", "abcd"]}], " ", 
     SuperscriptBox["l", "a"], 
     SuperscriptBox["m", "b"], 
     SuperscriptBox["l", "c"], 
     SuperscriptBox["m", "d"]}]}], TraditionalForm]],ExpressionUUID->
  "bd8eab56-5382-4834-b655-511a2132d407"],
 " in the (-,+,+,+) signature     \[Rule]     use (55a) in review paper.\n\
These definitions ensure that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "a7b8126c-e772-46e9-aeb7-f97a248c74f4"],
 " is independent of the signature.\[NonBreakingSpace]\nSo to get the \
puncture ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", "P"], TraditionalForm]],ExpressionUUID->
  "46390884-78d4-4ffd-98e5-f6a5ef7b68cb"],
 ", if one starts with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "bd96dc4e-9a76-42c1-8dda-8139cc4d2dd7"],
 " in the (-,+,+,+) signature, one should use (55a), while one should instead \
use (B7) if working in (+,-,-,-) signature.\nIn the present case,we assume  \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "135e3bd2-4dc2-4908-b21a-e0dd1df0aab5"],
 " is given in the (-,+,+,+) signature."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8763922760565157`*^9, 3.876392353726788*^9}, {
   3.883116929064185*^9, 3.8831171628395844`*^9}, 3.883117308226556*^9, {
