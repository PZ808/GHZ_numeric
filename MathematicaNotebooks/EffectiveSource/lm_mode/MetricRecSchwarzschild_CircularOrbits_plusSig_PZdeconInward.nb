Cell["\<\
Set up rule to account for all the contributions in the integration of \
\[Delta] and \[Delta]\[CloseCurlyQuote].\
\>", "Text",
 CellChangeTimes->{{3.8929764507177553`*^9, 
  3.892976494829124*^9}},ExpressionUUID->"f4af68af-bc86-4dba-923e-\
1d39d3e563d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "\[ScriptCapitalN]xmmb\[Delta]Coeff\[Rho]max", ",", "xnmIntegrationRule"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalN]xmmb\[Delta]Coeff\[Rho]max", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "1"}], "/", "2"}], " ", 
     RowBox[{
      RowBox[{"\[Eth]CK", "[", 
       RowBox[{"0", ",", "l"}], "]"}], "[", 
      RowBox[{"xmmbAt\[Rho]max", "[", 
       RowBox[{"l", ",", "m"}], "]"}], "]"}]}], " ", "/.", " ", 
    RowBox[{"r", " ", "->", " ", "rmax"}]}]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"check", " ", "sign"}], " ", "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"when", " ", "evaluating", " ", 
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], " ", "at", " ", 
    SubscriptBox["r", "max"], " ", "we", " ", "can", " ", "simply", " ", 
    "take", " ", "the", " ", "value", " ", "of", " ", "the", " ", 
    "distributional", " ", "parts", " ", "as", " ", "the", " ", "integral", " ",
     "over", " ", "smooth", " ", "bit", " ", "is", " ", "zero", " ", "at", " ", 
    SubscriptBox["r", "max"]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"xnmIntegrationRule", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"xnmIntegrand\[Delta]Coeff", "[", 
