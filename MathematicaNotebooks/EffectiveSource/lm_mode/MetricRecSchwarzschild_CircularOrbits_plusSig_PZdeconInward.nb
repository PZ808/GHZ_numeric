Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"expr", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "^", 
          RowBox[{"(", 
           RowBox[{"-", "2"}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"xnm", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", 
            RowBox[{"HeavisideTheta", "[", 
             RowBox[{"rmax", "-", "r"}], "]"}]}], ",", "r"}], "]"}]}], ",", 
        "r"}], "]"}]}], "//", "Expand"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprCanon", "=", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"DiracDelta", "[", 
         RowBox[{
          RowBox[{"-", "r"}], "+", "rmax"}], "]"}], "->", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmax"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"DiracDelta", "'"}], "[", 
         RowBox[{
          RowBox[{"-", "r"}], "+", "rmax"}], "]"}], "->", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"DiracDelta", "'"}], "[", 
          RowBox[{"r", "-", "rmax"}], "]"}]}]}]}], "}"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprCanon", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{"exprCanon", "/.", " ", 
      RowBox[{
       RowBox[{"c_.", " ", 
        RowBox[{
         RowBox[{"DiracDelta", "'"}], "[", 
         RowBox[{"r", "-", "rmax"}], "]"}]}], ":>", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "/.", " ", 
           RowBox[{"r", "->", "rmax"}]}], ")"}], " ", 
         RowBox[{
          RowBox[{"DiracDelta", "'"}], "[", 
          RowBox[{"r", "-", "rmax"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"c", ",", "r"}], "]"}], "/.", " ", 
           RowBox[{"r", "->", "rmax"}]}], ")"}], " ", 
         RowBox[{"DiracDelta", "[", 
          RowBox[{"r", "-", "rmax"}], "]"}]}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprCanon", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{"exprCanon", "/.", " ", 
      RowBox[{
       RowBox[{"c_.", " ", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmax"}], "]"}]}], ":>", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c", "/.", " ", 
          RowBox[{"r", "->", "rmax"}]}], ")"}], " ", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmax"}], "]"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"exprCanon", ",", 
     RowBox[{"DiracDelta", "[", 
      RowBox[{"r", "-", "rmax"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "=", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"exprCanon", ",", 
      RowBox[{
       RowBox[{"DiracDelta", "'"}], "[", 
       RowBox[{"r", "-", "rmax"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ruletmp", " ", "=", " ", 
  RowBox[{
   RowBox[{"Flatten", "@", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "==", 
         RowBox[{
          RowBox[{"Tlm\[Delta]Coeff", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "\[Eth]xmmb"}]}]}], ",", 
        RowBox[{"B", "==", 
         RowBox[{"Tlm\[Delta]pCoeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"xnm", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"xnm", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "rmax", "]"}]}], 
       "}"}]}], "]"}]}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.992411520140854*^9, 3.992411552306916*^9}, {
