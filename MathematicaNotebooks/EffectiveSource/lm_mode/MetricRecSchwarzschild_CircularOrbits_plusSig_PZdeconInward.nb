Cell["\<\
Check that the homogeneous solutions are indeed solutions to the homogeneous \
Teukolsky equation.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8963524213450613`*^9, 
  3.896352448976725*^9}},ExpressionUUID->"aa905a8f-765c-431b-9f3d-\
100cb71a0268"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"my\[CapitalDelta]", ",", "myK", ",", "my\[Lambda]"}], "]"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[CapitalDelta]", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", "^", "2"}], "-", 
    RowBox[{"2", " ", "M", " ", "r"}]}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"myK", "[", "m_", "]"}], "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", 
    RowBox[{"\[Omega]m", "[", "m", "]"}]}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[Lambda]", "[", 
    RowBox[{"l_", ",", "s_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"l", " ", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}], " ", "-", 
    RowBox[{"s", " ", 
     RowBox[{"(", 
      RowBox[{"s", "+", "1"}], ")"}]}]}]}], ";"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8962405018803883`*^9, 3.896240525855769*^9}, {
  3.8962406074309063`*^9, 3.896240645091634*^9}, {3.896240989620165*^9, 
  3.8962410449901047`*^9}, {3.992141911246063*^9, 3.992141912030739*^9}, {
  3.9921420161041603`*^9, 3.9921420169073763`*^9}, {3.99250114984229*^9, 
  3.9925011504714947`*^9}},
 CellLabel->
  "In[756]:=",ExpressionUUID->"b948f081-e2d5-4c96-9d28-c0aebb2d6df6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"myl", " ", "=", " ", "2"}], ";", " ", 
  RowBox[{"mym", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"my\[CapitalDelta]", "[", "r", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "Weylspin"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"my\[CapitalDelta]", "[", "r", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"Weylspin", "+", "1"}], ")"}]}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]HomogInUp", "[", 
               RowBox[{"Weylspin", ",", "myl", ",", "mym"}], "]"}], 
              "[", "\"\<In\>\"", "]"}], "'"}], "[", "r", "]"}]}], ",", "r"}], 
         "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"myK", "[", "mym", "]"}], "[", "r", "]"}], "^", "2"}], 
             " ", "-", " ", 
             RowBox[{"2", " ", "I", " ", "Weylspin", " ", 
              RowBox[{"(", 
               RowBox[{"r", "-", "M"}], ")"}], " ", 
              RowBox[{
               RowBox[{"myK", "[", "mym", "]"}], "[", "r", "]"}]}]}], ")"}], "/", 
           RowBox[{"my\[CapitalDelta]", "[", "r", "]"}]}], "+", " ", 
          RowBox[{"4", " ", "I", " ", "Weylspin", " ", 
           RowBox[{"\[Omega]m", "[", "mym", "]"}], " ", "r"}], " ", "-", " ", 
          
          RowBox[{"my\[Lambda]", "[", 
           RowBox[{"myl", ",", "Weylspin"}], "]"}]}], ")"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]HomogInUp", "[", 
           RowBox[{"Weylspin", ",", "myl", ",", "mym"}], "]"}], 
          "[", "\"\<In\>\"", "]"}], "[", "r", "]"}]}]}], " ", "/.", " ", 
      RowBox[{"r", " ", "->", " ", "rVal"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"rVal", ",", "rmin", ",", "rmax", ",", "0.1"}], "}"}]}], 
    "]"}]}]}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.896240477579863*^9, 3.896240499189204*^9}, {
  3.8962405326305923`*^9, 3.896240598692103*^9}, {3.896240648068493*^9, 
  3.896240740419127*^9}, {3.896241050670465*^9, 3.8962410778466387`*^9}, {
  3.896241289429862*^9, 3.8962413857931967`*^9}},
 CellLabel->
  "In[760]:=",ExpressionUUID->"06e199f2-5de7-44db-9af0-b774f4be296a"],

Cell[BoxData["1.9860273225978185`*^-15"], "Output",
 Evaluatable->False,
 CellChangeTimes->{
  3.89624107870466*^9, {3.8962412935238037`*^9, 3.8962413969418793`*^9}, 
   3.898762585494545*^9, 3.992502553005072*^9},
 CellLabel->
  "Out[761]=",ExpressionUUID->"8b08e10a-d7f9-4b26-bd7e-b039aa7fab51"]
}, {1, 2}]],

Cell[TextData[{
 "Check now the inhomogeneous solution. Here, need to be careful: Note that \
the RHS ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["S", "ab"], 
     RowBox[{
      SubscriptBox["T", "ab"], "~", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "0"]}], ")"}]}]}], "+", 
    RowBox[{
     RowBox[{"\[Delta]", "'"}], 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "0"]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"\[Delta]", "''"}], 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "0"]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "49feb587-305c-445c-bee5-e9d74017aa3f"],
 ". So, the LHs must be of that form too.\nSo, the Weyl scalar is of the \
form: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Psi]", "lm", "ret"], "(", "r", ")"}], " ", "=", " ", 
    RowBox[{
     SubsuperscriptBox["\[Psi]", "lm", "-"], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Psi]", "lm", "+"], "-", 
        SubsuperscriptBox["\[Psi]", "lm", "-"]}], ")"}], " ", 
      RowBox[{"\[CapitalTheta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "0"]}], ")"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"\[Delta]\[Psi]", "(", 
       SubscriptBox["r", "0"], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "0"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"6e49b9b3-158c-4aed-bbfd-af007d5ffc81"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Psi]", "lm", "\[PlusMinus]"], TraditionalForm]],
  ExpressionUUID->"ddd55b0d-4162-461e-a756-ad88b7e5e0df"],
 " are the left and right solutions.\nThe \[Delta] term comes about because \
the retarded (and puncture) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "ab"], TraditionalForm]],ExpressionUUID->
  "c6708497-bf17-4c71-9a6f-7c55e865d96f"],
 " is only ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", "0"], TraditionalForm]],ExpressionUUID->
  "30de49b6-f7c0-42c0-908f-4826820608bb"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "7d06f251-7247-4b58-816a-0ad0f0fa1dea"],
 ". In principle, one could find ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]\[Psi]", "(", 
    SubscriptBox["r", "0"], ")"}], TraditionalForm]],ExpressionUUID->
  "613b5648-246c-4b9f-bfc6-591ad7b75d32"],
 " by looking at the jump of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[PartialD]", "r", "2"], 
    SubscriptBox["h", "ab"]}], TraditionalForm]],ExpressionUUID->
  "69447888-d725-4051-8c54-2a0ffef4315e"],
 " across ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "0"]}], TraditionalForm]],ExpressionUUID->
  "fb0de1ad-223b-4e98-9f28-d3b700717f55"],
 ".\nHere, we will cheat a little bit: By applying the Teukolsky to the above \
form of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "lm", "ret"], "(", "r", ")"}], 
   TraditionalForm]],ExpressionUUID->"427f2c03-fed6-4ffa-8aed-f94e3d8a4476"],
 " and matching the LHS and the RHS, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]\[Psi]", "(", 
    SubscriptBox["r", "0"], ")"}], TraditionalForm]],ExpressionUUID->
  "54dd2159-7753-40b8-a391-61887333c8eb"],
 " will be fixed by equating the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"~", "\[Delta]"}], "''"}], 
    RowBox[{"(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "46f342c1-e66d-4137-93ed-9cd27ef5387c"],
 " coefficients. We then use that to check the other two coefficients.\nNote: \
we make sure that the coefficients of the \[Delta]-functions on both sides \
are always evaluated at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "fc5887e0-7b09-4c56-a874-557ab39d228a"],
 ", using the usual formulae:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"F", 
      RowBox[{"(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], "   ", "=", "     ", 
     RowBox[{
      RowBox[{"F", "(", 
       SubscriptBox["x", "0"], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"F", "'"}]}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "''"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"F", "''"}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], " ", "-", 
      RowBox[{"2", " ", 
       RowBox[{"F", "'"}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "''"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e479426f-9646-4db1-bd77-8dd8a9cbfbbf"]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.896352480664393*^9, 3.8963529350786963`*^9}, {
  3.896361854230186*^9, 
  3.8963619775886927`*^9}},ExpressionUUID->"57a8ada9-0336-4838-9fa9-\
91c4f2c60875"],

