   3.918726971712178*^9},ExpressionUUID->"b85e92e2-9f1f-49bb-9625-\
7f481ec0fc8a"],

Cell["\<\
Check that the homogeneous solutions are indeed solutions to the homogeneous \
Teukolsky equation.\
\>", "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.8963524213450613`*^9, 
  3.896352448976725*^9}},ExpressionUUID->"aa905a8f-765c-431b-9f3d-\
100cb71a0268"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"my\[CapitalDelta]", ",", "myK", ",", "my\[Lambda]"}], "]"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[CapitalDelta]", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", "^", "2"}], "-", 
    RowBox[{"2", " ", "M", " ", "r"}]}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"myK", "[", "m_", "]"}], "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", 
    RowBox[{"\[Omega]m", "[", "m", "]"}]}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"my\[Lambda]", "[", 
    RowBox[{"l_", ",", "s_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"l", " ", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}], " ", "-", 
    RowBox[{"s", " ", 
     RowBox[{"(", 
      RowBox[{"s", "+", "1"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8962405018803883`*^9, 3.896240525855769*^9}, {
  3.8962406074309063`*^9, 3.896240645091634*^9}, {3.896240989620165*^9, 
  3.8962410449901047`*^9}, {3.992141911246063*^9, 3.992141912030739*^9}, {
  3.9921420161041603`*^9, 3.9921420169073763`*^9}, {3.99250114984229*^9, 
  3.9925011504714947`*^9}},
 CellLabel->
  "In[896]:=",ExpressionUUID->"b948f081-e2d5-4c96-9d28-c0aebb2d6df6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"myl", " ", "=", " ", "18"}], ";", " ", 
   RowBox[{"mym", " ", "=", " ", "16"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"construct", " ", "a", " ", "numerical", " ", "sol"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]HomogN", "[", "Weylspin", "]"}], "[", 
    RowBox[{"myl", ",", "mym"}], "]"}], "=", 
   RowBox[{"TeukolskyRadial", "[", "\[IndentingNewLine]", 
    RowBox[{"Weylspin", ",", "myl", ",", "mym", ",", "aKerr", ",", 
     RowBox[{"\[Omega]m", "[", "mym", "]"}], ",", 
     RowBox[{"WorkingPrecision", "->", "TeukolskyPrecision"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"\"\<NumericalIntegration\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<Domain\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<In\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"rNumInbd", ",", "r0"}], "}"}]}], ",", 
           RowBox[{"\"\<Up\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"r0", ",", "rNumOutbd"}], "}"}]}]}], "}"}]}]}], 
       "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
