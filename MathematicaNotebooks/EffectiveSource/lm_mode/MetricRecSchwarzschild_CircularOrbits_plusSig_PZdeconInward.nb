       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"RHS", " ", "term", " ", "3"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "...", ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         RowBox[{"-", "r"}], "+", 
