     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
            "2", " ", "\[ImaginaryI]", " ", "m", " ", 
             "\[CapitalOmega]\[CurlyPhi]"}], 
            RowBox[{
             RowBox[{"2", " ", "M"}], "-", "rmin"}]]}], "  ", 
          RowBox[{
           RowBox[{"hPlnLeft", "[", 
