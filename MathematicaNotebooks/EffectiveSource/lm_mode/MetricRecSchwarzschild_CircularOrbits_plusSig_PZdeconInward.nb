cde97b38b345"],

Cell[TextData[{
 "Outward integration: In Schwarzschild case, the outward integration formula \
reduces to H.20 in reconstruction paper.\nNote that we added a minus sign to \
change it into mostly positive convention.\nUsing the ODE for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "700d4b9b-a70c-44ef-b009-66674e4b94f4"],
 " (eq. (56)), we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}]], "(", 
          SubscriptBox["r", "max"], ")"}]}], " ", "+", " ", 
        RowBox[{"(", 
         RowBox[{"\[Delta]", " ", "and", " ", 
          RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
          SubscriptBox["r", "max"], " ", "of", " ", 
          SubscriptBox["T", "ll"]}], ")"}]}], ")"}]}], " ", "+", "  ", 
     RowBox[{
      FractionBox[
       SubscriptBox["\[Rho]", "max"], "2"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubsuperscriptBox["r", "max", "2"]}], 
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]], "'"}], 
          RowBox[{"(", 
           SubscriptBox["r", "max"], ")"}]}], " ", "+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "max"], " ", "of", " ", 
           SubscriptBox["T", "ll"]}], ")"}]}], ")"}], "."}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"e8d4b8a6-ab3e-4e1b-8362-04a5b4d7c63a"],
 "\nFor the second term, used that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["r", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"a593faf8-c0d1-4839-921b-5ae26ede2ed6"],
 ". Also, the distributional contributions at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "1620b56d-7c9a-49c1-b680-132832f1e706"],
 " are already included in the construction of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "15352ad8-abb9-4c6e-a0b2-5e1d78900c2b"],
 ".\n\nInward integration: In Schwarzschild case,\nUsing the ODE for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "f3680439-55ee-45e5-8e01-a67155f3e4b7"],
 " (eq. (56)), we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}]], "(", 
          SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
        RowBox[{"(", 
         RowBox[{"\[Delta]", " ", "and", " ", 
          RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
          SubscriptBox["r", "rmin"], " ", "of", " ", 
          SubscriptBox["T", "ll"]}], ")"}]}], ")"}]}], " ", "+", "  ", 
     RowBox[{
      FractionBox[
       SubscriptBox["\[Rho]", "min"], "2"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubsuperscriptBox["r", "min", "2"]}], 
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]], "'"}], 
          RowBox[{"(", 
           SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "min"], " ", "of", " ", 
           SubscriptBox["T", "ll"]}], ")"}]}], ")"}], "."}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"09563b03-097a-4277-b46f-625dc48ada01"],
 "\nFor the second term, used that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["r", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"0b051f89-fd92-438b-99ca-d3f327eae863"],
 ". Also, the distributional contributions at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "b0c7c484-94e6-40d1-97c7-2e8b71945ae0"],
 " are already included in the construction of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "4004d235-6a05-4f63-ab36-316ef29078b4"],
 "."
}], "Text",
 CellChangeTimes->{{3.8935809208418493`*^9, 3.893581133472534*^9}, {
  3.89358146160606*^9, 3.89358146181406*^9}, {3.893581895155189*^9, 
