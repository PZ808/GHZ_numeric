       RowBox[{"{", 
        RowBox[{"c", ",", "1", ",", "ndim"}], "}"}]}], "]"}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gmetNullDD", "[", 
