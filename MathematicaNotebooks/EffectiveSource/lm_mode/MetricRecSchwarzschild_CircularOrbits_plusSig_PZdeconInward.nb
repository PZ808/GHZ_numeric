     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"hP\[CapitalDelta]rExpansion", "[", "7", "]"}], "[", 
        RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"hP\[CapitalDelta]rExpansion", "[", "10", "]"}], "[", 
         RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}]}]}], 
     ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "l"}], ")"}], " ", "l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", "l"}], ")"}]}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"r0", "+", "\[CapitalDelta]r"}], ")"}]}], ")"}]}]}], 
  ";"}]}], "Input",
