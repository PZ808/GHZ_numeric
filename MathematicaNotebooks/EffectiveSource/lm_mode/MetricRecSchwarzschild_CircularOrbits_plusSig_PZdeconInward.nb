           RowBox[{"{", 
            RowBox[{"r2", ",", 
             RowBox[{"rmin", "-", "\[Epsilon]"}], ",", "r"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r1", ",", 
             RowBox[{"rmin", "-", "\[Epsilon]"}], ",", "r2"}], "}"}]}], 
          "]"}]}]}], "]"}], "  ", "/.", " ", 
      RowBox[{"r", " ", "->", " ", 
