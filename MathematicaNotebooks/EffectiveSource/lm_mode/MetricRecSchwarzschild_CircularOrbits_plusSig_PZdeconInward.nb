Cell[TextData[{
 "Note that the values of \[Alpha] and \[Beta] were once computed using \
power-series expanded expressions of the puncture.\nIn this case, we actually \
found that only the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]r", "0"], TraditionalForm]],ExpressionUUID->
  "b546df88-4fb2-4903-863e-6b88a6e4a2e2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]r", "1"], TraditionalForm]],ExpressionUUID->
  "7b576f48-bcfa-4d28-80b6-92eed96ae883"],
 " contribute, and value is independent on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "0f5e0e3d-21fd-4407-8613-8b9e31614c84"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "664a67ec-5f07-45cf-aa7f-a03c1f21c473"],
 ".\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalXi]", "a"], TraditionalForm]],ExpressionUUID->
  "a02ced9e-0de7-46d4-bd12-8c046ab95bf2"],
 " should be independent of convention."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.893583150963532*^9, 3.8935832609092407`*^9}, {
  3.897973831901772*^9, 3.8979738341048527`*^9}, {3.898843349019253*^9, 
