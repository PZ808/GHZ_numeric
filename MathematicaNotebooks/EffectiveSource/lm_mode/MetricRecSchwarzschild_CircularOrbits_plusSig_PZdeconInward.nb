Cell[CellGroupData[{

Cell[TextData[{
 "Check --- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
     RowBox[{
      SuperscriptBox["h", "Res"], "+", 
      SuperscriptBox["h", "P"], "+", 
      SubscriptBox["x", "ab"]}], ")"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"7128926e-5b61-4161-8234-5a42bcec1fbf"]
}], "Chapter",
 Evaluatable->False,
 CellChangeTimes->{{3.893182743530898*^9, 3.893182808324532*^9}, {
  3.893825692953958*^9, 3.893825693772038*^9}, {3.893826662294035*^9, 
  3.8938266625240183`*^9}, {3.898679513664319*^9, 3.8986795152089567`*^9}, {
  3.898788724502653*^9, 
  3.898788724944303*^9}},ExpressionUUID->"9adf3bdf-e4a8-44f9-ad64-\
62a108d31082"],

Cell[TextData[{
 "We already checked previously that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
     OverscriptBox["g", "."], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
      RowBox[{
       SubscriptBox["\[ScriptCapitalL]", "\[CapitalXi]"], 
       SubscriptBox["g", "ab"]}], ")"}], "=", "0"}]}], TraditionalForm]],
  ExpressionUUID->"b55090fa-4c50-483e-992e-b5d242e73e96"],
 ".\nIn principle, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
     RowBox[{
      SuperscriptBox["h", "Res"], "+", 
      SuperscriptBox["h", "P"], "+", 
      SubscriptBox["x", "ab"]}], ")"}], " "}], TraditionalForm]],
  ExpressionUUID->"7c306656-127a-43df-ba9a-58b38d357c92"],
 " is made up of three things: a smooth piece, a piece ~ \[Delta] at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "8c5a6c67-5cd0-4630-ba9e-3d453bebb926"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "305c4a8b-e568-46fa-97a5-49288066c5a0"],
 " and a piece \[Delta]\[CloseCurlyQuote] at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "2c6e40bc-7c0b-482b-9c60-e659af1acde0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "2a8a6b82-385b-4dc7-9269-fa44142c2d8b"],
 ". All these contributions need to vanish.\n",
 StyleBox["For distributional pieces, we will focus on ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "1924e63a-ad56-4ef2-9bdc-c14efe8e129f"],
 StyleBox[".",
  FontColor->RGBColor[0, 0, 1]],
 "\n\nTo set this up, use \[ScriptCapitalE]hPWorldtubePiece, \
\[ScriptCapitalE]hP\[Delta]RminPiece, and \
\[ScriptCapitalE]hP\[Delta]RminPiece defined in the \
\[OpenCurlyDoubleQuote]Operator\[CloseCurlyDoubleQuote] section. It is \
important to do the following:\n1) Compute these three quantities first \
making sure that ",
 StyleBox["the input for ",
  FontVariations->{"Underline"->True}],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],
  FontVariations->{"Underline"->True},ExpressionUUID->
  "018719a9-6cd3-42cb-b4db-5676bf822895"],
 StyleBox[" is written in t slicing. ",
  FontVariations->{"Underline"->True}],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
    SuperscriptBox["h", "P"], ")"}], TraditionalForm]],
  FontVariations->{"Underline"->False},ExpressionUUID->
  "0c3c99c4-11ca-4064-b2c2-4ceda494ca92"],
 " itself should be given in u slicing.",
 StyleBox["\n",
  FontVariations->{"Underline"->True}],
 "2) Run the \[OpenCurlyDoubleQuote]Effective stress-energy\
\[CloseCurlyDoubleQuote] section.\n3) Now, rerun the \
\[OpenCurlyDoubleQuote]Operator section\[CloseCurlyDoubleQuote] (specifically \
the subsection which computed the linearised Einstein operator), but this \
time, make sure that \[ScriptCapitalE]hPWorldtubePiece, \[ScriptCapitalE]hP\
\[Delta]RminPiece, and \[ScriptCapitalE]hP\[Delta]RminPiece are written in u \
slicing for both input and output. The reason is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubsuperscriptBox["T", "ab", "R"], " ", ":=", " ", 
     RowBox[{"-", 
      RowBox[{
       SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
       SuperscriptBox["h", "P"], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c4bdffec-160c-4260-ad73-5150109b8442"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "e2029a40-c0d9-4bcd-af94-3e8088fe157d"],
 " is given in t slicing. On the other hand, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "Res"], TraditionalForm]],ExpressionUUID->
  "53d9f113-c89f-4323-9a07-7ad59298abd8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "ab"], TraditionalForm]],ExpressionUUID->
  "55d7258d-6b34-4d8d-a0bb-af7a5871af29"],
 " are both given in u slicing."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8931827961503477`*^9, 3.893183187397998*^9}, {
  3.893183221675706*^9, 3.893183294880938*^9}, {3.893183853406049*^9, 
  3.893183885595065*^9}, {3.895491054747746*^9, 3.89549105504883*^9}, {
  3.898761674941086*^9, 3.898761674990057*^9}, {3.898788875535944*^9, 
  3.898788879543975*^9}},ExpressionUUID->"24c99a09-18e9-4f24-a31f-\
f25b6b530ab3"],

