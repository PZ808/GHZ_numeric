Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Comparing", " ", 
    SubsuperscriptBox["\[Psi]", "0", "Res"]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"rGrid", ",", "diff", ",", "diffInterpol"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rGrid", " ", "=", " ", 
     RowBox[{"DeleteElements", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"rmin", "+", 
          RowBox[{"i", " ", 
