Cell[TextData[{
 "Eq. (57) is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", 
         RowBox[{"-", "2"}]], " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "r"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r", "2"], 
           SubscriptBox["x", "nm"], " ", 
           RowBox[{"H", "(", 
            RowBox[{
             RowBox[{"-", "r"}], "+", 
             SubscriptBox["r", "max"]}], ")"}]}], ")"}]}]}], ")"}]}]}], " ", "=",
     " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["T", "lm"], "+", 
      SubscriptBox["\[ScriptCapitalN]x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]]}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["T", "lm"], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "r"], 
         RowBox[{"+", 
          FractionBox["1", "r"]}]}], ")"}], 
       SubscriptBox["\[Eth]x", 
        RowBox[{"m", 
         OverscriptBox["m", "_"]}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "ddad3e1e-0ba9-4959-89e8-4862c467facd"],
 "\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{"LHS", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "r"], 
         SubscriptBox["x", "nm"]}], "+", 
        SubscriptBox[
         RowBox[{"x", "'"}], "nm"]}], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      SubscriptBox["x", "nm"], 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"\t", 
    RowBox[{"=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "...", ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         RowBox[{"-", "r"}], "+", 
         SubscriptBox["r", "max"]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", 
           SubscriptBox["r", "min"]], 
          SubsuperscriptBox["x", "nm", "+"]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           RowBox[{"x", "'"}], "nm", "+"]}]}], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SubsuperscriptBox["x", "nm", "+"], 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "max"]}], ")"}]}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"RHS", " ", "term", " ", "1"}], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[Delta]T", "lm", "+"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]T", "lm", "+"], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"RHS", " ", "term", " ", "2"}], " ", "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      SubsuperscriptBox["\[Eth]x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}], "+"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"\[Rule]", " ", "RHS"}], " ", "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "...", ")"}], 
      RowBox[{"H", "(", 
       RowBox[{
        RowBox[{"-", "r"}], "+", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[Delta]T", "lm", "+"], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         SubsuperscriptBox["\[Eth]x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}], "+"]}]}], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}], "+", 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]T", "lm", "+"], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "max"]}], ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Implies]", " ", 
      SubsuperscriptBox["x", "nm", "+"]}], " ", "=", " ", 
     RowBox[{"2", 
      SubsuperscriptBox["\[CapitalDelta]T", "lm", "+"]}]}], ",", 
    "           ", 
    RowBox[{
     SubsuperscriptBox[
      RowBox[{"x", "'"}], "nm", "+"], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Eth]", "-"], 
         SubsuperscriptBox["x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}], "+"]}], "+", 
        RowBox[{
         FractionBox["4", 
          SubscriptBox["r", "max"]], 
         SubsuperscriptBox["\[CapitalDelta]T", "lm", "+"]}], "-", 
        RowBox[{"2", 
         SubsuperscriptBox["\[Delta]T", "lm", "+"]}]}], ")"}]}]}]}], 
   TraditionalForm]}], "Text",ExpressionUUID->
  "03dfe56a-4df1-490d-bc1a-ab4b8877df72"]
}], "Text",
