      RowBox[{"-", 
       RowBox[{
        RowBox[{
         RowBox[{"xnmNDSolve", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "'"}], "[", "rmin", "]"}]}], "-", 
      RowBox[{"2", " ", "\[Rho]min", " ", 
       RowBox[{
        RowBox[{"xnmNDSolve", "[", 
         RowBox[{"1", ",", "0"}], "]"}], "[", "rmin", "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"cCirc\[Delta]And\[Delta]pContributionAtRmin", "[", 
        RowBox[{"1", ",", "0"}], "]"}]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.893582295928719*^9, 3.8935823142103148`*^9}, {
   3.893582556852359*^9, 3.89358255947954*^9}, 3.898841374659924*^9, 
   3.898841908277039*^9, {3.89884242910393*^9, 3.898842429445335*^9}, {
   3.919313844406082*^9, 3.919313891099927*^9}, {3.9193139677394876`*^9, 
   3.919313980238304*^9}, {3.992505931829967*^9, 3.992505944030613*^9}, {
