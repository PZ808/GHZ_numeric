Cell[CellGroupData[{

Cell["Corrector tensor left of WT", "Chapter",
 CellChangeTimes->{{3.993028335833125*^9, 
  3.993028353654931*^9}},ExpressionUUID->"061db7d4-7587-4180-ad07-\
8aa0a273978a"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 RowBox[{
  SuperscriptBox["a", "o"], ",", 
  SuperscriptBox["b", "o"], ",", 
  SuperscriptBox["c", "o"]}]],
 CellChangeTimes->{
  3.8798421842272053`*^9, {3.879842217850469*^9, 
   3.8798422449071913`*^9}},ExpressionUUID->"31d8c323-445f-4834-a9a6-\
95821c675dc9"]], "Section",
 CellChangeTimes->{
  3.879844566117942*^9, {3.87984464460774*^9, 3.8798446481128883`*^9}, {
   3.882947156310356*^9, 3.882947166541945*^9}, {3.88338459157164*^9, 
   3.883384592638061*^9}},ExpressionUUID->"7634a2c1-e91a-4b01-ac5a-\
9219fefbf533"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["a", "o"], 
  TraditionalForm]],ExpressionUUID->"02dde5b8-ee3a-4ed6-83bf-a7116858d8cb"]], \
"Subsection",
 CellChangeTimes->{{3.893580888154965*^9, 
  3.893580889881576*^9}},ExpressionUUID->"4fdcfd19-9103-4644-8003-\
070d3c679bd9"],

Cell[TextData[{
 "Inward integration: In Schwarzschild case,\nUsing the ODE for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "e2e307c9-2ed6-4193-b161-bb5bc10217bf"],
 " (eq. (56)), we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"m", 
            OverscriptBox["m", "_"]}]], "(", 
          SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
        RowBox[{"(", 
         RowBox[{"\[Delta]", " ", "and", " ", 
          RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
          SubscriptBox["r", "rmin"], " ", "of", " ", 
          SubscriptBox["T", "ll"]}], ")"}]}], ")"}]}], " ", "+", "  ", 
     RowBox[{
      FractionBox[
       SubscriptBox["\[Rho]", "min"], "2"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubsuperscriptBox["r", "min", "2"]}], 
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]], "'"}], 
          RowBox[{"(", 
           SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "min"], " ", "of", " ", 
           SubscriptBox["T", "ll"]}], ")"}]}], ")"}], "."}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"d922db90-6ebd-4c2f-8c25-79b2435367e5"],
 "\nFor the second term, used that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["r", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"bad1a881-20c7-41bb-82b4-e1201e7dc5ef"],
 ". Also, the distributional contributions at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "25a7a0d0-1a60-4e27-9da3-3600aa315b28"],
 " are already included in the construction of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "6017525d-23d0-4dc0-8ab4-8504ea7c3a29"],
 "."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.8935809208418493`*^9, 3.893581133472534*^9}, {
