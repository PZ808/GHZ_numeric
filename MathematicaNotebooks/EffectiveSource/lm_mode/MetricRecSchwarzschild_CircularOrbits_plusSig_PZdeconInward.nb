  3.8929723017940683`*^9}},ExpressionUUID->"b1a7f397-4462-439c-a18a-\
0a54d84a0e60"],

Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], while in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"39c50022-42d4-431a-bee9-f4d93ab396c3"],
 "."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 
  3.8929713039202633`*^9}},ExpressionUUID->"ffe1aa91-e874-49e0-897c-\
c23bf6873ca8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xmmbAt\[Rho]maxViaIntegration", "[", 
    RowBox[{"l", ",", "m"}], "]"}], "  ", "==", "  ", 
   RowBox[{"xmmbAt\[Rho]maxViaODE", "[", 
    RowBox[{"l", ",", "m"}], "]"}]}], " ", "//", " ", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]min", "^", "2"}], " ", 
     RowBox[{"xmmbpAt\[Rho]maxViaIntegration", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}], "  ", "==", "  ", 
    RowBox[{"xmmbpAt\[Rho]maxViaODE", "[", 
     RowBox[{"l", ",", "m"}], "]"}]}], " ", "/.", " ", 
   RowBox[{"\[Rho]max", "->", "  ", 
    RowBox[{"\[Rho]OfrK", "[", "rmax", "]"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.89297106992463*^9, 3.892971100841628*^9}, {
