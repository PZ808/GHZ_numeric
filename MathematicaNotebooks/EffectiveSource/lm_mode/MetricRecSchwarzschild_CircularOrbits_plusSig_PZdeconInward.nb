Cell[TextData[{
 "When acting on an spin-0 object of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "r", ")"}], 
    RowBox[{"H", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "min"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "61367a48-803e-4259-bd1e-909665f65d32"],
 ", we get two terms, one proportional to the Heaviside function and a delta \
function."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{
  3.89298555146173*^9, {3.892985627716631*^9, 
