Cell[BoxData[{
 RowBox[{"Clear", "[", "dint", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dint", "[", 
   RowBox[{"x_", ",", "p_", ",", "m_", ",", "r_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Factor", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"m", "/", "2"}], ",", "i"}], "]"}], 
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"m", "/", "2"}], ",", 
           RowBox[{"n", "-", "i"}]}], "]"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Delta]", "^", "2"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", "i"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "+", "n"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "+", 
            RowBox[{"\[Delta]", "^", "2"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", "n", "+", "i"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}], 
     RowBox[{"dR", "[", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "p"}], ",", "r", ",", "\[Delta]"}], "]"}]}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "0", ",", "m"}], "}"}]}], "]"}]}]}], "Input",
 Evaluatable->False,
