Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], while in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"7fc0f166-7b59-4ef5-9b17-20baf58c695a"],
 "."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 
  3.8929713039202633`*^9}},ExpressionUUID->"7395825c-1986-4132-a210-\
213eab71d8ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xnmbAt\[Rho]maxViaIntegration", "[", 
    RowBox[{"l", ",", "m"}], "]"}], " ", "==", " ", 
   RowBox[{"xnmbAt\[Rho]maxViaODE", "[", 
    RowBox[{"l", ",", "m"}], "]"}]}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"xnmbIntegrand\[Delta]pCoeff", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], "->", " ", 
   RowBox[{"Tlmb\[Delta]pCoeff", "[", 
    RowBox[{"l", ",", "m"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]max", "^", "2"}], " ", 
        RowBox[{"xnmbpAt\[Rho]maxViaIntegration", "[", 
         RowBox[{"l", ",", "m"}], "]"}]}], " ", "==", " ", 
       RowBox[{"xnmbpAt\[Rho]maxViaODE", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}], " ", " ", "/.", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"xnmbIntegrand\[Delta]Coeff", "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], "->", " ", 
         RowBox[{
          RowBox[{"Tlmb\[Delta]Coeff", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", 
           RowBox[{
            RowBox[{"\[Eth]pCK", "[", 
             RowBox[{"0", ",", "l"}], "]"}], "[", 
            RowBox[{"xmmb", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"xnmbIntegrand\[Delta]pCoeff", "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
         RowBox[{"Tlmb\[Delta]pCoeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}]}], "}"}]}], " ", "/.", "  ", 
     RowBox[{"\[Eth]pxmmb", " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Eth]pCK", "[", 
        RowBox[{"0", ",", "l"}], "]"}], "[", 
       RowBox[{"xmmb", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "]"}]}]}], " ", "/.", " ", 
    RowBox[{"r", " ", "->", " ", "rmax"}]}], " ", "/.", " ", 
   RowBox[{"\[Rho]max", " ", "->", " ", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "rmax"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellChangeTimes->{{3.892976121646153*^9, 3.8929761400252028`*^9}, {
