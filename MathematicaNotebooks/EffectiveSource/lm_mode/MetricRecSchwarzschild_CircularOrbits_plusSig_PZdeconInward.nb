               "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"xnnNDSolveRight", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "[", "\[Rho]_", "]"}], "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
