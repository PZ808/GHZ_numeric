3edb998d39bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"energy", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       RowBox[{"M", "/", "r0"}]}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", 
