Cell[CellGroupData[{

Cell["Check --- point-particle source", "Section",
 Evaluatable->False,
 CellChangeTimes->{
  3.879844604131274*^9, {3.8798446588151484`*^9, 3.879844659126225*^9}, {
   3.885459988034794*^9, 3.885459989465703*^9}, {3.898756548541026*^9, 
   3.8987565524233837`*^9}},ExpressionUUID->"41619e58-d7f9-4ddb-a6eb-\
bf66d6dc0032"],

Cell["Not evaluable.", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8935831258905563`*^9, 3.8935831301234207`*^9}},
 FontColor->RGBColor[
  1, 0, 0],ExpressionUUID->"81be30a7-878c-4341-8a13-e2eb4f0d328e"],

Cell[CellGroupData[{

Cell["Theory", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.88216713000215*^9, 
  3.882167132303095*^9}},ExpressionUUID->"9df9a1a0-c4b9-4ab3-b0f2-\
37da1bde60e6"],

Cell[TextData[{
 "See arXiv:1503.02414, below eq. (25). Compare also (31)-(32) with \
(24)-(25).\nThere is a typo and it should read: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Xi]", "\[Mu]"], "=", " ", 
     RowBox[{"\[Mu]", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          OverscriptBox["\[CapitalEpsilon]", "^"], 
          RowBox[{
           SubscriptBox["r", "0"], 
           SubscriptBox["f", "0"]}]], " ", 
         SuperscriptBox["t", "\[Mu]"]}], " ", "+", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"2", " ", 
           SubscriptBox["L", "z"]}], 
          SubsuperscriptBox["r", "0", "3"]], 
         SuperscriptBox["\[Phi]", "\[Mu]"]}]}], ")"}], " ", 
      RowBox[{"\[CapitalTheta]", "(", 
       RowBox[{
        SubscriptBox["r", "0"], "-", "r"}], ")"}]}]}], ","}], 
   TraditionalForm]],ExpressionUUID->"4b6012b6-5fb1-48c1-baf7-a735f7e9977f"],
 " where \[Mu] is particle mass, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["E", "^"], " ", "=", 
     FractionBox[
      RowBox[{" ", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", "M"}], 
         SubscriptBox["r", "0"]]}]}], 
      SqrtBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", "M"}], 
         SubscriptBox["r", "0"]]}]]]}], ",", " ", 
    RowBox[{
     SubscriptBox["L", "z"], " ", "=", 
     SqrtBox[
      FractionBox[
       SubscriptBox["Mr", "0"], 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", "M"}], 
         SubscriptBox["r", "0"]]}]]], " "}]}], TraditionalForm]],
  ExpressionUUID->"57e6151c-8cac-4be5-ab61-69b9d9de1149"]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.879844111732706*^9, 3.879844389511216*^9}, 
   3.8798444874577427`*^9, 3.8833786565038*^9, 3.884611386981711*^9, {
   3.898842478467607*^9, 3.898842480317499*^9}, {3.898843115649332*^9, 
   3.898843115801608*^9}},ExpressionUUID->"15bb27eb-db53-4733-ac32-\
06adb0880a6b"],

Cell[TextData[{
 "First, can check this by computing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], ",", " ", 
    RowBox[{
     SuperscriptBox["b", "o"], " ", "and", " ", 
     SuperscriptBox["c", "o"]}]}], TraditionalForm]],ExpressionUUID->
  "25aa5a7f-7575-4e34-ac14-3f2d20edd547"],
 " for a point particle-source: reconstruction paper, H.20. Note that the \
final answer should not depend on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "a2028faf-a72b-47b8-8e9e-98fc29149024"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "87a4b414-16f6-413f-8a52-a18ec7164430"],
 "! Also, need to add a minus sign in definition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], ",", " ", 
    RowBox[{
     SuperscriptBox["b", "o"], " ", "and", " ", 
     SuperscriptBox["c", "o"]}]}], TraditionalForm]],ExpressionUUID->
  "1cf9265e-55a7-49f0-b31d-1705bc67adfa"],
 " to change to mostly positive signature.\nUse that: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "ab"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["f", "ab"], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"r", "-", 
       SubscriptBox["r", "0"]}], ")"}], " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"46846854-1aab-4458-a53b-ce04c8ae14ca"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "ab"], " ", ":=", " ", 
    RowBox[{"8", "\[Pi]", 
     FractionBox[
      RowBox[{
       SubscriptBox["u", "a"], 
       SubscriptBox["u", "b"]}], 
      RowBox[{
       SubsuperscriptBox["r", "0", "2"], 
       SuperscriptBox["u", "t"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "3151b504-8b67-4b01-ab5b-8b7f96ce8fa1"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], "=", 
    RowBox[{
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Theta]", "-", 
       RowBox[{"\[Pi]", "/", "2"}]}], ")"}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Phi]", "-", "\[Omega]t"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"717a356a-6985-4748-be07-a8e4b2056495"],
 ". (8\[Pi] is included in the definition of the stress energy in the \
papers).\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Rho]", "0", "2"], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{"\[Rho]", "-", 
       SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ab9e3b13-d5a9-4b2b-9505-84a2c9653efe"],
 ", and from (C.3): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"l", ",", "m"}]], " "}], "s"], 
     SubscriptBox[
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["Y", "_"], "lm"], "(", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}], " "}], "s"], 
     
     RowBox[{
      SubscriptBox["Y", "lm"], "(", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"9baba482-fca6-4b96-a2e2-d5a92f36a41f"],
 ".\n\t\t\nFirst term for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "9cf1cdc2-b32d-46f2-bd9f-11ae9728b79a"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Rho]", "max"], "-", 
      SubscriptBox["\[Rho]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"4f2c9847-a0f3-4f78-bff0-d748008f58d4"],
 ".  (Do take care that integrating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "(", 
    RowBox[{
     SubscriptBox["\[Rho]", "1"], "-", 
     SubscriptBox["\[Rho]", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "0db54510-8213-4c17-8e2f-ca50fe9572cc"],
 " will give you Heaviside functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "(", 
    RowBox[{
     SubscriptBox["\[Rho]", "2"], "-", 
     SubscriptBox["\[Rho]", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "ba215c64-80d5-4898-a448-069c0bab6de8"],
 "). E.g.:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SubscriptBox["\[Rho]", "min"], 
       SubscriptBox["\[Rho]", "2"]], 
      RowBox[{
       SubscriptBox["d\[Rho]", "1"], " ", 
       SubsuperscriptBox["\[Rho]", "1", 
        RowBox[{"-", "4"}]]}]}], 
     RowBox[{"\[Delta]", "(", 
      RowBox[{
       SubscriptBox["r", "1"], "-", 
       SubscriptBox["r", "0"]}], ")"}]}], "=", "  ", 
    RowBox[{
     SubsuperscriptBox["\[Rho]", "0", 
      RowBox[{"-", "2"}]], 
     RowBox[{
      RowBox[{"H", "(", 
       RowBox[{
        SubscriptBox["\[Rho]", "2"], "-", 
        SubscriptBox["\[Rho]", "0"]}], ")"}], " ", "."}]}]}], 
   TraditionalForm]],ExpressionUUID->"426d08c7-1f8f-4c6b-bb9e-7e9e6c92cce6"],
 "\nSecond term gives: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["f", "ll"], 
     RowBox[{"2", " ", 
      SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    SubscriptBox["\[Rho]", "max"]}], TraditionalForm]],ExpressionUUID->
  "956c9411-5f6d-448f-a7ba-34c43b8df03d"],
 ".\nAdding both terms together, the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "max"], TraditionalForm]],ExpressionUUID->
  "2d951962-4cfe-46ed-a5c1-31dc8e3fd1f5"],
 " cancel and we get:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "o"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubscriptBox["\[Rho]", "0"]}]], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"a6922e4f-fd83-4e65-a6fc-386a1175aed2"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"->", "    ", 
     SubsuperscriptBox["a", "lm", "o"]}], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubscriptBox["\[Rho]", "0"]}]], "  ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"624fff53-69c6-4694-9d21-099035e9a353"],
 ". (s=0).\n\t\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "o"], TraditionalForm]],ExpressionUUID->
  "e36bbb3a-fac6-46c6-a05e-a6728d1f078e"],
 " is just proportional to the second term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "cf8c511f-f68a-4bb8-b9b1-417421d07aca"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "o"], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"fd3e6475-ca18-4f47-ae72-b1ba3c974c0d"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"->", "    ", 
     SubsuperscriptBox["b", "lm", "o"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], "  ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"b940fd65-25c2-4c77-bc9f-5d8de20317ea"],
 ". (s=0).\n\t\nFor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "dbc9d059-3db7-406e-85b2-79003d0af943"],
 ", first note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eth]", " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], " ", "=", 
    RowBox[{"\[Rho]", " ", 
     SqrtBox[
      FractionBox[
       RowBox[{" ", 
        RowBox[{"l", "(", 
         RowBox[{"l", "+", "1"}], ")"}]}], "2"]], " ", 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"l", ",", "m"}]], " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{
          SubscriptBox[
           OverscriptBox["Y", "_"], "lm"], "(", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}], " "}], 
        "1"], 
       RowBox[{
        SubscriptBox["Y", "lm"], "(", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0630743f-f636-424a-9014-3ce4805f1a23"],
 ". (we only really care about the case s=0 here). Note that we suppress spin \
if s=0.\nFirst term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "9c35db5f-cf44-460e-9802-3193de06e839"],
 " is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["\[Rho]", "max", "2"]}], " ", 
    FractionBox[
     SubscriptBox["f", "ll"], 
     RowBox[{"2", 
      SubsuperscriptBox["\[Rho]", "0", "2"]}]], 
    OverscriptBox["\[Eth]", "~"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"45e73f5b-f5bc-41b2-a6ff-14e0c793cfa5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Eth]", "~"], "=", 
    RowBox[{
     FractionBox["1", "\[Rho]"], "\[Eth]"}]}], TraditionalForm]],
  ExpressionUUID->"6bc43b79-ec2b-467c-b2b3-588c62194357"],
 " is independent of \[Rho].\nSecond term is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox["f", "lm"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"88416b0c-fa3a-4a1e-8b48-6233436c22d1"],
 ".\nConcerning ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "899d8d45-d174-4635-b7d4-12b4af22c4a8"],
 ", similar calculations show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       SubsuperscriptBox["\[Rho]", "0", "2"]]}], 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
     RowBox[{"H", "(", 
      RowBox[{"\[Rho]", "-", 
       SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"b51b4834-978c-41df-b5c4-7e8eeaaafd98"],
 ".\nThen: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalN]x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", 
        SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
     OverscriptBox["\[Eth]", "~"], " ", 
     RowBox[{
      SuperscriptBox["\[Delta]", "2"], "(", 
      RowBox[{"\[CapitalOmega]", "-", 
       SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
     SuperscriptBox["\[Rho]", "3"], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H", "(", 
         RowBox[{"\[Rho]", "-", 
          SubscriptBox["\[Rho]", "0"]}], ")"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", "-", 
           SubscriptBox["\[Rho]", "0"]}], ")"}], " ", 
         RowBox[{"\[Delta]", "(", 
          RowBox[{"\[Rho]", "-", 
           SubscriptBox["\[Rho]", "0"]}], ")"}]}]}], ")"}], "."}]}]}], 
   TraditionalForm]],ExpressionUUID->"de480b4c-bc2e-4ee7-9969-c3d8f5f4498f"],
 " The second term can be dropped because the coefficient vanishes at the \
particle.\nSo, third term of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "58549633-d34e-4202-b972-ca136851a539"],
 " is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["f", "ll"], 
     SubsuperscriptBox["\[Rho]", "0", "2"]], 
    OverscriptBox["\[Eth]", "~"], " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], "(", 
     RowBox[{"\[CapitalOmega]", "-", 
      SubscriptBox["\[CapitalOmega]", "0"]}], ")"}], " ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Rho]", "max", "2"], "-", 
       SubsuperscriptBox["\[Rho]", "0", "2"]}], ")"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"de4b7d39-ccee-47df-abf7-9750f8a1d6d0"],
 ".\nAdding everything up, again find that the first term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"~", 
     SubsuperscriptBox["\[Rho]", "max", "2"]}]}], TraditionalForm]],
  ExpressionUUID->"e2f33c0d-13d5-4792-a505-6a7c7ccd57c3"],
 ") cancels with the corresponding expression in the third term.\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "o"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "(", 
         RowBox[{"\[CapitalOmega]", "-", 
          SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        OverscriptBox["\[Eth]", "~"], " ", 
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "(", 
         RowBox[{"\[CapitalOmega]", "-", 
          SubscriptBox["\[CapitalOmega]", "0"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"5d368b65-f686-4ced-ba80-7e4a1c900dc9"],
 ".\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["c", "lm", "o"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox[
         SubscriptBox["f", "lm"], "1"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}], " ", "+", 
       " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        SqrtBox[
         FractionBox[
          RowBox[{" ", 
           RowBox[{"l", "(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "2"]], 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\[Omega]t"}], ")"}]}]}], 
      ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "979b3bfd-b3a0-4289-9d73-7abdb234af3a"],
 ".\n\t\t\nSo, \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["a", "lm", "o"], ">"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      SubscriptBox["f", "ll"], 
      RowBox[{"2", " ", 
       SubscriptBox["\[Rho]", "0"]}]], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"70b0153c-a16d-4517-8e9d-ea777e72688b"],
 ", \t(the averaging basically sets t=0 by periodicity).\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["b", "lm", "o"], ">"}], " ", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SubscriptBox["f", "ll"], 
       RowBox[{"2", " ", 
        SubsuperscriptBox["\[Rho]", "0", "2"]}]]}], 
     RowBox[{
      SubscriptBox[
       OverscriptBox["Y", "_"], "lm"], "(", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"269733a9-272f-46dc-bfc3-3e6bcfe0bbc2"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["c", "lm", "o"], ">"}], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox[
         SubscriptBox["f", "lm"], "1"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["f", "ll"], "2"], 
        SqrtBox[
         FractionBox[
          RowBox[{" ", 
           RowBox[{"l", "(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "2"]], 
        SubscriptBox["f", "lm"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox["Y", "_"], "lm"], "(", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"2c733b38-e241-44c8-86d7-3db3d1c8057a"],
 ".\nNow, computing \[Alpha] and \[Beta] constants of \[CapitalXi], note that \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["Y", "_"], "10"], "(", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], ")"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"e8a1552c-8d6d-4647-93b0-6c85daba0687"],
 " and so the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "o"], TraditionalForm]],ExpressionUUID->
  "fd1851a8-ae6c-4075-bff4-4db65e72885b"],
 " contribution vanishes, as well as second term in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "o"], TraditionalForm]],ExpressionUUID->
  "36678ae4-e27f-478b-8049-89f72531d272"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["a", "00", "o"], ">"}], " ", "=", " ", 
    FractionBox[
     SubscriptBox["f", "ll"], 
     RowBox[{"4", 
      SubscriptBox["\[Rho]", "0"], " ", 
      SqrtBox["\[Pi]"]}]]}], TraditionalForm]],ExpressionUUID->
  "4acce1bf-bbc6-481b-906a-9bcb5be6de62"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["b", "10", "o"], ">"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"ccc4e7ca-2b36-4978-8d81-9f0fa49670a6"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"<", 
     SubsuperscriptBox["c", "10", "o"], ">"}], " ", "=", " ", 
    FractionBox[
     SubscriptBox["f", "lm"], 
     SqrtBox[
      RowBox[{"6", "\[Pi]"}]]]}], TraditionalForm]],ExpressionUUID->
  "130e2d7d-a480-42af-8707-476d652f02c1"],
 ".\n\[Implies]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{
       SubscriptBox["r", "0"], 
       SqrtBox[
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"3", " ", "M"}], 
          SubscriptBox["r", "0"]]}]]}]]}]}], TraditionalForm]],ExpressionUUID->
  "949bf533-1f90-4fd3-a06c-abf7d18e5c35"],
 ", \t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", " ", "=", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"2", 
       SubscriptBox["\[CapitalOmega]", "\[Phi]"]}], 
      RowBox[{
       SubscriptBox["r", "0"], 
       SqrtBox[
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"3", " ", "M"}], 
          SubscriptBox["r", "0"]]}]]}]]}]}], TraditionalForm]],ExpressionUUID->
  "1f84bee5-5816-4622-9395-3de2008d24be"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.882167170720036*^9, 3.8821672019746237`*^9}, {
   3.8821673698920918`*^9, 3.882167726994569*^9}, {3.882167758580556*^9, 
   3.882168062477778*^9}, {3.8821681736594954`*^9, 3.882168245374127*^9}, {
   3.8821682939236937`*^9, 3.882168588072769*^9}, {3.882168686468438*^9, 
   3.882169533778191*^9}, {3.88216960544783*^9, 3.88216969807841*^9}, {
   3.8821697612490263`*^9, 3.882169811075183*^9}, {3.8821698689704742`*^9, 
   3.882169868971867*^9}, {3.882169967319829*^9, 3.882169978750259*^9}, {
   3.882170029614362*^9, 3.882170222048188*^9}, {3.882175971954688*^9, 
   3.882176010460597*^9}, 3.883378656545508*^9, 3.8838075209816723`*^9, {
   3.8846113962688923`*^9, 3.8846113964941797`*^9}, {3.8860567374393463`*^9, 
   3.886056798098012*^9}, {3.886056835656702*^9, 3.886056936784109*^9}, {
