Cell[TextData[{
 "\tThe following allows to auto-replace stuff when you write \
\[OpenCurlyDoubleQuote]tex[\[CloseCurlyDoubleQuote] into \
\[OpenCurlyDoubleQuote]TeXForm[StandardForm[]]\[CloseCurlyDoubleQuote],\n\t\
which is what is needed to  output ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"L", 
     StyleBox[
      AdjustmentBox["A",
       BoxBaselineShift->-0.4,
       BoxMargins->{{-0.5, -0.3}, {0, 0}}],
      FontSize->Smaller], "T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "020dae54-9a59-4db4-98e6-64cec669697b"],
 " code of an equation. The StandardForm is needed if using the notation \
package."
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.7601919042878942`*^9, 3.760192013317361*^9}, {
  3.761758056639923*^9, 3.761758063903331*^9}, {3.770032519536647*^9, 
  3.770032545482421*^9}, {3.89358794986084*^9, 3.893587958560437*^9}, {
  3.897974581100947*^9, 
  3.897974584495674*^9}},ExpressionUUID->"07202516-b92d-4be7-ba94-\
f330924ae6f2"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"CurrentValue", "[", 
    RowBox[{
     RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"InputAutoReplacements", ",", "\"\<tex\>\""}], "}"}]}], "]"}], ":=",
    "\[IndentingNewLine]", "\t", 
   RowBox[{"RowBox", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<TeXForm\>\"", ",", "\"\<[\>\"", ",", 
      RowBox[{"RowBox", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<StandardForm\>\"", ",", "\"\<\>\"", ",", "\"\<]\>\""}], 
        "}"}], "]"}], ",", "\"\<]\>\""}], "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.760191741926221*^9, 3.76019174192828*^9}, {
  3.760191819083969*^9, 3.7601918687946672`*^9}, {3.760192014215056*^9, 
