Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "M"], TraditionalForm]],ExpressionUUID->
  "f626abb8-7d83-4a79-ab4d-458ef7b4f62c"],
 " in WT region "
}], "Section",
 CellChangeTimes->{{3.872832457700755*^9, 3.872832461278577*^9}, {
  3.8731953580585938`*^9, 3.873195358903475*^9}, {3.88546002284702*^9, 
  3.885460024218726*^9}, {3.992509683797915*^9, 
  3.9925096894585342`*^9}},ExpressionUUID->"2deac7d0-c76e-4de4-8326-\
5724a42cb038"],

Cell[TextData[{
 StyleBox["See eq. (48).  Boundary conditions are eq (49a):   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      SubsuperscriptBox["\[PartialD]", "r", "n"], 
      RowBox[{"-", "2"}]], 
     SubsuperscriptBox[
      OverscriptBox["R", "_"], "lm", "M"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       SubsuperscriptBox["\[PartialD]", "r", "n"], 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox[
       OverscriptBox["R", "_"], "lm", "-"]}], " ", "+", " ", 
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        SubsuperscriptBox["\[PartialD]", "r", "n"], 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["R", "_"], "lm"]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"38bd48b1-a4fb-4ff8-a99c-8ac166358993"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "f0bb2e5c-1ef1-4e56-962d-0a2c0c91a6a5"],
 " for n=0,1,2,3.\nThe last term is the jump across ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "2b21111b-9ca9-4d7f-a762-851f53799b73"],
 " and can be given in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], 
     OverscriptBox["\[CapitalPhi]", "_"]}], " ", "=", " ", 
    RowBox[{"2", 
     SubsuperscriptBox["\[Psi]", "0", "Res"]}]}], TraditionalForm]],
  ExpressionUUID->"3b6f2d82-3e04-4132-ae38-2038691beb1b"],
 ".",
 StyleBox["\nFor ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "0", "Res"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "o"], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "min"]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["B", "o"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "min"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e794f453-bc64-4d51-adab-508b459f54f2"],
 " + (delta functions are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "a32aaca9-2e71-441a-adc8-ad16608d24ab"],
 ") + smooth functions.\n",
 StyleBox["The ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "o"], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "c525ae78-8c14-42e0-908e-e9874303283f"],
 StyleBox[" and ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "o"], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "3cd0e8e2-a787-4549-a84d-355f9e3a4fca"],
 StyleBox[" are independent of r!",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" Integrating around ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "1afe7187-cc7c-49ce-8c10-71cadb05b1be"],
 StyleBox[", the RHS gives: ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SuperscriptBox["rmin", "-"], 
       SuperscriptBox["rmin", "+"]], " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Psi]", "0", "Res"], "(", "r", ")"}], 
       RowBox[{"\[DifferentialD]", "r"}]}]}], " ", "=", " ", 
     SuperscriptBox["B", "o"]}], ",", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SuperscriptBox["rmin", "-"], 
       SuperscriptBox["rmin", "+"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", 
          SuperscriptBox["rmin", "-"], "r"], " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Psi]", "0", "Res"], "(", 
           SubscriptBox["r", "1"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           SubscriptBox["r", "1"]}]}]}], ")"}], 
       RowBox[{"\[DifferentialD]", "r"}]}]}], " ", "=", " ", 
     SuperscriptBox["A", "o"]}]}], TraditionalForm]],ExpressionUUID->
  "f095bbed-028e-4ae5-846e-ddd60da383e3"],
 ". \n\[Implies] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox["\[Thorn]", "2"], 
        OverscriptBox["\[CapitalPhi]", "_"]}], "]"}], 
      SubscriptBox["|", 
       SubscriptBox["r", "min"]]}], "=", 
     RowBox[{"2", " ", 
      SuperscriptBox["A", "o"]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox["\[Thorn]", "3"], 
        OverscriptBox["\[CapitalPhi]", "_"]}], "]"}], 
      SubscriptBox["|", 
       SubscriptBox["r", "min"]]}], "=", 
     RowBox[{"2", " ", 
      SuperscriptBox["B", "o"]}]}]}], TraditionalForm]],ExpressionUUID->
  "7919430d-19ea-4c44-9ba4-8804a6fe76de"],
 ".\nAt the level of the modes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["", "2"], 
    SubscriptBox["R", 
     RowBox[{"lm", " "}]]}], TraditionalForm]],ExpressionUUID->
  "a0dea1da-aaee-4d19-ba1e-05799733916f"],
 "inherits the delta functions and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         SubsuperscriptBox["\[PartialD]", "r", "2"], 
         RowBox[{"-", "2"}]], 
        SubscriptBox[
         OverscriptBox["R", "_"], "lm"]}], "]"}], 
      SubscriptBox["|", 
       SubscriptBox["r", "min"]]}], "=", 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "m"], 
      SubsuperscriptBox["A", 
       RowBox[{"l", "-", "m"}], "o"]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         SubsuperscriptBox["\[PartialD]", "r", "3"], 
         RowBox[{"-", "2"}]], 
        SubscriptBox[
         OverscriptBox["R", "_"], "lm"]}], "]"}], 
      SubscriptBox["|", 
       SubscriptBox["r", "min"]]}], "=", 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "m"], 
      SubsuperscriptBox["B", 
       RowBox[{"l", "-", "m"}], "o"]}]}]}], TraditionalForm]],ExpressionUUID->
  "03393299-c5b0-4f8f-a596-94d8e0a0c68b"],
 ".\nThen, because we are working with the residual field = retarded - \
puncture, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["A", "o"], "=", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Delta]", "'"}], " ", "coeff", " ", "of", " ", 
        SuperscriptBox["\[Psi]", "P"]}], ")"}]}]}], ",", " ", 
    RowBox[{
     SuperscriptBox["B", "o"], "=", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"\[Delta]", " ", "coeff", " ", "of", " ", 
        SuperscriptBox["\[Psi]", "P"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"895b1f6a-db6c-48a7-b246-6d40e0f780ec"],
 ".\n\nWe also use the fact that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["", 
        RowBox[{"-", "2"}]], 
       SubscriptBox["R", 
        RowBox[{"l", "-", "m"}]]}], " ", "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "l"], 
       SubscriptBox["(", 
        RowBox[{"-", "2"}]], 
       SubscriptBox["R", "lm"]}]}], ")"}], "*"], TraditionalForm]],
  ExpressionUUID->"18dea6c7-d296-426d-b6bb-3c798881bbab"],
 ", which was checked explicitly."
}], "Text",
 CellChangeTimes->{{3.877497908153605*^9, 3.877497918366846*^9}, {
   3.88350906445712*^9, 3.8835090858119173`*^9}, {3.884414017688056*^9, 
   3.8844140271912413`*^9}, {3.8844143506306*^9, 3.884414351967445*^9}, 
   3.8846116645103397`*^9, {3.8860560519137*^9, 3.8860560657156963`*^9}, {
   3.8860561021206827`*^9, 3.886056329337652*^9}, {3.886056375565167*^9, 
   3.886056573292859*^9}, {3.88605661907023*^9, 3.886056645353492*^9}, 
   3.886242408818996*^9, {3.8883174365033693`*^9, 3.888317441114641*^9}, {
   3.888403016088862*^9, 3.888403016216762*^9}, {3.888403153038322*^9, 
   3.888403153542428*^9}, {3.8885677324867268`*^9, 3.888567734106999*^9}, {
   3.888575467738381*^9, 3.888575470543787*^9}, {3.8902070781562147`*^9, 
   3.890207100085044*^9}, {3.890207190284656*^9, 3.89020724579702*^9}, {
   3.893136318312245*^9, 3.8931363584451313`*^9}, {3.8931364985741377`*^9, 
   3.893136498955817*^9}, {3.8931365547489967`*^9, 3.893136650914353*^9}, {
   3.893136687606736*^9, 3.8931367170848427`*^9}, {3.893136750804989*^9, 
   3.8931367773041*^9}, {3.893137006741556*^9, 3.893137057850765*^9}, {
   3.893137111745212*^9, 3.893137190605693*^9}, {3.89313722408887*^9, 
   3.893137302166603*^9}, {3.893773868945656*^9, 3.893773959113583*^9}, 
   3.89702644858197*^9, {3.898843693281248*^9, 3.8988437045192747`*^9}, {
   3.99242844932724*^9, 
   3.992428465663097*^9}},ExpressionUUID->"54baef8e-aae9-4ee4-ad90-\
be837ca1b116"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[CapitalPhi]Mbar", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Monitor", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalPhi]Mbar", "[", 
         RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "=", " ", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "\t", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''''"}], "[",
               "r", "]"}], " ", "==", " ", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", "\[ScriptM]"}], " ", 
              RowBox[{
               RowBox[{"\[Psi]0RSmoothPiece", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "r", 
               "]"}]}]}], ",", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{"RMbar", "[", 
               RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax", 
              "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{"\[CapitalPsi]barRetPlus", "[", 
               RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmax", 
              "]"}]}], ",", " ", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'"}], "[", 
              "rmax", "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalPsi]barRetm", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'"}], "[", 
              "rmax", "]"}]}], ",", "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''"}], "[",
               "rmax", "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalPsi]barRetm", "[", 
                 RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''"}], "[",
                "rmax", "]"}], "-", 
              RowBox[{"2", " ", 
               RowBox[{"\[Psi]0PExact\[Delta]prmax", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}]}]}]}], ",", 
            "\[IndentingNewLine]", "\t", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RMbar", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'''"}], "[",
               "rmax", "]"}], " ", "==", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalPsi]barRetm", "[", 
                 RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'''"}], "[",
                "rmax", "]"}], "-", 
              RowBox[{"2", " ", 
               RowBox[{"\[Psi]0PExact\[Delta]rmax", "[", 
                RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}]}]}]}]}], 
           "}"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"RMbar", "[", 
           RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "rmax", ",", "rmin"}], "}"}], ",", 
          RowBox[{"PrecisionGoal", "->", "30"}], ",", 
          RowBox[{"MaxStepSize", "->", "0.01"}], ",", 
          RowBox[{"InterpolationOrder", "->", "All"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"\[ScriptM]", " ", "!=", " ", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalPhi]Mbar", "[", 
            RowBox[{"\[ScriptL]", ",", 
             RowBox[{"-", "\[ScriptM]"}]}], "]"}], "[", "r_", "]"}], " ", "=",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "\[ScriptL]"}], " ", 
           RowBox[{"Conjugate", "[", 
            RowBox[{
             RowBox[{"\[CapitalPhi]Mbar", "[", 
              RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "r", 
             "]"}], "]"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"\[ScriptL]", ",", 
        RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[ScriptM]", ",", "0", ",", "\[ScriptL]"}], "}"}]}], "]"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "}"}]}], "]"}], " ", "//", 
  " ", "Timing"}]}], "Input",
 CellChangeTimes->{{3.8937740338229523`*^9, 3.893774172129567*^9}, {
   3.89378162572727*^9, 3.893781630301569*^9}, {3.893841940966693*^9, 
   3.893841943814437*^9}, {3.8938420115184927`*^9, 3.8938420135984373`*^9}, {
   3.893842614141576*^9, 3.893842615954947*^9}, {3.8938427241167717`*^9, 
   3.893842726061969*^9}, {3.893929117277217*^9, 3.893929176503045*^9}, {
