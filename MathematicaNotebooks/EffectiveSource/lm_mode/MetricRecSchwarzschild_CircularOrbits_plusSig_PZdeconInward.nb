       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Epsilon]", ">", "0"}], ",", 
         RowBox[{"rmin", ">", "0"}], ",", 
         RowBox[{"r1", ">", "0"}], ",", 
         RowBox[{"r", "<", "rmax"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
