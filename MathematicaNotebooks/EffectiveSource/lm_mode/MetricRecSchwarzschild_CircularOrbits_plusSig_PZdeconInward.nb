Cell[TextData[{
 "The relevant differential operator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["1", "2"], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "-", "\[Rho]", "+", 
           OverscriptBox["\[Rho]", "_"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"\[Eth]", "+", 
           RowBox[{"3", "\[Tau]"}]}], ")"}]}], "  ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Eth]", "-", "\[Tau]", "+", 
           RowBox[{
            OverscriptBox["\[Tau]", "_"], "'"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "+", 
           RowBox[{"3", "\[Rho]"}]}], ")"}]}]}], "]"}]}], " ", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{"\[Thorn]\[Eth]", "  ", "+", " ", "\[Eth]\[Thorn]", "+", 
        RowBox[{"3", "\[Eth]\[Rho]"}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"7e5ad9d9-84a1-4433-b926-b1fde1f7f34c"],
 "."
}], "Text",
