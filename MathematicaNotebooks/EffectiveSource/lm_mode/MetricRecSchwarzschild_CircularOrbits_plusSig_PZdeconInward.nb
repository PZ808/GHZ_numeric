      RowBox[{"Tll\[Delta]pRmaxPiece", "[", 
       RowBox[{"l", ",", "m"}], "]"}]}]}], "  ", "//", " ", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aCirc2ndTermDistrContributionAtRmax", "[", 
   RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], " ", "=", " ", 
  RowBox[{
