Cell[TextData[{
 StyleBox["We need to make sure the coefficients of the ",
  FontColor->GrayLevel[0]],
 "\[Delta]-functions are constants. We use usual distributional properties:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"F", 
      RowBox[{"(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], "   ", "=", "     ", 
     RowBox[{
      RowBox[{"F", "(", 
       SubscriptBox["x", "0"], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"F", "'"}]}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ce1095fa-4e75-4bcb-a451-9ea58fd67b4c"]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.892984103790772*^9, 
  3.892984151167996*^9}},ExpressionUUID->"02367d68-d277-4649-b14c-\
1f9ebb3a5947"],

