       RowBox[{"r", ">", "r0"}]}], "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]RetSpinFlipPlus", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], "[", "r_", "]"}], " ", ":=", " ", 
