   3.886057198428967*^9, 3.886057232240861*^9}, {3.886057301293888*^9, 
   3.886057480046417*^9}, {3.887367034641551*^9, 3.8873670350203743`*^9}, {
   3.887693772051035*^9, 3.887693786500566*^9}, {3.894017032027794*^9, 
   3.894017034062235*^9}, {3.898843081580521*^9, 3.898843166099227*^9}, {
