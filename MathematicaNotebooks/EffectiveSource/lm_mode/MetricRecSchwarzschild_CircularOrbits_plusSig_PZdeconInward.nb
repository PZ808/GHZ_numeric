Cell[TextData[{
 "For the derivatives below, checked that substituting known values of \
derivatives of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "edbe7183-2964-42fa-8ded-ac8a61526889"],
 ", instead of differentiating the interpolating polynomials makes no \
difference."
}], "Text",
