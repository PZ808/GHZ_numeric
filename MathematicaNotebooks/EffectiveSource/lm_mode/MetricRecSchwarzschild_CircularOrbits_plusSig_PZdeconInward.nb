Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRange", " ", "=", " ", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]RetData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rmax", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
         RowBox[{"i", "/", "iRange"}]}]}], ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmax", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
             RowBox[{"i", "/", "iRange"}]}]}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", 
           RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "iRange"}], "}"}]}], "]"}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{"paraFitRule", " ", "=", " ", 
   RowBox[{"FindFit", "[", 
    RowBox[{
     RowBox[{"Abs", "@", 
      RowBox[{"\[Psi]RetData", "[", 
       RowBox[{"[", 
        RowBox[{"30", ";;", "All"}], "]"}], "]"}]}], ",", 
     RowBox[{"A", " ", 
      RowBox[{"r", "^", 
       RowBox[{"(", 
        RowBox[{"-", "b"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"A", ",", "b"}], "}"}], ",", "r"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{"Abs", "@", "\[Psi]RetData"}], "]"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "b"}], ")"}]}]}], " ", "/.", " ", "paraFitRule"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"r", ",", "rmax", ",", "rNumOutbd"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}], "Input",
