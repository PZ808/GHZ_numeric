            RowBox[{"-", "mm"}]}], "]"}], "[", "\"\<In\>\"", "]"}], "[", 
         RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]HomogInUp", "[", "ss", "]"}], "[", 
            RowBox[{"ll", ",", "mm"}], "]"}], "[", "\"\<In\>\"", "]"}], "[", 
          "r", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]HomogInUp", "[", "ss", "]"}], "[", 
           RowBox[{"ll", ",", 
            RowBox[{"-", "mm"}]}], "]"}], "[", "\"\<Up\>\"", "]"}], "[", 
         RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]HomogInUp", "[", "ss", "]"}], "[", 
            RowBox[{"ll", ",", "mm"}], "]"}], "[", "\"\<Up\>\"", "]"}], "[", 
          "r", "]"}], "]"}]}], ";"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"res", ",", 
      RowBox[{"positiveModeResults", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.99258068980221*^9, 
  3.992580694325069*^9}},ExpressionUUID->"bda0b1d3-061a-414b-8ba9-\
a77f4793b03a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zeroModeJobs", "=", 
    RowBox[{"Range", "[", 
     RowBox[{
