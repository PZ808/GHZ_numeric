Cell[BoxData[
 RowBox[{
  RowBox[{"CheckTS1", "[", 
   RowBox[{"l_", ",", "m_", ",", "rVal_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "q", " ", ",", "myC", ",", "C2", ",", "Psi$sm2", ",", 
      "Psi$s2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", "4"}], ";", " ", 
     RowBox[{"q", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"myC", " ", "=", " ", 
      RowBox[{
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"l", "-", "1"}], ",", "4"}], "]"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"m", "+", "l"}], ")"}]}], " ", "12", " ", "I", " ", "M", " ", 
        RowBox[{"\[Omega]m", "[", "m", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"C2", " ", "=", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "myC", "]"}], "^", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Psi$sm2", "=", 
      RowBox[{"TeukolskyRadial", "[", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "aKerr", ",", 
        RowBox[{"\[Omega]m", "[", "m", "]"}], ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<NumericalIntegration\>\"", ",", 
           RowBox[{"\"\<Domain\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<In\>\"", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"rmin", ",", "r0"}], "}"}]}], ",", 
              RowBox[{"\"\<Up\>\"", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"r0", ",", 
                 RowBox[{"rmax", "+", "1"}]}], "}"}]}]}], "}"}]}]}], 
          "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Psi$s2", " ", "=", " ", 
      RowBox[{"TeukolskyRadial", "[", 
       RowBox[{"2", ",", "l", ",", "m", ",", "aKerr", ",", 
        RowBox[{"\[Omega]m", "[", "m", "]"}], ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<NumericalIntegration\>\"", ",", 
           RowBox[{"\"\<Domain\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<In\>\"", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"rmin", ",", "r0"}], "}"}]}], ",", 
              RowBox[{"\"\<Up\>\"", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"r0", ",", 
                 RowBox[{"rmax", "+", "1"}]}], "}"}]}]}], "}"}]}]}], 
          "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"rVal", ">", "r0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"64", "/", "C2"}], " ", 
          RowBox[{"r", "^", "4"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Thorn]pNullK", "[", 
             RowBox[{
              RowBox[{"p", "-", "3"}], ",", 
              RowBox[{"q", "-", "3"}]}], "]"}], "[", 
            RowBox[{
             RowBox[{"\[Thorn]pNullK", "[", 
              RowBox[{
               RowBox[{"p", "-", "2"}], ",", 
               RowBox[{"q", "-", "2"}]}], "]"}], "[", 
             RowBox[{
              RowBox[{"\[Thorn]pNullK", "[", 
               RowBox[{
                RowBox[{"p", "-", "1"}], ",", 
                RowBox[{"q", "-", "1"}]}], "]"}], "[", 
              RowBox[{
               RowBox[{"\[Thorn]pNullK", "[", 
                RowBox[{"p", ",", "q"}], "]"}], "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"r", "^", "4"}], " ", 
                RowBox[{"Cplus", "[", 
                 RowBox[{"2", ",", "l", ",", "m"}], "]"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Psi$s2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
                 StyleBox["/",
                  FontColor->GrayLevel[0]], 
                 StyleBox[
                  RowBox[{
                   RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r", 
                   "]"}],
                  FontColor->GrayLevel[0]]}]}], "]"}], "]"}], "]"}], "]"}], "/",
            "\[IndentingNewLine]", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             RowBox[{"Aplus", "[", 
              RowBox[{"l", ",", "m"}], "]"}], " ", 
             RowBox[{"Cplus", "[", 
              RowBox[{"2", ",", "l", ",", "m"}], "]"}], " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Psi$sm2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
              StyleBox["/",
               FontColor->GrayLevel[0]], 
              StyleBox[
               RowBox[{
                RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r", "]"}],
               
               FontColor->GrayLevel[0]]}]}], ")"}]}]}], " ", ")"}], "/.", " ", 
        RowBox[{"r", " ", "->", " ", "rVal"}]}], " ", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"64", "/", "C2"}], " ", 
          RowBox[{"r", "^", "4"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Thorn]pNullK", "[", 
             RowBox[{
              RowBox[{"p", "-", "3"}], ",", 
              RowBox[{"q", "-", "3"}]}], "]"}], "[", 
            RowBox[{
             RowBox[{"\[Thorn]pNullK", "[", 
              RowBox[{
               RowBox[{"p", "-", "2"}], ",", 
               RowBox[{"q", "-", "2"}]}], "]"}], "[", 
             RowBox[{
              RowBox[{"\[Thorn]pNullK", "[", 
               RowBox[{
                RowBox[{"p", "-", "1"}], ",", 
                RowBox[{"q", "-", "1"}]}], "]"}], "[", 
              RowBox[{
               RowBox[{"\[Thorn]pNullK", "[", 
                RowBox[{"p", ",", "q"}], "]"}], "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"r", "^", "4"}], " ", 
                RowBox[{"Cplus", "[", 
                 RowBox[{"2", ",", "l", ",", "m"}], "]"}], " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Psi$s2", "[", "\"\<In\>\"", "]"}], "[", "r", "]"}], 
                 StyleBox["/",
