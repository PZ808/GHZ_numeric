          RowBox[{
           RowBox[{"h\[ScriptCapitalP]", "[", "9", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}]}], ")"}]}]}], 
     RowBox[{"4", " ", 
      SqrtBox["2"], " ", 
      SqrtBox[
       RowBox[{"l", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "l"}], ")"}]}]], " ", "r"}]]}], ",", 
