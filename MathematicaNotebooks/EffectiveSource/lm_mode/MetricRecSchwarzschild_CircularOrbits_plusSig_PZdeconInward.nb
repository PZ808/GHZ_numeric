        "zeroModeJobs", ",", 
        RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], 
      ",", "\"\<Computing m=0 homogeneous Teukolsky modes...\>\""}], "]"}], "//",
