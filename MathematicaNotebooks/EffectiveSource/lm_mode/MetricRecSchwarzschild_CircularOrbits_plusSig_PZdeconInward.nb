Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
      RowBox[{
       SuperscriptBox["h", "Res"], "+", 
       SuperscriptBox["h", "P"], "+", 
       SubscriptBox["x", "ab"]}], ")"}], "}"}], 
    RowBox[{"\[Delta]", " ", "piece"}]], " ", "=", " ", "0"}], 
  TraditionalForm]],ExpressionUUID->"5ce3d072-9372-4368-b7bc-a4c5eddb5eab"]], \
"Section",
 Evaluatable->False,
 CellChangeTimes->{{3.893183600973741*^9, 
  3.893183627338059*^9}},ExpressionUUID->"e1f446d9-5e60-4223-9b64-\
9cdc7b13cec0"],

Cell[TextData[{
 "For the distributional pieces (both \[Delta] and \[Delta] next section), \
need to be careful since using \[ScriptCapitalE]hP\[Delta]RminPiece and \
\[ScriptCapitalE]hP\[Delta]pRminPiece assumed that the input is of the form \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"#", " ", 
    RowBox[{"H", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "min"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "204003ac-b1aa-44eb-942d-e2ad724cdc43"],
 ".\nNow, this is true for puncture, stress energy, and corrector tensors \
(which all vanish outside the worldtube for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "<", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "fa9582a2-21e3-44d4-b37f-4c5eb45eb074"],
 "). However, for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "Res"], TraditionalForm]],ExpressionUUID->
  "76a32275-2aeb-4444-b164-3e78689054c0"],
 ", it equals the retarded metric perturbation for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "<", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "f6f6c348-ff55-47ff-9774-1ef4997e01cd"],
 ".\nBasically, we could write, abusing notation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["h", "Res"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["h", "Res"], 
       RowBox[{"H", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "min"]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Psi]", "Ret"], 
       RowBox[{"H", "(", 
        RowBox[{
         SubscriptBox["r", "min"], "-", "r"}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      SuperscriptBox["\[Psi]", "Ret"], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["h", "Res"], "-", 
         SuperscriptBox["h", "Ret"]}], ")"}], " ", 
       RowBox[{"H", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "min"]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"aca99547-0a04-45a3-b9af-879b3bd57132"],
 ".\nSo, the \[Delta] and \[Delta]\[CloseCurlyQuote] pieces\[CloseCurlyQuote] \
coefficients should be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["h", "Res"], "-", 
    SuperscriptBox["h", "Ret"]}], TraditionalForm]],ExpressionUUID->
  "7f9116dd-d646-480b-9edf-f00930739375"],
 " instead of just ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "Res"], TraditionalForm]],ExpressionUUID->
  "acba4eff-9876-4cb6-8a56-f58fd039b232"],
 ".\n\nChecked that for pieces along ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "a"], TraditionalForm]],ExpressionUUID->
  "7f349025-e34f-49da-84dc-e17ab5f670c7"],
 ", the corrector tensor cancels the distributional pieces of the stress \
energy, as it should by construction."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.893183753029751*^9, 3.893183848419539*^9}, {
   3.893183908518896*^9, 3.893183949310998*^9}, {3.893183996107226*^9, 
   3.893184089577087*^9}, {3.893184152044413*^9, 3.893184265843347*^9}, {
   3.893219586815282*^9, 3.8932196382002563`*^9}, 
   3.898790977444647*^9},ExpressionUUID->"5a6486e8-7dbb-4416-aa3d-\
2e14019c3ece"],

