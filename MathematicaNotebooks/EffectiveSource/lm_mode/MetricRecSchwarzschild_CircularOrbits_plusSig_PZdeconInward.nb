Cell[BoxData[{
 RowBox[{"Clear", "[", "\[CapitalPsi]barTailFrom\[Psi]0Fit", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPsi]barTailFrom\[Psi]0Fit", "[", 
