Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]", ">", "0"}], ",", 
        RowBox[{"rmin", ">", "0"}], ",", 
        RowBox[{"r1", ">", "0"}], ",", 
        RowBox[{"r", "<", "rmax"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", "\[Rho]"}], " ", 
       RowBox[{"Simplify", "@", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r2", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"xnnIntegrand\[Delta]Coeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], " ", 
              RowBox[{"DiracDelta", "[", 
               RowBox[{"r2", "-", "rmax"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"xnnIntegrand\[Delta]pCoeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], 
              RowBox[{
               RowBox[{"DiracDelta", "'"}], "[", 
               RowBox[{"r2", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r2", ",", 
            RowBox[{"rmax", "+", "\[Epsilon]"}], ",", "r"}], "}"}]}], 
         "]"}]}]}]}], " ", "]"}], "/.", " ", 
    RowBox[{"r", "->", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "\[Rho]"}]}]}], "/.", " ", 
   RowBox[{"rmax", "->", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "\[Rho]max"}]}]}], "//", "Simplify"}]], "Input",\

 CellChangeTimes->{{3.992146348768229*^9, 3.992146399989017*^9}, {
