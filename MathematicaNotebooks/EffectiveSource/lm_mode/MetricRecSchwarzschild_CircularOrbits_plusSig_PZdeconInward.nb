Cell[CellGroupData[{

Cell["Individual m modes (Residual field)", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.8823352249379673`*^9, 3.882335264787097*^9}, {
  3.882335537530089*^9, 3.882335540418551*^9}, {3.882336907058528*^9, 
  3.882336910485691*^9}, {3.882341693681781*^9, 
  3.882341695733286*^9}},ExpressionUUID->"dc7745ff-24bf-4afd-a83b-\
4f1b40fea667"],

Cell["\<\
The retarded reconstructed metric is by definition in radiation gauge, while \
the puncture is in Lorentz gauge.
So the difference will generically not cancel out the divergences.
Instead, we can look at the redshift:\
\>", "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.882859971469919*^9, 3.882860041964628*^9}, {
  3.8828600732994747`*^9, 
  3.882860093449328*^9}},ExpressionUUID->"b4551246-c707-4976-a958-\
ca0ec4599950"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mmode", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "@", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"hRetuu", "[", 
