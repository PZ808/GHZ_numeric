ab758c5f6f8d"]
}, Closed]],

Cell[CellGroupData[{

Cell["Check --- large l behaviour", "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.893755200537608*^9, 
  3.893755205808997*^9}},ExpressionUUID->"8cb99fda-457c-4ea7-98a7-\
be62a40729c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"huuRetMinusP", " ", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"hRetuu", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}],
            "-", 
           RowBox[{
            RowBox[{"hPuu", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", 
            RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{
  3.893928047506472*^9, {3.8939331662179127`*^9, 3.893933168102008*^9}, 
   3.8987952315141077`*^9},
 CellLabel->
  "In[838]:=",ExpressionUUID->"c1dabeb7-131a-4a98-9668-e3452e1176b8"],

Cell["\<\
We check the l mode behaviour of the metric perturbation using the GHZ scheme \
vs the usual method (reconstructed metric - lorentz puncture).

The first plot is done using WorkinPrecision=64. IF you use a too small \
precision (e.g. wp=36), you will find that the last few points go crazy and \
the power law wobbles a bit at the tail.\
\>", "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.893933189692333*^9, 3.893933287679706*^9}, {
   3.8939339272717047`*^9, 3.893934079678288*^9}, {3.89393445357903*^9, 
   3.893934457050898*^9}, 3.897119829767383*^9, {3.89879529443929*^9, 
   3.8987952948705397`*^9}},ExpressionUUID->"acccd8a3-e93f-4c37-a100-\
ba85bd05424b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"wp", "=", "64"}], ",", " ", 
    RowBox[{"MaxStepSize", "=", 
     RowBox[{
     "0.01", " ", "in", " ", "computing", " ", "the", " ", "Hertz"}]}], ",", 
    " ", 
    RowBox[{
    "and", " ", "0.001", " ", "for", " ", "the", " ", "corrector", " ", 
     RowBox[{"tensors", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
       "metricContributionlModes", "+", "correctorContributionlModes", "-", 
        "\[ScriptCapitalL]\[CapitalXi]gabContributionlModes"}], "]"}], ",", 
      RowBox[{"DataRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "40"}], "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", "Large"}], "}"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"Abs", "@", "huuRetMinusP"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8939307875862503`*^9, 3.893930795808482*^9}, {
