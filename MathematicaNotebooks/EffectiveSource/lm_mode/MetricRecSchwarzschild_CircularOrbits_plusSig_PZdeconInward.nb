Cell[TextData[{
 "For the pre-computed puncture. Showing behaviour for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["h", "ll", "P"], TraditionalForm]],ExpressionUUID->
  "72d310fc-cc56-4295-8391-4f4c6e337137"],
 " and its first and second radial derivative.\nChecked that all other \
components have a similar behaviour."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.890291431272188*^9, 3.8902914385398607`*^9}, {
  3.891667627167141*^9, 3.891667686795085*^9}, {3.8916678824891233`*^9, 
