Cell[TextData[{
 "When acting on an spin-0 object of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "r", ")"}], 
    RowBox[{"H", "(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "min"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "4dda2764-49c5-4a02-981e-543640768220"],
 ", we get three terms, one proportional to the Heaviside function and a \
delta function and its derivative."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.892984576254817*^9, 
  3.89298460407171*^9}},ExpressionUUID->"f8936676-a308-400f-afbf-\
94765e49ab4a"],

