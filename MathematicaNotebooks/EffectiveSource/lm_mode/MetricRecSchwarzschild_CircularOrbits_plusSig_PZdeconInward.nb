Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], while in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"39c50022-42d4-431a-bee9-f4d93ab396c3"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 
  3.8929713039202633`*^9}},ExpressionUUID->"ffe1aa91-e874-49e0-897c-\
c23bf6873ca8"],

