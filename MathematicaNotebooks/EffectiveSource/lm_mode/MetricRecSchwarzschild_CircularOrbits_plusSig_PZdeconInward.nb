Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["\[CapitalXi]", "a"], 
  TraditionalForm]],ExpressionUUID->"d77186b5-e939-4bbb-97dc-093cc7adce27"]], \
"Section",
 CellChangeTimes->{{3.878983680311625*^9, 
  3.878983686597128*^9}},ExpressionUUID->"ee418809-71d5-42c9-9317-\
68e14fb57e1e"],

Cell[TextData[{
 "Note that the values of \[Alpha] and \[Beta] were once computed using \
power-series expanded expressions of the puncture.\nIn this case, we actually \
found that only the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]r", "0"], TraditionalForm]],ExpressionUUID->
  "b546df88-4fb2-4903-863e-6b88a6e4a2e2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]r", "1"], TraditionalForm]],ExpressionUUID->
  "7b576f48-bcfa-4d28-80b6-92eed96ae883"],
 " contribute, and value is independent on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "0f5e0e3d-21fd-4407-8613-8b9e31614c84"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "664a67ec-5f07-45cf-aa7f-a03c1f21c473"],
 ".\n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalXi]", "a"], TraditionalForm]],ExpressionUUID->
  "a02ced9e-0de7-46d4-bd12-8c046ab95bf2"],
 " should be independent of convention."
}], "Text",
 CellChangeTimes->{{3.893583150963532*^9, 3.8935832609092407`*^9}, {
  3.897973831901772*^9, 3.8979738341048527`*^9}, {3.898843349019253*^9, 
  3.8988433675236397`*^9}},ExpressionUUID->"60653434-b908-4479-bcf5-\
97d0f0207353"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[Alpha]Const", ",", "\[Beta]Const"}], "]"}]], "Input",
 CellChangeTimes->{{3.8880538114452744`*^9, 3.888053820811981*^9}},
 CellLabel->
  "In[947]:=",ExpressionUUID->"ac32acf3-8815-4bb8-b054-824cb9905fba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]Const", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["1", 
      RowBox[{"4", " ", "\[Pi]"}]], "]"}], " ", "aCirc00"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"eq", " ", 
    RowBox[{"(", "103", ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Beta]Const", " ", "=", 
  RowBox[{
   RowBox[{"-", "I"}], " ", 
   RowBox[{"Sqrt", "[", 
    FractionBox["3", 
     RowBox[{"4", " ", "\[Pi]"}]], "]"}], " ", 
   "cCirc10"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalXi]Vec", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "u"}], 
     RowBox[{"{", 
      RowBox[{"\[Alpha]Const", ",", "0", ",", "0", ",", "\[Beta]Const"}], 
      "}"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"eq", " ", 
    RowBox[{"(", "98", ")"}]}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.877402638790863*^9, 3.877402692085165*^9}, {
   3.8774388472918177`*^9, 3.8774388951236486`*^9}, {3.877499206922759*^9, 
