Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "\[ScriptCapitalN]xmmb\[Delta]Coeff\[Rho]max", ",", "xnmIntegrationRule"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalN]xmmb\[Delta]Coeff\[Rho]max", "[", 
     RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "1"}], "/", "2"}], " ", 
      RowBox[{
       RowBox[{"\[Eth]CK", "[", 
        RowBox[{"0", ",", "l"}], "]"}], "[", 
       RowBox[{"xmmbAt\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "]"}]}], " ", "/.", " ", 
     RowBox[{"r", " ", "->", " ", "rmax"}]}]}], " ", ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"check", " ", "sign"}], " ", "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"when", " ", "evaluating", " ", 
    SubscriptBox["x", 
     RowBox[{"m", 
      OverscriptBox["m", "_"]}]], " ", "at", " ", 
    SubscriptBox["r", "max"], " ", "we", " ", "can", " ", "simply", " ", 
    "take", " ", "the", " ", "value", " ", "of", " ", "the", " ", 
    "distributional", " ", "parts", " ", "as", " ", "the", " ", "integral", " ",
     "over", " ", "smooth", " ", "bit", " ", "is", " ", "zero", " ", "at", " ", 
    SubscriptBox["r", "max"]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xnmIntegrationRule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"xnmIntegrand\[Delta]Coeff", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Tlm\[Delta]RmaxInterpol", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "+", 
       RowBox[{"\[ScriptCapitalN]xmmb\[Delta]Coeff\[Rho]max", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"xnmIntegrand\[Delta]pCoeff", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
      RowBox[{"Tlm\[Delta]pRmaxInterpol", "[", 
       RowBox[{"l", ",", "m"}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.892976678465035*^9, 3.8929766903903427`*^9}, {
