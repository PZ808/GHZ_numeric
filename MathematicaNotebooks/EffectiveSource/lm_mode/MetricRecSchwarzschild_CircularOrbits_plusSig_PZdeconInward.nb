Cell[BoxData[{
 RowBox[{
  RowBox[{"iRange", " ", "=", " ", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]RetData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rmax", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
         RowBox[{"i", "/", "iRange"}]}]}], ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"rmax", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
             RowBox[{"i", "/", "iRange"}]}]}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", 
           RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "iRange"}], "}"}]}], "]"}]}], ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{"paraFitRule", " ", "=", " ", 
