Cell[BoxData[{
 RowBox[{
  RowBox[{"my\[Theta]t", " ", "=", " ", 
   RowBox[{"\[Pi]", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myz", " ", "=", " ", 
   RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xnn\[CurlyRho]", " ", "=", " ", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CurlyRho]", ",", 
         RowBox[{"Sum", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"xnn", "[", 
              RowBox[{"lInd", ",", "mInd"}], "]"}], "[", 
             RowBox[{
              RowBox[{"my\[CapitalDelta]rCoord", "[", 
               RowBox[{"\[CurlyRho]", ",", "my\[Theta]t", ",", "myz"}], "]"}],
               "+", "r0"}], "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "mInd", "]"}], "[", 
             RowBox[{
              RowBox[{"my\[CapitalDelta]rCoord", "[", 
               RowBox[{"\[CurlyRho]", ",", "my\[Theta]t", ",", "myz"}], "]"}],
               "+", "r0"}], "]"}], " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"0", ",", "lInd", ",", "mInd", ",", 
              RowBox[{"my\[Theta]Coord", "[", 
               RowBox[{"\[CurlyRho]", ",", "my\[Theta]t", ",", "myz"}], "]"}],
               ",", 
              RowBox[{"my\[Phi]Coord", "[", 
               RowBox[{"\[CurlyRho]", ",", "my\[Theta]t", ",", "myz"}], 
               "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"lInd", ",", "0", ",", "lmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"mInd", ",", 
             RowBox[{"-", "lInd"}], ",", "lInd"}], "}"}]}], "]"}]}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[CurlyRho]", ",", "0", ",", "0.1", ",", "0.001"}], "}"}]}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", "\[CurlyRho]", "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xnn\[CurlyRho]Interpolation", " ", "=", " ", 
   RowBox[{"Interpolation", "[", "xnn\[CurlyRho]", "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
