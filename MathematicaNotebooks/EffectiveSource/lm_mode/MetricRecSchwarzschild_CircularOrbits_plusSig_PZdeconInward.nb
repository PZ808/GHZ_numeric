Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"<|", "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"remaining", "=", "jobsHP"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"completed", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"total", "=", 
     RowBox[{"Length", "[", "jobsHP", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lastMode", "=", "None"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"failed", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"remaining", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"WaitNext", " ", 
          RowBox[{"returns", ":", 
           RowBox[{"{", 
            RowBox[{"result", ",", 
             RowBox[{"finished", " ", "evaluation", " ", "object"}], ",", 
             RowBox[{"new", " ", "remaining", " ", "list"}]}], "}"}]}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"res", ",", "finishedJob", ",", "remaining"}], "}"}], "=", 
          
          RowBox[{"WaitNext", "[", "remaining", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"res", ",", 
             RowBox[{"{", 
              RowBox[{"_Integer", ",", "_Integer", ",", "_Association"}], 
              "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "l", ",", "m", ",", "portableData", ",", " ", "file$interp"}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"l", ",", "m", ",", "portableData"}], "}"}], "=", 
               "res"}], ";", "\[IndentingNewLine]", 
              RowBox[{"lastMode", "=", 
               RowBox[{"{", 
                RowBox[{"l", ",", "m"}], "}"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"(*", " ", 
               RowBox[{"create", " ", "file"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"file$interp", "=", 
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"sp2modeDir$interp", ",", 
                  RowBox[{
                   RowBox[{
                   "StringTemplate", "[", "\"\<s``_l``_m``.wxf\>\"", "]"}], "[", 
                   RowBox[{"sHomog", ",", "l", ",", "m"}], "]"}]}], "}"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{"save", " ", "data"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"Export", "[", 
               RowBox[{
               "file$interp", ",", "portableData", ",", "\"\<WXF\>\""}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"AssociateTo", "[", 
               RowBox[{"results", ",", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"l", ",", "m"}], "}"}], "->", "file$interp"}]}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"if", " ", "failed"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"failed", ",", "res"}], "]"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"completed", "++"}], ";"}]}], "]"}], " ", 
      RowBox[{"(*", " ", 
       RowBox[{"end", " ", "while"}], " ", "*)"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"monitor", " ", "style"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Positive s=+2 modes\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Completed: \>\"", ",", 
            RowBox[{"Dynamic", "[", "completed", "]"}], ",", "\"\< / \>\"", ",",
             "total"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Remaining: \>\"", ",", 
            RowBox[{"Dynamic", "[", 
             RowBox[{"Length", "[", "remaining", "]"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Last finished: \>\"", ",", 
            RowBox[{"Dynamic", "[", "lastMode", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"ProgressIndicator", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "completed", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "total"}], "}"}], ",", 
           RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], "}"}], "]"}]}], 
     "]"}], ";"}]}]}]], "Input",
