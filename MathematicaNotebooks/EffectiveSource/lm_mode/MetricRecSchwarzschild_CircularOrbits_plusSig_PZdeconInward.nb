      RowBox[{"rs", ",", 
       RowBox[{"powers", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "3"}], "]"}]}], ",", "mat", ",", "y", ",", 
       "coeffs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"rs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"SetPrecision", "[", 
          RowBox[{"rFitMin", ",", "wp"}], "]"}], ",", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"rFitMax", ",", "wp"}], "]"}], ",", 
         RowBox[{"nPts", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mat", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "q"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "rs", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "powers"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalPsi]barRetp", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "/@", "rs"}], ",", "wp"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"coeffs", "=", 
       RowBox[{"LeastSquares", "[", 
        RowBox[{"mat", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<powers\>\"", "->", "powers"}], ",", 
        RowBox[{"\"\<coeffs\>\"", "->", "coeffs"}], ",", 
        RowBox[{"\"\<a0\>\"", "->", 
         RowBox[{"coeffs", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<a1\>\"", "->", 
         RowBox[{"coeffs", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<a2\>\"", "->", 
         RowBox[{"coeffs", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<a3\>\"", "->", 
         RowBox[{"coeffs", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<Polynomial\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "rr", "}"}], ",", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", "j", "]"}], "]"}], " ", 
              RowBox[{"rr", "^", 
               RowBox[{"powers", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "powers", "]"}]}], "}"}]}], "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"\"\<FitRange\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"rFitMin", ",", "rFitMax"}], "}"}]}], ",", 
        RowBox[{"\"\<NumberOfFitPoints\>\"", "->", "nPts"}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9930315275551863`*^9, 3.993031527557077*^9}},
 CellLabel->
  "In[2359]:=",ExpressionUUID->"f4730cce-59cb-43c4-92a9-a06c51cf8256"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "conjugate\[CapitalPsi]PolynomialFit", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "conjugate\[CapitalPsi]PolynomialFit", "[", "fit_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coeffs", ",", "powers", ",", "l", ",", "m"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coeffs", "=", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"fit", "[", "\"\<coeffs\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"powers", "=", 
       RowBox[{"fit", "[", "\"\<powers\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"l", "=", 
       RowBox[{"fit", "[", "\"\<l\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"-", 
        RowBox[{"fit", "[", "\"\<m\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{"fit", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
          RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
          RowBox[{"\"\<coeffs\>\"", "->", "coeffs"}], ",", 
          RowBox[{"\"\<a0\>\"", "->", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<a1\>\"", "->", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<a2\>\"", "->", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<a3\>\"", "->", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Polynomial\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "rr", "}"}], ",", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"coeffs", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", 
                RowBox[{"rr", "^", 
                 RowBox[{"powers", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"Length", "[", "powers", "]"}]}], "}"}]}], "]"}]}], 
            "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993031667196512*^9, 3.9930316671986732`*^9}},
 CellLabel->
  "In[2361]:=",ExpressionUUID->"96f5db90-71cb-4851-bf0b-432364636b15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "compute\[CapitalPsi]PolynomialData", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "compute\[CapitalPsi]PolynomialData", "]"}], "=", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<LMin\>\"", "->", "2"}], ",", 
      RowBox[{"\"\<NPts\>\"", "->", "200"}], ",", 
      RowBox[{"WorkingPrecision", "->", "50"}], ",", 
      RowBox[{"\"\<UseParallel\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<Verbose\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"compute\[CapitalPsi]PolynomialData", "[", 
    RowBox[{
     RowBox[{"ellMax_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"rFitMin_", "?", "NumericQ"}], ",", 
     RowBox[{"rFitMax_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "lmin", ",", "nPts", ",", "wp", ",", "useParallel", ",", "verbose", ",",
        "modesToFit", ",", "allModes", ",", "nModes", ",", "worker", ",", 
       "mapFunction", ",", "raw", ",", "fitAssocPositive", ",", 
       "fitAssocNegative", ",", "fitAssoc", ",", "failedModes", ",", 
       "coeffAssoc", ",", "a0Assoc", ",", "a1Assoc", ",", "a2Assoc", ",", 
       "a3Assoc", ",", "polynomialAssoc", ",", 
       RowBox[{"done", "=", "0"}], ",", 
       RowBox[{"currentMode", "=", "None"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"lmin", "=", 
       RowBox[{"OptionValue", "[", "\"\<LMin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nPts", "=", 
       RowBox[{"OptionValue", "[", "\"\<NPts\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"useParallel", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<UseParallel\>\"", "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"verbose", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<Verbose\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"modesToFit", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "lmin", ",", "ellMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "0", ",", "l"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"allModes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "lmin", ",", "ellMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nModes", "=", 
       RowBox[{"Length", "[", "modesToFit", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"verbose", ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Fitting Hertz-potential polynomial data for \>\"", ",",
            "nModes", ",", "\"\< independent modes.\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<Filling negative-m modes by conjugation.\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<l range: \>\"", ",", "lmin", ",", "\"\< to \>\"", ",", 
           "ellMax"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<fit range: r \[Element] [\>\"", ",", "rFitMin", 
           ",", "\"\<, \>\"", ",", "rFitMax", ",", "\"\<]\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "\"\<basis: {1, r, r^2, r^3}\>\"", "]"}], 
         ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"worker", "[", 
        RowBox[{"{", 
         RowBox[{"l_", ",", "m_"}], "}"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "res", "}"}], ",", 
         RowBox[{
          RowBox[{"currentMode", "=", 
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"res", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{"fit\[CapitalPsi]pPolynomialBase", "[", 
               RowBox[{
               "l", ",", "m", ",", "rFitMin", ",", "rFitMax", ",", "nPts", ",",
                 "wp"}], "]"}], ",", "$Failed"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"done", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], "->", "res"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mapFunction", "=", 
       RowBox[{"If", "[", 
        RowBox[{"useParallel", ",", "ParallelMap", ",", "Map"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"raw", "=", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"mapFunction", "[", 
          RowBox[{"worker", ",", "modesToFit"}], "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<mode\>\"", ",", 
               RowBox[{"Dynamic", "[", "currentMode", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<done\>\"", ",", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "done", "]"}], ",", "\"\< / \>\"", ",",
                   "nModes"}], "}"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<progress\>\"", ",", 
               RowBox[{"ProgressIndicator", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", "done", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "nModes"}], "}"}]}], "]"}]}], "}"}]}], 
            "}"}], ",", 
           RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fitAssocPositive", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"Select", "[", 
         RowBox[{"raw", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "=!=", "$Failed"}], "&"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fitAssocNegative", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"mode", ",", "fit"}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"mode", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"mode", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"-", 
                  RowBox[{"mode", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "->", 
               RowBox[{
               "conjugate\[CapitalPsi]PolynomialFit", "[", "fit", "]"}]}], ",",
               "Nothing"}], "]"}]}], "]"}], ",", "fitAssocPositive"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fitAssoc", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"fitAssocPositive", ",", "fitAssocNegative"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"failedModes", "=", 
       RowBox[{"Keys", "@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Association", "[", "raw", "]"}], ",", 
          RowBox[{
           RowBox[{"#", "===", "$Failed"}], "&"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coeffAssoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<coeffs\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a0Assoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<a0\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a1Assoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<a1\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a2Assoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<a2\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a3Assoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<a3\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"polynomialAssoc", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"#2", "[", "\"\<Polynomial\>\"", "]"}]}], "&"}], ",", 
          "fitAssoc"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<ellMax\>\"", "->", "ellMax"}], ",", 
        RowBox[{"\"\<LMin\>\"", "->", "lmin"}], ",", 
        RowBox[{"\"\<rFitMin\>\"", "->", "rFitMin"}], ",", 
        RowBox[{"\"\<rFitMax\>\"", "->", "rFitMax"}], ",", 
        RowBox[{"\"\<powers\>\"", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "3"}], "]"}]}], ",", 
        RowBox[{"\"\<nPts\>\"", "->", "nPts"}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}], ",", 
        RowBox[{"\"\<ModesFit\>\"", "->", "modesToFit"}], ",", 
        RowBox[{"\"\<Modes\>\"", "->", "allModes"}], ",", 
        RowBox[{"\"\<Fits\>\"", "->", "fitAssoc"}], ",", 
        RowBox[{"\"\<AllCoefficients\>\"", "->", "coeffAssoc"}], ",", 
        RowBox[{"\"\<a0Coefficients\>\"", "->", "a0Assoc"}], ",", 
        RowBox[{"\"\<a1Coefficients\>\"", "->", "a1Assoc"}], ",", 
        RowBox[{"\"\<a2Coefficients\>\"", "->", "a2Assoc"}], ",", 
        RowBox[{"\"\<a3Coefficients\>\"", "->", "a3Assoc"}], ",", 
        RowBox[{"\"\<PolynomialFunctions\>\"", "->", "polynomialAssoc"}], ",", 
        RowBox[{"\"\<FailedModes\>\"", "->", "failedModes"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
