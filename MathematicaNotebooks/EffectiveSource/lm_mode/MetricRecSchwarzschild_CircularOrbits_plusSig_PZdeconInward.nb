   3.880976289537025*^9, 3.880976319108366*^9}, {3.8823366157333117`*^9, 
   3.882336616266345*^9}, {3.88374083645465*^9, 3.8837408847837563`*^9}, {
   3.8838047932034407`*^9, 3.883804793210697*^9}, {3.890209747717207*^9, 
