Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["b", "o"], 
  TraditionalForm]],ExpressionUUID->"ac830f63-b0d9-437d-af3c-baa88d8eb81d"]], \
"Subsection",
 CellChangeTimes->{{3.893580888154965*^9, 3.893580889881576*^9}, {
  3.8935814191287107`*^9, 
  3.89358141919188*^9}},ExpressionUUID->"8a5aad2a-0818-4790-8764-\
068203c85b05"],

Cell[TextData[{
 "\nWe simply have that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "0"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["r", "min", "2"], 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}]], "'"}], 
        RowBox[{"(", 
         SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
       RowBox[{"(", 
        RowBox[{"\[Delta]", " ", "and", " ", 
         RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
         SubscriptBox["r", "min"]}], ")"}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"14eb7434-775c-47fb-90a9-c77565a89a93"],
 ". This is proportional to the second term in expression for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "3b8a4659-8e25-459a-8897-d11382afce43"],
 ".\nWe find that this contribution identically vanishes, because the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "1"}], ",", 
    RowBox[{"m", "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "1aad7e56-09c6-4016-b268-8d6a6112651e"],
 " component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "7c5784f2-534d-40d3-bc6d-af71f9b7990b"],
 " is zero.\t"
}], "Text",
 CellChangeTimes->{{3.8935809208418493`*^9, 3.893581133472534*^9}, {
  3.89358142852661*^9, 3.893581443010607*^9}, {3.893581476152308*^9, 
