Cell[BoxData[{
 RowBox[{
  RowBox[{"tmp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"my\[CapitalDelta]", "[", "r", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{"-", "Weylspin"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"my\[CapitalDelta]", "[", "r", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"Weylspin", "+", "1"}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"myf", "[", "r", "]"}], ",", "r"}], "]"}]}], ",", "r"}], 
        "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"myK", "[", "mym", "]"}], "[", "r", "]"}], "^", "2"}], 
            " ", "-", " ", 
            RowBox[{"2", " ", "I", " ", "Weylspin", " ", 
             RowBox[{"(", 
              RowBox[{"r", "-", "M"}], ")"}], " ", 
             RowBox[{
              RowBox[{"myK", "[", "mym", "]"}], "[", "r", "]"}]}]}], ")"}], "/", 
          RowBox[{"my\[CapitalDelta]", "[", "r", "]"}]}], "+", " ", 
         RowBox[{"4", " ", "I", " ", "Weylspin", " ", 
          RowBox[{"\[Omega]m", "[", "mym", "]"}], " ", "r"}], " ", "-", " ", 
         RowBox[{"my\[Lambda]", "[", 
          RowBox[{"myl", ",", "Weylspin"}], "]"}]}], ")"}], 
       RowBox[{"myf", "[", "r", "]"}]}]}], " ", "/.", " ", 
     RowBox[{"myf", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{"r", ",", 
        RowBox[{
         RowBox[{"\[Psi]m", "[", "r", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Psi]p", "[", "r", "]"}], "-", 
            RowBox[{"\[Psi]m", "[", "r", "]"}]}], ")"}], " ", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"r", "-", "r0"}], "]"}]}], " ", "+", " ", 
         RowBox[{"\[Psi]\[Delta]", " ", 
          RowBox[{"DiracDelta", "[", 
           RowBox[{"r", "-", "r0"}], "]"}]}]}]}], "]"}]}]}], " ", "//", " ", 
    "Simplify"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LHS\[Delta]Term", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"tmp", ",", 
      RowBox[{"DiracDelta", "[", 
       RowBox[{"r", "-", "r0"}], "]"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LHS\[Delta]pTerm", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"tmp", ",", 
      RowBox[{
       RowBox[{"DiracDelta", "'"}], "[", 
       RowBox[{"r", "-", "r0"}], "]"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LHS\[Delta]ppTerm", "[", "r_", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"tmp", ",", 
       RowBox[{
        RowBox[{"DiracDelta", "''"}], "[", 
        RowBox[{"r", "-", "r0"}], "]"}]}], "]"}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LHS\[Delta]ppConstTerm", " ", "=", " ", 
   RowBox[{
    RowBox[{"LHS\[Delta]ppTerm", "[", "r0", "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LHS\[Delta]pConstTerm", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"LHS\[Delta]pTerm", "[", "r0", "]"}], "-", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"LHS\[Delta]ppTerm", "'"}], "[", "r0", "]"}]}]}], " ", "//", 
    " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LHS\[Delta]ConstTerm", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"LHS\[Delta]Term", "[", "r0", "]"}], "-", 
     RowBox[{
      RowBox[{"LHS\[Delta]pTerm", "'"}], "[", "r0", "]"}], "+", 
     RowBox[{
      RowBox[{"LHS\[Delta]ppTerm", "''"}], "[", "r0", "]"}]}], " ", "//", " ",
     "Simplify"}]}], ";"}]}], "Input",
