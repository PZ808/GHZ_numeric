Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRange", " ", "=", " ", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPsi]barInwardData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rmax", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
         RowBox[{"i", "/", "iRange"}]}]}], ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
            RowBox[{
             RowBox[{"\[CapitalPsi]barInward", "[", 
              RowBox[{"l", ",", 
               RowBox[{"-", "m"}]}], "]"}], "[", 
             RowBox[{"rmax", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"rNumOutbd", "-", "rmax"}], ")"}], " ", 
               RowBox[{"i", "/", "iRange"}]}]}], "]"}]}], "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "iRange"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRule", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
     RowBox[{"\[CapitalPsi]barInwardData", "[", 
      RowBox[{"[", 
       RowBox[{"20", ";;", "All"}], "]"}], "]"}]}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"r", "^", 
      RowBox[{"(", 
       RowBox[{"-", "b"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "b"}], "}"}], ",", "r"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{"Abs", "@", "\[CapitalPsi]barInwardData"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "b"}], ")"}]}]}], " ", "/.", " ", "paraFitRule"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"r", ",", "rmax", ",", "rNumOutbd"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}], "Input",
