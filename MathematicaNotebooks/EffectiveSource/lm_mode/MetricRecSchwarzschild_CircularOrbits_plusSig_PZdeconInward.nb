            RowBox[{"\[Psi]ResFrom\[Psi]New", "[", 
             RowBox[{"20", ",", "15"}], "]"}], "[", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
