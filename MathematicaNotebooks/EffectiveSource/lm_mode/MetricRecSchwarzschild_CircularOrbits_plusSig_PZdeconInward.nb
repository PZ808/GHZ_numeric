     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"\[Rho]K", " ", "+", " ", 
         RowBox[{"Conjugate", "[", "\[Rho]K", "]"}]}], ")"}]}], " ", 
      "Mdot"}]}], ";", " ", "\[IndentingNewLine]", 
    RowBox[{"gdotnm4DExpr", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "\[Rho]K"}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Rho]K", " ", "+", " ", 
        RowBox[{"Conjugate", "[", "\[Rho]K", "]"}]}], ")"}], 
      FractionBox["I", 
       RowBox[{"Sqrt", "[", "2", "]"}]], "Jdot", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
