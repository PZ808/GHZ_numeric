Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox["Redshift", TraditionalForm]],ExpressionUUID->
  "b416953d-622d-43b0-84d3-eddb931a6dc2"],
 " formula"
}], "Section",
 CellChangeTimes->{{3.893998592948285*^9, 3.893998610500874*^9}, {
  3.893998666210948*^9, 
  3.893998667331328*^9}},ExpressionUUID->"9798df6f-5348-4fdb-9a7a-\
b258a20dece9"],

Cell[TextData[{
 "We use as definition of the redshift: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "uu"], " ", ":=", " ", 
    RowBox[{
     SubscriptBox["h", "ab"], 
     SuperscriptBox["u", "a"], 
     SuperscriptBox["u", "b"]}]}], TraditionalForm]],ExpressionUUID->
  "b5ae7bda-d54b-4ceb-a1bd-e775ab9ba8ba"],
 ".\n Using that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "a"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["l", "a"]}], 
      SubscriptBox["u", "n"]}], "-", 
     RowBox[{
      SuperscriptBox["n", "a"], 
      SubscriptBox["u", "l"]}], "+", 
     RowBox[{
      SuperscriptBox["m", "a"], 
      SubscriptBox["u", 
       OverscriptBox["m", "_"]]}], "+", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["m", "_"], "a"], 
      SubscriptBox["u", "m"]}]}]}], TraditionalForm]],ExpressionUUID->
  "3ea83a0e-a6a8-43b0-a698-094df00fa1fe"],
 "   \[Implies]   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["h", "ab"], 
     SuperscriptBox["u", "a"], 
     SuperscriptBox["u", "b"]}], " ", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["h", "ll"], 
      SubsuperscriptBox["u", "n", "2"]}], "+", 
     RowBox[{"2", 
      SubscriptBox["h", "ln"], 
      SubscriptBox["u", "n"], 
      SubscriptBox["u", "l"]}], "-", 
     RowBox[{"2", 
      SubscriptBox["h", "lm"], 
      SubscriptBox["u", "n"], 
      SubscriptBox["u", 
       OverscriptBox["m", "_"]]}], "-", 
     RowBox[{"2", 
      SubscriptBox["h", 
       RowBox[{"l", 
        OverscriptBox["m", "_"]}]], 
      SubscriptBox["u", "n"], 
      SubscriptBox["u", "m"]}], "+", 
     RowBox[{
      SubscriptBox["h", "nn"], 
      SubsuperscriptBox["u", "l", "2"]}], "-", 
     RowBox[{"2", 
      SubscriptBox["h", "nm"], 
      SubscriptBox["u", "l"], 
      SubscriptBox["u", 
       OverscriptBox["m", "_"]]}], "-", 
     RowBox[{"2", 
      SubscriptBox["h", 
       RowBox[{"n", 
        OverscriptBox["m", "_"]}]], 
      SubscriptBox["u", "l"], 
      SubscriptBox["u", "m"]}], "+", 
     RowBox[{
      SubscriptBox["h", "mm"], 
      SubsuperscriptBox["u", 
       OverscriptBox["m", "_"], "2"]}], "+", 
     RowBox[{"2", 
      SubscriptBox["h", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]], 
      SubscriptBox["u", 
       OverscriptBox["m", "_"]], 
      SubscriptBox["u", "m"]}], "+", " ", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{
        OverscriptBox["m", "_"], 
        OverscriptBox["m", "_"]}]], 
      SubsuperscriptBox["u", "m", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"e2ccb58a-ad6f-4d14-8fdc-4807855665e1"],
 ".\n \n Note that if  we are working with the trace-reversed metric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "ab"], "=", 
    RowBox[{
     SubscriptBox["h", "ab"], "-", 
     RowBox[{
      FractionBox["1", "2"], "h", " ", 
      SubscriptBox["g", "ab"]}]}]}], TraditionalForm]],ExpressionUUID->
  "151ca91b-9be8-4182-ab68-ae140eb58694"],
 ", then to leading order (mostly positive signature): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "ab"], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", 
        FractionBox[
         RowBox[{"4", 
          SubscriptBox["Mu", "a"], 
          SubscriptBox["u", "b"]}], "R"]}], "+"}], "..."}], "."}]}], 
   TraditionalForm]],ExpressionUUID->"b7764933-17e4-4277-b384-4e7f5ecb6e78"],
 " (R is 4D distance).\nSo, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["h", "_"], "uu"], "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"4", "M"}], "R"]}], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"a0976f21-865c-42b5-ad61-6e5902156838"],
 ", while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "ab"], "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"M", "(", 
          RowBox[{
           SubscriptBox["g", "ab"], "+", 
           RowBox[{"2", 
            SubscriptBox["u", "a"], 
            SubscriptBox["u", "b"]}]}], ")"}]}], "R"]}], "+"}], "..."}]}], 
   TraditionalForm]],ExpressionUUID->"76dffa96-0f1a-40aa-9c79-925dc2c91c2d"],
 ", so  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "uu"], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", "M"}], "R"]}], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"fb29fa02-6183-422e-bc31-94615c7156a7"],
 ". So, to leading order, there is a factor of 2 difference in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "uu"], TraditionalForm]],ExpressionUUID->
  "51099d60-85c1-43cb-852a-ea6cc6d7bae4"],
 " between trace-reversed and non-trace-reversed."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.893998626541276*^9, 3.8939986884213676`*^9}, {
  3.893998726909534*^9, 3.893998727622652*^9}, {3.8939988189356337`*^9, 
  3.893998823340618*^9}, {3.898838190331808*^9, 3.8988381958602953`*^9}, {
  3.898838229505108*^9, 
  3.8988382650178747`*^9}},ExpressionUUID->"d0412c94-ef3d-43ad-939d-\
87a4ba531553"],

Cell[TextData[{
 "Below is the general formula for the general quantity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "uu"], TraditionalForm]],ExpressionUUID->
  "8c3b8799-ae2e-4449-9dcf-e012f529ad94"],
 " given ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "ab"], TraditionalForm]],ExpressionUUID->
  "2be575e5-38d2-44a4-af77-2819af9ea525"],
 " in Kinnersley tetrad."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.893998825904759*^9, 3.893998874270193*^9}, {
  3.893999024454874*^9, 3.893999027191669*^9}, {3.89399975704578*^9, 
  3.893999757939027*^9}},ExpressionUUID->"9304e1ee-d9f5-4149-8428-\
4475bed0a14c"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "redshift$Contribution$Formula", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"redshift$Contribution$Formula", "[", 
    RowBox[{
    "fll_", ",", "fln_", ",", "flm_", ",", "flmb_", ",", "fnn_", ",", "fnm_", 
     ",", "fnmb_", ",", "fmm_", ",", "fmmb_", ",", "fmbmb_"}], "]"}], " ", ":=",
    " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fll", " ", 
     RowBox[{"un", "^", "2"}]}], "+", "\[IndentingNewLine]", 
    RowBox[{"2", " ", "fln", " ", "un", " ", "ul"}], "-", 
    "\[IndentingNewLine]", 
    RowBox[{"2", " ", "flm", " ", "un", " ", "umb"}], "-", 
    "\[IndentingNewLine]", 
    RowBox[{"2", " ", "flmb", " ", "un", " ", "um"}], "+", 
    "\[IndentingNewLine]", 
