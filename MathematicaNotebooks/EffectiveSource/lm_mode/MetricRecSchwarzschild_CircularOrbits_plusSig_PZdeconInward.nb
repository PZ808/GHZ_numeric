0618570fa73e"],

Cell[TextData[StyleBox["Note: because different tetrad indices are expanded \
in different bases, we will write the l modes of each quantity starting at \
l=0.\nFor those quantities that start at a higher l mode, we will define \
their lower l values as zero.",
 FontColor->RGBColor[0, 0, 1]]], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.8934107501688128`*^9, 3.893410794658382*^9}, {
  3.8937543832251663`*^9, 3.893754464532858*^9}, {3.893754798840073*^9, 
  3.893754800716419*^9}, {3.8940021770404263`*^9, 
  3.8940021791445723`*^9}},ExpressionUUID->"b1b456bc-ec7c-41e7-86af-\
38cd65e3634c"],

