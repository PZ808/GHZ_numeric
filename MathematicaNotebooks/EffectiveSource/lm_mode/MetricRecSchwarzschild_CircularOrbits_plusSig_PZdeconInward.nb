Cell[CellGroupData[{

Cell["Theory", "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8788066672288637`*^9, 3.8788066682679863`*^9}, {
  3.879841651770989*^9, 
  3.8798416525197487`*^9}},ExpressionUUID->"2d4c9d80-57e5-4b25-8087-\
98371b1894ab"],

Cell[TextData[{
 "General corrector tensor is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "ab"], " ", "=", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      SubscriptBox["m", 
       RowBox[{"(", "a"}]], 
      SubscriptBox[
       OverscriptBox["m", "_"], 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", 
       RowBox[{"m", 
        OverscriptBox["m", "_"]}]]}], " ", "-", " ", 
     RowBox[{"2", " ", 
      SubscriptBox["l", 
       RowBox[{"(", "a"}]], 
      SubscriptBox[
       OverscriptBox["m", "_"], 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", "nm"]}], "-", 
     RowBox[{"2", " ", 
      SubscriptBox["l", 
       RowBox[{"(", "a"}]], 
      SubscriptBox["m", 
       RowBox[{"b", ")"}]], " ", 
      SubscriptBox["x", 
       RowBox[{"n", 
        OverscriptBox["m", "_"]}]]}], "+", 
     RowBox[{
      SubscriptBox["l", "a"], 
      SubscriptBox["l", "b"], 
      SubscriptBox["x", "nn"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a58499d7-3010-48a6-a73e-fdac251a9652"],
 ", see ",
 ButtonBox["1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 " eq. (55). Defined to satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["T", "ab"], "-", 
       SubscriptBox[
        RowBox[{"(", "\[ScriptCapitalE]x", ")"}], "ab"]}], ")"}], 
     SuperscriptBox["l", "a"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7db6a9f4-c00c-4cb5-8dc0-6da72704f7c1"],
 ".\nNote that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "la"], "=", 
    RowBox[{
     SubscriptBox["x", "mm"], "=", 
     RowBox[{
      SubscriptBox["x", 
       RowBox[{
        OverscriptBox["m", "_"], 
        OverscriptBox["m", "_"]}]], "=", "0"}]}]}], TraditionalForm]],
  ExpressionUUID->"61c55f18-ead8-4da0-b82c-95e1cde0ed9e"],
 ". Only non-trivial pieces are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "nn"], ",", " ", 
    SubscriptBox["x", "nm"], ",", 
    SubscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}]], ",", 
    SubscriptBox["x", "mm"]}], TraditionalForm]],ExpressionUUID->
  "1ce14fc8-2027-4bab-a1d4-15d27a2e074c"],
 ". They are given by ODEs, see ",
 ButtonBox["2108.04273",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2108.04273.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/2108.04273.pdf"],
 ", eq. (56)-(61), and ",
 ButtonBox["1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 ", eq. (58)-(61). See also comment on page 38.\n\nIn general, the stress \
energy is of the schematic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["T", "ab"], " ", "~", " ", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"n", " "}]], 
       RowBox[{
        SubscriptBox["c", "1"], 
        SuperscriptBox["\[CapitalDelta]r", "n"]}]}]}], " ", "+", " ", 
     SubscriptBox["c", "2"]}], " ", "|", "\[CapitalDelta]r", "|", " ", 
    SuperscriptBox["\[CapitalDelta]r", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "38cc4503-a276-43f6-a03b-92de3635b8aa"],
 ".\nWe compute the contribution of each term separately.\nFirst term is \
simple to implement. For second term, we need to be careful if the \
integration crosses the particle.\nIn general, consider piecewise function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["f", "~"], "(", "x", ")"}], " ", "=", " ", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{"f", "(", "x", ")"}], 
           RowBox[{"x", "\[LessEqual]", "0"}]},
          {
           RowBox[{"g", "(", "x", ")"}], 
           RowBox[{"x", ">", "0"}]}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
         GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.84]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}},
         Selectable->True]}
      },
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.35]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     "Piecewise",
     DeleteWithContents->True,
     Editable->False,
     SelectWithContents->True,
     Selectable->False,
     StripWrapperBoxes->True]}], TraditionalForm]],ExpressionUUID->
  "2a97afeb-b792-4115-8548-915342b73228"],
 ", where f(0)=g(0). Define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"F", "(", "x", ")"}], " ", ":=", " ", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"f", "(", "x", ")"}], "dx"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"G", "(", "x", ")"}], " ", ":=", " ", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"g", "(", "x", ")"}], "dx"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"b40eb784-af46-47f7-b8c2-ef06930b3a69"],
 ".\nThen, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["F", "~"], "(", "x", ")"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", "a", "x"], " ", 
      RowBox[{
       RowBox[{
        OverscriptBox["f", "~"], "(", "x", ")"}], "dx"}]}], " ", "=", " ", 
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             RowBox[{"F", "(", "x", ")"}], "-", 
             RowBox[{"F", "(", "a", ")"}]}], 
            RowBox[{"x", "\[LessEqual]", "0"}]},
           {
            RowBox[{
             RowBox[{"-", 
              RowBox[{"F", "(", "a", ")"}]}], "+", 
             RowBox[{"F", "(", "0", ")"}], "+", 
             RowBox[{"G", "(", "x", ")"}], "-", 
             RowBox[{"G", "(", "0", ")"}]}], 
            RowBox[{"x", ">", "0"}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
          GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.84]}, 
              Offset[0.27999999999999997`]}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}},
          Selectable->True]}
       },
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.35]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      "Piecewise",
      DeleteWithContents->True,
      Editable->False,
      SelectWithContents->True,
      Selectable->False,
      StripWrapperBoxes->True]}]}], TraditionalForm]],ExpressionUUID->
  "f6f9a9f1-c183-4d8a-a0cc-177bed4f2e73"],
 ". Easy to check that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["F", "~"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"6ffb4830-2399-4604-9cc3-aa4a538972a4"],
 " is continuous at x=0.\n\nFor the contribution of the delta function and \
its derivative, we will work withe computing: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", ":=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "-", "+"], 
     RowBox[{
      SubscriptBox["d\[Rho]", "2"], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "-", 
        SubscriptBox["\[Rho]", "2"]], 
       RowBox[{
        FractionBox[
         SubscriptBox["T", "ll"], 
         SubsuperscriptBox["\[Rho]", "1", "4"]], 
        SubscriptBox["d\[Rho]", "1"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"192ee2fa-02af-4465-8d5d-13525360eef2"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "ll"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"f", "(", "r", ")"}], 
       RowBox[{"\[Delta]", "(", 
        RowBox[{
         SubscriptBox["r", "min"], "-", "r"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"g", "(", "r", ")"}], 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["r", "min"], "-", "r"}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "(", "r", ")"}], 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "min"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"g", "(", "r", ")"}], 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "min"]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"abc064cd-6e20-471a-abb1-1eecde1c8baa"],
 " and we denote \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", " ", 
     RowBox[{":=", " ", 
      SubsuperscriptBox["r", "min", "-"]}]}], ",", " ", 
    RowBox[{"+", " ", 
     RowBox[{":=", " ", 
      SubsuperscriptBox["r", "max", "+"]}]}]}], TraditionalForm]],
  ExpressionUUID->"4d8f74b5-11c5-48b9-a73b-c6d5b29e44d0"],
 ".\n\[Delta] contribution:\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "-", "+"], 
     RowBox[{
      SubscriptBox["dr", "2"], 
      SubsuperscriptBox["r", "2", 
       RowBox[{"-", "2"}]], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "-", 
        SubscriptBox["r", "2"]], 
       RowBox[{
        SubsuperscriptBox["r", "1", "2"], " ", 
        RowBox[{"f", "(", 
         SubscriptBox["r", "1"], ")"}], 
        RowBox[{"\[Delta]", "(", 
         RowBox[{
          SubscriptBox["r", "1"], "-", 
          SubscriptBox["r", "min"]}], ")"}], " ", 
        SubscriptBox["dr", "1"]}]}]}]}], "=", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", "-", "+"], 
      RowBox[{
       SubscriptBox["dr", "2"], 
       SubsuperscriptBox["r", "2", 
        RowBox[{"-", "2"}]], 
       SubsuperscriptBox["r", "min", "2"], " ", 
       RowBox[{"f", "(", 
        SubscriptBox["r", "min"], ")"}], 
       RowBox[{"H", "(", 
        RowBox[{
         SubscriptBox["r", "2"], "-", 
         SubscriptBox["r", "min"]}], ")"}]}]}], " ", "=", " ", 
     RowBox[{
      SubsuperscriptBox["r", "min", "2"], " ", 
      RowBox[{"f", "(", 
       SubscriptBox["r", "min"], ")"}], 
      FractionBox[
       RowBox[{
        SubscriptBox["r", "max"], "-", 
        SubscriptBox["r", "min"]}], 
       RowBox[{
        SubscriptBox["r", "max"], 
        SubscriptBox["r", "min"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "b75a2286-90d4-49ed-9e5f-3f3b07291184"],
 ", where H(x) is the usual Heaviside function.\n \[Delta]\[CloseCurlyQuote] \
contribution:\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "-", "+"], 
     RowBox[{
      SubscriptBox["dr", "2"], 
      RowBox[{
       SubsuperscriptBox["r", "2", 
        RowBox[{"-", "2"}]], "(", 
       RowBox[{
        SubsuperscriptBox[
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["r", "1", "2"], 
           RowBox[{"g", "(", 
            SubscriptBox["r", "1"], ")"}], 
           RowBox[{"\[Delta]", "(", 
            RowBox[{
             SubscriptBox["r", "1"], "-", 
             SubscriptBox["r", "min"]}], ")"}]}], "]"}], "-", 
         SubscriptBox["r", "2"]], "+", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", "-", 
          SubscriptBox["r", "2"]], 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["r", "1", "2"], " ", 
             RowBox[{"g", "(", 
              SubscriptBox["r", "1"], ")"}]}], ")"}], "'"}], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["r", "1"], "-", 
            SubscriptBox["r", "min"]}], ")"}], " ", 
          SubscriptBox["dr", "1"]}]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"629df1e9-0e53-4f82-aeab-68a7da17692b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    RowBox[{"-", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "-", "+"], 
      RowBox[{
       SubscriptBox["dr", "2"], 
       RowBox[{
        SubsuperscriptBox["r", "2", 
         RowBox[{"-", "2"}]], "(", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["r", "2", "2"], 
          RowBox[{"g", "(", 
           SubscriptBox["r", "2"], ")"}], 
          RowBox[{"\[Delta]", "(", 
           RowBox[{
            SubscriptBox["r", "2"], "-", 
            SubscriptBox["r", "min"]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["r", "2", "2"], " ", 
             RowBox[{"g", "(", 
              SubscriptBox["r", "2"], ")"}]}], ")"}], "'"}], 
          RowBox[{"H", "(", 
           RowBox[{
            SubscriptBox["r", "2"], "-", 
            SubscriptBox["r", "min"]}], ")"}]}]}], ")"}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"8edd0629-7073-4a69-a9f8-3040402c3cc0"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"g", "(", 
         SubscriptBox["r", "min"], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          RowBox[{"g", "(", "r", ")"}]}], ")"}], "'"}]}]}], ")"}], 
    SubscriptBox["|", 
     SubscriptBox["r", "min"]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["r", "min"], "+"], 
     RowBox[{
      SubscriptBox["dr", "2"], 
      SubsuperscriptBox["r", "2", 
       RowBox[{"-", "2"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "9da5374a-3cf2-4d84-b1ac-59c509569b3b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"g", "(", 
         SubscriptBox["r", "min"], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          RowBox[{"g", "(", "r", ")"}]}], ")"}], "'"}]}]}], ")"}], 
    SubscriptBox["|", 
     SubscriptBox["r", "min"]], 
    FractionBox[
     RowBox[{
      SubscriptBox["r", "max"], "-", 
      SubscriptBox["r", "min"]}], 
     RowBox[{
      SubscriptBox["r", "max"], 
      SubscriptBox["r", "min"]}]]}], TraditionalForm]],ExpressionUUID->
  "aebce4e0-0741-4712-bc58-85b08adfc30e"],
 ".\n\n",
 StyleBox["So, full contribution for delta functions and derivatives at ",
  FontVariations->{"Underline"->True}],
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],
  FontWeight->"Plain",
  FontVariations->{"Underline"->True},ExpressionUUID->
  "a2d24e87-0ff3-41b9-8503-edcb782326ce"],
 StyleBox[" is:",
