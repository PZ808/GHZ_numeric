       RowBox[{"2", ",", "l", ",", "m"}], "]"}], "'"}], "[", "r0", "]"}], " ",
     "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"SabTab\[Delta]ppTerm", "[", 
       RowBox[{"2", ",", "l", ",", "m"}], "]"}], "''"}], "[", "r0", "]"}]}]}],
   ";"}]}], "Input",
 Evaluatable->False,
