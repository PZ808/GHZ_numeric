Cell[CellGroupData[{

Cell[TextData[{
 "Redshift for different ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "2285dfae-668f-473a-aacd-e51128d34cc0"]
}], "Section",
 CellChangeTimes->{{3.9047114048726387`*^9, 
  3.9047114125147142`*^9}},ExpressionUUID->"b57e6006-4d82-4d19-bbd5-\
ebcb933e4821"],

Cell[TextData[{
 "For r0 = 8M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "GHZ"], " ", "=", " ", 
    RowBox[{"-", "0.2809995389719025"}]}], TraditionalForm]],ExpressionUUID->
  "6e474190-021e-43c9-a4ac-111bef2dc14e"],
 ".\nFor r0 = 9M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "GHZ"], " ", "=", " ", 
    RowBox[{"-", "0.24390486588748073"}]}], TraditionalForm]],ExpressionUUID->
  "948b928d-ec23-494e-a86f-10b56f291cb2"],
 ".\nFor r0 = 10M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "GHZ"], " ", "=", " ", 
    RowBox[{"-", "0.21606282961213014"}]}], TraditionalForm]],ExpressionUUID->
  "083cdc04-5fa5-47b4-b87f-86f18249d052"],
 ".\nFor r0 = 12M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "GHZ"], " ", "=", " ", 
    RowBox[{"-", "0.17655750951515695"}]}], TraditionalForm]],ExpressionUUID->
  "fa0ab424-a680-4f84-b128-5082002189b8"],
 ".\nFor r0 = 50M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "GHZ"], " ", "=", " ", 
    RowBox[{"-", "0.0404192524172486"}]}], TraditionalForm]],ExpressionUUID->
  "934b4530-0a9c-494c-8629-2eb950db46f5"],
 ".\nAll the above is done using a power law fitting for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", ">", 
     SubscriptBox["l", "max"]}], "=", "40"}], TraditionalForm]],
  ExpressionUUID->"ad74461c-ce59-4cbf-82cd-3d24ee4c043f"],
 "."
}], "Text",
 CellMargins->{{27, 10}, {7, 8}},
 CellChangeTimes->{{3.904711432599434*^9, 3.904711516862257*^9}, {
  3.904711549016453*^9, 3.904711632137227*^9}, {3.918898768577766*^9, 
