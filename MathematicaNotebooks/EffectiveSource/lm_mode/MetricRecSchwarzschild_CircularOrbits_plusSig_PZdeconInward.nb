   3.875697463795088*^9}, {3.875787425749255*^9, 
   3.875787425749312*^9}},ExpressionUUID->"641916c8-c630-4503-a10c-\
1ff5b605613a"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "ExpI\[Omega]rstar", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExpI\[Omega]rstar", "[", "m_", "]"}], "[", "r_", "]"}], " ", "=",
    " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", 
     RowBox[{"\[Omega]m", "[", "m", "]"}], " ", 
     RowBox[{"rstar", "[", "r", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.875640130863244*^9, 3.8756401483157883`*^9}, {
   3.8756402023636847`*^9, 3.875640255361219*^9}, 3.875640381181241*^9, 
