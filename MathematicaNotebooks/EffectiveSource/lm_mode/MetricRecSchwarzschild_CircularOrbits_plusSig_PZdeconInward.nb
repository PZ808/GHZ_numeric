Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]0DataLeft", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "Left", "]"}], 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}], " ", 
          RowBox[{
           RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], "]"}]}],
   ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{"\[Psi]0DataRight", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "Right", "]"}], 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}], " ", 
          RowBox[{
           RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "r0", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{"Abs", "@", 
     RowBox[{"{", 
      RowBox[{"\[Psi]0DataLeft", ",", "\[Psi]0DataRight"}], "}"}]}], "]"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "3000"], 
       SuperscriptBox["l", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], "]"}]}], "Input",\

