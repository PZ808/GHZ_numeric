Cell[TextData[{
 StyleBox["Now summing over the lm modes.",
  FontColor->GrayLevel[0]],
 StyleBox["\nNOTE: I am not multiplying back by ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    SuperscriptBox["i\[Omega]r", "\[Star]"]], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "f0a305dc-51cd-4e06-807b-a027f9cce02a"],
 StyleBox[" when summing over the individual lm modes!",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
