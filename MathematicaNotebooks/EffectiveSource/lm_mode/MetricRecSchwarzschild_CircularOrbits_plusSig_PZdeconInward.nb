Cell[CellGroupData[{

Cell["Check --- GHZ expressions", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.878199941315178*^9, 
  3.878199947077402*^9}},ExpressionUUID->"8b53827d-6f1a-4299-b826-\
9099c18fec13"],

Cell[TextData[{
 StyleBox["Not evaluable.",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\nSome expressions obtained here are directly copy-pasted to later \
parts of the notebook.",
  FontColor->GrayLevel[0]]
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.878200130519232*^9, 3.8782001348491383`*^9}, {
  3.8784681948828897`*^9, 
  3.8784682334318323`*^9}},ExpressionUUID->"2c125791-f5fc-4462-a0cb-\
25424d0437cd"],

Cell[TextData[{
 "Expressions for tetrad components of linearised Einstein operator can be \
found in ",
 ButtonBox["arXiv:1908.09095",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1908.09095.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1908.09095.pdf"],
 ", appendix A.\n",
 StyleBox["Note:\t",
  FontColor->RGBColor[0, 0, 1]],
 "1) need to write the terms in \[ScriptCapitalE]hPWorldtubePiece in the \
format hNullK[a,b].\n\t\t2) make sure you use u slicing for the expression of \
\[ScriptCapitalE]hPWorldtubePiece!\n\t\t3) GHZ works in mostly negative \
convention. To get agreement (aka, check functional form of \
\[ScriptCapitalE]h), need to add a minus sign!"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8782000039521303`*^9, 3.878200109117774*^9}, {
   3.8788088307336397`*^9, 3.878808831194828*^9}, 3.878808977390246*^9, {
   3.878809091767232*^9, 3.878809137304597*^9}, 3.8833787283081713`*^9, 
   3.887694670286518*^9, {3.8969518678015833`*^9, 3.8969518833254833`*^9}, {
   3.898690605757195*^9, 3.898690637531494*^9}, {3.8987890184172993`*^9, 
   3.898789019219181*^9}, {3.898835077191331*^9, 
   3.8988351701887712`*^9}},ExpressionUUID->"5f3d37e5-0672-401a-9fe4-\
33ac53ea21a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPsi]2", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "M"}], "/", 
    RowBox[{"r", "^", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPsi]3", " ", "=", " ", "0"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"I", " ", "am", " ", "assuming", " ", "this"}], ",", " ", 
     RowBox[{
     "as", " ", "this", " ", "is", " ", "what", " ", "is", " ", "needed", " ",
       "to", " ", "make", " ", "the", " ", 
      SubscriptBox[
       StyleBox["h",
        FontColor->RGBColor[1, 0, 0]], "ll"], " ", "term", " ", "in", " ", 
      FormBox[
       SubscriptBox[
        RowBox[{"(", "\[ScriptCapitalE]h", ")"}], "lm"],
       TraditionalForm], " ", 
      RowBox[{"agree", 
       StyleBox[".",
        FontColor->RGBColor[1, 0, 0]]}]}]}],
    FontColor->RGBColor[1, 0, 0]], " ", "*)"}]}]}], "Input",
 Evaluatable->False,
