Cell[BoxData[{
 RowBox[{
  RowBox[{"WTresidualCheckIn", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rr", ",", 
       RowBox[{
        RowBox[{"teukolskyResidualData", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
