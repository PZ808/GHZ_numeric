Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"aCircDistrContributionAtRmaxTMP", "[", 
     RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Tll\[Delta]pCoeff", "[", 
         RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}], " ", "/.", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Tll\[Delta]Coeff", "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", 
        " ", 
        RowBox[{"Tll\[Delta]RmaxPiece", "[", 
         RowBox[{"l", ",", "m"}], "]"}]}]}], " ", "/.", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Tll\[Delta]pCoeff", "[", 
         RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", " ", 
       RowBox[{"Tll\[Delta]pRmaxPiece", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}]}], "  ", "//", " ", "Simplify"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]", ">", "0"}], ",", 
        RowBox[{"rmax", ">", "rmin", ">", "0"}]}], "}"}], ",", 
      RowBox[{"Simplify", "@", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r2", "^", 
           RowBox[{"(", 
            RowBox[{"-", "2"}], ")"}]}], 
          RowBox[{"r1", "^", "2"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Tll\[Delta]Coeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}], " ", 
             RowBox[{"DiracDelta", "[", 
              RowBox[{"r1", "-", "rmax"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{
              RowBox[{"Tll\[Delta]pCoeff", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "rmax", "]"}], " ", 
             RowBox[{
              RowBox[{"DiracDelta", "'"}], "[", 
              RowBox[{"r1", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r2", ",", 
           RowBox[{"rmin", "-", "\[Epsilon]"}], ",", 
           RowBox[{"rmax", "+", "\[Epsilon]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r1", ",", 
           RowBox[{"rmin", "-", "\[Epsilon]"}], ",", "r2"}], "}"}]}], 
        "]"}]}]}], "]"}], " ", "/.", " ", 
    RowBox[{"\[Epsilon]", " ", "->", " ", "0"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aCircDistrContributionAtRmax", "[", 
   RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"aCircDistrContributionAtRmaxTMP", "[", 
        RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], " ", "/.", " ", 
       "h\[ScriptCapitalP]TaylorAnalyticRule"}], ")"}], " ", "+", 
     "\[IndentingNewLine]", "\t\t\t", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"aCircDistrContributionAtRmaxTMP", "[", 
         RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], " ", "/.", " ", 
        "h\[ScriptCapitalP]TaylorAbs\[CapitalDelta]rRule"}], ")"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], " ", "/.", " ", "rTo\[Rho]Rule"}], 
   " ", "//", " ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}], 
    "&"}]}]}]}], "Input",
 Evaluatable->False,
