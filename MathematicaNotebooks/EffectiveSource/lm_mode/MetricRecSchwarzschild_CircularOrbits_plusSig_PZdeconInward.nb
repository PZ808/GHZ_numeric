Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPhi]Data", " ", "=", " ", 
   RowBox[{"Abs", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
             RowBox[{
              RowBox[{"\[CapitalPhi]Mbar", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "[", 
              RowBox[{"rmin", "+", 
               RowBox[{"1", "/", "10"}]}], "]"}], " ", 
             StyleBox[
              RowBox[{
               RowBox[{"ExpI\[Omega]rstar", "[", 
                RowBox[{"-", "m"}], "]"}], "[", 
               RowBox[{"rmin", "+", 
                RowBox[{"1", "/", "10"}]}], "]"}],
              FontColor->GrayLevel[0]]}], "]"}], " ", 
           RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
             RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", 
            RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRule", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"\[CapitalPhi]Data", "[", 
      RowBox[{"[", 
       RowBox[{"25", ";;", "All"}], "]"}], "]"}], "]"}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "0.3"}], "}"}]}], "}"}], ",", "l"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", "\[CapitalPhi]Data", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], " ", "l"}], "]"}]}], "/.", " ", "paraFitRule"}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], "]"}]}],
