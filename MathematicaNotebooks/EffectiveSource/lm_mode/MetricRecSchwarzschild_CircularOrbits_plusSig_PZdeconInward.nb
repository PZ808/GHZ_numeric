       RowBox[{"l", "-", "m"}], "o"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a440a079-9f45-47f5-b4f8-beb5adaaa0be"],
 ".\nThen, because we are working with the residual field = retarded - \
puncture, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["A", "o"], "=", 
