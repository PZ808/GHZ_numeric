      "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xnmTermNoCoeffRule", "[", 
        RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], "[", "r", "]"}], "   ", "/.",
       " ", "coeffRule"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"xnmbTerm", "[", 
       RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "r_", "]"}], " ", 
     "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xnmbTermNoCoeffRule", "[", 
        RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], "[", "r", "]"}], " ", "/.",
       " ", "coeffRule"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"xnnTerm", "[", 
       RowBox[{"l_", ",", "m_", ",", "aExp"}], "]"}], "[", "r_", "]"}], "   ",
      "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"xnnTermNoCoeffRule", "[", 
        RowBox[{"l", ",", "m", ",", "aExp"}], "]"}], "[", "r", "]"}], "   ", "/.",
       " ", "coeffRule"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"aExp", ",", "0", ",", "orderOfPuncture"}], "}"}]}], 
