 RowBox[{"Clear", "[", "Pl", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pl", "[", 
   RowBox[{"l_", ",", "1"}], "]"}], ":=", "1"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Derivative", "[", 
     RowBox[{"0", ",", "m_"}], "]"}], "[", "Pl", "]"}], "[", 
   RowBox[{"l_", ",", "1"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "^", "m"}], " ", 
      RowBox[{"m", "!"}]}], ")"}]}], " ", 
