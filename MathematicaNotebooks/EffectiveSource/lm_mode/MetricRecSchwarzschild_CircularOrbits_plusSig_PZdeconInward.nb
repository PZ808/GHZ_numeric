          RowBox[{"(", 
           RowBox[{"\[Delta]", "^", "2"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", "i"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "+", "n"}], ")"}]}], " ", 
