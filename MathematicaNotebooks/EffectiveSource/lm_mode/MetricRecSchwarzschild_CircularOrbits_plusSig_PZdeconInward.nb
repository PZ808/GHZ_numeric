  3.892970339746449*^9}},ExpressionUUID->"4678317b-2f70-46f3-ab63-\
ca5837f3adcd"],

Cell[TextData[{
 "Integrate (59) in reconstruction paper at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "72f3de2b-6d61-44ce-84ee-09920be59d2c"],
 ", so that only distributional pieces contribute."
}], "Text",
 CellChangeTimes->{{3.892970366522747*^9, 
  3.8929704250847*^9}},ExpressionUUID->"0220cfcd-db30-4abe-926a-99b2fd7d8033"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]", ">", "0"}], ",", 
        RowBox[{"rmax", ">", "0"}], ",", 
        RowBox[{"r1", ">", "0"}], ",", 
        RowBox[{"r", "<", "rmax"}], ",", 
        RowBox[{"\[Rho]", "<", "0"}]}], "}"}], ",", 
      RowBox[{"-", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r2", "^", 
           RowBox[{"(", 
            RowBox[{"-", "2"}], ")"}]}], " ", 
          RowBox[{"r1", "^", "2"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Tll\[Delta]Coeff", "[", 
              RowBox[{"l", ",", "m"}], "]"}], " ", 
             RowBox[{"DiracDelta", "[", 
              RowBox[{"r1", "-", "rmax"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"Tll\[Delta]pCoeff", "[", 
              RowBox[{"l", ",", "m"}], "]"}], " ", 
             RowBox[{
              RowBox[{"DiracDelta", "'"}], "[", 
              RowBox[{"r1", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r2", ",", 
           RowBox[{"rmax", "+", "\[Epsilon]"}], ",", "r"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r1", ",", 
           RowBox[{"rmax", "+", "\[Epsilon]"}], ",", "r2"}], "}"}]}], 
        "]"}]}]}], "]"}], "/.", " ", 
    RowBox[{"r", "->", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "\[Rho]"}]}]}], "/.", " ", 
   RowBox[{"rmax", "->", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "\[Rho]max"}]}]}], "//", "Simplify"}]], "Input",\

 CellChangeTimes->{{3.9920803904381523`*^9, 3.9920804321179333`*^9}, {
  3.9920804846472473`*^9, 3.992080489970171*^9}, {3.992086885091221*^9, 
  3.992086889135228*^9}, {3.992086951472302*^9, 3.992086956257155*^9}},
 CellLabel->
  "In[393]:=",ExpressionUUID->"81110d92-8432-44d4-986f-dc9503dd1286"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{
        RowBox[{"(", 
          RowBox[{"\[Rho]", "-", "\[Rho]max"}], ")"}], " ", 
        RowBox[{"Tll\[Delta]Coeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}], "+", 
      RowBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"2", " ", "\[Rho]"}], "-", "\[Rho]max"}], ")"}], " ", 
        "\[Rho]max", " ", 
        RowBox[{"Tll\[Delta]pCoeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}]}], 
    SuperscriptBox["\[Rho]max", "2"]], 
   RowBox[{"\[Rho]", "<", "0"}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{
  3.992080370355247*^9, {3.992080415139176*^9, 3.992080432369266*^9}, 
   3.992080485143553*^9, {3.992086902941814*^9, 3.992086921918625*^9}, 
   3.9920869631372557`*^9, 3.9924109237138453`*^9, 3.9925103532893267`*^9, 
