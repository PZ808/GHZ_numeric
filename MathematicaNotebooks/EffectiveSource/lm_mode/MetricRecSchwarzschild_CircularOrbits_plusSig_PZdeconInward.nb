Cell[TextData[{
 StyleBox["Looking at the ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["L", "2"], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "ac084308-adfb-4c47-af8c-e96a75a244c1"],
 StyleBox[" norm",
  FontColor->GrayLevel[0]],
 " over the sphere centered around the central black hole. Using \
orthonormality of the harmonics, this is simply ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"||", 
     SubscriptBox["h", "ab"], 
     SubscriptBox["||", 
      SuperscriptBox["L", "2"]]}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "lm"], " ", 
     RowBox[{"|", 
      RowBox[{
       SubsuperscriptBox["h", "ab", "lm"], "(", "r", ")"}], 
      SuperscriptBox["|", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "7c6b8652-89bd-4498-8694-55d3b9a53a24"],
 "."
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
