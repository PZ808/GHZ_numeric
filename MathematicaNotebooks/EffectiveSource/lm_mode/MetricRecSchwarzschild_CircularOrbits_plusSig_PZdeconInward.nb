         RowBox[{
          RowBox[{
           RowBox[{"h\[ScriptCapitalP]leven", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{
            RowBox[{"h\[ScriptCapitalP]lodd", "[", 
