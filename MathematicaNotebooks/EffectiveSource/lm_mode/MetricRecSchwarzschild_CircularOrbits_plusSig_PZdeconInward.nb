  3.89297227904158*^9}},ExpressionUUID->"7b54af57-e053-4816-af40-\
938098a488bd"],

Cell[TextData[{
 "Quantities evaluated at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "e4792460-2496-49ab-aa19-a5883b57dc89"],
 " are shown with a minus exponent: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["F", "+"], " ", ":=", " ", 
    RowBox[{"F", "(", 
     SubscriptBox["r", "max"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "56bf6ed0-b2e1-45e4-b553-aa8dd12d11b4"],
 ".\nEq. (56) is:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["r", 
       RowBox[{"-", "2"}]]}], " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["r", "2"], " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "r"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]], " ", 
           RowBox[{"H", "(", 
            RowBox[{
             RowBox[{"-", "r"}], "+", 
             SubscriptBox["r", "max"]}], ")"}]}], ")"}]}]}], ")"}]}]}], " ", "=",
     " ", 
    SubscriptBox["T", "ll"]}], TraditionalForm]],ExpressionUUID->
  "63f453d1-24f4-40ae-a2cf-8851dcda8f38"],
 ".\n"
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 CellChangeTimes->{{3.8929704410872707`*^9, 3.892970551340023*^9}, {
  3.893651323246397*^9, 3.8936513250624104`*^9}, {3.893742040811207*^9, 
  3.8937420547281322`*^9}, {3.893742108789589*^9, 3.893742118436356*^9}, {
  3.893742190091523*^9, 3.893742190091653*^9}, {3.897968675346644*^9, 
  3.897968683266622*^9}, {3.89883833601869*^9, 3.8988383742344503`*^9}, {
