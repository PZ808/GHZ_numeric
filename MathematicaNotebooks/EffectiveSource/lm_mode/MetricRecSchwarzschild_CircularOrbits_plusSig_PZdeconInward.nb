Cell[BoxData[{
 RowBox[{"Clear", "[", "\[ScriptCapitalN]OfFH", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalN]OfFH", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[ScriptCapitalN]NullK", "[", 
      RowBox[{"0", ",", "l"}], "]"}], "[", 
     RowBox[{
      RowBox[{"F", "[", "r", "]"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "//", " ", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{"r", "-", "rmin"}], "]"}], ",", 
         RowBox[{"DiracDelta", "[", 
          RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], 
      "]"}], " ", "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"\[ScriptCapitalN]OfFH", "[", "r", "]"}], ",", 
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D", "[", 
