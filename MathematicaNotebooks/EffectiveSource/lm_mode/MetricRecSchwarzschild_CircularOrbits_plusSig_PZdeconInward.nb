    RowBox[{"l", "+", "m"}], ")"}], " ", 
   RowBox[{"LegendreP", "[", 
    RowBox[{"l", ",", 
     RowBox[{
      RowBox[{"-", "2"}], "+", "m"}], ",", "x"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["m", "2"], " ", 
   RowBox[{"LegendreP", "[", 
    RowBox[{"l", ",", "m", ",", "x"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"LegendreP", "[", 
    RowBox[{"l", ",", 
     RowBox[{"2", "+", "m"}], ",", "x"}], "]"}]}]}]], "Output",
