       "\[IndentingNewLine]", 
       RowBox[{"order", "=", 
        RowBox[{"fun", "[", "\"\<InterpolationOrder\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Coordinates\>\"", "->", "coords"}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "vals"}], ",", 
