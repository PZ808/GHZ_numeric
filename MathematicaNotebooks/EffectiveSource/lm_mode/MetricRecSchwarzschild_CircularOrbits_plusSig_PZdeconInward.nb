}]}]}]}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xmmbNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}], ",", 
            RowBox[{"xnmNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}], ",", 
            RowBox[{"xnnNDSolveRight", "[", 
             RowBox[{"l", ",", "m"}], "]"}]}], "}"}], "=", 
          "\[IndentingNewLine]", 
          RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", "xmmb", "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"\[Rho]", "^", "4"}], " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"myxmmb", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", "\[Rho]", 
                  "]"}]}]}], "==", 
               RowBox[{
                RowBox[{"TllRightInterpol", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", 
                RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"myxmmb", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}], "==", 
               RowBox[{"xmmbAt\[Rho]max", "[", 
                RowBox[{"l", ",", "m"}], "]"}]}], ",", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"myxmmb", "[", 
                  RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[Rho]max", 
                "]"}], "==", 
               RowBox[{"xmmbpAt\[Rho]max", "[", 
                RowBox[{"l", ",", "m"}], "]"}]}], ",", "\[IndentingNewLine]", 
              
              RowBox[{"(*", "xnm", " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"\[Rho]", "^", "2"}]}], "/", "2"}], " ", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"\[Rho]", "^", "4"}], " ", 
                   RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"myxnm", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]", "]"}], "/", 
                    RowBox[{"\[Rho]", "^", "2"}]}], ",", "\[Rho]"}], "]"}]}], 
                  ",", "\[Rho]"}], "]"}]}], "==", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"l", "==", "0"}], ",", "0", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"TlmRightInterpol", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "[", 
                   RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"\[ScriptCapitalN]NullK\[Rho]", "[", 
                    RowBox[{"0", ",", "l"}], "]"}], "[", 
                   RowBox[{
                    RowBox[{"myxmmb", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]", "]"}], 
                   "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"myxnm", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]max", "]"}], "==", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"l", "==", "0"}], ",", "0", ",", 
                 RowBox[{"xnmAt\[Rho]max", "[", 
                  RowBox[{"l", ",", "m"}], "]"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"myxnm", "[", 
                  RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[Rho]max", 
                "]"}], "==", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"l", "==", "0"}], ",", "0", ",", 
                 RowBox[{"xnmpAt\[Rho]max", "[", 
                  RowBox[{"l", ",", "m"}], "]"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", "xnn", " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"-", 
