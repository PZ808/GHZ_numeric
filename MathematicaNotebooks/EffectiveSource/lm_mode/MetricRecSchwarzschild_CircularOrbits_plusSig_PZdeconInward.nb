 CellLabel->
  "Out[393]=",ExpressionUUID->"17bc6e17-574d-4f19-b774-5e19161c4b0e"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "xmmbDistrContributionPiece", ",", "xmmbDistrContributionPieceAtRmax"}],
       "]"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"xmmbDistrContributionPiece", "[", 
