           RowBox[{"s", ",", "l", ",", "m"}], "]"}], "[", "\"\<Up\>\"", "]"}],
          "'"}], "[", "r", "]"}]}], "-", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]HomogInUpFn", "[", 
          RowBox[{"s", ",", "l", ",", "m"}], "]"}], "[", "\"\<Up\>\"", "]"}], 
