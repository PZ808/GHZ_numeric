Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"It", " ", "is", " ", "continuous", " ", "at", " ", "the", " ", 
    RowBox[{"worldline", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]rPlot", "=", 
     RowBox[{"1", "/", "10000000000000000"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"\[CapitalPhi]Mbar", "[", 
                   RowBox[{"l", ",", 
                    RowBox[{"-", "m"}]}], "]"}], "[", 
                  RowBox[{"r0", "-", "\[CapitalDelta]rPlot"}], "]"}], "-", 
                 RowBox[{
                  RowBox[{"\[CapitalPhi]Mbar", "[", 
                   RowBox[{"l", ",", 
                    RowBox[{"-", "m"}]}], "]"}], "[", 
                  RowBox[{"r0", "+", "\[CapitalDelta]rPlot"}], "]"}]}], ")"}],
                " ", 
               StyleBox[
                RowBox[{
                 RowBox[{"ExpI\[Omega]rstar", "[", 
                  RowBox[{"-", "m"}], "]"}], "[", "r0", "]"}],
                FontColor->GrayLevel[0]]}], "]"}], " ", 
             RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
              RowBox[{
               RowBox[{"-", "2"}], ",", "l", ",", "m", ",", 
               RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}]}]], "Input",
