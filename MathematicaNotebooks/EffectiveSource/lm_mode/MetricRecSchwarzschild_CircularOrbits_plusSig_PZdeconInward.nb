  3.992085326575897*^9, 
  3.992085329947691*^9}},ExpressionUUID->"cd29dd9e-c455-4e19-92d9-\
5b365a26307f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Assuming", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Epsilon]", ">", "0"}], ",", 
         RowBox[{"rmin", ">", "0"}], ",", 
         RowBox[{"r1", ">", "0"}], ",", 
         RowBox[{"r", "<", "rmax"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"\[Rho]", "^", "2"}], " ", 
        RowBox[{"Simplify", "@", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r2", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"xnmIntegrand\[Delta]Coeff", "[", 
                RowBox[{"l", ",", "m"}], "]"}], 
               RowBox[{"DiracDelta", "[", 
                RowBox[{"r1", "-", "rmax"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"xnmIntegrand\[Delta]pCoeff", "[", 
                RowBox[{"l", ",", "m"}], "]"}], " ", 
               RowBox[{
                RowBox[{"DiracDelta", "'"}], "[", 
                RowBox[{"r1", "-", "rmax"}], "]"}]}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r2", ",", 
             RowBox[{"rmax", "+", "\[Epsilon]"}], ",", "r"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r1", ",", 
             RowBox[{"rmax", "+", "\[Epsilon]"}], ",", "r2"}], "}"}]}], 
          "]"}]}]}]}], "]"}], " ", "/.", " ", 
     RowBox[{"r", "->", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "\[Rho]"}]}]}], "/.", " ", 
    RowBox[{"rmax", "->", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "\[Rho]max"}]}]}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.992086357081414*^9, 3.9920863606710377`*^9}, {
  3.992086410627849*^9, 3.9920864907592773`*^9}, {3.992086558851715*^9, 
