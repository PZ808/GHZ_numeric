Cell["\<\
The second type of integral involves:
1/(1-x^2) m/(2l+1) ((2+l) (l+m) P[-1+l,m,x]-(-1+l) (1+l-m) P[1+l,m,x])\
\>", "Text",
 Evaluatable->False,ExpressionUUID->"624d5694-eccc-46ec-86d5-6ab2787b233b"],

Cell["This simplifies to:", "Text",
