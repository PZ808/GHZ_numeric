97960aaa255e"],

Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], \nwhile in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"a3241cb7-7d96-44b6-91a1-57049183532d"]
}], "Text",
 CellMargins->{{66, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 3.8929713039202633`*^9}, {
   3.992087482086911*^9, 3.992087498658115*^9}, 
   3.9920875533250303`*^9},ExpressionUUID->"f8cbbab9-f95c-44ee-a78b-\
dffb63c80b3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"xnmAt\[Rho]maxViaIntegration", "[", 
     RowBox[{"l", ",", "m"}], "]"}], " ", "==", " ", 
    RowBox[{"xnmAt\[Rho]maxViaODE", "[", 
     RowBox[{"l", ",", "m"}], "]"}]}], " ", ")"}], "/.", " ", 
  RowBox[{
   RowBox[{"xnmIntegrand\[Delta]pCoeff", "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], "->", " ", 
   RowBox[{"Tlm\[Delta]pCoeff", "[", 
    RowBox[{"l", ",", "m"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]max", "^", "2"}], " ", 
        RowBox[{"xnmpAt\[Rho]maxViaIntegration", "[", 
         RowBox[{"l", ",", "m"}], "]"}]}], " ", "==", " ", 
       RowBox[{"xnmpAt\[Rho]maxViaODE", "[", 
        RowBox[{"l", ",", "m"}], "]"}]}], " ", " ", "/.", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"xnmIntegrand\[Delta]Coeff", "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Tlm\[Delta]Coeff", "[", 
           RowBox[{"l", ",", "m"}], "]"}], "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", 
           RowBox[{
            RowBox[{"\[Eth]CK", "[", 
             RowBox[{"0", ",", "l"}], "]"}], "[", 
            RowBox[{"xmmb", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "]"}]}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"xnmIntegrand\[Delta]pCoeff", "[", 
          RowBox[{"l_", ",", "m_"}], "]"}], " ", "->", " ", 
         RowBox[{"Tlm\[Delta]pCoeff", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}]}], "}"}]}], " ", "/.", "  ", 
     RowBox[{"\[Eth]xmmb", " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Eth]CK", "[", 
        RowBox[{"0", ",", "l"}], "]"}], "[", 
       RowBox[{"xmmb", "[", 
        RowBox[{"l", ",", "m"}], "]"}], "]"}]}]}], " ", "/.", " ", 
    RowBox[{"r", " ", "->", " ", "rmax"}]}], " ", "/.", " ", 
   RowBox[{"\[Rho]max", " ", "->", " ", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "rmax"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellChangeTimes->{{3.892976121646153*^9, 3.8929761400252028`*^9}, {
