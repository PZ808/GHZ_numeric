Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["\[Psi]", "Ret"], 
  TraditionalForm]],ExpressionUUID->"dbcbf22e-852d-48f8-80ea-cccaf6432c03"]], \
"Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.8827973113985023`*^9, 
