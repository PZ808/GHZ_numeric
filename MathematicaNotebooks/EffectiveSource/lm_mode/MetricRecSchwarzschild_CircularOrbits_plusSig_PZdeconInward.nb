Cell[TextData[{
 "For r0 = 8M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "CCK"], " ", "=", " ", 
    RowBox[{"-", "0.28099956631176215"}]}], TraditionalForm]],ExpressionUUID->
  "56e20fb5-de01-4b53-a6a9-4e12ccd5125b"],
 ".\nFor r0 = 9M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "CCK"], " ", "=", " ", 
    RowBox[{"-", "0.24390484067315518"}]}], TraditionalForm]],ExpressionUUID->
  "096969d2-0234-46b4-92e4-5d965bf5cc88"],
 ".\nFor r0 = 10M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "CCK"], " ", "=", " ", 
    RowBox[{"-", "0.21606288405249827"}]}], TraditionalForm]],ExpressionUUID->
  "9c6cc9aa-9138-474a-8140-12dbd1ea9fe0"],
 ".\nFor r0 = 12M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "CCK"], " ", "=", " ", 
    RowBox[{"-", "0.17655758923980888"}]}], TraditionalForm]],ExpressionUUID->
  "78ba63a0-7f89-4916-a98c-0e176f8a1589"],
 ".\nFor r0 = 50M:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["h", "uu", "CCK"], " ", "=", " ", 
    RowBox[{"-", "0.040419291509814985"}]}], TraditionalForm]],ExpressionUUID->
  "4919c6b7-b631-4fb7-8965-cf35f05f5761"],
 ".\nAll the above is done using a power law fitting for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", ">", 
     SubscriptBox["l", "max"]}], "=", "40"}], TraditionalForm]],
  ExpressionUUID->"96974b4b-dcdb-4b86-8676-009ebff19bab"],
