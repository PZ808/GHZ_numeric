                  RowBox[{"0", ",", "nModes"}], "}"}]}], "]"}]}], "}"}]}], 
            "}"}], ",", 
           RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fitAssocPositive", "=", 
