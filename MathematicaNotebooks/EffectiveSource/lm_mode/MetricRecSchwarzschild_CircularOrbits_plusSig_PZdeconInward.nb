Cell[TextData[{
 "Integrate (60) in reconstruction paper at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "max"]}], TraditionalForm]],ExpressionUUID->
  "b672d18a-f31b-4175-8956-32df45f45e7a"],
 ", so that only distributional pieces contribute."
}], "Text",
