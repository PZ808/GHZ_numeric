   3.893496283761685*^9},ExpressionUUID->"80b6fbb9-ebaa-42cd-9ace-\
bae43089f8d7"],

Cell[TextData[{
 "We have three different kinds of contributions:\n1) one coming from the \
stress energy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ln"], TraditionalForm]],ExpressionUUID->
  "d221f55f-65b3-4a05-90bc-10992495f1a8"],
 " (\[Delta] and \[Delta]\[CloseCurlyQuote]).\n2) One coming from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalU]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "2a10c671-569c-4951-beee-aba39742411a"],
 " (a \[Delta] and \[Delta]\[CloseCurlyQuote]). Note that the \[Delta]\
\[CloseCurlyQuote] needs to cancel with the one from the stress energy so \
that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nn"], TraditionalForm]],ExpressionUUID->
  "72a140cd-64e6-4cec-b245-69341ab20507"],
 " does not have a delta function. We do this consistency check below.\n3) \
The last one coming from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalV]x", "nm"], TraditionalForm]],ExpressionUUID->
  "f8167679-8859-4f0a-9bb7-50499ce93631"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalV]x", 
    RowBox[{"n", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "e2e1b9b3-5573-4253-8db4-e97a4fc073e5"],
 " (just a \[Delta])."
}], "Text",
 CellChangeTimes->{{3.877152676663382*^9, 3.877152719234168*^9}, {
   3.877152802644614*^9, 3.877152836297073*^9}, {3.8874453989336853`*^9, 
