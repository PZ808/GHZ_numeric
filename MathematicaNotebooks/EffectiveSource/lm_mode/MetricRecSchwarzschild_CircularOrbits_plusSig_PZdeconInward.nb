           RowBox[{"\[Eth]CK\[Rho]", "[", 
            RowBox[{"0", ",", "l"}], "]"}], "[", 
           RowBox[{"g", "[", "\[Rho]", "]"}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"\[Eth]CK\[Rho]", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "l"}], "]"}], "[", 
