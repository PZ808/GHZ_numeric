Cell["The below is working in u slicing and Kinnersley tetrad.", "Text",
 CellMargins->{{27, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.87923106022233*^9, 3.879231074095096*^9}, {
