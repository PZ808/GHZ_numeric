Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Psi]0RSmoothPiece", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]0RSmoothPiece", "[", 
      RowBox[{"lpara_", ",", "mpara_"}], "]"}], "[", "r_", "]"}], " ", ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Piecewise", "[", "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"lpara", ",", "mpara"}], "]"}], "[", "r", "]"}], "-", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
            "rmin", " ", "\[LessEqual]", " ", "r", " ", "\[LessEqual]", " ", 
             "rmax"}], ",", 
            RowBox[{
             RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
              RowBox[{"lpara", ",", "mpara"}], "]"}], "[", "r", "]"}], ",", 
            "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"r", " ", "\[NotEqual]", " ", "r0"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"lpara", ",", "mpara"}], "]"}], "[", "Left", "]"}], "-", 
          RowBox[{
           RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
            RowBox[{"lpara", ",", "mpara"}], "]"}], "[", "Left", "]"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"r", " ", "==", " ", "r0"}]}], "\[IndentingNewLine]", 
        "}"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "]"}]}],
    ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"By", " ", "construction"}], ",", " ", 
    RowBox[{"can", " ", "check", " ", "that", " ", 
     RowBox[{"Left", "/", "Right"}], " ", "values", " ", "are", " ", "the", " ",
      "same"}]}], " ", "*)"}]}]}], "Input",
