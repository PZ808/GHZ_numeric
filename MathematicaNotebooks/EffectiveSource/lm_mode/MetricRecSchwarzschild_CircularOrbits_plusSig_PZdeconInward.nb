  "],ExpressionUUID->"4454e80b-8d4a-4183-9934-3e03a1d8c912"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"(*", 
    RowBox[{"\[Thorn]C", ",", "\[Thorn]NullC", ","}], "*)"}], 
   RowBox[{
   "\[Thorn]K", ",", "\[Thorn]pK", ",", "\[Thorn]NullK", ",", 
    "\[Thorn]pNullK", ",", "\[Thorn]NullK\[Rho]", ",", "\[Thorn]pNullK\[Rho]",
     ",", "\[Eth]CK", ",", "\[Eth]pCK", ",", "\[Eth]CK\[Rho]", ",", 
    "\[Eth]pCK\[Rho]"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Thorn]C", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"I", " ", 
           RowBox[{"\[Omega]m", "[", "m", "]"}]}], 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"f", "[", "r", "]"}]}], "]"}]]}], " ", "#"}], "+", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         FractionBox[
          RowBox[{"f", "[", "r", "]"}], "2"], "]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "r"}], "]"}]}], " ", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]C", " ", "#"}]}], 
      " ", "&"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Thorn]NullC", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         FractionBox[
          RowBox[{"f", "[", "r", "]"}], "2"], "]"}], " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"#", ",", "r"}], "]"}], "/", "2"}]}], " ", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]NullC", " ", "#"}]}],
       " ", "&"}]}], ";"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Thorn]K", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{
        RowBox[{"\[Omega]m", "[", "m", "]"}], "/", 
        RowBox[{"f", "[", "r", "]"}]}], " ", "#"}], "+", " ", 
      RowBox[{"D", "[", 
       RowBox[{"#", ",", "r"}], "]"}]}], ")"}], " ", "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Thorn]pK", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{
        RowBox[{"\[Omega]m", "[", "m", "]"}], "/", "2"}], " ", "#"}], "-", 
      RowBox[{
       RowBox[{"f", "[", "r", "]"}], " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "r"}], "]"}], "/", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]pK", " ", "#"}]}], 
     ")"}], " ", "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Thorn]NullK", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"#", ",", "r"}], "]"}], " ", "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Thorn]NullK\[Rho]", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "^", "2"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{"#", ",", "\[Rho]"}], "]"}]}], " ", "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Thorn]pNullK", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"\[Omega]m", "[", "m", "]"}], " ", "#"}], " ", "-", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "r", "]"}], "/", "2"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{"#", ",", "r"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]pK", " ", "#"}]}], 
     ")"}], " ", "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Thorn]pNullK\[Rho]", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"\[Omega]m", "[", "m", "]"}], " ", "#"}], " ", "-", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], "/", "2"}], " ", 
        
        RowBox[{"\[Rho]", "^", "2"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"#", ",", "\[Rho]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "+", "q"}], ")"}], " ", "\[Epsilon]pK", " ", "#"}]}], 
      " ", "/.", " ", 
      RowBox[{"r", " ", "->", " ", 
       RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}]}]}], ")"}], " ", "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]CK", "[", 
    RowBox[{"s_", ",", "l_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["#", "r"]}], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", "-", "s"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"l", "+", "s", "+", "1"}], ")"}]}], "2"]]}], ")"}], " ", 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eth]pCK", "[", 
    RowBox[{"s_", ",", "l_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["#", "r"], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", "+", "s"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"l", "-", "s", "+", "1"}], ")"}]}], "2"]]}], ")"}], " ", 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Eth]CK\[Rho]", "[", 
     RowBox[{"s_", ",", "l_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", " ", "\[Rho]", " ", 
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "s"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"l", "+", "s", "+", "1"}], ")"}]}], "2"]]}], ")"}], " ", 
     "&"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Eth]pCK\[Rho]", "[", 
     RowBox[{"s_", ",", "l_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"#", " ", "\[Rho]", " ", 
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "s"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"l", "-", "s", "+", "1"}], ")"}]}], "2"]]}], ")"}]}], " ",
      "&"}]}], ";"}], " "}]}], "Input",
 CellChangeTimes->{{3.8792297702669897`*^9, 3.879229800041506*^9}, {
   3.879229833610071*^9, 3.879229860662632*^9}, {3.879230133304998*^9, 
   3.879230210852421*^9}, {3.87923059228802*^9, 3.879230645041387*^9}, {
   3.8792308185285892`*^9, 3.879230821570404*^9}, {3.882437519826439*^9, 
   3.882437522363608*^9}, {3.882437588103322*^9, 3.882437617363085*^9}, {
   3.8824376538452053`*^9, 3.882437755013933*^9}, {3.882441280810067*^9, 
   3.882441290251255*^9}, {3.882509173709717*^9, 3.882509181414538*^9}, {
   3.892890824287726*^9, 3.8928908663621607`*^9}, 3.892890901698419*^9, {
   3.892891019221216*^9, 3.892891057022367*^9}, {3.892969796113021*^9, 
   3.892969834637216*^9}, {3.8929800760065823`*^9, 3.8929800847577047`*^9}, 
   3.892982532933174*^9, 3.892982629000646*^9, 3.892983000957363*^9, {
   3.892983195544232*^9, 3.892983251496971*^9}, {3.8929832836005774`*^9, 
   3.892983289808569*^9}, {3.90298648529436*^9, 3.902986491915101*^9}, {
   3.90298655128759*^9, 3.902986561278129*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"b909ecb3-2de8-42e1-8179-5e63669a3546"]
