Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["c", "o"], 
  TraditionalForm]], \
"Subsection",ExpressionUUID->"add3ad4a-09ec-46c4-935a-b195a719ae76"]], \
"Subsection",
 CellChangeTimes->{{3.8935817162668257`*^9, 
  3.893581717860224*^9}},ExpressionUUID->"92471c45-6831-47f0-b87c-\
e961e8649c2c"],

Cell[TextData[{
 "Outward integration: Similarly to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "0"], TraditionalForm]],ExpressionUUID->
  "9b9788ed-4bf2-4bd2-8701-b77a5485a240"],
 ", we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"+", 
       FractionBox[
        SubsuperscriptBox["\[Rho]", "max", "2"], "3"]}], 
      OverscriptBox["\[Eth]", "~"], 
      SuperscriptBox["b", "o"]}], " ", "+", 
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", 
         SuperscriptBox["\[Rho]", "4"], 
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Rho]"], 
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["x", "nm"], 
            SuperscriptBox["\[Rho]", "2"]], ")"}]}]}], 
        SubscriptBox["|", 
         RowBox[{"r", "=", 
          SubscriptBox["r", "max"]}]], " ", 
        RowBox[{"+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "max"], " ", "of", " ", 
           SubscriptBox["T", "lm"], " ", "and", " ", 
           SubscriptBox["\[ScriptCapitalN]x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]]}], ")"}]}]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"94d0e6da-44c3-474e-aa69-f27a0107597b"],
 ".\n\n\nOutward integration:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "o"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"+", 
       FractionBox[
        SubsuperscriptBox["\[Rho]", "min", "2"], "3"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         OverscriptBox["\[Eth]", "~"], 
         SuperscriptBox["b", "o"]}], ")"}], "-"]}], " ", "+", 
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", 
         SuperscriptBox["\[Rho]", "4"], 
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Rho]"], 
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["x", "nm"], 
            SuperscriptBox["\[Rho]", "2"]], ")"}]}]}], 
        SubscriptBox["|", 
         RowBox[{"r", "=", 
          SubscriptBox["r", "min"]}]], " ", 
        RowBox[{"+", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", " ", "and", " ", 
           RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
           SubscriptBox["r", "min"], " ", "of", " ", 
           SubscriptBox["T", "lm"], " ", "and", " ", 
           SubscriptBox["\[ScriptCapitalN]x", 
            RowBox[{"m", 
             OverscriptBox["m", "_"]}]]}], ")"}]}]}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"1c704713-ddee-49b1-9b8d-0d37ba87d350"],
 ".\n",
 StyleBox["Note:",
  FontColor->RGBColor[0, 0, 1]],
 " Concerning the distributional contributions, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalN]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "0b527b9d-8547-434d-b493-872a74311e06"],
 " will actually not contribute, because its coefficient linearly depends on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "24135d4d-8d40-4f72-9b77-753c38281636"],
 ", which vanishes for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "1"}], ",", " ", 
    RowBox[{"m", "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "8a1e8279-7a8e-4f4d-8389-a3fb61c3468c"],
 "."
}], "Text",
 CellChangeTimes->{{3.893581737435095*^9, 3.8935818757714987`*^9}, {
  3.8935819087094297`*^9, 3.89358195694801*^9}, {3.893581989797371*^9, 
  3.893582036380327*^9}, {3.898841344861999*^9, 3.898841350516369*^9}, {
  3.8988417177059183`*^9, 3.898841717732831*^9}, {3.898841889771203*^9, 
  3.898841889771429*^9}, {3.8988419915095873`*^9, 3.898842002894566*^9}, {
  3.898842039662304*^9, 3.898842039662476*^9}, {3.898842082553738*^9, 
  3.8988420898841352`*^9}, {3.899268060908763*^9, 3.89926807933263*^9}, {
  3.992505691692211*^9, 3.992505697054041*^9}, {3.99250580420378*^9, 
  3.992505824054178*^9}, {3.992575822726383*^9, 
  3.9925758602232924`*^9}},ExpressionUUID->"1e254fb7-ed9b-47ea-a0c2-\
e2aecc4c85a7"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"\[Delta]", " ", "and", " ", 
    RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "in", " ", 
    SuperscriptBox["c", "o"]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Epsilon]", ">", "0"}], ",", 
      RowBox[{"rmin", ">", "0"}], ",", 
      RowBox[{"r1", ">", "0"}], ",", 
      RowBox[{"rmax", ">", "rmin"}]}], "}"}], ",", "  ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"TlmAnd\[ScriptCapitalN]xmmb\[Delta]Coeff", "[", 
           RowBox[{"l", ",", "m"}], "]"}], " ", 
          RowBox[{"DiracDelta", "[", 
           RowBox[{"r2", "-", "rmax"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"TlmAnd\[ScriptCapitalN]xmmb\[Delta]pCoeff", "[", 
           RowBox[{"l", ",", "m"}], "]"}], " ", 
          RowBox[{
           RowBox[{"DiracDelta", "'"}], "[", 
           RowBox[{"r2", "-", "rmax"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"r2", ",", 
          RowBox[{"rmin", "-", "\[Epsilon]"}], ",", 
          RowBox[{"rmax", "+", "\[Epsilon]"}]}], "}"}]}], "]"}]}], " ", "//", 
     " ", "Simplify"}]}], "]"}], "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.893582240902938*^9, 3.8935822621720333`*^9}, {
   3.893582582831828*^9, 3.89358259666936*^9}, 3.898841359242487*^9, {
