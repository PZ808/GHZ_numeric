c8b235987c3b"],

Cell[TextData[{
 "Note that for differentiation, in the integration method, we differentiate \
with respect to \[Rho], while in the ODE method it is with respect to r, so \
need to adjust to this using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"=", " ", 
     RowBox[{
      SuperscriptBox["\[Rho]", "2"], 
      SubscriptBox["\[PartialD]", "r"]}]}]}], TraditionalForm]],
  ExpressionUUID->"30953c7a-85a8-455c-a5c4-e498ccb9e25b"],
 ".\n",
 StyleBox["Also,",
  FontColor->RGBColor[0, 0, 1]],
 " the below assumes that the \[Delta]\[CloseCurlyQuote] piece vanishes at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "af926199-3718-4469-a9e7-94b17fbf4e27"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.892971206838442*^9, 3.8929713039202633`*^9}, {
  3.892999094599958*^9, 
  3.892999115689904*^9}},ExpressionUUID->"b30a6d16-8b12-4256-9209-\
a61e635fa391"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"xnnAt\[Rho]maxViaIntegration", "[", 
      RowBox[{"l", ",", "m"}], "]"}], " ", "==", " ", 
     RowBox[{"xnnAt\[Rho]maxViaODE", "[", 
      RowBox[{"l", ",", "m"}], "]"}]}], " ", "/.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"xnnIntegrand\[Delta]Coeff", "[", 
         RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"Tln\[Delta]Coeff", "[", 
         RowBox[{"l", ",", "m"}], "]"}], "+", 
        RowBox[{"\[Delta]Uxmmb", "[", 
         RowBox[{"l", ",", "m"}], "]"}], "+", 
        RowBox[{"\[Delta]Vbxnmb", "[", 
         RowBox[{"l", ",", "m"}], "]"}], "+", 
        RowBox[{"\[Delta]Vxnm", "[", 
         RowBox[{"l", ",", "m"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"xnnIntegrand\[Delta]pCoeff", "[", 
         RowBox[{"l_", ",", "m_"}], "]"}], "[", "rmax", "]"}], " ", "->", 
       "0"}]}], "}"}]}], " ", "/.", " ", 
   RowBox[{"\[Rho]max", " ", "->", " ", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "rmax"}]}]}], " ", "//", " ", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.8929905089086647`*^9, 3.8929905159142313`*^9}, {
  3.8929908059536743`*^9, 3.8929908063012657`*^9}, {3.892990851260558*^9, 
