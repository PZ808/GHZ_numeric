Cell[BoxData[{
 RowBox[{"Clear", "[", "\[ScriptCapitalU]OfFH", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalU]OfFH", "[", "r_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"\[ScriptCapitalU]NullK", "[", 
    RowBox[{
     RowBox[{"F", "[", "r", "]"}], " ", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}], ",", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], "]"}],
     " ", "&"}]}]}]}], "Input",
 Evaluatable->False,
