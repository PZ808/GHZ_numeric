                 RowBox[{"\[Rho]", "^", "4"}], " ", 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"myxnn", "[", 
                    RowBox[{"l", ",", "m"}], "]"}], "[", "\[Rho]", "]"}], "/",
                     "\[Rho]"}], ",", "\[Rho]"}], "]"}]}]}], "==", 
               RowBox[{
                RowBox[{
                 RowBox[{"TlnRightInterpol", "[", 
                  RowBox[{"l", ",", "m"}], "]"}], "[", 
                 RowBox[{"rOf\[Rho]K", "[", "\[Rho]", "]"}], "]"}], "+", 
                RowBox[{"\[ScriptCapitalU]NullK\[Rho]", "[", 
                 RowBox[{
                  RowBox[{"myxmmb", "[", 
