Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hPLorenz", "[", "1", "]"}], "[", 
    RowBox[{"l_", ",", "m_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"(", 
      RowBox[{"r0", "+", "\[CapitalDelta]r"}], ")"}], 
     RowBox[{"WignerD", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", "m", ",", "0"}], "}"}], ",", "\[Pi]", ",", 
       RowBox[{"\[Pi]", "/", "2"}], ",", 
       RowBox[{"\[Pi]", "/", "2"}]}], "]"}], 
     FractionBox[
      SqrtBox[
       RowBox[{"2", "\[Pi]"}]], 
      SqrtBox[
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}]]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "l"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "M"}], "+", "r0"}], ")"}], "  ", "pm", 
          SqrtBox[
           SuperscriptBox["\[CapitalDelta]r", "2"]]}], 
         RowBox[{
          SuperscriptBox["r0", 
           RowBox[{"5", "/", "2"}]], " ", 
          SqrtBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}]]}]]}], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "l"}]}], ")"}], "2"], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "M"}], "+", "r0"}]], " ", 
         SuperscriptBox["\[CapitalDelta]r", "2"], " ", 
         RowBox[{"EllipticE", "[", 
          FractionBox["M", 
           RowBox[{"r0", "-", 
            RowBox[{"2", "M"}]}]], "]"}]}], 
