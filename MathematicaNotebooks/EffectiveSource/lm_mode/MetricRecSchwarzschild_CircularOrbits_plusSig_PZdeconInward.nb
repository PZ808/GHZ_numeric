                  FontColor->GrayLevel[0]]}]}], "]"}], "]"}], "]"}], "]"}], "/",
            "\[IndentingNewLine]", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             RowBox[{"Aplus", "[", 
              RowBox[{"l", ",", "m"}], "]"}], " ", 
             RowBox[{"Cplus", "[", 
              RowBox[{"2", ",", "l", ",", "m"}], "]"}], " ", 
             RowBox[{
