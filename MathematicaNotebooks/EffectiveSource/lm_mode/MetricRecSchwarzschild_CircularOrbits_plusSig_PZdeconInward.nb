Cell[BoxData[{
 RowBox[{"Clear", "[", "\[ScriptCapitalV]OfFH", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalV]OfFH", "[", "r_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"\[ScriptCapitalV]NullK", "[", 
    RowBox[{
     RowBox[{"F", "[", "r", "]"}], " ", 
     RowBox[{"HeavisideTheta", "[", 
      RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}], ",", 
        RowBox[{"DiracDelta", "[", 
         RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], "]"}],
     " ", "&"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"\[ScriptCapitalV]OfFH", "[", "r", "]"}], ",", 
    RowBox[{"DiracDelta", "[", 
     RowBox[{"r", "-", "rmin"}], "]"}]}], "]"}], " ", "/.", " ", 
  RowBox[{"r", " ", "->", " ", "rmin"}]}]}], "Input",
