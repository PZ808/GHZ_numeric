           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRuleForPuncture", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Abs", "@", 
