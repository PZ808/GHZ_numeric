Cell["\<\
Notes: \t1) checked, at least up to l=40, numerical floor kicks on when only \
accounting for less than 8 digits on the three fields
\t\t(so we are using enough precision).
\t\t2) tries computing puncture with mpmax=20 (2x more than usual). There is \
more of a slope in then range 30<l<40 for the residual field,
\t\tbut the residual fields is also bigger (as the puncture is different). \
Furthermore, keeping mpmax=10, but reducing mpmax when
\t\tdoing the summation gives visually the same plot. This all suggest that \
the loss of regularity due to the regularization factor is not causing
\t\tthe behaviour at 30<l<40.
\t\t3) looking at individual m-mode contributions, it looks like the residual \
fields has zero crossings at different l\[CloseCurlyQuote]s. This might in \
part explain why it looks so flat in the range 30<l<40.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.910158609378257*^9, 3.910158709171072*^9}, {
  3.910158761216659*^9, 3.910159130984613*^9}, {3.918726459501954*^9, 
  3.918726460827186*^9}},ExpressionUUID->"edce2f67-2639-43dd-b89b-\
0c62987febdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"r0", "=", 
    RowBox[{
     RowBox[{"10", "M", " ", "at", " ", "r"}], "=", 
     RowBox[{"8", "M"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]0RetData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]Ret", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]0PData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]0RData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]Ret", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], "-", 
              RowBox[{
               RowBox[{"\[Psi]0PExactWorldtubePiece", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}]}], ")"}], " ", 
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}],
             " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{"Abs", "@", "\[Psi]0PData"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Abs", "@", "\[Psi]0RetData"}], ",", 
       RowBox[{"PlotStyle", "->", "Green"}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "Large"}], "}"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Abs", "@", "\[Psi]0RData"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "\[IndentingNewLine]", 
    "]"}], " "}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.909465884564076*^9, 3.9094658854274054`*^9}, {
