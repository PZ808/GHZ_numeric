Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["b", "o"], 
  TraditionalForm]],ExpressionUUID->"1b3b8270-0711-41d9-a1d6-df3f8947bbec"]], \
"Subsection",
 CellChangeTimes->{{3.893580888154965*^9, 3.893580889881576*^9}, {
  3.8935814191287107`*^9, 
  3.89358141919188*^9}},ExpressionUUID->"6e7e5477-32f0-4b6f-81bb-\
1c9a30953aef"],

Cell[TextData[{
 "\nWe simply have that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "0"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["r", "min", "2"], 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"m", 
           OverscriptBox["m", "_"]}]], "'"}], 
        RowBox[{"(", 
         SubscriptBox["r", "min"], ")"}]}], " ", "+", " ", 
       RowBox[{"(", 
        RowBox[{"\[Delta]", " ", "and", " ", 
         RowBox[{"\[Delta]", "'"}], " ", "contributions", " ", "at", " ", 
         SubscriptBox["r", "min"]}], ")"}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"7b908af5-2c98-4f91-a3b4-8cf4aa6e2ab2"],
 ". This is proportional to the second term in expression for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "o"], TraditionalForm]],ExpressionUUID->
  "a09f7c58-7b85-40fe-a9d7-4d9a1f714825"],
 ".\nWe find that this contribution identically vanishes, because the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"l", "=", "1"}], ",", 
    RowBox[{"m", "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "86dfe550-8e3a-4453-8820-aba2bea40dee"],
 " component of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "ll"], TraditionalForm]],ExpressionUUID->
  "a68a847f-1ca9-4f3c-b56b-ce654fb2a73e"],
 " is zero.\t"
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 CellChangeTimes->{{3.8935809208418493`*^9, 3.893581133472534*^9}, {
  3.89358142852661*^9, 3.893581443010607*^9}, {3.893581476152308*^9, 
