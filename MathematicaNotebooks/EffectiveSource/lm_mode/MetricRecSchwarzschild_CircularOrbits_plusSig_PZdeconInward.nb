 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["r", "min", "2"], 
       RowBox[{"f", "(", 
        SubscriptBox["r", "min"], ")"}], 
       FractionBox[
        RowBox[{
         SubscriptBox["r", "max"], "-", 
         SubscriptBox["r", "min"]}], 
        RowBox[{
         SubscriptBox["r", "max"], 
