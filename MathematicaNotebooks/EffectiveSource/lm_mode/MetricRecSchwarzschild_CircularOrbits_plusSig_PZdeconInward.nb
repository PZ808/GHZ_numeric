  "Out[810]=",ExpressionUUID->"6353e9bd-3a9a-409a-babd-8780df822f11"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The modes", "Subsubsection",
 CellChangeTimes->{{3.907047653117293*^9, 3.907047654737205*^9}, {
  3.907048060486281*^9, 
  3.9070480612836018`*^9}},ExpressionUUID->"ca5ce339-b282-4b3a-bdf3-\
4df524321ccf"],

Cell[TextData[{
 "The Hertz potential equation (radial inversion formula) is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "0"], " ", "=", " ", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox["\[Thorn]", "4"], 
     OverscriptBox["\[CapitalPhi]", "_"]}]}], TraditionalForm]],
  ExpressionUUID->"a1735815-25cf-4c0f-97dd-7885726d5b00"],
 ".\nIn vacuum, can use the Teukolsky-Starobinsky relations can be used on \
the radial inversion formula (decoupled into modes) to give\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["64", 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], 
       SuperscriptBox["\[Thorn]", "4"], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", 
         RowBox[{"-", "2"}]], 
        SubscriptBox["\[Psi]", "lm"]}]}]}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["64", 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], 
       SuperscriptBox["r", "4"], 
       SuperscriptBox[
        RowBox[{"\[Thorn]", "'"}], "4"], 
       SuperscriptBox["r", "4"], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
        SubscriptBox["\[Psi]", "lm"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"b57169d6-10f6-41af-8fb9-dc9a08a97c60"],
 "\nIn the above, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[CapitalPhi]", "_"], "lm"], TraditionalForm]],
  ExpressionUUID->"8a98f373-4023-4a69-8381-d8b69ec4c586"],
 " means the modes of a complex conjugated quantity. In particular,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "s"}]], 
     SubscriptBox[
      OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], " ", ":=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"m", "+", "s"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
        SubscriptBox[
         OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], ")"}], "*"]}]}], 
   TraditionalForm]],ExpressionUUID->"c2788de8-bba5-46b2-83b0-df952ef0876c"],
 ".\nSo, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"9ff0918d-2bd9-4251-9a13-4715ec9153aa"],
 " can be expanded into basis functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["", 
     RowBox[{"-", "s"}]], 
    SubscriptBox["\[Psi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "ae09de6e-0df5-497a-bbb1-5d1fedd9a319"],
 ", and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["\[CapitalPhi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "868a9c5c-d9c8-4d8b-8f08-2ea6e0415467"],
 " into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", "s"], 
    SubscriptBox["\[Psi]", "lm"]}], TraditionalForm]],ExpressionUUID->
  "f019c172-3035-44a0-887b-9f27bbe3b9db"],
 ", say the \[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] basis functions \
for concreteness. In particular, the right-hand side of the above equations \
must satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubscriptBox["\[Psi]", "lm"]}]}], " ", "\[Proportional]", " ", 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
     SubscriptBox["\[Psi]", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "ed6a20ec-ab95-4cfc-ac04-916ac60b9ab7"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["\[Psi]", "lm"]}]}], " ", "\[Proportional]", "  ", 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", 
      RowBox[{"-", "2"}]], 
     SubscriptBox["\[Psi]", "lm"]}]}], TraditionalForm]],ExpressionUUID->
  "c08a6874-8b2f-46da-89b7-c36e422c1300"],
 ".\nThe proper way to find the exact coefficient is to evaluate these \
homogeneous functions at the horizon (or infinity depending on the basis \
function) and simply comparing them. Alternatively, can just guess and then \
check numerically \[OpenCurlyDoubleQuote]until it works\
\[CloseCurlyDoubleQuote]. See below.\n\nThe exact formula that you will \
depend 1) on the normalisation of the homogenenous solutions, 2) if m=0 or \
not.\nFor example, for non-static modes, using the \
\[OpenCurlyDoubleQuote]usual\[CloseCurlyDoubleQuote] normalisation from the \
toolkit, one can check that \n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["64", 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], 
     SuperscriptBox["\[Thorn]", "4"], "  ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox["4", 
      SuperscriptBox["\[Omega]", "4"]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["64", 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], 
     SuperscriptBox["r", "4"], 
     SuperscriptBox[
      RowBox[{"\[Thorn]", "'"}], "4"], 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"64", 
       SuperscriptBox["\[Omega]", "4"]}], 
      RowBox[{"|", 
       SubscriptBox["C", "lm"], 
       SuperscriptBox["|", "2"]}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], TraditionalForm]}],
  ExpressionUUID->"82d3d9b6-d146-42db-b519-9022e76625e6"],
 "\nfrom which the modes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", 
     RowBox[{"\[PlusMinus]", "2"}]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"84527aef-26a1-4c56-a735-0c70ed5437f9"],
 " are then given analytically,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "_"], "lm", "up"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["4", 
        SuperscriptBox["\[Omega]", "4"]], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
        SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", 
        RowBox[{"-", "2"}]], 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalPhi]", "_"], "lm", "up"]}], " ", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"64", 
         SuperscriptBox["\[Omega]", "4"]}], 
        RowBox[{"|", 
         SubscriptBox["C", "lm"], 
         SuperscriptBox["|", "2"]}]], " ", 
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", 
         RowBox[{"-", "2"}]], 
        SubsuperscriptBox["\[Psi]", "lm", "up"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e6794d3d-8760-45b5-8718-9fd66dbdce12"],
 "\nNote that for static modes, this breaks down.\n\nFor the static modes, \
the homogeneous solution are actually known analytically (again, up to \
normalisation). In the toolkit, they are given by,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "in"], " ", "=", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"l", "+", "s", "+", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "s"}]], " ", 
     FractionBox[
      RowBox[{"\[CapitalGamma]", "(", 
       RowBox[{"1", "+", "s"}], ")"}], 
      RowBox[{"\[CapitalGamma]", "(", 
       RowBox[{"1", "-", "s"}], ")"}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "l"}], ",", 
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"1", "-", "s"}], ",", 
       RowBox[{"1", "-", 
        FractionBox["r", 
         RowBox[{"2", "M"}]]}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "1fe5d261-1173-41aa-bf45-af12ef8cef0d"],
 ", s> 0 (note that \[CapitalGamma](1-s) should be absorbed into F21 to \
regularize it into F21Regularised)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "in"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "2"}], "s"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["r", 
         RowBox[{"2", "M"}]], "-", "1"}], ")"}], 
      RowBox[{"-", "s"}]], " ", 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "l"}], ",", 
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"1", "-", "s"}], ",", 
       RowBox[{"1", "-", 
        FractionBox["r", 
         RowBox[{"2", "M"}]]}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "dd2281ad-edfc-4f5e-b8e9-0078fde3e721"],
 ", s\[LessEqual] 0,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "l0", "up"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "s"}], "-", "l", "-", "1"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["r", 
         RowBox[{"2", "M"}]], "-", "1"}], ")"}], 
      RowBox[{"-", "s"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["r", 
        RowBox[{"2", "M"}]], ")"}], 
      RowBox[{
       RowBox[{"-", "l"}], "-", "1"}]], 
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubscriptBox["F", "1"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"l", "+", "1"}], ",", 
       RowBox[{"l", "+", "1", "-", "s"}], ",", 
       RowBox[{
        RowBox[{"2", "l"}], "+", "2"}], ",", 
       FractionBox["r", 
        RowBox[{"2", "M"}]]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "76f929c1-022a-4171-8488-debe7d38613d"],
 "\nThis changes the formulae for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[InvisiblePrefixScriptBase]", 
     RowBox[{"\[PlusMinus]", "2"}]], 
    SubscriptBox[
     OverscriptBox["\[CapitalPhi]", "_"], "lm"]}], TraditionalForm]],
  ExpressionUUID->"6c0658f5-6496-45e6-91a8-9ce8ef46d620"],
 " a bit. The end-result is,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
      SubsuperscriptBox[
       OverscriptBox["\[CapitalPhi]", "_"], "lm", 
       RowBox[{"in", "/", "up"}]]}], " ", "=", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["M", "4"]}], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"l", "-", "1"}], ")"}], "4"]], " ", 
      RowBox[{
       SubscriptBox["\[InvisiblePrefixScriptBase]", "2"], 
       SubsuperscriptBox["\[Psi]", "lm", 
        RowBox[{"in", "/", "up"}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "c68f7066-4a99-4858-beec-b4b41d1821f2"],
 ".\nFor the retarded solution, one then simply multiples it with the \
appropriate weighting coefficient. "
}], "Text",
 CellChangeTimes->{{3.907046633070578*^9, 3.9070466690971107`*^9}, {
  3.907046753715465*^9, 3.907046846293333*^9}, {3.907046902308004*^9, 
  3.907046903611537*^9}, {3.907047659981381*^9, 3.9070477829127293`*^9}, {
  3.907047842952845*^9, 3.907048144832046*^9}, {3.907048189903224*^9, 
  3.9070483070354033`*^9}, {3.907048382091339*^9, 3.907048765346795*^9}, {
  3.907048812608927*^9, 3.907048961199314*^9}, {3.907048995318959*^9, 
  3.907049136000572*^9}, {3.919572326051179*^9, 3.9195723290376263`*^9}, {
  3.919572391062608*^9, 
  3.9195724231333113`*^9}},ExpressionUUID->"513c18a6-019a-4f37-a26f-\
58588359b361"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"myl", "=", "5"}], ";", 
  RowBox[{"mym", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Weyl$spin$p", "=", "4"}], ";", " ", 
  RowBox[{"Weyl$spin$q", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myC", " ", "=", " ", 
   RowBox[{
    RowBox[{"Pochhammer", "[", 
     RowBox[{
      RowBox[{"myl", "-", "1"}], ",", "4"}], "]"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"mym", "+", "myl"}], ")"}]}], " ", "12", " ", "I", " ", "M", " ", 
     RowBox[{"\[Omega]m", "[", "mym", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C2", " ", "=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", "myC", "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Weyl$spin$p", "=", "4"}], ";", " ", 
  RowBox[{"Weyl$spin$q", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Psi$sm2", "=", 
   RowBox[{"TeukolskyRadial", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "myl", ",", "mym", ",", "aKerr", ",", 
     RowBox[{"\[Omega]m", "[", "mym", "]"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<NumericalIntegration\>\"", ",", 
        RowBox[{"\"\<Domain\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<In\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}], ",", 
           RowBox[{"\"\<Up\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}]}], "}"}]}]}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Psi$s2", " ", "=", " ", 
    RowBox[{"TeukolskyRadial", "[", 
     RowBox[{"2", ",", "myl", ",", "mym", ",", "aKerr", ",", 
      RowBox[{"\[Omega]m", "[", "mym", "]"}], ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<NumericalIntegration\>\"", ",", 
         RowBox[{"\"\<Domain\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<In\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}], ",", 
            RowBox[{"\"\<Up\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"rNumInbd", ",", "rNumOutbd"}], "}"}]}]}], "}"}]}]}], 
        "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"64", "/", "C2"}], " ", 
    RowBox[{"r", "^", "4"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Thorn]pNullK", "[", 
       RowBox[{
        RowBox[{"Weyl$spin$p", "-", "3"}], ",", 
        RowBox[{"Weyl$spin$q", "-", "3"}]}], "]"}], "[", 
      RowBox[{
       RowBox[{"\[Thorn]pNullK", "[", 
        RowBox[{
         RowBox[{"Weyl$spin$p", "-", "2"}], ",", 
         RowBox[{"Weyl$spin$q", "-", "2"}]}], "]"}], "[", 
       RowBox[{
        RowBox[{"\[Thorn]pNullK", "[", 
         RowBox[{
          RowBox[{"Weyl$spin$p", "-", "1"}], ",", 
          RowBox[{"Weyl$spin$q", "-", "1"}]}], "]"}], "[", 
        RowBox[{
         RowBox[{"\[Thorn]pNullK", "[", 
          RowBox[{
           RowBox[{"Weyl$spin$p", "+", "0"}], ",", 
           RowBox[{"Weyl$spin$q", "+", "0"}]}], "]"}], "[", 
         RowBox[{
          RowBox[{"r", "^", "4"}], " ", 
          RowBox[{"Cplus", "[", 
           RowBox[{"2", ",", "myl", ",", "mym"}], "]"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Psi$s2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
           StyleBox["/",
            FontColor->GrayLevel[0]], 
           StyleBox[
            RowBox[{
             RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
            FontColor->GrayLevel[0]]}]}], "]"}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"Aplus", "[", 
        RowBox[{"myl", ",", "mym"}], "]"}], " ", 
       RowBox[{"Cplus", "[", 
        RowBox[{"2", ",", "myl", ",", "mym"}], "]"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Psi$sm2", "[", "\"\<Up\>\"", "]"}], "[", "r", "]"}], 
        StyleBox["/",
         FontColor->GrayLevel[0]], 
        StyleBox[
         RowBox[{
          RowBox[{"ExpI\[Omega]rstar", "[", "mym", "]"}], "[", "r", "]"}],
         FontColor->GrayLevel[0]]}]}], ")"}]}]}], " ", "/.", " ", 
   RowBox[{"r", " ", "->", " ", "rmax"}]}], " ", "/.", " ", 
  RowBox[{"m", " ", "->", " ", "mym"}]}]}], "Input",
 CellChangeTimes->{{3.904202290000345*^9, 3.904202365486228*^9}, {
   3.904202566941186*^9, 3.904202566961025*^9}, {3.904202601021315*^9, 
   3.904202696665717*^9}, {3.904202727687894*^9, 3.9042027295319366`*^9}, {
   3.904203332383563*^9, 3.904203437773457*^9}, {3.9042034840046864`*^9, 
   3.9042034868592253`*^9}, {3.904203528410124*^9, 3.904203535247528*^9}, {
   3.9042036392840443`*^9, 3.904203644846019*^9}, 3.904203795396851*^9, {
   3.904203843899352*^9, 3.90420384480226*^9}, {3.9042039814764853`*^9, 
   3.9042039918911963`*^9}, {3.904204083732848*^9, 3.904204086913172*^9}, {
   3.90420450062535*^9, 3.9042045137166243`*^9}, 3.904206219918457*^9, {
   3.904206665873088*^9, 3.904206776845818*^9}, {3.9042068278577967`*^9, 
   3.904206846066904*^9}, {3.904206928078518*^9, 3.9042069517558403`*^9}, {
   3.9042071831108513`*^9, 3.904207220263618*^9}, 3.904207320551738*^9, {
   3.9042073715555267`*^9, 3.90420738045809*^9}, {3.9042074178886766`*^9, 
   3.904207428352982*^9}, {3.904207547508654*^9, 3.9042075790750237`*^9}, {
   3.9042078192459507`*^9, 3.904207824145958*^9}, {3.904208047407516*^9, 
   3.904208060705916*^9}, 3.904208100254704*^9, 3.904208277826222*^9, {
   3.904208339295624*^9, 3.9042083395048437`*^9}, {3.904208409829114*^9, 
   3.904208416004779*^9}, {3.9042093612710543`*^9, 3.904209384258115*^9}, {
   3.9042858471446753`*^9, 3.9042858472220917`*^9}, {3.904287573176694*^9, 
   3.904287573254738*^9}, {3.918726783158929*^9, 3.918726783642068*^9}, {
