     RowBox[{"{", 
      RowBox[{"\"\<r\>\"", ",", "\"\<normalized Teukolsky residual\>\""}], 
      "}"}]}], ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{"residualCheckIn", ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", "\"\<normalized Teukolsky residual\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
