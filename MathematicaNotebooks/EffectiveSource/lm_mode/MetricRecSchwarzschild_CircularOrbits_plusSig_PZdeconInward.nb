Cell[CellGroupData[{

Cell["Theory", "Subsection",
 Evaluatable->False,
 CellChangeTimes->{{3.873096850062484*^9, 3.87309685164462*^9}, {
  3.873097004113317*^9, 
  3.873097010558796*^9}},ExpressionUUID->"2121f316-f94d-48e2-b7b7-\
8c3ee87a93d8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", "ab", "\[Dagger]"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["l", "a"]}], 
      SubscriptBox["l", "b"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Eth]", "-", "\[Tau]"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Eth]", "+", 
        RowBox[{"3", "\[Tau]"}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
      SubscriptBox["m", "a"], 
      SubscriptBox["m", "b"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Thorn]", "-", "\[Rho]"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Thorn]", "+", 
        RowBox[{"3", "\[Rho]"}]}], ")"}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["l", 
       RowBox[{"(", "a"}]], 
      RowBox[{
       SubscriptBox["m", 
        RowBox[{"b", ")"}]], " ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "-", "\[Rho]", "+", 
           OverscriptBox["\[Rho]", "_"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"\[Eth]", "+", 
           RowBox[{"3", "\[Tau]"}]}], ")"}]}], "  ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Eth]", "-", "\[Tau]", "+", 
           OverscriptBox["\[Tau]", "_"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"\[Thorn]", "+", 
           RowBox[{"3", "\[Rho]"}]}], ")"}]}]}], "]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"f3bdd3f5-0919-46f5-8939-2225966d73a9"],
 ".\nIn Schwarzschild, spheroidal and spherical harmonics are the same thing, \
and since the Hertz potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", ":", 
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "0"}], "}"}], "GHP"]}], TraditionalForm]],
  ExpressionUUID->"aea9096d-f7c6-4df8-88b1-5ad3b98482ff"],
 ",\nwe have the expansion (for circular orbits, \[Omega]=m\[CapitalOmega]): \
\[CapitalPhi] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "lm"], " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "lm"], "(", "r", ")"}], " "}], 
      RowBox[{"-", "2"}]], 
     RowBox[{
      SubscriptBox["Y", "lm"], "(", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", 
     SuperscriptBox["e", 
      RowBox[{"-", "im\[CapitalOmega]t"}]]}]}], TraditionalForm]],
  ExpressionUUID->"85739593-978b-4c1d-9a6a-795661bb8056"],
 ".\nThe operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eth]", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "r"]}], 
     OverscriptBox["\[Eth]", "~"]}]}], TraditionalForm]],ExpressionUUID->
  "f7f60bee-cb71-4c4c-a360-59ed4eff0011"],
 ", where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Eth]", "~"], TraditionalForm]],ExpressionUUID->
  "195a0cc0-e1d1-41af-a462-170b92934045"],
 " is a spin raising operator: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{
       OverscriptBox["\[Eth]", "~"], " "}], "s"], 
     RowBox[{
      SubscriptBox["Y", "lm"], "(", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       SqrtBox[
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", "-", "s"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"l", "+", "s", "+", "1"}], ")"}]}], "2"]], 
       RowBox[{"s", "+", "1"}]]}], 
     RowBox[{
      SubscriptBox["Y", "lm"], "(", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"439c1197-39df-409a-8239-c58fec669e5e"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8730945740626373`*^9, 3.873094685361042*^9}, {
  3.873094793035421*^9, 3.8730948519247427`*^9}, {3.873094982280911*^9, 
  3.873095155929843*^9}, {3.873095228944762*^9, 
  3.8730952984195633`*^9}},ExpressionUUID->"7287cecf-f7c1-46c9-b83f-\
14cca49e03dd"],

Cell[TextData[{
 "Note that only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     RowBox[{
      OverscriptBox["m", "_"], 
      OverscriptBox["m", "_"]}]], ",", 
    SubscriptBox["h", "nn"], ",", " ", 
    RowBox[{"and", " ", 
     SubscriptBox["h", 
      RowBox[{"n", 
       OverscriptBox["m", "_"], " "}]]}]}], TraditionalForm]],ExpressionUUID->
  "6537fc0f-4fbe-4e46-adbe-17f379a3b956"],
 " are non-trivial."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.873096845906562*^9, 
  3.873096927592853*^9}},ExpressionUUID->"0163b11c-c395-483d-9db7-\
17639af5cc8e"]
}, Closed]],

