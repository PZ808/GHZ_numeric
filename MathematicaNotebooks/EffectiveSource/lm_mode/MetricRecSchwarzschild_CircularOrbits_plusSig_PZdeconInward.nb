 CellChangeTimes->{{3.877440456141926*^9, 3.8774404585222063`*^9}, {
  3.8774429705352907`*^9, 3.877442970645619*^9}, {3.877445314811635*^9, 
  3.877445314886448*^9}, {3.877445553072035*^9, 3.877445555791531*^9}, {
  3.882252671207776*^9, 
  3.882252671874704*^9}},ExpressionUUID->"c49aadc7-8544-4bc3-9ecf-\
2abccc673582"],

Cell[TextData[{
 "The metric can be written in the form (paper review): h =  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"n", "\[GreaterEqual]", "0"}]], " ", 
      RowBox[{
       SubscriptBox["c", "n"], " ", 
       SuperscriptBox["\[CapitalDelta]r", "n"]}]}], " ", "+"}], " ", "|", 
    "\[CapitalDelta]r", "|", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{"n", "\[GreaterEqual]", "0"}]], 
     RowBox[{
      SubscriptBox["d", "n"], "  ", 
      SuperscriptBox["\[CapitalDelta]r", 
       RowBox[{"n", "-", "1"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "72ceac59-0c2b-44d6-97f7-28ce5ab6affb"],
 ". (log term not here for circular orbits).\nNote that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "0"], TraditionalForm]],ExpressionUUID->
  "b71642ee-e6f7-430f-80c1-d6190f7900f1"],
 " will be wlog set to 0 as it can be re-absorbed into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "0"], TraditionalForm]],ExpressionUUID->
  "21bfbe59-8cb8-4639-901c-33fc4715f32b"],
 " (basically, the second sum can be re-interpreted as  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["d", "0"], " ", "+"}], " ", "|", "\[CapitalDelta]r", "|", 
    " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["d", "1"], " ", "+", " ", 
       RowBox[{
        SubscriptBox["d", "2"], " ", "\[CapitalDelta]r"}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["d", "3"], 
        SuperscriptBox["\[CapitalDelta]r", "2"]}], "+"}], "..."}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"00f473af-56c8-41db-bdfc-c47785d26ac0"],
 ").\nWe can find the coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "n"], TraditionalForm]],ExpressionUUID->
  "5d4283b3-4974-4ab8-bd3a-774ae8782115"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "n"], TraditionalForm]],ExpressionUUID->
  "40d48037-a1c9-40aa-b2cf-418f16768144"],
 " via: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["h", 
      RowBox[{"(", "n", ")"}]], "(", 
     SuperscriptBox["0", "\[PlusMinus]"], ")"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"n", "!"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "n"], "\[PlusMinus]", 
       SubscriptBox["d", "n"]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "a039c4d0-4da9-43b8-bed9-f67982f9b1e1"],
 ". Note that the coefficients are written in t coordinate (meaning with \
Taylor expansion ~ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "i\[Omega]t"}]], TraditionalForm]],ExpressionUUID->
  "bda5e206-4db6-4182-9e85-3a468fa516a7"],
 "). Need to modify them to write\nthem in u coordinate."
}], "Text",
 CellMargins->{{$Failed, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.882252673966774*^9, 3.882252680955142*^9}, {
  3.882252906704714*^9, 3.8822530510084*^9}, {3.882253918165202*^9, 
  3.882254013643861*^9}, {3.882254044262903*^9, 3.882254114818594*^9}, {
  3.8822603092061768`*^9, 3.8822605020682364`*^9}, {3.894017206285108*^9, 
  3.8940172109581127`*^9}},ExpressionUUID->"871ea9b5-b935-4393-9369-\
6180423f57a8"]
}, Closed]],

