               FontColor->GrayLevel[0]]}]}], ")"}]}]}], " ", ")"}], "/.", " ", 
        RowBox[{"r", " ", "->", " ", "rVal"}]}]}], " ", "\[IndentingNewLine]",
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
