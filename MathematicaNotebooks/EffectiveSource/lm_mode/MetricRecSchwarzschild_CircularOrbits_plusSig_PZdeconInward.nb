            RowBox[{
             RowBox[{"hSLeftTable", "[", "i", "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "9"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"hSRightInterpol", "[", "i", "]"}], "[", 
        RowBox[{"l", ",", "m"}], "]"}], " ", "=", " ", 
