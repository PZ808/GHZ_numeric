Cell[TextData[{
 StyleBox["See eq. (48).  Boundary conditions are eq (49a):   ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      SubsuperscriptBox["\[PartialD]", "r", "n"], 
      RowBox[{"-", "2"}]], 
     SubsuperscriptBox[
      OverscriptBox["R", "_"], "lm", "M"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       SubsuperscriptBox["\[PartialD]", "r", "n"], 
       RowBox[{"-", "2"}]], 
      SubsuperscriptBox[
       OverscriptBox["R", "_"], "lm", "-"]}], " ", "+", " ", 
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        SubsuperscriptBox["\[PartialD]", "r", "n"], 
        RowBox[{"-", "2"}]], 
       SubscriptBox[
        OverscriptBox["R", "_"], "lm"]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"c39963ba-02b4-436e-926c-23efc7629694"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "d778fc21-bbcc-4025-a9ce-f18e7b559c74"],
 " for n=0,1,2,3.\nThe last term is the jump across ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "98fb39cb-9492-4b29-8ce9-0fb4d3d5c8cd"],
 " and can be given in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Thorn]", "4"], 
     OverscriptBox["\[CapitalPhi]", "_"]}], " ", "=", " ", 
    RowBox[{"2", 
     SubsuperscriptBox["\[Psi]", "0", "Res"]}]}], TraditionalForm]],
  ExpressionUUID->"97f31ffa-c8e9-4c4b-b2f4-0da71830a6e0"],
 ".",
 StyleBox["\nFor ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", "0", "Res"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "o"], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "min"]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["B", "o"], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "min"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"609dab08-e422-44d5-9cdc-49091eaeaea1"],
 " + (delta functions are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "93ce4244-1967-4434-8c1a-a946acff632a"],
 ") + smooth functions.\n",
 StyleBox["The ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "o"], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "dc71b865-91e4-4346-9d28-7c923d44cfd7"],
 StyleBox[" and ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B", "o"], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1],ExpressionUUID->
  "c108978b-c6ff-43a1-918a-0ea1c426890e"],
 StyleBox[" are independent of r!",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" Integrating around ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "c47ab2b0-f55c-4d3f-a234-2c932ae3f30b"],
 StyleBox[", the RHS gives: ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SuperscriptBox["rmin", "-"], 
       SuperscriptBox["rmin", "+"]], " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Psi]", "0", "Res"], "(", "r", ")"}], 
       RowBox[{"\[DifferentialD]", "r"}]}]}], " ", "=", " ", 
     SuperscriptBox["B", "o"]}], ",", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       SuperscriptBox["rmin", "-"], 
       SuperscriptBox["rmin", "+"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", 
          SuperscriptBox["rmin", "-"], "r"], " ", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Psi]", "0", "Res"], "(", 
           SubscriptBox["r", "1"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           SubscriptBox["r", "1"]}]}]}], ")"}], 
       RowBox[{"\[DifferentialD]", "r"}]}]}], " ", "=", " ", 
     SuperscriptBox["A", "o"]}]}], TraditionalForm]],ExpressionUUID->
  "0a29c01c-1ec8-4dee-ac11-30dc5e07c763"],
 ". \n\[Implies] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox["\[Thorn]", "2"], 
