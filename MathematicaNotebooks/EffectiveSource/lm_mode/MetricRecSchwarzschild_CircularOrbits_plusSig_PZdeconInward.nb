Cell[CellGroupData[{

Cell["Left and right interpolations", "Subsection",
 CellChangeTimes->{{3.890803577443898*^9, 3.890803581005362*^9}, {
  3.8908037323723087`*^9, 3.890803737106915*^9}, {3.893829311806617*^9, 
