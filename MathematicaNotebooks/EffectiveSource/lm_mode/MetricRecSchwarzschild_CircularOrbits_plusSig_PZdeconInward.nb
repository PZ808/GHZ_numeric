Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "coeffhPRule", ",", "\[ScriptC]AnalytictCoordGeneral", ",", 
   "\[ScriptC]Abs\[CapitalDelta]rtCoordGeneral"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"coeffhPRule", "[", "BlSIndex", "]"}], "[", 
        RowBox[{"l_", ",", "m_"}], "]"}], " ", "=", " ", 
       RowBox[{"Simplify", "@", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "Left", "]"}], " ", "==",
               " ", 
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "0", "]"}]}], ",", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"0", " ", "==", " ", 
              RowBox[{
               RowBox[{"d", "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", "0", "]"}]}], ",", " ", 
             RowBox[{"(*", " ", "convention", " ", "*)"}], 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Left", ",", "1"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}], "-", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}]}]}], ",", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Right", ",", "1"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}], "+", 
               RowBox[{
                RowBox[{"d", "[", 
                 RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}]}]}], ",", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Left", ",", "2"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"2", "!"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}], "-", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}]}], 
                ")"}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Right", ",", "2"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"2", "!"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}], "+", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}]}], 
                ")"}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Left", ",", "3"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"3", "!"}], 
               RowBox[{"(", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}], "-", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}]}], 
                ")"}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Right", ",", "3"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"3", "!"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}], "+", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}]}], 
                ")"}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Left", ",", "4"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"4", "!"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}], "-", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}]}], 
                ")"}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dhP", "[", "BlSIndex", "]"}], "[", 
                RowBox[{"l", ",", "m"}], "]"}], "[", 
               RowBox[{"Right", ",", "4"}], "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"4", "!"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}], "+", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}]}], 
                ")"}]}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "0", "]"}], ",", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}], ",", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}], ",", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}], ",", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "0", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "1", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "2", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "3", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "[", "4", "]"}]}], "}"}]}], 
          "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[ScriptC]AnalytictCoordGeneral", "[", "BlSIndex", "]"}],
             "[", 
            RowBox[{"l_", ",", "m_"}], "]"}], "[", "n", "]"}], " ", "=", " ", 
          
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "n", "]"}], " ", "/.", " ", 
            RowBox[{
             RowBox[{"coeffhPRule", "[", "BlSIndex", "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}]}], " ", "//", " ", "Simplify"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "\[ScriptC]Abs\[CapitalDelta]rtCoordGeneral", "[", "BlSIndex", 
             "]"}], "[", 
            RowBox[{"l_", ",", "m_"}], "]"}], "[", "n", "]"}], " ", "=", " ", 
          
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"l", ",", "m"}], "]"}], "[", "n", "]"}], " ", "/.", " ", 
            RowBox[{
             RowBox[{"coeffhPRule", "[", "BlSIndex", "]"}], "[", 
             RowBox[{"l", ",", "m"}], "]"}]}], " ", "//", " ", 
           "Simplify"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "orderOfPuncture"}], "}"}]}], "]"}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"BlSIndex", ",", "1", ",", "10"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", "BlSIndex", "}"}]}], "]"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.882267746872655*^9, 3.8822677613497953`*^9}, {
