             RowBox[{"rout", "=", "rNumOutbd"}], ",", "\[IndentingNewLine]", 
             " ", 
             RowBox[{"wp0", "=", "TeukolskyPrecision"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"ParallelSubmit", "[", "\[IndentingNewLine]", 
            RowBox[{"Module", "[", 
