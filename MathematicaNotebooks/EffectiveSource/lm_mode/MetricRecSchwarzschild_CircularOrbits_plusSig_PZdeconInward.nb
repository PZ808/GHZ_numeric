Cell[CellGroupData[{

Cell["Check --- Compare to known values", "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8931446111508713`*^9, 
  3.893144624841902*^9}},ExpressionUUID->"eea46515-80ad-4190-8d48-\
6ad120ca4d3e"],

Cell[TextData[{
 "Comparing to known value, see ",
 ButtonBox["arXiv:1207.5595",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1207.5595.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1207.5595.pdf"],
 ", eqs (137),(138). ",
 StyleBox["Note ",
  FontColor->GrayLevel[0]],
 "that we modified the formula for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "\[Delta]M"], TraditionalForm]],ExpressionUUID->
  "6272c895-b4fd-4630-aedd-0bf912828566"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "\[Delta]J"], TraditionalForm]],ExpressionUUID->
  "6a164dae-75a6-499c-ac5d-acf90edc6490"],
 " by a factor of ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]],ExpressionUUID->
  "46aba336-a86a-4cdf-b776-37981448b432"],
 " since the paper defines redshift as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox["h", "ab"], 
    SuperscriptBox["u", "a"], 
    SuperscriptBox["u", "b"]}], TraditionalForm]],ExpressionUUID->
  "6a0dbdf5-77d1-4a69-b67f-25ddccfb66a7"],
 ".\nOnly non-trivial components are the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nn", ",", " ", "nm", ",", " ", 
    RowBox[{"and", " ", "n", 
     OverscriptBox["m", "_"]}]}], TraditionalForm]],ExpressionUUID->
  "ae42bfa6-492e-4c0e-b03a-852a51f703f3"],
 " components. Contribution for \[Delta]M is just the ",
 Cell[BoxData[
  FormBox["nn", TraditionalForm]],ExpressionUUID->
  "55b55276-26fc-4470-83b6-226208024df3"],
 " component (real), and for \[Delta]J, it is ",
 Cell[BoxData[
  FormBox["nm", TraditionalForm]],ExpressionUUID->
  "1200a83c-e773-4e68-8a85-6c5469bc9eb8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", 
    OverscriptBox["m", "_"]}], TraditionalForm]],ExpressionUUID->
  "3802aa08-2cc7-4d86-a6c1-9e71a5fab919"],
 " (purely imaginary)\nStarting with \[Delta]M contribution:"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.8879632387520103`*^9, 3.887963294394026*^9}, {
   3.887963443599868*^9, 3.887963453271584*^9}, {3.887964557184781*^9, 
