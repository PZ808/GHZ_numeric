 RowBox[{"Clear", "[", "S\[Dagger]nmb", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S\[Dagger]nmb", "[", "l_", "]"}], "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"nNullKU", ".", "lNullKD"}], " ", 
         RowBox[{"mbNullKU", ".", "mNullKD"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"nNullKU", ".", "mNullKD"}], " ", 
         RowBox[{"mbNullKU", ".", "lNullKD"}]}]}], ")"}], "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Thorn]NullK", "[", 
        RowBox[{
         RowBox[{"\[Eth]CK", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", "#", "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"\[Eth]CK", "[", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", 
        RowBox[{"\[Thorn]NullK", "[", "#", "]"}], "]"}], "+", 
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"\[Eth]CK", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "l"}], "]"}], "[", 
         RowBox[{"\[Rho]K", " ", "#"}], "]"}]}]}], ")"}]}], " ", "&"}]}], 
  ";"}]}], "Input",
 Evaluatable->False,
