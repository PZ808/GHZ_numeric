   3.884611040973927*^9, 3.884611308137004*^9, 3.884674569566826*^9, 
   3.884674669369725*^9, {3.88476173482895*^9, 3.8847617461541567`*^9}, 
   3.884762577908345*^9, 3.884763810035928*^9, 3.886506916252927*^9, {
   3.8865069669879208`*^9, 3.886506980198867*^9}, {3.886571578876099*^9, 
