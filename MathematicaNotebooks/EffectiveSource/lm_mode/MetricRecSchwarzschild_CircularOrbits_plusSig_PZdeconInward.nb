Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"test", " ", "mode"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitPrecision", " ", "=", " ", "TeukolskyPrecision"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{"ltest", ",", "mtest"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ltest", "=", "3"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mtest", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"fit", " ", "data"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rFitMin", "=", "800"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rFitMax", "=", "1200"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rBoundary", "=", "1150"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rEval", "=", "rmax"}], ";"}]}]}]], "Input",
 CellChangeTimes->{
