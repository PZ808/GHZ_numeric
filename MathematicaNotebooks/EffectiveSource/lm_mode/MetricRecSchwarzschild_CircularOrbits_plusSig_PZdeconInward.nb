Cell[BoxData[{
 RowBox[{
  RowBox[{"ltest", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mtest", "=", "2"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"rFitMin", "=", "800"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rFitMax", "=", "1200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rBoundary", "=", "1100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rEval", "=", "rmax"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fit32", "=", 
    RowBox[{"Fitpsi0RetTail", "[", 
     RowBox[{"ltest", ",", "mtest", ",", 
      RowBox[{"\"\<FitRange\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"rFitMin", ",", "rFitMax"}], "}"}]}], ",", 
      RowBox[{"\"\<PeelingPower\>\"", "->", "5"}], ",", 
      RowBox[{"\"\<NTailTerms\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<NumberOfFitPoints\>\"", "->", "250"}], ",", 
      RowBox[{"WorkingPrecision", "->", "60"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiBarPlus32", "=", 
   RowBox[{"PhiBarPlusSolveOne", "[", 
    RowBox[{"ltest", ",", "mtest", ",", "rEval", ",", 
     RowBox[{"\"\<FitRange\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"rFitMin", ",", "rFitMax"}], "}"}]}], ",", 
     RowBox[{"\"\<BoundaryRadius\>\"", "->", "rBoundary"}], ",", 
     RowBox[{"\"\<PeelingPower\>\"", "->", "5"}], ",", 
     RowBox[{"\"\<NTailTerms\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<NumberOfFitPoints\>\"", "->", "250"}], ",", 
     RowBox[{"WorkingPrecision", "->", "60"}], ",", 
     RowBox[{"AccuracyGoal", "->", "30"}], ",", 
     RowBox[{"PrecisionGoal", "->", "25"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9925112918093233`*^9, 3.9925113211910057`*^9}, {
  3.992583986709917*^9, 3.992583988614566*^9}},
