Cell[TextData[{
 StyleBox["The \[Psi]Ret are always expanded in (t,r,\[Theta],\[CurlyPhi]) \
coordinates.\nAgain, don\[CloseCurlyQuote]t forget to add the extra factor of \
",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "im"}], " ", "\[CapitalOmega]\[CurlyPhi]", " ", 
     SuperscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "a584277d-8c66-42d4-9caa-1659df8ac129"],
 StyleBox[" so that we get the expression in (u,r,\[Theta],\[CurlyPhi]) \
coordinates.",
  FontColor->GrayLevel[0]]
}], "Text",
