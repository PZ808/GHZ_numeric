          "'"}], "[", "r", "]"}]}]}]}], ";"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"l", ",", 
     RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"m", ",", 
