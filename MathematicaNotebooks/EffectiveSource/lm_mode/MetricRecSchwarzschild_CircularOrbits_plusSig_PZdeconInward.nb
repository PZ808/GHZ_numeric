Cell[BoxData[{
 RowBox[{"Clear", "[", "Pl", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pl", "[", 
   RowBox[{"l_", ",", "1"}], "]"}], ":=", "1"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Derivative", "[", 
     RowBox[{"0", ",", "m_"}], "]"}], "[", "Pl", "]"}], "[", 
   RowBox[{"l_", ",", "1"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "^", "m"}], " ", 
      RowBox[{"m", "!"}]}], ")"}]}], " ", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"l", "+", "k"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{
        RowBox[{"-", "m"}], "+", "1"}], ",", "m"}], "}"}]}], 
    "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Pl", "[", 
   RowBox[{"l_", ",", 
    RowBox[{"-", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", "l"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Derivative", "[", 
     RowBox[{"0", ",", "m_"}], "]"}], "[", "Pl", "]"}], "[", 
   RowBox[{"l_", ",", 
    RowBox[{"-", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"l", "+", "m"}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "^", "m"}], " ", 
      RowBox[{"m", "!"}]}], ")"}]}], " ", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"l", "+", "k"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
