          SuperscriptBox["r0", 
           RowBox[{"5", "/", "2"}]], " ", 
          SqrtBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}]]}]]}], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "l"}]}], ")"}], "2"], " ", 
         SqrtBox[
