Cell[BoxData[{
 RowBox[{"Clear", "[", "dR", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dR", "[", 
   RowBox[{"x_", ",", "p_", ",", "r_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", "r"}], " ", 
    RowBox[{"Pochhammer", "[", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"p", "/", "2"}], "-", "r"}], ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"RR", "[", 
      RowBox[{"x", ",", "\[Delta]"}], "]"}], "^", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"p", "/", "2"}], "-", "r"}], "]"}]}]}], "/.", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Delta]", "^", "2"}], ")"}], "^", "n_"}], ":>", 
    RowBox[{
     RowBox[{"Abs", "[", "\[Delta]", "]"}], 
     RowBox[{"\[Delta]", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}], ")"}]}]}]}]}]}]}], "Input",
