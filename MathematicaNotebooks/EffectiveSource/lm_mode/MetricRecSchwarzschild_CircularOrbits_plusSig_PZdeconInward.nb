       RowBox[{"currentMode", "=", "None"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"lmin", "=", 
       RowBox[{"OptionValue", "[", "\"\<LMin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nPts", "=", 
       RowBox[{"OptionValue", "[", "\"\<NPts\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"useParallel", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<UseParallel\>\"", "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"verbose", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<Verbose\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"modesToFit", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "lmin", ",", "ellMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "0", ",", "l"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"allModes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
