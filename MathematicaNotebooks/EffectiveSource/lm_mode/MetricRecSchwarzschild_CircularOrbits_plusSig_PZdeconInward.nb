Cell[CellGroupData[{

Cell["Check --- Reality conditions", "Section",
 Evaluatable->False,
 CellChangeTimes->{{3.8816764118891706`*^9, 3.8816764270713377`*^9}, {
   3.8829447607562037`*^9, 3.882944766930718*^9}, 
   3.883379714653758*^9},ExpressionUUID->"be9cf895-9c16-4c44-91c4-\
c43d2f5accc3"],

Cell[TextData[{
 "We should have that the 4D ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "nn"], TraditionalForm]],ExpressionUUID->
  "7ee7af2b-9936-46b3-82d1-3ffc11e637bd"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "1fa62f12-8997-4e1e-be43-53ad019ca855"],
 " are real, while by definition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}]], " ", "=", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["x", "nm"], ")"}], "*"]}], TraditionalForm]],
  ExpressionUUID->"6c08fa7a-f3eb-4e87-b39b-c5432ab2c3c3"],
 ".\nAt the level of the modes, this means for example that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["x", 
     RowBox[{"n", 
      OverscriptBox["m", "_"]}], "lm"], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"m", "+", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["x", "nm", 
        RowBox[{"l", "-", "m"}]], ")"}], "*"], " "}]}], TraditionalForm]],
  ExpressionUUID->"d1aa5386-ebf6-4799-b5d0-2014162584f9"],
 ". This formula also holds for the other tetrad components."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.881676445111261*^9, 3.881676596647101*^9}, 
   3.8833786564175463`*^9, 
   3.883379620435625*^9},ExpressionUUID->"d9e26142-772c-4cc1-aadd-\
ae461802dccb"],

