       RowBox[{"r", "-", "r0"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"h\[ScriptCapitalP]", "[", "x_", "]"}], "[", 
         RowBox[{"l_", ",", "m_"}], "]"}], "''"}], "[", "r_", "]"}], ":>", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"hPAnalytic", "[", "x", "]"}], "[", 
         RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", 
       RowBox[{"r", "-", "r0"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
