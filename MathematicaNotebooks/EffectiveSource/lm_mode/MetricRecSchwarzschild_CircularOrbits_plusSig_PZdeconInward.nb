     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "b"}], ")"}]}]}], " ", "/.", " ", "paraFitRule"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"r", ",", "rmax", ",", "rNumOutbd"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  "]"}], "\[LineSeparator]"}], "Input",
