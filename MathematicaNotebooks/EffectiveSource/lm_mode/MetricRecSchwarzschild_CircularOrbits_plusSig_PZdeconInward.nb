Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalE]", "ab"], "(", 
     FormBox[
      RowBox[{
       SubscriptBox["L", "\[CapitalXi]"], 
       SubscriptBox["g", "ab"]}],
      TraditionalForm], ")"}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "74c197c5-9229-41e5-868c-56d0b60e03ed"],
 " irrespective on whether the expression of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalE]", "ab"], TraditionalForm]],ExpressionUUID->
  "86f797a2-f070-4f26-868a-04ffe6221cbd"],
 " at the level of modes is in t or u slicing."
}], "Text",
