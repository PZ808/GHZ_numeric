b1704575d4c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "below", " ", "two", " ", "integrals", " ", "are", " ", "the",
      " ", "same", " ", "up", " ", "to", " ", "coordinate", " ", 
     "transformation"}], ",", " ", 
    RowBox[{"and", " ", "therefore", " ", "should", " ", 
     RowBox[{"agree", ".", " ", "The"}], " ", "2", "nd", " ", "one", " ", 
     "gives", " ", "the", " ", "right", " ", 
     RowBox[{"answer", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rOf\[Rho]", "[", "\[Rho]_", "]"}], "=", 
     RowBox[{"1", "/", "\[Rho]"}]}], ";"}], "\[LineSeparator]", 
   RowBox[{
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]", ">", "0"}], ",", 
        RowBox[{"\[Rho]0", ">", "0"}]}], "}"}], ",", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "^", 
          RowBox[{"(", 
           RowBox[{"-", "4"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{"DiracDelta", "'"}], "[", 
          RowBox[{
           RowBox[{"rOf\[Rho]", "[", "\[Rho]", "]"}], "-", 
           RowBox[{"rOf\[Rho]", "[", "\[Rho]0", "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", 
          RowBox[{"\[Rho]0", "-", "\[Epsilon]"}], ",", 
          RowBox[{"\[Rho]0", "+", "\[Epsilon]"}]}], "}"}]}], "]"}]}], "]"}], "/.",
     " ", 
    RowBox[{"\[Rho]0", "->", 
     RowBox[{"1", "/", "r0"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Epsilon]", ">", "0"}], ",", 
       RowBox[{"r0", ">", "0"}]}], "}"}], ",", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"r", "^", "2"}]}], " ", 
        RowBox[{
         RowBox[{"DiracDelta", "'"}], "[", 
         RowBox[{"r", "-", "r0"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"r0", "-", "\[Epsilon]"}], ",", 
         RowBox[{"r0", "+", "\[Epsilon]"}]}], "}"}]}], "]"}]}], 
    "]"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.8979704929601097`*^9, 3.8979705584947777`*^9}, {
  3.977202927074512*^9, 3.977202929596504*^9}, {3.977204892936317*^9, 
