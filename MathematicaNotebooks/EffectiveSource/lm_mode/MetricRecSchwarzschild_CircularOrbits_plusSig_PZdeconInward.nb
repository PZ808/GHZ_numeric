Cell[TextData[{
 "Note: the below does not work well because to get ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Psi]", 
    RowBox[{"Res", ",", "loop"}]], TraditionalForm]],ExpressionUUID->
  "6c346c02-a1f9-4321-aaeb-cb0bcd171a04"],
 " had to differentiate \[CapitalPhi] fourth times, which gives huge junk \
near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SubscriptBox["r", "min"]}], TraditionalForm]],ExpressionUUID->
  "57ef0f16-20f0-4bac-8da7-7286ab940f9f"],
 ".\nCan however check that it is formally correct by computing  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "0"], "~", " ", 
      SubsuperscriptBox["h", "nn", "''"], " ", "~", " ", "\[CapitalPhi]"}], 
     "''''"}], " ", "~", " ", 
    SubscriptBox["\[Psi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "059d471e-6557-4ca1-b582-2fa9943db51b"],
 ". "
}], "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.898777486912945*^9, 3.898777536556036*^9}, {
  3.898788241084222*^9, 
  3.898788347551293*^9}},ExpressionUUID->"40a87dad-c8fc-423d-b8e8-\
a0e7583e01d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Comparing", " ", 
    SubsuperscriptBox["\[Psi]", "0", "Res"]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"rGrid", ",", "diff", ",", "diffInterpol"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rGrid", " ", "=", " ", 
     RowBox[{"DeleteElements", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"rmin", "+", 
          RowBox[{"i", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"rmax", "-", "rmin"}], ")"}], "/", "30"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "30"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", "r0", "}"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"remove", " ", "r"}], "=", "r0"}], ",", " ", 
     RowBox[{"as", " ", "puncture", " ", "not", " ", "defined", " ", 
      RowBox[{"there", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rGrid", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]0RSmoothPiece", "[", 
             RowBox[{"20", ",", "18"}], "]"}], "[", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"\[Psi]RFromhRNew", "[", 
             RowBox[{"20", ",", "18"}], "]"}], "[", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "rGrid", "]"}]}], "}"}]}], "]"}]}], ";"}], 
    " ", "//", " ", "Timing"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diffInterpol", " ", "=", " ", 
     RowBox[{"Interpolation", "[", "diff", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ReImPlot", "[", 
    RowBox[{
     RowBox[{"diffInterpol", " ", "[", "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rmin", ",", "rmax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "Full"}]}], "]"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.879323311421442*^9, 3.87932331157192*^9}, 
