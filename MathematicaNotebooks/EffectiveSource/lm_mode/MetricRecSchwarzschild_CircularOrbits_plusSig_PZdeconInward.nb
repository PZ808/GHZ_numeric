Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "testPortableBranchInterpolations", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "testPortableBranchInterpolations", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Branches\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<In\>\"", ",", "\"\<Up\>\""}], "}"}]}], ",", 
      RowBox[{"\"\<TestDomains\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<NumberOfTestPoints\>\"", "->", "250"}], ",", 
      RowBox[{"\"\<TestGridPowers\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<In\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], ",", 
         RowBox[{"\"\<Up\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "4", ",", "8"}], "}"}]}]}], "|>"}]}], ",", 
      RowBox[{"\"\<ClusterAt\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<RelativeFloor\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "100"}]}]}], ",", 
      RowBox[{"WorkingPrecision", "->", "TeukolskyPrecision"}], ",", 
      RowBox[{"\"\<MakePlots\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"testPortableBranchInterpolations", "[", 
    RowBox[{
    "referenceAssoc_Association", ",", "interpolationAssoc_Association", ",", 
     
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "branches", ",", "testDomains", ",", "nPts", ",", 
       "gridPowersOption", ",", "clusterOption", ",", "relativeFloor", ",", 
       "wp", ",", "makePlots", ",", "getBranchOption", ",", "makeTestGrid", ",",
        "results", ",", "summaryRows", ",", "makeErrorPlot", ",", "plots"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Intersection", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "referenceAssoc", "]"}], ",", 
         RowBox[{"Keys", "[", "interpolationAssoc", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"branches", "=", 
       RowBox[{"OptionValue", "[", "\"\<Branches\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"testDomains", "=", 
       RowBox[{"OptionValue", "[", "\"\<TestDomains\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nPts", "=", 
       RowBox[{"OptionValue", "[", "\"\<NumberOfTestPoints\>\"", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"gridPowersOption", "=", 
       RowBox[{"OptionValue", "[", "\"\<TestGridPowers\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clusterOption", "=", 
       RowBox[{"OptionValue", "[", "\"\<ClusterAt\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"relativeFloor", "=", 
       RowBox[{"OptionValue", "[", "\"\<RelativeFloor\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"makePlots", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"OptionValue", "[", "\"\<MakePlots\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Allows", " ", "branch"}], "-", 
        RowBox[{"dependent", " ", "options", " ", "such", " ", "as", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<In\>\"", "->", 
            RowBox[{"{", "...", "}"}]}], ",", 
           RowBox[{"\"\<Up\>\"", "->", 
            RowBox[{"{", "...", "}"}]}]}], "|>"}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"getBranchOption", "[", 
        RowBox[{"option_", ",", "branch_"}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AssociationQ", "[", "option", "]"}], ",", 
         RowBox[{"Lookup", "[", 
          RowBox[{"option", ",", "branch", ",", 
           RowBox[{"Missing", "[", 
            RowBox[{"\"\<NotSpecified\>\"", ",", "branch"}], "]"}]}], "]"}], ",",
          "option"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Half", "-", 
         RowBox[{"shifted", " ", "grid", " ", "in", " ", "u"}]}], ",", 
        RowBox[{
        "so", " ", "validation", " ", "points", " ", "are", " ", "not", " ", 
         "the", " ", "same", " ", "Subdivide", " ", "points", " ", "used", " ",
          "to", " ", "build", " ", "the", " ", 
         RowBox[{"interpolation", "."}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"makeTestGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rmin_", ",", "rmax_"}], "}"}], ",", "branch_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "a", ",", "b", ",", "powers", ",", "clusterAt", ",", "u", ",", 
           "grids"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"wp", "===", "MachinePrecision"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{"{", 
               RowBox[{"rmin", ",", "rmax"}], "}"}], "]"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"rmin", ",", "rmax"}], "}"}], ",", "wp"}], "]"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"powers", "=", 
           RowBox[{"getBranchOption", "[", 
            RowBox[{"gridPowersOption", ",", "branch"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"clusterAt", "=", 
           RowBox[{"getBranchOption", "[", 
            RowBox[{"clusterOption", ",", "branch"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"clusterAt", "===", "Automatic"}], ",", 
            RowBox[{"clusterAt", "=", 
             RowBox[{"Switch", "[", 
              RowBox[{
              "branch", ",", "\"\<In\>\"", ",", "\"\<Right\>\"", 
               ",", "\"\<Up\>\"", ",", "\"\<Left\>\"", ",", "_", 
               ",", "\"\<Both\>\""}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Midpoints", " ", "of", " ", "nPts", " ", "equal", " ", 
            "subintervals", " ", "in", " ", 
            RowBox[{"u", "."}]}], "*)"}], 
          RowBox[{"u", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"wp", "===", "MachinePrecision"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"nPts", "-", "1"}]}], "]"}], "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "/", "nPts"}], "]"}], ",", 
             
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Range", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{"nPts", "-", "1"}]}], "]"}], "+", 
                  RowBox[{"1", "/", "2"}]}], ")"}], "/", "nPts"}], ",", 
               "wp"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"grids", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{"clusterAt", ",", "\"\<Left\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"a", "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"b", "-", "a"}], ")"}], " ", 
                 RowBox[{"u", "^", "p"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "powers"}], "}"}]}], "]"}], 
             ",", "\"\<Right\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"b", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"b", "-", "a"}], ")"}], " ", 
                 RowBox[{"u", "^", "p"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "powers"}], "}"}]}], "]"}], 
             ",", "\"\<Both\>\"", ",", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"a", "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"b", "-", "a"}], ")"}], " ", 
                   RowBox[{"u", "^", "p"}]}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"p", ",", "powers"}], "}"}]}], "]"}], ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"b", "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"b", "-", "a"}], ")"}], " ", 
                   RowBox[{"u", "^", "p"}]}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"p", ",", "powers"}], "}"}]}], "]"}]}], "]"}], ",", 
             "_", ",", 
             RowBox[{"Return", "[", 
              RowBox[{"Failure", "[", 
               RowBox[{"\"\<InvalidClusterLocation\>\"", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Branch\>\"", "->", "branch"}], ",", 
                  RowBox[{"\"\<ClusterAt\>\"", "->", "clusterAt"}]}], 
                 "|>"}]}], "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Sort", "[", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Flatten", "[", "grids", "]"}], "]"}], "]"}]}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
