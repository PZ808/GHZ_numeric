   3.88312002811195*^9}, 3.883378656589973*^9, 3.883378728853662*^9, 
   3.883483906777729*^9, 3.883484298579631*^9, {3.884680368285084*^9, 
   3.884680376421783*^9}, {3.8846805043815823`*^9, 3.8846805109453382`*^9}, {
   3.884680720151679*^9, 3.884680861328886*^9}, {3.8846809089815073`*^9, 
   3.884680989251361*^9}, {3.8846811568756447`*^9, 3.88468115687574*^9}, {
