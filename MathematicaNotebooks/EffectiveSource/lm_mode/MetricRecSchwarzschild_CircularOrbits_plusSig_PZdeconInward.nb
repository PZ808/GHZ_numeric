   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"l", "+", "m"}], ")"}]}], "/", 
    RowBox[{"(", 
