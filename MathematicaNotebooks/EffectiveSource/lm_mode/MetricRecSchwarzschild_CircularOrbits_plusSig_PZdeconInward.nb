          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", "n", "+", "i"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}], 
     RowBox[{"dR", "[", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "p"}], ",", "r", ",", "\[Delta]"}], "]"}]}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "0", ",", "m"}], "}"}]}], "]"}]}]}], "Input",
