         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<fit range: r \[Element] [\>\"", ",", "rFitMin", 
           ",", "\"\<, \>\"", ",", "rFitMax", ",", "\"\<]\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "\"\<basis: {1, r, r^2, r^3}\>\"", "]"}], 
         ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"worker", "[", 
        RowBox[{"{", 
         RowBox[{"l_", ",", "m_"}], "}"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "res", "}"}], ",", 
