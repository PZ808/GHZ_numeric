Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"dhPllLeft", ",", "ddhPllLeft"}], "]"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{"dhPllLeft", "[", 
        RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[CapitalDelta]r_", "]"}], 
      " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"hPllLeft", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[CapitalDelta]r", 
        "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"hSLeftInterpol", "[", "i_", "]"}], "[", 
            RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[CapitalDelta]r", 
          "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"dhSLeftInterpol", "[", "i", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}]}], 
        "}"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"ddhPllLeft", "[", 
       RowBox[{"l_", ",", "m_"}], "]"}], "[", "\[CapitalDelta]r_", "]"}], " ",
      "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"hPllLeft", "[", 
         RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", "\[CapitalDelta]r", 
       "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"hSLeftInterpol", "[", "i_", "]"}], "[", 
            RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "\[CapitalDelta]r", 
          "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"dhSLeftInterpol", "[", "i", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}]}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"hSLeftInterpol", "[", "i_", "]"}], "[", 
            RowBox[{"l", ",", "m"}], "]"}], "''"}], "[", "\[CapitalDelta]r", 
          "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"ddhSLeftInterpol", "[", "i", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", "\[CapitalDelta]r", "]"}]}]}],
        "}"}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hPData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"hPllLeft", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", 
             RowBox[{"rmin", "-", "r0"}], "]"}], " ", 
            RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
             RowBox[{"0", ",", "l", ",", "m", ",", 
              RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"paraFitRuleForPuncture", " ", "=", " ", 
    RowBox[{"FindFit", "[", 
     RowBox[{
      RowBox[{"Abs", "@", 
       RowBox[{"hPData", "[", 
        RowBox[{"[", 
         RowBox[{"30", ";;", "All"}], "]"}], "]"}]}], ",", 
      RowBox[{"A", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "0.003"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "0.21"}], "}"}]}], "}"}], ",", "l"}], "]"}]}], 
   "\[IndentingNewLine]", 
