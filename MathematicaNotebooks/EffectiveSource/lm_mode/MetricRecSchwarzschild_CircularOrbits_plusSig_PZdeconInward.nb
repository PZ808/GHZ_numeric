Cell[TextData[{
 "These are given in the \
\[OpenCurlyDoubleQuote]SchwarzschildRegularizationParameters\
\[CloseCurlyDoubleQuote] notebook. The values are also taken from ",
 ButtonBox["arXiv:1204.0794",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1204.0794.pdf"], None},
  ButtonNote->"https://arxiv.org/pdf/1204.0794.pdf"],
 ", page 26.\nNote that they are given in mostly positive, so again need to \
change it to mostly negative signature."
}], "Text",
