Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "^", 
        RowBox[{"(", 
         RowBox[{"-", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"xnmb", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], " ", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"r", "-", "rmin"}], "]"}]}], ",", "r"}], "]"}]}], ",", 
      "r"}], "]"}]}], " ", "//", " ", "Simplify"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DiracDelta", "[", 
      RowBox[{"r", "-", "rmin"}], "]"}], ",", 
     RowBox[{
      RowBox[{"DiracDelta", "'"}], "[", 
      RowBox[{"r", "-", "rmin"}], "]"}]}], "}"}], ",", "Simplify"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ruletmp", " ", "=", " ", 
