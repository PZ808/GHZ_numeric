Cell["\<\
Exponential rate of convergence away from the orbital radius:\
\>", "Text",
 CellMargins->{{50.34765625, 10}, {7, 8}},
 Evaluatable->False,
 CellChangeTimes->{{3.890290989952304*^9, 
  3.8902910100877323`*^9}},ExpressionUUID->"de45bcdc-09b8-4b89-bd14-\
ae612b31c020"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"A", ",", "b", ",", "\[Psi]0Data"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]0Data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", "rmin", "]"}], " ", 
          RowBox[{
           RowBox[{"ExpI\[Omega]rstar", "[", "m", "]"}], "[", "rmin", "]"}], " ", 
          RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
           RowBox[{"Weylspin", ",", "l", ",", "m", ",", 
            RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"Abs", "[", "Weylspin", "]"}], ",", "lmax"}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"paraFitRuleForPuncture1", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"\[Psi]0Data", "[", 
      RowBox[{"[", 
       RowBox[{"30", ";;", "All"}], "]"}], "]"}], "]"}], ",", 
    RowBox[{"A", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "l"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "b"}], "}"}], ",", "l"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListLogPlot", "[", 
     RowBox[{"Abs", "@", "\[Psi]0Data"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], " ", "l"}], "]"}]}], " ", "/.", " ", 
        "paraFitRuleForPuncture1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.890211625565412*^9, 3.890211637568424*^9}, {
   3.890211768372325*^9, 3.890211862435749*^9}, 3.890290983508123*^9, {
   3.890370778077282*^9, 3.890370809025317*^9}, {3.992490162179442*^9, 
   3.9924901631314*^9}, {3.99249019537955*^9, 3.992490204172908*^9}},
 CellLabel->
  "In[676]:=",ExpressionUUID->"30290b22-e796-4b14-b78d-654e086d96ea"]
}, Closed]],

