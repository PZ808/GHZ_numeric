 RowBox[{
  RowBox[{"exactint", "[", 
   RowBox[{"p_", ",", "l_", ",", "\[Delta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", "+", "1"}], ")"}], "/", "2"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p", "+", "1"}], ")"}], "/", "2"}]}], "]"}], "^", "2"}]}],
       ")"}], "/", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"l", "-", 
        RowBox[{"p", "/", "2"}]}], ",", 
       RowBox[{"2", "+", "p"}]}], "]"}]}], "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"\[Delta]", "^", "2"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "/", "2"}], "+", "1"}], ")"}]}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      RowBox[{"-", "l"}], ",", 
      RowBox[{"1", "+", "l"}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p", "/", "2"}], ")"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], "/", "2"}], ")"}]}]}], "]"}]}], "-", 
   
   RowBox[{
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{"2", "+", "p"}], ")"}]}], " ", 
    RowBox[{"\[Delta]", "^", 
     RowBox[{"(", 
      RowBox[{"1", "+", "p"}], ")"}]}], " ", 
    RowBox[{"Abs", "[", "\[Delta]", "]"}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      RowBox[{"-", "l"}], ",", 
      RowBox[{"1", "+", "l"}], ",", 
      RowBox[{"2", "+", 
       RowBox[{"p", "/", "2"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], "/", "2"}], ")"}]}]}], 
     "]"}]}]}]}]}], "Input",
