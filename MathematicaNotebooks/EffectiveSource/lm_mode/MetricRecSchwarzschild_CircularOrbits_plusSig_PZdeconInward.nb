Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fit\[CapitalPsi]CubicDifferenceBase", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fit\[CapitalPsi]CubicDifferenceBase", "[", 
     RowBox[{"l_Integer", ",", "m_Integer", ",", 
      RowBox[{"rFitMin_", "?", "NumericQ"}], ",", 
      RowBox[{"rFitMax_", "?", "NumericQ"}], ",", 
      RowBox[{"nPts_Integer", ":", "250"}], ",", 
      RowBox[{"wp_", ":", "fitPrecision"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rs", ",", "rCenter", ",", "rScale", ",", "xs", ",", "values", ",", 
        "mat", ",", "scaledCoeffs", ",", "polynomial", ",", "z", ",", 
        "expressionR", ",", "coeffsR", ",", "residuals", ",", "valueScale"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"rCenter", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rFitMin", "+", "rFitMax"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rScale", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rFitMax", "-", "rFitMin"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rs", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"wp", "===", "MachinePrecision"}], ",", 
          RowBox[{"N", "@", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"rFitMin", ",", "rFitMax", ",", 
             RowBox[{"nPts", "-", "1"}]}], "]"}]}], ",", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"SetPrecision", "[", 
             RowBox[{"rFitMin", ",", "wp"}], "]"}], ",", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"rFitMax", ",", "wp"}], "]"}], ",", 
            RowBox[{"nPts", "-", "1"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xs", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rs", "-", "rCenter"}], ")"}], "/", "rScale"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"values", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalPsi]barRetp", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "rr", "]"}], "-", 
           RowBox[{
            RowBox[{"\[CapitalPsi]barInward", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "rr", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"rr", ",", "rs"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"values", ",", "NumericQ"}], "]"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Failure", "[", 
           RowBox[{"\"\<NonNumericValues\>\"", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Mode\>\"", "->", 
               RowBox[{"{", 
                RowBox[{"l", ",", "m"}], "}"}]}], ",", 
              RowBox[{"\"\<BadIndices\>\"", "->", 
               RowBox[{"Pick", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "values", "]"}], "]"}], ",", 
                 RowBox[{"NumericQ", "/@", "values"}], ",", "False"}], 
                "]"}]}]}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mat", "=", 
        RowBox[{"Outer", "[", 
         RowBox[{"Power", ",", "xs", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "3"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"scaledCoeffs", "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"mat", ",", "values"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"polynomial", "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cc", "=", "scaledCoeffs"}], ",", 
            RowBox[{"rc", "=", "rCenter"}], ",", 
            RowBox[{"sc", "=", "rScale"}]}], "}"}], ",", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "rr", "}"}], ",", 
            RowBox[{
             RowBox[{"cc", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"cc", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}]}], "+", 
             
             RowBox[{
              RowBox[{"cc", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}], "^", 
               "2"}]}], "+", 
             RowBox[{
              RowBox[{"cc", "[", 
               RowBox[{"[", "4", "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"rr", "-", "rc"}], ")"}], "/", "sc"}], ")"}], "^", 
               "3"}]}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"expressionR", "=", 
        RowBox[{"Expand", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"scaledCoeffs", "[", 
             RowBox[{"[", 
              RowBox[{"j", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"z", "-", "rCenter"}], ")"}], "/", "rScale"}], ")"}], 
             "^", "j"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeffsR", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{"expressionR", ",", "z", ",", "j"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"residuals", "=", 
        RowBox[{"values", "-", 
         RowBox[{"polynomial", "/@", "rs"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"valueScale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "300"}]}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "values", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<l\>\"", "->", "l"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<FitRange\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"rFitMin", ",", "rFitMax"}], "}"}]}], ",", 
         RowBox[{"\"\<FitRadii\>\"", "->", "rs"}], ",", 
         RowBox[{"\"\<Center\>\"", "->", "rCenter"}], ",", 
         RowBox[{"\"\<Scale\>\"", "->", "rScale"}], ",", 
         RowBox[{"\"\<ScaledCoefficients\>\"", "->", "scaledCoeffs"}], ",", 
         RowBox[{"\"\<coeffs\>\"", "->", "coeffsR"}], ",", 
         RowBox[{"\"\<a0\>\"", "->", 
          RowBox[{"coeffsR", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<a1\>\"", "->", 
          RowBox[{"coeffsR", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<a2\>\"", "->", 
          RowBox[{"coeffsR", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<a3\>\"", "->", 
          RowBox[{"coeffsR", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Polynomial\>\"", "->", "polynomial"}], ",", 
         RowBox[{"\"\<ResidualValues\>\"", "->", "residuals"}], ",", 
         RowBox[{"\"\<MaxAbsoluteResidual\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "residuals", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<RelativeResidual\>\"", "->", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "residuals", "]"}], "]"}], "/", 
           "valueScale"}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "computediffData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
