Cell[BoxData[{
 RowBox[{"Clear", "[", "\[CapitalPhi]Nbarm", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]Nbarm", "[", 
    RowBox[{"\[ScriptL]_", ",", "\[ScriptM]_"}], "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"\[CapitalPhi]Nbarm", "[", 
     RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "=", " ", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RNbar", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''''"}], "[", 
          "rVar", "]"}], " ", "==", " ", 
         RowBox[{"2", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "\[ScriptM]"}], " ", 
          RowBox[{
           RowBox[{"\[Psi]Ret", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rVar", 
           "]"}]}]}], ",", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{"RNbar", "[", 
           RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmin", 
          "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"\[CapitalPsi]barRetm", "[", 
           RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "[", "rmin", 
          "]"}]}], ",", " ", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RNbar", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'"}], "[", 
          "rmin", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalPsi]barRetm", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'"}], "[", 
          "rmin", "]"}]}], ",", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RNbar", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''"}], "[", 
          "rmin", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalPsi]barRetm", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "''"}], "[", 
          "rmin", "]"}]}], ",", " ", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RNbar", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'''"}], "[", 
          "rmin", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalPsi]barRetm", "[", 
            RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], "'''"}], "[", 
          "rmin", "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"RNbar", "[", 
       RowBox[{"\[ScriptL]", ",", "\[ScriptM]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rVar", ",", "rmin", ",", "r0"}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "35"}], ",", 
      RowBox[{"InterpolationOrder", "->", "All"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
