  FormBox[
   SubscriptBox["\[ScriptCapitalU]x", 
    RowBox[{"m", 
     OverscriptBox["m", "_"]}]], TraditionalForm]],ExpressionUUID->
  "ae42aac1-ec70-4ae6-aebe-1a9cc88a54f7"],
 " evaluated at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "45e9fd0b-28e3-4817-be69-01e7eb13f117"],
 "."
}], "Text",
