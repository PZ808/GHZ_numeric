   RowBox[{
   "Mdot", ",", "Jdot", ",", "gDotll", ",", "gDotln", ",", "gDotlm", ",", 
    "gDotlmb", ",", "gDotnn", ",", "gDotnm", ",", "gDotnmb", ",", "gDotmm", ",",
     "gDotmmb", ",", "gDotmbmb"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
