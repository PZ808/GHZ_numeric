      RowBox[{"(", 
       RowBox[{"\[Delta]", " ", "coeff", " ", "of", " ", 
        SuperscriptBox["\[Psi]", "P"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9c108724-d7b1-49f9-82c8-cdb087251f5c"],
 ".\n\n",
 StyleBox["See eq. (48).  Boundary conditions are eq (49a):   ",
