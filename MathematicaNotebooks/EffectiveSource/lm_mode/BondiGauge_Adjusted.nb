Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Test", ":"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"-", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"l", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Gamma]", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]0", "=", 
     RowBox[{"\[Pi]", "/", "3."}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]0", "=", 
     RowBox[{"\[Pi]", "/", "5."}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Maximum", " ", 
     RowBox[{"\[ScriptL]", "'"}], " ", "we", " ", "want", " ", "to", " ", 
     "keep", " ", 
     RowBox[{"(", 
      RowBox[{"should", " ", "be", " ", "large", " ", "enough"}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
        RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], ",", 
       SuperscriptBox["10.0", 
        RowBox[{"-", "15"}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[ScriptL]' values          : \>\"", ",", 
      RowBox[{"Keys", "[", "b", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mixing coefficients: \>\"", ",", "b"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\[CapitalSigma] |b|^{2} (should \[TildeTilde] 1) : \>\"", ",", 
      RowBox[{"Total", "[", 
       RowBox[{"Values", "[", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "b", "]"}], "2"], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Reconstruction", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Sreconstructed", "[", 
      RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"b", "[", "lp", "]"}], "*", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"s", ",", "lp", ",", "m", ",", "0"}], "]"}], "[", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"lp", ",", 
         RowBox[{"Abs", "[", "s", "]"}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", "s", "]"}], "+", "lCount", "-", "1"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Consistency", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sdirect", "=", 
     RowBox[{
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "l", ",", "m", ",", "0"}], "]"}], "[", 
      RowBox[{"\[Theta]0", ",", "\[Phi]0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Sreconst", "=", 
     RowBox[{"Sreconstructed", "[", 
      RowBox[{"\[Theta]0", ",", "\[Phi]0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Sdirect", "-", "Sreconst"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nDirect evaluation   S = \>\"", ",", "Sdirect"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Reconstructed       S = \>\"", ",", "Sreconst"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Absolute difference   = \>\"", ",", "diff"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Relative difference   = \>\"", ",", 
      RowBox[{"diff", "/", 
       RowBox[{"Abs", "[", "Sdirect", "]"}]}]}], "]"}], ";"}]}]}]], "Input",
