Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[Zeta]ModeFromHeld", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Zeta]ModeFromHeld", "[", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "]"}], "[", 
     RowBox[{"rr_", ":", "r"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Omega]m", ",", "zl", ",", "zn", ",", "zm", ",", "zmb", ",", 
        "ethCoeff", ",", "basisL", ",", "basisN", ",", "basisM", ",", 
        "basisMb"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Omega]m", "=", 
        RowBox[{"m", " ", "\[Omega]0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Target", "-", 
         RowBox[{"m", " ", "Held", " ", "components"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"zl", "=", 
        RowBox[{
         RowBox[{"\[Zeta]lH", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "/.", " ", 
         RowBox[{"\[Omega]", "->", "\[Omega]m"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zn", "=", 
        RowBox[{
         RowBox[{"\[Zeta]nH", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "/.", " ", 
         RowBox[{"\[Omega]", "->", "\[Omega]m"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zm", "=", 
        RowBox[{
         RowBox[{"\[Zeta]mH", "[", 
          RowBox[{"l", ",", "m"}], "]"}], "/.", " ", 
         RowBox[{"\[Omega]", "->", "\[Omega]m"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"cconj", " ", "already", " ", "performs", " ", "omega"}], "->", 
         RowBox[{"-", "omega"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"zmb", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"m", "+", "1"}], ")"}]}], " ", 
           RowBox[{"cconj", "[", 
            RowBox[{"\[Zeta]mH", "[", 
             RowBox[{"l", ",", 
              RowBox[{"-", "m"}]}], "]"}], "]"}]}], ")"}], "/.", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Omega]", "->", "\[Omega]m"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ethCoeff", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"l", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"basisL", "=", 
        RowBox[{"zn", "+", 
         RowBox[{"I", " ", "rr", " ", "\[Omega]m", " ", "zl"}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"M", "/", "rr"}], ")"}], " ", "zl"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"basisN", "=", "zl"}], ";", "\[IndentingNewLine]", 
       RowBox[{"basisMb", "=", 
        RowBox[{
         RowBox[{"rr", " ", "zm"}], "+", 
         RowBox[{"ethCoeff", " ", "zl"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"basisM", "=", 
        RowBox[{
         RowBox[{"rr", " ", "zmb"}], "-", 
         RowBox[{"ethCoeff", " ", "zl"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Frequency\>\"", "->", "\[Omega]m"}], ",", 
         RowBox[{"\"\<HeldComponents\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<l\>\"", "->", "zl"}], ",", 
            RowBox[{"\"\<n\>\"", "->", "zn"}], ",", 
            RowBox[{"\"\<m\>\"", "->", "zm"}], ",", 
            RowBox[{"\"\<mb\>\"", "->", "zmb"}]}], "|>"}]}], ",", 
         RowBox[{"\"\<BasisCoefficients\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<l\>\"", "->", "basisL"}], ",", 
            RowBox[{"\"\<n\>\"", "->", "basisN"}], ",", 
            RowBox[{"\"\<mb\>\"", "->", "basisMb"}], ",", 
            RowBox[{"\"\<m\>\"", "->", "basisM"}]}], "|>"}]}], ",", 
         RowBox[{"\"\<NPComponents\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<l\>\"", "->", "basisN"}], ",", 
            RowBox[{"\"\<n\>\"", "->", "basisL"}], ",", 
            RowBox[{"\"\<m\>\"", "->", 
             RowBox[{"-", "basisMb"}]}], ",", 
            RowBox[{"\"\<mb\>\"", "->", 
             RowBox[{"-", "basisM"}]}]}], "|>"}]}]}], "|>"}]}]}], "]"}]}], 
