          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{
             RowBox[{"Phi", "[", 
              RowBox[{"l", ",", 
               RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}]}], "+", 
           RowBox[{"r", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "'"}], "[", "r", "]"}]}]}], 
          "]"}]}]}], "]"}]}], ",", 
     RowBox[{"\"\<nmb\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
