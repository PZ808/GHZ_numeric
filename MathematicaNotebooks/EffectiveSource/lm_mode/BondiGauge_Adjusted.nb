Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SpinRules", ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"g_", "+", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Enclose", "[", 
        RowBox[{
         RowBox[{"ConfirmAssert", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Spinof", "[", "f", "]"}], "===", 
            RowBox[{"Spinof", "[", "g", "]"}]}], 
           ",", "\"\<Two scalars with different spins added\>\""}], "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Spinof", "[", "f", "]"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"g_", "*", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", 
        RowBox[{"Spinof", "[", "g", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"n_", "?", "NumberQ"}], "]"}], "\[RuleDelayed]", "0"}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"EdthH", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", "1"}]}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"EdthpH", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "-", "1"}]}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"\[Tau]H", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "+", "1"}]}], ",", 
      RowBox[{
       RowBox[{"Spinof", "[", 
        RowBox[{"\[Tau]H\[Dagger]", "@", "f_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{
        RowBox[{"Spinof", "[", "f", "]"}], "-", "1"}]}], ",", 
      RowBox[{
