        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", "0"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<nn\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", 
           SuperscriptBox["r", "2"]]}], 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "1"}], ")"}], " ", "l", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"l", "+", "2"}], ")"}]}], "16"]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Phi", "[", 
