           RowBox[{"r", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", "m"}], "]"}], "'"}], "[", "r", "]"}]}]}], 
          ")"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<mm\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "m"], " ", 
         RowBox[{"cconj", "[", 
          RowBox[{
           RowBox[{
            FractionBox["1", "r"], 
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "'"}], "[", "r", "]"}]}], "-", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "''"}], "[", "r", "]"}]}]}], 
          "]"}]}]}], "]"}]}], ",", 
