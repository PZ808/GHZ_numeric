        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "1"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"l", "+", "2"}], ")"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", "2", "]"}], " ", 
            RowBox[{"r", "^", "2"}]}], ")"}]}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{
             RowBox[{"Phi", "[", 
