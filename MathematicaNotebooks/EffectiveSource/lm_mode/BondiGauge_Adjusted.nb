 RowBox[{
  RowBox[{
   RowBox[{
   "ClearAll", "[", "Re\[ScriptCapitalS]dagMode\[CapitalPhi]OpsOld", "]"}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Sdagger", " ", "from", " ", "notebook", " ", "from", " ", "Patrick", " ", 
    "has", " ", "mostly", " ", "plus", " ", "sign", " ", "\[CapitalPhi]bar"}],
    " ", "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Re\[ScriptCapitalS]dagMode\[CapitalPhi]OpsOld", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<ll\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", "0"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<ln\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", "0"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<lm\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", "0"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<lmb\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", "0"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<nn\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", 
           SuperscriptBox["r", "2"]]}], 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "1"}], ")"}], " ", "l", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"l", "+", "2"}], ")"}]}], "16"]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Phi", "[", 
             RowBox[{"l", ",", "m"}], "]"}], "[", "r", "]"}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], " ", 
            RowBox[{"cconj", "[", 
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], 
          ")"}]}]}], "]"}]}], ",", 
     RowBox[{"\"\<nm\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Phi", ",", "l", ",", "m", ",", "r"}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "m"]}], 
         FractionBox["1", 
          SuperscriptBox["r", "2"]], 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "1"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"l", "+", "2"}], ")"}]}], "8"]], 
         RowBox[{"cconj", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{
             RowBox[{"Phi", "[", 
              RowBox[{"l", ",", 
               RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}]}], "+", 
           RowBox[{"r", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Phi", "[", 
