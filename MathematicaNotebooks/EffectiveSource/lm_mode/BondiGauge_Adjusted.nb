           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], " ", 
            RowBox[{"cconj", "[", 
             RowBox[{
              RowBox[{"Phi", "[", 
               RowBox[{"l", ",", 
                RowBox[{"-", "m"}]}], "]"}], "[", "r", "]"}], "]"}]}]}], 
          ")"}]}]}], "]"}]}], ",", 
     RowBox[{"\"\<nm\>\"", "->", 
