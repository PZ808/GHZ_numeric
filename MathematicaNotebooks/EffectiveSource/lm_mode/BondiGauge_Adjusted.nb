        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "m"]}], 
         FractionBox["1", 
          SuperscriptBox["r", "2"]], 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "-", "1"}], ")"}], " ", 
