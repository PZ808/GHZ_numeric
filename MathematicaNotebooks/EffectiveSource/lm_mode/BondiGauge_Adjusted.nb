        RowBox[{"Conjugate", "[", 
         RowBox[{"Evaluate", "[", "expr", "]"}], "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", "\[Rule]", " ", 
         RowBox[{"-", "\[Omega]"}]}], "}"}]}], "//", "fsimplify"}]}], ";"}], 
   "\[IndentingNewLine]", 
