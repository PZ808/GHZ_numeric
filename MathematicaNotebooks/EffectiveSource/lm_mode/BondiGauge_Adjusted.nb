Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Numerical", " ", "projection", " ", "of", " ", "Spheroidal", " ", 
      "Harmonics", " ", 
      SubscriptBox["S", 
       RowBox[{"l", ",", "m"}]], 
      RowBox[{"(", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "onto", " ", "the", 
      " ", "spherical", " ", "basis", " ", 
      RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
       RowBox[{"s", ",", "l", ",", "lp", ",", "m", ",", "\[Gamma]"}], "]"}]}],
      " ", 
     SubscriptBox[
      RowBox[{"=", " "}], "s"], 
     SubscriptBox["b", 
      RowBox[{"\[ScriptL]", ",", 
       RowBox[{"\[ScriptL]", "'"}], ",", "m"}]]}], "=", 
    RowBox[{
     SubscriptBox["\[Integral]", "s"], 
     RowBox[{
      SubscriptBox["S", 
       RowBox[{"\[ScriptL]", ",", "m"}]], 
      SubscriptBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " "}], "s"], 
      OverscriptBox[
       SubscriptBox["Y", 
        RowBox[{
         RowBox[{"\[ScriptL]", "'"}], ",", "m"}]], "_"], 
      RowBox[{"(", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "sin", 
      RowBox[{"(", "\[Theta]", ")"}], " ", "d\[Theta]", " ", 
      RowBox[{"d\[Phi]", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lCount", "=", "10"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
      RowBox[{
      "s_Integer", ",", "l_Integer", ",", "lp_Integer", ",", "m_Integer", ",",
        "\[Gamma]_"}], "]"}], "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"s", ",", "l", ",", "m", ",", "\[Gamma]"}], "]"}], "[", 
         RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], 
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
           RowBox[{"s", ",", "lp", ",", "m", ",", "0"}], "]"}], "[", 
          RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
      RowBox[{
      "s_Integer", ",", "l_Integer", ",", "m_Integer", ",", "\[Gamma]_"}], 
      "]"}], ":=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"lp", "\[Rule]", 
         RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
          RowBox[{"s", ",", "l", ",", "lp", ",", "m", ",", "\[Gamma]"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"lp", ",", 
          RowBox[{"Abs", "[", "s", "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", "s", "]"}], "+", "lCount", "-", "1"}]}], 
         "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Assuming", " ", 
       SubscriptBox["f", 
        RowBox[{"l", ",", "m"}]], " ", "are", " ", "coeffcients", " ", "of", 
       " ", "Spheroidal", " ", "expansion", " ", "of", " ", "a", " ", 
       "Held"}], "-", 
      RowBox[{"like", " ", "scalar", " ", "f"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{"l", ",", "m"}]], " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{
          SubscriptBox["f", 
           RowBox[{"l", ",", "m"}]], " "}], "s"], 
        SubscriptBox["S", 
         RowBox[{"l", ",", "m"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], ".", " ", "Then"}], " ",
         "f"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Sum]", 
         RowBox[{"l", ",", "m"}]], " ", 
        RowBox[{
         SubscriptBox[
          RowBox[{
           SubscriptBox["g", 
            RowBox[{"l", ",", "m"}]], " "}], "s"], 
         SubscriptBox["Y", 
          RowBox[{"l", ",", "m"}]], 
         RowBox[{"(", 
          RowBox[{"\[Theta]", ",", "\[Phi]"}], ")"}], " ", "with", " ", 
         SubscriptBox["g", 
          RowBox[{"l", ",", "m"}]]}]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"SpheroidalToSphericalExpansion", "[", "\[Gamma]", "]"}], 
           "[", "f", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], " ", "and", " ", "f"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"SphericalToSpherodalExpansion", "[", "\[Gamma]", "]"}], 
           "[", "g", "]"}], "[", 
          RowBox[{"l", ",", "m"}], "]"}], "."}]}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"SpheroidalToSphericalExpansion", "[", "\[Gamma]_", "]"}], "[",
        "f_", "]"}], "[", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
          RowBox[{
           RowBox[{"Spinof", "[", "f", "]"}], ",", "lp", ",", "l", ",", "m", 
           ",", "\[Gamma]"}], "]"}], 
         RowBox[{"f", "[", 
          RowBox[{"lp", ",", "m"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"lp", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"Spinof", "[", "f", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Spinof", "[", "f", "]"}], "]"}], "+", "lCount", "-", 
           "1"}]}], "}"}]}], "]"}], "//.", 
      RowBox[{"Union", "[", 
       RowBox[{"OperatorRules", ",", "SpinRules"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"SphericalToSpherodalExpansion", "[", "\[Gamma]_", "]"}], "[", 
       "f_", "]"}], "[", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"SpinWeightedSpheroidalHarmonicSExpansion", "[", 
           RowBox[{
            RowBox[{"Spinof", "[", "f", "]"}], ",", "l", ",", "lp", ",", "m", 
            ",", "\[Gamma]"}], "]"}], "]"}], 
         RowBox[{"f", "[", 
          RowBox[{"lp", ",", "m"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"lp", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"Spinof", "[", "f", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Spinof", "[", "f", "]"}], "]"}], "+", "lCount", "-", 
           "1"}]}], "}"}]}], "]"}], "//.", 
      RowBox[{"Union", "[", 
       RowBox[{"OperatorRules", ",", "SpinRules"}], "]"}]}]}], 
    ";"}]}]}]], "Input",
