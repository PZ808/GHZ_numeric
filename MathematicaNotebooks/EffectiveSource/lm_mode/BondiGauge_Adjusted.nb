Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"simplification", " ", "utilities"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"simplifyRule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["r", "0"], ">", "0"}], ",", 
       RowBox[{"l", ">=", "2"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"l", ",", "m"}], "}"}], ",", "Integers"}], "]"}], ",", 
       RowBox[{"M", ">", "0"}], ",", 
       RowBox[{"a", "<=", "1"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", ",", "a", ",", "\[Omega]", ",", "r"}], "}"}], ",", 
         "Reals"}], "]"}], ",", 
       RowBox[{"r", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simplify", "[", "f_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fsimplify", "[", "f_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"f", ",", 
      RowBox[{"Assumptions", "->", "simplifyRule"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"conjugation", " ", "utilities"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconj", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cconj", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"Evaluate", "[", "expr", "]"}], "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", "\[Rule]", " ", 
         RowBox[{"-", "\[Omega]"}]}], "}"}]}], "//", "fsimplify"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "cconjSch", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cconjSch", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"cconj", "[", 
       RowBox[{"expr", "/.", 
        RowBox[{"a", "->", "0"}]}], "]"}], "//", "fsimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fchop", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"expr", "//", "fsimplify"}], "//", "Expand"}], "//", "Chop"}]}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"modeValue", ",", "modeDerivative"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
