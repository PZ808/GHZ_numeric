Cell[CellGroupData[{

Cell["\<\
Import NumericalDifferentialEquationAnalysis (centered)  GL routine\
\>", "Subsection",
 CellChangeTimes->{{3.9881711840906143`*^9, 3.988171195727982*^9}, {
  3.988304203667499*^9, 
  3.988304226422226*^9}},ExpressionUUID->"717e4545-2bfc-4a68-90d1-\
4b97993da3c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gauss", "-", 
    RowBox[{
    "Legendre", " ", "orthogonality", " ", "check", " ", "for", " ", "SWSH", " ",
      "spheroidal", " ", "modes"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"makeGaussLegendreRule", ",", "sphValsOnRule"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeGaussLegendreRule", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"wp_", ":", "WP"}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "gw", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gw", "=", 
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"n", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<yGrid\>\"", "->", 
           RowBox[{"N64", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Weights\>\"", "->", 
           RowBox[{"N64", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], 
         "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"makeGLPanel", ",", "makeCompositeGLRule"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeGLPanel", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a_", "?", "NumericQ"}], ",", 
         RowBox[{"b_", "?", "NumericQ"}]}], "}"}], ",", 
       RowBox[{"wp_", ":", "WP"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "gw", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gw", "=", 
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"n", ",", "a", ",", "b", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<yGrid\>\"", "->", 
           RowBox[{"N64", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"\"\<Weights\>\"", "->", 
           RowBox[{"N64", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeCompositeGLRule", "[", 
      RowBox[{"panels_List", ",", "nList_List", ",", 
       RowBox[{"wp_", ":", "WP"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rules", ",", "y", ",", "w", ",", "ord"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rules", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"makeGLPanel", "[", 
             RowBox[{"#1", ",", "#2", ",", "wp"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"nList", ",", "panels"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "\"\<yGrid\>\"", "]"}], "]"}], "&"}], "/@", 
            "rules"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"w", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "\"\<Weights\>\"", "]"}], "]"}], "&"}], "/@", 
            "rules"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ord", "=", 
         RowBox[{"Ordering", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<yGrid\>\"", "->", 
           RowBox[{"y", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Weights\>\"", "->", 
           RowBox[{"w", "[", 
            RowBox[{"[", "ord", "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"centralRule", "=", 
     RowBox[{"makeCompositeGLRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{
            RowBox[{"-", "3"}], "/", "10"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], "/", "10"}], ",", 
           RowBox[{
            RowBox[{"-", "8"}], "/", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "8"}], "/", "100"}], ",", 
           RowBox[{"8", "/", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"8", "/", "100"}], ",", 
           RowBox[{"3", "/", "10"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "10"}], ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"48", ",", "64", ",", "160", ",", "64", ",", "48"}], "}"}], ",",
        "80"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"centralSplitRule", "=", 
      RowBox[{"makeCompositeGLRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "0.3"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.3"}], ",", 
            RowBox[{"-", "0.08"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.08"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0.08"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.08", ",", "0.3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.3", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "48", ",", "64", ",", "96", ",", "96", ",", "64", ",", "48"}], "}"}],
         ",", "80"}], "]"}]}], ";"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"yGrid", "=", 
     RowBox[{"centralRule", "[", "\"\<yGrid\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"weights", "=", 
     RowBox[{"centralRule", "[", "\"\<Weights\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"YGrid", "=", 
     RowBox[{"N64", "[", 
      RowBox[{
       RowBox[{"-", "r0val"}], " ", "yGrid"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
