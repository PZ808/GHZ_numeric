9c3f73291e38"],

Cell[TextData[{
 "For a function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", 
    RowBox[{
     RowBox[{"F", "(", 
      RowBox[{"x", ",", "y"}], ")"}], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "i\[Omega]t"}], "+", "im\[Phi]", " "}]]}]}], 
   TraditionalForm]],ExpressionUUID->"ac7569fa-2e08-483c-8db3-06dca534c5c7"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "\[Mu]"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], " ", "=", " "}], 
   TraditionalForm]],ExpressionUUID->"9f67782f-d832-4ad4-980f-67f1356fb66e"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["v", "t"], "(", 
      RowBox[{"-", "\[ImaginaryI]\[Omega]F"}], ")"}], "+", 
     RowBox[{
      SuperscriptBox["v", "\[Phi]"], "(", 
      RowBox[{"\[ImaginaryI]", " ", "mF"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"c1d9eff3-41f7-4773-9a6d-bc2b41234160"],
 "+ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["v", "X"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "X"], " ", "F"}]}], "+", 
      RowBox[{
       SuperscriptBox["v", "Y"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "Y"], "F"}]}]}], "]"}], 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]\[Omega]t"}], "+", "\[ImaginaryI]m\[Phi]", 
      " "}]]}], TraditionalForm]],ExpressionUUID->
  "769b498d-cfd4-42ac-9a5a-a14f4504e34f"],
 "\nSince X=X(r) and Y=Y(\[Theta]) ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["X", 
       RowBox[{",", "r"}]], 
      SubscriptBox["F", 
       RowBox[{",", "x"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "b9f270f7-fc4f-4fe1-a80b-d8a21a0db810"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Theta]"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["Y", 
       RowBox[{",", "\[Theta]"}]], 
      SubscriptBox["F", 
       RowBox[{",", "Y"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "c49fef1e-d9ff-4b07-a9c8-e3c1d41deccb"],
 " \nwith X = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}], "/", "\[ScriptCapitalB]", " "}], 
   TraditionalForm]],ExpressionUUID->"863b2c40-09a6-408e-a523-4c1a7a9bb0c9"],
 " and Y = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["r", "0"]}], "cos\[Theta]"}], TraditionalForm]],
  ExpressionUUID->"306d45fd-0014-4c95-8e6f-00ebe46342f9"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    RowBox[{",", "r"}]], TraditionalForm]],ExpressionUUID->
  "0da8207c-5ee7-4687-8abf-4a738ae5074b"],
 " = 1/\[ScriptCapitalB] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Y", 
     RowBox[{",", "\[Theta]"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["r", "0"], 
      RowBox[{"sin", "(", "\[Theta]", ")"}]}], "=", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["r", "0"], "2"], "-", 
        SuperscriptBox["Y", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]],ExpressionUUID->
  "ca3c9654-7b41-489d-b583-a108d630afdf"]
}], "Text",
 CellChangeTimes->{{3.988088550392536*^9, 3.9880889314069653`*^9}, {
