Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkSourceInfrastructure", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"required", ",", "missing"}], "}"}], ",", 
     RowBox[{
