Cell[BoxData[
 RowBox[{
  RowBox[{"BLtoCM", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "[", "]"}], "->", 
      RowBox[{
       RowBox[{"\[ScriptCapitalB]", " ", 
        RowBox[{"X", "[", "]"}]}], "+", "r0"}]}], ",", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "->", 
      FractionBox[
       RowBox[{"Y", "[", "]"}], 
       RowBox[{"-", "r0"}]]}], ",", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "->", 
      RowBox[{"PowerExpand", "[", 
       RowBox[{"Together", "[", 
        RowBox[{"Sin", "[", 
         RowBox[{"ArcCos", "[", 
          FractionBox[
           RowBox[{"Y", "[", "]"}], 
           RowBox[{"-", "r0"}]], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Csc", "[", 
       RowBox[{"\[Theta]", "[", "]"}], "]"}], "->", 
      FractionBox["1", 
       RowBox[{"PowerExpand", "[", 
        RowBox[{"Together", "[", 
         RowBox[{"Sin", "[", 
          RowBox[{"ArcCos", "[", 
           FractionBox[
            RowBox[{"Y", "[", "]"}], 
            RowBox[{"-", "r0"}]], "]"}], "]"}], "]"}], "]"}]]}], ",", 
     RowBox[{
      RowBox[{"Cos", "[", 
