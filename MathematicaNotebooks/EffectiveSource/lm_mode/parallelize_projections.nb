         RowBox[{
          RowBox[{
           RowBox[{"DownValues", "[", "#", "]"}], "===", 
           RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"missing", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Missing definitions for source-building helpers: \>\"",
            ",", "missing"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", 
          "[", "\"\<Rerun/import the source-construction section before \
compiling.\>\"", "]"}], ";", "\[IndentingNewLine]", 
