Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plotPlus2NearParticleComponents", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotPlus2NearParticleComponents", "[", 
    RowBox[{"run_Association", ",", "m_Integer", ",", "ell_Integer", ",", 
     RowBox[{"zoom_", ":", "0.05"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sector", ",", "ellList", ",", "ellPos", ",", "patchAssoc", ",", 
       "leftData", ",", "rightData", ",", "makeData"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sector", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellList", "=", 
       RowBox[{
        RowBox[{"sector", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<ellList\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ellPos", "=", 
       RowBox[{"First", "@", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"ellList", ",", "ell"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"patchAssoc", "=", 
       RowBox[{"run", "[", "\"\<PatchAssoc\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeData", "[", 
        RowBox[{"patch_String", ",", "transform_"}], "]"}], ":=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"patchAssoc", "[", "patch", "]"}], ",", 
            RowBox[{"transform", "/@", 
             RowBox[{
              RowBox[{
               RowBox[{"sector", "[", "\"\<ProjectionMatrices\>\"", "]"}], "[",
                "patch", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "ellPos"}], "]"}], "]"}]}]}], "}"}]}], ",",
          "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"makeData", "[", 
              RowBox[{"\"\<Left\>\"", ",", "Re"}], "]"}], ",", 
             RowBox[{"makeData", "[", 
              RowBox[{"\"\<Right\>\"", ",", "Re"}], "]"}]}], "}"}], ",", 
           RowBox[{"Joined", "->", "True"}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<X\>\"", ",", "\"\<Re[T]\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<real part near the particle: \>\"", 
               ",", "\"\<\[ScriptL] = \>\"", ",", "ell", ",", "\"\<, m = \>\"",
                ",", "m"}], "}"}], "]"}]}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Left\>\"", ",", "\"\<Right\>\""}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"X0val", "-", "zoom"}], ",", 
                RowBox[{"X0val", "+", "zoom"}]}], "}"}], ",", "All"}], 
             "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"makeData", "[", 
              RowBox[{"\"\<Left\>\"", ",", "Im"}], "]"}], ",", 
             RowBox[{"makeData", "[", 
              RowBox[{"\"\<Right\>\"", ",", "Im"}], "]"}]}], "}"}], ",", 
           RowBox[{"Joined", "->", "True"}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<X\>\"", ",", "\"\<Im[T]\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<imaginary part near the particle: \>\"", 
               ",", "\"\<\[ScriptL] = \>\"", ",", "ell", ",", "\"\<, m = \>\"",
                ",", "m"}], "}"}], "]"}]}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Left\>\"", ",", "\"\<Right\>\""}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"X0val", "-", "zoom"}], ",", 
                RowBox[{"X0val", "+", "zoom"}]}], "}"}], ",", "All"}], 
             "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
