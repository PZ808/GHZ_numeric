Cell["Create block of indices", "Subsection",
 CellChangeTimes->{{3.988304179594708*^9, 
  3.9883041973406677`*^9}},ExpressionUUID->"c4746a22-cefc-487a-842e-\
ecb2e2474d8a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", 
   RowBox[{
   "ellListForM", ",", "mListForEllMax", ",", "mList", ",", "validPairsPlus2",
     ",", "validPairsMinus2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"omegaOfM", ",", "yCosGrid"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ellListForM", "[", 
    RowBox[{"s_Integer", ",", "ellMax_Integer", ",", "m_Integer"}], "]"}], ":=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "m", "]"}], ",", 
       RowBox[{"Abs", "[", "s", "]"}]}], "]"}], ",", "ellMax"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mListForEllMax", "[", "ellMax_Integer", "]"}], ":=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "ellMax"}], ",", "ellMax"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mList", "=", 
    RowBox[{"mListForEllMax", "[", "ellMax", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"validPairsPlus2", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ell", ",", "m"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ell", ",", 
           RowBox[{"ellListForM", "[", 
            RowBox[{"2", ",", "ellMax", ",", "m"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validPairsMinus2", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ell", ",", "m"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ell", ",", 
            RowBox[{"ellListForM", "[", 
             RowBox[{"2", ",", "ellMax", ",", "m"}], "]"}]}], "}"}]}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omegaOfM", "[", "m_Integer", "]"}], ":=", 
   RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"yCosGrid", "=", 
    RowBox[{"N64", "[", 
     RowBox[{
      RowBox[{"-", "YGrid"}], "/", "r0val"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yCosGridSph", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"YGrid", ",", "80"}], "]"}]}], "/", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{"r0val", ",", "80"}], "]"}]}], ",", "80"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.989037792341588*^9, 3.9890378001411257`*^9}},
