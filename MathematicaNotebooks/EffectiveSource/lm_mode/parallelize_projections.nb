Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildTTeukPlus2ExprForM", "[", "m_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"jets", ",", "expr"}], "}"}], ",", 
      RowBox[{
       RowBox[{"checkSourceInfrastructure", "[", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"jets", "=", 
        RowBox[{"teffJets2", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"expr", "=", 
        RowBox[{"teukSourcePlus2Expr", "[", 
         RowBox[{"jets", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"\"\<while building plus-2 expression for m = \>\"", "<>", 
          RowBox[{"ToString", "[", "m", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "expr"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}]], "Input",
 CellChangeTimes->{3.989580915729004*^9},
 CellLabel->
