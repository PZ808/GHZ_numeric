Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "makeAngularYGrid", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "makeAngularYGrid", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<EpsilonZ\>\"", "->", "\[Epsilon]Tiny"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeAngularYGrid", "[", 
    RowBox[{"nY_Integer", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsZ", ",", "zGridRaw", ",", "thetaGridRaw", ",", "yGridRaw", ",", 
       "yzPairs"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsZ", "=", 
       RowBox[{"OptionValue", "[", "\"\<EpsilonZ\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zGridRaw", "=", "\[IndentingNewLine]", 
       RowBox[{"affineChebLobattoGrid", "[", "\[IndentingNewLine]", 
        RowBox[{"nY", ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "+", "epsZ"}], ",", 
           RowBox[{"1", "-", "epsZ"}]}], "}"}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"thetaGridRaw", "=", 
       RowBox[{"ArcCos", "/@", "zGridRaw"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yGridRaw", "=", 
       RowBox[{"N64", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Yval", "[", "#", "]"}], "/.", " ", "tovals"}], "/.", 
             " ", "to0vals"}], ")"}], "&"}], "/@", "thetaGridRaw"}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Sort", " ", "by", " ", "Y"}], ",", 
        RowBox[{
        "because", " ", "ListInterpolation", " ", "wants", " ", "increasing", 
         " ", "coordinate", " ", 
         RowBox[{"lists", "."}]}]}], "*)"}], 
      RowBox[{"yzPairs", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"yGridRaw", ",", "zGridRaw", ",", "thetaGridRaw"}], "}"}], 
          "]"}], ",", "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<YGrid\>\"", "->", 
         RowBox[{"yzPairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ZOnYGrid\>\"", "->", 
         RowBox[{"yzPairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ThetaOnYGrid\>\"", "->", 
         RowBox[{"yzPairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], "\[IndentingNewLine]",
        "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
