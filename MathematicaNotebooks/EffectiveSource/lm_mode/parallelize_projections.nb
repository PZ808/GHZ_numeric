Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"plus2StoredModeVector", ",", "plus2CompareStoredModes"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"plus2StoredModeVector", "[", 
     RowBox[{
     "run_Association", ",", "m_Integer", ",", "ell_Integer", ",", 
      "patch_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sector", ",", "ellList", ",", "ellPosition"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], ",", "m"}], "]"}]}],
          ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<No saved sector exists for m = \>\"", ",", "m"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sector", "=", 
        RowBox[{
         RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m", "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"ellList", "=", 
        RowBox[{
         RowBox[{"sector", "[", "\"\<Metadata\>\"", "]"}], 
         "[", "\"\<ellList\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ellPosition", "=", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"ellList", ",", "ell", ",", 
          RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MissingQ", "[", "ellPosition", "]"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<ell = \>\"", ",", "ell", 
            ",", "\"\< is unavailable for m = \>\"", ",", "m", 
            ",", "\"\<. Available ell values: \>\"", ",", "ellList"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"sector", "[", "\"\<ProjectionMatrices\>\"", "]"}], "[", 
         "patch", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"First", "[", "ellPosition", "]"}]}], "]"}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plus2CompareStoredModes", "[", 
    RowBox[{"run_Association", ",", 
     RowBox[{"mode1", ":", 
      RowBox[{"{", 
       RowBox[{"m1_Integer", ",", "ell1_Integer"}], "}"}]}], ",", 
     RowBox[{"mode2", ":", 
      RowBox[{"{", 
       RowBox[{"m2_Integer", ",", "ell2_Integer"}], "}"}]}], ",", 
     RowBox[{"patch_String", ":", "\"\<Left\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sector1", ",", "sector2", ",", "v1", ",", "v2", ",", "denominator", ",",
        "bestFitScale", ",", "residual", ",", "ratioThreshold", ",", 
       "ratioMask", ",", "ratios", ",", "report", ",", "normalizedPlot", ",", 
       "residualPlot", ",", "xGrid"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sector1", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m1", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"sector2", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m2", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"v1", "=", 
       RowBox[{"plus2StoredModeVector", "[", 
        RowBox[{"run", ",", "m1", ",", "ell1", ",", "patch"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v2", "=", 
       RowBox[{"plus2StoredModeVector", "[", 
        RowBox[{"run", ",", "m2", ",", "ell2", ",", "patch"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xGrid", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<PatchAssoc\>\"", "]"}], "[", "patch", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"denominator", "=", 
       RowBox[{
        RowBox[{"Conjugate", "[", "v2", "]"}], ".", "v2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bestFitScale", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "denominator", "]"}], "==", "0"}], ",", 
         "Indeterminate", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Conjugate", "[", "v2", "]"}], ".", "v1"}], ")"}], "/", 
          "denominator"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"residual", "=", 
       RowBox[{"v1", "-", 
        RowBox[{"bestFitScale", " ", "v2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratioThreshold", "=", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}], " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "v2", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ratioMask", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "#", "]"}], ">", "ratioThreshold"}], "&"}], ",",
          "v2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratios", "=", 
       RowBox[{"Pick", "[", 
        RowBox[{
         RowBox[{"v1", "/", "v2"}], ",", "ratioMask", ",", "True"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"report", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<RequestedMode1\>\"", "->", "mode1"}], ",", 
         RowBox[{"\"\<RequestedMode2\>\"", "->", "mode2"}], ",", 
         RowBox[{"\"\<StoredMetadata1\>\"", "->", 
          RowBox[{"KeyTake", "[", 
           RowBox[{
            RowBox[{"sector1", "[", "\"\<Metadata\>\"", "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<m\>\"", ",", "\"\<omega\>\"", ",", "\"\<ellList\>\"",
               ",", "\"\<PatchSizes\>\"", ",", "\"\<RuleTag\>\""}], "}"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<StoredMetadata2\>\"", "->", 
          RowBox[{"KeyTake", "[", 
           RowBox[{
            RowBox[{"sector2", "[", "\"\<Metadata\>\"", "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<m\>\"", ",", "\"\<omega\>\"", ",", "\"\<ellList\>\"",
               ",", "\"\<PatchSizes\>\"", ",", "\"\<RuleTag\>\""}], "}"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<ExactArraysIdenticalQ\>\"", "->", 
          RowBox[{"SameQ", "[", 
           RowBox[{"v1", ",", "v2"}], "]"}]}], ",", 
         RowBox[{"\"\<MaximumAbsoluteDifference\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"v1", "-", "v2"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<RelativeDifferenceWithoutRescaling\>\"", "->", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"v1", "-", "v2"}], "]"}], "/", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Norm", "[", "v1", "]"}], ",", 
             RowBox[{"Norm", "[", "v2", "]"}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "30"}]}]}], "]"}]}]}], ",", 
         RowBox[{"\"\<BestFitComplexScaleForMode2ToMode1\>\"", "->", 
          "bestFitScale"}], ",", 
         RowBox[{"\"\<RelativeResidualAfterBestFitRescaling\>\"", "->", 
          RowBox[{
           RowBox[{"Norm", "[", "residual", "]"}], "/", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Norm", "[", "v1", "]"}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "30"}]}]}], "]"}]}]}], ",", 
         RowBox[{"\"\<RelativeVariationOfPointwiseRatio\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ratios", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<NoSafeRatios\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"ratios", "-", "bestFitScale"}], "]"}], "]"}], "/", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"Abs", "[", "bestFitScale", "]"}], ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "30"}]}]}], "]"}]}]}], "]"}]}]}], "|>"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"normalizedPlot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Transpose", "@", 
            RowBox[{"{", 
             RowBox[{"xGrid", ",", 
              RowBox[{
               RowBox[{"Abs", "[", "v1", "]"}], "/", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", "v1", "]"}], "]"}]}]}], "}"}]}], ",", 
           RowBox[{"Transpose", "@", 
            RowBox[{"{", 
             RowBox[{"xGrid", ",", 
              RowBox[{
               RowBox[{"Abs", "[", "v2", "]"}], "/", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", "v2", "]"}], "]"}]}]}], "}"}]}]}], "}"}], 
         ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "7"}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", "\"\<normalized |T|\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
