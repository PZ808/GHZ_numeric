Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plus2InnermostSlopeTable", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plus2InnermostSlopeTable", "[", 
    RowBox[{"run_Association", ",", "m_Integer", ",", "ell_Integer", ",", 
     RowBox[{"n_Integer", ":", "8"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sector", ",", "ellList", ",", "ellPos", ",", "makeRows", ",", 
       "makeTable"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sector", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellList", "=", 
       RowBox[{
        RowBox[{"sector", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<ellList\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ellPos", "=", 
       RowBox[{"First", "@", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"ellList", ",", "ell"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeRows", "[", "patch_String", "]"}], ":=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Transpose", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"run", "[", "\"\<PatchAssoc\>\"", "]"}], "[", 
                 "patch", "]"}], "-", "X0val"}], "]"}], ",", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"sector", "[", "\"\<ProjectionMatrices\>\"", "]"}], "[",
                  "patch", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "ellPos"}], "]"}], "]"}], "]"}]}], 
             "}"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}], ",",
          "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeTable", "[", "patch_String", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rows", ",", "distances", ",", "values", ",", "slopes"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"rows", "=", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"makeRows", "[", "patch", "]"}], ",", 
             RowBox[{"UpTo", "[", 
              RowBox[{"n", "+", "1"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"distances", "=", 
           RowBox[{"rows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"values", "=", 
           RowBox[{"rows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slopes", "=", 
           RowBox[{
            RowBox[{"Differences", "[", 
             RowBox[{"Log", "[", "values", "]"}], "]"}], "/", 
            RowBox[{"Differences", "[", 
             RowBox[{"Log", "[", "distances", "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Patch\>\"", "->", "patch"}], ",", 
               RowBox[{"\"\<RepresentativeDistance\>\"", "->", "#1"}], ",", 
               RowBox[{"\"\<EffectiveSlope\>\"", "->", "#2"}]}], "|>"}], 
             "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{"Most", "[", "distances", "]"}], " ", 
                RowBox[{"Rest", "[", "distances", "]"}]}], "]"}], ",", 
              "slopes"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Dataset", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"makeTable", "[", "\"\<Left\>\"", "]"}], ",", 
         RowBox[{"makeTable", "[", "\"\<Right\>\"", "]"}]}], "]"}], "]"}]}]}],
     "]"}]}], ";"}]}], "Input",
