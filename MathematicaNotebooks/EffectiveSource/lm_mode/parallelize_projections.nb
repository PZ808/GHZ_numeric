              RowBox[{"args", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<InnerAssociationQ\>\"", "->", 
             RowBox[{"AssociationQ", "[", 
              RowBox[{"args", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<JetHead\>\"", "->", 
             RowBox[{"Head", "[", 
              RowBox[{"args", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<JetAssociationQ\>\"", "->", 
             RowBox[{"AssociationQ", "[", 
              RowBox[{"args", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<JetKeys\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", 
                RowBox[{"args", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
               RowBox[{"Keys", "[", 
                RowBox[{"args", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
               RowBox[{"Missing", "[", "\"\<NotAnAssociation\>\"", "]"}]}], 
              "]"}]}]}], "|>"}]}], "]"}], ",", "terms"}], "]"}]}]}]}], 
