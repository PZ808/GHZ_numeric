        RowBox[{"aKerr", " ", "omega"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{"s", ",", "ell", ",", "m", ",", "gamma"}], "]"}], "[", 
        RowBox[{"theta", ",", "phi"}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SsphY", "[", 
     RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
