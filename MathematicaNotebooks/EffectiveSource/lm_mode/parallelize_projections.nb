Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mergeRules", "[", 
    RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
   RowBox[{"DeleteDuplicatesBy", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compileRules", "=", 
    RowBox[{"mergeRules", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"M", "->", "MKerr"}], ",", 
        RowBox[{"a", "->", "aKerr"}], ",", 
        RowBox[{"r0", "->", "r0val"}], ",", 
        RowBox[{"\[ScriptCapitalB]", "->", "\[ScriptCapitalB]0val"}]}], "}"}],
       ",", "tovals"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"globalSymbolsLeftForCompile", "[", "expr_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"HoldComplete", "[", "expr", "]"}], ",", 
      RowBox[{"s_Symbol", "/;", 
       RowBox[{
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}], "&&", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Xval", ",", "Yval"}], "}"}], ",", "s"}], "]"}]}]}]}], ",",
       "Infinity"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98958098375558*^9, 3.989580999988943*^9}},
