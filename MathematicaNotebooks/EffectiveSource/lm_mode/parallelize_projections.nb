Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonalignment", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"styles", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Section\>\"", ",", "\"\<Subsection\>\"", 
          ",", "\"\<Subsubsection\>\""}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ToBoxes", "@", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<align\>\"", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Set", "[", 
             RowBox[{
              RowBox[{"CurrentValue", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], "]"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"CurrentValue", "[", 
               RowBox[{
                RowBox[{"PreviousCell", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"CellStyle", "\[Rule]", "styles"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], 
