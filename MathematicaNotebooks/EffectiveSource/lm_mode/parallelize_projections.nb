  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Grid", " ", "generation", " ", "utilities"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "affineChebLobattoGrid", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"affineChebLobattoGrid", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"{", 
        RowBox[{"xmin_", ",", "xmax_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", "xi", ",", "x"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xi", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"Pi", " ", 
             RowBox[{"j", "/", 
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmin", "+", "xmax"}], ")"}], "/", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmax", "-", "xmin"}], ")"}], " ", 
           RowBox[{"xi", "/", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"N64", "/@", "x"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
