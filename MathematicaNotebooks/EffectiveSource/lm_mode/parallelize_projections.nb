 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SsphThetaPhi", "[", 
      RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
     RowBox[{
      RowBox[{"theta_", "?", "NumericQ"}], ",", 
