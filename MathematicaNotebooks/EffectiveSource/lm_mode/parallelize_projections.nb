            RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
          RowBox[{"UpTo", "[", "n", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
