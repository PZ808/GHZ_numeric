Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plus2BuilderTermReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"plus2BuilderTermReport", "[", "mm_Integer", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"jets", ",", "ops", ",", "terms"}], "}"}], ",", 
    RowBox[{
     RowBox[{"jets", "=", 
      RowBox[{"teffJets2", "[", "mm", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ops", "=", 
      RowBox[{"makeTeukPlus2Ops", "[", "mm", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<ll:  Ldel1[Ldel2[Tll]]\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<Ldel1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<Ldel2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<ll\>\"", "]"}]}], "}"}]}], ",", 
        RowBox[{"\"\<mm:  LD1[LD2[Tmm]]\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<LD1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<LD2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<mm\>\"", "]"}]}], "}"}]}], ",", 
        RowBox[{"\"\<lm: -LD1[Ldellm[Tlm]]\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<LD1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<Ldellm\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<lm\>\"", "]"}]}], "}"}]}], ",", 
        RowBox[{"\"\<lm: -Ldel1[LD2[Tlm]]\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<Ldel1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<LD2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<lm\>\"", "]"}]}], "}"}]}]}], "|>"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Dataset", "@", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"name", ",", "args"}], "}"}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Term\>\"", "->", "name"}], ",", 
            RowBox[{"\"\<OuterHead\>\"", "->", 
             RowBox[{"Head", "[", 
              RowBox[{"args", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<OuterAssociationQ\>\"", "->", 
             RowBox[{"AssociationQ", "[", 
              RowBox[{"args", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<InnerHead\>\"", "->", 
