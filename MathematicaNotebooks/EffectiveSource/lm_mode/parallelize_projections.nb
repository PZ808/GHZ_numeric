          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"TakeLargestBy", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", 
          RowBox[{"UpTo", "[", "n", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"rows", "/.", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"name_", ",", "bytes_", ",", "mib_"}], "}"}], ":>", 
             RowBox[{"{", 
              RowBox[{"name", ",", "bytes", ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"mib", ",", 
                 RowBox[{"{", 
                  RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}]}]}],
            ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Symbol\>\"", ",", "\"\<Bytes\>\"", 
             ",", "\"\<MiB\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Left"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TopGlobalMemory", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
