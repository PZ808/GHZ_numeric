          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"label", ",", "\"\<: \>\"", ",", "\[IndentingNewLine]", 
                RowBox[{"Dynamic", "[", "k", "]"}], ",", "\"\</\>\"", ",", 
                "total"}], "}"}], "]"}], ",", 
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "k", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "total"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
