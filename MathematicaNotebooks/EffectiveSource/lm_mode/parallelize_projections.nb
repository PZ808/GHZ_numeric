      RowBox[{
       RowBox[{"names", "=", 
        RowBox[{"Names", "[", "patt", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"bytes", "=", 
              RowBox[{"ToExpression", "[", 
               RowBox[{"name", ",", "InputForm", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"heldOwnValueBytes", "[", "s", "]"}], ",", 
                  "HoldAllComplete"}], "]"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
