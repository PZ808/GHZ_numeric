Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plus2LocalSlopePlot", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plus2LocalSlopePlot", "[", 
    RowBox[{"run_Association", ",", "m_Integer", ",", "ell_Integer"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sector", ",", "ellList", ",", "ellPos", ",", "makeRows", ",", 
       "makeSlopes"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sector", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellList", "=", 
       RowBox[{
        RowBox[{"sector", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<ellList\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ellPos", "=", 
       RowBox[{"First", "@", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"ellList", ",", "ell"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeRows", "[", "patch_String", "]"}], ":=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Transpose", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"run", "[", "\"\<PatchAssoc\>\"", "]"}], "[", 
                 "patch", "]"}], "-", "X0val"}], "]"}], ",", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"sector", "[", "\"\<ProjectionMatrices\>\"", "]"}], "[",
                  "patch", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "ellPos"}], "]"}], "]"}], "]"}]}], 
             "}"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}], ",",
          "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeSlopes", "[", "patch_String", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rows", ",", "logDistance", ",", "logValue"}], "}"}], ",", 
         RowBox[{
          RowBox[{"rows", "=", 
           RowBox[{"makeRows", "[", "patch", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"logDistance", "=", 
           RowBox[{"Log", "[", 
            RowBox[{"rows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"logValue", "=", 
           RowBox[{"Log", "[", 
            RowBox[{"rows", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Transpose", "@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Exp", "@", 
              RowBox[{"MovingAverage", "[", 
               RowBox[{"logDistance", ",", "2"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"Differences", "[", "logValue", "]"}], "/", 
              RowBox[{"Differences", "[", "logDistance", "]"}]}]}], 
            "}"}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"makeSlopes", "[", "\"\<Left\>\"", "]"}], ",", 
          RowBox[{"makeSlopes", "[", "\"\<Right\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
        RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<|X - X0|\>\"", ",", "\"\<effective local slope\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<local radial scaling: \>\"", 
            ",", "\"\<\[ScriptL] = \>\"", ",", "ell", ",", "\"\<, m = \>\"", ",",
             "m"}], "}"}], "]"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Left\>\"", ",", "\"\<Right\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
