    RowBox[{"13", " ", "production", " ", "run"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Existing", " ", "m", " ", "files", " ", "are", " ", "skipped"}], 
   "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearSystemCache", "[", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ellMaxProd", "=", "13"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prodCacheRoot", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<Plus2ProjectionData\>\""}], "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CloseKernels", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plus2ProductionManifest", "=", 
     RowBox[{"runPlus2ProjectionsAllMCached", "[", 
      RowBox[{
      "ellMaxProd", ",", "patchAssocProd", ",", "plus2TfunOfM", ",", 
       "centralRule", ",", 
       RowBox[{"\"\<MList\>\"", "->", 
