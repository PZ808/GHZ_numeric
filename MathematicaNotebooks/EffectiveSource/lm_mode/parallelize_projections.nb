Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeCompiledXYFunction", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"rules_List", ":", "compileRules"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", ",", "leftovers"}], "}"}], ",", 
     RowBox[{
      RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
       RowBox[{"expr", ",", "\"\<before numerical replacement\>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"e", "=", 
       RowBox[{
        RowBox[{"expr", "/.", " ", "rules"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"X", "->", "Xval"}], ",", 
          RowBox[{"Y", "->", "Yval"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"e", "=", 
       RowBox[{"N", "[", 
        RowBox[{"e", ",", "MachinePrecision"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
       RowBox[{"e", ",", "\"\<after numerical replacement\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"leftovers", "=", 
       RowBox[{"globalSymbolsLeftForCompile", "[", "e", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"leftovers", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Unreplaced symbols before Compile: \>\"", ",", 
           "leftovers"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Expression sample: \>\"", ",", 
           RowBox[{"Short", "[", 
            RowBox[{"e", ",", "4"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Xval", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Yval", ",", "_Real"}], "}"}]}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "e", "]"}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"CompilationOptions", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}],
        "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[406]:=",ExpressionUUID->"cabb0286-cee1-41f8-a2f4-f181b13552ae"],

