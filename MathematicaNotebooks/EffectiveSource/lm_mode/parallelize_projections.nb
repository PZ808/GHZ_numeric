Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plus2LocalSlopePlotNearParticle", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "plus2LocalSlopePlotNearParticle", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<X0\>\"", "->", "X0val"}], ",", 
      RowBox[{"\"\<MaxDistance\>\"", "->", "0.05"}], ",", 
      RowBox[{"\"\<RelativeValueCutoff\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MovingFitPoints\>\"", "->", "4"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plus2LocalSlopePlotNearParticle", "[", 
    RowBox[{"run_Association", ",", "m_Integer", ",", "ell_Integer", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sector", ",", "ellList", ",", "ellPos", ",", "x0", ",", "maxDistance", 
       ",", "relativeCutoff", ",", "movingFitPoints", ",", "makeRows", ",", 
       "makeSlopes"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sector", "=", 
       RowBox[{
        RowBox[{"run", "[", "\"\<Sectors\>\"", "]"}], "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellList", "=", 
       RowBox[{
        RowBox[{"sector", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<ellList\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ellPos", "=", 
       RowBox[{"First", "@", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"ellList", ",", "ell"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"OptionValue", "[", "\"\<X0\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxDistance", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxDistance\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"relativeCutoff", "=", 
       RowBox[{"OptionValue", "[", "\"\<RelativeValueCutoff\>\"", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"movingFitPoints", "=", 
       RowBox[{"OptionValue", "[", "\"\<MovingFitPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeRows", "[", "patch_String", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"distances", ",", "values", ",", "peak"}], "}"}], ",", 
         RowBox[{
          RowBox[{"distances", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run", "[", "\"\<PatchAssoc\>\"", "]"}], "[", "patch", 
              "]"}], "-", "x0"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"values", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sector", "[", "\"\<ProjectionMatrices\>\"", "]"}], "[",
               "patch", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "ellPos"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"peak", "=", 
           RowBox[{"Max", "[", "values", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"SortBy", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Transpose", "@", 
               RowBox[{"{", 
                RowBox[{"distances", ",", "values"}], "}"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "<=", "maxDistance"}], "&&", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ">", 
                 RowBox[{"relativeCutoff", " ", "peak"}]}]}], "&"}]}], "]"}], 
            ",", "First"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"makeSlopes", "[", "patch_String", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rows", ",", "logRows", ",", "windows"}], "}"}], ",", 
         RowBox[{
          RowBox[{"rows", "=", 
           RowBox[{"makeRows", "[", "patch", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"logRows", "=", 
           RowBox[{"Log", "[", "rows", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"windows", "=", 
           RowBox[{"Partition", "[", 
            RowBox[{"logRows", ",", "movingFitPoints", ",", "1"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{"Mean", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"LinearModelFit", "[", 
                  RowBox[{"#", ",", "u", ",", "u"}], "]"}], 
                 "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ")"}], "&"}], "/@", 
           "windows"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"makeSlopes", "[", "\"\<Left\>\"", "]"}], ",", 
          RowBox[{"makeSlopes", "[", "\"\<Right\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
        RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<|X - X0|\>\"", ",", "\"\<effective local slope\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<near-particle scaling: \>\"", 
            ",", "\"\<\[ScriptL] = \>\"", ",", "ell", ",", "\"\<, m = \>\"", ",",
             "m"}], "}"}], "]"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Left\>\"", ",", "\"\<Right\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
