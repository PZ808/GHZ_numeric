NotebookEventActions:>{
 "WindowClose" :> 
  Module[{$CellContext`dy, $CellContext`mn, $CellContext`yr}, \
{$CellContext`dy, $CellContext`mn, $CellContext`yr} = Map[(LinkWrite[
         First[$FrontEnd], 
         FrontEnd`Value[#]]; LinkRead[
         First[$FrontEnd]])& , {"Day", "MonthName", "Second"}]; 
    NotebookLocate["LastModified"]; NotebookWrite[
      InputNotebook[], 
      Cell[
       TextData[{
        "Last modified:  ", $CellContext`dy, ", ", $CellContext`mn, 
         " ", $CellContext`yr}], "Text", CellTags -> "LastModified"]]]},
WindowSize->{930, 747},
WindowMargins->{{Automatic, 123}, {Automatic, 29}},
DockedCells->Cell[
  BoxData[{
    ButtonBox[
    "\"align\"", ButtonFunction :> 
     Map[(CurrentValue[#, {CellMargins, 1, 1}] = CurrentValue[
         PreviousCell[#, 
          CellStyle -> {"Section", "Subsection", "Subsubsection"}], {
         CellMargins, 1, 1}])& , 
       Cells[CellStyle -> "Text"]], Appearance -> Automatic, Evaluator -> 
     Automatic, Method -> "Preemptive"], 
    TagBox[
     GridBox[{{
        ButtonBox[
         InterpretationBox[
         "\"Evaluable -> \\!\\(\\*RowBox[{\\\"False\\\"}]\\)\"", 
          StringForm["Evaluable -> ``", False], Editable -> False], 
         ButtonFunction :> (CurrentValue[
            SelectedCells[
             InputNotebook[]], Evaluatable] = False), Appearance -> Automatic,
          Evaluator -> Automatic, Method -> "Preemptive"]}, {
        ButtonBox[
