Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildTTeukPlus2ExprForM", "[", "m_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"jets", ",", "expr"}], "}"}], ",", 
      RowBox[{
       RowBox[{"checkSourceInfrastructure", "[", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"jets", "=", 
        RowBox[{"teffJets2", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
