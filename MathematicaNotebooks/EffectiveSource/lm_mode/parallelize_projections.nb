Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mergeRules", "[", 
    RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
   RowBox[{"DeleteDuplicatesBy", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compileRules", "=", 
    RowBox[{"mergeRules", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"M", "->", "MKerr"}], ",", 
        RowBox[{"a", "->", "aKerr"}], ",", 
        RowBox[{"r0", "->", "r0val"}], ",", 
        RowBox[{"\[ScriptCapitalB]", "->", "\[ScriptCapitalB]0val"}]}], "}"}],
       ",", "tovals"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"globalSymbolsLeftForCompile", "[", "expr_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"HoldComplete", "[", "expr", "]"}], ",", 
      RowBox[{"s_Symbol", "/;", 
       RowBox[{
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}], "&&", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Xval", ",", "Yval"}], "}"}], ",", "s"}], "]"}]}]}]}], ",",
       "Infinity"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98958098375558*^9, 3.989580999988943*^9}},
 CellLabel->
  "In[458]:=",ExpressionUUID->"2a580267-6266-4a9c-b265-0b2cd92aab35"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeCompiledXYFunction", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"rules_List", ":", "compileRules"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", ",", "leftovers"}], "}"}], ",", 
     RowBox[{
      RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
       RowBox[{"expr", ",", "\"\<before numerical replacement\>\""}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"e", "=", 
       RowBox[{
        RowBox[{"expr", "/.", " ", "rules"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"X", "->", "Xval"}], ",", 
          RowBox[{"Y", "->", "Yval"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"e", "=", 
       RowBox[{"N", "[", 
        RowBox[{"e", ",", "MachinePrecision"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"assertNoUnevaluatedSourceBuilders", "[", 
       RowBox[{"e", ",", "\"\<after numerical replacement\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"leftovers", "=", 
       RowBox[{"globalSymbolsLeftForCompile", "[", "e", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"leftovers", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Unreplaced symbols before Compile: \>\"", ",", 
           "leftovers"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Expression sample: \>\"", ",", 
           RowBox[{"Short", "[", 
            RowBox[{"e", ",", "4"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Xval", ",", "_Real"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Yval", ",", "_Real"}], "}"}]}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "e", "]"}], ",", 
        RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
        RowBox[{"CompilationOptions", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}],
        "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[461]:=",ExpressionUUID->"cabb0286-cee1-41f8-a2f4-f181b13552ae"],

