Cell[CellGroupData[{

Cell["Correctly re-enable evaluation property", "Subsubsubsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.762002514219326*^9, 
  3.7620025247075577`*^9}},ExpressionUUID->"0d16ad99-e523-4ece-8c08-\
e2fb96e6d4e1"],

Cell["\<\
\tThis part of the above code creates a docked button that easily allows to \
deactivate cell evaluation and re - enable it,
\twhile keeping the texts, outputs,etc default (not evaluable).  \
Specifically, \[OpenCurlyDoubleQuote]re-enable\[CloseCurlyDoubleQuote] in \
fact just sets properties back to default.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.7620025283983707`*^9, 3.762002653775247*^9}, {
  3.767333803125916*^9, 3.767333810069026*^9}, {3.767334453236224*^9, 
  3.767334455964188*^9}, {3.8979745502005777`*^9, 
  3.897974554274568*^9}},ExpressionUUID->"e348002b-4d76-4e19-a9ae-\
eeb6de84b148"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buttonevaluable", " ", "=", " ", 
   RowBox[{"ToBoxes", "@", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Button", "[", 
        RowBox[{
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CurrentValue", "[", 
           RowBox[{
            RowBox[{"SelectedCells", "@", 
             RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
           "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.767333531414897*^9, 3.767333548375959*^9}, {
   3.7673336081872797`*^9, 3.767333622683069*^9}, {3.767333752783671*^9, 
