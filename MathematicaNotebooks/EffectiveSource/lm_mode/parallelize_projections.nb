Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkSourceInfrastructure", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"required", ",", "missing"}], "}"}], ",", 
     RowBox[{
      RowBox[{"required", "=", 
       RowBox[{"{", 
        RowBox[{
        "teffJets2", ",", "teukSourcePlus2Expr", ",", "applyTwoOpsToJet2"}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"missing", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"required", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"DownValues", "[", "#", "]"}], "===", 
           RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"missing", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Missing definitions for source-building helpers: \>\"",
            ",", "missing"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", 
          "[", "\"\<Rerun/import the source-construction section before \
compiling.\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "]"}]}], 
  ";"}]], "Input",
