 CellLabel->"In[33]:=",ExpressionUUID->"69b43748-bb6e-4495-a824-0a79f9f859a7"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"SetOptions", "[", 
   RowBox[{
    RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
    RowBox[{"NotebookEventActions", "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"\"\<WindowClose\>\"", "\[RuleDelayed]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], "=", 
           "\[IndentingNewLine]", "\t   ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"LinkWrite", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "$FrontEnd", "]"}], ",", 
                  RowBox[{"FrontEnd`Value", "[", "#", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "     ", 
                RowBox[{"LinkRead", "[", 
                 RowBox[{"First", "[", "$FrontEnd", "]"}], "]"}]}], ")"}], 
              "&"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Day\>\"", ",", "\"\<MonthName\>\"", 
               ",", "\"\<Second\>\""}], "}"}]}], "]"}]}], ";", 
          RowBox[{"NotebookLocate", "[", "\"\<LastModified\>\"", "]"}], ";", 
          "\[IndentingNewLine]", "\t     ", 
          RowBox[{"NotebookWrite", "[", 
           RowBox[{
            RowBox[{"InputNotebook", "[", "]"}], ",", 
            RowBox[{"Cell", "[", 
             RowBox[{
              RowBox[{"TextData", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Last modified:  \>\"", ",", "dy", 
                 ",", "\"\<, \>\"", ",", "mn", ",", "\"\< \>\"", ",", "yr"}], 
                "}"}], "]"}], ",", "\"\<Text\>\"", ",", 
              RowBox[{"CellTags", "\[Rule]", "\"\<LastModified\>\""}]}], 
             "]"}]}], "]"}]}]}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
