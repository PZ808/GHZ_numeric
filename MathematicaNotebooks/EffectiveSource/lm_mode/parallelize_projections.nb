Cell["Mixed NP spin coeffs ", "Subsubsection",
 CellChangeTimes->{{3.9880914167541447`*^9, 3.988091425185109*^9}, {
  3.988091569193225*^9, 
  3.988091569878615*^9}},ExpressionUUID->"28cdf0c0-1ec2-4899-af6e-\
bafa6885460d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Kinnersley", " ", "spin", " ", "coefficients", " ", "rewritten", " ", 
    "in", " ", "mixed", " ", 
    RowBox[{"CM", "/", "BL"}], " ", "coordinates", " ", 
    RowBox[{"(", 
     RowBox[{"t", ",", "X", ",", "Y", ",", "\[Phi]"}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "rhoNP", ",", "rhobNP", ",", "muNP", ",", "mubNP", ",", "tauNP", ",", 
      "taubNP", ",", "piNP", ",", "pibNP", ",", "betaNP", ",", "betabNP", ",",
       "alphaNP", ",", "alphabNP", ",", "gammaNP", ",", "gammabNP", ",", 
      "epsNP"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rhoNP", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"rMix", "-", 
          RowBox[{"I", " ", "a", " ", "yMix"}]}], ")"}]}], "//.", " ", 
       "ToVars"}], " ", "//.", "apToBD"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhobNP", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"rMix", "+", 
          RowBox[{"I", " ", "a", " ", "yMix"}]}], ")"}]}], "//.", "ToVars"}], 
      "//.", "apToBD"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"muNP", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"DeltaMix", " ", 
        RowBox[{"rhoNP", "^", "2"}], " ", 
        RowBox[{"rhobNP", "/", "2"}]}], " ", "//.", "ToVars"}], "//.", 
      "apToBD"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mubNP", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"DeltaMix", " ", 
        RowBox[{"rhobNP", "^", "2"}], " ", 
        RowBox[{"rhoNP", "/", "2"}]}], " ", "//.", "ToVars"}], "//.", 
      "apToBD"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauNP", ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "I"}], " ", "a", " ", "sinThetaMix", " ", "rhoNP", " ", 
