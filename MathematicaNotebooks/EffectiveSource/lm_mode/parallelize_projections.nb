Cell[BoxData[
 RowBox[{
  RowBox[{"KerrVals", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalSigma]", "->", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"r", "[", "]"}], "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox[
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}], "2"]}]}]}], ",", 
     RowBox[{"\[CapitalDelta]", "->", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"r", "[", "]"}], "2"], "-", 
       RowBox[{"2", "M", " ", 
        RowBox[{"r", "[", "]"}]}], "+", 
       SuperscriptBox["a", "2"]}]}], ",", 
     RowBox[{"\[Zeta]", "->", 
      RowBox[{
       RowBox[{"r", "[", "]"}], "-", 
       RowBox[{"I", " ", "a", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}]}]}]}], ",", 
     RowBox[{"\[Zeta]b", "->", 
      RowBox[{
       RowBox[{"r", "[", "]"}], "+", 
       RowBox[{"I", " ", "a", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}]}]}]}]}], "}"}]}], 
