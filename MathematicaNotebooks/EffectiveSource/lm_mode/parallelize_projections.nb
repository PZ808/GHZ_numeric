 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"heldDefinitionBytes", ",", "HoldFirst"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heldDefinitionBytes", "[", "s_Symbol", "]"}], ":=", 
