              RowBox[{"j", "==", "k"}], ",", "1", ",", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"x", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ",", 
