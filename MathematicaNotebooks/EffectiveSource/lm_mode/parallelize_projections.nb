Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plus2BuilderTermReport", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plus2BuilderTermReport", "[", "m_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"jets", ",", "ops", ",", "terms"}], "}"}], ",", 
     RowBox[{
      RowBox[{"jets", "=", 
       RowBox[{"teffJets2", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ops", "=", 
       RowBox[{"makeTeukPlus2Ops", "[", "m", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"terms", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ll:  P1[P2[Tll]]\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"ops", ",", "\"\<P1\>\"", ",", 
              RowBox[{"Missing", "[", 
               RowBox[{"\"\<MissingOperator\>\"", ",", "\"\<P1\>\""}], 
               "]"}]}], "]"}], ",", 
            RowBox[{"Lookup", "[", 
             RowBox[{"ops", ",", "\"\<P2\>\"", ",", 
              RowBox[{"Missing", "[", 
               RowBox[{"\"\<MissingOperator\>\"", ",", "\"\<P2\>\""}], 
               "]"}]}], "]"}], ",", 
            RowBox[{"Lookup", "[", 
             RowBox[{"jets", ",", "\"\<ll\>\"", ",", 
              RowBox[{"Missing", "[", 
               RowBox[{"\"\<MissingJet\>\"", ",", "\"\<ll\>\""}], "]"}]}], 
             "]"}]}], "}"}]}], ",", 
         RowBox[{"\"\<mm:  P4[P5[Tmm]]\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
