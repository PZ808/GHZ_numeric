            RowBox[{"right", "[", "\"\<PowerP\>\"", "]"}]}], ",", 
           RowBox[{"\"\<expected left power\>\"", "->", 
            RowBox[{"expectedLeftPower", "[", 
             RowBox[{"mUse", ",", "q"}], "]"}]}], ",", 
           RowBox[{"\"\<measured left power\>\"", "->", 
            RowBox[{"-", 
             RowBox[{"left", "[", "\"\<PowerP\>\"", "]"}]}]}], ",", 
           RowBox[{"\"\<left divergence p\>\"", "->", 
            RowBox[{"left", "[", "\"\<PowerP\>\"", "]"}]}]}], "|>"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
