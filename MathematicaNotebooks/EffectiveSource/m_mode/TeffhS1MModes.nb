  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Tensor", "-", 
    RowBox[{"product", " ", "complex", " ", "interpolation", " ", 
     RowBox[{"(", 
      RowBox[{"MMA", " ", "approach"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "makeComplexTensorInterpolant", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeComplexTensorInterpolant", "[", 
      RowBox[{"XGrid_List", ",", "YGrid_List", ",", 
       RowBox[{"vals_", "?", "MatrixQ"}], ",", 
       RowBox[{"interpOrder_", ":", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"reIF", ",", "imIF"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"reIF", "=", 
         RowBox[{"ListInterpolation", "[", 
          RowBox[{
           RowBox[{"Re", "[", "vals", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"XGrid", ",", "YGrid"}], "}"}], ",", 
           RowBox[{"InterpolationOrder", "->", "interpOrder"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"imIF", "=", 
         RowBox[{"ListInterpolation", "[", 
          RowBox[{
           RowBox[{"Im", "[", "vals", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"XGrid", ",", "YGrid"}], "}"}], ",", 
           RowBox[{"InterpolationOrder", "->", "interpOrder"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<ReIF\>\"", "->", "reIF"}], ",", 
          RowBox[{"\"\<ImIF\>\"", "->", "imIF"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"\"\<F\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Y"}], "}"}], ",", 
             RowBox[{
              RowBox[{"reIF", "[", 
               RowBox[{"X", ",", "Y"}], "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{"imIF", "[", 
                RowBox[{"X", ",", "Y"}], "]"}]}]}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<dX\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Y"}], "}"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", 
                 RowBox[{"1", ",", "0"}], "]"}], "[", "reIF", "]"}], "[", 
               RowBox[{"X", ",", "Y"}], "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Derivative", "[", 
                  RowBox[{"1", ",", "0"}], "]"}], "[", "imIF", "]"}], "[", 
                RowBox[{"X", ",", "Y"}], "]"}]}]}]}], "]"}]}], ",", 
          RowBox[{"\"\<dY\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Y"}], "}"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", 
                 RowBox[{"0", ",", "1"}], "]"}], "[", "reIF", "]"}], "[", 
               RowBox[{"X", ",", "Y"}], "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Derivative", "[", 
                  RowBox[{"0", ",", "1"}], "]"}], "[", "imIF", "]"}], "[", 
                RowBox[{"X", ",", "Y"}], "]"}]}]}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
