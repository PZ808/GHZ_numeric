Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "patchEdgeCheck", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"patchEdgeCheck", "[", 
     RowBox[{"res_Association", ",", "s_Integer", ",", "ell_Integer"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"left", ",", "right"}], "}"}], ",", 
      RowBox[{
       RowBox[{"left", "=", 
        RowBox[{"getProjData", "[", 
         RowBox[{"res", ",", "s", ",", "ell", ",", "\"\<Left\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"right", "=", 
        RowBox[{"getProjData", "[", 
         RowBox[{"res", ",", "s", ",", "ell", ",", "\"\<Right\>\""}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
         RowBox[{"\"\<X left closest to 0\>\"", "->", 
          RowBox[{"Last", "[", 
           RowBox[{"left", "[", "\"\<X\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Value left closest to 0\>\"", "->", 
          RowBox[{"Last", "[", 
           RowBox[{"left", "[", "\"\<Values\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<X right closest to 0\>\"", "->", 
          RowBox[{"First", "[", 
           RowBox[{"right", "[", "\"\<X\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Value right closest to 0\>\"", "->", 
          RowBox[{"First", "[", 
           RowBox[{"right", "[", "\"\<Values\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Jump estimate\>\"", "->", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"right", "[", "\"\<Values\>\"", "]"}], "]"}], "-", 
           RowBox[{"Last", "[", 
            RowBox[{"left", "[", "\"\<Values\>\"", "]"}], "]"}]}]}], ",", 
         RowBox[{"\"\<Abs jump\>\"", "->", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"right", "[", "\"\<Values\>\"", "]"}], "]"}], "-", 
            RowBox[{"Last", "[", 
             RowBox[{"left", "[", "\"\<Values\>\"", "]"}], "]"}]}], "]"}]}]}],
         "|>"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
