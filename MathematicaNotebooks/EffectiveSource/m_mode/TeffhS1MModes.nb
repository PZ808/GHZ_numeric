     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eps", ",", "wp", ",", "acc", ",", "prec", ",", "maxrec", ",", 
       "\[Theta]"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eps", "=", 
       RowBox[{"OptionValue", "[", "\"\<EndpointCutoff\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
