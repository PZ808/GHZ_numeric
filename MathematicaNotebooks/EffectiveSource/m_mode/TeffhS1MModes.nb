Cell[CellGroupData[{

Cell["Gauss-Legendre integration ", "Section",
 CellChangeTimes->{{3.9881709757139893`*^9, 3.9881709873134212`*^9}, {
  3.988171088516879*^9, 
  3.988171094069762*^9}},ExpressionUUID->"644b452e-fbde-4eda-b311-\
f5d928da44e5"],

Cell[CellGroupData[{

Cell["Import NumericalDifferentialEquationAnalysis  routine", "Subsection",
 CellChangeTimes->{{3.9881711840906143`*^9, 
  3.988171195727982*^9}},ExpressionUUID->"bf371721-c348-446a-b455-\
89da8f399805"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gauss", "-", 
    RowBox[{
    "Legendre", " ", "orthogonality", " ", "check", " ", "for", " ", "SWSH", 
     " ", "spheroidal", " ", "modes"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "makeGaussLegendreRule", ",", "sphValsOnRule", ",", 
      "sphOrthogonalityMatrix", ",", "sphOrthogonalityCheck"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeGaussLegendreRule", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "gw", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gw", "=", 
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"n", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<yGrid\>\"", "->", 
           RowBox[{"Nw", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Weights\>\"", "->", 
           RowBox[{"Nw", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], 
         "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sphValsOnRule", "[", 
      RowBox[{
      "s_", ",", "m_", ",", "omega_", ",", "ellList_List", ",", 
       "rule_Association"}], "]"}], ":=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ell", "->", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SsphY", "[", 
             RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", 
            "y", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}], "}"}]}], "]"}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"ell", ",", "ellList"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
