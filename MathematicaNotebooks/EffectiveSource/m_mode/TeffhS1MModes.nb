Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"compileRules", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"tovals", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"M", "->", "MKerr"}], ",", 
        RowBox[{"a", "->", "aKerr"}], ",", 
        RowBox[{"r0", "->", "r0val"}], ",", 
        RowBox[{"\[ScriptCapitalB]", "->", "\[ScriptCapitalB]0val"}]}], 
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Production", " ", 
    RowBox[{"compile", "/", "cache"}], " ", "infrastructure"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mergeRules", ",", "toMachineRules", ",", "cacheHash", ",", 
     "ensureDirectory", ",", "writeMXObject", ",", "readMXObject", ",", 
     "getCached", ",", "safeName", ",", "compiledCacheFile", ",", 
     "compileSymbolsLeft", ",", "compileXYExpr", ",", "compileLeaves", ",", 
     "compileJet2", ",", "compileOp", ",", "initTeffCompileCache", ",", 
     "TeffJetCompiledCached", ",", "TeukMinus2ReducedOpCompiledCached", ",", 
     "TeukPlus2ReducedOpCompiledCached"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Rules", " ", "earlier", " ", "in", " ", "the", " ", "list", " ", 
    RowBox[{"win", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mergeRules", "[", 
     RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
    RowBox[{"DeleteDuplicatesBy", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toMachineRules", "[", "rules_List", "]"}], ":=", 
    RowBox[{"rules", "/.", " ", 
     RowBox[{
      RowBox[{"Rule", "[", 
       RowBox[{"l_", ",", "r_"}], "]"}], ":>", 
      RowBox[{"Rule", "[", 
       RowBox[{"l", ",", 
        RowBox[{"N", "[", 
         RowBox[{"r", ",", "MP"}], "]"}]}], "]"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cacheHash", "[", "obj_", "]"}], ":=", 
    RowBox[{"StringTake", "[", 
     RowBox[{
      RowBox[{"IntegerString", "[", 
       RowBox[{
        RowBox[{"Hash", "[", 
         RowBox[{
          RowBox[{"HoldComplete", "[", "obj", "]"}], ",", "\"\<SHA256\>\""}], 
         "]"}], ",", "16"}], "]"}], ",", "20"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"dir", ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"safeName", "[", "x_", "]"}], ":=", 
   RowBox[{"StringReplace", "[", 
    RowBox[{
     RowBox[{"ToString", "[", 
      RowBox[{"x", ",", "InputForm"}], "]"}], ",", 
     RowBox[{
      RowBox[{"RegularExpression", "[", "\"\<[^A-Za-z0-9_-]\>\"", "]"}], 
      "->", "\"\<_\>\""}]}], "]"}]}], ";"}]}], "Input",
 Evaluatable->False,
