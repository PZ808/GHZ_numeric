 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"smoothCompactBump", ",", "angularWindowY"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"smoothCompactBump", "[", 
     RowBox[{"u_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "u", "]"}], "<", "1"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"u", "^", "2"}]}], ")"}]}], "]"}], ",", "0"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
