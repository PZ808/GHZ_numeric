       RowBox[{
        RowBox[{
         RowBox[{"inner", "[", "\"\<AX\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<X\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<AY\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<Y\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<A0\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<F\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
