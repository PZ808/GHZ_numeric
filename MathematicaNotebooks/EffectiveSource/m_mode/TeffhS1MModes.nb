Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Production", " ", 
    RowBox[{"compile", "/", "cache"}], " ", "infrastructure"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mergeRules", ",", "toMachineRules", ",", "cacheHash", ",", 
     "ensureDirectory", ",", "getCached", ",", "safeName"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "buildSphYTable", ",", "SphYTableCached", ",", "buildSphBundleForM"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"validSpheroidalPairs", ",", "prebuildSpheroidalTables"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Rules", " ", "earlier", " ", "in", " ", "the", " ", "list", " ", 
     RowBox[{"win", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mergeRules", "[", 
      RowBox[{"primary_List", ",", "fallback_List"}], "]"}], ":=", 
     RowBox[{"DeleteDuplicatesBy", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"primary", ",", "fallback"}], "]"}], ",", "First"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"toMachineRules", "[", "rules_List", "]"}], ":=", 
     RowBox[{"rules", "/.", " ", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"l_", ",", "r_"}], "]"}], ":>", 
       RowBox[{"Rule", "[", 
        RowBox[{"l", ",", 
         RowBox[{"N", "[", 
          RowBox[{"r", ",", "MachinePrecision"}], "]"}]}], "]"}]}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cacheHash", "[", "obj_", "]"}], ":=", 
     RowBox[{"StringTake", "[", 
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"Hash", "[", 
          RowBox[{
           RowBox[{"HoldComplete", "[", "obj", "]"}], ",", "\"\<SHA256\>\""}],
           "]"}], ",", "16"}], "]"}], ",", "20"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ensureDirectory", "[", "dir_String", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
