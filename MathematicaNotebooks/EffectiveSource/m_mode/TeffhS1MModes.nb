         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<P4\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<P6\>\"", "]"}], ",", 
