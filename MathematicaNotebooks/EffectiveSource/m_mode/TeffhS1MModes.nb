Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "endpointPowerFitFromData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"endpointPowerFitFromData", "[", "data_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"logdata", ",", "fit", ",", "slope"}], "}"}], ",", 
      RowBox[{
       RowBox[{"logdata", "=", 
        RowBox[{"Log", "/@", "data"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fit", "=", 
        RowBox[{"LinearModelFit", "[", 
         RowBox[{"logdata", ",", "u", ",", "u"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"slope", "=", 
        RowBox[{
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Slope\>\"", "->", "slope"}], ",", 
         RowBox[{"\"\<DivergencePower\>\"", "->", 
          RowBox[{"-", "slope"}]}], ",", 
         RowBox[{"\"\<Fit\>\"", "->", "fit"}]}], "|>"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"componentEndpointData", ",", "componentEndpointReport"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"componentEndpointData", "[", 
     RowBox[{"key_String", ",", 
      RowBox[{"Xval_", "?", "NumericQ"}], ",", "projector_Association", ",", 
      RowBox[{"side_String", ":", "\"\<Right\>\""}], ",", 
      RowBox[{"n_Integer", ":", "16"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "yGrid", ",", "YGrid", ",", "inds", ",", "delta", ",", "vals"}], "}"}],
       ",", 
      RowBox[{
       RowBox[{"yGrid", "=", 
        RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YGrid", "=", 
        RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"inds", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"side", "===", "\"\<Right\>\""}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "yGrid", "]"}], "-", "n", "+", "1"}], ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "]"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "n"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"delta", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"side", "===", "\"\<Right\>\""}], ",", 
          RowBox[{"1", "-", 
           RowBox[{"yGrid", "[", 
            RowBox[{"[", "inds", "]"}], "]"}]}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"yGrid", "[", 
            RowBox[{"[", "inds", "]"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"evalCompiledJet2", "[", 
             RowBox[{
              RowBox[{"TeffMinus2JetCompiled", "[", "key", "]"}], ",", "Xval",
               ",", 
              RowBox[{"YGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "[", "\"\<F\>\"", 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "inds"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"delta", ",", "vals"}], "}"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"componentEndpointReport", "[", 
    RowBox[{"key_String", ",", "q_Integer", ",", 
     RowBox[{"Xval_", "?", "NumericQ"}], ",", "projector_Association"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rightData", ",", "leftData", ",", "rightFit", ",", "leftFit"}],
       "}"}], ",", 
     RowBox[{
      RowBox[{"rightData", "=", 
       RowBox[{"componentEndpointData", "[", 
        RowBox[{
        "key", ",", "Xval", ",", "projector", ",", "\"\<Right\>\"", ",", 
         "16"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"leftData", "=", 
       RowBox[{"componentEndpointData", "[", 
        RowBox[{
        "key", ",", "Xval", ",", "projector", ",", "\"\<Left\>\"", ",", 
         "16"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rightFit", "=", 
       RowBox[{"endpointPowerFitFromData", "[", "rightData", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"leftFit", "=", 
       RowBox[{"endpointPowerFitFromData", "[", "leftData", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Component\>\"", "->", "key"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "q"}], ",", 
        RowBox[{"\"\<ExpectedRightVanishingPower\>\"", "->", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"mUse", "+", "q"}], "]"}], "/", "2"}]}], ",", 
        RowBox[{"\"\<MeasuredRightSlope\>\"", "->", 
         RowBox[{"rightFit", "[", "\"\<Slope\>\"", "]"}]}], ",", 
        RowBox[{"\"\<MeasuredRightDivergencePower\>\"", "->", 
         RowBox[{"rightFit", "[", "\"\<DivergencePower\>\"", "]"}]}], ",", 
        RowBox[{"\"\<ExpectedLeftVanishingPower\>\"", "->", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"mUse", "-", "q"}], "]"}], "/", "2"}]}], ",", 
        RowBox[{"\"\<MeasuredLeftSlope\>\"", "->", 
         RowBox[{"leftFit", "[", "\"\<Slope\>\"", "]"}]}], ",", 
        RowBox[{"\"\<MeasuredLeftDivergencePower\>\"", "->", 
         RowBox[{"leftFit", "[", "\"\<DivergencePower\>\"", "]"}]}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
