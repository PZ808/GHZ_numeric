       RowBox[{
        RowBox[{"N64", "[", "expr", "]"}], "//.", "tovals"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"X", "->", "x"}], ",", 
         RowBox[{"Y", "->", "Yin"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
     RowBox[{"CompilationOptions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}], 
    "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
