Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"integerLabelQ", ",", "exactIntLabel", ",", "validSWSHLabelQ"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"integerLabelQ", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"IntegerQ", "[", "x", "]"}], "||", 
    RowBox[{"TrueQ", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"x", "-", 
           RowBox[{"Round", "[", "x", "]"}]}], ",", "50"}], "]"}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "30"}]}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "exactIntLabel", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", "x_Integer", "]"}], ":=", "x"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xx", ",", "rr"}], "}"}], ",", 
      RowBox[{
       RowBox[{"xx", "=", 
        RowBox[{"N", "[", 
         RowBox[{"x", ",", "80"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rr", "=", 
        RowBox[{"Round", "[", "xx", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"xx", "-", "rr"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "40"}]}]}], ",", 
         RowBox[{"Rationalize", "[", 
          RowBox[{"rr", ",", "0"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Bad non-integer spheroidal label: \>\"", ",", "x"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exactIntLabel", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Bad non-numeric/non-integer spheroidal label: \>\"", ",", "x"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validSWSHLabelQ", "[", 
    RowBox[{"s_", ",", "ell_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ss", "=", 
       RowBox[{"exactIntLabel", "[", "s", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ll", "=", 
       RowBox[{"exactIntLabel", "[", "ell", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mm", "=", 
       RowBox[{"exactIntLabel", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ll", ">=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "ss", "]"}], ",", 
         RowBox[{"Abs", "[", "mm", "]"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]}], "Input",
