Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "angularIntegrandSamples", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"angularIntegrandSamples", "[", 
    RowBox[{"Tfun_", ",", "projector_Association", ",", 
     RowBox[{"Xval_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "yGrid", ",", "YGrid", ",", "sph", ",", "srcVals", ",", "vals"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"yGrid", "=", 
       RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"YGrid", "=", 
       RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sph", "=", 
       RowBox[{"projector", "[", "\"\<SpheroidalValues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"srcVals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tfun", "[", 
          RowBox[{"Xval", ",", 
           RowBox[{"YGrid", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"sph", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
          RowBox[{"srcVals", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<yGrid\>\"", "->", "yGrid"}], ",", 
        RowBox[{"\"\<YGrid\>\"", "->", "YGrid"}], ",", 
        RowBox[{"\"\<SourceValues\>\"", "->", "srcVals"}], ",", 
        RowBox[{"\"\<IntegrandValues\>\"", "->", "vals"}], ",", 
        RowBox[{"\"\<Data\>\"", "->", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"yGrid", ",", 
            RowBox[{"Re", "[", "vals", "]"}], ",", 
            RowBox[{"Im", "[", "vals", "]"}], ",", 
            RowBox[{"Abs", "[", "vals", "]"}]}], "}"}], "]"}]}], ",", 
        RowBox[{"\"\<SourceAbsData\>\"", "->", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"yGrid", ",", 
            RowBox[{"Abs", "[", "srcVals", "]"}]}], "}"}], "]"}]}], ",", 
