      "\[IndentingNewLine]", 
      RowBox[{"rRightPhys", "=", 
       RowBox[{"r0val", "+", "\[ScriptCapitalB]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xLeftOuter", "=", 
