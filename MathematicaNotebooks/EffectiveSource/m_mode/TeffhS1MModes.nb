Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{"(*", 
   RowBox[{"Per", "-", 
    RowBox[{"m", " ", "plus"}], "-", 
    RowBox[{"2", " ", "projection", " ", "driver"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "ellListForM", ",", "makePlus2ProjectionTasksForM", ",", 
      "runPlus2ProjectionTaskNoProjector", ",", "runPlus2ProjectionsForM"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ellListForM", "[", 
      RowBox[{"s_Integer", ",", "ellMax_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "m", "]"}], ",", 
         RowBox[{"Abs", "[", "s", "]"}]}], "]"}], ",", "ellMax"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makePlus2ProjectionTasksForM", "[", 
      RowBox[{
      "ellMax_Integer", ",", "m_Integer", ",", "nY_Integer", ",", 
       "patchAssoc_Association", ",", "Tfun_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ellList", ",", "projectors", ",", "tasks"}], "}"}], ",", 
       RowBox[{
        RowBox[{"ellList", "=", 
         RowBox[{"ellListForM", "[", 
          RowBox[{
           RowBox[{"+", "2"}], ",", "ellMax", ",", "m"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Building projectors on master kernel for m = \>\"", ",", "m", 
          ",", "\"\<...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"projectors", "=", 
         RowBox[{"Association", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ell", "->", 
             RowBox[{"makeAngularProjector", "[", 
              RowBox[{
               RowBox[{"+", "2"}], ",", "ell", ",", "m", ",", "nY"}], "]"}]}],
             ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", "ellList"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tasks", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<s\>\"", "->", 
                RowBox[{"+", "2"}]}], ",", 
               RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
               RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
               RowBox[{"\"\<nY\>\"", "->", "nY"}], ",", 
               RowBox[{"\"\<Patch\>\"", "->", "patchName"}], ",", 
               RowBox[{"\"\<XGrid\>\"", "->", 
                RowBox[{"patchAssoc", "[", "patchName", "]"}]}], ",", 
               RowBox[{"\"\<Projector\>\"", "->", 
                RowBox[{"projectors", "[", "ell", "]"}]}], ",", 
               RowBox[{"\"\<Tfun\>\"", "->", "Tfun"}]}], "|>"}], ",", 
             RowBox[{"{", 
              RowBox[{"ell", ",", "ellList"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"patchName", ",", 
               RowBox[{"Keys", "[", "patchAssoc", "]"}]}], "}"}]}], "]"}], 
           ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", "tasks"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
