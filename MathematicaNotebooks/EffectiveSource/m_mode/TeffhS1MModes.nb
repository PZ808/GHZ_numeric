Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"smoothStep01", ",", "angularPlateauWindowY"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"smoothStep01", "[", 
     RowBox[{"u_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"u", "<=", "0"}], ",", "0", ",", 
        RowBox[{"u", ">=", "1"}], ",", "1", ",", "True", ",", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "u"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"b", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "-", "u"}], ")"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"a", "/", 
          RowBox[{"(", 
           RowBox[{"a", "+", "b"}], ")"}]}]}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"angularPlateauWindowY", "[", 
    RowBox[{
     RowBox[{"Y_", "?", "NumericQ"}], ",", 
     RowBox[{"Yin_", "?", "NumericQ"}], ",", 
     RowBox[{"Yout_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"Abs", "[", "Y", "]"}]}], "}"}], ",", 
     RowBox[{"1", "-", 
      RowBox[{"smoothStep01", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "-", "Yin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"Yout", "-", "Yin"}], ")"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
 Evaluatable->False,
