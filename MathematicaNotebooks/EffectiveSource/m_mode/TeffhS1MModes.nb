Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TTeukMinus2PoleCleanHatPoint", "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TTeukMinus2PoleCleanHatPoint", "[", 
    RowBox[{
     RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"Yval_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rawJets", ",", " ", "hatJets", ",", " ", "ops", ",", " ", 
       "hatSource"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"rawJets", " ", "=", "\n", "   ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<nn\>\"", " ", "->", "\n", "     ", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<nn\>\"", "]"}], ",", 
            " ", "x", ",", " ", "Yval"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<nmb\>\"", " ", "->", "\n", "     ", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<nmb\>\"", "]"}], ",", 
            " ", "x", ",", " ", "Yval"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<mbmb\>\"", " ", "->", "\n", "     ", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<mbmb\>\"", "]"}], ",", 
            " ", "x", ",", " ", "Yval"}], "]"}]}]}], "\n", "    ", "|>"}]}], 
      ";", "\n", "\n", "  ", 
      RowBox[{"hatJets", " ", "=", "\n", "   ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<nn\>\"", " ", "->", "\n", "     ", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", " ", "0", ",", " ", 
            RowBox[{"rawJets", "[", "\"\<nn\>\"", "]"}], ",", " ", "Yval"}], 
           "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<nmb\>\"", " ", "->", "\n", "     ", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", 
            RowBox[{"rawJets", "[", "\"\<nmb\>\"", "]"}], ",", " ", "Yval"}], 
           "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<mbmb\>\"", " ", "->", "\n", "     ", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", " ", 
            RowBox[{"-", "2"}], ",", " ", 
            RowBox[{"rawJets", "[", "\"\<mbmb\>\"", "]"}], ",", " ", "Yval"}],
            "]"}]}]}], "\n", "    ", "|>"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"ops", " ", "=", "\n", "   ", 
       RowBox[{"Association", " ", "@", "\n", "    ", 
        RowBox[{"KeyValueMap", "[", "\n", "     ", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"key", ",", " ", "op"}], "}"}], ",", "\n", "      ", 
            RowBox[{"key", " ", "->", " ", 
             RowBox[{"evalCompiledOp", "[", 
              RowBox[{"op", ",", " ", "x", ",", " ", "Yval"}], "]"}]}]}], 
           "\n", "      ", "]"}], ",", "\n", "     ", 
          "Minus2ReducedOpsCompiled"}], "\n", "     ", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\n", "  ", 
      RowBox[{"hatSource", " ", "=", "\n", "   ", 
       RowBox[{
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M1\>\"", "]"}], ",", " ", 
          RowBox[{"ops", "[", "\"\<M2\>\"", "]"}], ",", " ", 
          RowBox[{"hatJets", "[", "\"\<nmb\>\"", "]"}]}], "]"}], "\n", "    ",
         "-", "\n", "    ", 
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M1\>\"", "]"}], ",", " ", 
          RowBox[{"ops", "[", "\"\<M3\>\"", "]"}], ",", " ", 
          RowBox[{"hatJets", "[", "\"\<mbmb\>\"", "]"}]}], "]"}], "\n", 
        "    ", "+", "\n", "    ", 
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M4\>\"", "]"}], ",", " ", 
          RowBox[{"ops", "[", "\"\<M5\>\"", "]"}], ",", " ", 
          RowBox[{"hatJets", "[", "\"\<nmb\>\"", "]"}]}], "]"}], "\n", "    ",
         "-", "\n", "    ", 
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M4\>\"", "]"}], ",", " ", 
          RowBox[{"ops", "[", "\"\<M6\>\"", "]"}], ",", " ", 
          RowBox[{"hatJets", "[", "\"\<nn\>\"", "]"}]}], "]"}]}]}], ";", "\n",
       "\n", "  ", "hatSource"}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98818535347042*^9, 3.988185389526206*^9}},
 CellLabel->
  "In[435]:=",ExpressionUUID->"767bb095-8242-40a1-ab30-f659c16230f5"]
