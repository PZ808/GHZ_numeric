      RowBox[{"\"\<mm\>\"", "->", "Teffmm$MMode$XY$numeric"}], ",", 
      RowBox[{"\"\<mmb\>\"", "->", "Teffmmb$MMode$XY$numeric"}]}], "|>"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flattenComplexInterleaved", "[", 
     RowBox[{"data_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", "#", "]"}], ",", 
          RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
      RowBox[{"Flatten", "[", "data", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildComponentMatrix", "[", 
     RowBox[{"fun_", ",", 
      RowBox[{"m_Integer", "?", "NonNegative"}], ",", "XGrid_List", ",", 
