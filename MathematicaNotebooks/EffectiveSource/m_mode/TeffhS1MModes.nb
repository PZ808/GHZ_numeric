Cell[CellGroupData[{

Cell["Pole reduced form  ", "Subsection",
 CellChangeTimes->{{3.9881691179647017`*^9, 
  3.988169124202743*^9}},ExpressionUUID->"3f92ea5d-344f-4898-b7e5-\
625680f567bf"],

Cell[TextData[{
 "We write the stress energy in pole factorized form :\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["", "s"], 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{"m", ",", "\[Omega]"}]], "ab"], "(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "539d191d-f27b-4bbd-b032-e7df385a2127"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["w", 
      RowBox[{"m", ",", "s"}]], "(", 
     RowBox[{"Y", "(", "y", ")"}], ")"}], 
    SubscriptBox[
     OverscriptBox[
      RowBox[{
       SubscriptBox[" ", "s"], 
       SuperscriptBox["T", 
        RowBox[{"m", ",", "\[Omega]"}]]}], "^"], "ab"], 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6f20c37-ddce-49fb-90d6-37a00e251ecc"],
 "\nwhere the \n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["w", 
     RowBox[{"m", ",", "s"}]], 
    RowBox[{"(", "y", ")"}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "y"}], ")"}], 
     SubscriptBox["\[Alpha]", 
      RowBox[{"m", ",", "s"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "y"}], ")"}], 
     SubscriptBox["\[Beta]", 
      RowBox[{"m", ",", "s"}]]]}]}]],ExpressionUUID->
  "67b716c9-e38f-40b2-a651-fb1d35c962db"],
 ".\nThe power exponents are given by \[Alpha]=|m+s|/2 and \[Beta]=|m-s|/2"
}], "Text",
 CellChangeTimes->{{3.988169129866596*^9, 
  3.988169418287292*^9}},ExpressionUUID->"4dc4f224-76d6-4f19-9c6c-\
64fb6782f6e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Pole", "-", 
    RowBox[{"reduction", " ", "weights"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "yCosExpr", ",", "poleWeightNum", ",", " ", "poleWeightY", ",", 
      "dLogPoleWeightNum", ",", " ", "dLogPoleWeightY", ",", 
      "d2LogPoleWeightNum", ",", " ", "poleWeightRatioY"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yCosExpr", ":=", 
     RowBox[{
      RowBox[{"-", "Y"}], "/", "r0val"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"poleWeightNum", "[", 
      RowBox[{"m_Integer", ",", "q_Integer", ",", 
       RowBox[{"Yval_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "a", ",", "b"}], "}"}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{
          RowBox[{"-", "Yval"}], "/", "r0val"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "-", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "y"}], ")"}], "^", "a"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "y"}], ")"}], "^", "b"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"poleWeightY", "[", 
      RowBox[{"m_Integer", ",", "q_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "y"}], "}"}], ",", 
       RowBox[{
        RowBox[{"y", "=", "yCosExpr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "-", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "y"}], ")"}], "^", "a"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "y"}], ")"}], "^", "b"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dLogPoleWeightY", "[", 
      RowBox[{"m_Integer", ",", "q_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "y"}], "}"}], ",", 
       RowBox[{
        RowBox[{"y", "=", "yCosExpr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "-", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "/", "dY"}], " ", 
           RowBox[{"log", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "y"}], ")"}], "^", "a"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "y"}], ")"}], "^", "b"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"with", " ", "y"}], "=", 
           RowBox[{
            RowBox[{"-", "Y"}], "/", "r0"}]}]}], "*)"}], 
        RowBox[{
         RowBox[{"a", "/", 
          RowBox[{"(", 
           RowBox[{"r0val", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "y"}], ")"}]}], ")"}]}], "-", 
         RowBox[{"b", "/", 
          RowBox[{"(", 
           RowBox[{"r0val", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "y"}], ")"}]}], ")"}]}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dLogPoleWeightNum", "[", 
      RowBox[{"m_Integer", ",", "q_Integer", ",", 
       RowBox[{"Yval_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "a", ",", "b"}], "}"}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{
          RowBox[{"-", "Yval"}], "/", "r0val"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
