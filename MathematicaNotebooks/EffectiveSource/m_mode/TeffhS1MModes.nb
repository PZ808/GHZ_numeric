Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runPlus2ProjectionsForM", "[", 
    RowBox[{"m_Integer", ",", 
     RowBox[{"ellMax_Integer", ":", "15"}], ",", 
     RowBox[{"nY_Integer", ":", "128"}], ",", "patchAssoc_Association", ",", 
     "Tfun_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tasks", ",", "results"}], "}"}], ",", 
     RowBox[{
      RowBox[{"tasks", "=", 
       RowBox[{"makePlus2ProjectionTasksForM", "[", 
        RowBox[{
        "ellMax", ",", "m", ",", "nY", ",", "patchAssoc", ",", "Tfun"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<m = \>\"", ",", "m"}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Number of tasks: \>\"", ",", 
        RowBox[{"Length", "[", "tasks", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<ell range: \>\"", ",", 
        RowBox[{"ellListForM", "[", 
         RowBox[{
          RowBox[{"+", "2"}], ",", "ellMax", ",", "m"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<nY = \>\"", ",", "nY"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<radial grid sizes: \>\"", ",", 
        RowBox[{"Map", "[", 
         RowBox[{"Length", ",", "patchAssoc"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{
       "projectAtXFast", ",", "projectOnXGridFast", ",", 
        "runPlus2ProjectionTaskNoProjector"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{"runPlus2ProjectionTaskNoProjector", ",", "tasks", ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Association", "[", "results", "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.988386319422741*^9, 3.988386319424982*^9}},
 CellLabel->
  "In[1008]:=",ExpressionUUID->"d3d6385a-5364-425f-911f-66bf0c6fee29"],

