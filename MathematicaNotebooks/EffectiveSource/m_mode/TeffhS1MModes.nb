Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sphYDirect", "]"}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphYDirect", "[", 
     RowBox[{"s0_", ",", "ell0_", ",", "m0_", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", 
      RowBox[{"yCos_", "?", "NumericQ"}], ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ss", ",", "ll", ",", "mm", ",", "theta", ",", "gamma", ",", "val"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"ss", "=", 
        RowBox[{"exactIntLabel", "[", "s0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ll", "=", 
        RowBox[{"exactIntLabel", "[", "ell0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mm", "=", 
        RowBox[{"exactIntLabel", "[", "m0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{"IntegerQ", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Labels are not exact integers: \>\"", ",", 
            RowBox[{"InputForm", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"ll", ">=", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Abs", "[", "ss", "]"}], ",", 
              RowBox[{"Abs", "[", "mm", "]"}]}], "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Invalid SWSH labels: \>\"", ",", 
            RowBox[{"{", 
             RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"ArcCos", "[", "yCos", "]"}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gamma", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"aKerr", " ", "omega"}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"val", "=", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"ss", ",", "ll", ",", "mm", ",", "gamma"}], "]"}], "[", 
         RowBox[{"theta", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"NumericQ", "[", "val", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<SWSH did not evaluate numerically for labels: \>\"", ",", 
            RowBox[{"{", 
             RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Heads: \>\"", ",", 
            RowBox[{"Head", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<InputForm labels: \>\"", ",", 
            RowBox[{"InputForm", "/@", 
             RowBox[{"{", 
              RowBox[{"ss", ",", "ll", ",", "mm"}], "}"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<gamma = \>\"", ",", "gamma", ",", "\"\<, theta = \>\"", ",", 
            "theta"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"N", "[", 
        RowBox[{"val", ",", "prec"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildSphYTable", "[", 
     RowBox[{"s_", ",", "ell_", ",", "m_", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ss", ",", "ll", ",", "mm", ",", "vals"}], "}"}], ",", 
      RowBox[{
       RowBox[{"ss", "=", 
        RowBox[{"exactIntLabel", "[", "s", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ll", "=", 
        RowBox[{"exactIntLabel", "[", "ell", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mm", "=", 
        RowBox[{"exactIntLabel", "[", "m", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"sphYDirect", "[", 
           RowBox[{
           "ss", ",", "ll", ",", "mm", ",", "omega", ",", "y", ",", "prec"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"N", "[", 
             RowBox[{"yGrid", ",", "prec"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<s\>\"", "->", "ss"}], ",", 
         RowBox[{"\"\<ell\>\"", "->", "ll"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "mm"}], ",", 
         RowBox[{"\"\<omega\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"omega", ",", "prec"}], "]"}]}], ",", 
         RowBox[{"\"\<gamma\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"aKerr", " ", "omega"}], ",", "prec"}], "]"}]}], ",", 
         RowBox[{"\"\<aKerr\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"aKerr", ",", "prec"}], "]"}]}], ",", 
         RowBox[{"\"\<Precision\>\"", "->", "prec"}], ",", 
         RowBox[{"\"\<yGrid\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"yGrid", ",", "prec"}], "]"}]}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "vals"}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SphYTableCached", "[", 
     RowBox[{"s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "file", "}"}], ",", 
      RowBox[{
       RowBox[{"file", "=", 
        RowBox[{"sphTableFile", "[", 
         RowBox[{
         "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", "prec"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"getCached", "[", 
        RowBox[{"file", ",", 
         RowBox[{"buildSphYTable", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildSphBundleForM", "[", 
     RowBox[{"s_Integer", ",", "ellList_List", ",", "m_Integer", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
      RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
    RowBox[{"Association", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ell", "->", 
        RowBox[{
         RowBox[{"SphYTableCached", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}], "[", "\"\<Values\>\"", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ell", ",", "ellList"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"validSpheroidalPairs", "[", 
     RowBox[{"s0_", ",", "ellMax0_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "ellMax"}], "}"}], ",", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"exactIntLabel", "[", "s0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ellMax", "=", 
        RowBox[{"exactIntLabel", "[", "ellMax0", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"s", ",", "ell", ",", "m"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"ell", ",", 
               RowBox[{"Max", "[", 
                RowBox[{
                 RowBox[{"Abs", "[", "m", "]"}], ",", 
                 RowBox[{"Abs", "[", "s", "]"}]}], "]"}], ",", "ellMax"}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "ellMax"}], ",", "ellMax"}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prebuildSpheroidalTables", "[", 
    RowBox[{
    "sList_List", ",", "ellMax_Integer", ",", "omegaOfM_", ",", "yGrid_List", 
     ",", 
     RowBox[{"prec_Integer", ":", "WP"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "specs", "}"}], ",", 
     RowBox[{
      RowBox[{"specs", "=", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
