Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"BL", "->", 
    RowBox[{"mixed", " ", 
     RowBox[{"(", 
      RowBox[{"t", ",", "X", ",", "Y", ",", "phi"}], ")"}], " ", "Kinnersley",
      " ", "tetrad"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "rMix", ",", "zMix", ",", "sinThetaMix", ",", "SigmaMix", ",", 
      "DeltaMix", ",", "denMix", ",", "lVecMix", ",", "nVecMix", ",", 
      "mVecMix", ",", "mbVecMix"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rMix", ":=", 
     RowBox[{"r0val", "+", 
      RowBox[{"Bval", " ", "X"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zMix", ":=", 
     RowBox[{
      RowBox[{"-", "Y"}], "/", "r0val"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sinThetaMix", ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"zMix", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SigmaMix", ":=", 
     RowBox[{
      RowBox[{"rMix", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"spinval", "^", "2"}], " ", 
       RowBox[{"zMix", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DeltaMix", ":=", 
     RowBox[{
      RowBox[{"rMix", "^", "2"}], "-", 
      RowBox[{"2", " ", "massval", " ", "rMix"}], "+", 
      RowBox[{"spinval", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Standard", " ", "Kinnersley", " ", "m"}], "-", 
     RowBox[{"vector", " ", 
      RowBox[{"denominator", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"denMix", ":=", 
     RowBox[{"rMix", "+", 
      RowBox[{"I", " ", "spinval", " ", "zMix"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lVecMix", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<t\>\"", "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rMix", "^", "2"}], "+", 
           RowBox[{"spinval", "^", "2"}]}], ")"}], "/", "DeltaMix"}]}], ",", 
       RowBox[{"\"\<X\>\"", "->", 
        RowBox[{"1", "/", "Bval"}]}], ",", 
       RowBox[{"\"\<Y\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<phi\>\"", "->", 
        RowBox[{"spinval", "/", "DeltaMix"}]}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nVecMix", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<t\>\"", "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rMix", "^", "2"}], "+", 
           RowBox[{"spinval", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix"}], ")"}]}]}], ",", 
       RowBox[{"\"\<X\>\"", "->", 
        RowBox[{
         RowBox[{"-", "DeltaMix"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix", " ", "Bval"}], ")"}]}]}], ",", 
       RowBox[{"\"\<Y\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<phi\>\"", "->", 
        RowBox[{"spinval", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix"}], ")"}]}]}]}], "|>"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
