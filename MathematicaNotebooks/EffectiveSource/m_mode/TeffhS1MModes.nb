       RowBox[{"\"\<M1\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"nVecMix", ",", "m", ",", 
          RowBox[{
           RowBox[{"3", " ", "gammaNP"}], "-", "gammabNP", "+", 
           RowBox[{"4", " ", "muNP"}], "+", "mubNP"}]}], "]"}]}], ",", 
       RowBox[{"\"\<M2\>\"", "->", 
