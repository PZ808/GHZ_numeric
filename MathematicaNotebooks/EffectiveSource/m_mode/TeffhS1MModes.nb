Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TTeukMinus2PoleCleanTerms", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TTeukMinus2PoleCleanTerms", "[", 
    RowBox[{
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"Yval_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rawJets", ",", "hatJets", ",", "ops", ",", "t1", ",", "t2", ",", "t3", 
       ",", "t4"}], "}"}], ",", 
     RowBox[{
      RowBox[{"rawJets", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<nn\>\"", "->", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<nn\>\"", "]"}], ",", 
            "x", ",", "Yval"}], "]"}]}], ",", 
         RowBox[{"\"\<nmb\>\"", "->", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<nmb\>\"", "]"}], ",", 
            "x", ",", "Yval"}], "]"}]}], ",", 
         RowBox[{"\"\<mbmb\>\"", "->", 
          RowBox[{"evalCompiledJet2", "[", 
           RowBox[{
            RowBox[{"TeffMinus2JetCompiled", "[", "\"\<mbmb\>\"", "]"}], ",", 
            "x", ",", "Yval"}], "]"}]}]}], "|>"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hatJets", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<nn\>\"", "->", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", "0", ",", 
            RowBox[{"rawJets", "[", "\"\<nn\>\"", "]"}], ",", "Yval"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<nmb\>\"", "->", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "1"}], ",", 
            RowBox[{"rawJets", "[", "\"\<nmb\>\"", "]"}], ",", "Yval"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<mbmb\>\"", "->", 
          RowBox[{"hatJetFromRawJetNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", 
            RowBox[{"rawJets", "[", "\"\<mbmb\>\"", "]"}], ",", "Yval"}], 
           "]"}]}]}], "|>"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ops", "=", 
       RowBox[{"Association", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"key", ",", "op"}], "}"}], ",", 
            RowBox[{"key", "->", 
             RowBox[{"evalCompiledOp", "[", 
              RowBox[{"op", ",", "x", ",", "Yval"}], "]"}]}]}], "]"}], ",", 
          "Minus2ReducedOpsCompiled"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"t1", "=", 
       RowBox[{"applyTwoOpsToJet2Num", "[", 
        RowBox[{
         RowBox[{"ops", "[", "\"\<M1\>\"", "]"}], ",", 
         RowBox[{"ops", "[", "\"\<M2\>\"", "]"}], ",", 
         RowBox[{"hatJets", "[", "\"\<nmb\>\"", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"t2", "=", 
       RowBox[{"-", 
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M1\>\"", "]"}], ",", 
          RowBox[{"ops", "[", "\"\<M3\>\"", "]"}], ",", 
          RowBox[{"hatJets", "[", "\"\<mbmb\>\"", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"t3", "=", 
       RowBox[{"applyTwoOpsToJet2Num", "[", 
        RowBox[{
         RowBox[{"ops", "[", "\"\<M4\>\"", "]"}], ",", 
         RowBox[{"ops", "[", "\"\<M5\>\"", "]"}], ",", 
         RowBox[{"hatJets", "[", "\"\<nmb\>\"", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"t4", "=", 
       RowBox[{"-", 
        RowBox[{"applyTwoOpsToJet2Num", "[", 
         RowBox[{
          RowBox[{"ops", "[", "\"\<M4\>\"", "]"}], ",", 
          RowBox[{"ops", "[", "\"\<M6\>\"", "]"}], ",", 
          RowBox[{"hatJets", "[", "\"\<nn\>\"", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<M1M2_nmb\>\"", "->", 
         RowBox[{
          RowBox[{"poleWeightNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", "Yval"}], "]"}], " ", "t1"}]}], ",", 
        RowBox[{"\"\<-M1M3_mbmb\>\"", "->", 
         RowBox[{
          RowBox[{"poleWeightNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", "Yval"}], "]"}], " ", "t2"}]}], ",", 
        RowBox[{"\"\<M4M5_nmb\>\"", "->", 
         RowBox[{
          RowBox[{"poleWeightNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", "Yval"}], "]"}], " ", "t3"}]}], ",", 
        RowBox[{"\"\<-M4M6_nn\>\"", "->", 
         RowBox[{
          RowBox[{"poleWeightNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", "Yval"}], "]"}], " ", "t4"}]}], ",", 
        RowBox[{"\"\<Total\>\"", "->", 
         RowBox[{
          RowBox[{"poleWeightNum", "[", 
           RowBox[{"mUse", ",", 
            RowBox[{"-", "2"}], ",", "Yval"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"t1", "+", "t2", "+", "t3", "+", "t4"}], ")"}]}]}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Input",
