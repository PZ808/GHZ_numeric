       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "x", "]"}]}], ",", "w", ",", "D"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"w", "=", 
         RowBox[{"baryWeights1D", "[", "x", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"D", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", 
             RowBox[{"Nw", "@", "0"}], ",", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "-", 
                  RowBox[{"x", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}]}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"-", 
            RowBox[{"Total", "[", 
             RowBox[{"Delete", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "i"}], "]"}], "]"}]}]}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "D"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"If", " ", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "=", 
      RowBox[{"F", "[", 
       RowBox[{
        RowBox[{"XGrid", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"YGrid", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"then", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"dXGrid", "[", "DX_", "]"}], "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"DX", ".", "M"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"dYGrid", "[", "DY_", "]"}], "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"M", ".", 
      RowBox[{"Transpose", "[", "DY", "]"}]}]}], ";"}]}]}]], "Input",
