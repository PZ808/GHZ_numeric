        ";", "\[IndentingNewLine]", 
       RowBox[{"X", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"left", "[", "\"\<X\>\"", "]"}], ",", 
          RowBox[{"right", "[", "\"\<X\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"left", "[", "\"\<Values\>\"", "]"}], ",", 
          RowBox[{"right", "[", "\"\<Values\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", "X", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<X\>\"", "->", 
          RowBox[{"X", "[", 
           RowBox[{"[", "order", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Values\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "order", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<ReData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Re", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
         ",", 
         RowBox[{"\"\<ImData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Im", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
         ",", 
         RowBox[{"\"\<AbsData\>\"", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"X", "[", 
              RowBox[{"[", "order", "]"}], "]"}], ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "order", "]"}], "]"}], "]"}]}], "}"}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotProjectedMode", "[", 
    RowBox[{"res_Association", ",", "s_Integer", ",", "ell_Integer"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "data", "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"getJoinedProjData", "[", 
        RowBox[{"res", ",", "s", ",", "ell"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "[", "\"\<ReData\>\"", "]"}], ",", 
          RowBox[{"data", "[", "\"\<ImData\>\"", "]"}], ",", 
          RowBox[{"data", "[", "\"\<AbsData\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
             "\"\<TTeuk, s = \>\"", ",", "s", ",", "\"\<, ell = \>\"", ",", 
              "ell", ",", "\"\<, m = \>\"", ",", "mUse"}], "}"}], "]"}]}], 
          "}"}]}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
