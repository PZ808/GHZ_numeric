   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "gridMaxAbs", ",", "splitGridAt", ",", "makePatch", ",", 
      "sampleComponentGrid", ",", "makeComplexTensorInterpolant"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gridMaxAbs", "[", "M_", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Flatten", "[", "M", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"splitGridAt", "[", 
      RowBox[{"XGrid_List", ",", 
       RowBox[{"x0_", ":", 
        RowBox[{"N64", "@", "0"}]}], ",", 
       RowBox[{"gap_", ":", 
        RowBox[{"N64", "@", "0"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xLeft", ",", "xRight"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xLeft", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"XGrid", ",", 
           RowBox[{
            RowBox[{"#", "<", 
             RowBox[{"x0", "-", "gap"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xRight", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"XGrid", ",", 
           RowBox[{
            RowBox[{"#", ">", 
             RowBox[{"x0", "+", "gap"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<Left\>\"", "->", "xLeft"}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Right\>\"", "->", "xRight"}]}], "\[IndentingNewLine]", 
         "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makePatch", "[", 
      RowBox[{"name_String", ",", "XGrid_List", ",", "YGrid_List"}], "]"}], ":=",
      "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<Name\>\"", "->", "name"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<XGrid\>\"", "->", "XGrid"}], ",", 
       RowBox[{"\"\<YGrid\>\"", "->", "YGrid"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<XMin\>\"", "->", 
        RowBox[{"Min", "[", "XGrid", "]"}]}], ",", 
       RowBox[{"\"\<XMax\>\"", "->", 
        RowBox[{"Max", "[", "XGrid", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<YMin\>\"", "->", 
        RowBox[{"Min", "[", "YGrid", "]"}]}], ",", 
       RowBox[{"\"\<YMax\>\"", "->", 
        RowBox[{"Max", "[", "YGrid", "]"}]}]}], "\[IndentingNewLine]", 
      "|>"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sampleComponentGrid", "[", 
      RowBox[{"f_", ",", "XGrid_List", ",", "YGrid_List"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"X", ",", "Y"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"X", ",", "XGrid"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Y", ",", "YGrid"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "monitoredSampleComponentGrid", "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"monitoredSampleComponentGrid", "[", 
      RowBox[{"f_", ",", "XGrid_List", ",", "YGrid_List", ",", 
       RowBox[{"label_", ":", "\"\<Sampling grid\>\""}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"total", ",", 
         RowBox[{"k", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"total", "=", 
         RowBox[{
          RowBox[{"Length", "[", "XGrid", "]"}], " ", 
          RowBox[{"Length", "[", "YGrid", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"f", "[", 
              RowBox[{"X", ",", "Y"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"X", ",", "XGrid"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Y", ",", "YGrid"}], "}"}]}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"label", ",", "\"\<: \>\"", ",", "\[IndentingNewLine]", 
                RowBox[{"Dynamic", "[", "k", "]"}], ",", "\"\</\>\"", ",", 
                "total"}], "}"}], "]"}], ",", 
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "k", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "total"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
