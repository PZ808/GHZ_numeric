 RowBox[{
  RowBox[{
   RowBox[{"maxErrorLocation", "[", 
    RowBox[{"v1_List", ",", "v2_List", ",", "XGrid_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"err", ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"err", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"v2", "-", "v1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{"err", ",", 
          RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Index\>\"", "->", "k"}], ",", 
        RowBox[{"\"\<X\>\"", "->", 
         RowBox[{"XGrid", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v1\>\"", "->", 
         RowBox[{"v1", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v2\>\"", "->", 
         RowBox[{"v2", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<AbsError\>\"", "->", 
         RowBox[{"err", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<RelError\>\"", "->", 
         RowBox[{
          RowBox[{"err", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"v2", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], ",", 
            RowBox[{"10", "^", 
