 RowBox[{
  RowBox[{
   RowBox[{"applyTwoOpsToJet2", "[", 
    RowBox[{
    "outer_Association", ",", "inner_Association", ",", "jet_Association"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", "gX", ",", "gY"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"g", "=", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"inner", "[", "\"\<AX\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<X\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<AY\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<Y\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<A0\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<F\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gX", "=", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"inner", "[", "\"\<AX\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<XX\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<AY\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<XY\>\"", "]"}]}], "\[IndentingNewLine]", 
        "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"inner", "[", "\"\<AX_X\>\"", "]"}], "+", 
           RowBox[{"inner", "[", "\"\<A0\>\"", "]"}]}], ")"}], " ", 
         RowBox[{"jet", "[", "\"\<X\>\"", "]"}]}], "\[IndentingNewLine]", "+", 
        RowBox[{
         RowBox[{"inner", "[", "\"\<AY_X\>\"", "]"}], " ", 
