      "\[IndentingNewLine]", 
      RowBox[{"LY", "=", 
       RowBox[{"d2LogPoleWeightNum", "[", 
        RowBox[{"m", ",", "q", ",", "Yval"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<F\>\"", "->", 
         RowBox[{
          RowBox[{"raw", "[", "\"\<F\>\"", "]"}], "/", "W"}]}], ",", 
        RowBox[{"\"\<X\>\"", "->", 
         RowBox[{
          RowBox[{"raw", "[", "\"\<X\>\"", "]"}], "/", "W"}]}], ",", 
