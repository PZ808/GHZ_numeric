Cell[CellGroupData[{

Cell["Define projection utilities ", "Subsection",
 CellChangeTimes->{{3.988121217341893*^9, 
  3.9881212236023912`*^9}},ExpressionUUID->"1c1f178c-cb67-4f9b-87c2-\
4c53995b9583"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"YofYCos", ",", "makeAngularProjector"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"YofYCos", "[", 
     RowBox[{"y_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Nw", "@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "r0val"}], " ", "y"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makeAngularProjector", "[", 
    RowBox[{"s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", 
     RowBox[{"nY_Integer", ":", "96"}], ",", 
     RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "omega", ",", "rule", ",", "yGrid", ",", "YGrid", ",", "weights", ",", 
       "sphVals", ",", "projector"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"omega", "=", 
       RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rule", "=", 
       RowBox[{"makeGaussLegendreRule", "[", 
        RowBox[{"nY", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yGrid", "=", 
       RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"weights", "=", 
       RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"YGrid", "=", 
       RowBox[{"YofYCos", "/@", "yGrid"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sphVals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SsphY", "[", 
           RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", "y",
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"projector", "=", 
       RowBox[{"2", " ", "Pi", " ", "weights", " ", 
        RowBox[{"Conjugate", "[", "sphVals", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<s\>\"", "->", "s"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<omega\>\"", "->", "omega"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"\"\<yGrid\>\"", "->", "yGrid"}], ",", 
        RowBox[{"\"\<YGrid\>\"", "->", "YGrid"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"\"\<Weights\>\"", "->", "weights"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<SpheroidalValues\>\"", "->", "sphVals"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Projector\>\"", "->", "projector"}]}], 
       "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.988164656438118*^9, 3.988164656440673*^9}, {
  3.988164715155017*^9, 3.988164744689356*^9}},
 CellLabel->
  "In[563]:=",ExpressionUUID->"e7acb5d6-95e5-44ff-bfb1-29a9de532625"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"projectTeukSourceAtXGL", ",", "projectTeukSourceOnXGridGL"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"projectTeukSourceAtXGL", "[", 
      RowBox[{"Tfun_", ",", "projector_Association"}], "]"}], "[", 
     RowBox[{"Xval_", "?", "NumericQ"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"yGrid", ",", "projWeights", ",", "vals"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"yGrid", "=", 
        RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"projWeights", "=", 
        RowBox[{"projector", "[", "\"\<Projector\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Tfun", "[", 
           RowBox[{"Xval", ",", "y"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"y", ",", "yGrid"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", "\[IndentingNewLine]", 
        RowBox[{
