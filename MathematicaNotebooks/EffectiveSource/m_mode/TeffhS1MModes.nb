Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Spin", " ", "weights", " ", "of", " ", "tetrad", " ", "stress"}],
     "-", 
    RowBox[{"energy", " ", "components"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "componentSpinWeight", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"componentSpinWeight", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ll\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<ln\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<lm\>\"", "->", 
        RowBox[{"+", "1"}]}], ",", 
       RowBox[{"\"\<lmb\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"\"\<nn\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<nm\>\"", "->", 
        RowBox[{"+", "1"}]}], ",", 
       RowBox[{"\"\<nmb\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"\"\<mm\>\"", "->", 
        RowBox[{"+", "2"}]}], ",", 
       RowBox[{"\"\<mmb\>\"", "->", "0"}], ",", 
