Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"yOfYCoord", ",", "YofYCos", ",", "thetaOfYCos"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yOfYCoord", "[", 
    RowBox[{"Yval_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Nw", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "Yval"}], "/", "r0val"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"YofYCos", "[", 
    RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Nw", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "r0val"}], " ", "yCos"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaOfYCos", "[", 
    RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"ArcCos", "[", "yCos", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988163881125885*^9, 3.988163881128389*^9}, {
  3.988170938835702*^9, 
  3.988170941551985*^9}},ExpressionUUID->"30c5d45f-cbd2-41c9-9cd2-\
c620b7aff2cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Def Spheroidal harmonics ", "Subsection",
 CellChangeTimes->{{3.9881709613997993`*^9, 3.9881709639123373`*^9}, {
  3.988171071769041*^9, 
  3.988171073035862*^9}},ExpressionUUID->"05022118-604c-4bb2-8663-\
a0e474d462c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"c", "=", 
    RowBox[{"a", " ", "omega"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"SsphThetaPhi", ",", "SsphY"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SsphThetaPhi", "[", 
       RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
      RowBox[{
       RowBox[{"theta_", "?", "NumericQ"}], ",", 
       RowBox[{"phi_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "gamma", "}"}], ",", 
       RowBox[{
        RowBox[{"gamma", "=", 
         RowBox[{"spinval", " ", "omega"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"s", ",", "ell", ",", "m", ",", "gamma"}], "]"}], "[", 
         RowBox[{"theta", ",", "phi"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SsphY", "[", 
       RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
      RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "theta", "}"}], ",", 
       RowBox[{
        RowBox[{"theta", "=", 
         RowBox[{"ArcCos", "[", "yCos", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SsphThetaPhi", "[", 
          RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", 
         RowBox[{"theta", ",", 
          RowBox[{"Nw", "@", "0"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.988108335681973*^9, 3.9881083527142973`*^9}, {
   3.988108394048862*^9, 3.988108444514615*^9}, {3.988108494455317*^9, 
