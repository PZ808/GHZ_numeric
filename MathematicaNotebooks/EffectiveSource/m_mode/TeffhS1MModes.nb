    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Yin", ",", "_Real"}], "}"}]}], "}"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"N", "[", "expr", "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"X", "->", "x"}], ",", 
          RowBox[{"Y", "->", "Yin"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
      RowBox[{"CompilationOptions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
