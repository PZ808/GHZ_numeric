  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"compileXYExpr", "[", "expr_", "]"}], ":=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Yin", ",", "_Real"}], "}"}]}], "}"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"N15", "[", "expr", "]"}], "/.", "tovals"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"X", "->", "x"}], ",", 
          RowBox[{"Y", "->", "Yin"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
      RowBox[{"CompilationOptions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ExpressionOptimization\>\"", "->", "True"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
