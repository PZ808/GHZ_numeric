  3.988171536136841*^9}},ExpressionUUID->"9857b0f0-f294-452f-9366-\
9684893ee522"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Serial", " ", "convergence", " ", "check", " ", "in", " ", "angular", 
     " ", "Gauss"}], "-", 
    RowBox[{"Legendre", " ", "order", " ", "nY"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "maxAbsNorm", ",", "convergencePairErrors", ",", 
      "runAngularProjectionConvergence"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"maxAbsNorm", "[", "v_List", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "v", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"convergencePairErrors", "[", "vals_List", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pairs", ",", "diffs", ",", "rels"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pairs", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"vals", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"diffs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"#2", "-", "#1"}], "]"}], "]"}], "&"}], "@@@", 
          "pairs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rels", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"diffs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"maxAbsNorm", "[", 
               RowBox[{"pairs", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "30"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"diffs", ",", "rels"}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"runAngularProjectionConvergence", "[", 
      RowBox[{
      "Tfun_", ",", "s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", 
       "XGrid_List", ",", "nYList_List"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"valsByNY", ",", "valsList", ",", "errList"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"valsByNY", "=", 
         RowBox[{"Association", "@", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"nY", "->", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", "proj", "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"proj", "=", 
                 RowBox[{"makeAngularProjector", "[", 
                  RowBox[{"s", ",", "ell", ",", "m", ",", "nY"}], "]"}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"projectTeukSourceOnXGridGL", "[", 
                 RowBox[{"Tfun", ",", "XGrid", ",", "proj"}], "]"}]}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"nY", ",", "nYList"}], "}"}]}], "\[IndentingNewLine]", 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"valsList", "=", 
         RowBox[{"valsByNY", "/@", "nYList"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"errList", "=", 
         RowBox[{"convergencePairErrors", "[", "valsList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<nYList\>\"", "->", "nYList"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<ValuesByNY\>\"", "->", "valsByNY"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<PairwiseErrors\>\"", "->", 
           RowBox[{"Association", "@", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"nYList", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"nYList", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}], "->", 
               "\[IndentingNewLine]", 
               RowBox[{"<|", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"\"\<MaxAbsDifference\>\"", "->", 
                  RowBox[{"errList", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "1"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<RelativeMaxDifference\>\"", "->", 
                  RowBox[{"errList", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "2"}], "]"}], "]"}]}]}], 
                "\[IndentingNewLine]", "|>"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "nYList", "]"}], "-", "1"}]}], 
               "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988127438725542*^9, 3.9881275017705917`*^9}, {
  3.988165416381915*^9, 3.988165520058576*^9}},
 CellLabel->
  "In[606]:=",ExpressionUUID->"7f7a767a-f0fa-4038-a19b-be8ef73e86bf"]
}, Open  ]],

