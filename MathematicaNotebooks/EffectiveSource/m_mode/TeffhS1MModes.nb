Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "runPlus2ProjectionTaskNoProjector", "[", "task_Association", "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ell", ",", "m", ",", "nY", ",", "patchName", ",", "XGrid", ",", 
       "projector", ",", "Tfun", ",", "timing", ",", "vals"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ell", "=", 
       RowBox[{"task", "[", "\"\<ell\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"task", "[", "\"\<m\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"nY", "=", 
       RowBox[{"task", "[", "\"\<nY\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"patchName", "=", 
       RowBox[{"task", "[", "\"\<Patch\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"XGrid", "=", 
       RowBox[{"task", "[", "\"\<XGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"projector", "=", 
       RowBox[{"task", "[", "\"\<Projector\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Tfun", "=", 
       RowBox[{"task", "[", "\"\<Tfun\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"timing", "=", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{
         RowBox[{"vals", "=", 
          RowBox[{"projectOnXGridFast", "[", 
           RowBox[{"Tfun", ",", "projector", ",", "XGrid"}], "]"}]}], ";"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"+", "2"}], ",", "m", ",", "ell", ",", "patchName"}], "}"}], 
       "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<s\>\"", "->", 
          RowBox[{"+", "2"}]}], ",", 
         RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<Patch\>\"", "->", "patchName"}], ",", 
         RowBox[{"\"\<nY\>\"", "->", "nY"}], ",", 
         RowBox[{"\"\<XGrid\>\"", "->", "XGrid"}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "vals"}], ",", 
         RowBox[{"\"\<TimeSeconds\>\"", "->", 
          RowBox[{"timing", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{
         "\"\<SourceBuild\>\"", "->", 
          "\"\<windowed-at-perturbation-level\>\""}]}], "|>"}]}]}]}], "]"}]}],
