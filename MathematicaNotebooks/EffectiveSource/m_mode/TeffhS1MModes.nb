Cell["Pole reduced form  ", "Subsection",
 CellChangeTimes->{{3.9881691179647017`*^9, 
  3.988169124202743*^9}},ExpressionUUID->"3f92ea5d-344f-4898-b7e5-\
625680f567bf"],

Cell[TextData[{
 "We write the stress energy in pole factorized form :\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["", "s"], 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["T", 
       RowBox[{"m", ",", "\[Omega]"}]], "ab"], "(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "539d191d-f27b-4bbd-b032-e7df385a2127"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["w", 
      RowBox[{"m", ",", "s"}]], "(", 
     RowBox[{"Y", "(", "y", ")"}], ")"}], 
    SubscriptBox[
     OverscriptBox[
      RowBox[{
       SubscriptBox[" ", "s"], 
       SuperscriptBox["T", 
        RowBox[{"m", ",", "\[Omega]"}]]}], "^"], "ab"], 
    RowBox[{"(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6f20c37-ddce-49fb-90d6-37a00e251ecc"],
 "\nwhere the \n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["w", 
     RowBox[{"m", ",", "s"}]], 
    RowBox[{"(", "y", ")"}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "y"}], ")"}], 
     SubscriptBox["\[Alpha]", 
      RowBox[{"m", ",", "s"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "y"}], ")"}], 
     SubscriptBox["\[Beta]", 
      RowBox[{"m", ",", "s"}]]]}]}]],ExpressionUUID->
  "67b716c9-e38f-40b2-a651-fb1d35c962db"],
 ".\nThe power exponents are given by \[Alpha]=|m+s|/2 and \[Beta]=|m-s|/2"
}], "Text",
 CellChangeTimes->{{3.988169129866596*^9, 
  3.988169418287292*^9}},ExpressionUUID->"4dc4f224-76d6-4f19-9c6c-\
64fb6782f6e5"],

