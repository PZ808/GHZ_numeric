Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runProjectionTasksParallelMonitored", "[", 
    RowBox[{
    "sList_List", ",", "ellList_List", ",", "m_Integer", ",", 
     "patchAssoc_Association", ",", 
     RowBox[{"nZ_Integer", ":", "96"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tasks", ",", "submitted", ",", "results"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tasks", "=", 
       RowBox[{"makeProjectionTasks", "[", 
        RowBox[{
        "sList", ",", "ellList", ",", "m", ",", "patchAssoc", ",", "nZ"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"submitted", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"ParallelSubmit", "[", 
          RowBox[{"projectOneSpinEllPatch", "@@", "task"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"task", ",", "tasks"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"results", "=", 
         RowBox[{"WaitAll", "[", "submitted", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Finished \>\"", ",", 
           RowBox[{"Count", "[", 
            RowBox[{"submitted", ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "\"\<State\>\"", "]"}], "===", 
                 "\"\<Finished\>\""}], "&"}], ")"}]}]}], "]"}], ",", 
           "\"\< / \>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"Length", "[", "submitted", "]"}]}], "}"}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Association", "[", "results", "]"}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]], "Input",
