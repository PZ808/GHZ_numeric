 RowBox[{
  RowBox[{
   RowBox[{"projMinus2", "=", 
    RowBox[{"makeAngularProjector", "[", 
     RowBox[{
      RowBox[{"-", "2"}], ",", "ellUse", ",", "mUse", ",", "96"}], "]"}]}], 
