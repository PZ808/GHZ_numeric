          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ZOnYGrid\>\"", "->", 
         RowBox[{"yzPairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<ThetaOnYGrid\>\"", "->", 
         RowBox[{"yzPairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], "\[IndentingNewLine]",
        "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
