Cell[CellGroupData[{

Cell["Gauss-Legendre integration ", "Section",
 CellChangeTimes->{{3.9881709757139893`*^9, 3.9881709873134212`*^9}, {
  3.988171088516879*^9, 
  3.988171094069762*^9}},ExpressionUUID->"644b452e-fbde-4eda-b311-\
f5d928da44e5"],

Cell[CellGroupData[{

Cell["Import NumericalDifferentialEquationAnalysis  routine", "Subsection",
 CellChangeTimes->{{3.9881711840906143`*^9, 
  3.988171195727982*^9}},ExpressionUUID->"bf371721-c348-446a-b455-\
89da8f399805"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gauss", "-", 
    RowBox[{
    "Legendre", " ", "orthogonality", " ", "check", " ", "for", " ", "SWSH", 
     " ", "spheroidal", " ", "modes"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "makeGaussLegendreRule", ",", "sphValsOnRule", ",", 
      "sphOrthogonalityMatrix", ",", "sphOrthogonalityCheck"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeGaussLegendreRule", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "gw", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gw", "=", 
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"n", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<yGrid\>\"", "->", 
           RowBox[{"Nw", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Weights\>\"", "->", 
           RowBox[{"Nw", "/@", 
            RowBox[{"gw", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], 
         "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sphValsOnRule", "[", 
      RowBox[{
      "s_", ",", "m_", ",", "omega_", ",", "ellList_List", ",", 
       "rule_Association"}], "]"}], ":=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ell", "->", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SsphY", "[", 
             RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", 
            "y", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}], "}"}]}], "]"}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"ell", ",", "ellList"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.988095590632613*^9, 3.988095598662437*^9}, {
   3.988112030826337*^9, 3.988112031274457*^9}, {3.9881121053722143`*^9, 
   3.9881121123708*^9}, {3.988112353231997*^9, 3.988112381780282*^9}, {
   3.988112486247364*^9, 3.988112559469138*^9}, {3.988112671419245*^9, 
   3.988112676206932*^9}, 3.988113713152042*^9, {3.988115766278157*^9, 
   3.988115766403143*^9}, {3.988119223593833*^9, 3.988119225175625*^9}, {
   3.988119316088035*^9, 3.988119450211658*^9}, {3.9881639557465887`*^9, 
   3.988164068499248*^9}, 3.988164342662013*^9, {3.9881643807876368`*^9, 
   3.988164417849749*^9}, {3.988164468695118*^9, 3.988164469279333*^9}, {
   3.988164510848134*^9, 3.988164528045578*^9}, {3.988171118430497*^9, 
   3.988171170561164*^9}},ExpressionUUID->"0a0e6dbe-3f5d-4df0-a5c0-\
5a6de9988f36"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Check orthogonality ", "Subsection",
 CellChangeTimes->{{3.9881090235273657`*^9, 3.9881090306421967`*^9}, 
   3.988111897252491*^9, 3.988112227558137*^9, {3.988119243401106*^9, 
   3.9881192489637423`*^9}, {3.988171206781869*^9, 
   3.988171207564926*^9}},ExpressionUUID->"85468e6b-0206-4157-866d-\
50df5452041a"],

Cell[CellGroupData[{

Cell["utils ", "Subsubsection",
 CellChangeTimes->{{3.988171224276329*^9, 
  3.98817122500333*^9}},ExpressionUUID->"869fa308-6683-4236-a799-\
03f980b933b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphOrthogonalityMatrix", "[", 
     RowBox[{"s_Integer", ",", "m_Integer", ",", 
      RowBox[{"omega_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
      "ellList_List", ",", 
      RowBox[{"nY_Integer", ":", "128"}], ",", 
      RowBox[{"wp_", ":", "MachinePrecision"}], ",", 
      RowBox[{"phiFactor_", ":", 
       RowBox[{"2", " ", "Pi"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rule", ",", "weights", ",", "vals", ",", "mat"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rule", "=", 
        RowBox[{"makeGaussLegendreRule", "[", 
         RowBox[{"nY", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"sphValsOnRule", "[", 
         RowBox[{"s", ",", "m", ",", "omega", ",", "ellList", ",", "rule"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mat", "=", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"phiFactor", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"weights", " ", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"vals", "[", "ell1", "]"}], "]"}], " ", 
             RowBox[{"vals", "[", "ell2", "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ell1", ",", "ellList"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ell2", ",", "ellList"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}], ";", "\[IndentingNewLine]", "mat"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphOrthogonalityCheck", "[", 
    RowBox[{"s_Integer", ",", "m_Integer", ",", 
     RowBox[{"omega_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
     "ellList_List", ",", 
     RowBox[{"nY_Integer", ":", "128"}], ",", 
     RowBox[{"wp_", ":", "MachinePrecision"}], ",", 
     RowBox[{"phiFactor_", ":", 
      RowBox[{"2", " ", "Pi"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mat", ",", "id", ",", "err", ",", "offDiag"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"sphOrthogonalityMatrix", "[", 
        RowBox[{
        "s", ",", "m", ",", "omega", ",", "ellList", ",", "nY", ",", "wp", 
         ",", "phiFactor"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "ellList", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"err", "=", 
       RowBox[{"mat", "-", "id"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"offDiag", "=", 
       RowBox[{"err", "-", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "err", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Matrix\>\"", "->", "mat"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<ErrorMatrix\>\"", "->", "err"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MaxAbsError\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "err", "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MaxAbsDiagonalError\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Diagonal", "[", "err", "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<MaxAbsOffDiagonal\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "offDiag", "]"}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9881194888744097`*^9, 3.988119510364171*^9}, {
  3.988164164424901*^9, 3.988164194941556*^9}},
 CellLabel->
  "In[489]:=",ExpressionUUID->"275fe363-33c0-4ebd-a34b-b89c49de3587"]
}, Open  ]],

Cell[CellGroupData[{

Cell["perform check", "Subsubsection",
 CellChangeTimes->{{3.98817122989958*^9, 
  3.9881712315165873`*^9}},ExpressionUUID->"d2c0b588-cae7-4e9d-b48d-\
2fe54c6203b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"check", " ", "orthogonality"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"omegaUse", "=", 
     RowBox[{"mUse", " ", "\[CapitalOmega]0val"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"\[Omega]", " ", "=", " ", 
     RowBox[{"m", " ", 
      SubscriptBox["\[CapitalOmega]", "0"]}]}], " ", "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ellMinMinus2", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"-", "2"}], "]"}], ",", 
       RowBox[{"Abs", "[", "mUse", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ellListMinus2", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"ellMinMinus2", ",", 
       RowBox[{"ellMinMinus2", "+", "6"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"checkMinus2", "=", 
     RowBox[{"sphOrthogonalityCheck", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "mUse", ",", "omegaUse", ",", "ellListMinus2",
        ",", "128"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"checkMinus2", "[", "\"\<Matrix\>\"", "]"}], "//", "MatrixForm"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"checkMinus2", "[", "\"\<MaxAbsError\>\"", "]"}], ",", 
     RowBox[{"checkMinus2", "[", "\"\<MaxAbsDiagonalError\>\"", "]"}], ",", 
     RowBox[{"checkMinus2", "[", "\"\<MaxAbsOffDiagonal\>\"", "]"}]}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.988112616270726*^9, 3.988112639770772*^9}, {
  3.9881194641401663`*^9, 3.988119474146474*^9}},
 CellLabel->
