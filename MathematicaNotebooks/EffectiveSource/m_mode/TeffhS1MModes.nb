      RowBox[{"|", 
       RowBox[{"m", "+", "s"}], "|", 
       RowBox[{"/", "2"}]}]], " ", 
     SubscriptBox["", "s"], 
     OverscriptBox["T", "^"]}]}], TraditionalForm]],
