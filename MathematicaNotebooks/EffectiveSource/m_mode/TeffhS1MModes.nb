Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Fast", " ", "projection", " ", "using", " ", "precomputed", " ", 
    "projector"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"projectAtXFast", ",", "projectOnXGridFast"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"projectAtXFast", "[", 
      RowBox[{"Tfun_", ",", "projector_Association", ",", 
       RowBox[{"Xval_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"YGrid", ",", "projWeights", ",", "vals"}], "}"}], ",", 
       RowBox[{
        RowBox[{"YGrid", "=", 
         RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"projWeights", "=", 
         RowBox[{"projector", "[", "\"\<Projector\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Tfun", "[", 
            RowBox[{"Xval", ",", 
             RowBox[{"YGrid", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "YGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"vals", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Non-numeric values at X = \>\"", ",", "Xval"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Short", "[", 
             RowBox[{"vals", ",", "3"}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Total", "[", 
         RowBox[{"projWeights", " ", "vals"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"projectOnXGridFast", "[", 
      RowBox[{"Tfun_", ",", "projector_Association", ",", "XGrid_List"}], 
      "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"projectAtXFast", "[", 
        RowBox[{"Tfun", ",", "projector", ",", "X"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"X", ",", "XGrid"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988215828818741*^9, 
  3.9882158475165367`*^9}},ExpressionUUID->"f964b672-293b-44a9-bf0e-\
2ea40bb88875"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Build", "+", 
    RowBox[{
    "2", " ", "tasks", " ", "with", " ", "projectors", " ", "precomputed", 
     " ", "on", " ", "master", " ", "kernel"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "makePlus2ProjectionTasksMain", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makePlus2ProjectionTasksMain", "[", 
      RowBox[{
      "ellMax_Integer", ",", "m_Integer", ",", "nY_Integer", ",", 
       "patchAssoc_Association"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ellMin", ",", "ellList", ",", "projectors", ",", "tasks"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"ellMin", "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "m", "]"}], ",", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ellList", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"ellMin", ",", "ellMax"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<Building projectors on master kernel...\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"projectors", "=", 
         RowBox[{"Association", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ell", "->", 
             RowBox[{"makeAngularProjector", "[", 
              RowBox[{
               RowBox[{"+", "2"}], ",", "ell", ",", "m", ",", "nY"}], "]"}]}],
             ",", 
            RowBox[{"{", 
             RowBox[{"ell", ",", "ellList"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tasks", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<s\>\"", "->", 
                RowBox[{"+", "2"}]}], ",", 
               RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
               RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
               RowBox[{"\"\<nY\>\"", "->", "nY"}], ",", 
               RowBox[{"\"\<Patch\>\"", "->", "patchName"}], ",", 
               RowBox[{"\"\<XGrid\>\"", "->", 
                RowBox[{"patchAssoc", "[", "patchName", "]"}]}], ",", 
               RowBox[{"\"\<Projector\>\"", "->", 
                RowBox[{"projectors", "[", "ell", "]"}]}]}], "|>"}], ",", 
             RowBox[{"{", 
              RowBox[{"ell", ",", "ellList"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"patchName", ",", 
               RowBox[{"Keys", "[", "patchAssoc", "]"}]}], "}"}]}], "]"}], 
           ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", "tasks"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
