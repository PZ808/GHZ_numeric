   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"projectTeff$mMode$y", "[", 
      RowBox[{"s_", ",", "l_", ",", "m_"}], "]"}], "[", "TeffHead_", "]"}], 
