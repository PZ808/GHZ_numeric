            RowBox[{"validSpheroidalPairs", "[", 
             RowBox[{"s", ",", "ellMax"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "sList"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"spec", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "}"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s", ",", "ell", ",", "m"}], "}"}], "=", "spec"}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"omega", "=", 
              RowBox[{"omegaOfM", "[", "m", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"SphYTableCached", "[", 
              RowBox[{
              "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
               "prec"}], "]"}]}]}], "]"}]}], "]"}], ",", "specs"}], "]"}]}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
