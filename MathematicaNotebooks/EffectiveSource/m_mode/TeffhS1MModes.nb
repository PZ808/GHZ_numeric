      "\[IndentingNewLine]", 
      RowBox[{"projector", "=", 
       RowBox[{"2", " ", "Pi", " ", "weights", " ", 
        RowBox[{"Conjugate", "[", "sphVals", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<s\>\"", "->", "s"}], ",", 
