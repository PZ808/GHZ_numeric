Cell[CellGroupData[{

Cell["Create block of indices", "Subsection",
 CellChangeTimes->{{3.988304179594708*^9, 
  3.9883041973406677`*^9}},ExpressionUUID->"7baac731-8dbf-4ac7-bf13-\
01f57c152fe8"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", " ", 
     RowBox[{
     "ellListForM", ",", "mListForEllMax", ",", " ", "validSpheroidalPairs", 
      ",", "mList", ",", "validPairsPlus2", ",", "validPairsMinus2"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"omegaOfM", ",", "yCosGrid"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ellListForM", "[", 
      RowBox[{"s_Integer", ",", "ellMax_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "m", "]"}], ",", 
         RowBox[{"Abs", "[", "s", "]"}]}], "]"}], ",", "ellMax"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mListForEllMax", "[", "ellMax_Integer", "]"}], ":=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "ellMax"}], ",", "ellMax"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mList", "=", 
     RowBox[{"mListForEllMax", "[", "ellMax", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"validPairsPlus2", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ell", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", 
             RowBox[{"ellListForM", "[", 
              RowBox[{"2", ",", "ellMax", ",", "m"}], "]"}]}], "}"}]}], "]"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validPairsMinus2", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ell", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", 
             RowBox[{"ellListForM", "[", 
              RowBox[{"2", ",", "ellMax", ",", "m"}], "]"}]}], "}"}]}], "]"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"omegaOfM", "[", "m_Integer", "]"}], ":=", 
     RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yCosGrid", "=", 
     RowBox[{"N64", "[", 
      RowBox[{
       RowBox[{"-", "YGrid"}], "/", "r0val"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yCosGridSph", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"YGrid", ",", "80"}], "]"}]}], "/", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"r0val", ",", "80"}], "]"}]}], ",", "80"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[794]:=",ExpressionUUID->"f3db8c1e-e9ed-47d2-9b67-c034aabb4aee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Import NumericalDifferentialEquationAnalysis (centered)  GL routine\
\>", "Subsection",
 CellChangeTimes->{{3.9881711840906143`*^9, 3.988171195727982*^9}, {
  3.988304203667499*^9, 
  3.988304226422226*^9}},ExpressionUUID->"bf371721-c348-446a-b455-\
89da8f399805"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gauss", "-", 
    RowBox[{
    "Legendre", " ", "orthogonality", " ", "check", " ", "for", " ", "SWSH", 
     " ", "spheroidal", " ", "modes"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "makeGaussLegendreRule", ",", "sphValsOnRule", ",", 
      "sphOrthogonalityMatrix", ",", "sphOrthogonalityCheck"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeGaussLegendreRule", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"wp_", ":", "MP"}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "gw", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gw", "=", 
         RowBox[{"GaussianQuadratureWeights", "[", 
          RowBox[{"n", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "wp"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
