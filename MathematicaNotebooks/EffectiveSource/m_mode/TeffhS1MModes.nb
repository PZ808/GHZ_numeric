Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"makeGaussLegendreRuleCut", ",", "makeAngularProjectorCut"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeGaussLegendreRuleCut", "[", 
     RowBox[{"n_Integer", ",", "ycut_", ",", 
      RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "gw", "}"}], ",", 
      RowBox[{
       RowBox[{"gw", "=", 
        RowBox[{"GaussianQuadratureWeights", "[", 
         RowBox[{"n", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "ycut"}], ",", 
          RowBox[{"1", "-", "ycut"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<yGrid\>\"", "->", 
          RowBox[{"Nw", "/@", 
           RowBox[{"gw", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"\"\<Weights\>\"", "->", 
          RowBox[{"Nw", "/@", 
           RowBox[{"gw", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeAngularProjectorCut", "[", 
    RowBox[{"s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", 
     RowBox[{"nY_Integer", ":", "96"}], ",", 
     RowBox[{"ycut_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}], ",", 
     RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "omega", ",", "rule", ",", "yGrid", ",", "YGrid", ",", "weights", ",", 
       "sphVals", ",", "projector"}], "}"}], ",", 
     RowBox[{
      RowBox[{"omega", "=", 
       RowBox[{"m", " ", "\[CapitalOmega]0val"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rule", "=", 
       RowBox[{"makeGaussLegendreRuleCut", "[", 
        RowBox[{"nY", ",", "ycut", ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yGrid", "=", 
       RowBox[{"rule", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"weights", "=", 
       RowBox[{"rule", "[", "\"\<Weights\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"YGrid", "=", 
       RowBox[{"YofYCos", "/@", "yGrid"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sphVals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SsphY", "[", 
           RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", "y",
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"projector", "=", 
       RowBox[{"2", " ", "Pi", " ", "weights", " ", 
        RowBox[{"Conjugate", "[", "sphVals", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<s\>\"", "->", "s"}], ",", 
        RowBox[{"\"\<ell\>\"", "->", "ell"}], ",", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<omega\>\"", "->", "omega"}], ",", 
        RowBox[{"\"\<yGrid\>\"", "->", "yGrid"}], ",", 
        RowBox[{"\"\<YGrid\>\"", "->", "YGrid"}], ",", 
        RowBox[{"\"\<Weights\>\"", "->", "weights"}], ",", 
        RowBox[{"\"\<SpheroidalValues\>\"", "->", "sphVals"}], ",", 
        RowBox[{"\"\<Projector\>\"", "->", "projector"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
