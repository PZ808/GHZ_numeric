 CellChangeTimes->{{3.9881709613997993`*^9, 3.9881709639123373`*^9}, {
  3.988171071769041*^9, 
  3.988171073035862*^9}},ExpressionUUID->"05022118-604c-4bb2-8663-\
a0e474d462c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"SsphThetaPhi", ",", "SsphY"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SsphThetaPhi", "[", 
      RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
     RowBox[{
      RowBox[{"theta_", "?", "NumericQ"}], ",", 
      RowBox[{"phi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "gamma", "}"}], ",", 
      RowBox[{
       RowBox[{"gamma", "=", 
        RowBox[{"aKerr", " ", "omega"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
         RowBox[{"s", ",", "ell", ",", "m", ",", "gamma"}], "]"}], "[", 
        RowBox[{"theta", ",", "phi"}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SsphY", "[", 
     RowBox[{"s_", ",", "ell_", ",", "m_", ",", "omega_"}], "]"}], "[", 
    RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "theta", "}"}], ",", 
     RowBox[{
      RowBox[{"theta", "=", 
       RowBox[{"ArcCos", "[", "yCos", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SsphThetaPhi", "[", 
        RowBox[{"s", ",", "ell", ",", "m", ",", "omega"}], "]"}], "[", 
       RowBox[{"theta", ",", 
        RowBox[{"N64", "@", "0"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
