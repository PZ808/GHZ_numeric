      RowBox[{"Y_", "?", "NumericQ"}], ",", 
      RowBox[{"Ymax_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"smoothCompactBump", "[", 
      RowBox[{"Y", "/", "Ymax"}], "]"}], "/", 
     RowBox[{"smoothCompactBump", "[", "0", "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
