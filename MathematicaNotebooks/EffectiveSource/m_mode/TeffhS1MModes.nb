     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsX", ",", "rLeftPhys", ",", "rRightPhys", ",", "xLeftOuter", ",", 
       "xRightOuter", ",", "x0", ",", "xLeftGrid", ",", "xRightGrid"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsX", "=", 
       RowBox[{"OptionValue", "[", "\"\<EpsilonX\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", "X0val"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rLeftPhys", "=", 
