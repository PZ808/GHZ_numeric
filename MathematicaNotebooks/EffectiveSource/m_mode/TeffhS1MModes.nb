Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"yOfYCoord", ",", "YofYCos", ",", "thetaOfYCos"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yOfYCoord", "[", 
    RowBox[{"Yval_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"N64", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "Yval"}], "/", "r0val"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"YofYCos", "[", 
    RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"N64", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "r0val"}], " ", "yCos"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaOfYCos", "[", 
    RowBox[{"yCos_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"ArcCos", "[", "yCos", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988163881125885*^9, 3.988163881128389*^9}, {
