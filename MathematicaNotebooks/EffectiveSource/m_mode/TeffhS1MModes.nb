   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reduceFirstOrderOp", "[", 
      RowBox[{
      "op_Association", ",", "m_Integer", ",", "qIn_Integer", ",", 
       "qOut_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R", ",", "dlog", ",", "AX", ",", "AY", ",", "A0"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"R", "=", 
         RowBox[{"poleWeightRatioY", "[", 
          RowBox[{"m", ",", "qIn", ",", "qOut"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dlog", "=", 
         RowBox[{"dLogPoleWeightY", "[", 
          RowBox[{"m", ",", "qIn"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AX", "=", 
         RowBox[{"cleanOpExpr", "[", 
          RowBox[{"R", " ", 
           RowBox[{"op", "[", "\"\<AX\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AY", "=", 
         RowBox[{"cleanOpExpr", "[", 
          RowBox[{"R", " ", 
           RowBox[{"op", "[", "\"\<AY\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"A0", "=", 
         RowBox[{"cleanOpExpr", "[", 
          RowBox[{"R", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"op", "[", "\"\<A0\>\"", "]"}], "+", 
             RowBox[{
              RowBox[{"op", "[", "\"\<AY\>\"", "]"}], " ", "dlog"}]}], 
            ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"makeFirstOrderOp", "[", 
         RowBox[{"AX", ",", "AY", ",", "A0"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
