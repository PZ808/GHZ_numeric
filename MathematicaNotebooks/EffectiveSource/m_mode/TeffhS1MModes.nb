Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"dropRadialEndpoints", ",", "convergencePairErrorsInterior"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dropRadialEndpoints", "[", "v_List", "]"}], ":=", 
    RowBox[{"v", "[", 
     RowBox[{"[", 
      RowBox[{"2", ";;", 
       RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"convergencePairErrorsInterior", "[", "vals_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pairs", ",", "diffs", ",", "rels"}], "}"}], ",", 
      RowBox[{
       RowBox[{"pairs", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"dropRadialEndpoints", "/@", "vals"}], ",", "2", ",", "1"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diffs", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"#2", "-", "#1"}], "]"}], "]"}], "&"}], "@@@", 
         "pairs"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rels", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"diffs", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "/", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"pairs", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], "]"}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "30"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"diffs", ",", "rels"}], "}"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"create", " ", "convergence", " ", "table"}], " ", 
   "*)"}]}]}], "Input",
