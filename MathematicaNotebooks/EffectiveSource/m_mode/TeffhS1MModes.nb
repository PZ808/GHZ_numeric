 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"endpointScalingData", "[", 
     RowBox[{"data_Association", ",", 
      RowBox[{"side_String", ":", "\"\<Right\>\""}], ",", 
      RowBox[{"n_Integer", ":", "12"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"data", "[", "\"\<Data\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"side", "===", "\"\<Right\>\""}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "-", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "n"}], ";;"}], ",", "1"}], "]"}], "]"}]}], ",", 
            
            RowBox[{"d", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "n"}], ";;"}], ",", "4"}], "]"}], "]"}]}], "}"}],
           "]"}], ",", 
         RowBox[{"side", "===", "\"\<Left\>\""}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"1", ";;", "n"}], ",", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{"d", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", "n"}], ",", "4"}], "]"}], "]"}]}], "}"}], 
          "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
