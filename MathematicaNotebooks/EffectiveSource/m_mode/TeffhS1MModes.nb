            RowBox[{"raw", "[", "\"\<XY\>\"", "]"}], "-", 
            RowBox[{"L", " ", 
             RowBox[{"raw", "[", "\"\<X\>\"", "]"}]}]}], ")"}], "/", "W"}]}], 
        ",", 
        RowBox[{"\"\<YY\>\"", "->", 
         RowBox[{
          RowBox[{"(", 
