       RowBox[{"s", "===", "\"\<plus\>\""}]}], ",", "\"\<MostlyPlus\>\"", ",",
       "True", ",", "$Failed"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
