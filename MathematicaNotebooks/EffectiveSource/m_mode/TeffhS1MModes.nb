Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Spin", "+", 
    RowBox[{"2", " ", "Teukolsky", " ", "source", " ", "operator"}]}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"makeTeukPlus2Ops", ",", "teukSourcePlus2Expr"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeTeukPlus2Ops", "[", "m_", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<P1\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"mVecMix", ",", "m", ",", 
          RowBox[{"pibNP", "-", "alphabNP", "-", 
           RowBox[{"3", " ", "betaNP"}], "-", 
           RowBox[{"4", " ", "tauNP"}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<P2\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"lVecMix", ",", "m", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "epsNP"}], "-", 
           RowBox[{"2", " ", "rhobNP"}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<P3\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"mVecMix", ",", "m", ",", 
          RowBox[{"pibNP", "-", 
           RowBox[{"2", " ", "alphabNP"}], "-", 
           RowBox[{"2", " ", "betaNP"}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<P4\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"lVecMix", ",", "m", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", "epsNP"}], "+", "epsbNP", "-", 
           RowBox[{"4", " ", "rhoNP"}], "-", "rhobNP"}]}], "]"}]}], ",", 
       RowBox[{"\"\<P5\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"mVecMix", ",", "m", ",", 
          RowBox[{
           RowBox[{"2", " ", "pibNP"}], "-", 
           RowBox[{"2", " ", "betaNP"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<P6\>\"", "->", 
        RowBox[{"makeModeDirectionalOpMixed", "[", 
         RowBox[{"lVecMix", ",", "m", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "epsNP"}], "+", 
           RowBox[{"2", " ", "epsbNP"}], "-", "rhobNP"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"teukSourcePlus2Expr", "[", 
      RowBox[{"jets_Association", ",", "m_"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "ops", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ops", "=", 
         RowBox[{"makeTeukPlus2Ops", "[", "m", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<P1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<P2\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<lm\>\"", "]"}]}], "]"}], "-", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<P1\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<P3\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<ll\>\"", "]"}]}], "]"}], "+", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<P4\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<P5\>\"", "]"}], ",", 
