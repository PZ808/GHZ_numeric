        RowBox[{"m", ",", "q", ",", "Yval"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"dLogPoleWeightNum", "[", 
        RowBox[{"m", ",", "q", ",", "Yval"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"LY", "=", 
       RowBox[{"d2LogPoleWeightNum", "[", 
        RowBox[{"m", ",", "q", ",", "Yval"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<F\>\"", "->", 
         RowBox[{
          RowBox[{"raw", "[", "\"\<F\>\"", "]"}], "/", "W"}]}], ",", 
        RowBox[{"\"\<X\>\"", "->", 
         RowBox[{
          RowBox[{"raw", "[", "\"\<X\>\"", "]"}], "/", "W"}]}], ",", 
        RowBox[{"\"\<Y\>\"", "->", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"raw", "[", "\"\<Y\>\"", "]"}], "-", 
            RowBox[{"L", " ", 
             RowBox[{"raw", "[", "\"\<F\>\"", "]"}]}]}], ")"}], "/", "W"}]}], 
        ",", 
        RowBox[{"\"\<XX\>\"", "->", 
         RowBox[{
          RowBox[{"raw", "[", "\"\<XX\>\"", "]"}], "/", "W"}]}], ",", 
        RowBox[{"\"\<XY\>\"", "->", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"raw", "[", "\"\<XY\>\"", "]"}], "-", 
            RowBox[{"L", " ", 
             RowBox[{"raw", "[", "\"\<X\>\"", "]"}]}]}], ")"}], "/", "W"}]}], 
        ",", 
        RowBox[{"\"\<YY\>\"", "->", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"raw", "[", "\"\<YY\>\"", "]"}], "-", 
            RowBox[{"2", " ", "L", " ", 
             RowBox[{"raw", "[", "\"\<Y\>\"", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"L", "^", "2"}], "-", "LY"}], ")"}], " ", 
             RowBox[{"raw", "[", "\"\<F\>\"", "]"}]}]}], ")"}], "/", 
          "W"}]}]}], "|>"}]}]}], "]"}]}], ";"}]], "Input",
