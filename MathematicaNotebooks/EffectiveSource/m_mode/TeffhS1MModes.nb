  RowBox[{
   RowBox[{"applyTwoOpsToJet2Num", "[", 
    RowBox[{
    "outer_Association", ",", "inner_Association", ",", "jet_Association"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
