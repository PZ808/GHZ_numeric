Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "angularTermSamples", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angularTermSamples", "[", 
     RowBox[{"projector_Association", ",", 
      RowBox[{"Xval_", "?", "NumericQ"}], ",", "name_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"yGrid", ",", "YGrid", ",", "sph", ",", "vals"}], "}"}], ",", 
      RowBox[{
       RowBox[{"yGrid", "=", 
        RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YGrid", "=", 
        RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sph", "=", 
        RowBox[{"projector", "[", "\"\<SpheroidalValues\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"sph", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"termFunction", "[", "name", "]"}], "[", 
            RowBox[{"Xval", ",", 
             RowBox[{"YGrid", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"yGrid", ",", 
          RowBox[{"Abs", "[", "vals", "]"}]}], "}"}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"angularTermSamples", "[", 
      RowBox[{"projDiag", ",", "Xmid", ",", "name"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"name", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<M1M2_nmb\>\"", ",", "\"\<-M1M3_mbmb\>\"", ",", 
         "\"\<M4M5_nmb\>\"", ",", "\"\<-M4M6_nn\>\"", ",", "\"\<Total\>\""}], 
        "}"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<M1M2 nmb\>\"", ",", "\"\<-M1M3 mbmb\>\"", ",", "\"\<M4M5 nmb\>\"", 
      ",", "\"\<-M4M6 nn\>\"", ",", "\"\<Total\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
