Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Serial", " ", "convergence", " ", "check", " ", "in", " ", "angular", 
     " ", "Gauss"}], "-", 
    RowBox[{"Legendre", " ", "order", " ", "nY"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "maxAbsNorm", ",", "convergencePairErrors", ",", 
      "runAngularProjectionConvergence"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"maxAbsNorm", "[", "v_List", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "v", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"convergencePairErrors", "[", "vals_List", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pairs", ",", "diffs", ",", "rels"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pairs", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"vals", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"diffs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"#2", "-", "#1"}], "]"}], "]"}], "&"}], "@@@", 
          "pairs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rels", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"diffs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"maxAbsNorm", "[", 
               RowBox[{"pairs", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "30"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"diffs", ",", "rels"}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"runAngularProjectionConvergence", "[", 
      RowBox[{
      "Tfun_", ",", "s_Integer", ",", "ell_Integer", ",", "m_Integer", ",", 
       "XGrid_List", ",", "nYList_List"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"valsByNY", ",", "valsList", ",", "errList"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"valsByNY", "=", 
         RowBox[{"Association", "@", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"nY", "->", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", "proj", "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"proj", "=", 
                 RowBox[{"makeAngularProjector", "[", 
                  RowBox[{"s", ",", "ell", ",", "m", ",", "nY"}], "]"}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"projectTeukSourceOnXGridGL", "[", 
                 RowBox[{"Tfun", ",", "XGrid", ",", "proj"}], "]"}]}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"nY", ",", "nYList"}], "}"}]}], "\[IndentingNewLine]", 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"valsList", "=", 
         RowBox[{"valsByNY", "/@", "nYList"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"errList", "=", 
         RowBox[{"convergencePairErrors", "[", "valsList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<nYList\>\"", "->", "nYList"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<ValuesByNY\>\"", "->", "valsByNY"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<PairwiseErrors\>\"", "->", 
           RowBox[{"Association", "@", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"nYList", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"nYList", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}], "->", 
               "\[IndentingNewLine]", 
               RowBox[{"<|", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"\"\<MaxAbsDifference\>\"", "->", 
                  RowBox[{"errList", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "1"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\"\<RelativeMaxDifference\>\"", "->", 
                  RowBox[{"errList", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "2"}], "]"}], "]"}]}]}], 
                "\[IndentingNewLine]", "|>"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "nYList", "]"}], "-", "1"}]}], 
               "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988127438725542*^9, 3.9881275017705917`*^9}, {
  3.988165416381915*^9, 3.988165520058576*^9}},
 CellLabel->
  "In[1404]:=",ExpressionUUID->"7f7a767a-f0fa-4038-a19b-be8ef73e86bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "maxErrorLocation", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maxErrorLocation", "[", 
    RowBox[{"v1_List", ",", "v2_List", ",", "XGrid_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"err", ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"err", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"v2", "-", "v1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{"err", ",", 
          RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Index\>\"", "->", "k"}], ",", 
        RowBox[{"\"\<X\>\"", "->", 
         RowBox[{"XGrid", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v1\>\"", "->", 
         RowBox[{"v1", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<v2\>\"", "->", 
         RowBox[{"v2", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<AbsError\>\"", "->", 
         RowBox[{"err", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<RelError\>\"", "->", 
         RowBox[{
          RowBox[{"err", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"v2", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], ",", 
            RowBox[{"10", "^", 
             RowBox[{"-", "30"}]}]}], "]"}]}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[1408]:=",ExpressionUUID->"226ad72b-802a-4587-9a65-caf382b02055"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "angularIntegrandSamples", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angularIntegrandSamples", "[", 
     RowBox[{"Tfun_", ",", "projector_Association", ",", 
      RowBox[{"Xval_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "yGrid", ",", "YGrid", ",", "sph", ",", "srcVals", ",", "vals"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"yGrid", "=", 
        RowBox[{"projector", "[", "\"\<yGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YGrid", "=", 
        RowBox[{"projector", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sph", "=", 
        RowBox[{"projector", "[", "\"\<SpheroidalValues\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"srcVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Tfun", "[", 
           RowBox[{"Xval", ",", 
            RowBox[{"YGrid", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"sph", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", 
           RowBox[{"srcVals", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<yGrid\>\"", "->", "yGrid"}], ",", 
