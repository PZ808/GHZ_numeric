ab2b8ffff232"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Serial", " ", "spheroidal", " ", "table", " ", 
    RowBox[{"cache", "--"}], " ", "robust", " ", "fallback"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "sphTableGoodQ", ",", "SphYTableCachedSerial", ",", 
      "prebuildSpheroidalTablesSerial"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sphTableGoodQ", "[", "obj_Association", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "vals", "}"}], ",", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"obj", ",", "\"\<Values\>\"", ",", "$Failed"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ListQ", "[", "vals", "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"vals", ",", "$Failed"}], "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"vals", ",", 
           RowBox[{
           "SpinWeightedSpheroidalHarmonicS", "|", 
            "SpinWeightedSpheroidalHarmonicS"}]}], "]"}], "&&", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"vals", ",", "NumericQ"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sphTableGoodQ", "[", "_", "]"}], ":=", "False"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SphYTableCachedSerial", "[", 
      RowBox[{"s_", ",", "ell_", ",", "m_", ",", 
       RowBox[{"omega_", "?", "NumericQ"}], ",", "yGrid_List", ",", 
       RowBox[{"prec_Integer", ":", "MP"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"file", ",", "obj"}], "}"}], ",", 
       RowBox[{
        RowBox[{"file", "=", 
         RowBox[{"sphTableFile", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", "file", "]"}], ",", 
          RowBox[{
           RowBox[{"obj", "=", 
            RowBox[{"readMXObject", "[", "file", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"sphTableGoodQ", "[", "obj", "]"}], ",", 
             RowBox[{"Return", "[", "obj", "]"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Deleting bad spheroidal cache file: \>\"", ",", "file"}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"DeleteFile", "[", "file", "]"}], ";"}]}], "]"}], 
           ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"buildSphYTable", "[", 
          RowBox[{
          "s", ",", "ell", ",", "m", ",", "omega", ",", "yGrid", ",", 
           "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"sphTableGoodQ", "[", "obj", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Bad spheroidal table built for: \>\"", ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "ell", ",", "m"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"writeMXObject", "[", 
         RowBox[{"file", ",", "obj"}], "]"}], ";", "\[IndentingNewLine]", 
        "obj"}]}], "]"}]}], ";"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.988304853400635*^9, 3.988304862718889*^9}, {
  3.988304951988141*^9, 3.988304957333284*^9}, {3.988304990906826*^9, 
  3.9883049911353188`*^9}},
