           RowBox[{"ops", "[", "\"\<P3\>\"", "]"}], ",", 
           RowBox[{"jets", "[", "\"\<ll\>\"", "]"}]}], "]"}], "+", 
         RowBox[{"applyTwoOpsToJet2", "[", 
          RowBox[{
           RowBox[{"ops", "[", "\"\<P4\>\"", "]"}], ",", 
           RowBox[{"ops", "[", "\"\<P5\>\"", "]"}], ",", 
