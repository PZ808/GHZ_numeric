    RowBox[{"keys_List", ",", "projector_Association", ",", 
     RowBox[{"Xval_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Dataset", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "f", ",", "right", ",", "left"}], "}"}], ",", 
        RowBox[{
         RowBox[{"q", "=", 
          RowBox[{"componentSpinWeight", "[", "key", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"f", "=", 
          RowBox[{"componentFfun", "[", "key", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"right", "=", 
          RowBox[{"endpointPowerOfFunction", "[", 
           RowBox[{
           "f", ",", "Xval", ",", "projector", ",", "\"\<Right\>\"", ",", 
            "16"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"left", "=", 
          RowBox[{"endpointPowerOfFunction", "[", 
