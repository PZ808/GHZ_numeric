Cell[CellGroupData[{

Cell[TextData[{
 " Coordinate diffeo and derivative jacobian for source \
eva\[CloseCurlyQuote]ld at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     SuperscriptBox["x", "\[Mu]"], ")"}], "p"], TraditionalForm]],
  ExpressionUUID->"e0302ff8-a6f6-46f0-a512-76053a4b136a"],
 " "
}], "Subsubsection",
 CellChangeTimes->{{3.9880884999435577`*^9, 
  3.988088534702259*^9}},ExpressionUUID->"4f66e804-e438-44ea-aa2f-\
1979c033f3dc"],

Cell[TextData[{
 "For a function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", 
    RowBox[{
     RowBox[{"F", "(", 
      RowBox[{"x", ",", "y"}], ")"}], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "i\[Omega]t"}], "+", "im\[Phi]", " "}]]}]}], 
   TraditionalForm]],ExpressionUUID->"96a729b1-b20f-4776-928a-0ad705222523"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["v", "\[Mu]"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "f"}]}], " ", "=", " "}], 
   TraditionalForm]],ExpressionUUID->"e9be8802-f695-4529-ba2f-1c4675a09969"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["v", "t"], "(", 
      RowBox[{"-", "\[ImaginaryI]\[Omega]F"}], ")"}], "+", 
     RowBox[{
      SuperscriptBox["v", "\[Phi]"], "(", 
      RowBox[{"\[ImaginaryI]", " ", "mF"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"f467c21e-2c9b-4b40-893c-8f104ac01ff8"],
 "+ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["v", "X"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "X"], " ", "F"}]}], "+", 
      RowBox[{
       SuperscriptBox["v", "Y"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "Y"], "F"}]}]}], "]"}], 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]\[Omega]t"}], "+", "\[ImaginaryI]m\[Phi]", 
      " "}]]}], TraditionalForm]],ExpressionUUID->
  "e3d20a76-a4a2-4b16-b264-4f93352b95b1"],
 "\nSince X=X(r) and Y=Y(\[Theta]) ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "r"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["X", 
       RowBox[{",", "r"}]], 
      SubscriptBox["F", 
       RowBox[{",", "x"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "5595a36f-3ee6-4cbd-8c0e-05e2e8106826"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Theta]"], "F"}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["Y", 
       RowBox[{",", "\[Theta]"}]], 
      SubscriptBox["F", 
       RowBox[{",", "Y"}]], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "de2a32a5-35a0-4c24-b2f0-2753bbea3e59"],
 " \nwith X = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "-", 
      SubscriptBox["r", "0"]}], ")"}], "/", "\[ScriptCapitalB]", " "}], 
   TraditionalForm]],ExpressionUUID->"ad709f27-9e71-4c3f-af19-e5fff0508a79"],
 " and Y = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["r", "0"]}], "cos\[Theta]"}], TraditionalForm]],
  ExpressionUUID->"87d4f4ae-2230-4ac7-80b0-8f520bf641e3"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    RowBox[{",", "r"}]], TraditionalForm]],ExpressionUUID->
  "00d21c8f-ba8c-4ef6-8fa0-28ee8bf1e9bd"],
 "=1/\[ScriptCapitalB] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Y", 
     RowBox[{",", "\[Theta]"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["r", "0"], 
      RowBox[{"sin", "(", "\[Theta]", ")"}]}], "=", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["r", "0"], "2"], "-", 
        SuperscriptBox["Y", "2"]}], ")"}], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]],ExpressionUUID->
  "7ff23663-cb0a-4f51-9664-04d10b972b42"]
}], "Text",
 CellChangeTimes->{{3.988088550392536*^9, 
  3.9880889314069653`*^9}},ExpressionUUID->"68546774-d5a2-4a93-a7d0-\
441e2b255dbd"],

