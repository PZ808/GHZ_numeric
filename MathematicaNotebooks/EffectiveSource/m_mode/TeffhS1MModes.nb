Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Barycentric", " ", "interpolation", " ", "and", " ", "diff", " ", 
    "matrices", " ", 
    RowBox[{"(", 
     RowBox[{"manual", " ", "approach"}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Barycentric", " ", "interpolation", " ", "weights", " ", "for", " ", 
    "arbitrary", " ", "distinct", " ", 
    RowBox[{"nodes", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"baryWeights1D", "[", "x_List", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", "==", "k"}], ",", "1", ",", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"x", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Spectral", "/", "finite"}], " ", "interpolation", " ", 
     "differentiation", " ", "matrix", " ", "on", " ", "arbitrary", " ", 
     RowBox[{"nodes", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"diffMatrix1D", "[", "x_List", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "x", "]"}]}], ",", "w", ",", "D"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"w", "=", 
         RowBox[{"baryWeights1D", "[", "x", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"D", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", 
             RowBox[{"Nw", "@", "0"}], ",", 
             RowBox[{
              RowBox[{"w", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "-", 
                  RowBox[{"x", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}]}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"-", 
            RowBox[{"Total", "[", 
             RowBox[{"Delete", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "i"}], "]"}], "]"}]}]}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "D"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"If", " ", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "=", 
      RowBox[{"F", "[", 
       RowBox[{
        RowBox[{"XGrid", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"YGrid", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"then", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"dXGrid", "[", "DX_", "]"}], "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"DX", ".", "M"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"dYGrid", "[", "DY_", "]"}], "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"M", ".", 
      RowBox[{"Transpose", "[", "DY", "]"}]}]}], ";"}]}]}]], "Input",
