              RowBox[{"(", 
               RowBox[{"1", "+", "y"}], ")"}], "^", "b"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"with", " ", "y"}], "=", 
           RowBox[{
            RowBox[{"-", "Y"}], "/", "r0"}]}]}], "*)"}], 
        RowBox[{
         RowBox[{"a", "/", 
          RowBox[{"(", 
           RowBox[{"r0val", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "y"}], ")"}]}], ")"}]}], "-", 
         RowBox[{"b", "/", 
          RowBox[{"(", 
           RowBox[{"r0val", " ", 
            RowBox[{"(", 
