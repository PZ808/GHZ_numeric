Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "componentIDs", ",", "patchIDs", ",", "yStorageIDs", ",", "magicBytes", 
     ",", "teffFuncs", ",", "flattenComplexInterleaved", ",", 
     "buildComponentMatrix", ",", "exportBinaryComponentFile", ",", 
     "exportPatchBinaryFiles", ",", "exportTwoPatchModeBinaryFiles", ",", 
     "flagBits", ",", "normalizeMetricSignature", ",", "buildFlags"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"componentIDs", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<ll\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<ln\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<lm\>\"", "->", "2"}], ",", 
      RowBox[{"\"\<lmb\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<nn\>\"", "->", "4"}], ",", 
      RowBox[{"\"\<nm\>\"", "->", "5"}], ",", 
      RowBox[{"\"\<nmb\>\"", "->", "6"}], ",", 
      RowBox[{"\"\<mm\>\"", "->", "7"}], ",", 
      RowBox[{"\"\<mmb\>\"", "->", "8"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"patchIDs", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<left\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<right\>\"", "->", "1"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yStorageIDs", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Full\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<HalfWithEvenReflection\>\"", "->", "1"}]}], "|>"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magicBytes", "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"ToCharacterCode", "[", "\"\<GHZSRC1\>\"", "]"}], ",", 
      RowBox[{"{", "0", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"flag", " ", "bit", " ", "masks"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flagBits", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<NegativeMIsConjugate\>\"", "->", "1"}], ",", 
      RowBox[{"(*", 
       RowBox[{"bit", " ", "0"}], "*)"}], 
      RowBox[{"\"\<MostlyPlusSignature\>\"", "->", "2"}]}], "    ", 
     RowBox[{"(*", 
      RowBox[{"bit", " ", "1"}], "*)"}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalizeMetricSignature", "[", "s_", "]"}], ":=", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", "===", "\"\<MostlyMinus\>\""}], "||", 
       RowBox[{"s", "===", "\"\<-+++\>\""}], "||", 
       RowBox[{"s", "===", "\"\<minus\>\""}]}], ",", "\"\<MostlyMinus\>\"", 
      ",", 
      RowBox[{
       RowBox[{"s", "===", "\"\<MostlyPlus\>\""}], "||", 
       RowBox[{"s", "===", "\"\<+---\>\""}], "||", 
       RowBox[{"s", "===", "\"\<plus\>\""}]}], ",", "\"\<MostlyPlus\>\"", ",",
       "True", ",", "$Failed"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"buildFlags", "[", 
     RowBox[{"negM_", ",", "metricSig_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"flags", "=", "0"}], ",", 
        RowBox[{"sig", "=", 
         RowBox[{"normalizeMetricSignature", "[", "metricSig", "]"}]}]}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sig", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", "negM", "]"}], ",", 
         RowBox[{"flags", "=", 
          RowBox[{"BitOr", "[", 
           RowBox[{"flags", ",", 
            RowBox[{"flagBits", "[", "\"\<NegativeMIsConjugate\>\"", "]"}]}], 
           "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sig", "===", "\"\<MostlyPlus\>\""}], ",", 
         RowBox[{"flags", "=", 
          RowBox[{"BitOr", "[", 
           RowBox[{"flags", ",", 
            RowBox[{"flagBits", "[", "\"\<MostlyPlusSignature\>\"", "]"}]}], 
           "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "flags"}]}], "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"teffFuncs", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<ll\>\"", "->", "Teffll$MMode$XY$numeric"}], ",", 
