     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exportBinaryComponentFile", "[", 
     RowBox[{"file_String", ",", "component_String", ",", 
      RowBox[{"m_Integer", "?", "NonNegative"}], ",", "patch_String", ",", 
      "XGrid_List", ",", "YGrid_List", ",", 
      RowBox[{"data_", "?", "MatrixQ"}], ",", "rp_", ",", "B_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nx", ",", "ny", ",", "stream", ",", "flat", ",", "patchID", ",", 
        "yStorageID", ",", "flags", ",", "metricSig"}], "}"}], ",", 
      RowBox[{
       RowBox[{"nx", "=", 
        RowBox[{"Length", "[", "XGrid", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ny", "=", 
        RowBox[{"Length", "[", "YGrid", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"componentIDs", ",", "component"}], "]"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
