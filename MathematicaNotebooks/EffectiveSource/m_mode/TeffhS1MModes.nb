        RowBox[{
         RowBox[{"inner", "[", "\"\<AY\>\"", "]"}], " ", 
         RowBox[{"jet", "[", "\"\<XY\>\"", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"inner", "[", "\"\<AX_X\>\"", "]"}], "+", 
