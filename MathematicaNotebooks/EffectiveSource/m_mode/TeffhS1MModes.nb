          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "yGrid", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
