  3.988091131789856*^9}},ExpressionUUID->"e4c87f5a-8193-4d03-aedf-\
ce339e8648ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"BL", "->", 
    RowBox[{"mixed", " ", 
     RowBox[{"(", 
      RowBox[{"t", ",", "X", ",", "Y", ",", "phi"}], ")"}], " ", "Kinnersley",
      " ", "tetrad"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "rMix", ",", "zMix", ",", "sinThetaMix", ",", "SigmaMix", ",", 
      "DeltaMix", ",", "denMix", ",", "lVecMix", ",", "nVecMix", ",", 
      "mVecMix", ",", "mbVecMix"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rMix", ":=", 
     RowBox[{"r0val", "+", 
      RowBox[{"Bval", " ", "X"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zMix", ":=", 
     RowBox[{
      RowBox[{"-", "Y"}], "/", "r0val"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sinThetaMix", ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"zMix", "^", "2"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SigmaMix", ":=", 
     RowBox[{
      RowBox[{"rMix", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"spinval", "^", "2"}], " ", 
       RowBox[{"zMix", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DeltaMix", ":=", 
     RowBox[{
      RowBox[{"rMix", "^", "2"}], "-", 
      RowBox[{"2", " ", "massval", " ", "rMix"}], "+", 
      RowBox[{"spinval", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Standard", " ", "Kinnersley", " ", "m"}], "-", 
     RowBox[{"vector", " ", 
      RowBox[{"denominator", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"denMix", ":=", 
     RowBox[{"rMix", "+", 
      RowBox[{"I", " ", "spinval", " ", "zMix"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"denBarMix", " ", ":=", " ", 
     RowBox[{"rMix", " ", "-", " ", 
      RowBox[{"I", " ", "spinval", " ", "zMix"}]}]}], ";"}], 
   "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    SuperscriptBox["l", "\[Mu]"], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lVecMix", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<t\>\"", "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rMix", "^", "2"}], "+", 
           RowBox[{"spinval", "^", "2"}]}], ")"}], "/", "DeltaMix"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<X\>\"", "->", 
        RowBox[{"1", "/", "Bval"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Y\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<phi\>\"", "->", 
        RowBox[{"spinval", "/", "DeltaMix"}]}]}], "\[IndentingNewLine]", 
      "|>"}]}], ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", 
    SuperscriptBox["n", "\[Mu]"], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nVecMix", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<t\>\"", "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rMix", "^", "2"}], "+", 
           RowBox[{"spinval", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<X\>\"", "->", 
        RowBox[{
         RowBox[{"-", "DeltaMix"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix", " ", "Bval"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Y\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<phi\>\"", "->", 
        RowBox[{"spinval", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "SigmaMix"}], ")"}]}]}]}], "\[IndentingNewLine]", 
      "|>"}]}], ";"}], " ", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", 
    SuperscriptBox["m", "\[Mu]"], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mVecMix", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<t\>\"", "->", 
        RowBox[{"I", " ", "spinval", " ", 
         RowBox[{"sinThetaMix", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "2", "]"}], " ", "denMix"}], ")"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<X\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Y\>\"", "->", 
        RowBox[{"r0val", " ", 
         RowBox[{"sinThetaMix", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "2", "]"}], " ", "denMix"}], ")"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<phi\>\"", "->", 
        RowBox[{"I", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], " ", "denMix", " ", 
           "sinThetaMix"}], ")"}]}]}]}], "\[IndentingNewLine]", "|>"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    SuperscriptBox[
     OverscriptBox["m", "_"], "\[Mu]"], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mbVecMix", " ", "=", 
     RowBox[{"<|", "\n", "  ", 
      RowBox[{
       RowBox[{"\"\<t\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "spinval", " ", 
         RowBox[{"sinThetaMix", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "2", "]"}], " ", "denBarMix"}], ")"}]}]}]}], 
       ",", "\n", "  ", 
       RowBox[{"\"\<X\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
       RowBox[{"\"\<Y\>\"", " ", "->", " ", 
        RowBox[{"r0val", " ", 
         RowBox[{"sinThetaMix", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "2", "]"}], " ", "denBarMix"}], ")"}]}]}]}], 
       ",", "\n", "  ", 
       RowBox[{"\"\<phi\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"-", "I"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], " ", "denBarMix", " ", 
           "sinThetaMix"}], ")"}]}]}]}], "\n", "  ", "|>"}]}], ";"}], 
   " "}]}]], "Input",
 CellChangeTimes->{{3.9880907873389063`*^9, 3.988090792535421*^9}, {
  3.988091389286972*^9, 3.988091395568893*^9}, {3.9882032186598177`*^9, 
