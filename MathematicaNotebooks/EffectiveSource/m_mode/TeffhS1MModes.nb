            "16"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<component\>\"", "->", "key"}], ",", 
           RowBox[{"\"\<spin q\>\"", "->", "q"}], ",", 
           RowBox[{"\"\<expected right power\>\"", "->", 
