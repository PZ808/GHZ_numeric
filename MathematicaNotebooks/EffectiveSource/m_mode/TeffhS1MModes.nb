         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmin", "+", "xmax"}], ")"}], "/", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xmax", "-", "xmin"}], ")"}], " ", 
           RowBox[{"xi", "/", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"Nw", "/@", "x"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
