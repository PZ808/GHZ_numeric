Cell[CellGroupData[{

Cell["Spherical Harmonic Y Projections ", "Subsection",
 CellChangeTimes->{{3.988111982658353*^9, 3.988111989177335*^9}, {
  3.988211571525571*^9, 
  3.988211576291706*^9}},ExpressionUUID->"78500be4-71c6-48ee-aff6-\
feee19fb42b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "projectTeff$mMode$y", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "projectTeff$mMode$y", "]"}], "=", 
    "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<EndpointCutoff\>\"", "->", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"WorkingPrecision", "->", "MP"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AccuracyGoal", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PrecisionGoal", "->", "Automatic"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MaxRecursion", "->", "12"}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"projectTeff$mMode$y", "[", 
      RowBox[{"s_", ",", "l_", ",", "m_"}], "]"}], "[", "TeffHead_", "]"}], 
    "[", 
    RowBox[{
     RowBox[{"X_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eps", ",", "wp", ",", "acc", ",", "prec", ",", "maxrec", ",", 
       "\[Theta]"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eps", "=", 
       RowBox[{"OptionValue", "[", "\"\<EndpointCutoff\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"acc", "=", 
       RowBox[{"OptionValue", "[", "AccuracyGoal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"prec", "=", 
       RowBox[{"OptionValue", "[", "PrecisionGoal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxrec", "=", 
       RowBox[{"OptionValue", "[", "MaxRecursion", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Nintegration", " ", "local", " ", "adapative"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"TeffHead", "[", "m", "]"}], "[", 
           RowBox[{"X", ",", 
            RowBox[{
             RowBox[{"-", "r0val"}], " ", "y"}]}], "]"}], "*", 
          "\[IndentingNewLine]", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
            RowBox[{"s", ",", "l", ",", "m", ",", 
             RowBox[{"ArcCos", "[", "y", "]"}], ",", 
             RowBox[{"N64", "@", "0"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "eps"}], ",", 
           RowBox[{"1", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<LocalAdaptive\>\"", ",", 
            RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AccuracyGoal", "->", "acc"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PrecisionGoal", "->", "prec"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"MaxRecursion", "->", "maxrec"}]}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.988014839815839*^9, 3.988014923517639*^9}, {
   3.988115444247805*^9, 3.9881155743313427`*^9}, {3.9881156262355423`*^9, 
   3.9881156528292294`*^9}, 3.988292629691427*^9, {3.9882953681894913`*^9, 
   3.988295368302532*^9}},ExpressionUUID->"54469045-937e-49b4-ba9d-\
e199dbb0cbe7"],

