       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{
          RowBox[{"-", "Yval"}], "/", "r0val"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"m", "+", "q"}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
