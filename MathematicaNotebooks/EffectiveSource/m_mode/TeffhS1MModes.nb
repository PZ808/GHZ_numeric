   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"maxAbsNorm", "[", "v_List", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "v", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"convergencePairErrors", "[", "vals_List", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pairs", ",", "diffs", ",", "rels"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pairs", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"vals", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"diffs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"#2", "-", "#1"}], "]"}], "]"}], "&"}], "@@@", 
          "pairs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rels", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"diffs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"maxAbsNorm", "[", 
               RowBox[{"pairs", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "30"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"diffs", ",", "rels"}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"runAngularProjectionConvergence", "[", 
      RowBox[{
