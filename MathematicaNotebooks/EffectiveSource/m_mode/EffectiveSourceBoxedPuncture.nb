Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Eff. Source w/ boxed ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "P"], TraditionalForm]],ExpressionUUID->
  "1c2e9baa-2a6f-4444-ac66-7aa474e6e436"],
 " (Schw.)"
}], "Title",
 CellChangeTimes->{{3.9829403026938553`*^9, 3.982940315873452*^9}, {
  3.983428799136076*^9, 
  3.983428807384501*^9}},ExpressionUUID->"26cfe439-c05e-4c8b-a650-\
63b4956790da"],

Cell[TextData[{
 "\nComputes NP components of  effective source {l,m,\[Omega]} modes for a \
circular orbit in Schwarzschild spacetime. The output is in body adapted \
coordinates (X,Y,Z).\n\nA box windowed puncture:\n The worldtube left-end \
boundary  data  is generated  conditions for the corrector (IRG) in Schw. \
from the coefficients ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{",", "\[Delta]"}]}], ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d7b4642-534e-4a25-9f5f-7ca083748295"],
 "  and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{",", 
       RowBox[{"\[Delta]", "'"}]}]}], ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ca1e96a-bbe0-4ebb-b63e-51385193fd26"],
 " which are the coefficients of \[Delta] and \[Delta]\[CloseCurlyQuote].  \n \
\n Data format:\n The data is written in binary \n The data format can be \
determined from the functions exportBinaryComponentFile, and \
exportBoundaryModeFiles"
}], "Abstract",
 CellChangeTimes->{{3.98294032667756*^9, 3.982940367416107*^9}, {
  3.983427228762475*^9, 3.983427269854886*^9}, {3.983427317415923*^9, 
  3.983427412373563*^9}, {3.983428382506856*^9, 3.9834284602745447`*^9}, {
  3.9834285571679993`*^9, 
  3.9834286058855762`*^9}},ExpressionUUID->"57834274-19fe-4981-8b75-\
29d90e25e2a0"],

Cell[CellGroupData[{

