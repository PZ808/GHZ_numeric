Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "readBoundaryBinaryFile", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readBoundaryBinaryFile", "[", "file_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "stream", ",", "magic", ",", "version", ",", "m", ",", "componentID", 
       ",", "kindID", ",", "yStorageID", ",", "flags", ",", "rp", ",", 
       "rBoundary", ",", "ny", ",", "yGrid", ",", "flat", ",", "data"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"stream", "=", 
       RowBox[{"OpenRead", "[", 
        RowBox[{"file", ",", 
         RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"magic", "=", 
       RowBox[{"BinaryReadList", "[", 
        RowBox[{"stream", ",", "\"\<Byte\>\"", ",", "8"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"version", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<Integer32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"componentID", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kindID", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yStorageID", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flags", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rp", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<Real64\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rBoundary", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<Real64\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ny", "=", 
       RowBox[{"BinaryRead", "[", 
        RowBox[{"stream", ",", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yGrid", "=", 
       RowBox[{"BinaryReadList", "[", 
        RowBox[{"stream", ",", "\"\<Real64\>\"", ",", "ny"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flat", "=", 
       RowBox[{"BinaryReadList", "[", 
        RowBox[{"stream", ",", "\"\<Real64\>\"", ",", 
         RowBox[{"2", " ", "ny"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Complex", "@@", "#"}], "&"}], ",", 
         RowBox[{"Partition", "[", 
          RowBox[{"flat", ",", "2"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Magic\>\"", "->", "magic"}], ",", 
        RowBox[{"\"\<Version\>\"", "->", "version"}], ",", 
        RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<ComponentID\>\"", "->", "componentID"}], ",", 
        RowBox[{"\"\<KindID\>\"", "->", "kindID"}], ",", 
        RowBox[{"\"\<YStorageID\>\"", "->", "yStorageID"}], ",", 
        RowBox[{"\"\<Flags\>\"", "->", "flags"}], ",", 
        RowBox[{"\"\<rp\>\"", "->", "rp"}], ",", 
        RowBox[{"\"\<rBoundary\>\"", "->", "rBoundary"}], ",", 
        RowBox[{"\"\<ny\>\"", "->", "ny"}], ",", 
        RowBox[{"\"\<YGrid\>\"", "->", "yGrid"}], ",", 
        RowBox[{"\"\<Data\>\"", "->", "data"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",
