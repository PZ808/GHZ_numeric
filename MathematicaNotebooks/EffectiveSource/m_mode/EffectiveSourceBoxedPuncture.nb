Cell[CellGroupData[{

Cell["Manipulations and definitions", "Subsection",
 CellChangeTimes->{{3.893778002454561*^9, 3.8937780101648912`*^9}, {
  3.898835023493431*^9, 
  3.898835023563086*^9}},ExpressionUUID->"81efcc8f-43ee-4df9-8ab0-\
7bd8baedabaf"],

Cell[TextData[{
 "Now, add the Heaviside function and do some rules to put it in a usable \
format (not needing xTensor).\nAlso extract the smooth and distributional \
pieces. ",
 StyleBox["Note: if xTensor is active or geodesic quantities have been set, \
the below WILL break!\n",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Note that the puncture is given in t slicing. This gives \
\[ScriptCapitalE]hP in t slicing. Moving forward, we need it in u slicing, \
which is achieved by adding the appropriate factor of ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    SuperscriptBox["i\[Omega]r", "*"]], TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "ad6ce317-116f-4bb6-afc8-3c7035410af3"],
 StyleBox[" at the level of \[ScriptCapitalE]hP.\n\nWe will always make sure \
that the final coefficients in front of \[Delta] and \[Delta]\
\[CloseCurlyQuote] are evaluated at ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "min"], TraditionalForm]],ExpressionUUID->
  "09b24426-0d0c-4c96-9da5-e7f7bb64198e"],
 " (or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "max"], TraditionalForm]],ExpressionUUID->
  "6090a8be-d343-468d-940e-cd6d0fd63352"],
 "). This is done using the below two properties which hold distributionally:\
\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"F", 
      RowBox[{"(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], "   ", "=", "     ", 
     RowBox[{
      RowBox[{"F", "(", 
       SubscriptBox["x", "0"], ")"}], " ", 
      RowBox[{"\[Delta]", "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "(", "x", ")"}], " ", 
      RowBox[{"\[Delta]", "'"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "0"]}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"F", "'"}]}], 
       RowBox[{"(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"F", "(", 
        SubscriptBox["x", "0"], ")"}], " ", 
       RowBox[{"\[Delta]", "'"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9ef730d6-865f-4f87-904f-d894897f67ff"]
}], "Text",
 CellChangeTimes->{{3.8736291734475594`*^9, 3.873629265926456*^9}, {
  3.887263958194542*^9, 3.8872639682823877`*^9}, {3.890194089915679*^9, 
  3.890194176985252*^9}, {3.8928757904248857`*^9, 
  3.892875999592518*^9}},ExpressionUUID->"25bc2c5d-80a4-4e2f-94ac-\
0a3f8a80b65d"],

