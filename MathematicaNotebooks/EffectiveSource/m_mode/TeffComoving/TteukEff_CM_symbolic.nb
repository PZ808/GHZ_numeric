Cell["\<\
\tThis docked button will go through the notebook and correctly align all the \
text.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.767334495520029*^9, 3.7673345126073723`*^9}, {
  3.89797453461045*^9, 
  3.897974535093182*^9}},ExpressionUUID->"ab30c5f8-c95a-4e56-bdad-\
48f778ce0b0c"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonalignment", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"styles", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Section\>\"", ",", "\"\<Subsection\>\"", 
          ",", "\"\<Subsubsection\>\""}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ToBoxes", "@", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<align\>\"", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Set", "[", 
             RowBox[{
              RowBox[{"CurrentValue", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], "]"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"CurrentValue", "[", 
               RowBox[{
                RowBox[{"PreviousCell", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"CellStyle", "\[Rule]", "styles"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], 
               "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"Cells", "[", 
            RowBox[{"CellStyle", "\[Rule]", "\"\<Text\>\""}], "]"}]}], 
          "]"}]}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.767334514785654*^9, 3.7673345236628838`*^9}, {
  3.77002780011087*^9, 3.770027808916594*^9}, {3.7700319254436007`*^9, 
  3.7700319284353733`*^9}, {3.897974536733653*^9, 3.8979745449200697`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"fe7b85bf-1bfc-48e7-a9e7-c12ad9d2692c"]
