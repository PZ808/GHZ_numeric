Cell[CellGroupData[{

Cell["Full docked buttons", "Subsubsubsubsection",
 CellChangeTimes->{{3.767334421497847*^9, 
  3.767334428492256*^9}},ExpressionUUID->"95112daa-fcbc-452e-ba09-\
05a0494aeb57"],

Cell["\<\
\t\t\t\tImplementation of each part as a docked cell. For adding new \
features, simply create new data as shown for the above two buttons, i.e. \
ToBoxes[stuff] and then put it inside the BoxData.
\t\t\t\tThe next lines should not be touched and their purpose is to make the \
toolbar expand/collapse upon clicking of the bottom panel.\
\>", "Text",
 CellChangeTimes->{{3.7700290356860733`*^9, 3.770029173865818*^9}, 
   3.8833786476108437`*^9, {3.988533129726223*^9, 
   3.988533130826988*^9}},ExpressionUUID->"56967ffe-0f9c-44a2-ab4a-\
e93d6b65fde3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullDockedCellsWithCollapseToolbar", "=", 
   RowBox[{"Cell", "[", 
    RowBox[{
     RowBox[{"BoxData", "[", 
      RowBox[{"{", 
       RowBox[{"buttonalignment", ",", "buttonevaluable"}], "}"}], "]"}], ",",
      " ", "\[IndentingNewLine]", "\t\t\t\t\t", 
     RowBox[{"CellFrameLabelMargins", "\[Rule]", "0"}], ",", 
     RowBox[{"CellFrameLabels", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"None", ",", "None"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ButtonBox", "[", 
           
           RowBox[{"\"\<\>\"", ",", "\[IndentingNewLine]", "\t\t\t", 
            "\[IndentingNewLine]", 
            RowBox[{"ButtonFunction", "\[RuleDelayed]", 
             RowBox[{"Function", "[", 
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"pc", "=", 
                  RowBox[{"ParentCell", "@", 
                   RowBox[{"EvaluationCell", "[", "]"}]}]}], "}"}], ",", 
                RowBox[{"SetOptions", "[", 
                 RowBox[{"pc", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"CurrentValue", "[", 
                    RowBox[{"pc", ",", "CellSize"}], "]"}], "===", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "Inherited"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                    "\t\t\t\t", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "Inherited"}]}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "0"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"\"\<CellMinHeight\>\"", "\[Rule]", "0"}], 
                    "}"}]}], ",", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "0"}]}], "}"}]}], 
                   "]"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"ImageSize", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Scaled", "[", "2", "]"}], ",", "15"}], "}"}]}], ",", 
            RowBox[{"Evaluator", "\[Rule]", "Automatic"}]}], "]"}], ",", 
          "None"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\t\t\t\t", 
  RowBox[{"SetOptions", "[", 
   RowBox[{
    RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
    RowBox[{
    "DockedCells", "\[Rule]", "fullDockedCellsWithCollapseToolbar"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\t\t\t\t", 
  RowBox[{"Clear", "[", 
   RowBox[{"buttonalignment", ",", "buttonevaluable"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.770025318638297*^9, 3.770025318638781*^9}, {
   3.7700258231894093`*^9, 3.7700258521002827`*^9}, {3.7700258828440104`*^9, 
   3.7700258870832376`*^9}, {3.7700259317144413`*^9, 3.770025976112444*^9}, {
