  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "SetBasisChange[CTensor[matrix, {-downbasis, upbasis}]] stores, both \
using a CTensor and TensorValues, the change between the bases. Input can \
also be given as SetBasisChange[CTensor[Transpose[matrix], {upbasis, \
-downbasis}]]. SetBasisChange[{direct, inverse}] provides a pair of CTensor \
objects describing the direct and inverse basis changes.", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, xAct`xCoba`SetBasisChange, {xAct`xCoba`SetBasisChange[
         Pattern[xAct`xCoba`Private`change, 
          Blank[]], 
         Pattern[xAct`xCoba`Private`opts, 
          OptionsPattern[]]] :> 
       xAct`xCoba`SetBasisChange[
        xAct`xCoba`Private`change, Null, xAct`xCoba`Private`opts], 
       xAct`xCoba`SetBasisChange[
         Pattern[xAct`xCoba`Private`ctensor, 
          Blank[xAct`xCoba`CTensor]], 
         Pattern[xAct`xCoba`Private`chart, 
          Blank[]], 
         Pattern[xAct`xCoba`Private`opts, 
          OptionsPattern[]]] :> 
       Module[{xAct`xCoba`Private`cvsimplify, xAct`xCoba`Private`inverse}, 
         If[
           Not[
            xAct`xCoba`Private`CTensorQ[xAct`xCoba`Private`ctensor, 2, 0]], 
           Return[$Failed]]; 
         xAct`xCoba`Private`cvsimplify = OptionValue[xAct`xCoba`CVSimplify]; 
         xAct`xCoba`Private`inverse = Check[
            xAct`xTensor`Inv[xAct`xCoba`Private`ctensor], $Failed]; 
         If[xAct`xCoba`Private`inverse =!= $Failed, 
           
           xAct`xCoba`SetBasisChange[{
            xAct`xCoba`Private`ctensor, xAct`xCoba`Private`inverse}, 
            xAct`xCoba`Private`chart, xAct`xCoba`Private`opts], $Failed]], 
       xAct`xCoba`SetBasisChange[{
          Pattern[xAct`xCoba`Private`direct, 
           Blank[xAct`xCoba`CTensor]], 
          Pattern[xAct`xCoba`Private`inverse, 
           Blank[xAct`xCoba`CTensor]]}, 
         Pattern[xAct`xCoba`Private`chart, 
          Blank[]], 
         Pattern[xAct`xCoba`Private`opts, 
          OptionsPattern[]]] :> Module[{}, If[Reverse[
             xAct`xCoba`Private`CTensorBases[xAct`xCoba`Private`direct]] =!= -
            xAct`xCoba`Private`CTensorBases[xAct`xCoba`Private`inverse], 
           Throw[
            Message[
             MessageName[xAct`xCoba`SetBasisChange, "error"], 
             "Incompatible changes of basis provided."]]]; 
         xAct`xCoba`Private`SetBasisChange1[
          xAct`xCoba`Private`inverse, xAct`xCoba`Private`chart, False, 
           xAct`xCoba`Private`opts]; 
         xAct`xCoba`Private`SetBasisChange1[
          xAct`xCoba`Private`direct, xAct`xCoba`Private`chart, True, 
           xAct`xCoba`Private`opts]; Null]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
