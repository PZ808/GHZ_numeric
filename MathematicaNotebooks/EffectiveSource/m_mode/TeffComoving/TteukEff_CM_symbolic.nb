Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "DefinitionMemoryBreakdown", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"DefinitionMemoryBreakdown", ",", "HoldFirst"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"DefinitionMemoryBreakdown", "[", "s_Symbol", "]"}], ":=", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<OwnValues\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"OwnValues", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<DownValues\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"DownValues", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<SubValues\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"SubValues", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<UpValues\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"UpValues", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<FormatValues\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"FormatValues", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Options\>\"", ",", 
        RowBox[{
         RowBox[{"ByteCount", "[", 
          RowBox[{"Options", "[", 
           RowBox[{"Unevaluated", "[", "s", "]"}], "]"}], "]"}], "/", 
         RowBox[{"2.", "^", "20"}]}]}], "}"}]}], "}"}], ",", 
    RowBox[{"Frame", "->", "All"}], ",", 
