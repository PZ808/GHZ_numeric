Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "memEval", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"memEval", ",", "HoldRest"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"memEval", "[", 
    RowBox[{"label_", ",", "expr_", ",", 
     RowBox[{"limitGiB_", ":", "2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m0", ",", "result", ",", "timing"}], "}"}], ",", 
     RowBox[{
      RowBox[{"m0", "=", 
       RowBox[{"MemoryInUse", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"label", ",", "\"\< | starting kernel memory: \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"m0", "/", 
           RowBox[{"2", "^", "30"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", "\"\< GiB\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timing", ",", "result"}], "}"}], "=", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"MemoryConstrained", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"Round", "[", 
           RowBox[{"limitGiB", " ", 
            RowBox[{"2", "^", "30"}]}], "]"}], ",", "$Failed"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"label", ",", "\"\< | time: \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"timing", ",", 
          RowBox[{"{", 
           RowBox[{"7", ",", "2"}], "}"}]}], "]"}], 
        ",", "\"\< s | current kernel memory: \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MemoryInUse", "[", "]"}], "/", 
           RowBox[{"2", "^", "30"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", "\"\< GiB\>\"", ",", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"result", "===", "$Failed"}], ",", "\"\< | FAILED\>\"", ",", 
          RowBox[{"\"\< | returned object: \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ByteCount", "[", "result", "]"}], "/", 
               RowBox[{"2", "^", "20"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "1"}], "}"}]}], "]"}], "]"}], 
           "<>", "\"\< MiB\>\""}]}], "]"}]}], "]"}], ";", 
