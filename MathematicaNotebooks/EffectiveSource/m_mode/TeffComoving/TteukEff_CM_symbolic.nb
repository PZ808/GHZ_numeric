 CellLabel->"In[34]:=",ExpressionUUID->"b8ae2fa2-022c-4c19-bbb0-7bcbe7f2915c"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"SetOptions", "[", 
   RowBox[{
    RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
    RowBox[{"NotebookEventActions", "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"\"\<WindowClose\>\"", "\[RuleDelayed]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dy", ",", "mn", ",", "yr"}], "}"}], "=", 
           "\[IndentingNewLine]", "\t   ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"LinkWrite", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "$FrontEnd", "]"}], ",", 
                  RowBox[{"FrontEnd`Value", "[", "#", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "     ", 
                RowBox[{"LinkRead", "[", 
                 RowBox[{"First", "[", "$FrontEnd", "]"}], "]"}]}], ")"}], 
              "&"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Day\>\"", ",", "\"\<MonthName\>\"", 
               ",", "\"\<Second\>\""}], "}"}]}], "]"}]}], ";", 
          RowBox[{"NotebookLocate", "[", "\"\<LastModified\>\"", "]"}], ";", 
          "\[IndentingNewLine]", "\t     ", 
          RowBox[{"NotebookWrite", "[", 
           RowBox[{
            RowBox[{"InputNotebook", "[", "]"}], ",", 
            RowBox[{"Cell", "[", 
             RowBox[{
              RowBox[{"TextData", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Last modified:  \>\"", ",", "dy", 
                 ",", "\"\<, \>\"", ",", "mn", ",", "\"\< \>\"", ",", "yr"}], 
                "}"}], "]"}], ",", "\"\<Text\>\"", ",", 
              RowBox[{"CellTags", "\[Rule]", "\"\<LastModified\>\""}]}], 
             "]"}]}], "]"}]}]}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"d3860e71-896b-44a3-92ff-f135071e7df2"]
