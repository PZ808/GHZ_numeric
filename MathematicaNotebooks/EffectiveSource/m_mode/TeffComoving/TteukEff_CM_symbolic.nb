 RowBox[{
  RowBox[{"buttonevaluable", " ", "=", " ", 
   RowBox[{"ToBoxes", "@", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Button", "[", 
        RowBox[{
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CurrentValue", "[", 
           RowBox[{
            RowBox[{"SelectedCells", "@", 
             RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
           "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
