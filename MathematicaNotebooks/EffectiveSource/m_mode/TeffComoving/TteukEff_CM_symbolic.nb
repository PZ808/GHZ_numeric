Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "aux", "  ", "quantities", " ", "in", " ", "the", " ", "coordinate", " ", 
    "transformation", " ", "between", " ", "X", " ", "and", " ", "x"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myzc", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"2", 
        FractionBox[
         SqrtBox["M"], 
         SqrtBox["r0"]], 
        FractionBox["\[ScriptCapitalB]", 
         RowBox[{"\[CapitalOmega]", " ", "\[ScriptCapitalD]"}]]}], "/.", 
       RowBox[{"r0", "->", 
        RowBox[{"\[Rho]0", " ", "M"}]}]}], "//", "PowerExpand"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalD]expr", "  ", "=", 
     FractionBox[
      SqrtBox[
       RowBox[{
        RowBox[{"2", "\[Alpha]"}], "+", "\[Rho]0", "-", "3"}]], 
      SqrtBox["\[Rho]0"]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalB]expr", " ", "=", " ", 
     FractionBox[
      SqrtBox[
       RowBox[{
        SuperscriptBox["\[Alpha]", "2"], "+", "\[Rho]0", "-", "2"}]], 
      SqrtBox["\[Rho]0"]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]expr", "=", 
