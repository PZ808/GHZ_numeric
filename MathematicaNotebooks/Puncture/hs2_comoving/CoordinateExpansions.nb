Cell[BoxData[{
 RowBox[{
  RowBox[{"myzc", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"2", 
      FractionBox[
       SqrtBox["M"], 
       SqrtBox["r0"]], 
      FractionBox["\[ScriptCapitalB]", 
