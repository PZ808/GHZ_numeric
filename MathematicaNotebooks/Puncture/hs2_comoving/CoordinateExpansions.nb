Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r0", ",", "M", ",", "a", ",", "\[Alpha]", ",", "\[CapitalOmega]", ",", 
       "\[ScriptCapitalB]", ",", "\[ScriptCapitalD]", ",", "zc", ",", 
       RowBox[{"R", "[", "]"}], ",", 
       RowBox[{"X", "[", "]"}], ",", 
       RowBox[{"Y", "[", "]"}], ",", 
       RowBox[{"Z", "[", "]"}]}], "}"}], "\[Element]", "Reals"}], "&&", 
    RowBox[{"zc", ">", "0"}], "&&", 
    RowBox[{"\[ScriptCapitalD]", ">", "0"}], "&&", 
    RowBox[{"\[ScriptCapitalB]", ">", "0"}], "&&", 
    RowBox[{"\[CapitalOmega]", ">", "0"}], "&&", 
    RowBox[{"\[Rho]0", ">", "0"}], "&&", 
    RowBox[{"M", ">", "0"}], "&&", 
    RowBox[{"0", "<", "a", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Alpha]", "<", "1"}], "&&", 
    RowBox[{
     RowBox[{"R", "[", "]"}], ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"-", "zc"}], "<=", 
     RowBox[{"Z", "[", "]"}], "<=", "zc"}], "&&", 
    RowBox[{
     RowBox[{"X", "[", "]"}], "!=", "0"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "M"}], " ", "\[Rho]0"}], "<=", 
