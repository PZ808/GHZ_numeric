Cell[TextData[{
 "We then expand ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "b0adb419-31af-42c4-b0a5-1f92cd4cc0bc"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"Z", "'"}], "2"], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
