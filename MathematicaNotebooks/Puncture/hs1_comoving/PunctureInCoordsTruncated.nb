Peter Zimmerman (based on nb from P. Bourg)
Last Modified Dec 18 2025\
\>", "Author",
 CellChangeTimes->{
  3.975166835306691*^9},ExpressionUUID->"a7194068-2055-446e-a343-\
75664982d565"],

Cell[TextData[{
 "Comoving coordinates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", 
    RowBox[{"\[Mu]", " "}]], TraditionalForm]],ExpressionUUID->
  "39806ad9-36d1-4c27-8f6d-7b0b2fe06d17"],
 "= (T,X,Y,Z) used in this notebook are centered on the particle \n ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["X", "p"], "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "3e7d2ee8-e129-4c29-a931-5e1ec8271c55"],
 " = (T,0,0,0). They\[CloseCurlyQuote]re related to BL (t,r,\[Theta],\[Phi]) \
coordinates by \[LineSeparator]",
 Cell[BoxData[
  RowBox[{"\[LineSeparator]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", 
            SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "t"}], "-", 
         RowBox[{"M", 
          SqrtBox[
           SubscriptBox["\[Rho]", "0"]], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Alpha]", "2"], "-", 
            RowBox[{"2", "\[Alpha]"}], "+", 
            SubscriptBox["\[Rho]", "0"]}], ")"}], "\[Phi]", " "}]}], 
        RowBox[{"\[ScriptCapitalD]", " ", 
         SubscriptBox["\[Rho]", "0"]}]], "=", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", 
             SqrtBox["M"]}], "+", 
            RowBox[{
             SqrtBox[
              SubscriptBox["r", "0"]], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], " ", "M"}], "+", 
               SubscriptBox["r", "0"]}], ")"}]}]}], ")"}], " ", "t", " ", 
          "\[ScriptCapitalD]"}], "-", 
         RowBox[{
          SqrtBox["M"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["a", "2"], "+", 
            SuperscriptBox[
             SubscriptBox["r", "0"], "2"], "-", 
            RowBox[{"2", " ", "a", " ", 
             SqrtBox[
              RowBox[{"M", " ", 
               SubscriptBox["r", "0"]}]]}]}], ")"}], " ", "\[ScriptCapitalD]",
           " ", "\[Phi]"}]}], 
        RowBox[{
         RowBox[{"2", " ", "a", " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["r0"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}], ")"}]}]}]]}]}], ",",
      "\[IndentingNewLine]", "\[LineSeparator]", 
     RowBox[{"X", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"r", "-", 
         RowBox[{"M", " ", 
          SubscriptBox["\[Rho]", "0"]}]}], "\[ScriptCapitalB]"], "=", 
       FractionBox[
        RowBox[{"r", "-", "r0"}], "\[ScriptCapitalB]"]}]}], ",", 
     "\[LineSeparator]", "\[IndentingNewLine]", 
     RowBox[{"Y", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["M\[Rho]", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "=", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["r", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ",", "\[LineSeparator]", 
     "\[IndentingNewLine]", 
     RowBox[{"Z", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["z", "c"], 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{"\[Phi]", "-", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "p"], "t"}]}], "2"], "]"}]}], "=", 
       RowBox[{
        SubscriptBox["z", "c"], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               SqrtBox["M"], " ", "t"}], 
              RowBox[{
               RowBox[{"a", " ", 
                SqrtBox["M"]}], "+", 
               SuperscriptBox["r0", 
                RowBox[{"3", "/", "2"}]]}]]}], "+", "\[Phi]"}], ")"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "where", " ", 
    "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "0"], "=", 
      RowBox[{
       SubscriptBox["r", "0"], "/", "M"}]}], ",", " ", 
     RowBox[{"\[Alpha]", "=", 
      FractionBox["a", 
       SqrtBox[
        RowBox[{"M", " ", 
         SubscriptBox["r", "0"]}]]]}]}], "\[IndentingNewLine]", "and", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SubscriptBox["z", "c"], "=", 
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"M", "/", 
         SubscriptBox["r", "0"]}]], 
       FractionBox["\[ScriptCapitalB]", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "p"], "\[ScriptCapitalD]"}]]}]}], 
     ",", " ", 
     RowBox[{"\[ScriptCapitalB]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Alpha]", "2"], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{"\[ScriptCapitalD]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[Alpha]"}], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "3"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "p"], "=", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"M", " ", "\[Alpha]"}], " ", "+", 
            RowBox[{"M", " ", 
             SubscriptBox["\[Rho]", "0"]}]}], ")"}], 
          SubscriptBox["\[Rho]", "0"]}], ",", " "}]]]}]}], 
