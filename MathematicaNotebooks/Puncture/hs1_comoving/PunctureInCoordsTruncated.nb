     SubscriptBox["z", "c"], 
     RowBox[{"sin", "(", "\[Phi]", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"761b209a-e2a2-4216-b7cf-aae8df9388ba"],
 ", to simplify the integration."
}], "Text",ExpressionUUID->"102ec874-51fb-41d8-916f-1357f0a99094"],

