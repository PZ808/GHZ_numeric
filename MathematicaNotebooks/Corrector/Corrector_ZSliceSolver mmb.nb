   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HeldEthBarRawField", "[", 
     RowBox[{"field_Association", ",", "bg_Association"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "mm", ",", "ss", ",", "\[Omega]", ",", "expr", ",", "\[Lambda]"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"mm", "=", 
