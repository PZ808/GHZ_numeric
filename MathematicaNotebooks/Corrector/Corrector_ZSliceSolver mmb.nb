   RowBox[{
    RowBox[{
     RowBox[{"HierarchySmokeTest", "[", 
      RowBox[{"m0_Integer", ",", "bg_Association", ",", 
       RowBox[{"\[Omega]0_", ":", "0.3"}], ",", 
       RowBox[{"rGrid_", ":", 
        RowBox[{"N", "@", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"2.2", ",", "15.0", ",", "60"}], "]"}]}]}], ",", 
