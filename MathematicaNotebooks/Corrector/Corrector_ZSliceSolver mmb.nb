  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"smooth", " ", "G", " ", "test"}], "-", "function"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SmoothGTest", "[", 
     RowBox[{"r_", ",", "z_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "-", "7"}], ")"}], "^", "2"}]}], "/", "5"}], "]"}], 
     " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "z", "+", 
       RowBox[{"2", " ", 
        RowBox[{"z", "^", "2"}]}], "+", 
       RowBox[{"z", "^", "3"}]}], ")"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OperatorConsistencyDiagnostics", "[", 
     RowBox[{"m0_Integer", ",", "s0_Integer", ",", "bg_Association", ",", 
      RowBox[{"\[Omega]0_", ":", "0.3"}], ",", 
      RowBox[{"fun_", ":", "SmoothGTest"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "g", ",", "raw", ",", "pts", ",", "dP", ",", "dPp", ",", "dE", ",", 
        "dEb", ",", "vP", ",", "vPp", ",", "vE", ",", "vEb"}], "}"}], ",", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"MakeReducedField", "[", 
         RowBox[{
          RowBox[{"fun", "[", 
           RowBox[{"r", ",", "z"}], "]"}], ",", "s0", ",", 
          RowBox[{"{", 
           RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"raw", "=", 
        RowBox[{"MakeRawFieldFromReduced", "[", "g", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dP", "=", 
        RowBox[{"Together", "[", 
         RowBox[{
          RowBox[{"RawExpr", "[", 
           RowBox[{"HeldPRedField", "[", 
            RowBox[{"g", ",", "bg"}], "]"}], "]"}], "-", 
          RowBox[{"RawFieldExpr", "[", 
           RowBox[{"HeldPRawField", "[", 
            RowBox[{"raw", ",", "bg"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dPp", "=", 
        RowBox[{"Together", "[", 
         RowBox[{
          RowBox[{"RawExpr", "[", 
           RowBox[{"HeldPpRedField", "[", 
            RowBox[{"g", ",", "bg"}], "]"}], "]"}], "-", 
          RowBox[{"RawFieldExpr", "[", 
