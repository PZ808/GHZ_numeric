            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gmmbarPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
          RowBox[{"gmmbar", ",", "bg"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"gnmPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
