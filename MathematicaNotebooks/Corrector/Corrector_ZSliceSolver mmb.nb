            RowBox[{"z0", ",", 
             RowBox[{"{", 
              RowBox[{"0.0", ",", "0.0"}], "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solXnn", "=", 
