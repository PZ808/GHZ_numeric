Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"ClearAll", "[", "MakeBoundaryBGFun", "]"}], ";", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"MakeBoundaryBGFun", "[", 
     RowBox[{"bg_Association", ",", 
      RowBox[{"rBoundary_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "z0", "}"}], ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<r\>\"", "->", "rBoundary"}], ",", 
        RowBox[{"\"\<a\>\"", "->", 
         RowBox[{"bg", "[", "\"\<a\>\"", "]"}]}], ",", 
        RowBox[{"\"\<M\>\"", "->", 
         RowBox[{"bg", "[", "\"\<M\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Q\>\"", "->", 
         RowBox[{"bg", "[", "\"\<Q\>\"", "]"}]}], ",", 
        RowBox[{"\"\<rho\>\"", "->", 
         RowBox[{"RhoBG", "[", 
          RowBox[{"bg", ",", "rBoundary", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<rhob\>\"", "->", 
         RowBox[{"RhobBG", "[", 
          RowBox[{"bg", ",", "rBoundary", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", 
         RowBox[{"DeltaBG", "[", 
          RowBox[{"bg", ",", "rBoundary"}], "]"}]}], ",", 
        RowBox[{"\"\<Sigma\>\"", "->", 
         RowBox[{"SigmaBG", "[", 
          RowBox[{"bg", ",", "rBoundary", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<tau0\>\"", "->", 
         RowBox[{"TauHBG", "[", 
          RowBox[{"bg", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<taub0\>\"", "->", 
         RowBox[{"TauHBarBG", "[", 
          RowBox[{"bg", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<rhop0\>\"", "->", 
         RowBox[{"RhopHBG", "[", 
          RowBox[{"bg", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<psi0\>\"", "->", 
         RowBox[{"PsiHBG", "[", 
          RowBox[{"bg", ",", "z0"}], "]"}]}], ",", 
        RowBox[{"\"\<om0\>\"", "->", 
