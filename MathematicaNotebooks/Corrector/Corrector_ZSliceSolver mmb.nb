Cell[CellGroupData[{
Cell["ZSlice Solver", "Title",
 CellChangeTimes->{{3.983421016405958*^9, 
  3.9834210235269413`*^9}},ExpressionUUID->"6e21a065-bac4-4039-a878-\
83d6da4ca04f"],

Cell["P Zimmerman and P Bourg", "Author",
 CellChangeTimes->{{3.983429238090651*^9, 
  3.98342924607045*^9}},ExpressionUUID->"58d889ac-186a-4e48-8fb2-\
32e536561e0a"],

Cell[TextData[{
 "- Solves the upper triangular corrector tensor hierarchy for the NP \
components in {\[Omega],m} modes using a \[OpenCurlyDoubleQuote]z-slice\
\[CloseCurlyDoubleQuote] algorithm which solves the r-transport equations at \
a given z=const from zmin=-1 to zmax =1 \n- Uses reduced differential \
operators with pole safe rescaling\n- Reads in the boundary data and \
effective source from binary\n\ndependency chains \n",
 Cell[BoxData[
  GraphicsBox[
