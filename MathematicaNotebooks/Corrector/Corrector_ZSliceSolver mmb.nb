              RowBox[{"bg", ",", "z0"}], "]"}]}], "]"}], ",", 
           RowBox[{"Function", "[", 
            RowBox[{"z0", ",", 
             RowBox[{"{", 
              RowBox[{"0.0", ",", "0.0"}], "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solXnm", "=", 
