Cell[CellGroupData[{

Cell["Reduced mmbar system only", "Subsection",
 CellChangeTimes->{{3.98352683632866*^9, 
  3.983526843638433*^9}},ExpressionUUID->"c9883014-2b89-45b1-9506-\
d6e8c91ed15a"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "solveCorrectorModeXmmbar", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "solveCorrectorModeXmmbar", "]"}], "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Options", "[", "loadCorrectorData", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<BoundaryTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solveCorrectorModeXmmbar", "[", 
     RowBox[{
     "m_Integer", ",", "bulkDir_String", ",", "bdyDir_String", ",", 
      "bg_Association", ",", "odeCoeffFun_", ",", "rGrid_List", ",", 
      "zGrid_List", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "corrData", ",", "bgFun", ",", "initXmmbar", ",", "sourceFieldXmmbar", 
        ",", "sol", ",", "rmin", ",", "tol"}], "}"}], ",", 
      RowBox[{
       RowBox[{"tol", "=", 
        RowBox[{"OptionValue", "[", "\"\<BoundaryTolerance\>\"", "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rmin", "=", 
        RowBox[{"First", "[", "rGrid", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"corrData", "=", 
        RowBox[{"loadCorrectorData", "[", 
         RowBox[{"m", ",", "bulkDir", ",", "bdyDir", ",", 
          RowBox[{"\"\<BulkPrefix\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<BulkPrefix\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BoundaryPrefix\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<BoundaryPrefix\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BulkInterpolationOrder\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<BulkInterpolationOrder\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BoundaryInterpolationOrder\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<BoundaryInterpolationOrder\>\"", "]"}]}], 
          ",", 
          RowBox[{"\"\<AtParticleAction\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<AtParticleAction\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"corrData", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"corrData", "[", "\"\<Meta\>\"", "]"}], "[", 
             "\"\<rBoundary\>\"", "]"}], "-", "rmin"}], "]"}], ">", "tol"}], 
         ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<solveCorrectorModeXmmbar: boundary mismatch. rBoundary = \
\>\"", ",", 
            RowBox[{
             RowBox[{"corrData", "[", "\"\<Meta\>\"", "]"}], "[", 
             "\"\<rBoundary\>\"", "]"}], ",", "\"\<, rmin = \>\"", ",", 
            "rmin"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bgFun", "=", 
        RowBox[{"MakeBoundaryBGFun", "[", 
         RowBox[{"bg", ",", "rmin"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"initXmmbar", "=", 
        RowBox[{"makeInitDataXmmbar", "[", 
         RowBox[{"corrData", ",", "bgFun"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sourceFieldXmmbar", "=", 
        RowBox[{"makeSourceFieldXmmbarFromBulk", "[", 
         RowBox[{"corrData", ",", "rGrid", ",", "zGrid", ",", "m"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"ZSliceSolveSecondOrder", "[", 
         RowBox[{"sourceFieldXmmbar", ",", "odeCoeffFun", ",", "initXmmbar"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<CorrectorData\>\"", "->", "corrData"}], ",", 
         RowBox[{"\"\<SourceField\>\"", "->", "sourceFieldXmmbar"}], ",", 
         RowBox[{"\"\<InitialData\>\"", "->", "initXmmbar"}], ",", 
         RowBox[{"\"\<Solution\>\"", "->", "sol"}]}], "|>"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.983526828634658*^9, 3.983526829258561*^9}},
 CellLabel->
  "In[221]:=",ExpressionUUID->"e640b5c9-5ad9-46ed-b025-1df406ee531c"]
}, Open  ]]
