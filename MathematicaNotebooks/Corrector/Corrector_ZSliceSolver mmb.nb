Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "readSourceBulkBinaryFile", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"$GHZSrcMagicBytes", ",", "decodeSourceFlags"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$GHZSrcMagicBytes", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ToCharacterCode", "[", "\"\<GHZSRC1\>\"", "]"}], ",", 
       RowBox[{"{", "0", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"decodeSourceFlags", "[", "flags_Integer", "]"}], ":=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<RawFlags\>\"", "->", "flags"}], ",", 
       RowBox[{"\"\<NegativeMIsConjugate\>\"", "->", 
        RowBox[{
         RowBox[{"BitAnd", "[", 
          RowBox[{"flags", ",", "1"}], "]"}], "=!=", "0"}]}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "readSourceBulkBinaryFile", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"readSourceBulkBinaryFile", "[", "file_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stream", ",", "magic", ",", "version", ",", "m", ",", "componentID", 
        ",", "patchID", ",", "yStorageID", ",", "flags", ",", "flagInfo", ",",
         "rp", ",", "B", ",", "nx", ",", "ny", ",", "xGrid", ",", "yGrid", 
        ",", "flat", ",", "data"}], "}"}], ",", 
      RowBox[{
       RowBox[{"stream", "=", 
        RowBox[{"OpenRead", "[", 
         RowBox[{"file", ",", 
          RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"stream", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"magic", "=", 
        RowBox[{"BinaryReadList", "[", 
         RowBox[{"stream", ",", "\"\<Byte\>\"", ",", "8"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"version", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<Integer32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"componentID", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"patchID", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yStorageID", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"flags", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger32\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rp", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<Real64\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"B", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<Real64\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nx", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ny", "=", 
        RowBox[{"BinaryRead", "[", 
         RowBox[{"stream", ",", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xGrid", "=", 
        RowBox[{"BinaryReadList", "[", 
         RowBox[{"stream", ",", "\"\<Real64\>\"", ",", "nx"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yGrid", "=", 
        RowBox[{"BinaryReadList", "[", 
         RowBox[{"stream", ",", "\"\<Real64\>\"", ",", "ny"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"flat", "=", 
        RowBox[{"BinaryReadList", "[", 
         RowBox[{"stream", ",", "\"\<Real64\>\"", ",", 
          RowBox[{"2", " ", "nx", " ", "ny"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"magic", "=!=", "$GHZSrcMagicBytes"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<readSourceBulkBinaryFile: bad magic bytes in \>\"", ",", 
            "file"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Complex", "@@", "#"}], "&"}], ",", 
            RowBox[{"Partition", "[", 
             RowBox[{"flat", ",", "2"}], "]"}]}], "]"}], ",", "ny"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"flagInfo", "=", 
        RowBox[{"decodeSourceFlags", "[", "flags", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Magic\>\"", "->", "magic"}], ",", 
         RowBox[{"\"\<Version\>\"", "->", "version"}], ",", 
         RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<ComponentID\>\"", "->", "componentID"}], ",", 
         RowBox[{"\"\<PatchID\>\"", "->", "patchID"}], ",", 
         RowBox[{"\"\<YStorageID\>\"", "->", "yStorageID"}], ",", 
         RowBox[{"\"\<Flags\>\"", "->", "flags"}], ",", 
         RowBox[{"\"\<NegativeMIsConjugate\>\"", "->", 
          RowBox[{"flagInfo", "[", "\"\<NegativeMIsConjugate\>\"", "]"}]}], 
         ",", 
         RowBox[{"\"\<rp\>\"", "->", "rp"}], ",", 
         RowBox[{"\"\<B\>\"", "->", "B"}], ",", 
         RowBox[{"\"\<nx\>\"", "->", "nx"}], ",", 
         RowBox[{"\"\<ny\>\"", "->", "ny"}], ",", 
         RowBox[{"\"\<XGrid\>\"", "->", "xGrid"}], ",", 
         RowBox[{"\"\<YGrid\>\"", "->", "yGrid"}], ",", 
         RowBox[{"\"\<Data\>\"", "->", "data"}]}], "|>"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"buildComponentMatrix", "[", 
      RowBox[{"fun_", ",", "m_", ",", "XGrid_List", ",", "YGrid_List"}], 
      "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fun", "[", "m", "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "XGrid"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "YGrid"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983432817679742*^9, 3.9834328176823397`*^9}, {
