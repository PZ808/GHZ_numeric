Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "makeBoundaryDerivativeProfiles", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"makeBoundaryDerivativeProfiles", "[", 
   RowBox[{
   "profiles_Association", ",", "m_Integer", ",", "omegaMK_", ",", "s_", ",", 
    "sLm_", ",", "sLmb_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ethTll", ",", "ethTlmb", ",", "ethbarTlm"}], "}"}], ",", 
    RowBox[{
     RowBox[{"ethTll", "=", 
      RowBox[{"heldEthOnMode", "[", 
       RowBox[{
        RowBox[{"profiles", "[", "\"\<TllDeltaPrime\>\"", "]"}], ",", "m", 
        ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ethTlmb", "=", 
      RowBox[{"heldEthOnMode", "[", 
       RowBox[{
        RowBox[{"profiles", "[", "\"\<TlmbDeltaPrime\>\"", "]"}], ",", "m", 
        ",", "sLmb"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ethbarTlm", "=", 
      RowBox[{"heldEthBarOnMode", "[", 
       RowBox[{
        RowBox[{"profiles", "[", "\"\<TlmDeltaPrime\>\"", "]"}], ",", "m", 
        ",", "sLm"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<pduTllDeltaPrime\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "z", "}"}], ",", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "omegaMK", " ", 
           RowBox[{
            RowBox[{"profiles", "[", "\"\<TllDeltaPrime\>\"", "]"}], "[", "z",
             "]"}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<ethTllDeltaPrime\>\"", "->", "ethTll"}], ",", 
       RowBox[{"\"\<ethTlmbDeltaPrime\>\"", "->", "ethTlmb"}], ",", 
       RowBox[{"\"\<ethbarTlmDeltaPrime\>\"", "->", "ethbarTlm"}]}], 
      "|>"}]}]}], "]"}]}]}], "Input",
