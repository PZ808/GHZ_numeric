            RowBox[{"r", ",", "z"}], "]"}], ",", "0", ",", 
           RowBox[{"{", 
            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gnm", "=", 
