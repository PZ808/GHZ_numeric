       RowBox[{"bg", ",", "rminXmmbar"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bgFunXnm", "=", 
      RowBox[{"MakeBoundaryBGFun", "[", 
       RowBox[{"bg", ",", "rminXnm"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bgFunXnn", "=", 
      RowBox[{"MakeBoundaryBGFun", "[", 
       RowBox[{"bg", ",", "rminXnn"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"initXmmbar", "=", 
      RowBox[{"makeInitDataXmmbar", "[", 
       RowBox[{"corrData", ",", "bgFunXmmbar"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"initXnm", "=", 
      RowBox[{"makeInitDataXnm", "[", 
       RowBox[{"corrData", ",", "bgFunXnm", ",", 
        RowBox[{"ops", "[", "\"\<ethTllDeltaPrime\>\"", "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"initXnn", "=", 
      RowBox[{"makeInitDataXnn", "[", 
       RowBox[{"corrData", ",", "bgFunXnn", ",", 
        RowBox[{"ops", "[", "\"\<pduTllDeltaPrime\>\"", "]"}], ",", 
        RowBox[{"ops", "[", "\"\<ethTlmbDeltaPrime\>\"", "]"}], ",", 
        RowBox[{"ops", "[", "\"\<ethbarTlmDeltaPrime\>\"", "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"solXmmbar", "=", 
      RowBox[{"ZSliceSolveSecondOrder", "[", 
       RowBox[{
        RowBox[{"sourceFields", "[", "\"\<Xmmbar\>\"", "]"}], ",", 
        RowBox[{"odeCoeffFuns", "[", "\"\<Xmmbar\>\"", "]"}], ",", 
        "initXmmbar"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solXnm", "=", 
      RowBox[{"ZSliceSolveSecondOrder", "[", 
       RowBox[{
        RowBox[{"sourceFields", "[", "\"\<Xnm\>\"", "]"}], ",", 
        RowBox[{"odeCoeffFuns", "[", "\"\<Xnm\>\"", "]"}], ",", "initXnm"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solXnn", "=", 
      RowBox[{"ZSliceSolveFirstOrder", "[", 
       RowBox[{
        RowBox[{"sourceFields", "[", "\"\<Xnn\>\"", "]"}], ",", 
        RowBox[{"odeCoeffFuns", "[", "\"\<Xnn\>\"", "]"}], ",", "initXnn"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"returnIntermediateQ", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<CorrectorData\>\"", "->", "corrData"}], ",", 
         RowBox[{"\"\<BoundaryProfiles\>\"", "->", "profiles"}], ",", 
         RowBox[{"\"\<BoundaryDerivativeProfiles\>\"", "->", "ops"}], ",", 
         RowBox[{"\"\<InitialData\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Xmmbar\>\"", "->", "initXmmbar"}], ",", 
            RowBox[{"\"\<Xnm\>\"", "->", "initXnm"}], ",", 
            RowBox[{"\"\<Xnn\>\"", "->", "initXnn"}]}], "|>"}]}], ",", 
         RowBox[{"\"\<Solutions\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Xmmbar\>\"", "->", "solXmmbar"}], ",", 
            RowBox[{"\"\<Xnm\>\"", "->", "solXnm"}], ",", 
            RowBox[{"\"\<Xnn\>\"", "->", "solXnn"}]}], "|>"}]}]}], "|>"}], 
       ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "m"}], ",", 
         RowBox[{"\"\<Solutions\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Xmmbar\>\"", "->", "solXmmbar"}], ",", 
            RowBox[{"\"\<Xnm\>\"", "->", "solXnm"}], ",", 
            RowBox[{"\"\<Xnn\>\"", "->", "solXnn"}]}], "|>"}]}]}], "|>"}]}], 
      "]"}]}]}], "]"}]}]}], "Input",
