  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readWorldtubeModeData", "[", 
    RowBox[{"dir_String", ",", "m_Integer", ",", 
     RowBox[{"prefix_", ":", "\"\<Teff\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mStored", "=", 
       RowBox[{"Abs", "[", "m", "]"}]}], "}"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Left\>\"", "->", 
        RowBox[{"readSourcePatchData", "[", 
         RowBox[{"dir", ",", "mStored", ",", "\"\<left\>\"", ",", "prefix"}], 
         "]"}]}], ",", 
       RowBox[{"\"\<Right\>\"", "->", 
        RowBox[{"readSourcePatchData", "[", 
         RowBox[{"dir", ",", "mStored", ",", "\"\<right\>\"", ",", "prefix"}],
          "]"}]}]}], "|>"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9834504529676847`*^9, 3.9834504556171913`*^9}},
