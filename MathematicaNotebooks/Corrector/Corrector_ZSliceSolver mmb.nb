              RowBox[{"bg", ",", "z0"}], "]"}]}], "]"}], ",", 
           RowBox[{"Function", "[", 
            RowBox[{"z0", ",", "0.0"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xmmbarField", "=", 
