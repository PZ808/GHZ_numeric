Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readSourcePatchData", "[", 
      RowBox[{"dir_String", ",", "m_Integer", ",", "patch_String", ",", 
       RowBox[{"prefix_", ":", "\"\<Teff\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mStored", "=", 
         RowBox[{"Abs", "[", "m", "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<left\>\"", ",", "\"\<right\>\""}], "}"}], ",", 
             "patch"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<readSourcePatchData: patch must be \\\"left\\\" or \\\"right\
\\\".\>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"readSourceBulkBinaryFile", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", 
               RowBox[{
                RowBox[{
                "StringTemplate", "[", "\"\<``_``_m``_``.bin\>\"", "]"}], "[", 
                RowBox[{"prefix", ",", "#", ",", "mStored", ",", "patch"}], 
                "]"}]}], "}"}], "]"}], "]"}], "&"}], ",", 
          "$GHZSrcComponents"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"makePatchComponentSamplers", "[", 
       RowBox[{"patchData_Association", ",", 
        RowBox[{"order_", ":", "1"}]}], "]"}], ":=", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
