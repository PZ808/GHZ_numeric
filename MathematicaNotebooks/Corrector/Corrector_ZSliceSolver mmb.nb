bbb15d239a6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Regularity", " ", "diagnostics", " ", "and", " ", 
    RowBox[{"tests", ":", " ", 
     RowBox[{
     "check", " ", "numerical", " ", "regularity", " ", "tests", " ", "near", 
      " ", "the", " ", "poles"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "RegularityTests", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "NumericGridValues", ",", "RegularityDiagnostics", ",", 
      "RegularityTests"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NumericGridValues", "[", 
      RowBox[{"expr_", ",", "pts_List"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"NumericValueAt", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", "pts"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RegularityDiagnostics", "[", 
      RowBox[{"m0_Integer", ",", "bg_Association", ",", 
       RowBox[{"\[Omega]0_", ":", "0.3"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "gmmbar", ",", "gnm", ",", "gmmbarPack", ",", "gnmPack", ",", 
         "sxnmRed", ",", "sxnnRed", ",", "ptsNearPoles", ",", "vals1", ",", 
         "vals2", ",", "bad1", ",", "bad2"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gmmbar", "=", 
         RowBox[{"MakeReducedField", "[", 
          RowBox[{
           RowBox[{"SmoothG0", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "0", ",", 
           RowBox[{"{", 
            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gnm", "=", 
         RowBox[{"MakeReducedField", "[", 
          RowBox[{
           RowBox[{"SmoothG1", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"gmmbarPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
          RowBox[{"gmmbar", ",", "bg"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"gnmPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
          RowBox[{"gnm", ",", "bg"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"sxnmRed", "=", 
         RowBox[{"SourceXnmReducedExpr", "[", 
          RowBox[{"gmmbarPack", ",", "bg", ",", "0", ",", "\"\<Raw\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sxnnRed", "=", 
         RowBox[{"SourceXnnReducedExpr", "[", 
          RowBox[{
          "gmmbarPack", ",", "gnmPack", ",", "bg", ",", "0", ",", 
           "\"\<Raw\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"ptsNearPoles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"SamplePointsRZ", "[", 
            RowBox[{"2.2", ",", "15.0", ",", "7", ",", 
             RowBox[{"-", "0.999"}], ",", 
             RowBox[{"-", "0.9"}], ",", "6"}], "]"}], ",", 
           RowBox[{"SamplePointsRZ", "[", 
            RowBox[{
            "2.2", ",", "15.0", ",", "7", ",", "0.9", ",", "0.999", ",", 
             "6"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vals1", "=", 
         RowBox[{"NumericGridValues", "[", 
          RowBox[{"sxnmRed", ",", "ptsNearPoles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals2", "=", 
         RowBox[{"NumericGridValues", "[", 
          RowBox[{"sxnnRed", ",", "ptsNearPoles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bad1", "=", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"ptsNearPoles", ",", "vals1"}], "}"}], "]"}], ",", 
           RowBox[{"Not", "/@", 
            RowBox[{"(", 
             RowBox[{"NumericQ", "/@", "vals1"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bad2", "=", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"ptsNearPoles", ",", "vals2"}], "}"}], "]"}], ",", 
           RowBox[{"Not", "/@", 
            RowBox[{"(", 
             RowBox[{"NumericQ", "/@", "vals2"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Points\>\"", "->", "ptsNearPoles"}], ",", 
          RowBox[{"\"\<sxnmValues\>\"", "->", "vals1"}], ",", 
          RowBox[{"\"\<sxnnValues\>\"", "->", "vals2"}], ",", 
          RowBox[{"\"\<sxnmBadValues\>\"", "->", "bad1"}], ",", 
          RowBox[{"\"\<sxnnBadValues\>\"", "->", "bad2"}], ",", 
          RowBox[{"\"\<sxnmMaxAbs\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"bad1", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", "vals1", "]"}], "]"}], ",", 
             RowBox[{"Missing", "[", "\"\<NonNumeric\>\"", "]"}]}], "]"}]}], 
          ",", 
          RowBox[{"\"\<sxnnMaxAbs\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"bad2", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", "vals2", "]"}], "]"}], ",", 
             RowBox[{"Missing", "[", "\"\<NonNumeric\>\"", "]"}]}], "]"}]}]}],
          "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RegularityTests", "[", 
      RowBox[{"m0_Integer", ",", "bg_Association", ",", 
       RowBox[{"\[Omega]0_", ":", "0.3"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "diag", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"diag", "=", 
         RowBox[{"RegularityDiagnostics", "[", 
          RowBox[{"m0", ",", "bg", ",", "\[Omega]0"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"TestReport", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"VerificationTest", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"diag", "[", "\"\<sxnmBadValues\>\"", "]"}], "===", 
              RowBox[{"{", "}"}]}], ",", "True", ",", "\[IndentingNewLine]", 
             RowBox[{
             "TestID", "->", 
              "\"\<xnm reduced source numeric near poles\>\""}]}], "]"}], ",", 
           RowBox[{"VerificationTest", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"diag", "[", "\"\<sxnnBadValues\>\"", "]"}], "===", 
              RowBox[{"{", "}"}]}], ",", "True", ",", 
             RowBox[{
             "TestID", "->", 
              "\"\<xnn reduced source numeric near poles\>\""}]}], "]"}]}], 
          "}"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 Evaluatable->False,
