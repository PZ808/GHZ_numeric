          RowBox[{
           RowBox[{"-", "0.98"}], ",", "0.98", ",", "24"}], "]"}]}]}]}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "gmmbar", ",", "gnm", ",", "gmmbarPack", ",", "gnmPack", ",", 
         "sxmmbRed", ",", "sxnmRed", ",", "sxnnRed", ",", "sxmmbField", ",", 
         "sxnmField", ",", "sxnnField", ",", "solXmmb", ",", "solXnm", ",", 
