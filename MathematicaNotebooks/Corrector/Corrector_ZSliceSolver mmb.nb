              " ", "expr"}]}], ")"}]}], ",", 
         RowBox[{"ss", "-", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Omega]", ",", "mm"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
