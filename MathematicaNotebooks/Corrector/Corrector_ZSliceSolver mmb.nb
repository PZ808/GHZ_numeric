Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Source", " ", "consistency", " ", "tests"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Numeric", " ", "source", " ", "consistency", " ", 
    RowBox[{"diagnostics", "/", "tests"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "SmoothTll", ",", "SmoothTlm", ",", "SmoothTln", ",", 
      "SourceConsistencyDiagnostics", ",", "SourceConsistencyTests"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SmoothTll", "[", 
      RowBox[{"r_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "6"}], ")"}], "^", "2"}]}], "/", "6"}], "]"}], 
      " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"z", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SmoothTlm", "[", 
      RowBox[{"r_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "8"}], ")"}], "^", "2"}]}], "/", "7"}], "]"}], 
      " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "z", "+", 
        RowBox[{"z", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SmoothTln", "[", 
      RowBox[{"r_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "9"}], ")"}], "^", "2"}]}], "/", "8"}], "]"}], 
      " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"z", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SourceConsistencyDiagnostics", "[", 
      RowBox[{"m0_Integer", ",", "bg_Association", ",", 
       RowBox[{"\[Omega]0_", ":", "0.3"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "gmmbar", ",", "gnm", ",", "gmmbarPack", ",", "gnmPack", ",", 
         "sxmmbRed", ",", "sxnmRed", ",", "sxnnRed", ",", "sxmmbRaw", ",", 
         "sxnmRaw", ",", "sxnnRaw", ",", "d0", ",", "d1", ",", "d2", ",", 
         "pts", ",", "v0", ",", "v1", ",", "v2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"gmmbar", "=", 
         RowBox[{"MakeReducedField", "[", 
          RowBox[{
           RowBox[{"SmoothG0", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "0", ",", 
           RowBox[{"{", 
            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gnm", "=", 
         RowBox[{"MakeReducedField", "[", 
          RowBox[{
           RowBox[{"SmoothG1", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gmmbarPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
          RowBox[{"gmmbar", ",", "bg"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"gnmPack", "=", 
         RowBox[{"BuildReducedHeldDerivPack", "[", 
          RowBox[{"gnm", ",", "bg"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sxmmbRed", "=", 
         RowBox[{"SourceXmmbReducedExpr", "[", 
          RowBox[{"m0", ",", 
           RowBox[{"SmoothTll", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "\"\<Raw\>\""}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"sxnmRed", "=", 
         RowBox[{"SourceXnmReducedExpr", "[", 
          RowBox[{"gmmbarPack", ",", "bg", ",", 
           RowBox[{"SmoothTlm", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "\"\<Raw\>\""}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"sxnnRed", "=", 
         RowBox[{"SourceXnnReducedExpr", "[", 
          RowBox[{"gmmbarPack", ",", "gnmPack", ",", "bg", ",", 
           RowBox[{"SmoothTln", "[", 
            RowBox[{"r", ",", "z"}], "]"}], ",", "\"\<Raw\>\""}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"sxmmbRaw", "=", 
         RowBox[{"SmoothTll", "[", 
          RowBox[{"r", ",", "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sxnmRaw", "=", 
         RowBox[{
          RowBox[{"NofXmmbRawExpr", "[", 
           RowBox[{"gmmbarPack", ",", "bg"}], "]"}], "+", 
          RowBox[{"SmoothTlm", "[", 
           RowBox[{"r", ",", "z"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sxnnRaw", "=", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"SmoothTln", "[", 
            RowBox[{"r", ",", "z"}], "]"}], "]"}], "+", 
          RowBox[{"Re", "[", 
           RowBox[{"UofXmmbRawExpr", "[", 
            RowBox[{"gmmbarPack", ",", "bg"}], "]"}], "]"}], "+", 
          RowBox[{"Re", "[", 
           RowBox[{"VofXnmRawExpr", "[", 
            RowBox[{"gnmPack", ",", "bg"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d0", "=", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TargetWeight", "[", 
             RowBox[{"m0", ",", "0"}], "]"}], " ", "sxmmbRed"}], "-", 
           "sxmmbRaw"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"d1", "=", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TargetWeight", "[", 
             RowBox[{"m0", ",", "1"}], "]"}], " ", "sxnmRed"}], "-", 
           "sxnmRaw"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"d2", "=", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TargetWeight", "[", 
             RowBox[{"m0", ",", "0"}], "]"}], " ", "sxnnRed"}], "-", 
           "sxnnRaw"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pts", "=", 
         RowBox[{"SamplePointsRZ", "[", 
          RowBox[{"2.5", ",", "12.0", ",", "6", ",", 
           RowBox[{"-", "0.95"}], ",", "0.95", ",", "7"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"v0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericValueAt", "[", 
            RowBox[{"d0", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", "pts"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"v1", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericValueAt", "[", 
            RowBox[{"d1", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", "pts"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"v2", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericValueAt", "[", 
            RowBox[{"d2", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", "pts"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<xmmbDiffExpr\>\"", "->", "d0"}], ",", 
          RowBox[{"\"\<xnmDiffExpr\>\"", "->", "d1"}], ",", 
          RowBox[{"\"\<xnnDiffExpr\>\"", "->", "d2"}], ",", 
          RowBox[{"\"\<xmmbMaxAbs\>\"", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "v0", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<xnmMaxAbs\>\"", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "v1", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<xnnMaxAbs\>\"", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "v2", "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SourceConsistencyTests", "[", 
      RowBox[{"m0_Integer", ",", "bg_Association", ",", 
       RowBox[{"\[Omega]0_", ":", "0.3"}], ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "diag", "}"}], ",", 
       RowBox[{
        RowBox[{"diag", "=", 
         RowBox[{"SourceConsistencyDiagnostics", "[", 
          RowBox[{"m0", ",", "bg", ",", "\[Omega]0"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"TestReport", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VerificationTest", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"diag", "[", "\"\<xmmbMaxAbs\>\"", "]"}], "]"}], "&&", 
              
              RowBox[{
               RowBox[{"diag", "[", "\"\<xmmbMaxAbs\>\"", "]"}], "<", 
               "tol"}]}], ",", "True", ",", 
             RowBox[{
             "TestID", "->", "\"\<xmmb reduced/raw consistency\>\""}]}], 
            "]"}], ",", 
           RowBox[{"VerificationTest", "[", 
            RowBox[{
