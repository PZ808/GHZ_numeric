Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "solveCorrectorMode", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "solveCorrectorMode", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "loadCorrectorData", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<CheckBoundaryRadius\>\"", "->", "True"}], ",", 
        RowBox[{"\"\<BoundaryTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<ReturnIntermediateData\>\"", "->", "True"}]}], "}"}]}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", "  ", 
   RowBox[{"mode", " ", "pairs", " ", "has", " ", "the", " ", "form", " ", 
    RowBox[{"<|", 
     RowBox[{
