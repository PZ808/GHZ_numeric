  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OperatorConsistencyTests", "[", 
     RowBox[{"m0_Integer", ",", "s0_Integer", ",", "bg_Association", ",", 
      RowBox[{"\[Omega]0_", ":", "0.3"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", ",", "raw", ",", "tests"}], "}"}], ",", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"MakeReducedField", "[", 
         RowBox[{
          RowBox[{"G", "[", 
           RowBox[{"r", ",", "z"}], "]"}], ",", "s0", ",", 
          RowBox[{"{", 
           RowBox[{"\[Omega]0", ",", "m0"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"raw", "=", 
        RowBox[{"MakeRawFieldFromReduced", "[", "g", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tests", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VerificationTest", "[", 
           RowBox[{
            RowBox[{"ExprEqualQ", "[", 
             RowBox[{
              RowBox[{"RawExpr", "[", 
               RowBox[{"HeldPRedField", "[", 
                RowBox[{"g", ",", "bg"}], "]"}], "]"}], ",", 
              RowBox[{"RawFieldExpr", "[", 
               RowBox[{"HeldPRawField", "[", 
                RowBox[{"raw", ",", "bg"}], "]"}], "]"}]}], "]"}], ",", 
            "True", ",", 
            RowBox[{"TestID", "->", "\"\<thorn consistency\>\""}]}], "]"}], 
          ",", 
          RowBox[{"VerificationTest", "[", 
           RowBox[{
            RowBox[{"ExprEqualQ", "[", 
             RowBox[{
              RowBox[{"RawExpr", "[", 
               RowBox[{"HeldPpRedField", "[", 
                RowBox[{"g", ",", "bg"}], "]"}], "]"}], ",", 
              RowBox[{"RawFieldExpr", "[", 
               RowBox[{"HeldPpRawField", "[", 
                RowBox[{"raw", ",", "bg"}], "]"}], "]"}]}], "]"}], ",", 
            "True", ",", 
            RowBox[{"TestID", "->", "\"\<thornPrime consistency\>\""}]}], 
           "]"}], ",", 
          RowBox[{"VerificationTest", "[", 
           RowBox[{
            RowBox[{"ExprEqualQ", "[", 
             RowBox[{
              RowBox[{"RawExpr", "[", 
               RowBox[{"HeldEthRedField", "[", 
                RowBox[{"g", ",", "bg"}], "]"}], "]"}], ",", 
              RowBox[{"RawFieldExpr", "[", 
               RowBox[{"HeldEthRawField", "[", 
                RowBox[{"raw", ",", "bg"}], "]"}], "]"}]}], "]"}], ",", 
            "True", ",", 
            RowBox[{"TestID", "->", "\"\<eth consistency\>\""}]}], "]"}], ",", 
          RowBox[{"VerificationTest", "[", 
           RowBox[{
            RowBox[{"ExprEqualQ", "[", 
             RowBox[{
              RowBox[{"RawExpr", "[", 
               RowBox[{"HeldEthBarRedField", "[", 
                RowBox[{"g", ",", "bg"}], "]"}], "]"}], ",", 
              RowBox[{"RawFieldExpr", "[", 
               RowBox[{"HeldEthBarRawField", "[", 
                RowBox[{"raw", ",", "bg"}], "]"}], "]"}]}], "]"}], ",", 
            "True", ",", 
            RowBox[{"TestID", "->", "\"\<ethbar consistency\>\""}]}], "]"}]}],
          "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"TestReport", "[", "tests", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
