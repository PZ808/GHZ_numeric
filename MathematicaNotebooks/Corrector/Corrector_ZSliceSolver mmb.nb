        RowBox[{"\"\<Tll\>\"", "->", "0"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"solveCorrectorModeXmmbar", "[", 
     RowBox[{
     "m_Integer", ",", "bulkDir_String", ",", "bdyDir_String", ",", 
      "bg_Association", ",", "odeCoeffFun_", ",", "rGrid_List", ",", 
      "zGrid_List", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "corrData", ",", "bgFun", ",", "initXmmbar", ",", "sourceFieldXmmbar", 
        ",", "sol", ",", "rmin", ",", "tol"}], "}"}], ",", 
      RowBox[{
       RowBox[{"tol", "=", 
        RowBox[{"OptionValue", "[", "\"\<BoundaryTolerance\>\"", "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"rmin", "=", 
        RowBox[{"First", "[", "rGrid", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"corrData", "=", 
        RowBox[{"loadCorrectorData", "[", 
         RowBox[{"m", ",", "bulkDir", ",", "bdyDir", ",", 
          RowBox[{"\"\<BulkPrefix\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<BulkPrefix\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BoundaryPrefix\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<BoundaryPrefix\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BulkInterpolationOrder\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<BulkInterpolationOrder\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BoundaryInterpolationOrder\>\"", "->", 
           RowBox[{
           "OptionValue", "[", "\"\<BoundaryInterpolationOrder\>\"", "]"}]}], 
          ",", 
          RowBox[{"\"\<AtParticleAction\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<AtParticleAction\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"corrData", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"corrData", "[", "\"\<Meta\>\"", "]"}], "[", 
