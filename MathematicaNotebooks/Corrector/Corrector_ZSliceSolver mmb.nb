            RowBox[{
             RowBox[{"diag", "[", "\"\<thornPrimeMaxAbs\>\"", "]"}], "<", 
             "tol"}]}], ",", "True", ",", 
           RowBox[{"TestID", "->", "\"\<thornPrime consistency\>\""}]}], 
          "]"}], ",", 
         RowBox[{"VerificationTest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", 
             RowBox[{"diag", "[", "\"\<ethMaxAbs\>\"", "]"}], "]"}], "&&", 
            RowBox[{
             RowBox[{"diag", "[", "\"\<ethMaxAbs\>\"", "]"}], "<", "tol"}]}], 
           ",", "True", ",", 
           RowBox[{"TestID", "->", "\"\<eth consistency\>\""}]}], "]"}], ",", 
         
         RowBox[{"VerificationTest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", 
             RowBox[{"diag", "[", "\"\<ethbarMaxAbs\>\"", "]"}], "]"}], "&&", 
            
            RowBox[{
             RowBox[{"diag", "[", "\"\<ethbarMaxAbs\>\"", "]"}], "<", 
             "tol"}]}], ",", "True", ",", 
