Cell[CellGroupData[{

Cell["Configurations (from Patrick)", "Subsubsection",
 CellChangeTimes->{{3.758357588711343*^9, 3.758357589303277*^9}, {
  3.760967268887353*^9, 3.7609672705428553`*^9}, {3.76139869026855*^9, 
  3.761398693588196*^9}, {3.761400098643458*^9, 3.761400103978828*^9}, {
  3.982940290733377*^9, 
  3.982940295060429*^9}},ExpressionUUID->"423d9460-7a02-4c5a-9a4c-\
737f07d0e848"],

Cell[CellGroupData[{

Cell["Keyboard shortcuts", "Subsubsubsection",
 CellChangeTimes->{{3.760191889651951*^9, 
  3.7601918966393347`*^9}},ExpressionUUID->"e8a6c76c-071c-4124-b8e1-\
c40a6c4fc7a0"],

Cell[TextData[{
 "\tThe following allows to auto-replace stuff when you write \
\[OpenCurlyDoubleQuote]tex[\[CloseCurlyDoubleQuote] into \
\[OpenCurlyDoubleQuote]TeXForm[StandardForm[]]\[CloseCurlyDoubleQuote],\n\t\
which is what is needed to  output ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"L", 
     StyleBox[
      AdjustmentBox["A",
       BoxBaselineShift->-0.4,
       BoxMargins->{{-0.5, -0.3}, {0, 0}}],
      FontSize->Smaller], "T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "e592b400-6c27-4d8f-b780-48de39a70502"],
 " code of an equation. The StandardForm is needed if using the notation \
package."
}], "Text",
 CellChangeTimes->{{3.7601919042878942`*^9, 3.760192013317361*^9}, {
  3.761758056639923*^9, 3.761758063903331*^9}, {3.770032519536647*^9, 
  3.770032545482421*^9}, {3.89358794986084*^9, 3.893587958560437*^9}, {
  3.897974581100947*^9, 
  3.897974584495674*^9}},ExpressionUUID->"31c8c09a-1b85-4b61-8291-\
8df6795a3540"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"CurrentValue", "[", 
    RowBox[{
     RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"InputAutoReplacements", ",", "\"\<tex\>\""}], "}"}]}], "]"}], ":=",
    "\[IndentingNewLine]", "\t", 
   RowBox[{"RowBox", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<TeXForm\>\"", ",", "\"\<[\>\"", ",", 
      RowBox[{"RowBox", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<StandardForm\>\"", ",", "\"\<\>\"", ",", "\"\<]\>\""}], 
        "}"}], "]"}], ",", "\"\<]\>\""}], "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.760191741926221*^9, 3.76019174192828*^9}, {
  3.760191819083969*^9, 3.7601918687946672`*^9}, {3.760192014215056*^9, 
  3.760192014952837*^9}, {3.7617580591026497`*^9, 3.7617580702793207`*^9}, {
  3.8979745862112713`*^9, 3.897974596731505*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"deab35f1-dab8-4636-aa0c-e069dba1b218"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Palettes and docked buttons", "Subsubsubsection",
 CellChangeTimes->{{3.762002502126274*^9, 3.762002506162354*^9}, {
  3.7673339124027567`*^9, 
  3.767333919106395*^9}},ExpressionUUID->"e80ebf5b-df6f-46c7-9513-\
9ce7bd0a1c9d"],

Cell["\<\
\tBelow is the full docked buttons code. In the following sections, we \
explain each part.\
\>", "Text",
 CellChangeTimes->{{3.7673343824376173`*^9, 3.767334415844964*^9}, {
  3.7700289491928368`*^9, 3.770028959512562*^9}, {3.8979745265166597`*^9, 
  3.897974527825539*^9}},ExpressionUUID->"1a0caf7d-bb4d-4121-b3f9-\
ca6046a576c9"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9834211005662127`*^9, 3.9834211023092117`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"dddff4fd-ea52-4145-b99a-68fa135acae8"],

Cell[CellGroupData[{

Cell["Correctly re-enable evaluation property", "Subsubsubsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.762002514219326*^9, 
  3.7620025247075577`*^9}},ExpressionUUID->"a01f5f53-386c-4dfb-95ee-\
f83b1c384978"],

Cell["\<\
\tThis part of the above code creates a docked button that easily allows to \
deactivate cell evaluation and re - enable it,
\twhile keeping the texts, outputs,etc default (not evaluable).  \
Specifically, \[OpenCurlyDoubleQuote]re-enable\[CloseCurlyDoubleQuote] in \
fact just sets properties back to default.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.7620025283983707`*^9, 3.762002653775247*^9}, {
  3.767333803125916*^9, 3.767333810069026*^9}, {3.767334453236224*^9, 
  3.767334455964188*^9}, {3.8979745502005777`*^9, 
  3.897974554274568*^9}},ExpressionUUID->"1de119b8-2b3d-46f6-a54c-\
81e5aec8305b"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonevaluable", " ", "=", " ", 
    RowBox[{"ToBoxes", "@", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Button", "[", 
         RowBox[{
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CurrentValue", "[", 
            RowBox[{
             RowBox[{"SelectedCells", "@", 
              RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
            "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.767333531414897*^9, 3.767333548375959*^9}, {
   3.7673336081872797`*^9, 3.767333622683069*^9}, {3.767333752783671*^9, 
   3.767333761976211*^9}, 3.77002782470183*^9, {3.8979745565450783`*^9, 
   3.897974561744177*^9}, {3.9195693402399817`*^9, 3.919569340428852*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"feea2f82-a31d-48e9-ade6-d32c083ee830"],

Cell["\<\
\tThe below code does the same thing, but it creates a palette instead. Kept \
it for archive purposes.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.7673338322712193`*^9, 3.767333874132453*^9}, {
  3.77002894251302*^9, 3.770028946009004*^9}, {3.897974564326116*^9, 
  3.897974564685095*^9}},ExpressionUUID->"cb533d81-75a9-4ec4-bc80-\
2d4836dbfe79"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{"(*", 
   RowBox[{"CreatePalette", "@", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Button", "[", 
        RowBox[{
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<Evaluatable -> ``\>\"", ",", "#"}], "]"}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"CurrentValue", "[", 
           RowBox[{
            RowBox[{"SelectedCells", "@", 
             RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
           "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}], 
   "*)"}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.762002661603444*^9, 3.7620026639591093`*^9}, {
  3.7673338237102613`*^9, 3.767333827148489*^9}, {3.897974569615777*^9, 
  3.897974575393712*^9}},ExpressionUUID->"b651e5e2-0fcf-49e0-9617-\
c1717c0564ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Full docked buttons", "Subsubsubsubsection",
 CellChangeTimes->{{3.767334421497847*^9, 
  3.767334428492256*^9}},ExpressionUUID->"6e4f5a29-6bab-49c9-966e-\
ebcb7f6a802b"],

Cell["\<\
\t\t\t\tImplementation of each part as a docked cell. For adding new \
features, simply create new data as shown for the above two buttons, i.e. \
ToBoxes[stuff] and then put it inside the BoxData.
\t\t\t\tThe next lines shoul not be touched and their purpose is to make the \
toolbar expand/collapse upon clicking of the bottom panel.\
\>", "Text",
 CellChangeTimes->{{3.7700290356860733`*^9, 3.770029173865818*^9}, 
   3.8833786476108437`*^9},ExpressionUUID->"c26af33a-652d-4d0f-8c9f-\
aad28e982938"],

Cell[BoxData[
 RowBox[{"\t\t\t\t", 
  RowBox[{
   RowBox[{
    RowBox[{"fullDockedCellsWithCollapseToolbar", "=", 
     RowBox[{"Cell", "[", 
      RowBox[{
       RowBox[{"BoxData", "[", 
        RowBox[{"{", 
         RowBox[{"buttonalignment", ",", "buttonevaluable"}], "}"}], "]"}], 
       ",", " ", "\[IndentingNewLine]", "\t\t\t\t\t", 
       RowBox[{"CellFrameLabelMargins", "\[Rule]", "0"}], ",", 
       RowBox[{"CellFrameLabels", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ButtonBox", "[", 
             RowBox[{"\"\<\>\"", ",", "\[IndentingNewLine]", "\t\t\t\t", 
              RowBox[{"ButtonFunction", "\[RuleDelayed]", 
               RowBox[{"Function", "[", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"pc", "=", 
                    RowBox[{"ParentCell", "@", 
                    RowBox[{"EvaluationCell", "[", "]"}]}]}], "}"}], ",", 
                  RowBox[{"SetOptions", "[", 
                   RowBox[{"pc", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"CurrentValue", "[", 
                    RowBox[{"pc", ",", "CellSize"}], "]"}], "===", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "Inherited"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                    "\t\t\t\t", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "Inherited"}]}], 
                    "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CellSize", "\[Rule]", "0"}], ",", 
                    RowBox[{"CellElementSpacings", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"\"\<CellMinHeight\>\"", "\[Rule]", "0"}], 
                    "}"}]}], ",", 
                    RowBox[{"CellFrameMargins", "\[Rule]", "0"}]}], "}"}]}], 
                    "]"}]}], "]"}]}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"ImageSize", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Scaled", "[", "2", "]"}], ",", "15"}], "}"}]}], ",", 
              RowBox[{"Evaluator", "\[Rule]", "Automatic"}]}], "]"}], ",", 
            "None"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\t\t\t\t", 
   RowBox[{"SetOptions", "[", 
    RowBox[{
     RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
     RowBox[{
     "DockedCells", "\[Rule]", "fullDockedCellsWithCollapseToolbar"}]}], 
    "]"}], "\[IndentingNewLine]", "\t\t\t\t", 
   RowBox[{"Clear", "[", 
    RowBox[{"buttonalignment", ",", "buttonevaluable"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.770025318638297*^9, 3.770025318638781*^9}, {
   3.7700258231894093`*^9, 3.7700258521002827`*^9}, {3.7700258828440104`*^9, 
   3.7700258870832376`*^9}, {3.7700259317144413`*^9, 3.770025976112444*^9}, {
   3.770026061774335*^9, 3.770026071117613*^9}, {3.770026102893291*^9, 
   3.770026135444914*^9}, {3.770026210274729*^9, 3.770026214713163*^9}, 
   3.7700275691012383`*^9, {3.7700276111871347`*^9, 3.770027691976449*^9}, {
   3.7700289970957003`*^9, 3.770029026902608*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"8ffa2529-aabd-4b9c-9b6c-500b5a7e80ab"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate Grid", "Chapter",
 CellChangeTimes->{{3.983525800242745*^9, 
  3.983525802332642*^9}},ExpressionUUID->"2cdc8e7f-bc0a-4cbe-9ee5-\
3d4a45f9f3fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rGrid", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"8", ",", "20", ",", "120"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zGrid", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1", ",", "20"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"cb4458cc-5f61-461c-9e90-f50707808aca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read the input source data ", "Chapter",
 CellChangeTimes->{{3.9834268851273327`*^9, 
  3.983426892973506*^9}},ExpressionUUID->"3eb84e61-6ce8-4583-b339-\
4c92173828ce"],

Cell["\<\
A couple of useful conventions are built in:
- it interprets X = (r-rp)/B,
- it interprets Y = -rp z,
- if YStorage -> \[OpenCurlyDoubleQuote]HalfWithEvenReflection\
\[CloseCurlyDoubleQuote], it evaluates using Abs[Y],
- if m<0 and the metadata says NegativeMIsConjugate -> True, it loads |m| and \
returns the conjugate.\
\>", "Abstract",
