Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"ClearAll", "[", "makeBulkSourceSampler", "]"}], ";", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"makeBulkSourceSampler", "[", 
     RowBox[{"src_Association", ",", 
      RowBox[{"order_", ":", "3"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "xGrid", ",", "yGrid", ",", "data", ",", "reIF", ",", "imIF", ",", 
        "yStorageID", ",", "rp", ",", "B"}], "}"}], ",", 
      RowBox[{
       RowBox[{"xGrid", "=", 
        RowBox[{"src", "[", "\"\<XGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yGrid", "=", 
        RowBox[{"src", "[", "\"\<YGrid\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"src", "[", "\"\<Data\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yStorageID", "=", 
        RowBox[{"src", "[", "\"\<YStorageID\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rp", "=", 
        RowBox[{"src", "[", "\"\<rp\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"B", "=", 
        RowBox[{"src", "[", "\"\<B\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"reIF", "=", 
        RowBox[{"ListInterpolation", "[", 
         RowBox[{
          RowBox[{"Re", "[", "data", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xGrid", ",", "yGrid"}], "}"}], ",", 
          RowBox[{"InterpolationOrder", "->", "order"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"imIF", "=", 
        RowBox[{"ListInterpolation", "[", 
         RowBox[{
          RowBox[{"Im", "[", "data", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xGrid", ",", "yGrid"}], "}"}], ",", 
          RowBox[{"InterpolationOrder", "->", "order"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<SampleXY\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"yy", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"yStorageID", "==", "1"}], ",", 
                  RowBox[{"Abs", "[", "y", "]"}], ",", "y"}], "]"}]}], "}"}], 
              ",", 
              RowBox[{
               RowBox[{"reIF", "[", 
                RowBox[{"x", ",", "yy"}], "]"}], "+", 
               RowBox[{"I", " ", 
                RowBox[{"imIF", "[", 
                 RowBox[{"x", ",", "yy"}], "]"}]}]}]}], "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<SamplePhysical\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", ",", "z"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"r", "-", "rp"}], ")"}], "/", "B"}]}], ",", 
                RowBox[{"y", "=", 
                 RowBox[{
                  RowBox[{"-", "rp"}], " ", "z"}]}], ",", "yy"}], "}"}], ",", 
              
              RowBox[{
               RowBox[{"yy", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"yStorageID", "==", "1"}], ",", 
                  RowBox[{"Abs", "[", "y", "]"}], ",", "y"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"reIF", "[", 
                 RowBox[{"x", ",", "yy"}], "]"}], "+", 
                RowBox[{"I", " ", 
                 RowBox[{"imIF", "[", 
                  RowBox[{"x", ",", "yy"}], "]"}]}]}]}]}], "]"}]}], "]"}]}]}],
         "|>"}]}]}], "]"}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9834328636529408`*^9, 3.983432863655579*^9}, {
