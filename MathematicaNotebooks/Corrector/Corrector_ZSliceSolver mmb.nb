Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "getFieldRGrid", ",", "getFieldZGrid", ",", "checkCorrectorSourceGrids"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"getFieldRGrid", "[", "field_Association", "]"}], ":=", 
   RowBox[{"N", "@", 
    RowBox[{
     RowBox[{"field", "[", "\"\<Meta\>\"", "]"}], "[", "\"\<RGrid\>\"", 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getFieldZGrid", "[", "field_Association", "]"}], ":=", 
    RowBox[{"N", "@", 
     RowBox[{
      RowBox[{"field", "[", "\"\<Meta\>\"", "]"}], "[", "\"\<ZGrid\>\"", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"checkCorrectorSourceGrids", "[", 
   RowBox[{"sourceFields_Association", ",", 
    RowBox[{"tol_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r1", ",", "z1", ",", "sameR", ",", "sameZ"}], "}"}], ",", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"getFieldRGrid", "[", 
       RowBox[{"sourceFields", "[", "\"\<Xmmbar\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z1", "=", 
      RowBox[{"getFieldZGrid", "[", 
       RowBox[{"sourceFields", "[", "\"\<Xmmbar\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sameR", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"r1", "-", 
           RowBox[{"getFieldRGrid", "[", 
            RowBox[{"sourceFields", "[", "\"\<Xnm\>\"", "]"}], "]"}]}], "]"}],
          "]"}], "<=", "tol"}], "&&", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"r1", "-", 
           RowBox[{"getFieldRGrid", "[", 
            RowBox[{"sourceFields", "[", "\"\<Xnn\>\"", "]"}], "]"}]}], "]"}],
          "]"}], "<=", "tol"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sameZ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"z1", "-", 
           RowBox[{"getFieldZGrid", "[", 
            RowBox[{"sourceFields", "[", "\"\<Xnm\>\"", "]"}], "]"}]}], "]"}],
          "]"}], "<=", "tol"}], "&&", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"z1", "-", 
           RowBox[{"getFieldZGrid", "[", 
            RowBox[{"sourceFields", "[", "\"\<Xnn\>\"", "]"}], "]"}]}], "]"}],
          "]"}], "<=", "tol"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<SameRGridQ\>\"", "->", "sameR"}], ",", 
       RowBox[{"\"\<SameZGridQ\>\"", "->", "sameZ"}], ",", 
       RowBox[{"\"\<RGrid\>\"", "->", "r1"}], ",", 
       RowBox[{"\"\<ZGrid\>\"", "->", "z1"}]}], "|>"}]}]}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.983449664583359*^9, 3.983449664586444*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"391b1707-3a3d-4369-8c05-d09f5fe84a31"]
