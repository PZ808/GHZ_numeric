Cell[TextData[{
 "\tWe can set the notebook to automatically save upon closing. We however \
will ",
 StyleBox["not do",
  FontColor->RGBColor[1, 0, 0]],
 " that (",
 StyleBox["made below unevaluable",
  FontColor->RGBColor[1, 0, 0]],
 ")! \n\tWe keep the code as a basis for possible future use.\n\tDue to the \
timestamp code above, this means that a \[OpenCurlyDoubleQuote]Save Changes \
To\[CloseCurlyDoubleQuote] windows will always appear."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.7609683899349203`*^9, 3.760968445706502*^9}, {
