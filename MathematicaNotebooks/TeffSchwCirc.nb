Cell[CellGroupData[{

Cell["Correcting alignment", "Subsubsubsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.767334485226399*^9, 
  3.7673344919917316`*^9}},ExpressionUUID->"22a995cb-7d15-4521-b8b9-\
a6e0472d7dea"],

Cell["\<\
\tThis docked button will go through the notebook and correctly align all the \
text.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.767334495520029*^9, 3.7673345126073723`*^9}, {
  3.89797453461045*^9, 
  3.897974535093182*^9}},ExpressionUUID->"4238d4e7-2fd4-4c1b-bd37-\
b6b01599d07c"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonalignment", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"styles", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Section\>\"", ",", "\"\<Subsection\>\"", ",", 
          "\"\<Subsubsection\>\""}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ToBoxes", "@", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<align\>\"", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Set", "[", 
             RowBox[{
              RowBox[{"CurrentValue", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], "]"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"CurrentValue", "[", 
               RowBox[{
                RowBox[{"PreviousCell", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"CellStyle", "\[Rule]", "styles"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"CellMargins", ",", "1", ",", "1"}], "}"}]}], 
               "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"Cells", "[", 
            RowBox[{"CellStyle", "\[Rule]", "\"\<Text\>\""}], "]"}]}], 
          "]"}]}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.767334514785654*^9, 3.7673345236628838`*^9}, {
  3.77002780011087*^9, 3.770027808916594*^9}, {3.7700319254436007`*^9, 
  3.7700319284353733`*^9}, {3.897974536733653*^9, 3.8979745449200697`*^9}},
 CellLabel->
  "In[434]:=",ExpressionUUID->"36ebb463-7370-49db-9200-7601e5221d65"]
}, Closed]],

Cell[CellGroupData[{

Cell["Correctly re-enable evaluation property", "Subsubsubsubsection",
 Evaluatable->False,
 CellChangeTimes->{{3.762002514219326*^9, 
  3.7620025247075577`*^9}},ExpressionUUID->"09bb3947-3a18-450c-b8f5-\
cb8125375253"],

Cell["\<\
\tThis part of the above code creates a docked button that easily allows to \
deactivate cell evaluation and re - enable it,
\twhile keeping the texts, outputs,etc default (not evaluable).  \
Specifically, \[OpenCurlyDoubleQuote]re-enable\[CloseCurlyDoubleQuote] in \
fact just sets properties back to default.\
\>", "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.7620025283983707`*^9, 3.762002653775247*^9}, {
  3.767333803125916*^9, 3.767333810069026*^9}, {3.767334453236224*^9, 
  3.767334455964188*^9}, {3.8979745502005777`*^9, 
  3.897974554274568*^9}},ExpressionUUID->"0d27f2fe-c862-4627-ad36-\
10ba70a5985b"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"buttonevaluable", " ", "=", " ", 
    RowBox[{"ToBoxes", "@", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Button", "[", 
         RowBox[{
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<Evaluable -> ``\>\"", ",", "#"}], "]"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CurrentValue", "[", 
            RowBox[{
             RowBox[{"SelectedCells", "@", 
              RowBox[{"InputNotebook", "[", "]"}]}], ",", "Evaluatable"}], 
            "]"}], "=", "#"}]}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"False", ",", "Inherited"}], "}"}]}], "]"}]}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.767333531414897*^9, 3.767333548375959*^9}, {
   3.7673336081872797`*^9, 3.767333622683069*^9}, {3.767333752783671*^9, 
   3.767333761976211*^9}, 3.77002782470183*^9, {3.8979745565450783`*^9, 
   3.897974561744177*^9}, {3.9195693402399817`*^9, 3.919569340428852*^9}},
 CellLabel->
  "In[435]:=",ExpressionUUID->"c5cdd025-6e1c-426f-b6dc-70dc18eb2a93"],

