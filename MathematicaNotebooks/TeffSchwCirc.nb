a3e1a3a68f48"],

Cell["\<\
\tAs a rule of thumb, packages should be loaded before loading mx files, \
because the latter may depend on definitions from those packages.
\tIf no dumpsave exist, the below simply prints this fact and does not do \
anything else.\
\>", "Text",
 CellChangeTimes->{{3.7582055346831217`*^9, 3.758205584977552*^9}, {
   3.758206372367805*^9, 3.7582064067427807`*^9}, {3.758357519202239*^9, 
   3.758357564696822*^9}, {3.7617581610730257`*^9, 3.761758163619699*^9}, {
   3.770032676780205*^9, 3.770032705562592*^9}, {3.879919471906907*^9, 
   3.879919473304255*^9}, 3.883378647635221*^9, 3.884754551707287*^9, {
   3.8979744235790157`*^9, 
   3.89797446363375*^9}},ExpressionUUID->"746c35f4-3f5a-47b1-8e1b-\
d00c72ed04fa"],

Cell[TextData[{
 "\t",
 StyleBox["Note:",
  FontColor->RGBColor[1, 0, 0]],
 " The dump-file\[CloseCurlyQuote]s name is assumed to have the very same \
name for the current notebook, with the extension \[OpenCurlyDoubleQuote].mx\
\[CloseCurlyDoubleQuote] instead of \[OpenCurlyDoubleQuote].nb\
\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.760956713169585*^9, 3.760956772215867*^9}, {
  3.761758165651751*^9, 3.761758166100388*^9}, {3.770032742985334*^9, 
  3.770032769224564*^9}, {3.8799194747295723`*^9, 
  3.8799194750654793`*^9}},ExpressionUUID->"dcfa5f50-c605-4aef-b5ff-\
e59753a06e0e"],

Cell[BoxData[
 RowBox[{"\t", 
  RowBox[{"(*", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dumpsaveFilePath", " ", "=", " ", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", 
           RowBox[{"StringDelete", "[", 
            RowBox[{
             RowBox[{"Last", "[", 
              RowBox[{"FileNameSplit", "[", 
               RowBox[{"NotebookFileName", "[", "]"}], "]"}], "]"}], ",", 
             "\"\<.nb\>\""}], "]"}]}], "}"}], "]"}], " ", "<>", " ", 
        "\"\<.mx\>\""}]}], "}"}], ",", " ", "\[IndentingNewLine]", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FileExistsQ", "[", "dumpsaveFilePath", "]"}], ",", 
       RowBox[{"Get", "[", "dumpsaveFilePath", "]"}], ",", 
       RowBox[{"Print", "[", "\"\<No DumpSave to load\>\"", "]"}]}], "]"}]}], 
    "]"}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.758357323265399*^9, {3.7583573566937323`*^9, 3.7583574844616003`*^9}, {
