Notebook[{

Cell[CellGroupData[{
Cell["First order m-mode Effective Source ", "Title",
 CellChangeTimes->{{3.9750878949790297`*^9, 
  3.975087914697748*^9}},ExpressionUUID->"22c0c002-18a1-4ecf-899d-\
7dbe91717e7d"],

Cell[TextData[{
 "Builds the first order effective source from a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "4"], TraditionalForm]],ExpressionUUID->
  "3fb7e206-d33d-4733-94c3-eea9c77ee40e"],
 " puncture in m-modes for a circular orbit \nKey features:\n- Newman Penrose \
formalism\n- comoving coordinates for a circular orbit\n- m-mode decomposition"
}], "Abstract",
 CellChangeTimes->{{3.975166002160399*^9, 3.975166151172249*^9}, {
  3.975166825937378*^9, 3.975166828629777*^9}, {3.9751669253100977`*^9, 
  3.9751669415045853`*^9}, {3.975168396307621*^9, 
  3.975168407854591*^9}},ExpressionUUID->"93597ed7-eef2-4136-8dbf-\
e9cdd572e31f"],

Cell[TextData[{
 "Computes the m-mode effective source from the 4th order puncture \n for a \
particle on a circular orbit using comoving coordinates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", 
    RowBox[{"\[Mu]", " "}]], TraditionalForm]],ExpressionUUID->
  "3a775396-156e-48e0-ad0c-4249d79c4e0f"],
 "= (T,X,Y,Z) centered on the particle \n ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["X", "p"], "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "5614114b-7888-41c0-a0cd-ab9a87b5d7ea"],
 " = (T,0,0,0).  These are related to BL (t,r,\[Theta],\[Phi]) coordinates by \
\[LineSeparator]",
 Cell[BoxData[
  RowBox[{"\[LineSeparator]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", 
            SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "t"}], "-", 
         RowBox[{"M", 
          SqrtBox[
           SubscriptBox["\[Rho]", "0"]], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Alpha]", "2"], "-", 
            RowBox[{"2", "\[Alpha]"}], "+", 
            SubscriptBox["\[Rho]", "0"]}], ")"}], "\[Phi]", " "}]}], 
        RowBox[{"\[ScriptCapitalD]", " ", 
         SubscriptBox["\[Rho]", "0"]}]], "=", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", 
             SqrtBox["M"]}], "+", 
            RowBox[{
             SqrtBox[
              SubscriptBox["r", "0"]], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], " ", "M"}], "+", 
               SubscriptBox["r", "0"]}], ")"}]}]}], ")"}], " ", "t", " ", 
          "\[ScriptCapitalD]"}], "-", 
         RowBox[{
          SqrtBox["M"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["a", "2"], "+", 
            SuperscriptBox[
             SubscriptBox["r", "0"], "2"], "-", 
            RowBox[{"2", " ", "a", " ", 
             SqrtBox[
              RowBox[{"M", " ", 
               SubscriptBox["r", "0"]}]]}]}], ")"}], " ", "\[ScriptCapitalD]",
           " ", "\[Phi]"}]}], 
        RowBox[{
         RowBox[{"2", " ", "a", " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["r0"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "M"}], "+", "r0"}], ")"}]}]}]]}]}], ",",
      "\[IndentingNewLine]", "\[LineSeparator]", 
     RowBox[{"X", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"r", "-", 
         RowBox[{"M", " ", 
          SubscriptBox["\[Rho]", "0"]}]}], "\[ScriptCapitalB]"], "=", 
       FractionBox[
        RowBox[{"r", "-", "r0"}], "\[ScriptCapitalB]"]}]}], ",", 
     "\[LineSeparator]", "\[IndentingNewLine]", 
     RowBox[{"Y", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["M\[Rho]", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "=", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["r", "0"]}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ",", "\[LineSeparator]", 
     "\[IndentingNewLine]", 
     RowBox[{"Z", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["z", "c"], 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{"\[Phi]", "-", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "p"], "t"}]}], "2"], "]"}]}], "=", 
       RowBox[{
        SubscriptBox["z", "c"], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               SqrtBox["M"], " ", "t"}], 
              RowBox[{
               RowBox[{"a", " ", 
                SqrtBox["M"]}], "+", 
               SuperscriptBox["r0", 
                RowBox[{"3", "/", "2"}]]}]]}], "+", "\[Phi]"}], ")"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "where", " ", 
    "\[LineSeparator]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "0"], "=", 
      RowBox[{
       SubscriptBox["r", "0"], "/", "M"}]}], ",", " ", 
     RowBox[{"\[Alpha]", "=", 
      FractionBox["a", 
       SqrtBox[
        RowBox[{"M", " ", 
         SubscriptBox["r", "0"]}]]]}]}], "\[IndentingNewLine]", "and", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SubscriptBox["z", "c"], "=", 
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"M", "/", 
         SubscriptBox["r", "0"]}]], 
       FractionBox["\[ScriptCapitalB]", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "p"], "\[ScriptCapitalD]"}]]}]}], 
     ",", " ", 
     RowBox[{"\[ScriptCapitalB]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Alpha]", "2"], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "2"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{"\[ScriptCapitalD]", "=", 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[Alpha]"}], "+", 
           SubscriptBox["\[Rho]", "0"], "-", "3"}], ")"}], "/", 
         SubscriptBox["\[Rho]", "0"]}], ",", " "}]]}], ",", " ", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "p"], "=", 
      FractionBox["1", 
       SqrtBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"M", " ", "\[Alpha]"}], " ", "+", 
            RowBox[{"M", " ", 
             SubscriptBox["\[Rho]", "0"]}]}], ")"}], 
          SubscriptBox["\[Rho]", "0"]}], ",", " "}]]]}]}], 
    "\[IndentingNewLine]"}]}]],ExpressionUUID->
  "3cfa7637-7ec0-48a3-beec-0b17d08a8973"],
 "\n (Adapted and truncated from  Patrick\[CloseCurlyQuote]s \
PunctureInCoordinates)"
}], "Text",
 CellChangeTimes->{{3.974504333881632*^9, 3.974504364771311*^9}, {
   3.974504404313861*^9, 3.974504410096993*^9}, {3.97450445282802*^9, 
   3.9745045576717854`*^9}, {3.9745046993059883`*^9, 3.974504846379155*^9}, {
   3.974504879441987*^9, 3.974505302060597*^9}, {3.974509228172714*^9, 
