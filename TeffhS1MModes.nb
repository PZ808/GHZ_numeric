Cell[CellGroupData[{

Cell["Spherical harmonic lm modes of the effective source", "Subsubsection",
 CellChangeTimes->{{3.975087458103092*^9, 
  3.975087469629236*^9}},ExpressionUUID->"697cff89-41fc-4423-bf96-\
ebc43e8790fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "the", " ", "coefficient", " ", "a_lm"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ProjectLM\[Theta]", "[", 
      RowBox[{"l_", ",", "ff_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "l"}], "+", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", "*", "Pi"}], ")"}]}], "]"}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"ff", "*", 
         RowBox[{"LegendreP", "[", 
          RowBox[{"l", ",", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Theta]", "[", "]"}], "]"}]}], "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", "[", "]"}], ",", "0", ",", "\[Pi]"}], "}"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ProjectLMY", "[", 
     RowBox[{"l_", ",", "ff_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
